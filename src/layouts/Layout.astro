---
import Navbar from "../components/Navbar.astro"
import Footer from "../components/Footer.astro"
import BackToTop from "../components/BackToTop.astro"
import LanguageSuggestionBanner from "../components/LanguageSuggestionBanner.astro"
import CoinGeckoUpdater from "../components/CoinGeckoUpdater.astro"
import "../styles/main.css"
import { getLangFromUrl, useTranslations, getAlternateUrl } from "../i18n"

// 1. Idioma detectado automáticamente desde la URL
const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)

// 2. Definimos qué datos PUEDE recibir este layout
interface Props {
  title?: string
  description?: string
  image?: string
  imageAlt?: string
  schema?: object | object[]
  ogType?: string
  customSpacing?: boolean
  /** ISO 8601 — fecha de publicación original */
  publishedTime?: string
  /** ISO 8601 — última modificación */
  modifiedTime?: string
  /** Nombre del autor — solo para ogType="article" */
  author?: string
  /** Ocultar de los motores de búsqueda (temporal para traducciones) */
  noindex?: boolean
  /** URL alternativa manual para ES (útil si hay translationSlug) */
  esUrl?: string
  /** URL alternativa manual para EN (útil si hay translationSlug) */
  enUrl?: string
  /** Ancho de la imagen OG */
  imageWidth?: number
  /** Alto de la imagen OG */
  imageHeight?: number
}

// 3. Extraemos los datos. Si la página no los envía, usamos los genéricos del diccionario (Fallback i18n)
const {
  title = t("layout.title.default"),
  description = t("layout.description.default"),
  image = "/img/44.webp",
  imageAlt = title,
  schema,
  ogType = "website",
  customSpacing = false,
  publishedTime,
  modifiedTime,
  author,
  noindex = false,
  esUrl: customEsUrl,
  enUrl: customEnUrl,
  imageWidth,
  imageHeight,
} = Astro.props

// 4. Utilidad para asegurar trailing slash (Evita bucles de contenido duplicado y garantiza que Canonical = Hreflang)
function ensureTS(path: string): string {
  return path === "/" || path.endsWith("/") ? path : path + "/"
}

// 5. Generación automática de la URL Canónica (Normalizada)
const canonicalURL = new URL(ensureTS(Astro.url.pathname), Astro.site)

// 6. URLs alternativas para hreflang (SEO bilingüe)

const esUrlStr = ensureTS(customEsUrl || getAlternateUrl(Astro.url, "es"))
const enUrlStr = ensureTS(customEnUrl || getAlternateUrl(Astro.url, "en"))

const esUrl = new URL(esUrlStr, Astro.site)
const enUrl = new URL(enUrlStr, Astro.site)
---

<!doctype html>
<html lang={lang} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="96x96" href="/img/favicon-96x96.png" />
    <link rel="apple-touch-icon" href="/img/apple-touch-icon.png" />

    <title>{title}</title>
    <meta name="description" content={description} />

    <link rel="canonical" href={canonicalURL} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    {
      noindex ? (
        <meta name="robots" content="noindex" />
      ) : (
        <meta name="robots" content="index, follow, max-image-preview:large" />
      )
    }

    <!-- hreflang alternates — SEO bilingüe -->
    <link rel="alternate" hreflang="es" href={esUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="x-default" href={esUrl} />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="0x Leñador" />
    <meta property="og:locale" content={lang === "es" ? "es_ES" : "en_US"} />
    <meta property="og:locale:alternate" content={lang === "es" ? "en_US" : "es_ES"} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, Astro.site)} />
    <meta property="og:image:alt" content={imageAlt} />
    {imageWidth && <meta property="og:image:width" content={imageWidth.toString()} />}
    {imageHeight && <meta property="og:image:height" content={imageHeight.toString()} />}
    <meta property="og:url" content={canonicalURL} />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    {author && <meta property="article:author" content={author} />}

    <meta property="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@0xlenador" />
    <meta name="twitter:creator" content="@0xlenador" />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={new URL(image, Astro.site)} />
    <meta name="twitter:image:alt" content={imageAlt} />

    <meta name="theme-color" content="#141414" />

    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}

    <!-- Slot para contenido <head> específico de cada página -->
    <slot name="head" />
  </head>
  <body class="bg-terminal-bg antialiased selection:bg-emerald-500/30 min-h-screen flex flex-col">
    <Navbar lang={lang} esUrl={esUrlStr} enUrl={enUrlStr} />
    <div class:list={["flex-1", !customSpacing && "pt-10 pb-4"]}>
      <slot />
    </div>
    <Footer lang={lang} />
    <BackToTop />
    <LanguageSuggestionBanner />
    <CoinGeckoUpdater />
  </body>
</html>
