---
import Navbar from "../components/Navbar.astro"
import Footer from "../components/Footer.astro"
import BackToTop from "../components/BackToTop.astro"
import "../styles/main.css"
import { getLangFromUrl, useTranslations, getAlternateUrl } from "../i18n"

// 1. Idioma detectado automáticamente desde la URL
const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)

// 2. Definimos qué datos PUEDE recibir este layout
interface Props {
  title?: string
  description?: string
  image?: string
  schema?: object | object[]
  keywords?: string
  ogType?: string
  customSpacing?: boolean
  /** ISO 8601 — solo para ogType="article" */
  publishedTime?: string
  /** Nombre del autor — solo para ogType="article" */
  author?: string
  /** Ocultar de los motores de búsqueda (temporal para traducciones) */
  noindex?: boolean
  /** URL alternativa manual para ES (útil si hay translationSlug) */
  esUrl?: string
  /** URL alternativa manual para EN (útil si hay translationSlug) */
  enUrl?: string
}

// 3. Extraemos los datos. Si la página no los envía, usamos los genéricos del diccionario (Fallback i18n)
const {
  title = t("layout.title.default"),
  description = t("layout.description.default"),
  image = "/img/44.webp",
  schema,
  keywords,
  ogType = "website",
  customSpacing = false,
  publishedTime,
  author,
  noindex = false,
  esUrl: customEsUrl,
  enUrl: customEnUrl,
} = Astro.props

// 4. Generación automática de la URL Canónica
const canonicalURL = new URL(Astro.url.pathname, Astro.site)

// 5. URLs alternativas para hreflang (SEO bilingüe)
const esUrlStr = customEsUrl || getAlternateUrl(Astro.url, "es")
const enUrlStr = customEnUrl || getAlternateUrl(Astro.url, "en")

const esUrl = new URL(esUrlStr, Astro.site)
const enUrl = new URL(enUrlStr, Astro.site)
---

<!doctype html>
<html lang={lang} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="96x96" href="/img/favicon-96x96.png" />
    <link rel="apple-touch-icon" href="/img/apple-touch-icon.png" />

    <title>{title}</title>
    <meta name="description" content={description} />
    {keywords && <meta name="keywords" content={keywords} />}

    <link rel="canonical" href={canonicalURL} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    {noindex && <meta name="robots" content="noindex" />}

    <!-- hreflang alternates — SEO bilingüe -->
    <link rel="alternate" hreflang="es" href={esUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="x-default" href={esUrl} />

    <!-- Redirección internacional automática (Solo en cliente) -->
    <script is:inline>
      (function() {
        try {
          // 1. Si el usuario ya eligió manualmente, no intervenir
          if (localStorage.getItem('lang_override') === 'true') return;
          
          // 2. Si es un bot de búsqueda/redes sociales, no intervenir
          // Googlebot y crawlers deben poder ver ambas versiones para respetar hreflang
          const isBot = /bot|googlebot|crawler|spider|robot|crawling|lighthouse|prerender|facebookexternalhit|twitterbot|discordbot/i.test(navigator.userAgent);
          if (isBot) return;

          // 3. Comprobar si es una página en español y si el navegador NO es hispano
          const isSpanishPage = document.documentElement.lang === 'es';
          const browserLang = navigator.language.toLowerCase();
          
          if (isSpanishPage && !browserLang.startsWith('es')) {
            // 3. Buscar el alternate link y redirigir limpiamente
            const enLink = document.querySelector('link[hreflang="en"]');
            if (enLink && enLink.href) {
              window.location.replace(enLink.href);
            }
          }
        } catch (e) {
          // Ignorar errores silenciosamente (ej. localStorage bloqueado)
        }
      })();
    </script>

    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, Astro.site)} />
    <meta property="og:url" content={canonicalURL} />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {author && <meta property="article:author" content={author} />}

    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={new URL(image, Astro.site)} />

    <meta name="theme-color" content="#141414" />

    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}

    <!-- Slot para contenido <head> específico de cada página -->
    <slot name="head" />
  </head>
  <body class="bg-terminal-bg antialiased selection:bg-emerald-500/30 min-h-screen flex flex-col">
    <Navbar lang={lang} esUrl={esUrlStr} enUrl={enUrlStr} />
    <div class:list={["flex-1", !customSpacing && "pt-10 pb-4"]}>
      <slot />
    </div>
    <Footer lang={lang} />
    <BackToTop />
  </body>
</html>
