---
// ==========================================
// 1. IMPORTS Y ENTRADA DE DATOS
// ==========================================
import bitcoinData from "../data/bitcoin.json";
import ethereumData from "../data/ethereum.json";
import directoryData from "../data/directory.json";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import "../styles/main.css";

export async function getStaticPaths() {
  return [
    { params: { id: "bitcoin" }, props: { data: bitcoinData } },
    { params: { id: "ethereum" }, props: { data: ethereumData } },
  ];
}

const { data } = Astro.props;

// ==========================================
// 2. MAPA DE COLORES SEGURO PARA TAILWIND
// ==========================================
const colorMap = {
  emerald: {
    bg5: "bg-emerald-500/5",
    bg10: "bg-emerald-500/10",
    bg20: "bg-emerald-500/20",
    bg30: "bg-emerald-500/30",
    bg600: "bg-emerald-600",
    border20: "border-emerald-500/20",
    border30: "border-emerald-500/30",
    border40: "border-emerald-500/40",
    text400: "text-emerald-400",
    text400_80: "text-emerald-400/80",
    text500: "text-emerald-500",
    text500_70: "text-emerald-500/70",
    text500_80: "text-emerald-500/80",
    borderL: "border-l-4 border-emerald-500",
    bgFull: "bg-emerald-500",
    glow: "group-hover:drop-shadow-[0_0_20px_rgba(16,185,129,0.3)]",
    overlay: "text-emerald-400 border-emerald-500/20",
  },
  cyan: {
    bg5: "bg-cyan-500/5",
    bg10: "bg-cyan-500/10",
    bg20: "bg-cyan-500/20",
    bg30: "bg-cyan-500/30",
    bg600: "bg-cyan-600",
    border20: "border-cyan-500/20",
    border30: "border-cyan-500/30",
    border40: "border-cyan-500/40",
    text400: "text-cyan-400",
    text400_80: "text-cyan-400/80",
    text500: "text-cyan-500",
    text500_70: "text-cyan-500/70",
    text500_80: "text-cyan-500/80",
    borderL: "border-l-4 border-cyan-500",
    bgFull: "bg-cyan-500",
    glow: "group-hover:drop-shadow-[0_0_20px_rgba(6,182,212,0.3)]",
    overlay: "text-cyan-400 border-cyan-500/20",
  },
};

const c = colorMap[data.accentColor] || colorMap.emerald;

// ==========================================
// FUNCIÓN PARA LIMPIAR RUTAS DE IMÁGENES
// ==========================================
const getCleanImagePath = (rawPath) => {
  if (!rawPath) return "";
  // Corrige tanto si empieza por "./assets/img/" como si empieza por "assets/img/"
  return rawPath
    .replace("./assets/img/", "/img/")
    .replace("assets/img/", "/img/");
};

const toolingSections = [
  { title: "Mercados y Exchanges", key: "mercados" },
  { title: "Análisis y Gráficos", key: "analisis" },
  { title: "Custodia (Wallets)", key: "custodia" },
  { title: "Exploración On-Chain", key: "infraestructura" },
];

const resolveTool = (toolIdOrObj) => {
  if (typeof toolIdOrObj === "string") {
    return (
      directoryData.find((d) => d.id === toolIdOrObj) || {
        name: toolIdOrObj,
        url: "#",
        subtitle: "No encontrado",
      }
    );
  }
  return toolIdOrObj;
};

// ==========================================
// 3. ESTRUCTURA METADATOS SEO
// ==========================================
const schema = [
  {
    "@context": "https://schema.org",
    "@type": "TechArticle",
    headline: data.seo.title,
    description: data.seo.description,
    image: data.seo.ogImage,
    author: {
      "@type": "Person",
      name: "0x Leñador",
      url: "https://0xlenador.xyz/",
    },
    publisher: { "@type": "Organization", name: "0xLeñador" },
    mainEntityOfPage: { "@type": "WebPage", "@id": data.pageUrl },
  },
];
---

<!doctype html>
<html lang="es" class="bg-slate-950 text-slate-300">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{data.seo.title}</title>
    <meta name="description" content={data.seo.description} />
    <meta property="og:title" content={data.seo.title} />
    <meta property="og:description" content={data.seo.description} />
    <meta property="og:image" content={data.seo.ogImage} />
    <meta property="og:url" content={data.pageUrl} />
    <link rel="canonical" href={data.pageUrl} />
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </head>
  <body class="antialiased font-sans">
    <Navbar />

    <main class="max-w-7xl mx-auto px-6 pt-10 pb-20">
      <header
        class="border-b border-slate-800 pb-8 mb-12 flex flex-col md:flex-row justify-between items-end gap-6"
      >
        <div>
          <div class="flex items-center gap-3 mb-2">
            <span
              class={`px-2 py-0.5 ${c.bg10} border ${c.border20} ${c.text500} text-[10px] font-bold uppercase tracking-widest rounded italic`}
              >Activo: {data.type}</span
            >
            <span
              class="text-slate-500 font-mono text-[10px] tracking-widest uppercase"
              >Protocolo v.1.0.0</span
            >
          </div>
          <h1
            class="text-6xl font-black text-white tracking-tighter uppercase italic leading-none"
          >
            {data.name}
            <span class={c.text500}>/ {data.ticker}</span>
          </h1>
        </div>
        <div class="text-right font-mono italic">
          <p class="text-slate-600 text-[10px] uppercase tracking-widest mb-1">
            Mercado / USD
          </p>
          <p
            id="asset-price"
            class="text-white text-3xl font-black tabular-nums tracking-tighter tracking-widest h-9 flex justify-end items-center"
          >
            <span class="w-32 h-8 bg-slate-800/80 rounded-md animate-pulse"
            ></span>
          </p>
        </div>
      </header>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
        <div class="lg:col-span-3 space-y-8">
          <section
            class="p-6 bg-slate-900/20 border border-slate-800 rounded-3xl relative overflow-hidden group"
          >
            <span
              class={`absolute top-4 right-6 text-slate-800 font-black text-4xl group-hover:${c.text500}/10 transition-colors`}
              >01</span
            >
            <h3
              class={`${c.text500} font-bold text-xs uppercase tracking-widest mb-6 italic font-mono`}
            >
              Definición
            </h3>
            <p class="text-slate-300 text-sm leading-relaxed italic">
              {data.definicion}
            </p>
          </section>

          <section
            class="p-6 bg-slate-900/20 border border-slate-800 rounded-3xl relative overflow-hidden group"
          >
            <span
              class={`absolute top-4 right-6 text-slate-800 font-black text-4xl group-hover:${c.text500}/10 transition-colors`}
              >02</span
            >
            <h3
              class={`${c.text500} font-bold text-xs uppercase tracking-widest mb-6 italic font-mono`}
            >
              Génesis e Identidad
            </h3>
            <div class="space-y-4 font-mono text-[11px]">
              <div
                class="flex justify-between border-b border-slate-800/50 pb-2"
              >
                <span class="text-slate-500 italic uppercase"
                  >Fecha de Inicio</span
                >
                <span class="text-white">{data.genesis.fechaInicio}</span>
              </div>
              <div
                class="flex justify-between border-b border-slate-800/50 pb-2"
              >
                <span class="text-slate-500 italic uppercase">Creador(es)</span>
                <span
                  class={`text-white underline decoration-${data.accentColor}-500/30 decoration-dashed`}
                  >{data.genesis.creador}</span
                >
              </div>
              <div
                class="flex justify-between border-b border-slate-800/50 pb-2"
              >
                <span class="text-slate-500 italic uppercase">Whitepaper</span>
                <a
                  href={data.genesis.whitepaperUrl}
                  target="_blank"
                  class={`${c.text500} hover:text-white transition-colors`}
                  >VER PDF -></a
                >
              </div>
            </div>
          </section>

          <div
            class={`py-8 px-6 ${c.bg600} rounded-[2rem] text-slate-950 flex flex-col justify-between group overflow-hidden relative`}
          >
            <svg
              class="absolute -bottom-4 -right-4 text-slate-950/10 w-32 h-32 transform -rotate-12 group-hover:scale-110 transition-transform"
              viewBox="0 0 24 24"
              fill="currentColor"
              ><path
                d="M12,2C10.6,2 9.4,2.6 8.5,3.5L6,9H2V11H22V9H18L15.5,3.5C14.6,2.6 13.4,2 12,2M12,4C12.9,4 13.7,4.4 14.2,5L16,9H8L9.8,5C10.3,4.4 11.1,4 12,4M7,12C4.2,12 2,14.2 2,17C2,19.8 4.2,22 7,22C9.4,22 11.5,20.3 11.9,18C12.2,17.8 12.8,17.8 13.1,18C13.5,20.3 15.6,22 18,22C20.8,22 23,19.8 23,17C23,14.2 20.8,12 18,12C16.3,12 14.8,12.8 13.8,14.1C13.2,13.8 12.5,13.8 11.9,14.1C10.9,12.8 9.4,12 7.7,12C7.5,12 7.2,12 7,12.1V12M7,14C8.7,14 10,15.3 10,17C10,18.7 8.7,20 7,20C5.3,20 4,18.7 4,17C4,15.3 5.3,14 7,14M18,14C19.7,14 21,15.3 21,17C21,18.7 19.7,20 18,20C16.3,20 15,18.7 15,17C15,15.3 16.3,14 18,14Z"
              ></path></svg
            >
            <div
              class="relative z-10 transition-opacity duration-500 ease-in-out"
              id="dato-oculto-content"
            >
              <h4
                class="font-black uppercase tracking-widest text-[10px] mb-4 italic"
              >
                Dato Oculto
              </h4>
              <p
                class="text-xs font-bold leading-relaxed italic border-l-2 border-slate-950/20 pl-3 line-clamp-2"
              >
                {data.datoOculto.teaser}
              </p>
              <button
                id="btn-ver-mas-dato"
                class="mt-4 text-[9px] font-black uppercase tracking-widest text-slate-900/60 hover:text-slate-900 transition-colors flex items-center gap-1 cursor-pointer relative z-20"
              >
                Ver más <svg
                  class="w-3 h-3"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                  stroke-width="2"
                  ><path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg
                >
              </button>
            </div>
            <div
              id="dato-oculto-overlay"
              class={`absolute inset-0 bg-slate-950/95 backdrop-blur-md ${c.overlay} z-30 p-6 pt-12 flex flex-col opacity-0 pointer-events-none transition-all duration-500 ease-in-out scale-95 border rounded-[2rem]`}
            >
              <button
                id="btn-cerrar-dato"
                class={`absolute top-4 right-4 ${c.text500}/70 hover:${c.text500} bg-slate-900 rounded-full transition-all cursor-pointer p-1.5 z-40`}
              >
                <svg
                  class="w-4 h-4"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                  ><path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M6 18L18 6M6 6l12 12"></path></svg
                >
              </button>
              <div
                class="custom-scrollbar overflow-y-auto flex-1 pr-3 space-y-4 font-mono text-[11px] leading-relaxed text-slate-200 pb-2"
              >
                {
                  data.datoOculto.contenido.map((p, i) => (
                    <p class={i === 0 ? `${c.text400} font-bold` : ""}>{p}</p>
                  ))
                }
              </div>
            </div>
          </div>
        </div>

        <div class="lg:col-span-6">
          <div
            class="relative bg-slate-900/10 border border-slate-800/50 rounded-[4rem] p-6 md:p-12 min-h-[450px] md:min-h-[550px] flex flex-col items-center justify-between overflow-hidden group"
          >
            <div
              class="relative w-full flex-1 flex items-center justify-center py-10 md:py-0"
            >
              <div
                class={`absolute w-48 h-48 md:w-64 md:h-64 ${c.bg5} blur-[100px] rounded-full animate-pulse`}
              >
              </div>

              <div
                class={`relative w-48 h-48 md:w-72 md:h-72 rounded-full flex items-center justify-center ${c.glow} transition-all duration-700 overflow-hidden`}
              >
                <img
                  src={getCleanImagePath(data.image)}
                  alt={data.imageAlt}
                  class="w-full h-full object-cover rounded-full"
                />
              </div>

              {
                data.floatingTags.map((tag, i) => {
                  const animation =
                    i % 2 === 0
                      ? "animate-bounce-slow"
                      : "animate-bounce-slower";
                  const position =
                    i === 0
                      ? "top-0 left-0 md:top-10 md:left-10"
                      : i === 1
                        ? "top-10 right-0 md:top-20 md:right-0"
                        : i === 2
                          ? "bottom-16 left-0 md:bottom-20 md:left-0"
                          : "bottom-0 right-0 md:bottom-10 md:right-10";
                  return (
                    <div class={`absolute ${position} z-10 ${animation}`}>
                      <div
                        class={`px-3 py-1.5 md:px-5 md:py-2.5 bg-slate-900/60 backdrop-blur-md border ${c.border30} rounded-full shadow-[inset_0_1px_1px_rgba(255,255,255,0.1),0_8px_32px_rgba(16,185,129,0.2)] flex items-center gap-2 transition-all hover:bg-slate-800/60 hover:scale-105 cursor-default`}
                      >
                        <svg
                          class={`w-3 h-3 ${c.text500_80}`}
                          fill="currentColor"
                          viewBox="0 0 24 24"
                        >
                          <path d="M12 2L14.5 8.5L21 11L14.5 13.5L12 20L9.5 13.5L3 11L9.5 8.5L12 2Z" />
                        </svg>
                        <span
                          class={`${c.text400} font-mono text-[9px] md:text-[11px] font-bold tracking-widest uppercase`}
                        >
                          {tag}
                        </span>
                      </div>
                    </div>
                  );
                })
              }
            </div>

            <div class="w-full flex flex-col items-center mt-4 z-10">
              <div
                class={`w-px h-12 bg-transparent border-l-2 border-dashed ${c.border20} mb-4`}
              >
              </div>
              <h3
                class="text-center text-[10px] font-black text-slate-600 uppercase tracking-[0.4em] italic mb-2"
              >
                Arquitectura Base del Protocolo
              </h3>
              <div class="w-full flex flex-col items-center mt-2 mb-8 relative">
                <div
                  class={`w-px h-10 bg-transparent border-l-2 border-dashed ${c.border40}`}
                >
                </div>
                <div
                  class={`w-[66%] h-px border-t-2 border-dashed ${c.border40} relative`}
                >
                  <div
                    class={`absolute left-0 top-0 w-px h-6 border-l-2 border-dashed ${c.border40}`}
                  >
                  </div>
                  <svg
                    class={`absolute -left-1.5 top-5 w-3 h-3 ${c.text500_70}`}
                    fill="currentColor"
                    viewBox="0 0 24 24"
                    ><path d="M12 21L3 12L5.8 9.2L12 15.4L18.2 9.2L21 12L12 21Z"
                    ></path></svg
                  >
                  <div
                    class={`absolute left-1/2 top-0 w-px h-6 border-l-2 border-dashed ${c.border40} transform -translate-x-1/2`}
                  >
                  </div>
                  <svg
                    class={`absolute left-1/2 top-5 w-3 h-3 ${c.text500_70} transform -translate-x-1/2`}
                    fill="currentColor"
                    viewBox="0 0 24 24"
                    ><path d="M12 21L3 12L5.8 9.2L12 15.4L18.2 9.2L21 12L12 21Z"
                    ></path></svg
                  >
                  <div
                    class={`absolute right-0 top-0 w-px h-6 border-l-2 border-dashed ${c.border40}`}
                  >
                  </div>
                  <svg
                    class={`absolute -right-1.5 top-5 w-3 h-3 ${c.text500_70}`}
                    fill="currentColor"
                    viewBox="0 0 24 24"
                    ><path d="M12 21L3 12L5.8 9.2L12 15.4L18.2 9.2L21 12L12 21Z"
                    ></path></svg
                  >
                </div>
              </div>
              <div class="grid grid-cols-3 gap-4 w-full">
                {
                  data.arquitectura.map((item) => (
                    <div class="text-center p-3 border border-slate-800/50 rounded-2xl bg-slate-950/40">
                      <p class="text-[8px] text-slate-500 uppercase mb-1">
                        {item.label}
                      </p>
                      <p class="text-white font-mono font-bold text-[10px] uppercase italic">
                        {item.value}
                      </p>
                    </div>
                  ))
                }
              </div>
            </div>
          </div>
        </div>

        <div class="lg:col-span-3 space-y-8">
          <section
            class="p-6 bg-slate-900/20 border border-slate-800 rounded-3xl relative overflow-hidden group"
          >
            <span
              class={`absolute top-4 right-6 text-slate-800 font-black text-4xl group-hover:${c.text500}/10 transition-colors`}
              >03</span
            >
            <h3
              class={`${c.text500} font-bold text-xs uppercase tracking-widest mb-6 italic font-mono`}
            >
              Matemática del Activo
            </h3>
            <div class="space-y-4 font-mono text-[11px]">
              <div class="flex flex-col border-b border-slate-800/50 pb-2">
                <span class="text-slate-500 italic mb-1 uppercase text-[8px]"
                  >Suministro Total</span
                >
                <span class="text-white text-base font-bold"
                  >{data.matematica.suministroTotal}</span
                >
              </div>
              <div class="flex flex-col border-b border-slate-800/50 pb-2">
                <span class="text-slate-500 italic mb-1 uppercase text-[8px]"
                  >Marketcap FDV</span
                >
                <span
                  id="asset-fdv"
                  class="text-white animate-pulse"
                  data-supply={data.matematica.suministroTotal}>...</span
                >
              </div>
              <div class="flex flex-col pb-2">
                <span class="text-slate-500 italic mb-1 uppercase text-[8px]"
                  >Ciclo</span
                >
                <span class="text-white italic"
                  >{data.matematica.cicloHalving}</span
                >
              </div>
            </div>
          </section>

          <a
            href="#"
            class={`p-6 border-2 border-dashed border-slate-800 rounded-[2rem] bg-slate-900/10 flex flex-col items-center justify-center text-center group hover:${c.border30} hover:bg-slate-900/30 transition-all`}
          >
            <svg
              class="w-5 h-5 text-slate-700 mb-2 group-hover:text-emerald-500/50 transition-colors"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="1.5"
                d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path></svg
            >
            <span
              class={`text-slate-600 font-black uppercase tracking-widest text-[9px] italic group-hover:${c.text500} transition-colors`}
              >Próximamente</span
            >
          </a>

          <div
            class="p-6 bg-cyan-400 rounded-[2rem] text-slate-950 flex flex-col justify-between group overflow-hidden relative"
          >
            <div
              class="absolute -bottom-4 -right-4 text-slate-950/10 font-black text-6xl uppercase italic transform -rotate-12 group-hover:scale-110 transition-transform"
            >
              Moat
            </div>
            <div class="relative z-10">
              <h4
                class="font-black uppercase tracking-widest text-[10px] mb-4 italic"
              >
                Análisis de Carácter
              </h4>
              <p
                class="text-xs font-bold leading-relaxed italic border-l-2 border-slate-950/20 pl-3"
              >
                {data.analisisCaracter}
              </p>
            </div>
          </div>
        </div>
      </div>

      <section
        class="mt-12 p-8 md:p-12 bg-slate-900/10 border border-slate-800 rounded-[3rem] relative overflow-hidden"
      >
        <h4
          class="text-white font-bold mb-10 uppercase tracking-widest text-xs italic font-mono flex items-center gap-3 relative z-10"
        >
          <svg
            class={`w-4 h-4 ${c.text500}`}
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            ><path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0-5.656-5.656l-1.1 1.1"
            ></path></svg
          >
          Tooling & Connectivity
        </h4>
        <div
          class="grid grid-cols-1 lg:grid-cols-2 gap-10 font-mono relative z-10"
        >
          {
            toolingSections.map((sec) => {
              const toolsRaw = data.tooling[sec.key];
              if (!toolsRaw || toolsRaw.length === 0) return null;
              const resolvedTools = toolsRaw.map(resolveTool);

              return (
                <div>
                  <p
                    class={`${c.text500} uppercase text-[9px] tracking-widest font-bold mb-4 flex items-center gap-2`}
                  >
                    <span class={`w-1.5 h-1.5 rounded-full ${c.bgFull}`} />
                    {sec.title}
                  </p>
                  <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                    {resolvedTools.map((item) => (
                      <div class="relative group">
                        {(item.partner || item.sponsored) && (
                          <span class="absolute -top-2 -right-2 bg-emerald-500/20 text-emerald-500 border border-emerald-500/30 text-[8px] font-black uppercase tracking-widest px-2 py-0.5 rounded-full z-10 shadow-[0_0_10px_rgba(16,185,129,0.1)]">
                            Partner
                          </span>
                        )}
                        <a
                          href={item.url}
                          target="_blank"
                          class="flex items-center gap-3 p-3 border border-slate-800 bg-slate-900/40 rounded-2xl transition-all hover:bg-slate-800/80 hover:border-slate-700 group-hover:scale-[1.02]"
                        >
                          <div class="w-10 h-10 rounded-xl bg-slate-950 flex items-center justify-center border border-slate-800">
                            <img
                              src={getCleanImagePath(
                                item.image || item.logo || "",
                              )}
                              alt={item.name}
                              loading="lazy"
                              class="w-6 h-6 object-contain"
                            />
                          </div>
                          <div>
                            <p class="text-white font-bold text-xs uppercase tracking-wider mb-0.5">
                              {item.name}
                            </p>
                            <p class="text-slate-500 text-[9px] uppercase tracking-widest italic">
                              {item.subtitle || item.tag || ""}
                            </p>
                          </div>
                        </a>
                      </div>
                    ))}
                  </div>
                </div>
              );
            })
          }
        </div>
      </section>

      <section class="mt-12 w-full pt-20">
        <div class="mb-20 text-center">
          <h2
            class="text-4xl font-black text-white tracking-tighter uppercase italic mb-4"
          >
            {data.investigacion.titulo}
          </h2>
          <p
            class="text-slate-500 font-mono text-[10px] uppercase tracking-[0.4em] italic"
          >
            {data.investigacion.subtitulo}
          </p>
        </div>

        <div
          class="grid grid-cols-1 gap-8 lg:gap-12 items-start max-w-4xl mx-auto"
        >
          {
            data.investigacion.pilares.map((pilar) => (
              <article class="bg-slate-900/20 border border-slate-800 rounded-[2rem] p-8 md:p-10 relative overflow-hidden">
                <div
                  class={`absolute top-0 right-0 w-64 h-64 ${c.bg5} blur-[80px] rounded-full pointer-events-none`}
                />
                <h2
                  class={`text-xl md:text-2xl font-black text-white uppercase italic ${c.borderL} pl-4 mb-8`}
                >
                  {pilar.titulo}
                </h2>
                <div class="space-y-8 relative z-10">
                  {pilar.secciones.map((sec, index) => (
                    <div
                      class={
                        index !== 0 ? "border-t border-slate-800/50 pt-8" : ""
                      }
                    >
                      <h3
                        class={`${c.text400} font-bold uppercase tracking-widest text-xs font-mono mb-3`}
                      >
                        {sec.subtitulo}
                      </h3>
                      <p class="text-slate-300 text-sm md:text-base leading-relaxed">
                        {sec.contenido}
                      </p>

                      {sec.tabla && (
                        <div class="overflow-x-auto rounded-xl border border-slate-800 bg-slate-950/50 mt-6">
                          <table class="w-full text-left text-sm border-collapse min-w-[600px]">
                            <thead>
                              <tr class="border-b border-slate-800 text-slate-500 uppercase font-mono text-[10px] tracking-widest bg-slate-900/50">
                                {sec.tabla.headers.map((h, i) => (
                                  <th
                                    class={`py-4 px-5 ${i === sec.tabla.highlightCol ? c.text500 : ""}`}
                                  >
                                    {h}
                                  </th>
                                ))}
                              </tr>
                            </thead>
                            <tbody class="text-slate-300">
                              {sec.tabla.rows.map((row, i) => (
                                <tr class="border-b border-slate-800/50 hover:bg-slate-900/50 transition-colors">
                                  {row.map((cell, j) => {
                                    const colClass = sec.tabla.rowColors[i][j];
                                    const color =
                                      colClass === "emerald"
                                        ? c.text400
                                        : colClass === "emerald-dim"
                                          ? c.text400_80
                                          : colClass === "red"
                                            ? "text-red-400/80"
                                            : "text-slate-400";
                                    return (
                                      <td
                                        class={`py-3 px-5 ${j === 0 ? "font-bold" : ""} ${color} text-xs`}
                                      >
                                        {cell}
                                      </td>
                                    );
                                  })}
                                </tr>
                              ))}
                            </tbody>
                          </table>
                        </div>
                      )}

                      {sec.riskCards && (
                        <>
                          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mt-4">
                            {sec.riskCards.map((cBox) => (
                              <div class="bg-slate-950/50 p-4 rounded-xl border border-slate-800">
                                <h4 class="text-slate-200 font-bold text-xs uppercase mb-2 flex items-center gap-2">
                                  <span
                                    class={`w-1.5 h-1.5 ${c.bgFull} rounded-full`}
                                  />{" "}
                                  {cBox.titulo}
                                </h4>
                                <p class="text-slate-400 text-xs">
                                  {cBox.texto}
                                </p>
                              </div>
                            ))}
                          </div>
                          {sec.riskNote && (
                            <p class="text-slate-500 text-xs mt-4 italic">
                              {sec.riskNote}
                            </p>
                          )}
                        </>
                      )}

                      {sec.correlationTags && (
                        <div class="flex flex-wrap gap-2 mt-4">
                          {sec.correlationTags.map((t) => (
                            <span class="px-3 py-1 bg-slate-900/80 border border-slate-800 rounded-lg text-xs text-slate-300 font-mono">
                              <span class={c.text400}>{t.label}:</span>{" "}
                              {t.value}
                            </span>
                          ))}
                        </div>
                      )}
                    </div>
                  ))}
                </div>
              </article>
            ))
          }
        </div>
      </section>

      <section class="mt-24 max-w-3xl mx-auto">
        <div class="mb-12 text-center">
          <h2
            class="text-3xl font-black text-white tracking-tighter uppercase italic mb-4"
          >
            {data.faq.titulo}
          </h2>
          <p
            class="text-slate-500 font-mono text-[10px] uppercase tracking-[0.4em] italic"
          >
            {data.faq.subtitulo}
          </p>
        </div>
        <div class="space-y-4">
          {
            data.faq.items.map((item, i) => {
              const id = data.faq.startId + i;
              return (
                <div class="p-6 bg-slate-900/20 border border-slate-800 rounded-3xl group hover:border-slate-700 transition-all duration-300">
                  <button
                    onclick={`toggleFaq(${id})`}
                    class="w-full flex justify-between items-center text-left faq-btn"
                    aria-expanded="false"
                  >
                    <h3 class="text-white font-bold text-sm md:text-base pr-8">
                      {item.pregunta}
                    </h3>
                    <span
                      id={`icon-${id}`}
                      class={`${c.text500}/50 transition-all duration-500 transform text-xl font-light icon-rotate`}
                    >
                      <svg
                        class="w-6 h-6"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          stroke-width="2"
                          d="M12 6v6m0 0v6m0-6h6m-6 0H6"
                        />
                      </svg>
                    </span>
                  </button>
                  <div
                    id={`ans-${id}`}
                    class="max-h-0 overflow-hidden transition-all duration-500 ease-in-out faq-content"
                    aria-hidden="true"
                    style="max-height: 0px;"
                  >
                    <p
                      class={`text-slate-400 text-sm md:text-base mt-6 leading-relaxed italic border-l-2 ${c.border20} pl-4`}
                    >
                      {item.respuesta}
                    </p>
                  </div>
                </div>
              );
            })
          }
        </div>
      </section>
    </main>

    <Footer />

    <script
      define:vars={{ apiUrl: data.price?.apiUrl, apiPath: data.price?.apiPath }}
    >
      async function updatePrice() {
        if (!apiUrl) return;
        try {
          const res = await fetch(apiUrl);
          const apiData = await res.json();
          const price = apiPath
            .split(".")
            .reduce((obj, key) => obj[key], apiData);

          const priceEl = document.getElementById("asset-price");
          if (priceEl) {
            priceEl.textContent =
              "$" + price.toLocaleString("en-US", { minimumFractionDigits: 2 });
          }

          const fdvEl = document.getElementById("asset-fdv");
          if (fdvEl) {
            const supplyRaw = fdvEl.getAttribute("data-supply");
            if (supplyRaw) {
              const supply = Number(supplyRaw.replace(/,/g, ""));
              const fdv = price * supply;
              fdvEl.classList.remove("animate-pulse");
              fdvEl.textContent = new Intl.NumberFormat("en-US", {
                style: "currency",
                currency: "USD",
                notation: "compact",
                maximumFractionDigits: 2,
              }).format(fdv);
            }
          }
        } catch (e) {
          console.error("Error consultando API:", e);
        }
      }
      updatePrice();
      setInterval(updatePrice, 3600000);

      const btnVerMas = document.getElementById("btn-ver-mas-dato");
      const btnCerrar = document.getElementById("btn-cerrar-dato");
      const overlay = document.getElementById("dato-oculto-overlay");
      const mainContent = document.getElementById("dato-oculto-content");

      if (btnVerMas && btnCerrar && overlay) {
        btnVerMas.addEventListener("click", () => {
          overlay.classList.remove(
            "opacity-0",
            "pointer-events-none",
            "scale-95",
          );
          overlay.classList.add(
            "opacity-100",
            "pointer-events-auto",
            "scale-100",
          );
          mainContent.classList.add("opacity-0", "pointer-events-none");
        });
        btnCerrar.addEventListener("click", () => {
          overlay.classList.remove(
            "opacity-100",
            "pointer-events-auto",
            "scale-100",
          );
          overlay.classList.add("opacity-0", "pointer-events-none", "scale-95");
          mainContent.classList.remove("opacity-0", "pointer-events-none");
        });
      }
    </script>

    <script is:inline>
      function toggleFaq(id) {
        const ans = document.getElementById(`ans-${id}`);
        const icon = document.getElementById(`icon-${id}`);
        const isClosed =
          ans.style.maxHeight === "0px" || ans.style.maxHeight === "";

        document
          .querySelectorAll(".faq-content")
          .forEach((el) => (el.style.maxHeight = "0px"));
        document
          .querySelectorAll(".icon-rotate")
          .forEach((el) => (el.style.transform = "rotate(0deg)"));

        if (isClosed) {
          ans.style.maxHeight = ans.scrollHeight + "px";
          icon.style.transform = "rotate(180deg)";
        }
      }
    </script>
  </body>
</html>
