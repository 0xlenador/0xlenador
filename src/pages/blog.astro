---
import Layout from "../layouts/Layout.astro"
import { getBlogPostsByLang } from "../lib/content"
import BlogView from "../components/views/BlogView.astro"
import { getLangFromUrl, useTranslations } from "../i18n/utils"

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)

// Solo posts en español — ya vienen ordenados por fecha desc desde el helper
const [featuredPost, ...regularPosts] = await getBlogPostsByLang("es")

const seo = {
  title: t("blog.seo.title"),
  description: t("blog.seo.description"),
  url: "https://0xlenador.xyz/blog",
  image: "/img/meta/blog.webp",
}
---

<Layout title={seo.title} description={seo.description} image={seo.image}>
  <BlogView featuredPost={featuredPost} regularPosts={regularPosts} />
</Layout>
