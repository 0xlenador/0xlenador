  <script
    is:inline
    src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js"
  ></script>
  <script is:inline>
    // LÓGICA CALCULADORA 60/40
    let portfolioChart = null;

    function initChart() {
      const ctx = document.getElementById("chartPortfolio").getContext("2d");
      portfolioChart = new Chart(ctx, {
        type: "doughnut",
        data: {
          labels: [
            "Renta Fija / ETFs",
            "Liquidez / Bluechip",
            "Cripto / ETFs Arriesgados",
            "Startups / Garaje",
          ],
          datasets: [
            {
              data: [4000, 2000, 2500, 1500],
              backgroundColor: ["#06b6d4", "#22d3ee", "#10b981", "#34d399"],
              borderColor: "#020617",
              borderWidth: 3,
              hoverBorderColor: "#1e293b",
              hoverOffset: 6,
            },
          ],
        },
        options: {
          responsive: true,
          maintainAspectRatio: true,
          cutout: "72%",
          plugins: {
            legend: { display: false },
            tooltip: {
              backgroundColor: "#0f172a",
              titleColor: "#e2e8f0",
              bodyColor: "#94a3b8",
              borderColor: "#1e293b",
              borderWidth: 1,
              cornerRadius: 10,
              padding: 12,
              titleFont: {
                family: "ui-monospace, monospace",
                size: 11,
                weight: "bold",
              },
              bodyFont: { family: "ui-monospace, monospace", size: 10 },
              callbacks: {
                label: function (ctx) {
                  const fmt = new Intl.NumberFormat("en-US", {
                    style: "currency",
                    currency: "USD",
                    maximumFractionDigits: 0,
                  });
                  const total = ctx.dataset.data.reduce((a, b) => a + b, 0);
                  const pct =
                    total > 0 ? ((ctx.parsed / total) * 100).toFixed(1) : 0;
                  return " " + fmt.format(ctx.parsed) + " (" + pct + "%)";
                },
              },
            },
          },
          animation: {
            animateRotate: true,
            duration: 600,
            easing: "easeOutQuart",
          },
        },
      });
    }

    function liveUpdate(val) {
      const capital = parseFloat(val) || 0;
      const cons = capital * 0.6;
      const arr = capital * 0.4;
      const rentaFija = capital * 0.4;
      const liquidez = capital * 0.2;
      const cripto = capital * 0.25;
      const startups = capital * 0.15;

      const fmt = new Intl.NumberFormat("en-US", {
        style: "currency",
        currency: "USD",
        maximumFractionDigits: 0,
      });

      document.getElementById("totalCons").innerText = fmt.format(cons);
      document.getElementById("totalArr").innerText = fmt.format(arr);
      document.getElementById("totalCapital").innerText = fmt.format(capital);
      document.getElementById("subRentaFija").innerText = fmt.format(rentaFija);
      document.getElementById("subLiquidez").innerText = fmt.format(liquidez);
      document.getElementById("subCripto").innerText = fmt.format(cripto);
      document.getElementById("subStartups").innerText = fmt.format(startups);

      if (cons > 0) {
        document.getElementById("progRentaFija").style.width =
          (rentaFija / cons) * 100 + "%";
        document.getElementById("progLiquidez").style.width =
          (liquidez / cons) * 100 + "%";
      }
      if (arr > 0) {
        document.getElementById("progCripto").style.width =
          (cripto / arr) * 100 + "%";
        document.getElementById("progStartups").style.width =
          (startups / arr) * 100 + "%";
      }

      if (portfolioChart) {
        portfolioChart.data.datasets[0].data = [
          rentaFija,
          liquidez,
          cripto,
          startups,
        ];
        portfolioChart.update("active");
      }

      const centerLabel = document.getElementById("chartCenterLabel");
      if (centerLabel) centerLabel.innerText = fmt.format(capital);
    }

    function setCapital(amount) {
      document.getElementById("capitalInput").value = amount;
      document.getElementById("capitalRange").value = amount;
      liveUpdate(amount);

      document.querySelectorAll(".sim-preset-btn").forEach((btn) => {
        btn.classList.replace("bg-emerald-500/20", "bg-slate-800");
        btn.classList.replace("text-emerald-400", "text-slate-300");
        btn.classList.replace("border-emerald-500/30", "border-transparent");
        btn.classList.remove("sim-preset-active");
      });
      event.target.classList.add("sim-preset-active");
      event.target.classList.replace("bg-slate-800", "bg-emerald-500/20");
      event.target.classList.replace("text-slate-300", "text-emerald-400");
      event.target.classList.replace(
        "border-transparent",
        "border-emerald-500/30",
      );
    }

    document.addEventListener("DOMContentLoaded", function () {
      const waitForChart = setInterval(function () {
        if (typeof Chart !== "undefined") {
          clearInterval(waitForChart);
          initChart();
        }
      }, 50);
    });
  </script>
</Layout>
