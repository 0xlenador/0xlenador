---
// Importamos el Layout maestro (Asegúrate de haber creado src/layouts/Layout.astro)
import Layout from "../layouts/Layout.astro";
import FaqAccordion from "../components/FaqAccordion.astro";

// Metadatos específicos de la página principal
const seo = {
  title:
    "0xLeñador | Divulgador sobre la gestión de Capital y Estrategia de Inversión 60/40",
  description:
    "Optimiza tu patrimonio con la estrategia 60/40. Gestión de capital multiactivo combinando inversiones tradicionales, ETFs y activos disruptivos como Cripto y Startups.",
};

// Datos estructurados (Knowledge Graph de Google)
const schema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "0x Leñador",
  url: "https://0xlenador.xyz/",
  image: "https://0xlenador.xyz/assets/img/44.png",
  jobTitle: "Divulgador de Inversiones y Web3",
  description:
    "Creador de contenido enfocado en la gestión de capital, estrategias de inversión 60/40 y ecosistema cripto.",
  sameAs: [
    "https://www.youtube.com/@0xlenadorgamefi",
    "https://x.com/0xlenador",
    "https://t.me/zero0xlenador",
  ],
};
---

<Layout title={seo.title} description={seo.description} schema={schema}>
  <main class="max-w-6xl mx-auto px-6 pt-14 pb-20">
    <header
      class="relative max-w-4xl mx-auto mb-32 text-center overflow-hidden py-8 md:py-16"
    >
      <h1
        class="relative z-10 text-4xl md:text-5xl font-black text-white mb-8 tracking-tighter uppercase leading-none"
      >
        El valor no está en el capital, <span
          class="bg-gradient-to-r from-emerald-400 to-cyan-400 bg-clip-text text-transparent"
          >sino en el entendimiento.</span
        >
      </h1>
      <p
        class="relative z-10 text-md md:text-lg text-slate-400 font-light leading-relaxed max-w-2xl mx-auto mb-12"
      >
        Invertir sin comprender es apostar a la suerte. En <span
          class="font-semibold text-white">0xLeñador</span
        >, creemos que nuestra capacidad de involucrarnos en la lógica de un
        proyecto es lo que define nuestra resiliencia frente al mercado.
      </p>
      <div class="relative z-10 flex flex-wrap gap-4 justify-center">
        <a
          href="/tesis"
          class="px-8 py-4 bg-gradient-to-r from-emerald-500 to-cyan-500 text-slate-950 font-black uppercase tracking-widest text-xs rounded-xl hover:bg-emerald-500 transition-all italic inline-flex items-center gap-2"
        >
          <svg
            class="w-4 h-4"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            viewBox="0 0 24 24"
            ><path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25"
            ></path></svg
          >
          Leer Tesis de Investigación
        </a>
        <a
          href="#simulador-6040"
          class="px-8 py-4 border border-slate-700 text-white font-black uppercase tracking-widest text-xs rounded-xl hover:bg-slate-900 transition-all"
          >Calcula tu Inversión</a
        >
      </div>
    </header>

    <section class="grid grid-cols-1 md:grid-cols-2 gap-16 mb-40 items-center">
      <div class="space-y-8">
        <div
          class="inline-block px-3 py-1 bg-emerald-500/10 border border-emerald-500/20 rounded-full"
        >
          <span
            class="text-[10px] font-mono text-emerald-500 uppercase tracking-[0.3em]"
            >Nuestra Premisa</span
          >
        </div>
        <h2
          class="text-3xl md:text-4xl font-bold text-white tracking-tight leading-tight"
        >
          Involucrarse es la única <br /> forma de <span
            class="italic text-slate-500">mantener el carácter</span
          >.
        </h2>
        <p class="text-slate-400 leading-relaxed text-lg">
          La volatilidad es el filtro que expulsa a quienes solo buscan retornos
          rápidos. El entendimiento profundo de la tecnología y la economía de
          un activo nos otorga la convicción necesaria para operar con frialdad
          matemática cuando otros dudan.
        </p>
        <blockquote
          class="border-l-2 border-emerald-500 pl-6 italic text-slate-300"
        >
          "Vale más lo que comprendemos del proyecto que el capital que
          depositamos en él."
        </blockquote>
      </div>

      <div
        class="bg-slate-900/20 border border-slate-800 p-10 rounded-[3rem] relative overflow-hidden group"
      >
        <div
          class="absolute -top-24 -right-24 w-64 h-64 bg-emerald-500/5 blur-[100px] group-hover:bg-emerald-500/10 transition-all"
        >
        </div>
        <div class="space-y-6 relative z-10 font-mono">
          <div class="flex justify-between border-b border-slate-800 pb-4">
            <span class="text-slate-600 text-xs">SISTEMA</span>
            <span class="text-emerald-500 text-xs">ONLINE</span>
          </div>
          <div class="text-xs space-y-4">
            <p class="text-slate-500 text-[10px] uppercase">
              Protocolo de ejecución:
            </p>
            <p class="text-white">> Investigar fundamentos económicos.</p>
            <p class="text-white">> Validar infraestructura tecnológica.</p>
            <p class="text-white">> Analizar asimetría de riesgo.</p>
            <p class="text-white">> Ejecutar con carácter (Convención).</p>
          </div>
        </div>
      </div>
    </section>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-32">
      <div
        class="p-8 bg-slate-900/10 border border-slate-900 rounded-3xl hover:border-slate-800 transition-all"
      >
        <div
          class="w-10 h-10 bg-emerald-500/10 rounded-lg flex items-center justify-center mb-6"
        >
          <svg
            class="w-5 h-5 text-emerald-500"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            ><path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
            ></path></svg
          >
        </div>
        <h3 class="text-white font-bold mb-4 uppercase tracking-tighter italic">
          Investigación
        </h3>
        <p class="text-xs leading-relaxed text-slate-500">
          No seguimos narrativas. Analizamos los datos on-chain y los
          fundamentos de los proyectos para entender su valor real antes de
          actuar.
        </p>
      </div>
      <div
        class="p-8 bg-slate-900/10 border border-slate-900 rounded-3xl hover:border-slate-800 transition-all"
      >
        <div
          class="w-10 h-10 bg-emerald-500/10 rounded-lg flex items-center justify-center mb-6"
        >
          <svg
            class="w-5 h-5 text-emerald-500"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            ><path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg
          >
        </div>
        <h3 class="text-white font-bold mb-4 uppercase tracking-tighter italic">
          Convicción
        </h3>
        <p class="text-xs leading-relaxed text-slate-500">
          Invertir con carácter significa no ser desplazados por el ruido. La
          convicción es el resultado directo de una investigación exhaustiva.
        </p>
      </div>
      <div
        class="p-8 bg-slate-900/10 border border-slate-900 rounded-3xl hover:border-slate-800 transition-all"
      >
        <div
          class="w-10 h-10 bg-emerald-500/10 rounded-lg flex items-center justify-center mb-6"
        >
          <svg
            class="w-5 h-5 text-emerald-500"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            ><path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"
            ></path></svg
          >
        </div>
        <h3 class="text-white font-bold mb-4 uppercase tracking-tighter italic">
          Asimetría
        </h3>
        <p class="text-xs leading-relaxed text-slate-500">
          Buscamos escenarios donde el entendimiento nos permita posicionarnos
          en activos con un potencial de retorno desproporcionado frente al
          riesgo.
        </p>
      </div>
    </div>

    <section id="simulador-6040" class="max-w-4xl mx-auto mb-12 scroll-mt-24">
      <div class="text-center mb-12">
        <div
          class="inline-block px-3 py-1 bg-emerald-500/10 border border-emerald-500/20 rounded-full mb-6"
        >
          <span
            class="text-[10px] font-mono text-emerald-500 uppercase tracking-[0.3em]"
            >Simulador Interactivo</span
          >
        </div>
        <h2
          class="text-3xl md:text-4xl font-bold text-white tracking-tight leading-tight"
        >
          Estrategia <span
            class="bg-gradient-to-r from-emerald-400 to-cyan-400 bg-clip-text text-transparent italic"
            >60 / 40</span
          >
        </h2>
        <p
          class="text-slate-400 text-sm mt-4 max-w-2xl mx-auto leading-relaxed"
        >
          Una vez que comprendes tu perfil de riesgo y la naturaleza de cada
          activo, estás listo para invertir con carácter y convicción para tu
          futuro. Aquí te presentamos el estándar de distribución bajo la tesis
          de 0xLeñador.
        </p>
      </div>

      <div
        class="bg-slate-900/40 border border-slate-800 rounded-3xl p-8 md:p-10 shadow-2xl"
      >
        <div class="mb-8">
          <label
            for="capitalInput"
            class="block text-[10px] font-mono text-slate-500 uppercase tracking-widest mb-3"
            >Capital a distribuir (USD)</label
          >
          <div class="flex items-center gap-3">
            <span class="text-emerald-500 font-mono text-xl font-bold">$</span>
            <input
              id="capitalInput"
              type="number"
              min="0"
              step="100"
              value="10000"
              placeholder="10000"
              oninput="liveUpdate(this.value); document.getElementById('capitalRange').value = this.value"
              class="w-full bg-slate-950 border border-slate-800 focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500 outline-none rounded-xl px-4 py-3.5 text-white text-xl font-mono tracking-wide transition-all"
            />
          </div>
          <style>
            input[type="range"]::-webkit-slider-thumb {
              background: #10b981;
              cursor: pointer;
            }
          </style>
          <input
            id="capitalRange"
            type="range"
            min="0"
            max="1000000"
            step="500"
            value="10000"
            oninput="liveUpdate(this.value); document.getElementById('capitalInput').value = this.value"
            class="w-full mt-4 cursor-pointer accent-emerald-500 h-1.5 bg-slate-800 rounded-lg appearance-none"
          />

          <div class="flex flex-wrap gap-2 mt-4">
            <button
              onclick="setCapital(5000)"
              class="sim-preset-btn px-4 py-2 bg-slate-800 hover:bg-slate-700 text-slate-300 rounded-lg text-sm transition-colors border border-transparent font-mono"
              >$5K</button
            >
            <button
              onclick="setCapital(10000)"
              class="sim-preset-btn sim-preset-active px-4 py-2 bg-emerald-500/20 hover:bg-emerald-500/30 text-emerald-400 border border-emerald-500/30 rounded-lg text-sm transition-colors font-mono"
              >$10K</button
            >
            <button
              onclick="setCapital(25000)"
              class="sim-preset-btn px-4 py-2 bg-slate-800 hover:bg-slate-700 text-slate-300 rounded-lg text-sm transition-colors border border-transparent font-mono"
              >$25K</button
            >
            <button
              onclick="setCapital(50000)"
              class="sim-preset-btn px-4 py-2 bg-slate-800 hover:bg-slate-700 text-slate-300 rounded-lg text-sm transition-colors border border-transparent font-mono"
              >$50K</button
            >
            <button
              onclick="setCapital(100000)"
              class="sim-preset-btn px-4 py-2 bg-slate-800 hover:bg-slate-700 text-slate-300 rounded-lg text-sm transition-colors border border-transparent font-mono"
              >$100K</button
            >
            <button
              onclick="setCapital(500000)"
              class="sim-preset-btn px-4 py-2 bg-slate-800 hover:bg-slate-700 text-slate-300 rounded-lg text-sm transition-colors border border-transparent font-mono"
              >$500K</button
            >
          </div>
        </div>

        <div class="mb-8">
          <div class="flex rounded-xl overflow-hidden h-3 bg-slate-900">
            <div
              id="barCons"
              class="bg-gradient-to-r from-cyan-500 to-cyan-400 transition-all duration-500 ease-out"
              style="width: 60%"
            >
            </div>
            <div
              id="barArr"
              class="bg-gradient-to-r from-emerald-500 to-emerald-400 transition-all duration-500 ease-out"
              style="width: 40%"
            >
            </div>
          </div>
          <div class="flex justify-between mt-2">
            <span class="text-[10px] font-mono text-cyan-400">60% Escudo</span>
            <span class="text-[10px] font-mono text-emerald-400"
              >40% Espada</span
            >
          </div>
        </div>

        <div class="flex flex-col items-center mb-10">
          <div class="relative w-56 h-56 md:w-64 md:h-64">
            <canvas id="chartPortfolio"></canvas>
            <div
              class="absolute inset-0 flex flex-col items-center justify-center pointer-events-none"
            >
              <span
                class="text-[9px] font-mono text-slate-500 uppercase tracking-widest"
                >Total</span
              >
              <span
                id="chartCenterLabel"
                class="text-xl md:text-2xl font-black text-white font-mono"
                >$10,000</span
              >
            </div>
          </div>
          <div class="flex flex-wrap justify-center gap-x-5 gap-y-2 mt-5">
            <div class="flex items-center gap-1.5">
              <div class="w-2.5 h-2.5 rounded-full" style="background:#06b6d4">
              </div><span class="text-[10px] font-mono text-slate-400"
                >Renta Fija / ETFs</span
              >
            </div>
            <div class="flex items-center gap-1.5">
              <div class="w-2.5 h-2.5 rounded-full" style="background:#22d3ee">
              </div><span class="text-[10px] font-mono text-slate-400"
                >Liquidez / Bluechip</span
              >
            </div>
            <div class="flex items-center gap-1.5">
              <div class="w-2.5 h-2.5 rounded-full" style="background:#10b981">
              </div><span class="text-[10px] font-mono text-slate-400"
                >Cripto / ETFs Arriesgados</span
              >
            </div>
            <div class="flex items-center gap-1.5">
              <div class="w-2.5 h-2.5 rounded-full" style="background:#34d399">
              </div><span class="text-[10px] font-mono text-slate-400"
                >Startups / Garaje</span
              >
            </div>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-8">
          <div
            class="bg-slate-900/60 border border-slate-800 rounded-2xl p-6 relative overflow-hidden group"
          >
            <div
              class="absolute -bottom-10 -right-10 w-40 h-40 bg-cyan-500/5 blur-[80px] group-hover:bg-cyan-500/15 transition-all duration-500"
            >
            </div>
            <div class="relative z-10">
              <div class="flex items-center justify-between mb-2">
                <div class="flex items-center gap-2">
                  <div class="w-2 h-2 rounded-full bg-cyan-400"></div>
                  <span
                    class="text-[10px] font-mono text-slate-500 uppercase tracking-widest"
                    >Conservador</span
                  >
                </div>
                <span
                  class="text-[10px] font-mono text-cyan-400 bg-cyan-500/10 px-2.5 py-1 rounded-full font-bold"
                  >60%</span
                >
              </div>
              <p
                id="totalCons"
                class="text-3xl md:text-4xl font-black text-white font-mono tracking-tight my-3"
              >
                $6,000
              </p>
              <p
                class="text-[10px] text-slate-600 font-mono uppercase tracking-wide"
              >
                Escudo · Renta Fija, Bluechips, ETFs
              </p>
              <div class="mt-5 pt-4 border-t border-slate-800/50 space-y-3">
                <div class="flex items-center justify-between">
                  <div class="flex items-center gap-2">
                    <svg
                      class="w-3.5 h-3.5 text-cyan-500/60"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      viewBox="0 0 24 24"
                      ><path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M2.25 18.75a60.07 60.07 0 0115.797 2.101c.727.198 1.453-.342 1.453-1.096V18.75M3.75 4.5v.75A.75.75 0 013 6h-.75m0 0v-.375c0-.621.504-1.125 1.125-1.125H20.25M2.25 6v9m18-10.5v.75c0 .414.336.75.75.75h.75m-1.5-1.5h.375c.621 0 1.125.504 1.125 1.125v9.75c0 .621-.504 1.125-1.125 1.125h-.375m1.5-1.5H21a.75.75 0 00-.75.75v.75m0 0H3.75m0 0h-.375a1.125 1.125 0 01-1.125-1.125V15m1.5 1.5v-.75A.75.75 0 003 15h-.75M15 10.5a3 3 0 11-6 0 3 3 0 016 0zm3 0h.008v.008H18V10.5zm-12 0h.008v.008H6V10.5z"
                      ></path></svg
                    >
                    <span class="text-[10px] font-mono text-slate-500"
                      >Renta Fija / ETFs</span
                    >
                  </div>
                  <span
                    id="subRentaFija"
                    class="text-xs font-bold text-white font-mono">$4,000</span
                  >
                </div>
                <div class="w-full bg-slate-900 rounded-full h-1">
                  <div
                    id="progRentaFija"
                    class="bg-cyan-500/40 h-1 rounded-full transition-all duration-500"
                    style="width: 66.6%"
                  >
                  </div>
                </div>
                <div class="flex items-center justify-between">
                  <div class="flex items-center gap-2">
                    <svg
                      class="w-3.5 h-3.5 text-cyan-500/60"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      viewBox="0 0 24 24"
                      ><path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M12 6v12m-3-2.818l.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-.725 0-1.45-.22-2.003-.659-1.106-.879-1.106-2.303 0-3.182s2.9-.879 4.006 0l.415.33M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
                      ></path></svg
                    >
                    <span class="text-[10px] font-mono text-slate-500"
                      >Liquidez / Bluechip</span
                    >
                  </div>
                  <span
                    id="subLiquidez"
                    class="text-xs font-bold text-white font-mono">$2,000</span
                  >
                </div>
                <div class="w-full bg-slate-900 rounded-full h-1">
                  <div
                    id="progLiquidez"
                    class="bg-cyan-500/40 h-1 rounded-full transition-all duration-500"
                    style="width: 33.3%"
                  >
                  </div>
                </div>
              </div>
            </div>
          </div>

          <div
            class="bg-slate-900/60 border border-slate-800 rounded-2xl p-6 relative overflow-hidden group"
          >
            <div
              class="absolute -bottom-10 -right-10 w-40 h-40 bg-emerald-500/5 blur-[80px] group-hover:bg-emerald-500/15 transition-all duration-500"
            >
            </div>
            <div class="relative z-10">
              <div class="flex items-center justify-between mb-2">
                <div class="flex items-center gap-2">
                  <div class="w-2 h-2 rounded-full bg-emerald-400"></div>
                  <span
                    class="text-[10px] font-mono text-slate-500 uppercase tracking-widest"
                    >Crecimiento</span
                  >
                </div>
                <span
                  class="text-[10px] font-mono text-emerald-400 bg-emerald-500/10 px-2.5 py-1 rounded-full font-bold"
                  >40%</span
                >
              </div>
              <p
                id="totalArr"
                class="text-3xl md:text-4xl font-black text-white font-mono tracking-tight my-3"
              >
                $4,000
              </p>
              <p
                class="text-[10px] text-slate-600 font-mono uppercase tracking-wide"
              >
                Espada · Cripto, Startups, Asimetrías
              </p>
              <div class="mt-5 pt-4 border-t border-slate-800/50 space-y-3">
                <div class="flex items-center justify-between">
                  <div class="flex items-center gap-2">
                    <svg
                      class="w-3.5 h-3.5 text-emerald-500/60"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      viewBox="0 0 24 24"
                      ><path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z"
                      ></path></svg
                    >
                    <span class="text-[10px] font-mono text-slate-500"
                      >Cripto / ETFs Arriesgados</span
                    >
                  </div>
                  <span
                    id="subCripto"
                    class="text-xs font-bold text-white font-mono">$2,500</span
                  >
                </div>
                <div class="w-full bg-slate-900 rounded-full h-1">
                  <div
                    id="progCripto"
                    class="bg-emerald-500/40 h-1 rounded-full transition-all duration-500"
                    style="width: 62.5%"
                  >
                  </div>
                </div>
                <div class="flex items-center justify-between">
                  <div class="flex items-center gap-2">
                    <svg
                      class="w-3.5 h-3.5 text-emerald-500/60"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      viewBox="0 0 24 24"
                      ><path
                        stroke-linecap="round"
                        stroke-linejoin="round"
