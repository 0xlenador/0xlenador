---
import Layout from "../layouts/Layout.astro"
import HomeView from "../components/views/HomeView.astro"
import { getBlogPostsByLang, getGuiasByLang } from "../lib/content"
import { getLangFromUrl, useTranslations } from "../i18n/utils"

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)

// Metadatos de la página principal
const seo = {
  title: t("home.seo.title"),
  description: t("home.seo.description"),
  image: "/img/meta/home.webp",
}

// Schema Person actualizado
const schema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "0x Leñador",
  url: "https://0xlenador.xyz/",
  image: "https://0xlenador.xyz/img/44.webp",
  jobTitle: t("home.schema.jobTitle"),
  description: t("home.schema.description"),
  sameAs: [
    "https://www.youtube.com/@0xlenadorgamefi",
    "https://x.com/0xlenador",
    "https://t.me/zero0xlenador",
  ],
}

// Últimas 3 entradas del blog en español
const posts = (await getBlogPostsByLang("es")).slice(0, 3)

// Guías operativas activas en español
const guiasActivas = (await getGuiasByLang("es")).filter((g) => g.data.estado === "activa")
---

<Layout
  title={seo.title}
  description={seo.description}
  image={seo.image}
  schema={schema}
  customSpacing
>
  <HomeView posts={posts} guiasActivas={guiasActivas} />
</Layout>
