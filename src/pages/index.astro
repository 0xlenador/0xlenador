---
// Importamos el Layout maestro
import Layout from "../layouts/Layout.astro";
import FaqAccordion from "../components/FaqAccordion.astro";
import HeroSection from "../components/home/HeroSection.astro";
import PremisaSection from "../components/home/PremisaSection.astro";
import FeatureCards from "../components/home/FeatureCards.astro";
import SimuladorChart from "../components/home/SimuladorChart.astro";

// Metadatos específicos de la página principal
const seo = {
  title:
    "0xLeñador | Divulgador sobre la gestión de Capital y Estrategia de Inversión 60/40",
  description:
    "Optimiza tu patrimonio con la estrategia 60/40. Gestión de capital multiactivo combinando inversiones tradicionales, ETFs y activos disruptivos como Cripto y Startups.",
};

// Datos estructurados (Knowledge Graph de Google)
const schema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "0x Leñador",
  url: "https://0xlenador.xyz/",
  image: "https://0xlenador.xyz/assets/img/44.png",
  jobTitle: "Divulgador de Inversiones y Web3",
  description:
    "Creador de contenido enfocado en la gestión de capital, estrategias de inversión 60/40 y ecosistema cripto.",
  sameAs: [
    "https://www.youtube.com/@0xlenadorgamefi",
    "https://x.com/0xlenador",
    "https://t.me/zero0xlenador",
  ],
};

// Datos de las tarjetas de features
const features = [
  {
    iconPath:
      "M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z",
    titulo: "Investigación",
    descripcion:
      "No seguimos narrativas. Analizamos los datos on-chain y los fundamentos de los proyectos para entender su valor real antes de actuar.",
  },
  {
    iconPath: "M13 10V3L4 14h7v7l9-11h-7z",
    titulo: "Convicción",
    descripcion:
      "Invertir con carácter significa no ser desplazados por el ruido. La convicción es el resultado directo de una investigación exhaustiva.",
  },
  {
    iconPath:
      "M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z",
    titulo: "Asimetría",
    descripcion:
      "Buscamos escenarios donde el entendimiento nos permita posicionarnos en activos con un potencial de retorno desproporcionado frente al riesgo.",
  },
];

// Datos del FAQ
const faqItems = [
  {
    pregunta: "¿Por qué el entendimiento vale más que el capital?",
    respuesta:
      "El capital sin conocimiento es efímero. Cuando comprendes la lógica económica de un activo, el precio se vuelve secundario; ese entendimiento es lo que te otorga la convicción necesaria para operar con frialdad cuando otros dudan.",
  },
  {
    pregunta: '¿Qué significa "investigar con carácter"?',
    respuesta:
      "Es el compromiso de involucrarse en la tecnología y los números de un proyecto hasta dominar sus riesgos. El carácter no es otra cosa que la seguridad resultante de una investigación exhaustiva que te impide ser desplazado por la volatilidad.",
  },
  {
    pregunta: "¿Este sitio ofrece señales o consejos de compra?",
    respuesta:
      "Absolutamente no. 0xLeñador es un ecosistema de investigación y análisis técnico. Nuestra meta es compartir metodologías de pensamiento crítico para que cada individuo construya su propia convicción operativa.",
  },
  {
    pregunta: "¿Qué encontrarás en nuestro sitio?",
    respuesta:
      "Accederás a nuestra tesis de inversión detallada, herramientas de cálculo como la terminal de valor intrínseco y un panel de observación de activos que abarca desde el ecosistema Web3 hasta mercados tradicionales.",
  },
];
---

<Layout
  title={seo.title}
  description={seo.description}
  schema={schema}
  customSpacing
>
  <main class="max-w-6xl mx-auto px-6 pt-14 pb-20">
    <HeroSection
      phrases={[
        "El valor no está en el capital",
        "sino en el entendimiento",
        "aprende lo nuevo",
        "usa nuestras herramientas",
        "o herramientas externas",
        "Aquí solo divulgamos",
        "para comprender el futuro",
      ]}
      ctaPrimario={{ texto: "Nuestra Tesis", href: "/tesis" }}
      ctaSecundario={{ texto: "Calcula tu Inversión", href: "#simulador-6040" }}
    />

    <PremisaSection />

    <FeatureCards items={features} />

    <SimuladorChart />

    <FaqAccordion
      titulo="Preguntas Frecuentes"
      subtitulo="Entendiendo la mentalidad de investigación"
      startId={101}
      items={faqItems}
    />

    <div class="mt-20 text-center">
      <p
        class="text-slate-600 text-[10px] font-bold uppercase tracking-[0.3em] mb-4"
      >
        Research & Conviction Protocol
      </p>
      <div class="h-1 w-12 bg-emerald-500/20 mx-auto rounded-full"></div>
    </div>
  </main>
</Layout>
