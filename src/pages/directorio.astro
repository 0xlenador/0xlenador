---
import Layout from "../layouts/Layout.astro";
import FaqAccordion from "../components/FaqAccordion.astro";

import directoryData from "../data/directory.json";
import faucetsData from "../data/faucets.json";

const seo = {
  title: "Directorio Web3 | 0xLeñador — Exchanges, Wallets y Exploradores",
  description:
    "Directorio curado de plataformas y recursos Web3 en uso activo: exchanges, wallets, exploradores de bloques, herramientas de análisis y faucets.",
  image: "/img/meta/home.webp",
};

// Categorías únicas del directorio, ordenadas
const tags = [...new Set(directoryData.map((item) => item.tag))].sort();

// Estadísticas de faucets para el bloque resumen
const testnetCount = faucetsData.filter((f) => f.type === "testnet").length;
const mainnetCount = faucetsData.filter((f) => f.type === "mainnet").length;

// Redes más cubiertas: contar frecuencia de cada tag en faucets
const tagFrequency: Record<string, number> = {};
faucetsData.forEach((f) => {
  f.tags.forEach((tag) => {
    tagFrequency[tag] = (tagFrequency[tag] || 0) + 1;
  });
});
const topNetworks = Object.entries(tagFrequency)
  .sort((a, b) => b[1] - a[1])
  .slice(0, 5)
  .map(([name, count]) => ({ name, count }));

const faqItems = [
  {
    pregunta: "¿Qué criterios usa 0xLeñador para incluir un recurso en el directorio?",
    respuesta:
      "Cada recurso debe estar en uso activo por 0xLeñador o haber sido evaluado directamente. Se priorizan plataformas con reputación comprobada, historial de seguridad limpio y relevancia operativa para el ecosistema Web3. No se incluyen proyectos sin track record o con señales de riesgo.",
  },
  {
    pregunta: "¿Qué significa el badge 'patrocinado'?",
    respuesta:
      "Indica que el enlace contiene un código de referido de 0xLeñador. Si te registras o compras a través de ese enlace, 0xLeñador puede recibir una comisión. Esto no afecta el precio que pagas ni implica un respaldo incondicional del servicio: la inclusión siempre está sujeta a los mismos criterios de calidad.",
  },
  {
    pregunta: "¿Cómo puedo sugerir un recurso para el directorio?",
    respuesta:
      "Puedes contactar a 0xLeñador a través de Telegram o X (@0xlenador). Los recursos sugeridos pasan por evaluación de seguridad y utilidad antes de ser añadidos. Las solicitudes con mayor demanda de la comunidad se priorizan.",
  },
];
---

<Layout title={seo.title} description={seo.description} image={seo.image}>
  <main class="max-w-6xl mx-auto px-6 pt-10 pb-20">

    <!-- Breadcrumb -->
    <p class="text-[10px] font-mono text-emerald-500/70 uppercase tracking-[0.4em] mb-6">
      Hub / Directorio
    </p>

    <!-- Header -->
    <header class="mb-12 border-b border-terminal-border/50 pb-8">
      <h1 class="text-4xl md:text-5xl font-extrabold text-white tracking-tight mb-3">
        Directorio <span class="text-emerald-500">Web3</span>
      </h1>
      <p class="text-terminal-secondary text-sm leading-relaxed max-w-2xl font-light">
        Plataformas y recursos curados en uso operativo activo. Exchanges, wallets de custodia
        propia, exploradores de bloques, herramientas de análisis y acceso al directorio de faucets.
      </p>
    </header>

    <!-- ─── SECCIÓN 1: Recursos y Plataformas ─── -->
    <section class="mb-20">
      <div class="flex items-center gap-4 mb-6">
        <h2 class="text-[10px] font-mono text-terminal-muted uppercase tracking-[0.5em] whitespace-nowrap">
          Recursos y Plataformas
        </h2>
        <div class="h-px flex-grow bg-terminal-border/40"></div>
        <span class="text-[10px] font-mono text-terminal-muted whitespace-nowrap">
          {directoryData.length} recursos
        </span>
      </div>

      <!-- Filtros -->
      <div class="flex flex-wrap gap-2 mb-8" id="dir-filter-bar">
        <button class="badge badge-active filter-btn" data-filter="all" id="dir-filter-all">
          Todos
        </button>
        {tags.map((tag) => (
          <button
            class="badge filter-btn bg-terminal-surface/60 text-terminal-muted border border-terminal-border hover:border-emerald-500/40 hover:text-emerald-400 transition-colors"
            data-filter={tag}
          >
            {tag}
          </button>
        ))}
      </div>

      <!-- Grid de recursos -->
      <div
        class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 xl:grid-cols-6 gap-3"
        id="dir-grid"
      >
        {directoryData.map((item) => (
          <a
            href={item.url}
            target="_blank"
            rel="noopener noreferrer"
            data-tag={item.tag}
            id={`dir-${item.id}`}
            class="group flex flex-col items-center gap-2.5 p-4 rounded-2xl bg-white/[0.02] border border-white/[0.05] hover:border-white/[0.1] hover:bg-white/[0.04] transition-all duration-300 no-underline text-center relative overflow-hidden hover:shadow-[0_4px_20px_rgba(0,0,0,0.3)]"
          >
            <!-- Shimmer line on hover -->
            <div class="absolute top-0 inset-x-0 h-px bg-gradient-to-r from-transparent via-white/[0.08] to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>

            <img
              src={item.logo}
              alt={item.alt_logo}
              width={40}
              height={40}
              loading="lazy"
              class="w-10 h-10 object-contain rounded-xl"
            />
            <div>
              <p class="text-white text-xs font-semibold leading-tight group-hover:text-emerald-400 transition-colors duration-300">
                {item.name}
              </p>
              <p class="text-terminal-muted text-[9px] mt-0.5 font-mono">{item.tag}</p>
            </div>
            {item.sponsored && (
              <span class="text-[8px] font-mono text-emerald-500/40 uppercase tracking-wider">
                ref
              </span>
            )}
          </a>
        ))}
      </div>
    </section>

    <!-- ─── SECCIÓN 2: Bloque Resumen Faucets ─── -->
    <section class="mb-20">
      <div class="flex items-center gap-4 mb-6">
        <h2 class="text-[10px] font-mono text-terminal-muted uppercase tracking-[0.5em] whitespace-nowrap">
          Faucets Directory
        </h2>
        <div class="h-px flex-grow bg-terminal-border/40"></div>
      </div>

      <div class="bg-white/[0.02] border border-white/[0.05] rounded-2xl p-6 md:p-8">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
          <!-- Stat: Total -->
          <div class="text-center md:text-left">
            <p class="text-3xl font-black text-white font-mono">{faucetsData.length}</p>
            <p class="text-[10px] font-mono text-terminal-muted uppercase tracking-widest mt-1">Faucets indexados</p>
          </div>
          <!-- Stat: Testnet -->
          <div class="text-center md:text-left">
            <p class="text-3xl font-black text-yellow-400 font-mono">{testnetCount}</p>
            <p class="text-[10px] font-mono text-terminal-muted uppercase tracking-widest mt-1">Testnet (tokens de prueba)</p>
          </div>
          <!-- Stat: Mainnet -->
          <div class="text-center md:text-left">
            <p class="text-3xl font-black text-amber-500 font-mono">{mainnetCount}</p>
            <p class="text-[10px] font-mono text-terminal-muted uppercase tracking-widest mt-1">Mainnet (con referido)</p>
          </div>
        </div>

        <!-- Redes más cubiertas -->
        <div class="border-t border-white/[0.05] pt-6 mb-8">
          <p class="text-[10px] font-mono text-terminal-muted uppercase tracking-widest mb-3">
            Redes más cubiertas
          </p>
          <div class="flex flex-wrap gap-2">
            {topNetworks.map((net) => (
              <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-terminal-surface/50 border border-terminal-border text-xs text-terminal-secondary font-mono">
                {net.name}
                <span class="text-[9px] text-terminal-muted">×{net.count}</span>
              </span>
            ))}
          </div>
        </div>

        <!-- CTA -->
        <a
          href="/faucets"
          id="faucets-cta-link"
          class="group inline-flex items-center gap-3 px-6 py-3 rounded-xl bg-terminal-surface/60 border border-terminal-border hover:border-emerald-500/50 hover:bg-terminal-surface transition-all duration-300 no-underline"
        >
          <span class="text-sm font-semibold text-white group-hover:text-emerald-400 transition-colors">
            Ver directorio completo de Faucets
          </span>
          <svg class="w-4 h-4 text-terminal-muted group-hover:text-emerald-400 transition-all duration-300 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
          </svg>
        </a>
      </div>
    </section>

    <!-- FAQ -->
    <div class="border-t border-terminal-border/60 pt-14">
      <h2 class="text-xl font-bold text-white tracking-tight mb-1">Sobre el Directorio</h2>
      <p class="text-xs text-terminal-subtle mb-8">Criterios de curación y uso operativo.</p>
      <FaqAccordion
        titulo="Preguntas del Directorio"
        subtitulo="Criterios y recursos"
        startId={500}
        items={faqItems}
      />
    </div>

  </main>
</Layout>

<script>
  const setupDirectoryFilter = () => {
    const buttons = document.querySelectorAll<HTMLButtonElement>(".filter-btn");
    const cards = document.querySelectorAll<HTMLAnchorElement>("#dir-grid a[data-tag]");

    buttons.forEach((btn) => {
      btn.addEventListener("click", () => {
        const filter = btn.dataset.filter;

        buttons.forEach((b) => {
          b.classList.remove("badge-active");
          b.classList.add("bg-terminal-surface/60", "text-terminal-muted");
        });
        btn.classList.add("badge-active");
        btn.classList.remove("bg-terminal-surface/60", "text-terminal-muted");

        cards.forEach((card) => {
          const show = filter === "all" || card.dataset.tag === filter;
          card.style.display = show ? "" : "none";
        });
      });
    });
  };

  setupDirectoryFilter();
  document.addEventListener("astro:page-load", setupDirectoryFilter);
</script>
