---
import Layout from "../layouts/Layout.astro"
import { Icon } from "astro-icon/components"
import Slider from "../components/Slider.astro"

const heroSlides = [
  {
    tag: "Gaming",
    title: "Yakkamon Hub",
    description: "Calculadoras, guías y herramientas de cría para maximizar tus rendimientos en el ecosistema de Yakkamon.",
    url: "/yakkamon",
    urlText: "Visitar Hub",
    icon: "lucide:swords",
    image: "/img/cripto/yakkamon.webp"
  },
  {
    tag: "Recursos",
    title: "Directorio de Faucets",
    description: "Lista curada de sitios web (faucets). Consigue tokens testnet para desarrollo y algunos en mainnet.",
    url: "/faucets",
    urlText: "Obtener Tokens",
    icon: "lucide:droplet",
    images: [
      "/img/cripto/optimism.webp",
      "/img/cripto/circle.webp",
      "/img/cripto/alchemy.webp",
      "/img/cripto/bitcoin.webp",
      "/img/cripto/google.webp",
      "/img/cripto/quicknode.webp"
    ]
  },
  {
    tag: "Guías",
    title: "Operaciones Activas",
    description: "Descubre en qué proyectos estamos operando y cómo hacerlo. Sigue nuestras guías paso a paso y estrategias para interactuar on-chain.",
    url: "/operaciones",
    urlText: "Explorar Guías",
    icon: "lucide:book-open",
    guides: [
      { logo: "/img/cripto/arc.webp" },
      { logo: "/img/cripto/polymarket.webp" },
      { logo: "/img/cripto/yakkamon.webp" }
    ]
  }
];

const seo = {
  title: "Directorio | 0x Leñador",
  description: "Tu puerta de entrada al ecosistema. Explora calculadoras, análisis profundos y todas las herramientas para tu operativa on-chain.",
  image: "/img/meta/home.webp",
}

const pageSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": seo.title,
  "description": seo.description,
  "url": "https://0xlenador.xyz/directorio/",
  "publisher": {
    "@type": "Organization",
    "name": "0x Leñador",
    "logo": {
      "@type": "ImageObject",
      "url": "https://0xlenador.xyz/img/logo.png"
    }
  }
}
---

<Layout title={seo.title} description={seo.description} image={seo.image} schema={pageSchema}>
  <main class="relative max-w-6xl mx-auto px-6 pt-12 pb-32">
    <!-- Ambient Background Glow -->
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-full max-w-3xl h-[400px] bg-emerald-500/5 blur-[120px] rounded-full pointer-events-none -z-10"></div>

    <!-- Hero Section -->
    <header class="flex flex-col items-center text-center mb-10">
      <!-- H1 aplicando regla de jerarquía estricta -->
      <h1 class="text-xl md:text-2xl font-bold text-white tracking-tight mb-4">
        Directorio de <span class="text-emerald-500">0x Leñador</span>
      </h1>
    </header>

    <!-- Slider Destacados -->
    <div class="mb-10">
      <Slider slides={heroSlides} />
    </div>

    <!-- Descripción del Directorio -->
    <div class="text-center mb-16">
      <p class="text-sm text-terminal-secondary leading-relaxed max-w-2xl mx-auto">
        Tu puerta de entrada al ecosistema. Explora calculadoras diseñadas para darte ventaja estadística, análisis profundos para tus inversiones y un ecosistema completo para potenciar tu operativa. ¡Adéntrate y descubre todo lo que hemos construido!
      </p>
    </div>

    <!-- Bento Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">

      <!-- Card 1: Operaciones (Spans 2 columns) -->
      <a href="/operaciones" class="group relative overflow-hidden rounded-2xl bg-[#0a0a0a] border border-white/5 hover:border-emerald-500/30 transition-all duration-500 md:col-span-2 min-h-[300px] flex flex-col justify-end p-6 md:p-8">
        <div class="absolute inset-0 bg-gradient-to-br from-emerald-500/5 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
        
        <!-- Abstract Decoration -->
        <div class="absolute top-0 right-0 p-8 opacity-20 group-hover:opacity-50 transition-opacity duration-700">
          <svg width="160" height="120" viewBox="0 0 200 150" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M0 100 Q 40 80, 80 110 T 160 60 T 200 20" stroke="url(#paint0_linear)" stroke-width="4" stroke-linecap="round"/>
            <path d="M0 130 Q 40 110, 80 140 T 160 90 T 200 50" stroke="#ffffff" stroke-opacity="0.1" stroke-width="2" stroke-dasharray="4 4" stroke-linecap="round"/>
            <defs>
              <linearGradient id="paint0_linear" x1="0" y1="100" x2="200" y2="20" gradientUnits="userSpaceOnUse">
                <stop stop-color="#10B981" />
                <stop offset="1" stop-color="#047857" stop-opacity="0" />
              </linearGradient>
            </defs>
          </svg>
        </div>

        <div class="relative z-10 w-full md:w-3/4">
          <div class="w-10 h-10 rounded-xl bg-white/[0.03] border border-white/10 flex items-center justify-center text-white mb-4 group-hover:-translate-y-1 transition-transform duration-300">
            <Icon name="lucide:activity" class="w-5 h-5" />
          </div>
          <!-- H2 aplicando regla de jerarquía estricta -->
          <h2 class="text-lg md:text-xl font-bold text-white mb-2">Operaciones & Diario</h2>
          <p class="text-sm text-terminal-secondary mb-5">
            El campo de batalla. Descubre nuestras estrategias, guías de interacción y bitácora para operar on-chain con ventaja estadística.
          </p>
          <div class="flex items-center gap-1.5 text-[10px] font-mono text-emerald-400 uppercase tracking-widest group-hover:gap-2 transition-all">
            <span>Acceder al Dashboard</span>
            <Icon name="lucide:arrow-right" class="w-3 h-3" />
          </div>
        </div>
      </a>

      <!-- Card 2: Activos (Spans 1 column) -->
      <a href="/activos" class="group relative overflow-hidden rounded-2xl bg-[#0a0a0a] border border-white/5 hover:border-emerald-500/30 transition-all duration-500 md:col-span-1 min-h-[300px] flex flex-col p-6 md:p-8">
        <div class="absolute inset-0 bg-gradient-to-b from-transparent via-transparent to-emerald-500/10 opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
        
        <div class="w-10 h-10 rounded-xl bg-white/[0.03] border border-white/10 flex items-center justify-center text-white mb-auto group-hover:scale-110 transition-transform duration-300">
          <Icon name="lucide:coins" class="w-5 h-5" />
        </div>

        <div class="relative z-10 mt-8">
          <h2 class="text-lg md:text-xl font-bold text-white mb-2">Tesis de Activos</h2>
          <p class="text-sm text-terminal-secondary mb-5">
            No compramos por fe. Análisis fundamental sólido, métricas on-chain y evaluación de riesgo para filtrar el ruido del mercado.
          </p>
          <div class="flex items-center gap-1.5 text-[10px] font-mono text-emerald-400 uppercase tracking-widest group-hover:gap-2 transition-all">
            <span>Explorar Tokens</span>
            <Icon name="lucide:arrow-right" class="w-3 h-3" />
          </div>
        </div>
      </a>

      <!-- Card 3: Herramientas (Spans 1 column) -->
      <a href="/herramientas" class="group relative overflow-hidden rounded-2xl bg-[#0a0a0a] border border-white/5 hover:border-emerald-500/30 transition-all duration-500 md:col-span-1 min-h-[300px] flex flex-col p-6 md:p-8">
        <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_bottom_right,rgba(16,185,129,0.15),transparent)] opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>

        <!-- Abstract Decoration -->
        <div class="absolute top-6 right-6 grid grid-cols-2 gap-1.5 opacity-20 group-hover:opacity-50 transition-opacity duration-500">
          <div class="w-5 h-5 rounded-[4px] border border-white/20"></div>
          <div class="w-5 h-5 rounded-[4px] bg-white/20"></div>
          <div class="w-5 h-5 rounded-[4px] bg-white/10"></div>
          <div class="w-5 h-5 rounded-[4px] border border-emerald-500/40"></div>
        </div>

        <div class="w-10 h-10 rounded-xl bg-white/[0.03] border border-white/10 flex items-center justify-center text-white mb-auto group-hover:rotate-12 transition-transform duration-300">
          <Icon name="lucide:wrench" class="w-5 h-5" />
        </div>

        <div class="relative z-10 mt-8">
          <h2 class="text-lg md:text-xl font-bold text-white mb-2">Herramientas</h2>
          <p class="text-sm text-terminal-secondary mb-5">
            Deja de operar a ciegas. Simuladores de impermanent loss, calculadoras de yields y utilidades clave para tu supervivencia on-chain.
          </p>
          <div class="flex items-center gap-1.5 text-[10px] font-mono text-emerald-400 uppercase tracking-widest group-hover:gap-2 transition-all">
            <span>Usar Utilidades</span>
            <Icon name="lucide:arrow-right" class="w-3 h-3" />
          </div>
        </div>
      </a>

      <!-- Card 4: Lista Web3 (Spans 2 columns) -->
      <a href="/lista-web3" class="group relative overflow-hidden rounded-2xl bg-[#0a0a0a] border border-white/5 hover:border-emerald-500/30 transition-all duration-500 md:col-span-2 min-h-[300px] flex flex-col md:flex-row items-end md:items-center p-6 md:p-8">
        <div class="absolute inset-0 bg-gradient-to-l from-emerald-500/5 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
        
        <!-- Abstract Nodes -->
        <div class="absolute top-1/2 -translate-y-1/2 right-12 opacity-20 group-hover:opacity-60 transition-opacity duration-700 hidden md:block">
           <svg width="140" height="140" viewBox="0 0 180 180" fill="none" xmlns="http://www.w3.org/2000/svg">
             <circle cx="90" cy="90" r="89.5" stroke="white" stroke-opacity="0.1" stroke-dasharray="4 4"/>
             <circle cx="90" cy="90" r="60" stroke="#10B981" stroke-opacity="0.4"/>
             <circle cx="90" cy="90" r="30" fill="#10B981" fill-opacity="0.1"/>
             <circle cx="30" cy="90" r="4" fill="white"/>
             <circle cx="150" cy="90" r="4" fill="#10B981"/>
             <circle cx="90" cy="30" r="4" fill="white"/>
             <circle cx="90" cy="150" r="4" fill="#10B981"/>
             <path d="M30 90H150 M90 30V150" stroke="white" stroke-opacity="0.1"/>
           </svg>
        </div>

        <div class="relative z-10 w-full md:w-3/5">
          <div class="w-10 h-10 rounded-xl bg-white/[0.03] border border-white/10 flex items-center justify-center text-white mb-4 group-hover:bg-white/[0.08] transition-colors duration-300">
            <Icon name="lucide:globe" class="w-5 h-5" />
          </div>
          <h2 class="text-lg md:text-xl font-bold text-white mb-2">Recursos Web3</h2>
          <p class="text-sm text-terminal-secondary mb-5">
            Nuestro arsenal curado. Links a faucets, exchanges, infraestructura y todas las plataformas de análisis que conforman nuestro stack.
          </p>
          <div class="flex items-center gap-1.5 text-[10px] font-mono text-emerald-400 uppercase tracking-widest group-hover:gap-2 transition-all">
            <span>Explorar Stack</span>
            <Icon name="lucide:arrow-right" class="w-3 h-3" />
          </div>
        </div>
      </a>

      <!-- Card 5: Blog (Spans 3 columns, Banner Style) -->
      <a href="/blog" class="group relative overflow-hidden rounded-2xl bg-[#0a0a0a] border border-white/5 hover:border-emerald-500/30 transition-all duration-500 md:col-span-3 min-h-[200px] flex flex-col md:flex-row items-center p-6 md:p-8">
        <div class="absolute inset-0 bg-gradient-to-r from-transparent via-emerald-500/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>

        <div class="w-full md:w-1/2 relative z-10 pr-0 md:pr-10 mb-6 md:mb-0">
          <div class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md bg-white/[0.05] border border-white/10 text-white text-[10px] font-mono mb-3">
            <Icon name="lucide:book-open" class="w-3 h-3 text-emerald-400" />
            Educación y Análisis
          </div>
          <h2 class="text-lg md:text-xl font-bold text-white mb-2">Diario del Leñador</h2>
          <p class="text-sm text-terminal-secondary mb-5">
            Reflexiones profundas sobre el mercado, narrativas, seguridad y tutoriales paso a paso para dominar el ecosistema DeFi como un experto.
          </p>
          <div class="flex items-center gap-1.5 text-[10px] font-mono text-emerald-400 uppercase tracking-widest group-hover:gap-2 transition-all">
            <span>Leer el Blog</span>
            <Icon name="lucide:arrow-right" class="w-3 h-3" />
          </div>
        </div>

        <div class="w-full md:w-1/2 relative z-10 flex justify-end">
          <div class="w-full max-w-sm rounded-xl border border-white/5 bg-white/[0.01] p-4 opacity-50 group-hover:opacity-100 group-hover:bg-white/[0.03] transition-all duration-500">
             <div class="h-2 rounded bg-white/10 w-1/3 mb-4"></div>
             <div class="h-1.5 rounded bg-white/5 w-full mb-2"></div>
             <div class="h-1.5 rounded bg-white/5 w-5/6 mb-2"></div>
             <div class="h-1.5 rounded bg-white/5 w-4/5"></div>
             <div class="mt-4 pt-4 border-t border-white/5 flex gap-2">
                <div class="h-4 w-4 rounded-full bg-white/10"></div>
                <div class="h-2 w-16 rounded bg-white/5 mt-1"></div>
             </div>
          </div>
        </div>
      </a>
    </div>

    <!-- Índice Completo -->
    <div class="mt-16">
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-6">
        <h3 class="text-xl font-bold text-white">Índice del Ecosistema</h3>
        <div class="flex flex-col sm:flex-row items-center gap-3">
          <!-- Buscador -->
          <div class="relative w-full sm:w-64 group/search">
            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
              <Icon name="lucide:search" class="w-4 h-4 text-terminal-muted" />
            </div>
            <input
              type="text"
              id="directorySearch"
              placeholder="Buscar por nombre, categoría o descripción..."
              class="w-full bg-[#0a0a0a] border border-white/5 rounded-lg py-2 pl-9 pr-9 text-sm text-white placeholder:text-white/20 focus:outline-none focus:border-emerald-500/50 focus:ring-1 focus:ring-emerald-500/50 transition-all"
            />
            <button type="button" id="clearSearch" class="absolute inset-y-0 right-0 pr-3 flex items-center text-terminal-muted hover:text-white transition-colors hidden">
              <Icon name="lucide:x" class="w-4 h-4" />
            </button>
          </div>
          <!-- Filtros -->
          <div class="flex items-center gap-1.5 overflow-x-auto w-full sm:w-auto pb-2 sm:pb-0 hide-scrollbar">
            <button data-filter="all" class="filter-btn active px-3 py-1.5 rounded-lg text-xs font-medium bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 whitespace-nowrap transition-colors">Todos</button>
            <button data-filter="activos" class="filter-btn px-3 py-1.5 rounded-lg text-xs font-medium bg-[#0a0a0a] text-terminal-muted border border-white/5 hover:border-white/10 hover:text-white whitespace-nowrap transition-colors">Activos</button>
            <button data-filter="guias" class="filter-btn px-3 py-1.5 rounded-lg text-xs font-medium bg-[#0a0a0a] text-terminal-muted border border-white/5 hover:border-white/10 hover:text-white whitespace-nowrap transition-colors">Guías</button>
            <button data-filter="herramientas" class="filter-btn px-3 py-1.5 rounded-lg text-xs font-medium bg-[#0a0a0a] text-terminal-muted border border-white/5 hover:border-white/10 hover:text-white whitespace-nowrap transition-colors">Herramientas</button>
            <button data-filter="directorio" class="filter-btn px-3 py-1.5 rounded-lg text-xs font-medium bg-[#0a0a0a] text-terminal-muted border border-white/5 hover:border-white/10 hover:text-white whitespace-nowrap transition-colors">Directorio</button>
          </div>
        </div>
      </div>
      <div class="overflow-hidden rounded-xl border border-white/5 bg-[#0a0a0a]">
        <div class="overflow-x-auto">
          <table id="directoryTable" class="w-full text-left text-sm text-terminal-secondary">
            <thead class="bg-white/[0.02] border-b border-white/5 text-emerald-500 font-mono text-xs uppercase tracking-wider">
              <tr>
                <th scope="col" class="px-6 py-4 w-1/3">Página</th>
                <th scope="col" class="px-6 py-4">Categoría</th>
                <th scope="col" class="px-6 py-4">Descripción</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-white/5">
              <tr class="hover:bg-white/[0.02] transition-colors group">
                <td class="px-6 py-4 font-medium text-white whitespace-nowrap">
                  <a href="/activos/bitcoin" class="flex items-center gap-3 hover:text-emerald-400 transition-colors">
                    <img src="/img/cripto/bitcoin.webp" alt="Bitcoin" class="w-6 h-6 rounded-md object-cover bg-white/5" onerror="this.style.display='none'" />
                    Bitcoin
                  </a>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                  <a href="/activos" class="inline-flex items-center px-2 py-1 rounded-md bg-emerald-500/10 text-emerald-400 text-xs font-medium hover:bg-emerald-500/20 transition-colors">Activos</a>
                </td>
                <td class="px-6 py-4 group-hover:text-white/80 transition-colors">Tesis de inversión y métricas on-chain de BTC.</td>
              </tr>
              <tr class="hover:bg-white/[0.02] transition-colors group">
                <td class="px-6 py-4 font-medium text-white whitespace-nowrap">
                  <a href="/activos/ethereum" class="flex items-center gap-3 hover:text-emerald-400 transition-colors">
                    <img src="/img/cripto/ethereum.webp" alt="Ethereum" class="w-6 h-6 rounded-md object-cover bg-white/5" onerror="this.style.display='none'" />
                    Ethereum
                  </a>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                  <a href="/activos" class="inline-flex items-center px-2 py-1 rounded-md bg-emerald-500/10 text-emerald-400 text-xs font-medium hover:bg-emerald-500/20 transition-colors">Activos</a>
                </td>
                <td class="px-6 py-4 group-hover:text-white/80 transition-colors">Tesis de inversión y métricas on-chain de ETH.</td>
              </tr>
              <tr class="hover:bg-white/[0.02] transition-colors group">
                <td class="px-6 py-4 font-medium text-white whitespace-nowrap">
                  <a href="/activos/hyperliquid" class="flex items-center gap-3 hover:text-emerald-400 transition-colors">
                    <img src="/img/cripto/hyperliquid.webp" alt="Hyperliquid" class="w-6 h-6 rounded-md object-cover bg-white/5" onerror="this.style.display='none'" />
                    Hyperliquid
                  </a>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                  <a href="/activos" class="inline-flex items-center px-2 py-1 rounded-md bg-emerald-500/10 text-emerald-400 text-xs font-medium hover:bg-emerald-500/20 transition-colors">Activos</a>
                </td>
                <td class="px-6 py-4 group-hover:text-white/80 transition-colors">Tesis de inversión y métricas on-chain de HYPE.</td>
              </tr>
              <tr class="hover:bg-white/[0.02] transition-colors group">
                <td class="px-6 py-4 font-medium text-white whitespace-nowrap">
                  <a href="/activos/runestone" class="flex items-center gap-3 hover:text-emerald-400 transition-colors">
                    <img src="/img/cripto/runestone.webp" alt="Runestone" class="w-6 h-6 rounded-md object-cover bg-white/5" onerror="this.style.display='none'" />
                    Runestone
                  </a>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                  <a href="/activos" class="inline-flex items-center px-2 py-1 rounded-md bg-emerald-500/10 text-emerald-400 text-xs font-medium hover:bg-emerald-500/20 transition-colors">Activos</a>
                </td>
                <td class="px-6 py-4 group-hover:text-white/80 transition-colors">Tesis de inversión y métricas on-chain de Runestone.</td>
              </tr>
              <tr class="hover:bg-white/[0.02] transition-colors group">
                <td class="px-6 py-4 font-medium text-white whitespace-nowrap">
                  <a href="/activos/sunflowerland" class="flex items-center gap-3 hover:text-emerald-400 transition-colors">
                    <img src="/img/sunflowerland/123/flower.jpg" alt="Sunflower Land" class="w-6 h-6 rounded-md object-cover bg-white/5" onerror="this.style.display='none'" />
                    Sunflower Land
                  </a>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                  <a href="/activos" class="inline-flex items-center px-2 py-1 rounded-md bg-emerald-500/10 text-emerald-400 text-xs font-medium hover:bg-emerald-500/20 transition-colors">Activos</a>
                </td>
                <td class="px-6 py-4 group-hover:text-white/80 transition-colors">Tesis de inversión y métricas on-chain de SFL.</td>
              </tr>
              <tr class="hover:bg-white/[0.02] transition-colors group">
                <td class="px-6 py-4 font-medium text-white whitespace-nowrap">
                  <a href="/operaciones/arc-circle" class="flex items-center gap-3 hover:text-emerald-400 transition-colors">
                    <img src="/img/cripto/arc.webp" alt="Arc Testnet" class="w-6 h-6 rounded-md object-cover bg-white/5" onerror="this.style.display='none'" />
                    Arc Testnet
                  </a>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                  <a href="/operaciones" class="inline-flex items-center px-2 py-1 rounded-md bg-emerald-500/10 text-emerald-400 text-xs font-medium hover:bg-emerald-500/20 transition-colors">Guías</a>
                </td>
                <td class="px-6 py-4 group-hover:text-white/80 transition-colors">Guía operativa para interactuar con Arc Testnet.</td>
              </tr>
              <tr class="hover:bg-white/[0.02] transition-colors group">
                <td class="px-6 py-4 font-medium text-white whitespace-nowrap">
                  <a href="/operaciones/polymarket" class="flex items-center gap-3 hover:text-emerald-400 transition-colors">
                    <img src="/img/cripto/polymarket.webp" alt="Polymarket" class="w-6 h-6 rounded-md object-cover bg-white/5" onerror="this.style.display='none'" />
                    Polymarket
                  </a>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                  <a href="/operaciones" class="inline-flex items-center px-2 py-1 rounded-md bg-emerald-500/10 text-emerald-400 text-xs font-medium hover:bg-emerald-500/20 transition-colors">Guías</a>
                </td>
                <td class="px-6 py-4 group-hover:text-white/80 transition-colors">Guía paso a paso para operar en Polymarket.</td>
              </tr>
              <tr class="hover:bg-white/[0.02] transition-colors group">
                <td class="px-6 py-4 font-medium text-white whitespace-nowrap">
                  <a href="/operaciones/soneium-portal" class="flex items-center gap-3 hover:text-emerald-400 transition-colors">
                    <img src="/img/cripto/soneium.webp" alt="Soneium" class="w-6 h-6 rounded-md object-cover bg-white/5" onerror="this.style.display='none'" />
                    Soneium
                  </a>
