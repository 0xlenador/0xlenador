---
import Layout from "../layouts/Layout.astro"
import { getLangFromUrl, useTranslations } from "../i18n/utils"

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)

const seo = {
  title: "Directorio Hub | 0x Leñador",
  description: "Hub principal del directorio",
  image: "/img/meta/home.webp",
}
---

<Layout title={seo.title} description={seo.description} image={seo.image}>
  <main class="max-w-6xl mx-auto px-6 pt-10 pb-20">
    <h1 class="text-4xl md:text-5xl font-extrabold text-white tracking-tight mb-6">
      Directorio <span class="text-emerald-500">Principal</span>
    </h1>
    <p class="text-terminal-secondary text-sm">
      Esta página funcionará como el "Hub" principal del directorio.
      <br/><br/>
      <a href="/lista-web3" class="text-emerald-400 hover:underline">Ver la Lista de Sitios Web3 &rarr;</a>
    </p>
  </main>
</Layout>
