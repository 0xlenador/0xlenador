---
import Layout from "../layouts/Layout.astro";
import FaqAccordion from "../components/FaqAccordion.astro";

import directoryData from "../data/directory.json";
import faucetsData from "../data/faucets.json";

const seo = {
  title: "Directorio Web3 | 0xLeñador — Exchanges, Wallets y Exploradores",
  description:
    "Directorio curado de recursos Web3: exchanges centralizados y descentralizados, wallets de hardware y software, exploradores de bloques, faucets y herramientas de análisis.",
  image: "/img/meta/home.webp",
};

// Extraer categorías únicas del directorio
const tags = [...new Set(directoryData.map((item) => item.tag))].sort();

// Separar faucets por tipo
const mainnetFaucets = faucetsData.filter((f) => f.type === "mainnet");
const testnetFaucets = faucetsData.filter((f) => f.type === "testnet");

const faqItems = [
  {
    pregunta: "¿Todos los recursos del directorio son seguros?",
    respuesta:
      "El directorio incluye recursos curados y en uso activo por 0xLeñador. Sin embargo, siempre debes verificar la URL antes de conectar tu wallet. Los enlaces marcados como 'patrocinados' son afiliados: su inclusión no implica respaldo incondicional.",
  },
  {
    pregunta: "¿Cuál es la diferencia entre faucets mainnet y testnet?",
    respuesta:
      "Los faucets de mainnet distribuyen tokens reales de pequeño valor (para experimentación o como incentivo). Los faucets de testnet distribuyen tokens sin valor real, útiles para probar contratos inteligentes y aplicaciones descentralizadas sin arriesgar capital.",
  },
  {
    pregunta: "¿Cómo sugiero un recurso para el directorio?",
    respuesta:
      "Puedes contactar a 0xLeñador a través de Telegram o X. Los recursos son evaluados por su seguridad, utilidad y relevancia para el ecosistema Web3 antes de ser añadidos.",
  },
];
---

<Layout title={seo.title} description={seo.description} image={seo.image}>
  <main class="max-w-6xl mx-auto px-6 pt-10 pb-20">
    <!-- Header -->
    <header class="mb-16">
      <p class="text-[10px] font-mono text-emerald-500/70 uppercase tracking-[0.4em] mb-3">
        Hub / Directorio
      </p>
      <h1 class="text-4xl md:text-5xl font-black text-white tracking-tighter mb-4">
        Directorio <span class="text-emerald-500">Web3</span>
      </h1>
      <p class="text-terminal-secondary text-sm leading-relaxed max-w-2xl">
        Recursos curados y en uso activo. Exchanges, wallets, exploradores y faucets
        organizados para el flujo operativo diario.
      </p>
    </header>

    <!-- ─── SECCIÓN: DIRECTORIO PRINCIPAL ─── -->
    <section class="mb-20">
      <div class="flex items-center gap-4 mb-8">
        <h2 class="section-prompt text-xs font-mono text-terminal-subtle uppercase tracking-[0.5em]">
          Recursos y Plataformas
        </h2>
        <div class="h-px flex-grow bg-terminal-border/50"></div>
        <span class="text-[10px] font-mono text-terminal-subtle">
          {directoryData.length} recursos
        </span>
      </div>

      <!-- Filtro de tags (JS progresivo) -->
      <div class="flex flex-wrap gap-2 mb-8" id="dir-filter-bar">
        <button
          class="badge badge-active filter-btn active"
          data-filter="all"
          id="dir-filter-all"
        >
          Todos
        </button>
        {tags.map((tag) => (
          <button
            class="badge filter-btn bg-terminal-surface/60 text-terminal-muted border border-terminal-border hover:border-emerald-500/40 hover:text-emerald-400 transition-colors"
            data-filter={tag}
          >
            {tag}
          </button>
        ))}
      </div>

      <div
        class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-4"
        id="dir-grid"
      >
        {directoryData.map((item) => (
          <a
            href={item.url}
            target="_blank"
            rel="noopener noreferrer"
            data-tag={item.tag}
            id={`dir-${item.id}`}
            class="hub-card p-4 flex flex-col items-center gap-3 text-center group no-underline"
          >
            <img
              src={item.logo}
              alt={item.alt_logo}
              width={48}
              height={48}
              loading="lazy"
              class="w-10 h-10 object-contain rounded-lg"
            />
            <div>
              <p class="text-white text-xs font-bold leading-tight group-hover:text-emerald-400 transition-colors">
                {item.name}
              </p>
              <p class="text-terminal-subtle text-[10px] mt-0.5">{item.tag}</p>
            </div>
            {item.sponsored && (
              <span class="text-[9px] font-mono text-emerald-500/50 uppercase tracking-widest">
                patrocinado
              </span>
            )}
          </a>
        ))}
      </div>
    </section>

    <!-- ─── SECCIÓN: FAUCETS ─── -->
    <section class="mb-20">
      <div class="flex items-center gap-4 mb-8">
        <h2 class="section-prompt text-xs font-mono text-terminal-subtle uppercase tracking-[0.5em]">
          Faucets
        </h2>
        <div class="h-px flex-grow bg-terminal-border/50"></div>
        <span class="text-[10px] font-mono text-terminal-subtle">
          {faucetsData.length} faucets
        </span>
      </div>

      <!-- Mainnet -->
      <div class="mb-10">
        <h3 class="text-[10px] font-mono text-emerald-500 uppercase tracking-[0.4em] mb-4 flex items-center gap-2">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 inline-block"></span>
          Mainnet — Tokens Reales
        </h3>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {mainnetFaucets.map((faucet) => (
            <a
              href={faucet.url}
              target="_blank"
              rel="noopener noreferrer"
              class="hub-card p-4 flex items-start gap-3 group no-underline"
            >
              <img
                src={faucet.img}
                alt={faucet.name}
                width={40}
                height={40}
                loading="lazy"
                class="w-8 h-8 object-contain rounded-lg flex-shrink-0 mt-0.5"
              />
              <div class="min-w-0">
                <p class="text-white text-xs font-bold group-hover:text-emerald-400 transition-colors truncate">
                  {faucet.name}
                </p>
                <div class="flex flex-wrap gap-1 mt-1.5">
                  {faucet.tags.map((tag) => (
                    <span class="text-[9px] font-mono text-terminal-subtle bg-terminal-elevated/60 px-1.5 py-0.5 rounded">
                      {tag}
                    </span>
                  ))}
                </div>
              </div>
            </a>
          ))}
        </div>
      </div>

      <!-- Testnet -->
      <div>
        <h3 class="text-[10px] font-mono text-yellow-500/80 uppercase tracking-[0.4em] mb-4 flex items-center gap-2">
          <span class="w-1.5 h-1.5 rounded-full bg-yellow-500/80 inline-block"></span>
          Testnet — Sin Valor Real
        </h3>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {testnetFaucets.map((faucet) => (
            <a
              href={faucet.url}
              target="_blank"
              rel="noopener noreferrer"
              class="hub-card p-4 flex items-start gap-3 group no-underline"
            >
              <img
                src={faucet.img}
                alt={faucet.name}
                width={40}
                height={40}
                loading="lazy"
                class="w-8 h-8 object-contain rounded-lg flex-shrink-0 mt-0.5"
              />
              <div class="min-w-0">
                <p class="text-white text-xs font-bold group-hover:text-emerald-400 transition-colors truncate">
                  {faucet.name}
                </p>
                <div class="flex flex-wrap gap-1 mt-1.5">
                  {faucet.tags.map((tag) => (
                    <span class="text-[9px] font-mono text-terminal-subtle bg-terminal-elevated/60 px-1.5 py-0.5 rounded">
                      {tag}
                    </span>
                  ))}
                </div>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <FaqAccordion
      titulo="Sobre el Directorio"
      subtitulo="Recursos y faucets"
      startId={400}
      items={faqItems}
    />
  </main>
</Layout>

<script>
  // Filtrado progresivo del directorio por tag (sin framework)
  const setupDirectoryFilter = () => {
    const buttons = document.querySelectorAll<HTMLButtonElement>(".filter-btn");
    const cards = document.querySelectorAll<HTMLAnchorElement>("#dir-grid a[data-tag]");

    buttons.forEach((btn) => {
      btn.addEventListener("click", () => {
        const filter = btn.dataset.filter;

        // Actualizar estado activo de botones
        buttons.forEach((b) => {
          b.classList.remove("badge-active");
          b.classList.add("bg-terminal-surface/60", "text-terminal-muted");
        });
        btn.classList.add("badge-active");
        btn.classList.remove("bg-terminal-surface/60", "text-terminal-muted");

        // Mostrar/ocultar tarjetas
        cards.forEach((card) => {
          const show = filter === "all" || card.dataset.tag === filter;
          card.style.display = show ? "" : "none";
        });
      });
    });
  };

  setupDirectoryFilter();
  document.addEventListener("astro:page-load", setupDirectoryFilter);
</script>
