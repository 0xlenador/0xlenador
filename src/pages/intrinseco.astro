---
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import "../styles/main.css";

const seo = {
  title:
    "Calculadora de Valor Intrínseco | Análisis Fundamental Graham y Buffett",
  description:
    "Calcula el valor real de tus acciones con precisión. Herramienta avanzada basada en la fórmula de Graham y el modelo de flujos descontados de Warren Buffett.",
  url: "https://0xlenador.xyz/intrinseco",
  image: "https://0xlenador.xyz/assets/img/intrinseco-og.webp",
};

const schema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "Calculadora de Valor Intrínseco 0xLeñador",
  operatingSystem: "Web",
  applicationCategory: "FinanceApplication",
  description:
    "Calculadora avanzada para determinar el valor real de acciones mediante el modelo de Graham y Buffett.",
  author: {
    "@type": "Person",
    name: "0x Leñador",
    url: "https://0xlenador.xyz/",
  },
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href="/img/favicon-96x96.png"
    />
    <link rel="apple-touch-icon" href="/img/apple-touch-icon.png" />

    <title>{seo.title}</title>
    <link rel="canonical" href={seo.url} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="description" content={seo.description} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={seo.url} />
    <meta
      property="og:title"
      content="0xLeñador - Calculadora de Valor Intrínseco | Value Investing"
    />
    <meta property="og:description" content={seo.description} />
    <meta property="og:image" content={seo.image} />
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:title" content="0xLeñador - Gestión de Capital" />

    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    <meta name="theme-color" content="#020617" />
  </head>

  <body class="bg-slate-950 antialiased selection:bg-emerald-500/30">
    <Navbar />

    <header class="max-w-4xl mx-auto px-6 pt-24 pb-16 text-center">
      <h1
        class="text-5xl md:text-7xl font-extrabold text-white mb-8 tracking-tight leading-tight"
      >
        Calculadora de <br />
        <span
          class="bg-gradient-to-r from-emerald-400 to-cyan-400 bg-clip-text text-transparent"
        >
          Valor Intrínseco
        </span>
      </h1>
      <p
        class="text-slate-500 text-xs md:text-sm font-bold uppercase tracking-[0.4em] mb-2"
      >
        Terminal de Análisis Fundamental
      </p>
      <p class="text-slate-400 text-lg md:text-xl font-light max-w-xl mx-auto">
        Calcula el valor real de tus activos con precisión algorítmica.
      </p>
    </header>

    <main class="max-w-3xl mx-auto px-6 pb-20">
      <div
        class="bg-slate-900/40 border border-slate-800 p-10 md:p-16 rounded-[3rem] shadow-2xl relative"
      >
        <div
          class="flex bg-slate-950 p-1 rounded-2xl border border-slate-800 mb-14 max-w-xs mx-auto"
        >
          <button
            id="btn-basic"
            onclick="setMode('basic')"
            class="flex-1 py-2 rounded-xl text-[10px] font-black tracking-[0.2em] transition uppercase bg-slate-800 text-white"
            >Graham</button
          >
          <button
            id="btn-advanced"
            onclick="setMode('advanced')"
            class="flex-1 py-2 rounded-xl text-[10px] font-black tracking-[0.2em] text-slate-500 hover:text-white transition uppercase"
            >Buffett</button
          >
        </div>

        <div class="space-y-12">
          <div id="form-basic" class="grid grid-cols-1 md:grid-cols-2 gap-12">
            <div class="space-y-4">
              <label
                for="basic-eps"
                class="text-[11px] font-bold text-slate-500 uppercase tracking-widest px-1"
                >EPS (Beneficio Acción)</label
              >
              <div class="relative">
                <span
                  class="absolute left-5 top-1/2 -translate-y-1/2 text-emerald-400 font-bold"
                  >$</span
                >
                <input
                  type="number"
                  id="basic-eps"
                  inputmode="decimal"
                  placeholder="0.00"
                  class="w-full bg-slate-950 border border-slate-800 py-5 pl-10 pr-6 text-2xl font-bold text-white rounded-2xl focus:ring-2 focus:ring-emerald-400/50 focus:outline-none transition-all"
                />
              </div>
            </div>
            <div class="space-y-4">
              <label
                for="basic-growth"
                class="text-[11px] font-bold text-slate-500 uppercase tracking-widest px-1"
                >Crecimiento (g %)</label
              >
              <div class="relative">
                <span
                  class="absolute right-5 top-1/2 -translate-y-1/2 text-slate-600 font-bold text-xl"
                  >%</span
                >
                <input
                  type="number"
                  id="basic-growth"
                  inputmode="decimal"
                  placeholder="0"
                  class="w-full bg-slate-950 border border-slate-800 py-5 px-6 text-2xl font-bold text-white rounded-2xl focus:ring-2 focus:ring-emerald-400/50 focus:outline-none transition-all"
                />
              </div>
            </div>
          </div>

          <div id="form-advanced" class="hidden space-y-12">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
              <div class="space-y-3">
                <div class="flex justify-between items-center px-1">
                  <label
                    for="adv-fcf"
                    class="text-[11px] font-bold text-slate-500 uppercase tracking-widest block"
                    >Free Cash Flow</label
                  >
                  <label class="inline-flex items-center cursor-pointer gap-2">
                    <span
                      class="text-[9px] font-black text-slate-600 uppercase tracking-tighter"
                      >Millones</span
                    >
                    <div class="relative">
                      <input
                        type="checkbox"
                        id="fcf-millions-toggle"
                        class="sr-only peer"
                      />
                      <div
                        class="w-7 h-4 bg-slate-800 rounded-full peer peer-checked:bg-emerald-500 peer-checked:after:translate-x-3 after:content-[''] after:absolute after:top-[2px] after:start-[2px] after:bg-slate-400 peer-checked:after:bg-white after:rounded-full after:h-3 after:w-3 after:transition-all"
                      >
                      </div>
                    </div>
                  </label>
                </div>
                <input
                  type="number"
                  id="adv-fcf"
                  inputmode="decimal"
                  placeholder="FCF"
                  class="w-full bg-slate-950 border border-slate-800 py-4 px-6 text-xl font-bold text-white rounded-2xl focus:ring-2 focus:ring-emerald-400/50 focus:outline-none"
                />
              </div>
              <div class="space-y-3">
                <label
                  for="adv-growth"
                  class="text-[11px] font-bold text-slate-500 uppercase tracking-widest px-1 block"
                  >Crecimiento %</label
                >
                <input
                  type="number"
                  id="adv-growth"
                  inputmode="decimal"
                  placeholder="10"
                  class="w-full bg-slate-950 border border-slate-800 py-4 px-6 text-xl font-bold text-white rounded-2xl focus:ring-2 focus:ring-emerald-400/50 focus:outline-none"
                />
              </div>
              <div class="space-y-3">
                <label
                  for="adv-discount"
                  class="text-[11px] font-bold text-slate-500 uppercase tracking-widest px-1 block"
                  >Tasa Descuento %</label
                >
                <input
                  type="number"
                  id="adv-discount"
                  inputmode="decimal"
                  value="10"
                  class="w-full bg-slate-950 border border-slate-800 py-4 px-6 text-xl font-bold text-white rounded-2xl focus:ring-2 focus:ring-emerald-400/50 focus:outline-none"
                />
              </div>
              <div class="space-y-3">
                <div class="flex justify-between items-center px-1">
                  <label
                    for="adv-shares"
                    class="text-[11px] font-bold text-slate-500 uppercase tracking-widest block"
                    >Acciones Totales</label
                  >
                  <label class="inline-flex items-center cursor-pointer gap-2">
                    <span
                      class="text-[9px] font-black text-slate-600 uppercase tracking-tighter"
                      >Millones</span
                    >
                    <div class="relative">
                      <input
                        type="checkbox"
                        id="shares-millions-toggle"
                        class="sr-only peer"
                      />
                      <div
                        class="w-7 h-4 bg-slate-800 rounded-full peer peer-checked:bg-emerald-500 peer-checked:after:translate-x-3 after:content-[''] after:absolute after:top-[2px] after:start-[2px] after:bg-slate-400 peer-checked:after:bg-white after:rounded-full after:h-3 after:w-3 after:transition-all"
                      >
                      </div>
                    </div>
                  </label>
                </div>
                <input
                  type="number"
                  id="adv-shares"
                  inputmode="decimal"
                  placeholder="Shares"
                  class="w-full bg-slate-950 border border-slate-800 py-4 px-6 text-xl font-bold text-white rounded-2xl focus:ring-2 focus:ring-emerald-400/50 focus:outline-none"
                />
              </div>
            </div>
            <div class="pt-6 border-t border-slate-800/40">
              <label
                for="adv-margin"
                class="flex justify-between items-center mb-6 cursor-pointer"
              >
                <span
                  class="text-[11px] font-bold text-slate-400 uppercase tracking-widest"
                  >Margen de Seguridad</span
                >
                <span
                  id="margin-label"
                  class="text-3xl font-black text-emerald-400 italic">30%</span
                >
              </label>
              <input
                type="range"
                id="adv-margin"
                min="5"
                max="50"
                value="30"
                class="w-full cursor-pointer accent-emerald-500 h-1.5 bg-slate-800 rounded-lg appearance-none"
                oninput="document.getElementById('margin-label').innerText = this.value + '%'"
              />
            </div>
          </div>

          <button
            id="calc-button"
            onclick="calculate()"
            class="w-full bg-gradient-to-r from-emerald-500 to-cyan-500 text-slate-950 py-5 rounded-2xl font-black text-xs tracking-[0.4em] uppercase transition-all shadow-xl shadow-emerald-500/20 italic"
          >
            Ejecutar Algoritmo
          </button>
        </div>

        <div
          id="result-area"
          class="hidden mt-16 border-t border-slate-800/60 pt-16"
        >
          <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
            <div
              class="bg-slate-950/60 border border-slate-800 p-10 rounded-[2rem] text-center md:text-left flex flex-col justify-center overflow-hidden"
            >
              <span
                class="text-[10px] font-bold text-slate-500 uppercase tracking-[0.3em] mb-4 block"
                >Precio Objetivo</span
              >
              <div
                id="final-price"
                class="text-5xl md:text-4xl font-black text-white tracking-tighter mb-2 leading-tight break-all overflow-hidden"
                title="$0.00"
              >
                $0.00
              </div>
              <div
                class="text-[9px] text-emerald-400 font-black uppercase tracking-widest flex items-center gap-2"
              >
                <span
                  class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"
                ></span>
                Target Price Multi-Asset
              </div>
            </div>
            <div
              class="bg-slate-950/60 border border-slate-800 p-10 rounded-[2rem] flex flex-col justify-center overflow-hidden"
            >
              <span
                class="text-[10px] font-bold text-slate-500 uppercase tracking-[0.3em] mb-4 block"
                >Estatus Terminal</span
              >
              <div
                id="status-text"
                class="text-xl font-bold text-white mb-3 italic tracking-tight truncate overflow-hidden"
              >
                Análisis Completado
              </div>
              <p
                id="final-desc"
                class="text-[11px] text-slate-500 leading-relaxed font-medium italic"
              >
              </p>
            </div>
          </div>
        </div>
      </div>

      <section class="mt-20 space-y-6">
        <h2
          class="text-2xl font-bold text-white tracking-tight text-center mb-10"
        >
          Entiende la Valoración
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="p-8 bg-slate-900/20 border border-slate-800 rounded-3xl">
            <h4
              class="text-emerald-500 font-bold mb-3 text-sm uppercase tracking-widest"
            >
              ¿Qué es el Valor Intrínseco?
            </h4>
            <p class="text-xs text-slate-400 leading-relaxed">
              Es el valor real de un activo basado en sus fundamentos
              económicos, ignorando el ruido actual del precio de mercado.
            </p>
          </div>
          <div class="p-8 bg-slate-900/20 border border-slate-800 rounded-3xl">
            <h4
              class="text-emerald-500 font-bold mb-3 text-sm uppercase tracking-widest"
            >
              ¿Por qué usar Margen de Seguridad?
            </h4>
            <p class="text-xs text-slate-400 leading-relaxed">
              Para protegernos de errores de cálculo o imprevistos del mercado.
              Comprar por debajo del valor intrínseco es la base del Value
              Investing.
            </p>
          </div>
        </div>
      </section>

      <section class="mt-24">
        <div class="text-center mb-12">
          <h2
            class="text-3xl font-black text-white tracking-tighter uppercase italic"
          >
            Preguntas Frecuentes
          </h2>
          <p
            class="text-slate-500 font-mono text-xs uppercase tracking-widest mt-2"
          >
            Todo lo que necesitas saber sobre el análisis
          </p>
        </div>
        <div class="space-y-4 max-w-2xl mx-auto">
          <div
            class="bg-slate-900/40 border border-slate-800 rounded-2xl overflow-hidden group hover:border-emerald-500/30 transition-all"
          >
            <button
              onclick="toggleFaq(1)"
              class="w-full p-6 text-left flex justify-between items-center"
            >
              <span
                class="text-white font-bold group-hover:text-emerald-400 transition-colors"
                >¿Cuándo debo comprar una acción?</span
              >
              <span
                id="icon-1"
                class="text-slate-500 transition-transform duration-300 icon-rotate"
                ><svg
                  class="w-6 h-6"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                  ><path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path></svg
                ></span
              >
            </button>
            <div
              id="ans-1"
              class="max-h-0 overflow-hidden transition-all duration-300 ease-in-out faq-content"
              style="max-height: 0px;"
            >
              <p
                class="p-6 pt-0 text-slate-400 text-sm leading-relaxed border-t border-slate-800/50"
              >
                Idealmente cuando el precio de mercado esté un 20-30% por debajo
                del valor calculado (Margen de Seguridad). Esto reduce el riesgo
                de pérdida y aumenta el potencial de beneficio.
              </p>
            </div>
          </div>

          <div
            class="bg-slate-900/40 border border-slate-800 rounded-2xl overflow-hidden group hover:border-emerald-500/30 transition-all"
          >
            <button
              onclick="toggleFaq(2)"
              class="w-full p-6 text-left flex justify-between items-center"
            >
              <span
                class="text-white font-bold group-hover:text-emerald-400 transition-colors"
                >¿Qué EPS debo utilizar?</span
              >
              <span
                id="icon-2"
                class="text-slate-500 transition-transform duration-300 icon-rotate"
                ><svg
                  class="w-6 h-6"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                  ><path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path></svg
                ></span
              >
            </button>
            <div
              id="ans-2"
              class="max-h-0 overflow-hidden transition-all duration-300 ease-in-out faq-content"
              style="max-height: 0px;"
            >
              <p
                class="p-6 pt-0 text-slate-400 text-sm leading-relaxed border-t border-slate-800/50"
              >
                El EPS TTM (Trailing Twelve Months) es el estándar, aunque el
                EPS normalizado evita distorsiones por eventos únicos. Asegúrate
                de verificar si hay dilución de acciones reciente.
              </p>
            </div>
          </div>

          <div
            class="bg-slate-900/40 border border-slate-800 rounded-2xl overflow-hidden group hover:border-emerald-500/30 transition-all"
          >
            <button
              onclick="toggleFaq(3)"
              class="w-full p-6 text-left flex justify-between items-center"
            >
              <span
                class="text-white font-bold group-hover:text-emerald-400 transition-colors"
                >¿Qué tasa de descuento es recomendable?</span
              >
              <span
                id="icon-3"
                class="text-slate-500 transition-transform duration-300 icon-rotate"
                ><svg
                  class="w-6 h-6"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                  ><path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path></svg
                ></span
              >
            </button>
            <div
              id="ans-3"
              class="max-h-0 overflow-hidden transition-all duration-300 ease-in-out faq-content"
              style="max-height: 0px;"
            >
              <p
                class="p-6 pt-0 text-slate-400 text-sm leading-relaxed border-t border-slate-800/50"
              >
                Generalmente entre el 8% y el 12%, dependiendo del riesgo del
                sector y los tipos de interés actuales. Una tasa más alta
                refleja una mayor incertidumbre sobre los flujos futuros.
              </p>
            </div>
          </div>
        </div>
      </section>

      <div class="mt-20 text-center">
        <p
          class="text-slate-600 text-[10px] font-bold uppercase tracking-[0.3em] mb-4"
        >
          Financial Intelligence Engine
        </p>
        <div class="h-1 w-12 bg-emerald-500/20 mx-auto rounded-full"></div>
      </div>
    </main>

    <Footer />

    <script is:inline>
      let currentMode = "basic";

      function setMode(mode) {
        currentMode = mode;
        const btnBasic = document.getElementById("btn-basic");
        const btnAdv = document.getElementById("btn-advanced");
        const formBasic = document.getElementById("form-basic");
        const formAdv = document.getElementById("form-advanced");
        const resultArea = document.getElementById("result-area");

        resultArea.classList.add("hidden");

        if (mode === "basic") {
          btnBasic.classList.replace("text-slate-500", "text-white");
          btnBasic.classList.add("bg-slate-800");
          btnAdv.classList.replace("text-white", "text-slate-500");
          btnAdv.classList.remove("bg-slate-800");
          formBasic.classList.remove("hidden");
          formAdv.classList.add("hidden");
        } else {
          btnAdv.classList.replace("text-slate-500", "text-white");
          btnAdv.classList.add("bg-slate-800");
          btnBasic.classList.replace("text-white", "text-slate-500");
          btnBasic.classList.remove("bg-slate-800");
          formAdv.classList.remove("hidden");
          formBasic.classList.add("hidden");
        }
      }

      function highlightError(elementId) {
        const el = document.getElementById(elementId);
        if (el) {
          el.classList.add("ring-2", "ring-rose-500", "border-rose-500");
          setTimeout(() => {
            el.classList.remove("ring-2", "ring-rose-500", "border-rose-500");
          }, 2000);
        }
      }

      function calculate() {
        const resultArea = document.getElementById("result-area");
        const finalPrice = document.getElementById("final-price");
        const finalDesc = document.getElementById("final-desc");
        const statusText = document.getElementById("status-text");
        const calcButton = document.getElementById("calc-button");

        let hasError = false;

        if (currentMode === "basic") {
          const epsInput = document.getElementById("basic-eps");
          const growthInput = document.getElementById("basic-growth");

          if (!epsInput.value) {
            highlightError("basic-eps");
            hasError = true;
          }
          if (!growthInput.value) {
            highlightError("basic-growth");
            hasError = true;
          }
        } else {
          const advFields = [
            "adv-fcf",
            "adv-growth",
            "adv-discount",
            "adv-shares",
          ];
          advFields.forEach((id) => {
            const input = document.getElementById(id);
            if (!input.value) {
              highlightError(id);
              hasError = true;
            }
          });
        }

        if (hasError) return;

        calcButton.disabled = true;
        calcButton.innerText = "Procesando...";
        resultArea.classList.add("hidden");

        setTimeout(() => {
          let result = 0;

          if (currentMode === "basic") {
            const eps = parseFloat(document.getElementById("basic-eps").value);
            const growth = parseFloat(
              document.getElementById("basic-growth").value,
            );

            if (isNaN(eps) || isNaN(growth)) {
              calcButton.disabled = false;
              calcButton.innerText = "Ejecutar Algoritmo";
              return;
            }
            result = eps * (8.5 + 2 * growth);
            statusText.innerText = "Target Graham";
            finalDesc.innerText =
              "Estimación fundamental rápida basada en el beneficio neto actual.";
          } else {
            let fcf = parseFloat(document.getElementById("adv-fcf").value);
            const growth =
              parseFloat(document.getElementById("adv-growth").value) / 100;
            const discount =
              parseFloat(document.getElementById("adv-discount").value) / 100;
            let shares = parseFloat(
              document.getElementById("adv-shares").value,
            );
            const margin =
              parseFloat(document.getElementById("adv-margin").value) / 100;

            if (
              isNaN(fcf) ||
              isNaN(growth) ||
              isNaN(discount) ||
              isNaN(shares)
            ) {
              calcButton.disabled = false;
              calcButton.innerText = "Ejecutar Algoritmo";
              return;
            }

            if (document.getElementById("fcf-millions-toggle").checked)
              fcf *= 1000000;
            if (document.getElementById("shares-millions-toggle").checked)
              shares *= 1000000;

            let totalPV = 0;
            let currentFCF = fcf;
            for (let i = 1; i <= 5; i++) {
              currentFCF *= 1 + growth;
              totalPV += currentFCF / Math.pow(1 + discount, i);
            }
            const terminalVal = (currentFCF * 1.025) / (discount - 0.025);
            const terminalPV = terminalVal / Math.pow(1 + discount, 5);
            const intrinsicPerShare = (totalPV + terminalPV) / shares;
            result = intrinsicPerShare * (1 - margin);

            statusText.innerText = "Target Buffett";
            finalDesc.innerText =
              "Cálculo DCF avanzado con descuento de flujos y margen de seguridad.";
          }

          const formattedPrice = `$${result.toLocaleString("en-US", { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
          finalPrice.innerText = formattedPrice;
          finalPrice.title = formattedPrice;

          resultArea.classList.remove("hidden");
          calcButton.disabled = false;
          calcButton.innerText = "Ejecutar Algoritmo";

          resultArea.scrollIntoView({ behavior: "smooth", block: "center" });
        }, 600);
      }

      // Evento Enter
      document.querySelectorAll('input[type="number"]').forEach((input) => {
        input.addEventListener("keydown", (e) => {
          if (e.key === "Enter") {
            e.preventDefault();
            calculate();
          }
        });
      });

      // Toggle Global FAQ
      function toggleFaq(id) {
        const ans = document.getElementById(`ans-${id}`);
        const icon = document.getElementById(`icon-${id}`);
        const isClosed =
          ans.style.maxHeight === "0px" || ans.style.maxHeight === "";

        document
          .querySelectorAll(".faq-content")
          .forEach((el) => (el.style.maxHeight = "0px"));
        document
          .querySelectorAll(".icon-rotate")
          .forEach((el) => (el.style.transform = "rotate(0deg)"));

        if (isClosed) {
          ans.style.maxHeight = ans.scrollHeight + "px";
          icon.style.transform = "rotate(180deg)";
        }
      }
    </script>
  </body>
</html>
