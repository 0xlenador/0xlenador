---
import Layout from "../layouts/Layout.astro"
import IntrinsicView from "../components/views/IntrinsicView.astro"
import { getLangFromUrl, useTranslations } from "../i18n/utils"

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)

const schema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: t("intrinsic.schema.name"),
  operatingSystem: "Web",
  applicationCategory: "FinanceApplication",
  description: t("intrinsic.schema.desc"),
  author: { "@type": "Person", name: "0x Leñador", url: "https://0xlenador.xyz/" },
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
}
---

<Layout
  title={t("intrinsic.seo.title")}
  description={t("intrinsic.seo.description")}
  image="/img/meta/intrinseco.webp"
  schema={schema}
  customSpacing
>
  <IntrinsicView />
</Layout>
