---
import Layout from '../layouts/Layout.astro';
import sflPets from '../data/sfl_pets.json';
import sflRecipes from '../data/sfl_recipes.json';
import sflIds from '../data/sfl_ids.json';
import fs from 'fs';
import path from 'path';

const seo = {
  title: "Mascotas SFL | 0xLeñador — Guía de Mascotas de Sunflower Land",
  description: "Descubre la lista completa de mascotas, sus requerimientos, recursos de energía y altares (Shrines) en Sunflower Land.",
  image: "/img/cripto/sunflowerland.webp",
}

// -------------------------------------------------------------
// Lógica de cálculo estático (Server-side / Build-time)
// -------------------------------------------------------------
let priceDict = {};
try {
  const sflDataPath = path.resolve(process.cwd(), 'public/api/sfl_data.json');
  const sflData = JSON.parse(fs.readFileSync(sflDataPath, 'utf8'));
  
  if (sflData.items) {
    Object.values(sflData.items).forEach(data => {
      const colMatch = data.key.match(/collectibles-(\d+)$/);
      if (colMatch && sflIds[colMatch[1]]) {
        priceDict[sflIds[colMatch[1]]] = data.currentPrice || 0;
      }
      const resMatch = data.key.match(/resources-(\d+)$/);
      if (resMatch && sflIds[resMatch[1]]) {
        priceDict[sflIds[resMatch[1]]] = data.currentPrice || 0;
      }
    });
  }
  priceDict['SFL'] = sflData.flowerPrice || 0;
} catch (e) {
  console.error("Error reading sfl_data.json in build", e);
}

const calculateRecipeCost = (ingredients, visited = new Set()) => {
  let total = 0;
  let missing = false;
  for (const ing of ingredients) {
    if (priceDict[ing.name]) {
      total += priceDict[ing.name] * ing.amount;
    } else {
      const subRecipe = sflRecipes.recipes.find(r => r.name === ing.name);
      if (subRecipe && !visited.has(ing.name)) {
        visited.add(ing.name);
        const subCost = calculateRecipeCost(subRecipe.ingredients, visited);
        if (subCost.missing) missing = true;
        total += subCost.total * ing.amount;
      } else {
        missing = true;
      }
    }
  }
  return { total, missing };
};

const foodCostsDict = {};
for (const recipe of sflRecipes.recipes) {
  const costObj = calculateRecipeCost(recipe.ingredients);
  foodCostsDict[recipe.name] = costObj.missing ? null : costObj.total;
}

const calcResources = sflPets.resources;

const formatPrice = (num) => {
  if (num === 0) return '0';
  return new Intl.NumberFormat('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 4 }).format(num);
};

const getFoodCostHtml = (foodName) => {
  const recipe = sflRecipes.recipes.find(r => r.name === foodName);
  if (!recipe) return `<span class="text-[10px] text-white/40 italic">N/A</span>`;
  const costObj = calculateRecipeCost(recipe.ingredients);
  if (costObj.missing) return `<span class="text-[10px] text-yellow-500/70 italic">*Inc</span>`;
  return `<span class="text-[11px] font-mono text-white/90">${formatPrice(costObj.total)}</span>`;
};

const getShrineCostHtml = (shrine) => {
  let total = 0;
  let missing = false;
  for (const res of shrine.resources) {
    if (res.name === 'Acorn') continue;
    if (priceDict[res.name]) {
      total += priceDict[res.name] * res.amount;
    } else {
      missing = true;
    }
  }
  if (missing && total === 0) return `<span class="text-xs text-white/40 italic">N/A</span>`;
  if (total === 0) return `<span class="text-xs text-white/40">-</span>`;
  let html = `<span class="text-sm font-mono text-white/90">${formatPrice(total)}</span>`;
  if (missing) html += ` <span class="text-[10px] text-yellow-500/70 italic" title="Precio incompleto">*Inc</span>`;
  return html;
};

const getResourcePriceHtml = (resName) => {
  if (resName === 'Acorn' || resName === 'Fossil Shell') return '';
  const price = priceDict[resName];
  if (!price) return `<span class="text-[10px] text-yellow-500/70 italic w-10 text-right inline-block">*Inc</span>`;
  return `<span class="text-[11px] font-mono text-white/90 w-10 text-right inline-block">${formatPrice(price)}</span>`;
};
---

<Layout title={seo.title} description={seo.description} image={seo.image}>
  <main class="max-w-7xl mx-auto px-6 pt-10 pb-20">
    
    <header class="mb-12">
      <div class="flex items-center gap-4 mb-3">
        <img src="/img/cripto/sunflowerland.webp" alt="Sunflower Land" class="w-10 h-10 rounded-full object-contain bg-white/[0.05] p-1 border border-white/[0.1]" />
        <p class="text-[10px] font-mono text-emerald-500/70 uppercase tracking-[0.4em]">
          Herramientas / Mascotas
        </p>
      </div>
      <div class="mb-12">
      <h1 class="text-4xl md:text-5xl font-black text-transparent bg-clip-text bg-gradient-to-r from-emerald-400 to-cyan-400 mb-4 tracking-tight drop-shadow-lg">
        Calcula la rentabilidad de la comida de tus mascotas
      </h1>
      <p class="text-lg text-white/60 font-medium">Conoce las comidas y premios de tus mascotas</p>
    </div>

    <!-- CALCULATOR DASHBOARD -->
    <div class="mb-12 bg-white/[0.02] border border-white/[0.05] backdrop-blur-2xl rounded-[24px] p-6 lg:p-8 shadow-2xl">
      <h2 class="text-2xl font-black text-white mb-6 flex items-center gap-2">
        <i class="bi bi-calculator text-emerald-400"></i> Calculadora de Rentabilidad - Comida / P2P
      </h2>
      
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
        <!-- Easy Selection -->
        <div class="bg-white/5 border border-white/10 rounded-xl p-4">
          <div class="text-[11px] uppercase font-bold tracking-widest text-emerald-400 mb-3 text-center border-b border-emerald-500/20 pb-2">Petición Easy (20⚡)</div>
          <div class="relative custom-dropdown select-none" data-id="calc-select-easy" data-value="">
            <button class="w-full bg-black/50 border border-white/10 rounded-lg p-2.5 text-sm text-white focus:outline-none focus:border-emerald-500/50 flex items-center justify-between shadow-inner hover:bg-black/70 transition-colors dropdown-toggle">
              <span class="dropdown-selected-text flex items-center gap-2">
                <span class="text-white/40">-- Seleccionar Comida --</span>
              </span>
              <i class="bi bi-chevron-down text-white/50 text-xs dropdown-arrow transition-transform"></i>
            </button>
            <ul class="absolute z-50 top-full mt-1 left-0 w-full bg-[#111827] border border-white/10 rounded-xl shadow-2xl max-h-60 overflow-y-auto custom-scrollbar hidden dropdown-menu ring-1 ring-black/50 overflow-hidden">
              <li class="p-2.5 text-sm text-white/40 hover:bg-white/5 cursor-pointer flex items-center gap-2 transition-colors dropdown-option" data-value="">
                -- Seleccionar Comida --
              </li>
              {sflPets.requests.Easy.map(food => (
                <li class="p-2.5 text-sm text-white/80 hover:bg-emerald-500/20 hover:text-emerald-300 cursor-pointer flex items-center justify-between transition-colors dropdown-option" data-value={food}>
                  <div class="flex items-center gap-2">
                    <img src={`/img/sunflowerland/food/${food}.png`} class="w-5 h-5 object-contain" alt={food} onerror="this.style.display='none';" />
                    <span>{food}</span>
                  </div>
                  <span class="font-mono text-[10px] text-white/40">{foodCostsDict[food] ? `(${formatPrice(foodCostsDict[food])})` : `(*Inc)`}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
        <!-- Medium Selection -->
        <div class="bg-white/5 border border-white/10 rounded-xl p-4">
          <div class="text-[11px] uppercase font-bold tracking-widest text-yellow-400 mb-3 text-center border-b border-yellow-500/20 pb-2">Petición Medium (100⚡)</div>
          <div class="relative custom-dropdown select-none" data-id="calc-select-medium" data-value="">
            <button class="w-full bg-black/50 border border-white/10 rounded-lg p-2.5 text-sm text-white focus:outline-none focus:border-yellow-500/50 flex items-center justify-between shadow-inner hover:bg-black/70 transition-colors dropdown-toggle">
              <span class="dropdown-selected-text flex items-center gap-2">
                <span class="text-white/40">-- Seleccionar Comida --</span>
              </span>
              <i class="bi bi-chevron-down text-white/50 text-xs dropdown-arrow transition-transform"></i>
            </button>
            <ul class="absolute z-50 top-full mt-1 left-0 w-full bg-[#111827] border border-white/10 rounded-xl shadow-2xl max-h-60 overflow-y-auto custom-scrollbar hidden dropdown-menu ring-1 ring-black/50 overflow-hidden">
              <li class="p-2.5 text-sm text-white/40 hover:bg-white/5 cursor-pointer flex items-center gap-2 transition-colors dropdown-option" data-value="">
                -- Seleccionar Comida --
              </li>
              {sflPets.requests.Medium.map(food => (
                <li class="p-2.5 text-sm text-white/80 hover:bg-yellow-500/20 hover:text-yellow-300 cursor-pointer flex items-center justify-between transition-colors dropdown-option" data-value={food}>
                  <div class="flex items-center gap-2">
                    <img src={`/img/sunflowerland/food/${food}.png`} class="w-5 h-5 object-contain" alt={food} onerror="this.style.display='none';" />
                    <span>{food}</span>
                  </div>
                  <span class="font-mono text-[10px] text-white/40">{foodCostsDict[food] ? `(${formatPrice(foodCostsDict[food])})` : `(*Inc)`}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
        <!-- Hard Selection -->
        <div class="bg-white/5 border border-white/10 rounded-xl p-4">
          <div class="text-[11px] uppercase font-bold tracking-widest text-red-400 mb-3 text-center border-b border-red-500/20 pb-2">Petición Hard (300⚡)</div>
          <div class="relative custom-dropdown select-none" data-id="calc-select-hard" data-value="">
            <button class="w-full bg-black/50 border border-white/10 rounded-lg p-2.5 text-sm text-white focus:outline-none focus:border-red-500/50 flex items-center justify-between shadow-inner hover:bg-black/70 transition-colors dropdown-toggle">
              <span class="dropdown-selected-text flex items-center gap-2">
                <span class="text-white/40">-- Seleccionar Comida --</span>
              </span>
              <i class="bi bi-chevron-down text-white/50 text-xs dropdown-arrow transition-transform"></i>
            </button>
            <ul class="absolute z-50 top-full mt-1 left-0 w-full bg-[#111827] border border-white/10 rounded-xl shadow-2xl max-h-60 overflow-y-auto custom-scrollbar hidden dropdown-menu ring-1 ring-black/50 overflow-hidden">
              <li class="p-2.5 text-sm text-white/40 hover:bg-white/5 cursor-pointer flex items-center gap-2 transition-colors dropdown-option" data-value="">
                -- Seleccionar Comida --
              </li>
              {sflPets.requests.Hard.map(food => (
                <li class="p-2.5 text-sm text-white/80 hover:bg-red-500/20 hover:text-red-300 cursor-pointer flex items-center justify-between transition-colors dropdown-option" data-value={food}>
                  <div class="flex items-center gap-2">
                    <img src={`/img/sunflowerland/food/${food}.png`} class="w-5 h-5 object-contain" alt={food} onerror="this.style.display='none';" />
                    <span>{food}</span>
                  </div>
                  <span class="font-mono text-[10px] text-white/40">{foodCostsDict[food] ? `(${formatPrice(foodCostsDict[food])})` : `(*Inc)`}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
      
      <div class="overflow-x-auto no-scrollbar">
        <table class="w-full text-left border-collapse min-w-[800px]">
          <thead>
            <tr class="border-b border-white/10 text-[10px] uppercase tracking-widest text-white/40">
              <th class="p-3 font-mono w-[15%]">Recurso</th>
              <th class="p-3 font-mono w-[10%] text-right">Energía / Precio P2P</th>
              <th class="p-3 font-mono w-[25%] text-center border-l border-white/5">Easy Costo / Ganancia</th>
              <th class="p-3 font-mono w-[25%] text-center border-l border-white/5">Medium Costo / Ganancia</th>
              <th class="p-3 font-mono w-[25%] text-center border-l border-white/5">Hard Costo / Ganancia</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-white/5" id="calc-results-body">
            {calcResources.map(res => (
              <tr class="hover:bg-white/[0.03] transition-colors group">
                <td class="p-3">
                  <div class="flex items-center gap-2">
                    <img src={`/img/sunflowerland/${res.name}.png`} class="w-5 h-5 object-contain" onerror="this.onerror=null; this.src='/img/cripto/sunflowerland.webp';" />
                    <span class="text-xs font-medium text-white/90">{res.name}</span>
                  </div>
                </td>
                <td class="p-3 text-right">
                  <div class="flex items-center justify-end gap-3">
                    <div class="inline-flex items-center text-[10px] text-yellow-500 font-mono font-bold opacity-80">
                      <svg class="w-2.5 h-2.5 mr-0.5 opacity-90" fill="currentColor" viewBox="0 0 16 16">
                        <path d="M11.251.068a.5.5 0 0 1 .227.58L9.677 6.5H13a.5.5 0 0 1 .364.843l-8 8.5a.5.5 0 0 1-.842-.49L6.323 9.5H3a.5.5 0 0 1-.364-.843l8-8.5a.5.5 0 0 1 .615-.09z"/>
                      </svg>
                      {res.energy}
                    </div>
                    {res.name === 'Acorn' || res.name === 'Fossil Shell' ? (
                      <span class="text-[10px] font-sans text-white/40 italic min-w-[3rem] text-right">No P2P</span>
                    ) : (
                      <span class="text-xs font-mono text-emerald-400 min-w-[3rem] text-right">{priceDict[res.name] ? formatPrice(priceDict[res.name]) : '-'}</span>
                    )}
                  </div>
                </td>
                <!-- Placeholders for JS injection -->
                <td class="p-3 align-middle border-l border-white/5"><div id={`calc-res-${res.name.replace(/\s+/g, '_')}-easy`} class="text-center text-[10px] text-white/20 italic">-</div></td>
                <td class="p-3 align-middle border-l border-white/5"><div id={`calc-res-${res.name.replace(/\s+/g, '_')}-medium`} class="text-center text-[10px] text-white/20 italic">-</div></td>
                <td class="p-3 align-middle border-l border-white/5"><div id={`calc-res-${res.name.replace(/\s+/g, '_')}-hard`} class="text-center text-[10px] text-white/20 italic">-</div></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
    <div class="text-center mb-12">
      <p class="text-terminal-secondary text-sm leading-relaxed max-w-2xl mx-auto">
        Consulta todos los detalles, habilidades y requisitos de alimentación para las mascotas del ecosistema. Revisa los altares, los recursos energéticos y la comida que demanda cada rareza.
      </p>
    </div>
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
      
      <!-- Mascotas Comunes -->
      <div class="bg-white/[0.02] border border-white/[0.05] backdrop-blur-2xl rounded-[24px] p-6 lg:p-8 shadow-2xl relative overflow-hidden">
        <div class="absolute -top-40 -left-40 w-80 h-80 bg-blue-500/10 rounded-full blur-3xl pointer-events-none"></div>
        <h2 class="text-2xl font-black text-white mb-6 relative z-10 flex items-center gap-2">
          <i class="bi bi-heptagon-half text-emerald-500"></i> Mascotas Comunes
        </h2>
        
        <div class="flex flex-col gap-4 relative z-10">
          {sflPets.commonPets.map(petGroup => (
            <div class="border border-white/10 bg-white/5 rounded-2xl p-4">
              <h3 class="text-lg font-bold text-emerald-400 mb-3">{petGroup.type}</h3>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                  <h4 class="text-[10px] text-white/40 uppercase font-mono tracking-widest mb-2">Variantes</h4>
                  <div class="flex flex-col gap-2">
                    {petGroup.names.map(name => (
                      <div class="flex items-center gap-2">
                        <img src={`/img/sunflowerland/pets/${name}.png`} class="w-6 h-6 object-contain" onerror="this.onerror=null; this.src='/img/cripto/sunflowerland.webp';" />
                        <span class="text-sm text-white/90">{name}</span>
                      </div>
                    ))}
                  </div>
                </div>
                <div>
                  <h4 class="text-[10px] text-white/40 uppercase font-mono tracking-widest mb-2">Búsquedas (Fetches)</h4>
                  <div class="flex flex-col gap-2">
                    {petGroup.fetches.map(fetch => (
                      <div class="flex items-center gap-2">
                        <img src={`/img/sunflowerland/${fetch.name}.png`} class="w-5 h-5 object-contain" onerror="this.onerror=null; this.src='/img/cripto/sunflowerland.webp';" />
                        <span class="text-xs text-white/80">{fetch.name}</span>
                        <span class="text-[9px] bg-emerald-500/20 text-emerald-400 px-1.5 py-0.5 rounded font-mono ml-auto">Lvl {fetch.level}</span>
                      </div>
                    ))}
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Mascotas NFT -->
      <div class="bg-white/[0.02] border border-white/[0.05] backdrop-blur-2xl rounded-[24px] p-6 lg:p-8 shadow-2xl relative overflow-hidden">
        <div class="absolute -top-40 -right-40 w-80 h-80 bg-purple-500/10 rounded-full blur-3xl pointer-events-none"></div>
        <h2 class="text-2xl font-black text-white mb-6 relative z-10 flex items-center gap-2">
          <i class="bi bi-gem text-purple-400"></i> Mascotas NFT
        </h2>
        
        <div class="flex flex-col gap-4 relative z-10">
          {sflPets.nftPets.map(pet => (
            <div class="border border-white/10 bg-white/5 rounded-2xl p-4">
              <div class="flex flex-col sm:flex-row gap-4 items-center sm:items-start">
                <div class="shrink-0 flex flex-col items-center">
                  <h3 class="text-lg font-bold text-purple-400 mb-2">{pet.name}</h3>
                  <img src={`/img/sunflowerland/pets/nft/${pet.name}.png`} class="w-20 h-20 object-contain rounded-xl bg-black/20 p-2 border border-white/5" onerror="this.onerror=null; this.src='/img/cripto/sunflowerland.webp';" />
                </div>
                <div class="w-full">
                  <h4 class="text-[10px] text-white/40 uppercase font-mono tracking-widest mb-2">Búsquedas (Fetches)</h4>
                  <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
                    {pet.fetches.map(fetch => (
                      <div class="flex items-center gap-2 bg-black/20 px-2 py-1.5 rounded-lg border border-white/5">
                        <img src={`/img/sunflowerland/${fetch.name}.png`} class="w-4 h-4 object-contain" onerror="this.onerror=null; this.src='/img/cripto/sunflowerland.webp';" />
                        <span class="text-[11px] text-white/80">{fetch.name}</span>
                        <span class="text-[9px] text-emerald-500/70 ml-auto font-mono">Lvl {fetch.level}</span>
                      </div>
                    ))}
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>

    </div>

    <!-- Sección Recursos y Comidas -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 mt-8">
      
      <!-- Resources -->
      <div class="bg-white/[0.02] border border-white/[0.05] backdrop-blur-2xl rounded-[24px] p-6 shadow-2xl">
        <h2 class="text-xl font-black text-white mb-4 flex items-center gap-2">
          <i class="bi bi-box-seam text-emerald-400"></i> Recursos
        </h2>
        <div class="flex flex-col gap-2">
          {sflPets.resources.map(res => (
            <div class="flex items-center justify-between p-2 hover:bg-white/5 rounded-lg transition-colors border-b border-white/5 last:border-0">
              <div class="flex items-center gap-2">
                <img src={`/img/sunflowerland/${res.name}.png`} class="w-5 h-5 object-contain" onerror="this.onerror=null; this.src='/img/cripto/sunflowerland.webp';" />
                <span class="text-sm text-white/90">{res.name}</span>
              </div>
              <div class="flex items-center gap-3">
                <div class="flex items-center" set:html={getResourcePriceHtml(res.name)}></div>
                <div class="flex items-center gap-1.5 bg-yellow-500/10 px-2 py-1 rounded text-yellow-500 font-mono text-xs w-16 justify-center">
                  <i class="bi bi-lightning-fill text-[10px]"></i> {res.energy}
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Requests -->
      <div class="bg-white/[0.02] border border-white/[0.05] backdrop-blur-2xl rounded-[24px] p-6 shadow-2xl lg:col-span-2">
        <h2 class="text-xl font-black text-white mb-4 flex items-center gap-2">
          <i class="bi bi-basket2 text-orange-400"></i> Solicitudes de Comida
        </h2>
        
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          
          <div class="border border-emerald-500/20 bg-emerald-500/5 rounded-xl p-4">
            <h3 class="text-sm font-bold text-emerald-400 mb-3 uppercase tracking-wider text-center border-b border-emerald-500/20 pb-2">Easy</h3>
            <div class="flex flex-col gap-1.5">
              {sflPets.requests.Easy.map(req => (
                <div class="flex items-center justify-between p-1.5 hover:bg-white/5 rounded" data-food={req}>
                  <div class="flex items-center gap-2">
                    <img src={`/img/sunflowerland/food/${req}.png`} class="w-4 h-4 object-contain" onerror="this.onerror=null; this.src='/img/cripto/sunflowerland.webp';" />
                    <span class="text-[11px] text-white/80">{req}</span>
                  </div>
                  <div class="food-cost flex items-center gap-1" set:html={getFoodCostHtml(req)}></div>
                </div>
              ))}
            </div>
          </div>

          <div class="border border-yellow-500/20 bg-yellow-500/5 rounded-xl p-4">
            <h3 class="text-sm font-bold text-yellow-400 mb-3 uppercase tracking-wider text-center border-b border-yellow-500/20 pb-2">Medium</h3>
            <div class="flex flex-col gap-1.5 pr-2">
              {sflPets.requests.Medium.map(req => (
                <div class="flex items-center justify-between p-1.5 hover:bg-white/5 rounded" data-food={req}>
                  <div class="flex items-center gap-2">
                    <img src={`/img/sunflowerland/food/${req}.png`} class="w-4 h-4 object-contain" onerror="this.onerror=null; this.src='/img/cripto/sunflowerland.webp';" />
                    <span class="text-[11px] text-white/80">{req}</span>
                  </div>
                  <div class="food-cost flex items-center gap-1" set:html={getFoodCostHtml(req)}></div>
                </div>
              ))}
            </div>
          </div>

          <div class="border border-red-500/20 bg-red-500/5 rounded-xl p-4">
            <h3 class="text-sm font-bold text-red-400 mb-3 uppercase tracking-wider text-center border-b border-red-500/20 pb-2">Hard</h3>
            <div class="flex flex-col gap-1.5 pr-2">
              {sflPets.requests.Hard.map(req => (
                <div class="flex items-center justify-between p-1.5 hover:bg-white/5 rounded" data-food={req}>
                  <div class="flex items-center gap-2">
                    <img src={`/img/sunflowerland/food/${req}.png`} class="w-4 h-4 object-contain" onerror="this.onerror=null; this.src='/img/cripto/sunflowerland.webp';" />
                    <span class="text-[11px] text-white/80">{req}</span>
                  </div>
                  <div class="food-cost flex items-center gap-1" set:html={getFoodCostHtml(req)}></div>
                </div>
              ))}
            </div>
          </div>

        </div>
      </div>

    </div>

    <!-- Shrines -->
    <div class="mt-8 max-w-4xl mx-auto bg-white/[0.02] border border-white/[0.05] backdrop-blur-2xl rounded-[24px] p-6 lg:p-8 shadow-2xl">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-6 gap-2">
        <h2 class="text-2xl font-black text-white flex items-center gap-2">
          <i class="bi bi-bank text-cyan-400"></i> Altares (Shrines)
        </h2>
        <div class="text-[11px] text-white/40 italic sm:mb-1">
          El costo no incluye <strong class="text-white/60">Acorn</strong>
        </div>
      </div>
      
      <div class="overflow-x-auto no-scrollbar">
        <table class="w-full text-left border-collapse min-w-[500px]">
          <thead>
            <tr class="border-b border-white/10 text-[10px] uppercase tracking-widest text-white/40">
              <th class="p-4 font-mono w-2/5">Altar (Shrine)</th>
              <th class="p-4 font-mono w-2/5">Recursos</th>
              <th class="p-4 font-mono text-right w-1/5">Costo Total</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-white/5">
            {sflPets.shrines.map(shrine => (
              <tr class="hover:bg-white/[0.03] transition-colors group">
                <td class="p-4 align-top">
                  <div class="flex items-start gap-3">
                    <img src={`/img/sunflowerland/shrines/${shrine.name.toLowerCase().replace(' ', '_')}.webp`} class="w-10 h-10 object-contain drop-shadow-lg" onerror="this.onerror=null; this.src='/img/cripto/sunflowerland.webp';" />
                    <div>
                      <h3 class="text-sm font-bold text-cyan-300 leading-tight">{shrine.name}</h3>
                      <p class="text-[11px] text-terminal-muted mt-1 leading-relaxed max-w-[200px]">{shrine.effects}</p>
                    </div>
                  </div>
                </td>
                <td class="p-4 align-top">
                  <div class="flex flex-col gap-2">
                    {shrine.resources.map(res => (
                      <div class="flex items-center gap-2">
                        <img src={`/img/sunflowerland/${res.name}.png`} class="w-4 h-4 object-contain" onerror="this.onerror=null; this.src='/img/cripto/sunflowerland.webp';" />
                        <span class="text-xs text-white/80">{res.name} <span class="text-white/40 font-mono">({res.amount})</span></span>
                      </div>
                    ))}
                  </div>
                </td>
                <td class="p-4 align-top text-right">
                  <div class="flex items-center justify-end gap-1.5" set:html={getShrineCostHtml(shrine)}></div>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>

  </main>
</Layout>

<script is:inline define:vars={{ foodCostsDict, calcResources, priceDict }}>
  const formatPriceNum = (num) => {
    if (num === 0) return '0.00';
    return new Intl.NumberFormat('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 4 }).format(num);
  };

  const updateCalculator = () => {
    const energies = { easy: 20, medium: 100, hard: 300 };
    const selectedFoods = {
      easy: document.querySelector('[data-id="calc-select-easy"]').getAttribute('data-value') || "",
      medium: document.querySelector('[data-id="calc-select-medium"]').getAttribute('data-value') || "",
      hard: document.querySelector('[data-id="calc-select-hard"]').getAttribute('data-value') || ""
    };
    
    calcResources.forEach(res => {
      const resPrice = priceDict[res.name] || 0;
      const safeId = res.name.replace(/\s+/g, '_');
      
      ['easy', 'medium', 'hard'].forEach(diff => {
        const cell = document.getElementById(`calc-res-${safeId}-${diff}`);
        if (!cell) return;
        
        if (!selectedFoods[diff]) {
          cell.innerHTML = '<span class="text-[10px] text-white/20 italic">-</span>';
          return;
        }
        
        if (res.name === 'Acorn') {
          cell.innerHTML = '<span class="text-[10px] text-emerald-500/70 italic block mt-1">Idea: Construye Altares</span>';
          return;
        }
        
        if (res.name === 'Fossil Shell') {
          cell.innerHTML = '<span class="text-[10px] text-cyan-500/70 italic block mt-1">Idea: ¡Caja de sorpresas! Prueba suerte</span>';
          return;
        }
        
        const foodCost = foodCostsDict[selectedFoods[diff]];
        if (foodCost === null || foodCost === undefined || resPrice === 0) {
          cell.innerHTML = '<span class="text-[10px] text-yellow-500/50 italic">Falta info (N/A)</span>';
          return;
        }
        
        const cpe = foodCost / energies[diff];
        const obtainCost = res.energy * cpe;
        
        const ratio = (resPrice / obtainCost) * 100;
        const roi = ((resPrice - obtainCost) / obtainCost) * 100;
        
        const isProfitable = roi >= 0;
        const roiFormatted = new Intl.NumberFormat('en-US', { maximumFractionDigits: 0 }).format(Math.abs(roi));
        const sign = isProfitable ? '+' : '-';
        
        const colorClass = isProfitable ? 'bg-emerald-400 shadow-[0_0_8px_rgba(52,211,153,0.6)]' : 'bg-red-500/80';
        const textClass = isProfitable ? 'text-emerald-400' : 'text-red-400';
        
        const barWidth = Math.min(ratio, 500);
        
        cell.innerHTML = `
          <div class="w-full flex flex-col gap-1 px-4">
            <div class="flex justify-between items-end">
              <span class="text-[10px] text-white/50">Costo: <span class="text-white/80">${formatPriceNum(obtainCost)}</span></span>
              <span class="text-[11px] font-mono font-bold ${textClass}">${sign}${roiFormatted}% ${!isProfitable ? '<span class="text-[9px] font-sans opacity-70 italic ml-0.5">(Pérdida)</span>' : ''}</span>
            </div>
            <div class="w-full h-1.5 bg-black/40 rounded-full overflow-hidden border border-white/10 relative">
              <!-- Punto de equilibrio al 100% de ratio (20% visual) -->
              <div class="absolute top-0 bottom-0 left-[20%] w-[1px] bg-white/40 z-10"></div>
              <div class="h-full ${colorClass} rounded-full transition-all duration-500 relative z-0" style="width: ${barWidth / 5}%;"></div>
            </div>
          </div>
        `;
      });
    });
  };

  document.addEventListener('DOMContentLoaded', () => {
    // Inicializar Custom Dropdowns
    document.querySelectorAll('.custom-dropdown').forEach(dropdown => {
      const toggle = dropdown.querySelector('.dropdown-toggle');
      const menu = dropdown.querySelector('.dropdown-menu');
      const selectedText = dropdown.querySelector('.dropdown-selected-text');
      const options = dropdown.querySelectorAll('.dropdown-option');
      const arrow = dropdown.querySelector('.dropdown-arrow');
      
      toggle.addEventListener('click', (e) => {
        e.stopPropagation();
        // Cerrar todos los demás menús primero
        document.querySelectorAll('.dropdown-menu').forEach(m => {
          if (m !== menu) {
            m.classList.add('hidden');
            m.parentElement.querySelector('.dropdown-arrow')?.classList.remove('rotate-180');
          }
        });
        menu.classList.toggle('hidden');
        arrow.classList.toggle('rotate-180');
      });
      
      options.forEach(option => {
        option.addEventListener('click', (e) => {
          e.stopPropagation();
          const val = option.getAttribute('data-value');
          dropdown.setAttribute('data-value', val);
          
          if (val === "") {
            selectedText.innerHTML = '<span class="text-white/40">-- Seleccionar Comida --</span>';
          } else {
            // Copiar todo el html interno de la opción (imagen + texto + precio)
            selectedText.innerHTML = option.innerHTML;
          }
          
          menu.classList.add('hidden');
          arrow.classList.remove('rotate-180');
          
          // Refrescar cálculos
          updateCalculator();
        });
      });
    });
    
    // Cerrar menús si el usuario hace click afuera
    document.addEventListener('click', () => {
      document.querySelectorAll('.dropdown-menu').forEach(menu => {
        menu.classList.add('hidden');
        menu.parentElement.querySelector('.dropdown-arrow')?.classList.remove('rotate-180');
      });
    });

    // Calcular en la carga por si hay valores por defecto
    updateCalculator();
  });
</script>

