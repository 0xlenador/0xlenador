---
import Layout from "../layouts/Layout.astro";
import FaqAccordion from "../components/FaqAccordion.astro";
import AssetCard from "../components/tesis/AssetCard.astro";
import GarageCard from "../components/tesis/GarageCard.astro";

const seo = {
  title: "Estrategia y Activos | 0xLeñador",
  description:
    "Tesis de inversión 60/40 basada en entendimiento estratégico e involucramiento activo. Activos tradicionales, cripto y fase de garaje.",
  image: "/img/meta/tesis.webp",
};

// ==========================================
// Datos de activos en observación
// ==========================================
const activos = [
  {
    nombre: "S&P 500 (ETFs)",
    ticker: "SPY / VOO",
    imagen: "/img/cripto/syp500.webp",
    descripcion:
      "Benchmark del mercado tradicional. Crecimiento compuesto a largo plazo basado en las 500 líderes de EE.UU.",
    accentColor: "emerald" as const,
    ctaLabel: "Compra SPY aquí:",
    links: [
      { nombre: "Hapi", url: "https://app.hapi.trade/rewards?code=MANVAR27" },
      {
        nombre: "xstocks",
        url: "https://defi.xstocks.fi/points?ref=HOTRLH35",
      },
    ],
  },
  {
    nombre: "Berkshire Hathaway",
    ticker: "BRK.B",
    imagen: "/img/cripto/brk.webp",
    descripcion:
      "Fortaleza operativa y gestión de valor intrínseco. El estándar de seguridad en renta variable.",
    accentColor: "emerald" as const,
    ctaLabel: "Compra BRK.B aquí:",
    links: [
      { nombre: "Hapi", url: "https://app.hapi.trade/rewards?code=MANVAR27" },
      {
        nombre: "xstocks",
        url: "https://defi.xstocks.fi/points?ref=HOTRLH35",
      },
    ],
  },
  {
    nombre: "Bitcoin",
    ticker: "BTC",
    imagen: "/img/cripto/bitcoin.webp",
    descripcion:
      "Reserva de valor digital y piedra angular de la descorrelación financiera.",
    accentColor: "orange" as const,
    href: "/bitcoin",
    ctaLabel: "Consigue BTC aquí:",
    links: [
      {
        nombre: "Binance",
        url: "https://www.binance.com/en?ref=11581761",
      },
      { nombre: "Bybit", url: "https://www.bybit.com/en" },
    ],
  },
  {
    nombre: "Ethereum",
    ticker: "ETH",
    imagen: "/img/cripto/ethereum.webp",
    descripcion:
      "La capa de liquidación de contratos inteligentes. Infraestructura de la economía DeFi.",
    accentColor: "blue" as const,
    href: "/ethereum",
    ctaLabel: "Consigue ETH aquí:",
    links: [
      {
        nombre: "Binance",
        url: "https://www.binance.com/en?ref=11581761",
      },
      { nombre: "Bybit", url: "https://www.bybit.com/en" },
    ],
  },
  {
    nombre: "Hyperliquid",
    ticker: "HYPE",
    imagen: "/img/cripto/hyperliquid.webp",
    descripcion:
      "Ecosistema L1 optimizado para derivados on-chain. Liquidez extrema y alto rendimiento.",
