// ==========================================
// Datos de activos en fase de garaje
// ==========================================
const garaje = [
  {
    nombre: "Runestone",
    imagen: "/img/cripto/runestone.webp",
    descripcion:
      "Apuesta por la infraestructura cultural en Bitcoin a través de inscripciones.",
    ctaLabel: "Mercado de Runestone:",
    link: {
      nombre: "UniSat Market",
      url: "https://unisat.io/market/collection?collectionId=runestone",
    },
  },
  {
    nombre: "Sunflower Land",
    imagen: "/img/cripto/sunflowerland.webp",
    descripcion:
      "Economía experimental de juego on-chain. Tokenomics de flujo orgánico.",
    href: "/sunflowerland",
    ctaLabel: "Comienza en Sunflower Land:",
    link: {
      nombre: "Sunflower Land Web",
      url: "https://sunflower-land.com/play/?ref=Oxlenador",
    },
  },
];

// ==========================================
// Datos del FAQ
// ==========================================
const faqItems = [
  {
    pregunta: "¿Qué es una tesis de inversión?",
    respuesta:
      'Es el conjunto de reglas, lógica y principios matemáticos que dictan cómo se debe asignar el capital. Una tesis elimina el componente emocional, permitiendo que las decisiones de inversión se basen en fundamentos sólidos y objetivos medibles en lugar de intuiciones o tendencias momentáneas.',
  },
  {
    pregunta: "¿Bajo qué criterios invertimos según nuestra tesis?",
    respuesta:
      'Nuestros criterios se basan en la Asimetría Cuantitativa y la Infraestructura Base. Buscamos activos con una relación riesgo/recompensa favorable (matemáticamente probada) y nos enfocamos en protocolos que actúan como "rieles" para el futuro financiero. Si un activo no cumple con el respaldo técnico o matemático, se descarta automáticamente.',
  },
  {
    pregunta: "¿Por qué es vital conocer nuestro perfil de inversión?",
    respuesta:
      "Conocer el perfil determina nuestra capacidad de soportar el drawdown (caídas) sin comprometer la estrategia. Un portafolio bien estructurado debe estar alineado con tu resiliencia psicológica y necesidades de liquidez para evitar ventas de pánico en ciclos bajistas y permitir que el interés compuesto trabaje a largo plazo.",
  },
  {
    pregunta: "¿Por qué usamos DeFi mientras holdeamos activos?",
    respuesta:
      "Es nuestra estrategia de Colateralización Híbrida. Mantener activos ociosos es una ineficiencia de capital. Al interactuar con protocolos DeFi de bajo riesgo, podemos utilizar esos activos como colateral para farmear recompensas y calificar para airdrops, añadiendo flujos de valor adicionales sin aumentar la exposición directa al precio.",
  },
  {
    pregunta: "¿Qué significa un activo en 'Fase de Garaje'?",
    respuesta:
      'Representa activos en etapa experimental o embrionaria. Operamos bajo una mentalidad de "0 o 1": el capital asignado se considera de riesgo total, con el potencial de desaparecer o de generar retornos asimétricos masivos. Es la porción más agresiva y especulativa de nuestra gestión de capital.',
  },
];
---

<Layout title={seo.title} description={seo.description} image={seo.image}>
  <main class="max-w-6xl mx-auto px-6 reveal">
    <header class="mb-20">
      <h1
        class="text-4xl md:text-6xl font-black text-white mb-4 tracking-tighter italic uppercase"
      >
        Tesis de <span class="text-emerald-500">Inversión</span>
      </h1>
      <div class="flex flex-col md:flex-row md:items-center gap-4">
        <p
          class="text-[10px] font-mono text-terminal-muted uppercase tracking-[0.4em]"
        >
          Protocolo: entendimiento estratégico e involucramiento activo
        </p>
        <span class="hidden md:block w-12 h-px bg-terminal-border-subtle"></span>
        <span class="text-[10px] font-mono text-emerald-500/70 uppercase"
          >Versión 2.0.0</span
        >
      </div>
    </header>

    <section class="mb-24">
      <div
        class="bg-terminal-surface/20 border border-terminal-border p-8 md:p-12 rounded-[2rem] relative overflow-hidden"
      >
        <div
          class="absolute top-0 right-0 w-64 h-64 bg-emerald-500/5 blur-[120px] rounded-full -mr-32 -mt-32"
        >
        </div>
        <div class="max-w-5xl">
          <h2 class="text-white font-bold text-xl mb-6">
            Filosofía de Convicción y Entendimiento
          </h2>
          <p class="text-sm text-terminal-secondary leading-relaxed mb-12">
            Vale más lo que comprendemos de un proyecto que el capital que
            depositamos en él. El conocimiento técnico es el único factor que nos
            condiciona para operar con carácter frente a la volatilidad.
          </p>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            <div>
              <h3
                class="text-emerald-500 font-bold text-xs uppercase tracking-widest mb-4"
              >
                01. Entendimiento y Colateralización
              </h3>
              <p class="text-xs leading-relaxed text-terminal-muted">
                Mantenemos un 60% en inversiones tradicionales equilibradas (ETFs
                y CDTs). No las elegimos por ser "seguras", sino porque
                entendemos su estructura. Usamos una fracción en instrumentos
                DeFi para capturar recompensas y airdrops, involucrándonos en la
                tecnología para exprimir la eficiencia del capital.
              </p>
            </div>

            <div>
              <h3
                class="text-emerald-500 font-bold text-xs uppercase tracking-widest mb-4"
              >
                02. Involucramiento Asimétrico
              </h3>
              <p class="text-xs leading-relaxed text-terminal-muted">
                Vale más lo que comprendemos de la infraestructura que lo que
                invertimos en ella. Nos concentramos en los "rieles"
                tecnológicos que dominamos técnicamente, aceptando que este
                conocimiento es el que nos permite buscar retornos exponenciales
                con convicción absoluta.
              </p>
            </div>

            <div>
              <h3
                class="text-emerald-500 font-bold text-xs uppercase tracking-widest mb-4"
              >
                03. Carácter Cuantitativo
              </h3>
              <p class="text-xs leading-relaxed text-terminal-muted">
                El carácter ante la volatilidad es el resultado de la preparación
                matemática. No operamos por narrativa; operamos porque el cálculo
                de probabilidades nos otorga la frialdad necesaria para mantener
                la posición cuando el mercado entra en pánico.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <div class="flex items-center justify-between mb-8">
      <h2 class="text-xs font-mono text-terminal-subtle uppercase tracking-[0.5em]">
        Activos en Observación
      </h2>
      <div class="h-px flex-grow ml-6 bg-terminal-border/50 glitch-separator"></div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-20">
      {activos.map((activo) => <AssetCard {...activo} />)}
    </div>

    <div class="mb-8">
      <div class="flex items-center justify-between mb-2">
        <h2
          class="text-xs font-mono text-rose-500 uppercase tracking-[0.5em]"
        >
          Fase de Garaje
        </h2>
        <div class="h-px flex-grow ml-6 bg-rose-500/20 glitch-separator"></div>
      </div>
      <p
        class="text-[10px] font-mono text-rose-500/60 uppercase italic tracking-widest text-right"
      >
        ⚠️ Riesgo de asimetría total: 0 o 1.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {garaje.map((item) => <GarageCard {...item} />)}
    </div>

    <FaqAccordion
      titulo="Preguntas Frecuentes"
      subtitulo="Protocolos y Estrategia de Inversión"
      items={faqItems}
    />

    <div class="mt-20 text-center">
      <p
        class="text-terminal-subtle text-[10px] font-bold uppercase tracking-[0.3em] mb-4"
      >
        Financial Intelligence Engine
      </p>
      <div class="h-1 w-12 bg-emerald-500/20 mx-auto rounded-full"></div>
    </div>
  </main>
</Layout>
