---
import Layout from "../../layouts/Layout.astro"
import FaqAccordion from "../../components/FaqAccordion.astro"
import faucetsData from "../../data/faucets.json"
import { getLangFromUrl, useTranslations } from "../../i18n/utils"

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)

const seo = {
  title: t("faucets.seo.title"),
  description: t("faucets.seo.description"),
  image: "/img/meta/faucets.webp",
}

// Todos los faucets están en faucetsData (mezclados)

const faqItems = [
  {
    pregunta: t("faucets.faq.q1"),
    respuesta: t("faucets.faq.a1"),
  },
  {
    pregunta: t("faucets.faq.q2"),
    respuesta: t("faucets.faq.a2"),
  },
  {
    pregunta: t("faucets.faq.q3"),
    respuesta: t("faucets.faq.a3"),
  },
  {
    pregunta: t("faucets.faq.q4"),
    respuesta: t("faucets.faq.a4"),
  },
  {
    pregunta: t("faucets.faq.q5"),
    respuesta: t("faucets.faq.a5"),
  },
]
---

<Layout title={seo.title} description={seo.description} image={seo.image}>
  <main class="max-w-6xl mx-auto px-6 pt-10 pb-20">
    <!-- Breadcrumb -->
    <p class="text-[10px] font-mono text-emerald-500/70 uppercase tracking-[0.4em] mb-6">
      {t("faucets.breadcrumb")}
    </p>

    <!-- Header -->
    <header class="mb-10 border-b border-terminal-border/50 pb-8">
      <h1 class="text-4xl md:text-5xl font-extrabold text-white tracking-tight mb-3">
        {t("faucets.heading")} <span class="text-emerald-500"> {t("faucets.heading.accent")}</span>
      </h1>
      <p class="text-terminal-secondary text-sm leading-relaxed max-w-2xl font-light">
        {t("faucets.intro")}
      </p>
    </header>

    <!-- Buscador y filtros -->
    <div class="flex flex-col sm:flex-row gap-3 mb-10">
      <div class="relative flex-1">
        <svg
          class="absolute left-3.5 top-1/2 -translate-y-1/2 w-4 h-4 text-terminal-muted"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="1.5"
            d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z"></path>
        </svg>
        <input
          type="text"
          id="faucet-search"
          class="w-full bg-terminal-bg border border-terminal-border focus:border-emerald-500/50 focus:ring-1 focus:ring-emerald-500/20 outline-none rounded-xl pl-10 pr-4 py-3 text-white text-sm font-mono placeholder:text-terminal-muted transition-all"
          placeholder={t("faucets.search.placeholder")}
        />
      </div>

      <div class="flex bg-terminal-bg p-1 rounded-xl border border-terminal-border">
        <button
          class="tab-btn px-5 py-2 rounded-lg text-sm font-mono font-bold transition-all bg-emerald-600 text-white"
          data-filter="all">{t("faucets.filter.all")}</button
        >
        <button
          class="tab-btn px-5 py-2 rounded-lg text-sm font-mono font-bold text-terminal-muted hover:text-white transition-all"
          data-filter="testnet">Testnet</button
        >
        <button
          class="tab-btn px-5 py-2 rounded-lg text-sm font-mono font-bold text-terminal-muted hover:text-white transition-all"
          data-filter="mainnet">Mainnet</button
        >
      </div>
    </div>

    <!-- ─── FAUCETS GRID ─── -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-3 mb-16" id="grid-faucets">
      {
        faucetsData.map((faucet) => (
          <div
            class:list={[
              "item-card group border rounded-2xl p-4 flex items-start gap-4 transition-all duration-300",
              faucet.type === "mainnet"
                ? "bg-amber-500/[0.03] border-amber-500/[0.08] hover:border-amber-500/20"
                : "bg-white/[0.02] border-white/[0.05] hover:border-white/[0.08]",
            ]}
            data-type={faucet.type}
            data-tags={faucet.tags.join(" ").toLowerCase()}
          >
            <img
              src={faucet.img}
              alt={faucet.name}
              width={40}
              height={40}
              loading="lazy"
              class="w-10 h-10 object-contain rounded-xl flex-shrink-0 mt-0.5"
            />
            <div class="min-w-0">
              <div class="flex items-center gap-2 mb-1">
                <a
                  href={faucet.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class:list={[
                    "inline-flex items-center gap-1 text-sm font-semibold transition-colors no-underline",
                    faucet.type === "mainnet"
                      ? "text-white hover:text-amber-400"
                      : "text-white hover:text-emerald-400",
                  ]}
                >
                  {faucet.name}
                  <svg
                    class="w-3 h-3 opacity-40"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
                    />
                  </svg>
                </a>
              </div>
              <div class="mb-2 flex items-center gap-2">
                <span
                  class:list={[
                    "text-[9px] font-mono uppercase tracking-wider font-bold",
                    faucet.type === "mainnet" ? "text-amber-500" : "text-emerald-500",
                  ]}
                >
                  {faucet.type.toUpperCase()}
                </span>
                {faucet.type === "mainnet" && (
                  <span class="text-[8px] font-mono text-amber-500/60 uppercase tracking-wider">
                    ref
                  </span>
                )}
              </div>
              <div class="flex flex-wrap gap-1.5 mt-2">
                {faucet.tags.map((tag) => (
                  <span
                    class:list={[
                      "faucet-tag text-xs font-medium tracking-tight px-2 py-0.5 rounded-md transition-colors",
                      faucet.type === "mainnet"
                        ? "text-amber-500/70 bg-black/40 border border-amber-500/[0.15]"
                        : "text-terminal-muted bg-black/40 border border-terminal-border/40",
                    ]}
                  >
                    {tag}
                  </span>
                ))}
              </div>
            </div>
          </div>
        ))
      }
    </div>

    <!-- FAQ -->
    <div class="border-t border-terminal-border/60 pt-14">
      <h2 class="text-xl font-bold text-white tracking-tight mb-1">{t("faucets.faq.title")}</h2>
      <p class="text-xs text-terminal-subtle mb-8">{t("faucets.faq.subtitle")}</p>
      <FaqAccordion
        titulo={t("faucets.faq.title")}
        subtitulo={t("faucets.faq.subtitle")}
        startId={600}
        items={faqItems}
      />
    </div>
  </main>
</Layout>

<script is:inline>
  var activeTab = "all"

  function applyFilters() {
    var q = document.getElementById("faucet-search").value.toLowerCase().trim()
    var cards = document.querySelectorAll(".item-card")

    cards.forEach(function (card) {
      var type = card.getAttribute("data-type")
      var tagsText = card.getAttribute("data-tags") || ""
      var name = card.querySelector("a") ? card.querySelector("a").textContent.toLowerCase() : ""

      var tabMatch = activeTab === "all" || type === activeTab
      var queryMatch = q === "" || tagsText.includes(q) || name.includes(q)

      if (tabMatch && queryMatch) {
        card.classList.remove("hidden")
      } else {
        card.classList.add("hidden")
      }

      // Highlight tags que coinciden con la búsqueda
      var tagEls = card.querySelectorAll(".faucet-tag")
      tagEls.forEach(function (tag) {
        if (q !== "" && tag.textContent.toLowerCase().includes(q)) {
          tag.classList.add("highlight")
          tag.classList.remove("dimmed")
        } else if (q !== "") {
          tag.classList.remove("highlight")
          tag.classList.add("dimmed")
        } else {
          tag.classList.remove("highlight", "dimmed")
        }
      })
    })

    // Fin de función applyFilters
  }

  document.querySelectorAll(".tab-btn").forEach(function (btn) {
    btn.addEventListener("click", function () {
      activeTab = btn.getAttribute("data-filter")

      document.querySelectorAll(".tab-btn").forEach(function (b) {
        b.classList.remove("bg-emerald-600", "text-white")
        b.classList.add("text-terminal-muted")
      })
      btn.classList.add("bg-emerald-600", "text-white")
      btn.classList.remove("text-terminal-muted")

      applyFilters()
    })
  })

  document.getElementById("faucet-search").addEventListener("input", applyFilters)
</script>
