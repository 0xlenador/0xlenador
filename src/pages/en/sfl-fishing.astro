---
import Layout from "../../layouts/Layout.astro"
import { getLangFromUrl, useTranslations } from "../../i18n/utils"
import SflFishingView from "../../components/views/SflFishingView.astro"

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)

const seo = {
  title: t("sfl.fishing.seo.title"),
  description: t("sfl.fishing.seo.description"),
  image: "/img/meta/sunflowerland-og.webp",
}
---

<Layout title={seo.title} description={seo.description} image={seo.image} customSpacing>
  <SflFishingView />
</Layout>

