---
import { getBlogPostsByLang } from "../../../lib/content"
import Layout from "../../../layouts/Layout.astro"
import BlogArticleView from "../../../components/views/BlogArticleView.astro"

// 1. Generar rutas solo para posts en inglés
export async function getStaticPaths() {
  const posts = await getBlogPostsByLang("en")
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }))
}

const { post } = Astro.props
const { title, description, keywords, date, coverImage } = post.data

const ogImage = coverImage?.src

// Schema.org BlogPosting para SEO estructurado
const blogSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: title,
  description,
  datePublished: new Date(date).toISOString(),
  author: {
    "@type": "Person",
    name: "0x Leñador",
    url: new URL("/en/author", Astro.site).href,
  },
  publisher: {
    "@type": "Organization",
    name: "0x Leñador",
    url: "https://0xlenador.xyz",
  },
  image: ogImage ? new URL(ogImage, "https://0xlenador.xyz").href : undefined,
  mainEntityOfPage: {
    "@type": "WebPage",
    "@id": new URL(Astro.url.pathname, Astro.site).href,
  },
}

const translationSlug = post.data.translationSlug
// Trailing slash explícito y fallback correcto:
// - enUrl: siempre la página EN actual
// - esUrl: usa translationSlug si existe; si no, asume mismo slug en /blog/ (ES)
const enUrl = `/en/blog/${post.slug}/`
const esUrl = translationSlug ? `/blog/${translationSlug}/` : `/blog/${post.slug}/`
---

<Layout
  title={`${title} | 0x Leñador`}
  description={description}
  keywords={keywords}
  ogType="article"
  image={ogImage}
  schema={blogSchema}
  publishedTime={new Date(date).toISOString()}
  author="0x Leñador"
  esUrl={esUrl}
  enUrl={enUrl}
>
  <BlogArticleView post={post} />
</Layout>
