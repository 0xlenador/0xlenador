---
import { getGuiasByLang } from "../../../lib/content"
import Layout from "../../../layouts/Layout.astro"
import GuiaDetailView from "../../../components/views/GuiaDetailView.astro"

// 1. Generar rutas estáticas solo para guías en inglés
export async function getStaticPaths() {
  const guias = await getGuiasByLang("en")
  return guias.map((guia) => ({
    params: { slug: guia.slug },
    props: { guia },
  }))
}

const { guia } = Astro.props
const { title, description, imagen, tags, date } = guia.data

const ogImage = imagen

// Schema.org TechArticle para SEO estructurado
const guiaSchema = {
  "@context": "https://schema.org",
  "@type": "TechArticle",
  headline: title,
  description,
  datePublished: new Date(date).toISOString(),
  author: {
    "@type": "Person",
    name: "0xLeñador",
    url: "https://0xlenador.xyz",
  },
  publisher: {
    "@type": "Organization",
    name: "0xLeñador",
    url: "https://0xlenador.xyz",
  },
  image: ogImage ? new URL(ogImage, "https://0xlenador.xyz").href : undefined,
  mainEntityOfPage: {
    "@type": "WebPage",
    "@id": new URL(Astro.url.pathname, Astro.site).href,
  },
}
---

<Layout
  title={`${title} | 0xLeñador`}
  description={description}
  keywords={tags.join(", ")}
  ogType="article"
  image={ogImage}
  schema={guiaSchema}
  publishedTime={new Date(date).toISOString()}
  author="0xLeñador"
>
  <GuiaDetailView guia={guia} />
</Layout>
