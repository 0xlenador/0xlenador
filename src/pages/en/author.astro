---
import Layout from "../../layouts/Layout.astro"
import SocialLinks from "../../components/SocialLinks.astro"
import { useTranslations } from "../../i18n"

const lang = "en"
const t = useTranslations(lang)

const title = "0x Leñador | Web3 Researcher & Operator"
const description = "Discover the story behind the 0x Leñador Hub. From Excel spreadsheets to Web3 tools and on-chain strategies."

const authorSchema = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  mainEntity: {
    "@type": "Person",
    name: "0x Leñador",
    alternateName: "Manuel Felipe Vargas",
    jobTitle: "Web3 Researcher",
    description: "Researcher and operator focused on DeFi, Airdrops, and Gaming in the Web3 ecosystem.",
    image: new URL("/img/44.webp", Astro.site).href,
    url: new URL(Astro.url.pathname, Astro.site).href,
    sameAs: [
      "https://x.com/0xlenador",
      "https://discord.gg/Yq95Uq48",
      "https://github.com/0xlenador"
    ]
  }
}
---

<Layout
  title={title}
  description={description}
  schema={authorSchema}
  ogType="profile"
  image="/img/44.webp"
  esUrl="/autor/"
  enUrl="/en/author/"
>
  <main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 sm:py-12">
    <div class="relative bg-white/5 backdrop-blur-xl border border-white/10 rounded-3xl overflow-hidden shadow-2xl">
      <div class="absolute inset-0 bg-gradient-to-br from-green-500/10 via-transparent to-blue-500/10 pointer-events-none"></div>
      
      <div class="relative px-6 py-12 sm:px-12 sm:py-16 flex flex-col md:flex-row items-center md:items-start gap-10">
        
        <!-- Avatar Section -->
        <div class="flex-shrink-0 flex flex-col items-center">
          <div class="w-24 h-24 md:w-40 md:h-40 rounded-full border-4 border-white/10 overflow-hidden shadow-[0_0_30px_rgba(34,197,94,0.3)] bg-gray-800">
            <img src="/img/44.webp" alt="0x Leñador - Web3 Researcher and Operator" class="w-full h-full object-cover" />
          </div>
          <h1 class="mt-4 md:mt-6 text-xl md:text-3xl font-bold text-white tracking-tight">0x<span class="ml-1.5 md:ml-2">Leñador</span></h1>
          <p class="text-green-400 font-medium text-xs md:text-sm mt-1 uppercase tracking-widest">Web3 Researcher</p>
          <div class="mt-6 flex justify-center w-full">
            <SocialLinks variant="responsive" />
          </div>
        </div>

        <!-- Bio Section -->
        <div class="flex-1 space-y-6 text-gray-300 text-lg leading-relaxed">
          <p class="text-xl text-white font-medium">
            Welcome to my digital logbook. What you see here is exactly what I operate, research, and build on a daily basis.
          </p>
          
          <div class="space-y-4">
            <h2 class="text-2xl font-bold text-white mt-8 mb-4">From Excel to Web3 Hub</h2>
            <p>
              For a long time, the only way to keep track of airdrops, DeFi strategies, and on-chain gaming mechanics was through endless notebooks and spreadsheets. The fragmentation of information in Web3 is overwhelming.
            </p>
            <p>
              I initially created this Hub as a personal necessity: to centralize my links, standardize my research, and keep an orderly track of my operations.
            </p>
            <p>
              Over time, I realized that sharing these structured records provided real value to the community. Thus, my personal logbook evolved into this Operational Hub.
            </p>
          </div>
          
          <div class="space-y-4">
            <h2 class="text-2xl font-bold text-white mt-8 mb-4">My Approach</h2>
            <ul class="list-disc pl-5 space-y-2 text-gray-300">
              <li><strong class="text-white">Skin in the Game:</strong> Analyzing and testing projects is just the beginning; operating with your own capital is what truly conditions you and keeps you sharp. Here, we operate to win. If there's a setback, it's documented honestly, but the non-negotiable goal is long-term profitability.</li>
              <li><strong class="text-white">Survival and Asymmetries:</strong> The market demands balance. I rely on solid, established investments (S&P 500, Berkshire Hathaway, RWAs, and Bitcoin's current solidity) to weather the storms. At the same time, I look for market anomalies: reserving a small portion for disruptive, garage-stage projects that can break out like dark horses.</li>
              <li><strong class="text-white">Professional Transparency:</strong> I'm Manuel Felipe Vargas, the researcher and operator behind 0x Leñador. <a href="https://www.linkedin.com/in/felipevargasborja/" target="_blank" rel="noopener noreferrer" class="text-green-400 hover:text-green-300 underline underline-offset-4 decoration-green-400/30 hover:decoration-green-400 transition-colors">LinkedIn</a></li>
            </ul>
          </div>
          
          <div class="mt-8 pt-8 border-t border-white/10 text-sm text-gray-400 italic">
            <p><strong>Disclaimer:</strong> All content documented on this site and my social networks is strictly for research and educational purposes. Nothing I share should be interpreted as financial or investment advice. Web3 markets are highly experimental and carry substantial risk of loss. Join my X account, where I share my analysis and current operations.</p>
          </div>

          <!-- Internal Linking SEO -->
          <div class="mt-8 flex flex-col sm:flex-row gap-4">
            <a href="/en/operations/" class="flex-1 bg-emerald-500/10 hover:bg-emerald-500/20 border border-emerald-500/20 text-emerald-400 text-center py-3 px-4 rounded-xl font-medium transition-colors">
              Explore my Operations
            </a>
            <a href="/en/blog/" class="flex-1 bg-white/5 hover:bg-white/10 border border-white/10 text-white text-center py-3 px-4 rounded-xl font-medium transition-colors">
              Read my Analysis
            </a>
          </div>

        </div>
      </div>
    </div>
  </main>
</Layout>
