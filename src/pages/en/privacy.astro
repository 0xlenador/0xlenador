---
import Layout from "../../layouts/Layout.astro"
import { getLangFromUrl, useTranslations } from "../../i18n/utils"

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)

const seo = {
  title: t('privacy.seo.title'),
  description: t('privacy.seo.description'),
}
---

<Layout title={seo.title} description={seo.description}>
  <main class="max-w-3xl mx-auto px-6">
    <header class="mb-16">
      <h1 class="text-4xl md:text-5xl font-black text-white mb-4 tracking-tighter italic uppercase">
        {t('privacy.heading')} <span class="text-emerald-500">{t('privacy.heading.accent')}</span> {t('privacy.heading.end')}
      </h1>
      <p class="text-[10px] font-mono text-terminal-muted uppercase tracking-[0.4em]">
        {t('privacy.subtitle')}
      </p>
    </header>

    <div class="space-y-12 leading-relaxed text-sm text-justify">
      <section>
        <h2 class="text-white font-bold uppercase tracking-widest mb-4 flex items-center gap-2">
          <span class="w-2 h-2 bg-emerald-500 rounded-full"></span>
          1. Data Controller
        </h2>
        <p>
          The website <span class="text-terminal-text">0xlenador.xyz</span> is an educational outreach platform operated by <span class="text-terminal-text">0x Leñador</span>. This project aims to share investment strategies and fundamental analysis tools without collecting sensitive personal information from its users.
        </p>
      </section>

      <section>
        <h2 class="text-white font-bold uppercase tracking-widest mb-4 flex items-center gap-2">
          <span class="w-2 h-2 bg-emerald-500 rounded-full"></span>
          2. Data Processing in Tools
        </h2>
        <p>
          Our tools, including <span class="text-terminal-text">Riskfolio</span> and the <span class="text-terminal-text">Intrinsic Value Calculator</span>, are designed to run entirely in the user's browser (Client-Side).
        </p>
        <div
          class="mt-4 p-4 bg-terminal-surface/40 border-l-2 border-emerald-500 rounded-r-xl italic text-terminal-secondary"
        >
          The financial values you input into these simulators are never sent to our servers nor stored in any external database.
        </div>
      </section>

      <section>
        <h2 class="text-white font-bold uppercase tracking-widest mb-4 flex items-center gap-2">
          <span class="w-2 h-2 bg-emerald-500 rounded-full"></span>
          3. Cookies and Third-Party Metrics
        </h2>
        <p>
          To optimize performance and user experience, we use <span class="text-terminal-text">Google Analytics</span> and <span class="text-terminal-text">Google Tag Manager</span>. These services use cookies to collect anonymous information such as:
        </p>
        <ul class="list-disc pl-5 mt-4 space-y-2 text-terminal-muted">
          <li>Pages visited and browsing time.</li>
          <li>Device type and general geographic location (country/city).</li>
          <li>Traffic sources (where you came from before entering the site).</li>
        </ul>
      </section>

      <section>
        <h2 class="text-white font-bold uppercase tracking-widest mb-4 flex items-center gap-2">
          <span class="w-2 h-2 bg-emerald-500 rounded-full"></span>
          4. Affiliate Transparency
        </h2>
        <p>
          In compliance with good disclosure practices, we inform you that certain links in the <span class="text-terminal-text">Analysis Directory</span> (specifically <span class="text-white">TradingView</span>) contain affiliate tracking codes. This may generate a commission for the project if you decide to purchase a service, helping to maintain the platform free of charge and free of invasive advertising.
        </p>
      </section>

      <section>
        <h2 class="text-white font-bold uppercase tracking-widest mb-4 flex items-center gap-2">
          <span class="w-2 h-2 bg-emerald-500 rounded-full"></span>
          5. Your Rights
        </h2>
        <p>
          As a user, you have the right to browse privately using tracking blocker extensions or configuring your browser to reject cookies. Being a static site, we do not maintain user profiles or accounts that require the management of direct personal data.
        </p>
      </section>
    </div>

    <div class="mt-20 pt-10 border-t border-terminal-border text-center">
      <p class="text-[9px] font-mono text-terminal-subtle uppercase tracking-widest">
        {t('privacy.updated')}
      </p>
    </div>
  </main>
</Layout>
