---
import Layout from "../../layouts/Layout.astro"
import { getLangFromUrl, useTranslations } from "../../i18n/utils"

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)

const seo = {
  title: t('privacy.seo.title'),
  description: t('privacy.seo.description'),
}
---

<Layout title={seo.title} description={seo.description}>
  <main class="max-w-3xl mx-auto px-6">
    <header class="mb-16">
      <h1 class="text-4xl md:text-5xl font-black text-white mb-4 tracking-tighter italic uppercase">
        {t('privacy.heading')} <span class="text-emerald-500">{t('privacy.heading.accent')}</span> {t('privacy.heading.end')}
      </h1>
      <p class="text-[10px] font-mono text-terminal-muted uppercase tracking-[0.4em]">
        {t('privacy.subtitle')}
      </p>
    </header>

    <div class="space-y-12 leading-relaxed text-sm text-justify">
      <section>
        <h2 class="text-white font-bold uppercase tracking-widest mb-4 flex items-center gap-2">
          <span class="w-2 h-2 bg-emerald-500 rounded-full"></span>
          1. Data Controller
        </h2>
        <p>
          The website <span class="text-terminal-text">0xlenador.xyz</span> is an educational outreach platform operated by <span class="text-terminal-text">0x Leñador</span>. This project aims to share investment strategies and fundamental analysis tools without collecting sensitive personal information from its users.
        </p>
      </section>

      <section>
        <h2 class="text-white font-bold uppercase tracking-widest mb-4 flex items-center gap-2">
          <span class="w-2 h-2 bg-emerald-500 rounded-full"></span>
          2. Data Processing in Tools
        </h2>
        <p>
          Our tools, including <span class="text-terminal-text">Riskfolio</span> and the <span class="text-terminal-text">Intrinsic Value Calculator</span>, are designed to run entirely in the user's browser (Client-Side).
        </p>
        <div
          class="mt-4 p-4 bg-terminal-surface/40 border-l-2 border-emerald-500 rounded-r-xl italic text-terminal-secondary"
        >
          The financial values you input into these simulators are never sent to our servers nor stored in any external database.
        </div>
      </section>

      <section>
        <h2 class="text-white font-bold uppercase tracking-widest mb-4 flex items-center gap-2">
          <span class="w-2 h-2 bg-emerald-500 rounded-full"></span>
          3. Privacy by Design and Cookies
        </h2>
        <p>
          At 0xLeñador we believe in privacy by default. <strong>We do not use Google Analytics or third-party trackers</strong> to monitor your behavior. This is a static site and does not use invasive tracking or advertising "cookies".
        </p>
        <p class="mt-4">
          We only use your browser's functional local storage (<span class="text-terminal-text">LocalStorage / SessionStorage</span>) to save strictly technical configurations requested by you anonymously, such as:
        </p>
        <ul class="list-disc pl-5 mt-4 space-y-2 text-terminal-muted">
          <li>Your language preference for future visits.</li>
          <li>Display preferences (e.g., hiding the blog sidebar).</li>
          <li>Temporary caching for market data to make the site load faster.</li>
        </ul>
      </section>

      <section>
        <h2 class="text-white font-bold uppercase tracking-widest mb-4 flex items-center gap-2">
          <span class="w-2 h-2 bg-emerald-500 rounded-full"></span>
          4. Affiliate Transparency (Referrals)
        </h2>
        <p>
          In compliance with good disclosure practices, we inform you that we make active use of <strong>referral and affiliate links</strong> across the site, especially in our <span class="text-terminal-text">Web3 Analysis & Tools Directory</span>.
        </p>
        <p class="mt-4 text-terminal-muted">
          If you click these links to sign up or use external platforms (such as exchanges, wallets, or trading tools), the project may earn a commission. This is what helps us keep the educational platform 100% free of charge and free of annoying ads. Please note that clicking these links will take you away from our site, and you will be subject to the privacy and cookie policies of those third-party websites.
        </p>
      </section>

      <section>
        <h2 class="text-white font-bold uppercase tracking-widest mb-4 flex items-center gap-2">
          <span class="w-2 h-2 bg-emerald-500 rounded-full"></span>
          5. Your Rights
        </h2>
        <p>
          As a user, you have the full right to browse anonymously. Since we are a private static site, we do not collect your information, we do not require account creation, nor do we maintain databases with your direct personal data. You are in total control of your browsing.
        </p>
      </section>
    </div>

    <div class="mt-20 pt-10 border-t border-terminal-border text-center">
      <p class="text-[9px] font-mono text-terminal-subtle uppercase tracking-widest">
        {t('privacy.updated')}
      </p>
    </div>
  </main>
</Layout>
