---
import { getCollection } from "astro:content"
import Layout from "../../../layouts/Layout.astro"
import AssetDetailView from "../../../components/views/AssetDetailView.astro"
import { getLangFromUrl, getBilingual } from "../../../i18n/utils"

export async function getStaticPaths() {
  const assets = await getCollection("watchlist")
  return assets.map((asset) => ({
    params: { id: asset.id },
    props: { data: asset.data },
  }))
}

const { data } = Astro.props
const lang = getLangFromUrl(Astro.url)

const seoTitle = getBilingual(data.seo.title, lang)
const seoDesc = getBilingual(data.seo.description, lang)

// Estructura Schema.org para SEO
const schema = [
  {
    "@context": "https://schema.org",
    "@type": "TechArticle",
    headline: seoTitle,
    description: seoDesc,
    image: data.seo.ogImage,
    author: {
      "@type": "Person",
      name: "0x Leñador",
      url: "https://0xlenador.xyz/",
    },
    publisher: { "@type": "Organization", name: "0xLeñador" },
    mainEntityOfPage: { "@type": "WebPage", "@id": data.pageUrl },
  },
]
---

<Layout
  title={seoTitle}
  description={seoDesc}
  image={data.seo.ogImage}
  schema={schema}
>
  <AssetDetailView data={data} />
</Layout>
