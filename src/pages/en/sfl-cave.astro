---
import Layout from "../../layouts/Layout.astro"
import { getLangFromUrl, useTranslations } from "../../i18n/utils"
import SflCaveView from "../../components/views/SflCaveView.astro"

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)

const seo = {
  title: t("sfl.cave.seo.title"),
  description: t("sfl.cave.seo.description"),
  image: "/img/meta/sunflowerland-og.webp",
}
---

<Layout title={seo.title} description={seo.description} image={seo.image} customSpacing>
  <SflCaveView />
</Layout>

