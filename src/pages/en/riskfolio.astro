---
import Layout from "../../layouts/Layout.astro"
import RiskfolioView from "../../components/views/RiskfolioView.astro"
import { getLangFromUrl, useTranslations } from "../../i18n/utils"

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)
---

<Layout
  title={t("riskfolio.seo.title")}
  description={t("riskfolio.seo.description")}
  image="/img/meta/home.webp"
>
  <RiskfolioView />
</Layout>
