---
import Layout from "../../layouts/Layout.astro"
import { Icon } from "astro-icon/components"
import Slider from "../../components/Slider.astro"

const heroSlides = [
  {
    tag: "Gaming",
    title: "Yakkamon Hub",
    description: "Calculators, guides, and breeding tools to maximize your yields in the Yakkamon ecosystem.",
    url: "/en/yakkamon",
    urlText: "Visit Hub",
    icon: "lucide:swords",
    image: "/img/cripto/yakkamon.webp"
  },
  {
    tag: "Resources",
    title: "Faucets Directory",
    description: "Curated list of faucet websites. Get testnet tokens for development and some for mainnet.",
    url: "/en/faucets",
    urlText: "Get Tokens",
    icon: "lucide:droplet",
    images: [
      "/img/cripto/optimism.webp",
      "/img/cripto/circle.webp",
      "/img/cripto/alchemy.webp",
      "/img/cripto/bitcoin.webp",
      "/img/cripto/google.webp",
      "/img/cripto/quicknode.webp"
    ]
  },
  {
    tag: "Guides",
    title: "Active Operations",
    description: "Discover which projects we are operating in and how to do it. Follow our step-by-step guides and strategies to interact on-chain.",
    url: "/en/operations",
    urlText: "Explore Guides",
    icon: "lucide:book-open",
    guides: [
      { logo: "/img/cripto/arc.webp" },
      { logo: "/img/cripto/polymarket.webp" },
      { logo: "/img/cripto/yakkamon.webp" }
    ]
  }
];

const seo = {
  title: "Directory | 0x Leñador",
  description: "Your gateway to the ecosystem. Explore calculators, deep analysis, and all the tools for your on-chain operations.",
  image: "/img/meta/home.webp",
}

const pageSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": seo.title,
  "description": seo.description,
  "url": "https://0xlenador.xyz/en/directory/",
  "publisher": {
    "@type": "Organization",
    "name": "0x Leñador",
    "logo": {
      "@type": "ImageObject",
      "url": "https://0xlenador.xyz/img/logo.png"
    }
  }
}
---

<Layout title={seo.title} description={seo.description} image={seo.image} schema={pageSchema}>
  <main class="relative max-w-6xl mx-auto px-6 pt-12 pb-32">
    <!-- Ambient Background Glow -->
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-full max-w-3xl h-[400px] bg-emerald-500/5 blur-[120px] rounded-full pointer-events-none -z-10"></div>

    <!-- Hero Section -->
    <header class="flex flex-col items-center text-center mb-10">
      <!-- H1 applying strict hierarchy rule -->
      <h1 class="text-xl md:text-2xl font-bold text-white tracking-tight mb-4">
        0x Leñador's <span class="text-emerald-500">Directory</span>
      </h1>
    </header>

    <!-- Highlight Slider -->
    <div class="mb-10">
      <Slider slides={heroSlides} />
    </div>

    <!-- Directory Description -->
    <div class="text-center mb-16">
      <p class="text-sm text-terminal-secondary leading-relaxed max-w-2xl mx-auto">
        Your gateway to the ecosystem. Explore calculators designed to give you a statistical edge, deep analysis for your investments, and a complete suite to power your operations. Dive in and discover everything we've built!
      </p>
    </div>

    <!-- Bento Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">

      <!-- Card 1: Operations (Spans 2 columns) -->
      <a href="/en/operations" class="group relative overflow-hidden rounded-2xl bg-[#0a0a0a] border border-white/5 hover:border-emerald-500/30 transition-all duration-500 md:col-span-2 min-h-[300px] flex flex-col justify-end p-6 md:p-8">
        <div class="absolute inset-0 bg-gradient-to-br from-emerald-500/5 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
        
        <!-- Abstract Decoration -->
        <div class="absolute top-0 right-0 p-8 opacity-20 group-hover:opacity-50 transition-opacity duration-700">
          <svg width="160" height="120" viewBox="0 0 200 150" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M0 100 Q 40 80, 80 110 T 160 60 T 200 20" stroke="url(#paint0_linear)" stroke-width="4" stroke-linecap="round"/>
            <path d="M0 130 Q 40 110, 80 140 T 160 90 T 200 50" stroke="#ffffff" stroke-opacity="0.1" stroke-width="2" stroke-dasharray="4 4" stroke-linecap="round"/>
            <defs>
              <linearGradient id="paint0_linear" x1="0" y1="100" x2="200" y2="20" gradientUnits="userSpaceOnUse">
                <stop stop-color="#10B981" />
                <stop offset="1" stop-color="#047857" stop-opacity="0" />
              </linearGradient>
            </defs>
          </svg>
        </div>

        <div class="relative z-10 w-full md:w-3/4">
          <div class="w-10 h-10 rounded-xl bg-white/[0.03] border border-white/10 flex items-center justify-center text-white mb-4 group-hover:-translate-y-1 transition-transform duration-300">
            <Icon name="lucide:activity" class="w-5 h-5" />
          </div>
          <!-- H2 applying strict hierarchy rule -->
          <h2 class="text-lg md:text-xl font-bold text-white mb-2">Operations & Journal</h2>
          <p class="text-sm text-terminal-secondary mb-5">
            The battlefield. Discover our strategies, interaction guides, and log to operate on-chain with a statistical edge.
          </p>
          <div class="flex items-center gap-1.5 text-[10px] font-mono text-emerald-400 uppercase tracking-widest group-hover:gap-2 transition-all">
            <span>Access Dashboard</span>
            <Icon name="lucide:arrow-right" class="w-3 h-3" />
          </div>
        </div>
      </a>

      <!-- Card 2: Assets (Spans 1 column) -->
      <a href="/en/watchlist" class="group relative overflow-hidden rounded-2xl bg-[#0a0a0a] border border-white/5 hover:border-emerald-500/30 transition-all duration-500 md:col-span-1 min-h-[300px] flex flex-col p-6 md:p-8">
        <div class="absolute inset-0 bg-gradient-to-b from-transparent via-transparent to-emerald-500/10 opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
        
        <div class="w-10 h-10 rounded-xl bg-white/[0.03] border border-white/10 flex items-center justify-center text-white mb-auto group-hover:scale-110 transition-transform duration-300">
          <Icon name="lucide:coins" class="w-5 h-5" />
        </div>

        <div class="relative z-10 mt-8">
          <h2 class="text-lg md:text-xl font-bold text-white mb-2">Asset Thesis</h2>
          <p class="text-sm text-terminal-secondary mb-5">
            We don't buy on faith. Solid fundamental analysis, on-chain metrics, and risk evaluation to filter market noise.
          </p>
          <div class="flex items-center gap-1.5 text-[10px] font-mono text-emerald-400 uppercase tracking-widest group-hover:gap-2 transition-all">
            <span>Explore Tokens</span>
            <Icon name="lucide:arrow-right" class="w-3 h-3" />
          </div>
        </div>
      </a>

      <!-- Card 3: Tools (Spans 1 column) -->
      <a href="/en/tools" class="group relative overflow-hidden rounded-2xl bg-[#0a0a0a] border border-white/5 hover:border-emerald-500/30 transition-all duration-500 md:col-span-1 min-h-[300px] flex flex-col p-6 md:p-8">
        <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_bottom_right,rgba(16,185,129,0.15),transparent)] opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>

        <!-- Abstract Decoration -->
        <div class="absolute top-6 right-6 grid grid-cols-2 gap-1.5 opacity-20 group-hover:opacity-50 transition-opacity duration-500">
          <div class="w-5 h-5 rounded-[4px] border border-white/20"></div>
          <div class="w-5 h-5 rounded-[4px] bg-white/20"></div>
          <div class="w-5 h-5 rounded-[4px] bg-white/10"></div>
          <div class="w-5 h-5 rounded-[4px] border border-emerald-500/40"></div>
        </div>

        <div class="w-10 h-10 rounded-xl bg-white/[0.03] border border-white/10 flex items-center justify-center text-white mb-auto group-hover:rotate-12 transition-transform duration-300">
          <Icon name="lucide:wrench" class="w-5 h-5" />
        </div>

        <div class="relative z-10 mt-8">
          <h2 class="text-lg md:text-xl font-bold text-white mb-2">Tools</h2>
          <p class="text-sm text-terminal-secondary mb-5">
            Stop trading blind. Impermanent loss simulators, yield calculators, and key utilities for your on-chain survival.
          </p>
          <div class="flex items-center gap-1.5 text-[10px] font-mono text-emerald-400 uppercase tracking-widest group-hover:gap-2 transition-all">
            <span>Use Utilities</span>
            <Icon name="lucide:arrow-right" class="w-3 h-3" />
          </div>
        </div>
      </a>

      <!-- Card 4: Web3 List (Spans 2 columns) -->
      <a href="/en/web3-list" class="group relative overflow-hidden rounded-2xl bg-[#0a0a0a] border border-white/5 hover:border-emerald-500/30 transition-all duration-500 md:col-span-2 min-h-[300px] flex flex-col md:flex-row items-end md:items-center p-6 md:p-8">
        <div class="absolute inset-0 bg-gradient-to-l from-emerald-500/5 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
        
        <!-- Abstract Nodes -->
        <div class="absolute top-1/2 -translate-y-1/2 right-12 opacity-20 group-hover:opacity-60 transition-opacity duration-700 hidden md:block">
           <svg width="140" height="140" viewBox="0 0 180 180" fill="none" xmlns="http://www.w3.org/2000/svg">
             <circle cx="90" cy="90" r="89.5" stroke="white" stroke-opacity="0.1" stroke-dasharray="4 4"/>
             <circle cx="90" cy="90" r="60" stroke="#10B981" stroke-opacity="0.4"/>
             <circle cx="90" cy="90" r="30" fill="#10B981" fill-opacity="0.1"/>
             <circle cx="30" cy="90" r="4" fill="white"/>
             <circle cx="150" cy="90" r="4" fill="#10B981"/>
             <circle cx="90" cy="30" r="4" fill="white"/>
             <circle cx="90" cy="150" r="4" fill="#10B981"/>
             <path d="M30 90H150 M90 30V150" stroke="white" stroke-opacity="0.1"/>
           </svg>
        </div>

        <div class="relative z-10 w-full md:w-3/5">
          <div class="w-10 h-10 rounded-xl bg-white/[0.03] border border-white/10 flex items-center justify-center text-white mb-4 group-hover:bg-white/[0.08] transition-colors duration-300">
            <Icon name="lucide:globe" class="w-5 h-5" />
          </div>
          <h2 class="text-lg md:text-xl font-bold text-white mb-2">Web3 Resources</h2>
          <p class="text-sm text-terminal-secondary mb-5">
            Our curated arsenal. Links to faucets, exchanges, infrastructure, and all the analytics platforms that make up our stack.
          </p>
          <div class="flex items-center gap-1.5 text-[10px] font-mono text-emerald-400 uppercase tracking-widest group-hover:gap-2 transition-all">
            <span>Explore Stack</span>
            <Icon name="lucide:arrow-right" class="w-3 h-3" />
          </div>
        </div>
      </a>

      <!-- Card 5: Blog (Spans 3 columns, Banner Style) -->
      <a href="/en/blog" class="group relative overflow-hidden rounded-2xl bg-[#0a0a0a] border border-white/5 hover:border-emerald-500/30 transition-all duration-500 md:col-span-3 min-h-[200px] flex flex-col md:flex-row items-center p-6 md:p-8">
        <div class="absolute inset-0 bg-gradient-to-r from-transparent via-emerald-500/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>

        <div class="w-full md:w-1/2 relative z-10 pr-0 md:pr-10 mb-6 md:mb-0">
          <div class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md bg-white/[0.05] border border-white/10 text-white text-[10px] font-mono mb-3">
            <Icon name="lucide:book-open" class="w-3 h-3 text-emerald-400" />
            Education & Analysis
          </div>
          <h2 class="text-lg md:text-xl font-bold text-white mb-2">The Lumberjack's Journal</h2>
          <p class="text-sm text-terminal-secondary mb-5">
            Deep reflections on the market, narratives, security, and step-by-step tutorials to master the DeFi ecosystem like a pro.
          </p>
          <div class="flex items-center gap-1.5 text-[10px] font-mono text-emerald-400 uppercase tracking-widest group-hover:gap-2 transition-all">
            <span>Read the Blog</span>
            <Icon name="lucide:arrow-right" class="w-3 h-3" />
          </div>
        </div>

        <div class="w-full md:w-1/2 relative z-10 flex justify-end">
          <div class="w-full max-w-sm rounded-xl border border-white/5 bg-white/[0.01] p-4 opacity-50 group-hover:opacity-100 group-hover:bg-white/[0.03] transition-all duration-500">
             <div class="h-2 rounded bg-white/10 w-1/3 mb-4"></div>
             <div class="h-1.5 rounded bg-white/5 w-full mb-2"></div>
             <div class="h-1.5 rounded bg-white/5 w-5/6 mb-2"></div>
             <div class="h-1.5 rounded bg-white/5 w-4/5"></div>
             <div class="mt-4 pt-4 border-t border-white/5 flex gap-2">
                <div class="h-4 w-4 rounded-full bg-white/10"></div>
                <div class="h-2 w-16 rounded bg-white/5 mt-1"></div>
             </div>
          </div>
        </div>
      </a>

    </div>
  </main>
</Layout>
