<script>
  function initDirectoryFilter() {
    const filterBtns = document.querySelectorAll('.filter-btn');
    const directorySearch = document.getElementById('directorySearch') as HTMLInputElement;
    const clearSearch = document.getElementById('clearSearch');
    const table = document.getElementById('directoryTable');
    const noResultsRow = document.getElementById('noResultsRow');
    
    if (!table || !directorySearch) return;
    if (table.hasAttribute('data-initialized')) return;
    table.setAttribute('data-initialized', 'true');
    
    // Select only data rows, ignoring the no results row
    const rows = Array.from(table.querySelectorAll('tbody tr')).filter(r => r.id !== 'noResultsRow');

    function filterTable() {
      // 1. Trim spaces
      const rawSearch = directorySearch.value.trim().toLowerCase();
      // 2. Filter only if it has 3 or more chars
      const searchTerm = rawSearch.length >= 3 ? rawSearch : '';
      
      if (clearSearch) {
        if (directorySearch.value.length > 0) {
          clearSearch.classList.remove('hidden');
        } else {
          clearSearch.classList.add('hidden');
        }
      }

      const activeBtn = document.querySelector('.filter-btn.active') as HTMLElement;
      const activeFilter = activeBtn ? activeBtn.dataset.filter : 'all';

      let visibleCount = 0;

      rows.forEach(r => {
        const row = r as HTMLElement;
        const text = row.textContent?.toLowerCase() || '';
        // Category is in the second cell
        const cell = row.querySelectorAll('td')[1];
        const category = cell ? cell.textContent?.trim().toLowerCase() || '' : '';
        
        // Match Search
        const matchesSearch = searchTerm === '' ? true : text.includes(searchTerm);
        
        // Match Filter
        let matchesFilter = true;
        if (activeFilter !== 'all') {
          const normalizedCategory = category.normalize("NFD").replace(/[\u0300-\u036f]/g, "");
          matchesFilter = normalizedCategory === activeFilter;
        }

        if (matchesSearch && matchesFilter) {
          row.style.display = '';
          visibleCount++;
        } else {
          row.style.display = 'none';
        }
      });

      // Show no results message if needed
      if (noResultsRow) {
        if (visibleCount === 0) {
          noResultsRow.classList.remove('hidden');
        } else {
          noResultsRow.classList.add('hidden');
        }
      }
    }

    // Debounce function
    let timeout: ReturnType<typeof setTimeout>;
    function debouncedFilter() {
      clearTimeout(timeout);
      timeout = setTimeout(filterTable, 300);
    }

    filterBtns.forEach(btn => {
      btn.addEventListener('click', (e) => {
        const clickedBtn = e.currentTarget as HTMLElement;
        document.querySelectorAll('.filter-btn').forEach(b => {
          b.classList.remove('bg-emerald-500/10', 'text-emerald-400', 'border-emerald-500/20', 'active');
          b.classList.add('bg-[#0a0a0a]', 'text-terminal-muted', 'border-white/5');
        });
        clickedBtn.classList.add('bg-emerald-500/10', 'text-emerald-400', 'border-emerald-500/20', 'active');
        clickedBtn.classList.remove('bg-[#0a0a0a]', 'text-terminal-muted', 'border-white/5');
        // Immediate filter on category change
        filterTable();
      });
    });

    directorySearch.addEventListener('input', debouncedFilter);
    
    if (clearSearch) {
      clearSearch.addEventListener('click', () => {
        directorySearch.value = '';
        // Immediate filter on clear
        filterTable();
        directorySearch.focus();
      });
    }
  }

  // Run script
  initDirectoryFilter();
  document.addEventListener('astro:page-load', initDirectoryFilter);
</script>

