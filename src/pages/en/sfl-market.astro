---
import Layout from "../../layouts/Layout.astro"
import { getLangFromUrl, useTranslations } from "../../i18n/utils"
import SflMarketView from "../../components/views/SflMarketView.astro"

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)

const seo = {
  title: t("sfl.seo.title"),
  description: t("sfl.seo.description"),
  image: "/img/meta/sunflowerland-og.webp",
}
---

<Layout title={seo.title} description={seo.description} image={seo.image}>
  <SflMarketView />
</Layout>
