---
import Layout from "../../layouts/Layout.astro"
import { getLangFromUrl, useTranslations } from "../../i18n/utils"
import SflCookingView from "../../components/views/SflCookingView.astro"

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)

const seo = {
  title: t("sfl.cooking.seo.title"),
  description: t("sfl.cooking.seo.description"),
  image: "/img/meta/sunflowerland-og.webp",
}

const schema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  name: t("sfl.cooking.seo.title"),
  operatingSystem: "Web Browser",
  applicationCategory: "GameApplication",
  description: t("sfl.cooking.seo.description"),
  url: "https://0xlenador.xyz/en/sfl-cooking/",
  author: { "@type": "Person", name: "0x Leñador", url: "https://0xlenador.xyz/" },
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
}
---

<Layout title={seo.title} description={seo.description} image={seo.image} schema={schema} customSpacing>
  <SflCookingView />
</Layout>
