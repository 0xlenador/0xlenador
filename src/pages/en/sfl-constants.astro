---
import Layout from "../../layouts/Layout.astro"
import { getLangFromUrl, useTranslations } from "../../i18n/utils"
import SflConstantsView from "../../components/views/SflConstantsView.astro"

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)

const seo = {
  title: t("sfl.constants.seo.title"),
  description: t("sfl.constants.seo.description"),
  image: "/img/meta/sunflowerland-og.webp",
}

const webAppSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  name: seo.title,
  operatingSystem: "Web Browser",
  applicationCategory: ["FinanceApplication", "GameApplication"],
  description: seo.description,
  url: "https://0xlenador.xyz/en/sfl-constants/",
  author: { "@type": "Person", name: "0x Leñador", url: "https://0xlenador.xyz/" },
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
}

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Home",
      item: "https://0xlenador.xyz/en/",
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "Sunflower Land",
      item: "https://0xlenador.xyz/en/sunflowerland/",
    },
    {
      "@type": "ListItem",
      position: 3,
      name: "Constants",
      item: "https://0xlenador.xyz/en/sfl-constants/",
    },
  ],
}

const schema = [webAppSchema, breadcrumbSchema]
---

<Layout
  title={seo.title}
  description={seo.description}
  image={seo.image}
  imageWidth={1200}
  imageHeight={630}
  schema={schema}
  customSpacing
>
  <SflConstantsView />
</Layout>

