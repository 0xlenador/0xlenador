---
import Layout from "../../layouts/Layout.astro"
import { getLangFromUrl, useTranslations } from "../../i18n/utils"

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)

const seo = {
  title: t('terms.seo.title'),
  description: t('terms.seo.description'),
}
---

<Layout title={seo.title} description={seo.description}>
  <main class="max-w-3xl mx-auto px-6">
    <header class="mb-16">
      <h1 class="text-4xl md:text-5xl font-black text-white mb-4 tracking-tighter italic uppercase">
        {t('terms.heading')} <span class="text-emerald-500">{t('terms.heading.accent')}</span> {t('terms.heading.end')}
      </h1>
      <p class="text-[10px] font-mono text-terminal-muted uppercase tracking-[0.4em]">
        {t('terms.subtitle')}
      </p>
    </header>

    <div class="space-y-12 leading-relaxed text-sm text-justify">
      <section>
        <h2 class="text-white font-bold uppercase tracking-widest mb-4 flex items-center gap-2">
          <span class="w-2 h-2 bg-emerald-500 rounded-full"></span>
          1. General Information
        </h2>
        <p>
          In compliance with the duty of information, it is hereby stated that the website <span
            class="text-terminal-text">0xlenador.xyz</span
          > is a personal and educational platform managed by <span
            class="text-terminal-text">0x Leñador</span
          >. Access to and use of this site attributes the condition of user and implies the acceptance of the terms set forth herein.
        </p>
      </section>

      <section
        class="bg-terminal-surface/40 border border-terminal-border p-8 rounded-[2rem] relative overflow-hidden"
      >
        <div class="absolute top-0 right-0 p-4 opacity-10">
          <svg class="w-20 h-20 text-rose-500" fill="currentColor" viewBox="0 0 24 24"
            ><path
              d="M12 2L1 21h22L12 2zm0 3.45l8.27 14.3H3.73L12 5.45zM11 16h2v2h-2v-2zm0-7h2v5h-2V9z"
            ></path></svg
          >
        </div>
        <h2 class="text-rose-500 font-black uppercase tracking-widest mb-4 italic">
          2. Financial Disclaimer
        </h2>
        <p class="text-terminal-secondary font-medium mb-4 italic">
          "The information and tools provided on 0xLeñador do not constitute, under any circumstances, investment, financial, legal, or tax advice."
        </p>
        <p class="mb-4">
          All content, including market analysis, simulations, and technical data, is offered strictly for <span class="text-white"
            >educational and entertainment purposes</span
          >.
        </p>
        <p>
          Calculation tools (such as the <span class="text-white"
            >Intrinsic Value Calculator</span
          > based on Graham and Buffett models) use theoretical formulas that provide estimates based on the data entered by the user. The results are not guaranteed projections nor are they buy or sell recommendations.
        </p>
      </section>

      <section>
        <h2 class="text-white font-bold uppercase tracking-widest mb-4 flex items-center gap-2">
          <span class="w-2 h-2 bg-emerald-500 rounded-full"></span>
          3. User Responsibility (DYOR)
        </h2>
        <p>
          The user acknowledges that investing in financial markets (ETFs, Stocks, Cryptoassets, Startups) entails an <span class="text-terminal-text font-bold"
            >inherent risk of total capital loss</span
          >. It is the user's sole responsibility to Do Your Own Research (DYOR) before executing any financial operation.
        </p>
      </section>

      <section>
        <h2 class="text-white font-bold uppercase tracking-widest mb-4 flex items-center gap-2">
          <span class="w-2 h-2 bg-emerald-500 rounded-full"></span>
          4. Affiliate Transparency
        </h2>
        <p>
          0xLeñador may contain links to external services (such as TradingView) that are part of affiliate programs. This means that the owner may receive compensation if the user makes a subscription through such links, which contributes to the maintenance of the website without increasing the cost to the user.
        </p>
      </section>

      <section>
        <h2 class="text-white font-bold uppercase tracking-widest mb-4 flex items-center gap-2">
          <span class="w-2 h-2 bg-emerald-500 rounded-full"></span>
          5. Intellectual Property
        </h2>
        <p>
          All intellectual property rights of the content of this website, its graphic design, and its source codes (HTML, CSS, and JS), are owned by <span
            class="text-terminal-text">0x Leñador</span
          >, unless otherwise specified. Their total or partial reproduction without express consent is prohibited.
        </p>
      </section>

      <section>
        <h2 class="text-white font-bold uppercase tracking-widest mb-4 flex items-center gap-2">
          <span class="w-2 h-2 bg-emerald-500 rounded-full"></span>
          6. Modification of Terms
        </h2>
        <p>
          0xLeñador reserves the right to update, modify, or delete the information contained in its tools and these legal terms at any time and without prior notice, to adapt them to legislative changes or technical improvements.
        </p>
      </section>
    </div>

    <div class="mt-20 pt-10 border-t border-terminal-border text-center">
      <p class="text-[9px] font-mono text-terminal-subtle uppercase tracking-widest">
        {t('terms.updated')}
      </p>
    </div>
  </main>
</Layout>
