---
import Layout from "../layouts/Layout.astro"
import FaqAccordion from "../components/FaqAccordion.astro"

const seo = {
  title: "Herramientas | 0xLeñador — Utilidades para Web3 y Análisis de Capital",
  description:
    "Modelos de cálculo y software de análisis para Web3: Simulador de portafolio 60/40 y Calculadora de Valor Intrínseco (DCF). Herramientas 100% locales, sin registro.",
  image: "/img/meta/home.webp",
}

const tools = [
  {
    id: "riskfolio",
    href: "/riskfolio",
    titulo: "Riskfolio",
    descripcion:
      "Calcula la distribución matemática de tu portafolio de inversión dependiendo de tu perfil de riesgo: Conservador, Moderado o Agresivo.",
    badge: "Modelo Paramétrico",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M11 3.055A9.001 9.001 0 1020.945 13H11V3.055z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20.488 9H15V3.512A9.025 9.025 0 0120.488 9z"/>`,
  },
  {
    id: "intrinseco",
    href: "/intrinseco",
    titulo: "Valor Intrínseco",
    descripcion:
      "Terminal de cálculo de valor intrínseco basada en flujo de caja descontado (DCF). Evalúa si un activo cotiza por encima o por debajo de su valor real.",
    badge: "Calculadora",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z"/>`,
  },
  {
    id: "sfl-mercado",
    href: "/sfl-mercado",
    titulo: "Mercado SFL",
    descripcion:
      "Consulta los precios P2P en tiempo real del ecosistema de Sunflower Land. Monitorea items, wearables y recursos mediante su API oficial.",
    badge: "Dashboard en Vivo",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"/>`,
  },
]

const faqItems = [
  {
    pregunta: "¿Cuál es la utilidad de nuestro centro de herramientas?",
    respuesta:
      "El objetivo de este centro es proporcionar modelos matemáticos y calculadoras estructuradas que eliminen la subjetividad y el ruido emocional al momento de evaluar activos. Estas herramientas están diseñadas para ayudarte a estructurar un portafolio equilibrado y determinar el valor real de tus inversiones mediante datos duros.",
  },
  {
    pregunta: "¿Por qué seleccionamos estas herramientas?",
    respuesta:
      "Porque representan los dos pilares fundamentales de la gestión de capital profesional: la asignación de riesgo (Simulador 60/40) y la valoración fundamental (Valor Intrínseco). En lugar de abrumarte con cientos de indicadores inútiles, nos enfocamos estrictamente en lo que funciona en la práctica institucional diaria.",
  },
  {
    pregunta: "¿Los cálculos que realizo son privados?",
    respuesta:
      "Sí, absolutamente. Todas las herramientas de 0xLeñador están construidas para operar de manera 100% local en tu dispositivo (Client-Side). No utilizamos bases de datos, no requerimos registro y no guardamos tu información. Una vez que cierras la pestaña, tus cálculos desaparecen.",
  },
  {
    pregunta: "¿Son estas herramientas recomendaciones financieras?",
    respuesta:
      "No. Son utilidades matemáticas y analíticas. El Simulador y la Calculadora te darán resultados basados en los números que tú mismo ingreses. Es tu responsabilidad realizar tu propia investigación (DYOR) e interpretar los datos según tu perfil de riesgo.",
  },
  {
    pregunta: "¿Puedo sugerir nuevas herramientas?",
    respuesta:
      "Sí. Si tienes una herramienta que consideres útil para la comunidad, puedes comunicarte a través de Telegram o X (@0xlenador). Las sugerencias con mayor demanda se priorizan en el roadmap.",
  },
]
---

<Layout title={seo.title} description={seo.description} image={seo.image}>
  <main class="max-w-6xl mx-auto px-6 pt-10 pb-20">
    <!-- Header -->
    <header class="mb-16">
      <p class="text-[10px] font-mono text-emerald-500/70 uppercase tracking-[0.4em] mb-3">
        Hub / Herramientas
      </p>
      <h1 class="text-4xl md:text-5xl font-black text-white tracking-tighter mb-4">
        Centro de <span class="text-emerald-500">Herramientas</span>
      </h1>
      <p class="text-terminal-secondary text-sm leading-relaxed max-w-2xl">
        Modelos de cálculo y software de análisis estructurado para evaluar activos y distribuir tu
        portafolio. Herramientas diseñadas para aportar objetividad matemática a tus decisiones de
        inversión, operando de forma local y privada en tu navegador.
      </p>
    </header>

    <!-- Grid de herramientas -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-20">
      {
        tools.map((tool) => (
          <a
            href={tool.href}
            id={`tool-card-${tool.id}`}
            class="flex flex-col relative bg-white/[0.02] border border-white/[0.05] hover:border-white/[0.1] hover:bg-white/[0.04] backdrop-blur-2xl rounded-[24px] p-6 transition-all duration-500 no-underline overflow-hidden group hover:shadow-[0_8px_30px_rgb(0,0,0,0.4)]"
          >
            {/* Efecto de brillo superior (Apple style) */}
            <div class="absolute top-0 inset-x-0 h-px bg-gradient-to-r from-transparent via-white/[0.1] to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500" />

            {/* Header de la tarjeta (Icono + Arrow) */}
            <div class="flex items-start justify-between mb-6">
              <div class="w-12 h-12 rounded-2xl bg-white/[0.04] border border-white/[0.05] flex items-center justify-center text-white/[0.7] group-hover:text-white transition-colors duration-300 shadow-inner">
                <svg
                  class="w-6 h-6"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                  set:html={tool.icon}
                />
              </div>

              <svg
                class="w-5 h-5 text-white/[0.3] group-hover:text-white transition-all duration-300 transform group-hover:translate-x-1 group-hover:-translate-y-1"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="1.5"
                  d="M17 8l4 4m0 0l-4 4m4-4H3"
                />
              </svg>
            </div>

            {/* Contenido */}
            <div class="flex flex-col flex-grow">
              <h2 class="text-white font-semibold text-lg tracking-tight mb-2">{tool.titulo}</h2>
              <p class="text-white/[0.5] text-sm leading-relaxed font-light flex-grow mb-6">
                {tool.descripcion}
              </p>
            </div>

            {/* Badge minimalista abajo */}
            <div class="mt-auto">
              <span class="inline-flex items-center justify-center px-3 py-1 rounded-full bg-white/[0.03] border border-white/[0.05] text-white/[0.6] text-[11px] font-medium tracking-wide">
                {tool.badge}
              </span>
            </div>
          </a>
        ))
      }
    </div>

    <FaqAccordion
      titulo="Sobre las Herramientas"
      subtitulo="Uso y disponibilidad"
      startId={300}
      items={faqItems}
    />
  </main>
</Layout>
