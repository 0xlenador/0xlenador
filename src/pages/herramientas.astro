---
import Layout from "../layouts/Layout.astro"
import ToolsView from "../components/views/ToolsView.astro"
import { getLangFromUrl, useTranslations } from "../i18n/utils"

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)

const seo = {
  title: t("tools.seo.title"),
  description: t("tools.seo.description"),
  image: "/img/meta/home.webp",
}
---

<Layout title={seo.title} description={seo.description} image={seo.image}>
  <ToolsView />
</Layout>
