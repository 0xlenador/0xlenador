---
import Layout from "../layouts/Layout.astro"
import { getGuiasByLang } from "../lib/content"
import OperationsView from "../components/views/OperationsView.astro"
import { getLangFromUrl, useTranslations } from "../i18n/utils"

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)

const seo = {
  title: t("ops.seo.title"),
  description: t("ops.seo.description"),
  image: "/img/meta/home.webp",
}

// Solo guías en español — ya vienen ordenadas por prioridad desc desde el helper
const guias = await getGuiasByLang("es")
---

<Layout title={seo.title} description={seo.description} image={seo.image}>
  <OperationsView guias={guias} />
</Layout>
