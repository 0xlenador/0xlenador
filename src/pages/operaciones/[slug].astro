---
import { getGuiasByLang } from "../../lib/content"
import Layout from "../../layouts/Layout.astro"
import GuiaDetailView from "../../components/views/GuiaDetailView.astro"

// 1. Generar rutas estáticas solo para guías en español
export async function getStaticPaths() {
  const guias = await getGuiasByLang("es")
  return guias.map((guia) => ({
    params: { slug: guia.slug },
    props: { guia },
  }))
}

const { guia } = Astro.props
const { title, description, imagen, tags, date, tiempoEstimado } = guia.data

const ogImage = guia.data.ogImage || imagen

// Schema.org TechArticle para SEO estructurado básico
const guiaSchema = {
  "@context": "https://schema.org",
  "@type": "TechArticle",
  headline: title,
  description,
  datePublished: new Date(date).toISOString(),
  author: {
    "@type": "Person",
    name: "0x Leñador",
    url: new URL("/autor", Astro.site).href,
  },
  publisher: {
    "@type": "Organization",
    name: "0x Leñador",
    url: "https://0xlenador.xyz",
  },
  image: ogImage ? new URL(ogImage, "https://0xlenador.xyz").href : undefined,
  mainEntityOfPage: {
    "@type": "WebPage",
    "@id": new URL(Astro.url.pathname, Astro.site).href,
  },
}

// Extraer dinámicamente los pasos del markdown para armar el Schema HowTo
const stepMatches = guia.body ? guia.body.match(/## Paso \d+:\s*(.*)/g) : null;
const steps = stepMatches ? stepMatches.map((match, index) => {
  const stepName = match.replace(/## Paso \d+:\s*/, '').trim();
  return {
    "@type": "HowToStep",
    "position": index + 1,
    "name": stepName,
    "text": stepName
  }
}) : [];

let finalSchema: any = [guiaSchema];

if (steps.length > 0) {
  // Convertir formato "15 min" a ISO 8601 "PT15M"
  const durationMatch = tiempoEstimado ? String(tiempoEstimado).match(/(\d+)/) : null;
  const totalTimeISO = durationMatch ? `PT${durationMatch[1]}M` : undefined;

  const howToSchema = {
    "@context": "https://schema.org",
    "@type": "HowTo",
    "name": title,
    "description": description,
    "totalTime": totalTimeISO,
    "step": steps,
    "image": ogImage ? new URL(ogImage, "https://0xlenador.xyz").href : undefined
  };
  
  finalSchema.push(howToSchema);
}

// Schema.org BreadcrumbList para migas de pan
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Inicio",
      "item": new URL("/", Astro.site).href
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Operaciones",
      "item": new URL("/operaciones/", Astro.site).href
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": title,
      "item": new URL(Astro.url.pathname, Astro.site).href
    }
  ]
};

finalSchema.push(breadcrumbSchema);

const translationSlug = guia.data.translationSlug
const esUrl = `/operaciones/${guia.slug}/`
const enUrl = translationSlug
  ? `/en/operations/${translationSlug}/`
  : `/en/operations/${guia.slug}/`
---

<Layout
  title={`${title} | 0x Leñador`}
  description={description}
  keywords={tags.join(", ")}
  ogType="article"
  image={ogImage}
  schema={finalSchema}
  publishedTime={new Date(date).toISOString()}
  author="0x Leñador"
  esUrl={esUrl}
  enUrl={enUrl}
>
  <GuiaDetailView guia={guia} />
</Layout>
