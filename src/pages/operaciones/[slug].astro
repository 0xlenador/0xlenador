---
import { getGuiasByLang } from "../../lib/content"
import Layout from "../../layouts/Layout.astro"
import GuiaDetailView from "../../components/views/GuiaDetailView.astro"

// 1. Generar rutas estáticas solo para guías en español
export async function getStaticPaths() {
  const guias = await getGuiasByLang("es")
  return guias.map((guia) => ({
    params: { slug: guia.slug },
    props: { guia },
  }))
}

const { guia } = Astro.props
const { title, description, imagen, tags, date } = guia.data

const ogImage = guia.data.ogImage || imagen

// Schema.org TechArticle para SEO estructurado
const guiaSchema = {
  "@context": "https://schema.org",
  "@type": "TechArticle",
  headline: title,
  description,
  datePublished: new Date(date).toISOString(),
  author: {
    "@type": "Person",
    name: "0x Leñador",
    url: new URL("/autor", Astro.site).href,
  },
  publisher: {
    "@type": "Organization",
    name: "0x Leñador",
    url: "https://0xlenador.xyz",
  },
  image: ogImage ? new URL(ogImage, "https://0xlenador.xyz").href : undefined,
  mainEntityOfPage: {
    "@type": "WebPage",
    "@id": new URL(Astro.url.pathname, Astro.site).href,
  },
}

const translationSlug = guia.data.translationSlug
const esUrl = `/operaciones/${guia.slug}/`
const enUrl = translationSlug
  ? `/en/operations/${translationSlug}/`
  : `/en/operations/${guia.slug}/`
---

<Layout
  title={`${title} | 0x Leñador`}
  description={description}
  keywords={tags.join(", ")}
  ogType="article"
  image={ogImage}
  schema={guiaSchema}
  publishedTime={new Date(date).toISOString()}
  author="0x Leñador"
  esUrl={esUrl}
  enUrl={enUrl}
>
  <GuiaDetailView guia={guia} />
</Layout>
