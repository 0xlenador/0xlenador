            style="max-height: 0px;"
          >
            <p
              class="p-6 pt-0 text-slate-400 text-sm leading-relaxed border-t border-slate-800/50 italic"
            >
              En 0xLeñador filtramos sitios conocidos, pero la regla de oro en
              cripto es la precaución. <b class="text-rose-500"
                >Usa siempre una "Burner Wallet"</b
              > (billetera secundaria vacía) para interactuar con faucets y nunca
              compartas tu frase semilla.
            </p>
          </div>
        </div>
      </div>
    </section>



    <script is:inline>
      let activeTab = "all";

      // LÓGICA DE FILTRADO EXACTA DEL PROYECTO VIEJO
      function applyFilters() {
        const q = document.getElementById("search").value.toLowerCase().trim();
        const cards = document.querySelectorAll(".item-card");

        cards.forEach((card) => {
          const type = card.getAttribute("data-type");
          const tags = card.querySelectorAll(".tag");
          let hasQueryMatch = false;
          let tabMatch = activeTab === "all" || type === activeTab;

          tags.forEach((t) => {
            const txt = t.innerText.toLowerCase();
            // RESTAURADO: Se vuelven a añadir las clases nativas .highlight y .dimmed de main.css
            if (q !== "" && txt.includes(q)) {
              t.classList.add("highlight");
              t.classList.remove("dimmed");
              hasQueryMatch = true;
            } else if (q !== "") {
              t.classList.remove("highlight");
              t.classList.add("dimmed");
            } else {
              t.classList.remove("highlight", "dimmed");
            }
          });

          // RESTAURADO: Toggle nativo de visibilidad usando la clase de Tailwind
          if (tabMatch && (q === "" || hasQueryMatch)) {
            card.classList.remove("hidden");
          } else {
            card.classList.add("hidden");
          }
        });
      }

      // Configuración de escuchas para las pestañas (TODOS, MAINNET, TESTNET)
      document.querySelectorAll(".tab-btn").forEach((btn) => {
        btn.addEventListener("click", (e) => {
          activeTab = e.target.getAttribute("data-filter");

          document.querySelectorAll(".tab-btn").forEach((b) => {
            b.classList.remove("bg-emerald-600", "text-white");
            b.classList.add("text-slate-500");
          });

          e.target.classList.add("bg-emerald-600", "text-white");
          e.target.classList.remove("text-slate-500");
          applyFilters();
        });
      });

      // Configuración de escucha para el buscador
      document.getElementById("search").addEventListener("keyup", applyFilters);

      // Lógica de acordeón FAQ (Cruz giratoria a 45 grados)
      const faqButtons = document.querySelectorAll(".faq-btn");
      faqButtons.forEach((btn) => {
        btn.addEventListener("click", () => {
          const ans = btn.parentElement.querySelector(".faq-content");
          const icon = btn.querySelector(".icon-rotate");
          const isClosed =
            ans.style.maxHeight === "0px" || ans.style.maxHeight === "";

          document
            .querySelectorAll(".faq-content")
            .forEach((el) => (el.style.maxHeight = "0px"));
          document.querySelectorAll(".icon-rotate").forEach((el) => {
            el.style.transform = "rotate(0deg)";
            el.classList.remove("text-emerald-400");
          });

          if (isClosed) {
            ans.style.maxHeight = ans.scrollHeight + "px";
            icon.style.transform = "rotate(45deg)";
            icon.classList.add("text-emerald-400");
          }
        });
      });
    </script>
</Layout>
