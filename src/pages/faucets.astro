---
import Layout from "../layouts/Layout.astro";
import faucets from "../data/faucets.json";

const seo = {
  title: "Faucets Cripto Mainnet & Testnet | Recursos para Airdrops y Devs",
  description:
    "El listado más completo de faucets de criptomonedas. Obtén tokens gratis para redes como Sepolia, Monad, Holesky y más. Ideal para desarrollo Web3 y farming de airdrops.",
  url: "https://0xlenador.xyz/faucets",
  image: "/img/meta/faucets.webp",
};
---

<Layout title={seo.title} description={seo.description} image={seo.image}>
  <section class="max-w-6xl mx-auto px-6">
    <div class="mb-10 text-left">
      <h2 class="text-3xl font-bold text-white mb-2">
        Listado de Faucets Mainnet & Testnet
      </h2>
      <p class="text-terminal-secondary">
        Recursos actualizados para desarrolladores y airdrop farmers.
      </p>
      <p class="text-terminal-muted">
        Explora todos los sitios web de faucets de criptomonedas disponibles en
        el ecosistema blockchain, acumula criptomonedas gratis para farmear tus
        airdrops y/o desarrollar tus proyectos.
      </p>
    </div>

    <div class="bg-terminal-surface/40 border border-terminal-border p-6 rounded-2xl mb-8">
      <div class="flex flex-col md:flex-row gap-4 items-center">
        <input
          type="text"
          id="search"
          class="w-full md:flex-1 bg-terminal-bg border border-terminal-border-subtle text-terminal-text px-4 py-3 rounded-xl focus:outline-none focus:ring-2 focus:ring-emerald-500/50 transition"
          placeholder="Buscar Red (Sepolia, Monad, Bitcoin...)"
        />

        <div
          class="flex bg-terminal-bg p-1 rounded-xl border border-terminal-border w-full md:w-auto font-mono"
        >
          <button
            class="tab-btn px-6 py-2 rounded-lg text-sm font-bold transition bg-emerald-600 text-white cursor-pointer"
            data-filter="all">TODOS</button
          >
          <button
            class="tab-btn px-6 py-2 rounded-lg text-sm font-bold text-terminal-muted hover:text-white transition cursor-pointer"
            data-filter="mainnet">MAINNET</button
          >
          <button
            class="tab-btn px-6 py-2 rounded-lg text-sm font-bold text-terminal-muted hover:text-white transition cursor-pointer"
            data-filter="testnet">TESTNET</button
          >
        </div>
      </div>
    </div>

    <div id="list" class="grid grid-cols-1 lg:grid-cols-2 gap-4">
      {
        faucets.map((faucet) => (
          <div
            class="item-card bg-terminal-surface/60 border border-terminal-border p-5 rounded-2xl hover:border-terminal-border-subtle transition group"
            data-type={faucet.type}
          >
            <div class="flex items-center gap-4 mb-4">
              <img
                src={faucet.img}
                loading="lazy"
                alt={faucet.name}
                class="w-10 h-10 rounded-full border border-terminal-border-subtle shadow-lg"
              />
              <div class="flex flex-col">
                <a
                  href={faucet.url}
                  target="_blank"
                  class="text-white font-bold hover:text-emerald-400 transition flex items-center gap-1 text-lg"
                >
                  {faucet.name} <span class="text-xs opacity-50">↗</span>
                </a>
                <span
                  class={`text-[10px] uppercase tracking-widest ${faucet.type === "mainnet" ? "text-amber-500" : "text-emerald-500"} font-semibold`}
                >
                  {faucet.type.toUpperCase()}
                </span>
              </div>
            </div>
            <div class="flex flex-wrap gap-2">
              {faucet.tags.map((tag) => (
                <span class="tag bg-terminal-bg text-terminal-secondary text-[11px] px-2 py-1 rounded-md border border-terminal-border transition">
                  {tag}
                </span>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <section class="max-w-4xl mx-auto mt-32 mb-20 px-6">
    <div class="text-center mb-12">
      <h2
        class="text-3xl font-black text-white tracking-tighter uppercase italic"
      >
        Preguntas Frecuentes
      </h2>
      <p
        class="text-terminal-muted font-mono text-xs uppercase tracking-widest mt-2"
      >
        Todo lo que necesitas saber sobre las Faucets
      </p>
    </div>

    <div class="space-y-4">
      <div
        class="bg-terminal-surface/40 border border-terminal-border rounded-2xl overflow-hidden group hover:border-emerald-500/20 transition-all duration-300"
      >
        <button
          class="w-full p-6 text-left flex justify-between items-center cursor-pointer faq-btn"
        >
          <span
            class="text-white font-bold group-hover:text-emerald-400 transition-colors"
            >¿Qué es una Faucet de criptomonedas?</span
          >
          <span
            class="text-terminal-muted transition-all duration-300 transform font-mono text-lg icon-rotate"
            >＋</span
          >
        </button>
        <div
          class="max-h-0 overflow-hidden transition-all duration-500 ease-in-out faq-content"
          style="max-height: 0px;"
        >
          <p
            class="p-6 pt-0 text-terminal-secondary text-sm leading-relaxed border-t border-terminal-border/50 italic"
          >
            Es un systema que entrega pequeñas cantidades de criptomonedas (o
            tokens de prueba) de forma gratuita. En Mainnet sirven como
            incentivo o faucet de goteo, y en Testnet son esenciales para pagar
            gas sin gastar dinero real durante las pruebas de protocolos.
          </p>
        </div>
      </div>

      <div
        class="bg-terminal-surface/40 border border-terminal-border rounded-2xl overflow-hidden group hover:border-emerald-500/20 transition-all duration-300"
      >
        <button
          class="w-full p-6 text-left flex justify-between items-center cursor-pointer faq-btn"
        >
          <span
            class="text-white font-bold group-hover:text-emerald-400 transition-colors"
            >¿Cuál es la diferencia entre Mainnet y Testnet?</span
          >
          <span
            class="text-terminal-muted transition-all duration-300 transform font-mono text-lg icon-rotate"
            >＋</span
          >
        </button>
        <div
          class="max-h-0 overflow-hidden transition-all duration-500 ease-in-out faq-content"
          style="max-height: 0px;"
        >
          <p
            class="p-6 pt-0 text-terminal-secondary text-sm leading-relaxed border-t border-terminal-border/50 italic"
          >
            Las faucets de <b class="text-emerald-500">Testnet</b> entregan tokens
            sin valor real para probar dApps. Las de <b class="text-cyan-500"
              >Mainnet</b
            > entregan criptomonedas reales (como Satoshis o SOL), generalmente a
            cambio de ver anuncios o completar tareas sencillas.
          </p>
        </div>
      </div>

      <div
        class="bg-terminal-surface/40 border border-terminal-border rounded-2xl overflow-hidden group hover:border-emerald-500/20 transition-all duration-300"
      >
        <button
          class="w-full p-6 text-left flex justify-between items-center cursor-pointer faq-btn"
        >
          <span
            class="text-white font-bold group-hover:text-emerald-400 transition-colors"
            >¿Es seguro conectar mi billetera a estas webs?</span
          >
          <span
            class="text-terminal-muted transition-all duration-300 transform font-mono text-lg icon-rotate"
            >＋</span
          >
        </button>
        <div
          class="max-h-0 overflow-hidden transition-all duration-500 ease-in-out faq-content"
          style="max-height: 0px;"
        >
          <p
            class="p-6 pt-0 text-terminal-secondary text-sm leading-relaxed border-t border-terminal-border/50 italic"
          >
            En 0xLeñador filtramos sitios conocidos, pero la regla de oro en
            cripto es la precaución. <b class="text-rose-500"
              >Usa siempre una "Burner Wallet"</b
            > (billetera secundaria vacía) para interactuar con faucets y nunca compartas
            tu frase semilla.
          </p>
        </div>
      </div>
    </div>
  </section>

  <script is:inline>
    let activeTab = "all";

    // LÓGICA DE FILTRADO EXACTA DEL PROYECTO VIEJO
    function applyFilters() {
      const q = document.getElementById("search").value.toLowerCase().trim();
      const cards = document.querySelectorAll(".item-card");

      cards.forEach((card) => {
        const type = card.getAttribute("data-type");
        const tags = card.querySelectorAll(".tag");
        let hasQueryMatch = false;
        let tabMatch = activeTab === "all" || type === activeTab;

        tags.forEach((t) => {
          const txt = t.innerText.toLowerCase();
          // RESTAURADO: Se vuelven a añadir las clases nativas .highlight y .dimmed de main.css
          if (q !== "" && txt.includes(q)) {
            t.classList.add("highlight");
            t.classList.remove("dimmed");
            hasQueryMatch = true;
          } else if (q !== "") {
            t.classList.remove("highlight");
            t.classList.add("dimmed");
          } else {
            t.classList.remove("highlight", "dimmed");
          }
        });

        // RESTAURADO: Toggle nativo de visibilidad usando la clase de Tailwind
        if (tabMatch && (q === "" || hasQueryMatch)) {
          card.classList.remove("hidden");
        } else {
          card.classList.add("hidden");
        }
      });
    }

    // Configuración de escuchas para las pestañas (TODOS, MAINNET, TESTNET)
    document.querySelectorAll(".tab-btn").forEach((btn) => {
      btn.addEventListener("click", (e) => {
        activeTab = e.target.getAttribute("data-filter");

        document.querySelectorAll(".tab-btn").forEach((b) => {
          b.classList.remove("bg-emerald-600", "text-white");
          b.classList.add("text-terminal-muted");
        });

        e.target.classList.add("bg-emerald-600", "text-white");
        e.target.classList.remove("text-terminal-muted");
        applyFilters();
      });
    });

    // Configuración de escucha para el buscador
    document.getElementById("search").addEventListener("keyup", applyFilters);

    // Lógica de acordeón FAQ (Cruz giratoria a 45 grados)
    const faqButtons = document.querySelectorAll(".faq-btn");
    faqButtons.forEach((btn) => {
      btn.addEventListener("click", () => {
        const ans = btn.parentElement.querySelector(".faq-content");
        const icon = btn.querySelector(".icon-rotate");
        const isClosed =
          ans.style.maxHeight === "0px" || ans.style.maxHeight === "";

        document
          .querySelectorAll(".faq-content")
          .forEach((el) => (el.style.maxHeight = "0px"));
        document.querySelectorAll(".icon-rotate").forEach((el) => {
          el.style.transform = "rotate(0deg)";
          el.classList.remove("text-emerald-400");
        });

        if (isClosed) {
          ans.style.maxHeight = ans.scrollHeight + "px";
          icon.style.transform = "rotate(45deg)";
          icon.classList.add("text-emerald-400");
        }
      });
    });
  </script>
</Layout>
