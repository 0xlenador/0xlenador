---
import Layout from "../layouts/Layout.astro"
import FaucetsView from "../components/views/FaucetsView.astro"
import { getLangFromUrl, useTranslations } from "../i18n/utils"

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)

const seo = {
  title: t("faucets.seo.title"),
  description: t("faucets.seo.description"),
  image: "/img/meta/faucets.webp",
}
---

<Layout title={seo.title} description={seo.description} image={seo.image}>
  <FaucetsView />
</Layout>
