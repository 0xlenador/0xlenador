          en el ecosistema blockchain, acumula criptomonedas gratis para farmear
          tus airdrops y/o desarrollar tus proyectos.
        </p>
      </div>

      <div class="bg-slate-900/40 border border-slate-800 p-6 rounded-2xl mb-8">
        <div class="flex flex-col md:flex-row gap-4 items-center">
          <input
            type="text"
            id="search"
            class="w-full md:flex-1 bg-slate-950 border border-slate-700 text-slate-200 px-4 py-3 rounded-xl focus:outline-none focus:ring-2 focus:ring-emerald-500/50 transition"
            placeholder="Buscar Red (Sepolia, Monad, Bitcoin...)"
          />

          <div
            class="flex bg-slate-950 p-1 rounded-xl border border-slate-800 w-full md:w-auto font-mono"
          >
            <button
              class="tab-btn px-6 py-2 rounded-lg text-sm font-bold transition bg-emerald-600 text-white cursor-pointer"
              data-filter="all">TODOS</button
            >
            <button
              class="tab-btn px-6 py-2 rounded-lg text-sm font-bold text-slate-500 hover:text-white transition cursor-pointer"
              data-filter="mainnet">MAINNET</button
            >
            <button
              class="tab-btn px-6 py-2 rounded-lg text-sm font-bold text-slate-500 hover:text-white transition cursor-pointer"
              data-filter="testnet">TESTNET</button
            >
          </div>
        </div>
      </div>

      <div id="list" class="grid grid-cols-1 lg:grid-cols-2 gap-4">
        {
          faucets.map((faucet) => (
            <div
              class="item-card bg-slate-900/60 border border-slate-800 p-5 rounded-2xl hover:border-slate-700 transition group"
              data-type={faucet.type}
            >
              <div class="flex items-center gap-4 mb-4">
                <img
                  src={faucet.img}
                  loading="lazy"
                  alt={faucet.name}
                  class="w-10 h-10 rounded-full border border-slate-700 shadow-lg"
                />
                <div class="flex flex-col">
                  <a
                    href={faucet.url}
                    target="_blank"
                    class="text-white font-bold hover:text-emerald-400 transition flex items-center gap-1 text-lg"
                  >
                    {faucet.name} <span class="text-xs opacity-50">↗</span>
                  </a>
                  <span
                    class={`text-[10px] uppercase tracking-widest ${faucet.type === "mainnet" ? "text-amber-500" : "text-emerald-500"} font-semibold`}
                  >
                    {faucet.type.toUpperCase()}
                  </span>
                </div>
              </div>
              <div class="flex flex-wrap gap-2">
                {faucet.tags.map((tag) => (
                  <span class="tag bg-slate-950 text-slate-400 text-[11px] px-2 py-1 rounded-md border border-slate-800 transition">
                    {tag}
                  </span>
                ))}
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <section class="max-w-4xl mx-auto mt-32 mb-20 px-6">
