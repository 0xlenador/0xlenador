---
import Layout from "../layouts/Layout.astro"
import sflIds from "../data/sfl_ids.json"

const seo = {
  title: "Mercado SFL | 0xLeñador — Precios P2P de Sunflower Land",
  description:
    "Consulta en tiempo real los precios del mercado P2P de Sunflower Land. Monitorea volumen, ventas recientes y floor prices de items y wearables.",
  image: "/img/cripto/sunflowerland.webp",
}
---

<Layout title={seo.title} description={seo.description} image={seo.image}>
  <main class="max-w-7xl mx-auto px-6 pt-10 pb-20">
    <header class="mb-12">
      <div class="flex items-center gap-4 mb-3">
        <img src="/img/cripto/sunflowerland.webp" alt="Sunflower Land" class="w-10 h-10 rounded-full object-contain bg-white/[0.05] p-1 border border-white/[0.1]" />
        <p class="text-[10px] font-mono text-emerald-500/70 uppercase tracking-[0.4em]">
          Herramientas / Mercado
        </p>
      </div>
      <h1 class="text-4xl md:text-5xl font-black text-white tracking-tighter mb-4">
        Mercado <span class="text-emerald-500">SFL</span>
      </h1>
      <p class="text-terminal-secondary text-sm leading-relaxed max-w-2xl">
        Monitor de precios y volumen de transacciones del mercado P2P de Sunflower Land. 
        Los datos se extraen de forma local y segura usando la API pública del juego.
      </p>
    </header>

    <div class="bg-white/[0.02] border border-white/[0.05] backdrop-blur-2xl rounded-[24px] p-6 lg:p-8 mb-10 shadow-2xl relative overflow-hidden">
      <!-- Glow effect -->
      <div class="absolute -top-40 -right-40 w-80 h-80 bg-emerald-500/10 rounded-full blur-3xl pointer-events-none"></div>
      
      <div class="flex flex-col md:flex-row justify-between items-start md:items-end gap-4 mb-8 relative z-10">
        <div class="w-full md:w-1/3">
          <label class="block text-xs font-mono text-terminal-muted mb-2 uppercase tracking-widest">Buscar Item</label>
          <input 
            type="text" 
            id="searchInput" 
            placeholder="Ej. Sunflower, Axe..." 
            class="w-full bg-terminal-bg/50 border border-white/[0.1] rounded-xl px-4 py-3 text-white placeholder-white/[0.3] focus:outline-none focus:border-emerald-500/50 focus:ring-1 focus:ring-emerald-500/50 transition-all text-sm"
          />
        </div>
        <div class="w-full md:w-auto">
          <button id="fetchBtn" class="w-full md:w-auto px-6 py-3 bg-emerald-500 hover:bg-emerald-400 text-black font-bold text-sm rounded-xl transition-colors whitespace-nowrap shadow-[0_0_15px_rgba(16,185,129,0.2)] hover:shadow-[0_0_25px_rgba(16,185,129,0.4)]">
            Refrescar
          </button>
        </div>
      </div>

      <div id="loadingState" class="hidden py-20 flex flex-col items-center justify-center relative z-10">
        <svg class="animate-spin h-8 w-8 text-emerald-500 mb-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
        </svg>
        <p class="text-terminal-muted font-mono text-xs animate-pulse">Consultando API de SFL...</p>
      </div>

      <div id="errorState" class="hidden py-12 px-6 bg-red-500/10 border border-red-500/20 rounded-xl relative z-10">
        <p id="errorMsg" class="text-red-400 text-sm text-center">Error al cargar los datos.</p>
      </div>

      <div id="dataContainer" class="hidden relative z-10">
        
        <!-- Dashboard Resumen (Coming Soon) -->
        <div class="relative mb-10">
          <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            <div class="bg-white/[0.02] border border-white/[0.05] rounded-[20px] p-5 shadow-inner flex flex-col justify-center">
              <h3 class="text-xs font-mono text-terminal-muted uppercase tracking-wider mb-3 flex items-center gap-2">
                <svg class="w-4 h-4 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/></svg>
                Top Volume 24h
              </h3>
              <div id="dashTopVolume" class="h-12 flex items-center">
                <div class="h-8 bg-white/[0.05] rounded-lg w-3/4 animate-pulse"></div>
              </div>
            </div>
            
            <div class="bg-white/[0.02] border border-white/[0.05] rounded-[20px] shadow-inner relative min-h-[116px] overflow-hidden">
              <div id="dashTopGainerCarousel" class="w-full h-full absolute inset-0 p-5">
                <div class="flex flex-col justify-center h-full">
                  <h3 class="text-xs font-mono text-terminal-muted uppercase tracking-wider mb-3 flex items-center gap-2">
                    <svg class="w-4 h-4 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 10l7-7m0 0l7 7m-7-7v18"/></svg>
                    Calculando...
                  </h3>
                  <div class="h-12 flex items-center">
                    <div class="h-8 bg-white/[0.05] rounded-lg w-2/3 animate-pulse"></div>
                  </div>
                </div>
              </div>
            </div>
            
            <div class="bg-white/[0.02] border border-white/[0.05] rounded-[20px] shadow-inner relative min-h-[116px] overflow-hidden">
              <div id="dashAthAtlCarousel" class="w-full h-full absolute inset-0 p-5">
                <div class="flex flex-col justify-center h-full">
                  <h3 class="text-xs font-mono text-terminal-muted uppercase tracking-wider mb-3 flex items-center gap-2">
                    <svg class="w-4 h-4 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
                    Calculando...
                  </h3>
                  <div class="flex flex-wrap gap-2 h-auto min-h-12 items-center">
                    <div class="h-10 w-10 bg-white/[0.05] rounded-lg animate-pulse border border-white/10"></div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="flex items-center justify-between mb-4">
          <h2 class="text-lg font-semibold text-white">Actividad del Mercado <span class="text-xs text-terminal-muted font-normal ml-2 tracking-wide">P2P History</span></h2>
          <span id="totalVolume" class="text-xs font-mono text-emerald-400 bg-emerald-500/10 px-3 py-1 rounded-full border border-emerald-500/20"></span>
        </div>

        <div class="overflow-x-auto">
          <table class="w-full text-left border-collapse">
            <thead>
              <tr class="border-b border-white/[0.05]">
                <th class="py-4 px-4 text-xs font-mono text-terminal-muted font-medium uppercase tracking-wider w-[25%]">Name</th>
                <th class="py-4 px-4 text-xs font-mono text-terminal-muted font-medium uppercase tracking-wider text-right w-[10%]">Price</th>
                <th class="py-4 px-4 text-xs font-mono text-terminal-muted font-medium uppercase tracking-wider text-center w-[11%]">Last 24h</th>
                <th class="py-4 px-4 text-xs font-mono text-terminal-muted font-medium uppercase tracking-wider text-center w-[18%]">Last 7d</th>
                <th class="py-4 px-4 text-xs font-mono text-terminal-muted font-medium uppercase tracking-wider text-center w-[18%]">Last 30d</th>
                <th class="py-4 px-4 text-xs font-mono text-terminal-muted font-medium uppercase tracking-wider text-center w-[18%]">Last 180d</th>
              </tr>
            </thead>
            <tbody id="tableBody" class="divide-y divide-white/[0.02]">
              <!-- Filas dinámicas -->
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </main>
</Layout>

<script define:vars={{ sflIds }}>
  const searchInput = document.getElementById("searchInput");
  const fetchBtn = document.getElementById("fetchBtn");
  const loadingState = document.getElementById("loadingState");
  const errorState = document.getElementById("errorState");
  const errorMsg = document.getElementById("errorMsg");
  const dataContainer = document.getElementById("dataContainer");
  const tableBody = document.getElementById("tableBody");
  const totalVolumeEl = document.getElementById("totalVolume");

  let marketData = [];

  // Formatear números
  const formatNumber = (num, decimals = 2) => {
    if (num === undefined || num === null) return "0";
    if (num < 0.0001) return num.toExponential(2);
    return new Intl.NumberFormat("en-US", {
      minimumFractionDigits: 0,
      maximumFractionDigits: decimals,
    }).format(num);
  };

  // Extraer el nombre del ID
  const getItemName = (key) => {
    const idMatch = key.match(/-(\d+)$/);
    if (idMatch && idMatch[1]) {
      const id = idMatch[1];
      if (sflIds[id]) return sflIds[id];
    }
    return key;
  };

  // Helper para SVG Sparkline Nativo
  const createSparklineSVG = (dataArray, isPositive) => {
    if (!dataArray) return '';
    const validData = dataArray.filter(v => v !== null && v !== undefined);
    if (validData.length < 2) return ''; 

    const width = 100;
    const height = 30;
    const max = Math.max(...validData);
    const min = Math.min(...validData);
    const range = max - min || 1; 
    
    const getX = (i) => (i / (validData.length - 1)) * width;
    const getY = (val) => height - ((val - min) / range) * height;

    const points = validData.map((val, i) => `${getX(i)},${getY(val)}`).join(' L ');

    const maxIndex = validData.indexOf(max);
    const minIndex = validData.indexOf(min);
    const finalIndex = validData.length - 1;

    const strokeColor = isPositive ? '#10b981' : '#ef4444'; 
    const dotColor = '#f59e0b';
    
    return `
      <div class="relative w-full h-full sparkline-container cursor-crosshair group/spark" 
           data-points='${JSON.stringify(validData)}' 
           data-min="${min}" 
           data-range="${range}">
        <svg width="100%" height="100%" viewBox="-2 -2 104 34" preserveAspectRatio="none" class="opacity-70 group-hover/spark:opacity-100 transition-opacity drop-shadow-md relative z-0">
          <path d="M ${points}" fill="none" stroke="${strokeColor}" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" />
          
          <circle cx="${getX(maxIndex)}" cy="${getY(max)}" r="1.5" fill="${dotColor}" />
          <circle cx="${getX(minIndex)}" cy="${getY(min)}" r="1.5" fill="${dotColor}" />
          <circle cx="${getX(finalIndex)}" cy="${getY(validData[finalIndex])}" r="1.5" fill="${dotColor}" />
          
          <line class="hover-line hidden pointer-events-none" y1="-2" y2="34" stroke="rgba(255,255,255,0.4)" stroke-width="0.5" />
          <circle class="hover-dot hidden pointer-events-none" r="2" fill="${strokeColor}" stroke="#1e1e1e" stroke-width="1" />
        </svg>
        
        <div class="hover-tooltip hidden absolute bg-terminal-dark border border-white/20 text-white text-[9px] font-mono px-1.5 py-0.5 rounded shadow-xl pointer-events-none z-10 transition-all duration-75 whitespace-nowrap" 
             style="transform: translateX(-50%) translateY(-100%); margin-top: -6px;">
        </div>
      </div>
    `;
  };

  const calculateChange = (current, past) => {
    if (!past || past === 0 || !current) return { val: 0, text: '-', isPositive: null, pastPrice: null };
    const change = ((current - past) / past) * 100;
    const isPositive = change >= 0;
    return {
      val: change,
      text: `${isPositive ? '+' : ''}${change.toFixed(2)}%`,
      isPositive,
      pastPrice: past
    };
  };

  const getChangeHTML = (changeObj, sparklineData, showText = true) => {
    if (changeObj.isPositive === null) return '<span class="text-terminal-muted/50 font-mono text-xs">-</span>';
    
    const colorClass = changeObj.isPositive ? 'text-emerald-500 bg-emerald-500/10 border-emerald-500/20' : 'text-red-500 bg-red-500/10 border-red-500/20';
    const arrow = changeObj.isPositive 
      ? '<svg class="w-3 h-3 inline mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 15l7-7 7 7"/></svg>' 
      : '<svg class="w-3 h-3 inline mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>';
      
    const sparklineHTML = sparklineData ? `<div class="h-6 w-full">${createSparklineSVG(sparklineData, changeObj.isPositive)}</div>` : '';
      
    const textHTML = showText ? `
        <span class="text-[10px] font-bold font-mono px-1.5 py-0.5 rounded border ${colorClass} inline-flex items-center whitespace-nowrap shrink-0">
          ${arrow}${changeObj.text}
        </span>
    ` : '';

    const layoutClass = sparklineData ? "justify-between gap-3" : "justify-center";

    return `
      <div class="flex flex-row items-center ${layoutClass} w-full">
        ${textHTML}
        ${sparklineHTML}
      </div>
    `;
  };

  const renderDashboard = () => {
    const topVolItem = marketData[0];
    if (topVolItem) {
      document.getElementById("dashTopVolume").innerHTML = `
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded bg-terminal-dark border border-terminal-muted/20 flex items-center justify-center p-1.5 shrink-0">
            <img src="/img/sunflowerland/${topVolItem.name}.png" class="w-full h-full object-contain drop-shadow-sm" onerror="this.style.display='none'" />
          </div>
          <div class="flex flex-col">
            <span class="text-white font-bold">${topVolItem.name}</span>
            <span class="text-xs text-emerald-400 font-mono">${formatNumber(topVolItem.volume, 0)} vol</span>
          </div>
        </div>
      `;
    }

    // Mayor Ganador Carrusel (24h, 7d, 30d, 180d)
    const getTopGainer = (periodKey) => {
      const sorted = [...marketData].map(item => {
        const change = calculateChange(item.currentPrice, item.history[periodKey]);
        return { ...item, changeObj: change };
      }).sort((a, b) => b.changeObj.val - a.changeObj.val);
      return sorted[0];
    };

    const slidesData = [
      { title: "Mayor Ganador 24H", data: getTopGainer("1d") },
      { title: "Mayor Ganador 7D", data: getTopGainer("7d") },
      { title: "Mayor Ganador 30D", data: getTopGainer("30d") },
      { title: "Mayor Ganador 180D", data: getTopGainer("180d") }
    ];

    let carouselHTML = '';
    slidesData.forEach((slide, idx) => {
      if(!slide.data) return;
      const isFirst = idx === 0;
      carouselHTML += `
        <div class="gainer-slide absolute inset-0 p-5 transition-opacity duration-500 flex flex-col justify-center ${isFirst ? 'opacity-100 z-10' : 'opacity-0 z-0'}">
          <h3 class="text-xs font-mono text-terminal-muted uppercase tracking-wider mb-3 flex items-center gap-2">
            <svg class="w-4 h-4 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 10l7-7m0 0l7 7m-7-7v18"/></svg>
            ${slide.title}
          </h3>
          <div class="flex items-center gap-3 h-12">
            <div class="w-10 h-10 rounded bg-terminal-dark border border-terminal-muted/20 flex items-center justify-center p-1.5 shrink-0">
              <img src="/img/sunflowerland/${slide.data.name}.png" class="w-full h-full object-contain drop-shadow-sm" onerror="this.style.display='none'" />
            </div>
            <div class="flex flex-col">
              <span class="text-white font-bold">${slide.data.name}</span>
              <span class="text-xs text-emerald-500 font-mono font-bold">+${slide.data.changeObj.val.toFixed(2)}%</span>
            </div>
          </div>
        </div>
      `;
    });

    const carouselContainer = document.getElementById("dashTopGainerCarousel");
    carouselContainer.innerHTML = carouselHTML;

    if (window.__gainerInterval) clearInterval(window.__gainerInterval);
    let currentSlide = 0;
    const slides = carouselContainer.querySelectorAll(".gainer-slide");
    
    if(slides.length > 1) {
      window.__gainerInterval = setInterval(() => {
        slides[currentSlide].classList.remove("opacity-100", "z-10");
        slides[currentSlide].classList.add("opacity-0", "z-0");
        
        currentSlide = (currentSlide + 1) % slides.length;
        
        slides[currentSlide].classList.remove("opacity-0", "z-0");
        slides[currentSlide].classList.add("opacity-100", "z-10");
      }, 5000);
    }

    // Extremos Carrusel (Cerca ATH vs Cerca ATL)
    const athItems = [...marketData].map(item => {
      const history180d = item.history.sparkline180d ? item.history.sparkline180d.filter(v => v !== null && v !== undefined) : [];
      const ath = Math.max(...history180d, item.currentPrice);
      const ratio = ath > 0 ? (item.currentPrice / ath) * 100 : 0;
      return { ...item, ratio, refPrice: ath };
    }).sort((a, b) => b.ratio - a.ratio).slice(0, 7);

    const atlItems = [...marketData].map(item => {
      const history180d = item.history.sparkline180d ? item.history.sparkline180d.filter(v => v !== null && v !== undefined) : [];
      const atl = Math.min(...history180d, item.currentPrice);
      const ratio = item.currentPrice > 0 ? (atl / item.currentPrice) * 100 : 0;
      return { ...item, ratio, refPrice: atl };
    }).sort((a, b) => b.ratio - a.ratio).slice(0, 7);

    const extremesSlides = [
      {
        title: "Cerca del ATH (180d)",
        icon: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>',
        colorClass: "text-emerald-500",
        borderClass: "border-emerald-500/30",
        shadowClass: "shadow-[0_0_10px_rgba(16,185,129,0.15)]",
        items: athItems,
        tooltipSuffix: "del ATH"
      },
      {
        title: "Cerca de Mínimos (180D)",
        icon: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"/>',
        colorClass: "text-red-500",
        borderClass: "border-red-500/30",
        shadowClass: "shadow-[0_0_10px_rgba(239,68,68,0.15)]",
        items: atlItems,
        tooltipSuffix: "del ATL"
      }
    ];

    let extremesHTML = '';
    extremesSlides.forEach((slide, idx) => {
      const isFirst = idx === 0;
      const itemsHTML = slide.items.map(item => `
        <div class="w-10 h-10 rounded bg-terminal-dark border ${slide.borderClass} flex items-center justify-center p-1.5 relative group cursor-help ${slide.shadowClass}">
          <img src="/img/sunflowerland/${item.name}.png" class="w-full h-full object-contain drop-shadow-sm" onerror="this.style.display='none'" />
          <div class="absolute -top-8 left-1/2 -translate-x-1/2 bg-black text-[9px] text-white px-2 py-1 rounded opacity-0 group-hover:opacity-100 transition-opacity whitespace-nowrap pointer-events-none z-10 border border-white/20">
            ${item.name} (${item.ratio.toFixed(1)}% ${slide.tooltipSuffix})
          </div>
        </div>
      `).join('');

      extremesHTML += `
        <div class="extremes-slide absolute inset-0 p-5 transition-opacity duration-500 flex flex-col justify-center ${isFirst ? 'opacity-100 z-10' : 'opacity-0 z-0'}">
          <h3 class="text-xs font-mono text-terminal-muted uppercase tracking-wider mb-3 flex items-center gap-2">
            <svg class="w-4 h-4 ${slide.colorClass}" fill="none" viewBox="0 0 24 24" stroke="currentColor">${slide.icon}</svg>
            ${slide.title}
          </h3>
          <div class="flex flex-wrap gap-2 h-auto min-h-12 items-center">
            ${itemsHTML}
          </div>
        </div>
      `;
    });

    const extremesContainer = document.getElementById("dashAthAtlCarousel");
    extremesContainer.innerHTML = extremesHTML;

    if (window.__extremesInterval) clearInterval(window.__extremesInterval);
    let currentExtreme = 0;
    const extremeNodes = extremesContainer.querySelectorAll(".extremes-slide");
    
    if(extremeNodes.length > 1) {
      window.__extremesInterval = setInterval(() => {
        extremeNodes[currentExtreme].classList.remove("opacity-100", "z-10");
        extremeNodes[currentExtreme].classList.add("opacity-0", "z-0");
        
        currentExtreme = (currentExtreme + 1) % extremeNodes.length;
        
        extremeNodes[currentExtreme].classList.remove("opacity-0", "z-0");
        extremeNodes[currentExtreme].classList.add("opacity-100", "z-10");
      }, 15000);
    }
  };

  const renderTable = (filterText = "") => {
    if (!marketData.length) return;

    const lowerFilter = filterText.toLowerCase();
    const filtered = marketData.filter(item => 
      item.name.toLowerCase().includes(lowerFilter) || 
      item.key.toLowerCase().includes(lowerFilter)
    );

    tableBody.innerHTML = "";

    if (filtered.length === 0) {
      tableBody.innerHTML = `<tr><td colspan="5" class="py-8 text-center text-terminal-muted text-sm">No se encontraron items que coincidan con la búsqueda.</td></tr>`;
      return;
    }

    filtered.forEach(item => {
      const tr = document.createElement("tr");
      tr.className = "hover:bg-white/[0.02] transition-colors group";
      
      tr.innerHTML = `
        <td class="py-4 px-4 font-medium text-white flex items-center gap-3">
          <div class="w-8 h-8 rounded bg-terminal-dark border border-terminal-muted/20 flex items-center justify-center p-1">
            <img src="/img/sunflowerland/${item.name}.png" alt="${item.name}" class="w-[60%] h-[60%] object-contain drop-shadow-sm" onerror="this.onerror=null; this.parentElement.innerHTML='📦';" />
          </div>
          <div>
            <p class="text-sm font-semibold text-white group-hover:text-emerald-400 transition-colors">${item.name}</p>
            <p class="text-[10px] font-mono text-terminal-muted/70">${item.key}</p>
          </div>
        </td>
        <td class="py-4 px-4 text-right">
          <span class="text-sm font-medium text-white">${formatNumber(item.currentPrice, 4)}</span>
        </td>
        <td class="py-3 px-4 text-center align-middle">
          ${getChangeHTML(calculateChange(item.currentPrice, item.history["1d"]), null, true)}
        </td>
        <td class="py-3 px-4 text-right align-middle">
          ${getChangeHTML(calculateChange(item.currentPrice, item.history["7d"]), item.history.sparkline7d, true)}
        </td>
        <td class="py-3 px-4 text-right align-middle">
          ${getChangeHTML(calculateChange(item.currentPrice, item.history["30d"]), item.history.sparkline30d, true)}
        </td>
        <td class="py-3 px-4 text-right align-middle">
          ${getChangeHTML(calculateChange(item.currentPrice, item.history["180d"]), item.history.sparkline180d, true)}
        </td>
      `;
      tableBody.appendChild(tr);
    });
  };

  const fetchData = async () => {
    try {
      loadingState.classList.remove("hidden");
      errorState.classList.add("hidden");
      dataContainer.classList.add("hidden");

      // Consultar el asset estático que actualiza el cron job
      const response = await fetch('/api/sfl_data.json');
      
      if (!response.ok) {
        throw new Error(`No se pudo cargar el archivo local: ${response.status}`);
      }

      const json = await response.json();
      
      if (!json.items) {
        throw new Error(`El archivo de datos estáticos no contiene historial de items.`);
      }

      // Mapear el nuevo formato histórico JSON filtrando por sfl_ids.json
      marketData = Object.values(json.items).reduce((acc, data) => {
        const idMatch = data.key.match(/collectibles-(\d+)$/);
        if (idMatch && sflIds[idMatch[1]]) {
           acc.push({
             ...data,
             name: sflIds[idMatch[1]]
           });
        }
        return acc;
      }, []).sort((a, b) => b.volume - a.volume);

      // Usar un estimado total de volumen basado en las props
      const totalVol = marketData.reduce((acc, curr) => acc + (curr.volume || 0), 0);
      totalVolumeEl.innerText = `Volumen Total: ${formatNumber(totalVol, 0)} FLOWER`;

      renderDashboard();
      renderTable(searchInput.value);
      dataContainer.classList.remove("hidden");

    } catch (err) {
      console.error(err);
      errorMsg.innerText = err.message || "Error desconocido al consultar la API.";
      errorState.classList.remove("hidden");
    } finally {
      loadingState.classList.add("hidden");
    }
  };

  // Prevenir inicializaciones dobles en Astro
  const init = () => {
    // Si ya inicializamos, salimos
    if (window.__sflMarketInitialized) return;
    window.__sflMarketInitialized = true;

    if(fetchBtn) {
      fetchBtn.addEventListener("click", () => {
        fetchData();
      });
    }

    if(searchInput) {
      searchInput.addEventListener("input", (e) => {
        renderTable(e.target.value);
      });
    }

    // Primer fetch automático
    fetchData();

    // Lógica para interactividad de las gráficas
    tableBody.addEventListener("mousemove", (e) => {
      const container = e.target.closest(".sparkline-container");
      
      // Ocultar elementos de todos los demás gráficos
      document.querySelectorAll(".sparkline-container .hover-line:not(.hidden)").forEach(el => {
        if (!container || !container.contains(el)) el.classList.add("hidden");
      });
      document.querySelectorAll(".sparkline-container .hover-dot:not(.hidden)").forEach(el => {
        if (!container || !container.contains(el)) el.classList.add("hidden");
      });
      document.querySelectorAll(".sparkline-container .hover-tooltip:not(.hidden)").forEach(el => {
        if (!container || !container.contains(el)) el.classList.add("hidden");
      });

      if (!container) return;
      
      const rect = container.getBoundingClientRect();
      const xPos = e.clientX - rect.left;
      const width = rect.width;
      
      const dataPoints = JSON.parse(container.dataset.points);
      const numPoints = dataPoints.length;
      let index = Math.round((xPos / width) * (numPoints - 1));
      if (index < 0) index = 0;
      if (index >= numPoints) index = numPoints - 1;
      
      const val = dataPoints[index];
      const min = parseFloat(container.dataset.min);
      const range = parseFloat(container.dataset.range);
      
      const svgWidth = 100;
      const svgHeight = 30;
      const mappedX = (index / (numPoints - 1)) * svgWidth;
      const mappedY = svgHeight - ((val - min) / range) * svgHeight;
      
      const line = container.querySelector(".hover-line");
      const dot = container.querySelector(".hover-dot");
      const tooltip = container.querySelector(".hover-tooltip");
      
      if(line && dot && tooltip) {
        line.classList.remove("hidden");
        line.setAttribute("x1", mappedX);
        line.setAttribute("x2", mappedX);
        
        dot.classList.remove("hidden");
        dot.setAttribute("cx", mappedX);
        dot.setAttribute("cy", mappedY);
        
        tooltip.classList.remove("hidden");
        tooltip.innerText = formatNumber(val, 4);
        
        tooltip.style.left = `${(mappedX / svgWidth) * 100}%`;
        tooltip.style.top = `${(mappedY / svgHeight) * 100}%`;
      }
    });

    tableBody.addEventListener("mouseleave", () => {
      document.querySelectorAll(".sparkline-container .hover-line:not(.hidden)").forEach(el => el.classList.add("hidden"));
      document.querySelectorAll(".sparkline-container .hover-dot:not(.hidden)").forEach(el => el.classList.add("hidden"));
      document.querySelectorAll(".sparkline-container .hover-tooltip:not(.hidden)").forEach(el => el.classList.add("hidden"));
    });
  };

  // Manejar el ciclo de vida de Astro ViewTransitions
  document.addEventListener("astro:page-load", () => {
    window.__sflMarketInitialized = false; // Reset en navegacion
    init();
  });
  
  // Por si ViewTransitions no está activo
  if (document.readyState === "complete" || document.readyState === "interactive") {
    setTimeout(init, 1);
  } else {
    document.addEventListener("DOMContentLoaded", init);
  }
</script>
