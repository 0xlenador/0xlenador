---
import Layout from "../layouts/Layout.astro"
import sflIds from "../data/sfl_ids.json"

const seo = {
  title: "Mercado SFL | 0xLeñador — Precios P2P de Sunflower Land",
  description:
    "Consulta en tiempo real los precios del mercado P2P de Sunflower Land. Monitorea volumen, ventas recientes y floor prices de items y wearables.",
  image: "/img/cripto/sunflowerland.webp",
}
---

<Layout title={seo.title} description={seo.description} image={seo.image}>
  <main class="max-w-7xl mx-auto px-6 pt-10 pb-20">
    <header class="mb-12">
      <div class="flex items-center gap-4 mb-3">
        <img src="/img/cripto/sunflowerland.webp" alt="Sunflower Land" class="w-10 h-10 rounded-full object-contain bg-white/[0.05] p-1 border border-white/[0.1]" />
        <p class="text-[10px] font-mono text-emerald-500/70 uppercase tracking-[0.4em]">
          Herramientas / Mercado
        </p>
      </div>
      <h1 class="text-4xl md:text-5xl font-black text-white tracking-tighter mb-4">
        Mercado <span class="text-emerald-500">SFL</span>
      </h1>
      <p class="text-terminal-secondary text-sm leading-relaxed max-w-2xl">
        Monitor de precios y volumen de transacciones del mercado P2P de Sunflower Land. 
        Los datos se extraen de forma local y segura usando la API pública del juego.
      </p>
    </header>

    <div class="bg-white/[0.02] border border-white/[0.05] backdrop-blur-2xl rounded-[24px] p-6 lg:p-8 mb-10 shadow-2xl relative overflow-hidden">
      <!-- Glow effect -->
      <div class="absolute -top-40 -right-40 w-80 h-80 bg-emerald-500/10 rounded-full blur-3xl pointer-events-none"></div>
      
      <div class="flex flex-col md:flex-row justify-between items-start md:items-end gap-4 mb-8 relative z-10">
        <div class="w-full md:w-1/3">
          <label class="block text-xs font-mono text-terminal-muted mb-2 uppercase tracking-widest">Buscar Item</label>
          <input 
            type="text" 
            id="searchInput" 
            placeholder="Ej. Sunflower, Axe..." 
            class="w-full bg-terminal-bg/50 border border-white/[0.1] rounded-xl px-4 py-3 text-white placeholder-white/[0.3] focus:outline-none focus:border-emerald-500/50 focus:ring-1 focus:ring-emerald-500/50 transition-all text-sm"
          />
        </div>
        <div class="w-full md:w-auto">
          <button id="fetchBtn" class="w-full md:w-auto px-6 py-3 bg-emerald-500 hover:bg-emerald-400 text-black font-bold text-sm rounded-xl transition-colors whitespace-nowrap shadow-[0_0_15px_rgba(16,185,129,0.2)] hover:shadow-[0_0_25px_rgba(16,185,129,0.4)]">
            Refrescar
          </button>
        </div>
      </div>

      <div id="loadingState" class="hidden py-20 flex flex-col items-center justify-center relative z-10">
        <svg class="animate-spin h-8 w-8 text-emerald-500 mb-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
        </svg>
        <p class="text-terminal-muted font-mono text-xs animate-pulse">Consultando API de SFL...</p>
      </div>

      <div id="errorState" class="hidden py-12 px-6 bg-red-500/10 border border-red-500/20 rounded-xl relative z-10">
        <p id="errorMsg" class="text-red-400 text-sm text-center">Error al cargar los datos.</p>
      </div>

      <div id="dataContainer" class="hidden relative z-10">
        
        <!-- Dashboard Resumen (Coming Soon) -->
        <div class="relative mb-10">
          <div class="absolute inset-0 z-20 backdrop-blur-[3px] bg-terminal-bg/40 rounded-[20px] flex items-center justify-center border border-emerald-500/20">
            <div class="bg-black/80 px-6 py-3 rounded-full border border-emerald-500/30 flex items-center gap-3 shadow-[0_0_20px_rgba(16,185,129,0.15)]">
              <span class="relative flex h-3 w-3">
                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                <span class="relative inline-flex rounded-full h-3 w-3 bg-emerald-500"></span>
              </span>
              <span class="font-mono text-sm text-emerald-400 uppercase tracking-widest font-bold">Pro Features • Coming Soon</span>
            </div>
          </div>
          
          <div class="grid grid-cols-1 md:grid-cols-3 gap-4 opacity-40 select-none pointer-events-none">
            <div class="bg-white/[0.02] border border-white/[0.05] rounded-[20px] p-5 shadow-inner">
              <h3 class="text-xs font-mono text-terminal-muted uppercase tracking-wider mb-3 flex items-center gap-2">
                <svg class="w-4 h-4 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/></svg>
                Top Volume 24h
              </h3>
              <div class="h-8 bg-white/[0.05] rounded-lg w-3/4 mb-2 animate-pulse"></div>
              <div class="h-4 bg-white/[0.05] rounded w-1/2 animate-pulse"></div>
            </div>
            <div class="bg-white/[0.02] border border-white/[0.05] rounded-[20px] p-5 shadow-inner">
              <h3 class="text-xs font-mono text-terminal-muted uppercase tracking-wider mb-3 flex items-center gap-2">
                <svg class="w-4 h-4 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 10l7-7m0 0l7 7m-7-7v18"/></svg>
                Mayor Ganador 7d
              </h3>
              <div class="h-8 bg-white/[0.05] rounded-lg w-2/3 mb-2 animate-pulse"></div>
              <div class="h-4 bg-white/[0.05] rounded w-1/3 animate-pulse"></div>
            </div>
            <div class="bg-white/[0.02] border border-white/[0.05] rounded-[20px] p-5 shadow-inner">
              <h3 class="text-xs font-mono text-terminal-muted uppercase tracking-wider mb-3 flex items-center gap-2">
                <svg class="w-4 h-4 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"/></svg>
                Productos Nuevos
              </h3>
              <div class="flex gap-2 mb-2">
                <div class="h-10 w-10 bg-white/[0.05] rounded-lg animate-pulse border border-white/10"></div>
                <div class="h-10 w-10 bg-white/[0.05] rounded-lg animate-pulse border border-white/10"></div>
                <div class="h-10 w-10 bg-white/[0.05] rounded-lg animate-pulse border border-white/10"></div>
              </div>
            </div>
          </div>
        </div>

        <div class="flex items-center justify-between mb-4">
          <h2 class="text-lg font-semibold text-white">Actividad del Mercado <span class="text-xs text-terminal-muted font-normal ml-2 tracking-wide">P2P History</span></h2>
          <span id="totalVolume" class="text-xs font-mono text-emerald-400 bg-emerald-500/10 px-3 py-1 rounded-full border border-emerald-500/20"></span>
        </div>

        <div class="overflow-x-auto">
          <table class="w-full text-left border-collapse">
            <thead>
              <tr class="border-b border-white/[0.05]">
                <th class="py-4 px-4 text-xs font-mono text-terminal-muted font-medium uppercase tracking-wider">Name</th>
                <th class="py-4 px-4 text-xs font-mono text-terminal-muted font-medium uppercase tracking-wider text-right">Price</th>
                <th class="py-4 px-4 text-xs font-mono text-terminal-muted font-medium uppercase tracking-wider text-right w-28">Last 24h</th>
                <th class="py-4 px-4 text-xs font-mono text-terminal-muted font-medium uppercase tracking-wider text-right w-28">Last 7d</th>
                <th class="py-4 px-4 text-xs font-mono text-terminal-muted font-medium uppercase tracking-wider text-right w-28">Last 30d</th>
                <th class="py-4 px-4 text-xs font-mono text-terminal-muted font-medium uppercase tracking-wider text-right w-28">Last 180d</th>
              </tr>
            </thead>
            <tbody id="tableBody" class="divide-y divide-white/[0.02]">
              <!-- Filas dinámicas -->
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </main>
</Layout>

<script define:vars={{ sflIds }}>
  const searchInput = document.getElementById("searchInput");
  const fetchBtn = document.getElementById("fetchBtn");
  const loadingState = document.getElementById("loadingState");
  const errorState = document.getElementById("errorState");
  const errorMsg = document.getElementById("errorMsg");
  const dataContainer = document.getElementById("dataContainer");
  const tableBody = document.getElementById("tableBody");
  const totalVolumeEl = document.getElementById("totalVolume");

  let marketData = [];

  // Formatear números
  const formatNumber = (num, decimals = 2) => {
    if (num === undefined || num === null) return "0";
    if (num < 0.0001) return num.toExponential(2);
    return new Intl.NumberFormat("en-US", {
      minimumFractionDigits: 0,
      maximumFractionDigits: decimals,
    }).format(num);
  };

  // Extraer el nombre del ID
  const getItemName = (key) => {
    // ej: collectibles-201 -> 201
    const idMatch = key.match(/-(\d+)$/);
    if (idMatch && idMatch[1]) {
      const id = idMatch[1];
      if (sflIds[id]) return sflIds[id];
    }
    return key;
  };

  // Helper para SVG Sparkline Nativo
  const createSparklineSVG = (dataArray, isPositive) => {
    if (!dataArray) return '';
    // Filtrar nulos para trazar linea continua
    const validData = dataArray.filter(v => v !== null && v !== undefined);
    if (validData.length < 2) return ''; 

    const width = 100;
    const height = 30;
    const max = Math.max(...validData);
    const min = Math.min(...validData);
    const range = max - min || 1; 
    
    const points = validData.map((val, i) => {
      const x = (i / (validData.length - 1)) * width;
      const y = height - ((val - min) / range) * height;
      return `${x},${y}`;
    }).join(' L ');

    const strokeColor = isPositive ? '#10b981' : '#ef4444'; // emerald-500 o red-500
    
    // Sparkline con gradiente estético debajo de la curva (Glassmorphism sutil)
    return `
      <svg width="100%" height="100%" viewBox="-2 -2 104 34" preserveAspectRatio="none" class="opacity-70 group-hover:opacity-100 transition-opacity drop-shadow-md">
        <path d="M ${points}" fill="none" stroke="${strokeColor}" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    `;
  };

  const calculateChange = (current, past) => {
    if (!past || past === 0 || !current) return { val: 0, text: '-', isPositive: null, pastPrice: null };
    const change = ((current - past) / past) * 100;
    const isPositive = change >= 0;
    return {
      val: change,
      text: `${isPositive ? '+' : ''}${change.toFixed(2)}%`,
      isPositive,
      pastPrice: past
    };
  };

  const getChangeHTML = (changeObj, sparklineData) => {
    if (changeObj.isPositive === null) return '<span class="text-terminal-muted/50 font-mono text-xs">-</span>';
    
    const colorClass = changeObj.isPositive ? 'text-emerald-500 bg-emerald-500/10 border-emerald-500/20' : 'text-red-500 bg-red-500/10 border-red-500/20';
    const arrow = changeObj.isPositive 
      ? '<svg class="w-3 h-3 inline mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 15l7-7 7 7"/></svg>' 
      : '<svg class="w-3 h-3 inline mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>';
      
    const sparklineHTML = sparklineData ? `<div class="h-6 mt-1.5 w-full flex justify-end pl-4">${createSparklineSVG(sparklineData, changeObj.isPositive)}</div>` : '';
      
    return `
      <div class="flex flex-col items-end">
        <div class="flex items-center gap-2">
          <span class="text-[10px] font-mono text-white/70">${formatNumber(changeObj.pastPrice, 4)}</span>
          <span class="text-[10px] font-bold font-mono px-1.5 py-0.5 rounded border ${colorClass} flex items-center justify-end">
            ${arrow}${changeObj.text}
          </span>
        </div>
        ${sparklineHTML}
      </div>
    `;
  };

  const renderTable = (filterText = "") => {
    if (!marketData.length) return;

    const lowerFilter = filterText.toLowerCase();
    const filtered = marketData.filter(item => 
      item.name.toLowerCase().includes(lowerFilter) || 
      item.key.toLowerCase().includes(lowerFilter)
    );

    tableBody.innerHTML = "";

    if (filtered.length === 0) {
      tableBody.innerHTML = `<tr><td colspan="5" class="py-8 text-center text-terminal-muted text-sm">No se encontraron items que coincidan con la búsqueda.</td></tr>`;
      return;
    }

    filtered.forEach(item => {
      const tr = document.createElement("tr");
      tr.className = "hover:bg-white/[0.02] transition-colors group";
      
      tr.innerHTML = `
        <td class="py-4 px-4 font-medium text-white flex items-center gap-3">
          <div class="w-8 h-8 rounded bg-terminal-dark border border-terminal-muted/20 flex items-center justify-center p-1">
            <img src="/img/sunflowerland/${item.name}.png" alt="${item.name}" class="w-full h-full object-contain" onerror="this.onerror=null; this.parentElement.innerHTML='📦';" />
          </div>
          <div>
            <p class="text-sm font-semibold text-white group-hover:text-emerald-400 transition-colors">${item.name}</p>
            <p class="text-[10px] font-mono text-terminal-muted/70">${item.key}</p>
          </div>
        </td>
        <td class="py-4 px-4 text-right">
          <span class="text-sm font-medium text-white">${formatNumber(item.currentPrice, 4)}</span>
          <span class="text-[10px] text-emerald-500/70 ml-1">FLOWER</span>
        </td>
        <td class="py-3 px-4 text-right align-middle">
          ${getChangeHTML(calculateChange(item.currentPrice, item.history["1d"]), null)}
        </td>
        <td class="py-3 px-4 text-right align-middle">
          ${getChangeHTML(calculateChange(item.currentPrice, item.history["7d"]), item.history.sparkline7d)}
        </td>
        <td class="py-3 px-4 text-right align-middle">
          ${getChangeHTML(calculateChange(item.currentPrice, item.history["30d"]), item.history.sparkline30d)}
        </td>
        <td class="py-3 px-4 text-right align-middle">
          ${getChangeHTML(calculateChange(item.currentPrice, item.history["180d"]), item.history.sparkline180d)}
        </td>
      `;
      tableBody.appendChild(tr);
    });
  };

  const fetchData = async () => {
    try {
      loadingState.classList.remove("hidden");
      errorState.classList.add("hidden");
      dataContainer.classList.add("hidden");

      // Consultar el asset estático que actualiza el cron job
      const response = await fetch('/api/sfl_data.json');
      
      if (!response.ok) {
        throw new Error(`No se pudo cargar el archivo local: ${response.status}`);
      }

      const json = await response.json();
      
      if (!json.items) {
        throw new Error(`El archivo de datos estáticos no contiene historial de items.`);
      }

      // Mapear el nuevo formato histórico JSON filtrando por sfl_ids.json
      marketData = Object.values(json.items).reduce((acc, data) => {
        const idMatch = data.key.match(/collectibles-(\d+)$/);
        if (idMatch && sflIds[idMatch[1]]) {
           acc.push({
             ...data,
             name: sflIds[idMatch[1]]
           });
        }
        return acc;
      }, []).sort((a, b) => b.volume - a.volume);

      // Usar un estimado total de volumen basado en las props
      const totalVol = marketData.reduce((acc, curr) => acc + (curr.volume || 0), 0);
      totalVolumeEl.innerText = `Volumen Total: ${formatNumber(totalVol, 0)} FLOWER`;

      renderTable(searchInput.value);
      dataContainer.classList.remove("hidden");

    } catch (err) {
      console.error(err);
      errorMsg.innerText = err.message || "Error desconocido al consultar la API.";
      errorState.classList.remove("hidden");
    } finally {
      loadingState.classList.add("hidden");
    }
  };

  // Prevenir inicializaciones dobles en Astro
  const init = () => {
    // Si ya inicializamos, salimos
    if (window.__sflMarketInitialized) return;
    window.__sflMarketInitialized = true;

    if(fetchBtn) {
      fetchBtn.addEventListener("click", () => {
        fetchData();
      });
    }

    if(searchInput) {
      searchInput.addEventListener("input", (e) => {
        renderTable(e.target.value);
      });
    }

    // Primer fetch automático
    fetchData();
  };

  // Manejar el ciclo de vida de Astro ViewTransitions
  document.addEventListener("astro:page-load", () => {
    window.__sflMarketInitialized = false; // Reset en navegacion
    init();
  });
  
  // Por si ViewTransitions no está activo
  if (document.readyState === "complete" || document.readyState === "interactive") {
    setTimeout(init, 1);
  } else {
    document.addEventListener("DOMContentLoaded", init);
  }
</script>
