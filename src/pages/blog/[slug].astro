---
import { getCollection, render } from "astro:content";
import Layout from "../../layouts/Layout.astro";

// 1. Generar automáticamente las rutas basadas en los nombres de los archivos .md
export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

// 2. Extraer los datos y compilar el cuerpo del Markdown a HTML nativo
const { post } = Astro.props;
const { title, description, keywords, date, readTime, category } = post.data;
const { Content } = await render(post);
---

<Layout
  title={`${title} | 0xLeñador`}
  description={description}
  keywords={keywords}
  ogType="article"
>
  <style is:global slot="head">
    .toc-link {
      transition: all 0.2s ease;
    }
    .toc-link.active {
      color: #34d399 !important;
      font-weight: 600;
    }
    .toc-marker {
      transition: all 0.2s ease;
    }
    .toc-item:hover .toc-marker {
      border-color: #34d399 !important;
    }
    .toc-item:has(.active) .toc-marker {
      background-color: #34d399 !important;
      border-color: #34d399 !important;
      transform: scale(1.3) rotate(45deg);
      box-shadow: 0 0 10px rgba(52, 211, 153, 0.4);
    }
  </style>

    <main
      class="max-w-7xl mx-auto px-6 relative z-10 flex flex-col lg:flex-row gap-16"
    >
      <article class="w-full lg:w-[68%]">
        <nav
          class="flex text-xs text-slate-500 mb-10 font-medium font-mono uppercase tracking-widest"
        >
          <a href="/" class="hover:text-emerald-400 transition-colors">Inicio</a
          >
          <span class="mx-3">›</span>
          <a href="/blog" class="hover:text-emerald-400 transition-colors"
            >Artículos</a
          >
          <span class="mx-3">›</span>
          <span class="text-slate-400 truncate max-w-[200px] sm:max-w-xs"
            >{title}</span
          >
        </nav>

        <header class="mb-12 border-b border-slate-800/60 pb-10">
          <h1
            class="text-3xl md:text-5xl font-black text-white mb-6 tracking-tight leading-tight uppercase italic"
          >
            {title}
          </h1>

          <div
            class="flex flex-wrap items-center gap-4 md:gap-6 text-slate-400 text-sm font-medium"
          >
            <div
              class="flex items-center gap-2 px-3 py-1 bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 rounded-md font-mono text-xs uppercase tracking-wider"
            >
              <span
                class="w-1.5 h-1.5 rounded-full bg-emerald-500 shadow-[0_0_8px_rgba(16,185,129,0.8)]"
              ></span>
              {category}
            </div>
            <div
              class="flex items-center gap-2 border-l border-slate-800 pl-4 md:pl-6"
            >
              <span class="text-slate-500">Actualizado</span>
              <span class="text-slate-300">{date}</span>
            </div>
            <div
              class="flex items-center gap-2 border-l border-slate-800 pl-4 md:pl-6"
            >
              <svg
                class="w-4 h-4 text-slate-500"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                ><path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg
              >
              <span class="text-slate-300">{readTime} de lectura</span>
            </div>
          </div>
        </header>

        <div class="content relative text-justify" id="article-content">
          <Content />
        </div>

        <footer
          class="mt-20 pt-8 border-t border-slate-800/60 flex flex-col sm:flex-row items-center justify-between gap-6"
        >
          <div class="flex items-center gap-4">
            <div
              class="w-12 h-12 rounded-full bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-center"
            >
              <span class="font-bold text-emerald-400 font-mono">0x</span>
            </div>
            <div>
              <p class="text-white font-bold text-sm">Escrito por 0xLeñador</p>
              <p class="text-slate-500 text-xs">
                Divulgador sobre la gestión de Capital
              </p>
            </div>
          </div>
        </footer>
      </article>

      <aside class="w-full lg:w-[32%] mt-12 lg:mt-0">
        <div
          class="sticky top-32 space-y-10 max-h-[calc(100vh-8rem)] overflow-y-auto pb-8 pr-2 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
        >
          <div
            class="bg-slate-900/40 p-6 rounded-2xl border border-slate-800/60"
          >
            <h3 class="text-white font-bold text-base mb-4">
              Compartir publicación
            </h3>
            <div class="flex items-center gap-3">
              <button
                onclick={`window.open('https://twitter.com/intent/tweet?text=${encodeURIComponent(title)}&url=' + window.location.href, '_blank')`}
                class="flex-1 flex justify-center p-3 rounded-xl bg-slate-900 border border-slate-800 text-slate-400 hover:text-emerald-400 hover:border-emerald-500/30 hover:bg-emerald-500/5 transition-all cursor-pointer"
              >
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"
                  ><path
                    d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"
                  ></path></svg
                >
              </button>
              <button
                onclick={`window.open('https://www.facebook.com/sharer/sharer.php?u=' + window.location.href, '_blank')`}
                class="flex-1 flex justify-center p-3 rounded-xl bg-slate-900 border border-slate-800 text-slate-400 hover:text-emerald-400 hover:border-emerald-500/30 hover:bg-emerald-500/5 transition-all cursor-pointer"
              >
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"
                  ><path
                    d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"
                  ></path></svg
                >
              </button>
              <button
                onclick={`window.open('https://t.me/share/url?url=' + window.location.href + '&text=${encodeURIComponent(title)}', '_blank')`}
                class="flex-1 flex justify-center p-3 rounded-xl bg-slate-900 border border-slate-800 text-slate-400 hover:text-emerald-400 hover:border-emerald-500/30 hover:bg-emerald-500/5 transition-all cursor-pointer"
              >
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"
                  ><path
                    d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"
                  ></path></svg
                >
              </button>
              <button
                onclick="navigator.clipboard.writeText(window.location.href); alert('¡Enlace copiado!');"
                class="flex-1 flex justify-center p-3 rounded-xl bg-slate-900 border border-slate-800 text-slate-400 hover:text-emerald-400 hover:border-emerald-500/30 hover:bg-emerald-500/5 transition-all cursor-pointer"
              >
                <svg
                  class="w-5 h-5"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                  stroke-width="2"
                  ><path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"
                  ></path></svg
                >
              </button>
            </div>
          </div>

          <div class="hidden lg:block">
            <h3
              class="text-white font-bold text-lg mb-6 flex items-center gap-2"
            >
              <svg
                class="w-5 h-5 text-emerald-500"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                ><path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M4 6h16M4 12h16M4 18h7"></path></svg
              >
              Aspectos clave
            </h3>
            <div class="relative pl-[9px] ml-[7px] border-l-2 border-slate-800">
              <ul
                id="toc-list"
                class="space-y-5 text-[15px] font-medium text-slate-400 relative"
              >
              </ul>
            </div>
          </div>
        </div>
      </aside>

      <div
        class="fixed top-0 left-1/2 -translate-x-1/2 w-[800px] h-[400px] bg-emerald-500/5 blur-[120px] rounded-full pointer-events-none z-0"
      >
      </div>
    </main>



    <button
      id="mobile-toc-btn"
      aria-label="Abrir Índice"
      class="fixed bottom-6 right-6 z-[60] lg:hidden p-4 rounded-full bg-emerald-500 text-slate-950 shadow-[0_0_20px_rgba(16,185,129,0.3)] hover:scale-105 transition-all cursor-pointer"
    >
      <svg
        class="w-6 h-6"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
        stroke-width="2"
        ><path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M4 6h16M4 12h8m-8 6h16"></path></svg
      >
    </button>

    <div
      id="mobile-toc-modal"
      class="fixed inset-0 z-[70] bg-slate-950/80 backdrop-blur-sm opacity-0 pointer-events-none transition-opacity duration-300 lg:hidden"
    >
      <div
        id="mobile-toc-drawer"
        class="absolute bottom-0 left-0 w-full bg-slate-900 border-t border-slate-800 rounded-t-3xl p-6 pt-8 max-h-[85vh] overflow-y-auto transform translate-y-full transition-transform duration-300"
      >
        <div class="flex justify-between items-center mb-8">
          <h3 class="text-white font-bold text-xl flex items-center gap-2">
            <svg
              class="w-6 h-6 text-emerald-500"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M4 6h16M4 12h16M4 18h7"></path></svg
            >
            Aspectos clave
          </h3>
          <button
            id="close-mobile-toc"
            class="p-2 text-slate-400 hover:text-white bg-slate-800/50 rounded-full transition-colors cursor-pointer"
          >
            <svg
              class="w-5 h-5"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              stroke-width="2"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M6 18L18 6M6 6l12 12"></path></svg
            >
          </button>
        </div>
        <div
          class="relative pl-[9px] ml-[7px] border-l-2 border-slate-800 pb-10"
        >
          <ul
            id="toc-list-mobile"
            class="space-y-6 text-[15px] font-medium text-slate-400 relative"
          >
          </ul>
        </div>
      </div>
    </div>

    <script is:inline>
      document.addEventListener("DOMContentLoaded", () => {
        const container = document.getElementById("article-content");
        const desktopList = document.getElementById("toc-list");
        const mobileList = document.getElementById("toc-list-mobile");
        if (!container) return;

        const headings = container.querySelectorAll("h2, h3");
        headings.forEach((heading, i) => {
          const cleanId = heading.id || `sec-${i}`;
          heading.id = cleanId;
          const text = heading.innerText;
          const isH3 = heading.tagName.toLowerCase() === "h3";

          const createItem = () => {
            const li = document.createElement("li");
            li.className = `toc-item flex items-center justify-between gap-4 relative w-full ${isH3 ? "pl-4 text-sm" : "text-[15px]"}`;
            const a = document.createElement("a");
            a.href = `#${cleanId}`;
            a.className =
              "toc-link block w-full text-slate-400 hover:text-emerald-400 transition-colors py-0.5";
            a.innerText = text;
            const marker = document.createElement("span");
            marker.className =
              "toc-marker w-2 h-2 rounded-full border border-slate-700 bg-slate-950 absolute -left-[14px] top-[10px]";
            li.appendChild(a);
            li.appendChild(marker);
            return li;
          };

          if (desktopList) desktopList.appendChild(createItem());
          if (mobileList) mobileList.appendChild(createItem());
        });

        const links = document.querySelectorAll(".toc-link");
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                const id = entry.target.id;
                links.forEach((link) => {
                  if (link.getAttribute("href") === `#${id}`) {
                    link.classList.add("active");
                  } else {
                    link.classList.remove("active");
                  }
                });
              }
            });
          },
          { root: null, rootMargin: "0px 0px -70% 0px", threshold: 0.1 },
        );

        headings.forEach((h) => observer.observe(h));

        const mBtn = document.getElementById("mobile-toc-btn");
        const mModal = document.getElementById("mobile-toc-modal");
        const mDrawer = document.getElementById("mobile-toc-drawer");
        const mClose = document.getElementById("close-mobile-toc");

        if (mBtn && mModal && mDrawer) {
          mBtn.addEventListener("click", () => {
            mModal.classList.remove("pointer-events-none", "opacity-0");
            mDrawer.classList.remove("translate-y-full");
          });
          const close = () => {
            mModal.classList.add("pointer-events-none", "opacity-0");
            mDrawer.classList.add("translate-y-full");
          };
          mClose.addEventListener("click", close);
          mModal.addEventListener("click", (e) => {
            if (e.target === mModal) close();
          });
        }
      });
    </script>
</Layout>
