---
import { getCollection, render } from "astro:content";
import Layout from "../../layouts/Layout.astro";

// 1. Generar automáticamente las rutas basadas en los nombres de los archivos .md
export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

// 2. Extraer los datos y compilar el cuerpo del Markdown a HTML nativo
const { post } = Astro.props;
const { title, description, keywords, date, category, coverImage, coverAlt } = post.data;
const { Content, remarkPluginFrontmatter, headings } = await render(post);
const tocHeadings = headings.filter(h => h.depth === 2 || h.depth === 3);
const readTime = post.data.readTime || remarkPluginFrontmatter?.readTime || "5 min";

// Agrupar headings: cada H2 contiene sus H3 hijos
type TocGroup = { heading: typeof tocHeadings[0]; children: typeof tocHeadings };
const groupedToc: TocGroup[] = [];
for (const h of tocHeadings) {
  if (h.depth === 2) {
    groupedToc.push({ heading: h, children: [] });
  } else if (h.depth === 3 && groupedToc.length > 0) {
    groupedToc[groupedToc.length - 1].children.push(h);
  }
}

// Formatear fecha al estilo: Apr 22, 2026
const formattedDate = new Date(date).toLocaleDateString("en-US", {
  year: "numeric",
  month: "short",
  day: "numeric",
  timeZone: "UTC",
});
---

<Layout
  title={`${title} | 0xLeñador`}
  description={description}
  keywords={keywords}
  ogType="article"
  image={coverImage}
>
  <style is:global slot="head">
    .toc-link {
      transition: all 0.2s ease;
    }
    .toc-link.active {
      color: #34d399 !important;
      font-weight: 600;
    }
    .toc-marker {
      transition: all 0.2s ease;
    }
    .toc-item:hover .toc-marker {
      border-color: #34d399 !important;
    }
    .toc-item:has(.active) .toc-marker {
      background-color: #34d399 !important;
      border-color: #34d399 !important;
      transform: scale(1.3) rotate(45deg);
      box-shadow: 0 0 10px rgba(52, 211, 153, 0.4);
    }
    /* Barra de progreso de lectura */
    #reading-progress {
      position: fixed;
      top: 0;
      left: 0;
      height: 2px;
      width: 0%;
      background: linear-gradient(90deg, #10b981, #34d399, #22d3ee);
      box-shadow: 0 0 8px rgba(52, 211, 153, 0.6);
      z-index: 9999;
      transition: width 0.1s linear;
      border-radius: 0 2px 2px 0;
    }
    /* Acordeón de H3 en el TOC */
    .toc-h3-group {
      max-height: 0;
      overflow: hidden;
      transition: max-height 0.35s ease;
      position: relative;
    }
    .toc-h3-group.open {
      max-height: 500px;
    }
    .toc-h3-group::before {
      content: "";
      position: absolute;
      top: 0;
      bottom: 0;
      left: 8px;
      width: 1px;
      background-color: rgba(42, 42, 42, 0.4);
    }
  </style>

  <!-- Barra de progreso de lectura -->
  <div id="reading-progress" role="progressbar" aria-label="Progreso de lectura" aria-valuenow={0} aria-valuemin={0} aria-valuemax={100}></div>

    <main
      class="max-w-7xl mx-auto px-6 relative z-10 flex flex-col lg:flex-row gap-16"
    >
      <article class="w-full lg:w-[68%]">
        <nav
          class="flex text-xs text-terminal-muted mb-10 font-medium font-mono uppercase tracking-widest"
        >
          <a href="/" class="hover:text-emerald-400 transition-colors">Inicio</a
          >
          <span class="mx-3">›</span>
          <a href="/blog" class="hover:text-emerald-400 transition-colors"
            >Artículos</a
          >
          <span class="mx-3">›</span>
          <span class="text-terminal-secondary truncate max-w-[200px] sm:max-w-xs"
            >{title}</span
          >
        </nav>

        <header class="mb-12 border-b border-terminal-border/60 pb-10">
          <h1
            class="text-2xl md:text-4xl font-extrabold text-terminal-text mb-6 tracking-tight leading-tight"
          >
            {title}
          </h1>

          <div
            class="flex flex-wrap items-center gap-4 md:gap-6 text-terminal-secondary text-sm font-medium"
          >
            <div
              class="flex items-center gap-2 px-3 py-1 bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 rounded-md font-mono text-xs uppercase tracking-wider"
            >
              <span
                class="w-1.5 h-1.5 rounded-full bg-emerald-500 shadow-[0_0_8px_rgba(16,185,129,0.8)]"
              ></span>
              {category}
            </div>
            <div
              class="flex items-center gap-2 border-l border-terminal-border pl-4 md:pl-6"
            >
              <span class="text-terminal-muted">Actualizado</span>
              <span class="text-terminal-secondary">{formattedDate}</span>
            </div>
            <div
              class="flex items-center gap-2 border-l border-terminal-border pl-4 md:pl-6"
            >
              <svg
                class="w-4 h-4 text-terminal-muted"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                ><path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg
              >
              <span class="text-terminal-secondary">{readTime} de lectura</span>
            </div>
          </div>
        </header>

        {coverImage && (
          <div class="mb-12 rounded-2xl overflow-hidden border border-terminal-border/60 shadow-[0_0_30px_rgba(16,185,129,0.05)] relative group">
            <div class="absolute inset-0 bg-emerald-500/10 opacity-0 group-hover:opacity-100 transition-opacity duration-500 z-10 pointer-events-none"></div>
            <img 
              src={coverImage} 
              alt={coverAlt || `Portada para el artículo: ${title}`} 
              class="w-full h-auto max-h-[500px] object-cover transform group-hover:scale-[1.02] transition-transform duration-700 ease-out"
              loading="eager"
            />
          </div>
        )}

        <div class="content relative text-left md:text-justify" id="article-content">
          <Content />
        </div>

        <footer
          class="mt-20 pt-8 border-t border-terminal-border/60 flex flex-col sm:flex-row items-center justify-between gap-6"
        >
          <div class="flex items-center gap-4">
            <div
              class="w-12 h-12 rounded-full bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-center"
            >
              <span class="font-bold text-emerald-400 font-mono">0x</span>
            </div>
            <div>
              <p class="text-white font-bold text-sm">Escrito por 0xLeñador</p>
              <p class="text-terminal-muted text-xs">
                Divulgador sobre la gestión de Capital
              </p>
            </div>
          </div>
        </footer>
      </article>

      <aside class="w-full lg:w-[32%] mt-12 lg:mt-0">
        <div
          id="sidebar-scroll-container"
          class="sticky top-32 space-y-10 max-h-[calc(100vh-8rem)] overflow-y-auto pb-8 pr-2 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
        >
          <div
            class="bg-terminal-surface/40 p-6 rounded-2xl border border-terminal-border/60"
          >
            <h3 class="text-white font-bold text-base mb-4">
              Compartir publicación
            </h3>
            <div class="flex items-center gap-3">
              <button
                onclick={`window.open('https://twitter.com/intent/tweet?text=${encodeURIComponent(title)}&url=' + window.location.href, '_blank')`}
                class="flex-1 flex justify-center p-3 rounded-xl bg-terminal-surface border border-terminal-border text-terminal-secondary hover:text-emerald-400 hover:border-emerald-500/30 hover:bg-emerald-500/5 transition-all cursor-pointer"
              >
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"
                  ><path
                    d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"
                  ></path></svg
                >
              </button>
              <button
                onclick={`window.open('https://www.facebook.com/sharer/sharer.php?u=' + window.location.href, '_blank')`}
                class="flex-1 flex justify-center p-3 rounded-xl bg-terminal-surface border border-terminal-border text-terminal-secondary hover:text-emerald-400 hover:border-emerald-500/30 hover:bg-emerald-500/5 transition-all cursor-pointer"
              >
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"
                  ><path
                    d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"
                  ></path></svg
                >
              </button>
              <button
                onclick={`window.open('https://t.me/share/url?url=' + window.location.href + '&text=${encodeURIComponent(title)}', '_blank')`}
                class="flex-1 flex justify-center p-3 rounded-xl bg-terminal-surface border border-terminal-border text-terminal-secondary hover:text-emerald-400 hover:border-emerald-500/30 hover:bg-emerald-500/5 transition-all cursor-pointer"
              >
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"
                  ><path
                    d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"
                  ></path></svg
                >
              </button>
              <button
                onclick="navigator.clipboard.writeText(window.location.href); alert('¡Enlace copiado!');"
                class="flex-1 flex justify-center p-3 rounded-xl bg-terminal-surface border border-terminal-border text-terminal-secondary hover:text-emerald-400 hover:border-emerald-500/30 hover:bg-emerald-500/5 transition-all cursor-pointer"
              >
                <svg
                  class="w-5 h-5"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                  stroke-width="2"
                  ><path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"
                  ></path></svg
                >
              </button>
            </div>
          </div>

          {groupedToc.length > 0 && (
            <div id="desktop-toc-container" class="hidden lg:block transition-all duration-300">
              <div class="flex items-center justify-between mb-6">
                <h3 class="text-white font-bold text-lg flex items-center gap-2">
                  <svg class="w-5 h-5 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"
                    ><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h7"></path></svg>
                  Aspectos clave
                </h3>
                <button
                  id="hide-toc-btn"
                  title="Ocultar índice de la pantalla"
                  class="text-terminal-secondary hover:text-emerald-400 p-1.5 rounded-lg hover:bg-terminal-surface border border-transparent hover:border-terminal-border transition-colors cursor-pointer"
                >
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3.98 8.223A10.477 10.477 0 001.934 12C3.226 16.338 7.244 19.5 12 19.5c.993 0 1.953-.138 2.863-.395M6.228 6.228A10.45 10.45 0 0112 4.5c4.756 0 8.773 3.162 10.065 7.498a10.523 10.523 0 01-4.293 5.774M6.228 6.228L21 21m-10.5-8.223a3 3 0 114.24-4.24m0 0a3 3 0 01-4.24 4.24" />
                  </svg>
                </button>
              </div>
              <div class="relative pl-[9px] ml-[7px] border-l-2 border-terminal-border">
                <ul id="toc-list" class="space-y-5 text-[15px] font-medium text-terminal-secondary relative">
                  {groupedToc.map(group => (
                    <li class="toc-item toc-h2-item flex flex-col relative w-full" data-h2={group.heading.slug}>
                      <div class="flex items-center justify-between gap-4">
                        <a
                          href={`#${group.heading.slug}`}
                          class="toc-link block w-full text-terminal-secondary hover:text-emerald-400 transition-colors py-0.5 text-[15px]"
                        >{group.heading.text}</a>
                        <span class="toc-marker w-2 h-2 rounded-full border border-terminal-border-subtle bg-terminal-bg absolute -left-[14px] top-[10px]"></span>
                      </div>
                      {group.children.length > 0 && (
                        <ul class="toc-h3-group pl-6 mt-2 space-y-2">
                          {group.children.map(child => (
                            <li class="toc-item toc-h3-item flex items-center justify-between gap-4 relative w-full" data-h3={child.slug}>
                              <a
                                href={`#${child.slug}`}
                                class="toc-link block w-full text-terminal-secondary hover:text-emerald-400 transition-colors py-0.5 text-sm"
                              >{child.text}</a>
                              <span class="toc-marker w-2 h-2 rounded-full border border-terminal-border-subtle bg-terminal-bg absolute -left-[20px] top-[10px]"></span>
                            </li>
                          ))}
                        </ul>
                      )}
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          )}
        </div>
      </aside>

      <div
        class="fixed top-0 left-1/2 -translate-x-1/2 w-[800px] h-[400px] bg-emerald-500/5 blur-[120px] rounded-full pointer-events-none z-0"
      >
      </div>
    </main>



    <button
      id="mobile-toc-btn"
      aria-label="Abrir Índice"
      class="fixed bottom-24 right-6 z-[60] lg:hidden p-4 rounded-full bg-emerald-500 text-terminal-bg shadow-[0_0_20px_rgba(16,185,129,0.3)] hover:scale-105 transition-all cursor-pointer"
    >
      <svg
        class="w-6 h-6"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
        stroke-width="2"
        ><path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M4 6h16M4 12h8m-8 6h16"></path></svg
      >
    </button>

    <div
      id="mobile-toc-modal"
      class="fixed inset-0 z-[70] bg-terminal-bg/80 backdrop-blur-sm opacity-0 pointer-events-none transition-opacity duration-300 lg:hidden"
    >
      <div
        id="mobile-toc-drawer"
        class="absolute bottom-0 left-0 w-full bg-terminal-surface border-t border-terminal-border rounded-t-3xl p-6 pt-8 max-h-[85vh] overflow-y-auto transform translate-y-full transition-transform duration-300"
      >
        <div class="flex justify-between items-center mb-8">
          <h3 class="text-white font-bold text-xl flex items-center gap-2">
            <svg
              class="w-6 h-6 text-emerald-500"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M4 6h16M4 12h16M4 18h7"></path></svg
            >
            Aspectos clave
          </h3>
          <button
            id="close-mobile-toc"
            class="p-2 text-terminal-secondary hover:text-white bg-terminal-border/50 rounded-full transition-colors cursor-pointer"
          >
            <svg
              class="w-5 h-5"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              stroke-width="2"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M6 18L18 6M6 6l12 12"></path></svg
            >
          </button>
        </div>
        <div class="relative pl-[9px] ml-[7px] border-l-2 border-terminal-border pb-10">
          <ul id="toc-list-mobile" class="space-y-6 text-[15px] font-medium text-terminal-secondary relative">
            {groupedToc.map(group => (
              <li class="toc-item toc-h2-item flex flex-col relative w-full" data-h2={group.heading.slug}>
                <div class="flex items-center justify-between gap-4">
                  <a
                    href={`#${group.heading.slug}`}
                    class="toc-link block w-full text-terminal-secondary hover:text-emerald-400 transition-colors py-0.5 text-[15px]"
                  >{group.heading.text}</a>
                  <span class="toc-marker w-2 h-2 rounded-full border border-terminal-border-subtle bg-terminal-bg absolute -left-[14px] top-[10px]"></span>
                </div>
                {group.children.length > 0 && (
                  <ul class="toc-h3-group pl-6 mt-2 space-y-3">
                    {group.children.map(child => (
                      <li class="toc-item toc-h3-item flex items-center justify-between gap-4 relative w-full" data-h3={child.slug}>
                        <a
                          href={`#${child.slug}`}
                          class="toc-link block w-full text-terminal-secondary hover:text-emerald-400 transition-colors py-0.5 text-sm"
                        >{child.text}</a>
                        <span class="toc-marker w-2 h-2 rounded-full border border-terminal-border-subtle bg-terminal-bg absolute -left-[20px] top-[10px]"></span>
                      </li>
                    ))}
                  </ul>
                )}
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>

    <div class="hidden lg:block">
      <button
        id="show-toc-btn"
        title="Mostrar índice"
        class="fixed right-6 top-32 z-40 hidden items-center gap-2 px-4 py-2.5 rounded-xl bg-terminal-surface/90 border border-terminal-border text-terminal-secondary hover:text-emerald-400 hover:border-emerald-500/30 hover:bg-emerald-500/5 transition-all shadow-xl backdrop-blur-sm cursor-pointer font-medium text-xs font-mono tracking-wider uppercase"
      >
        <svg class="w-4 h-4 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178z" />
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
        </svg>
        Mostrar índice
      </button>
    </div>

    <script is:inline>
      document.addEventListener("DOMContentLoaded", () => {
        const container = document.getElementById("article-content");
        if (!container) return;

        // Envolver tablas para que sean responsive en móviles
        const tables = container.querySelectorAll("table");
        tables.forEach((table) => {
          const wrapper = document.createElement("div");
          wrapper.className = "overflow-x-auto my-8 border border-terminal-border/80 rounded-xl bg-terminal-surface/20 max-w-full [scrollbar-width:thin] [&::-webkit-scrollbar]:h-1.5 [&::-webkit-scrollbar-track]:bg-terminal-bg [&::-webkit-scrollbar-thumb]:bg-terminal-border [&::-webkit-scrollbar-thumb]:rounded-full";
          if (table.parentNode) {
            table.parentNode.insertBefore(wrapper, table);
            wrapper.appendChild(table);
          }
        });

        // --- Gestión de Visibilidad del TOC (Ocultar/Mostrar) ---
        const hideBtn = document.getElementById("hide-toc-btn");
        const showBtn = document.getElementById("show-toc-btn");
        const desktopToc = document.getElementById("desktop-toc-container");

        const updateTocState = (isHidden) => {
          if (isHidden) {
            if (desktopToc) {
              desktopToc.classList.add("opacity-0", "scale-95", "pointer-events-none");
              setTimeout(() => {
                desktopToc.style.display = "none";
              }, 300);
            }
            if (showBtn) {
              showBtn.classList.remove("hidden");
              showBtn.classList.add("flex");
            }
          } else {
            if (desktopToc) {
              desktopToc.style.display = "block";
              setTimeout(() => {
                desktopToc.classList.remove("opacity-0", "scale-95", "pointer-events-none");
              }, 10);
            }
            if (showBtn) {
              showBtn.classList.add("hidden");
              showBtn.classList.remove("flex");
            }
          }
        };

        if (hideBtn) {
          hideBtn.addEventListener("click", () => {
            localStorage.setItem("toc-pref", "hidden");
            updateTocState(true);
          });
        }

        if (showBtn) {
          showBtn.addEventListener("click", () => {
            localStorage.setItem("toc-pref", "visible");
            updateTocState(false);
          });
        }

        // Inicializar según preferencia guardada
        const savedPref = localStorage.getItem("toc-pref");
        if (savedPref === "hidden") {
          updateTocState(true);
        }
        // --------------------------------------------------------

        // Los headings ya están pre-renderizados en el servidor, solo los seleccionamos
        const headings = container.querySelectorAll("h2, h3");

        // Barra de progreso de lectura
        const progressBar = document.getElementById("reading-progress");
        if (progressBar) {
          const updateProgress = () => {
            const articleEl = document.getElementById("article-content");
            if (!articleEl) return;
            const articleTop = articleEl.getBoundingClientRect().top + window.scrollY;
            const articleHeight = articleEl.scrollHeight;
            const scrolled = window.scrollY - articleTop;
            const progress = Math.min(100, Math.max(0, (scrolled / (articleHeight - window.innerHeight)) * 100));
            progressBar.style.width = `${progress}%`;
            progressBar.setAttribute("aria-valuenow", Math.round(progress));
          };
          window.addEventListener("scroll", updateProgress, { passive: true });
          updateProgress(); // Estado inicial
        }

        const links = document.querySelectorAll(".toc-link");
        const activeSections = new Set();
        let lastActiveId = "";

        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                activeSections.add(entry.target.id);
              } else {
                activeSections.delete(entry.target.id);
              }
            });

            let currentActiveId = "";
            if (activeSections.size > 0) {
              for (const heading of headings) {
                if (activeSections.has(heading.id)) {
                  currentActiveId = heading.id;
                  break;
                }
              }
            }

            if (!currentActiveId && lastActiveId) {
              currentActiveId = lastActiveId;
            }

            if (currentActiveId && currentActiveId !== lastActiveId) {
              lastActiveId = currentActiveId;

              // Acordeón: abrir el grupo H3 del H2 activo, cerrar los demás
              const activeHeadingEl = document.getElementById(currentActiveId);
              // Buscar el H2 padre del heading activo (puede ser él mismo o su ancestro)
              let activeH2Id = currentActiveId;
              if (activeHeadingEl && activeHeadingEl.tagName.toLowerCase() === 'h3') {
                // Buscar el H2 anterior en el DOM
                let prev = activeHeadingEl.previousElementSibling;
                while (prev) {
                  if (prev.tagName.toLowerCase() === 'h2') {
                    activeH2Id = prev.id;
                    break;
                  }
                  prev = prev.previousElementSibling;
                }
              }

              document.querySelectorAll('.toc-h2-item').forEach(h2item => {
                const h2Slug = h2item.getAttribute('data-h2');
                const h3Group = h2item.querySelector('.toc-h3-group');
                if (h3Group) {
                  if (h2Slug === activeH2Id) {
                    h3Group.classList.add('open');
                  } else {
                    h3Group.classList.remove('open');
                  }
                }
              });
              
              links.forEach((link) => {
                const href = link.getAttribute("href");
                if (href === `#${currentActiveId}`) {
                  link.classList.add("active");
                  
                  // Scroll-follow: centra el ítem activo en el contenedor del TOC
                  const activeItem = link.closest(".toc-item");
                  const isDesktop = link.closest("#toc-list") !== null;
                  const scrollContainer = isDesktop 
                    ? document.getElementById("sidebar-scroll-container")
                    : document.getElementById("mobile-toc-drawer");
                  
                  if (activeItem && scrollContainer) {
                    const containerHeight = scrollContainer.clientHeight;
                    const itemOffsetTop = activeItem.getBoundingClientRect().top
                      - scrollContainer.getBoundingClientRect().top
                      + scrollContainer.scrollTop;
                    const itemHeight = activeItem.clientHeight;
                    // Posicionar el ítem en el centro del contenedor, ligeramente más abajo
                    const targetScroll = itemOffsetTop - (containerHeight / 2) + (itemHeight / 2) + 40;
                    scrollContainer.scrollTo({
                      top: Math.max(0, targetScroll),
                      behavior: "smooth"
                    });
                  }
                } else {
                  link.classList.remove("active");
                }
              });
            }
          },
          { root: null, rootMargin: "-10% 0px -75% 0px", threshold: 0 }
        );

        headings.forEach((h) => observer.observe(h));

        // Scroll suave con offset inteligente al hacer click en un enlace del TOC
        // Evita que el título quede pegado al borde superior de la pantalla
        const SCROLL_OFFSET = 60;
        document.querySelectorAll(".toc-link").forEach((link) => {
          link.addEventListener("click", (e) => {
            e.preventDefault();
            const targetId = link.getAttribute("href")?.slice(1);
            const targetEl = targetId ? document.getElementById(targetId) : null;
            if (targetEl) {
              const y = targetEl.getBoundingClientRect().top + window.scrollY - SCROLL_OFFSET;
              window.scrollTo({ top: y, behavior: "smooth" });
              // Actualizar la URL sin recargar la página
              history.pushState(null, "", `#${targetId}`);
            }
          });
        });

        // Reset del TOC al volver al tope de la página
        const resetTocScroll = () => {
          const sidebar = document.getElementById("sidebar-scroll-container");
          if (sidebar) sidebar.scrollTo({ top: 0, behavior: "smooth" });
        };

        // Detectar cuando el usuario llega al tope por scroll
        let tocResetCooldown = false;
        window.addEventListener("scroll", () => {
          if (window.scrollY < 80 && !tocResetCooldown) {
            tocResetCooldown = true;
            resetTocScroll();
            setTimeout(() => { tocResetCooldown = false; }, 1000);
          }
        }, { passive: true });

        // Detectar clic en el botón back-to-top para resetear el TOC
        const backToTopBtn = document.getElementById("back-to-top");
        if (backToTopBtn) {
          backToTopBtn.addEventListener("click", resetTocScroll);
        }

        const mBtn = document.getElementById("mobile-toc-btn");
        const mModal = document.getElementById("mobile-toc-modal");
        const mDrawer = document.getElementById("mobile-toc-drawer");
        const mobileList = document.getElementById("toc-list-mobile");
        const mClose = document.getElementById("close-mobile-toc");

        const closeMobileToc = () => {
          if (mModal && mDrawer) {
            mModal.classList.add("pointer-events-none", "opacity-0");
            mDrawer.classList.add("translate-y-full");
          }
        };

        if (mBtn && mModal && mDrawer) {
          mBtn.addEventListener("click", () => {
            mModal.classList.remove("pointer-events-none", "opacity-0");
            mDrawer.classList.remove("translate-y-full");
          });
          if (mClose) mClose.addEventListener("click", closeMobileToc);
          mModal.addEventListener("click", (e) => {
            if (e.target === mModal) closeMobileToc();
          });
        }

        // Cerrar modal móvil al hacer click en un enlace del TOC móvil
        if (mobileList) {
          mobileList.addEventListener("click", (e) => {
            if (e.target.closest(".toc-link")) {
              closeMobileToc();
            }
          });
        }
      });
    </script>
</Layout>
