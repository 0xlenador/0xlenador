---
import { getBlogPostsByLang } from "../../lib/content"
import Layout from "../../layouts/Layout.astro"
import BlogArticleView from "../../components/views/BlogArticleView.astro"

// 1. Generar rutas solo para posts en español
export async function getStaticPaths() {
  const posts = await getBlogPostsByLang("es")
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }))
}

const { post } = Astro.props
const { title, description, keywords, date, coverImage } = post.data

const ogImage = coverImage?.src

// Schema.org BlogPosting para SEO estructurado
const blogSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: title,
  description,
  datePublished: new Date(date).toISOString(),
  author: {
    "@type": "Person",
    name: "0xLeñador",
    url: new URL("/autor", Astro.site).href,
  },
  publisher: {
    "@type": "Organization",
    name: "0xLeñador",
    url: "https://0xlenador.xyz",
  },
  image: ogImage ? new URL(ogImage, "https://0xlenador.xyz").href : undefined,
  mainEntityOfPage: {
    "@type": "WebPage",
    "@id": new URL(Astro.url.pathname, Astro.site).href,
  },
}

const translationSlug = post.data.translationSlug
// Trailing slash explícito: garantiza consistencia con el canonical aunque alguien
// modifique el Layout. El fallback EN apunta al mismo slug si no hay traducción.
const esUrl = `/blog/${post.slug}/`
const enUrl = translationSlug ? `/en/blog/${translationSlug}/` : `/en/blog/${post.slug}/`
---

<Layout
  title={`${title} | 0xLeñador`}
  description={description}
  keywords={keywords}
  ogType="article"
  image={ogImage}
  schema={blogSchema}
  publishedTime={new Date(date).toISOString()}
  author="0xLeñador"
  esUrl={esUrl}
  enUrl={enUrl}
>
  <BlogArticleView post={post} />
</Layout>
