---
/**
 * SocialLinks.astro — Íconos y enlaces a redes sociales de 0xLeñador.
 * Fuente única de verdad para todos los SVGs sociales del sitio
 * (Navbar, Footer, etc.), evitando duplicación.
 *
 * @prop variant - "icon-only" | "with-label"
 * @prop size    - "sm" (12px) | "md" (16px) | "lg" (20px)
 * @prop class   - clases adicionales para el wrapper
 */

interface Props {
  variant?: "icon-only" | "with-label"
  size?: "sm" | "md" | "lg"
  class?: string
}

const { variant = "with-label", size = "sm", class: className = "" } = Astro.props

const sizeMap: Record<string, string> = {
  sm: "w-3 h-3",
  md: "w-4 h-4",
  lg: "w-5 h-5",
}

const iconClass = sizeMap[size] ?? sizeMap.sm

const links = [
  {
    label: "YouTube",
    href: "https://www.youtube.com/@0xlenador000",
    svgPath:
      "M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z",
  },
  {
    label: "Telegram",
    href: "https://t.me/zero0xlenador",
    svgPath:
      "M11.944 0C5.346 0 0 5.346 0 11.944s5.346 11.944 11.944 11.944 11.944-5.346 11.944-11.944S18.542 0 11.944 0zm5.206 8.19l-1.78 8.385c-.134.6-.49.746-.994.464l-2.712-2.002-1.308 1.258c-.144.144-.265.265-.544.265l.195-2.766 5.035-4.547c.218-.195-.048-.304-.338-.11l-6.224 3.92-2.68-.838c-.58-.182-.593-.58.122-.857l10.475-4.037c.484-.182.908.108.76.81z",
  },
  {
    label: "X (Twitter)",
    href: "https://x.com/0xlenador",
    svgPath:
      "M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z",
  },
]
---

<div class:list={["flex flex-col gap-3", className]}>
  {
    links.map(({ label, href, svgPath }) => (
      <a
        href={href}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={label}
        class="flex items-center gap-2 text-terminal-muted hover:text-white text-sm transition group"
      >
        <span class="p-1 bg-terminal-surface rounded group-hover:bg-emerald-500/20 transition">
          <svg class={iconClass} fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path d={svgPath} />
          </svg>
        </span>
        {variant === "with-label" && label}
      </a>
    ))
  }
</div>
