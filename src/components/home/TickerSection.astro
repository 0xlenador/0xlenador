---
/**
 * TickerSection.astro — Carrusel infinito (Marquee) de precios
 * Extrae datos en vivo de la API de CoinGecko
 */
import { getLangFromUrl, useTranslations, getLocalizedPath } from "../../i18n";

const dataFiles = import.meta.glob("../../content/data/watchlist/*.json", { eager: true });
const assets = Object.values(dataFiles)
  .filter((file: any) => file.default && file.default.price && file.default.price.apiUrl)
  .map((file: any) => {
    const data = file.default
    const apiUrl = data.price.apiUrl || ""

    let coinId = ""
    if (apiUrl.includes("/simple/price")) {
      const match = apiUrl.match(/ids=([^&]+)/)
      if (match) coinId = match[1]
    } else if (apiUrl.includes("/nfts/")) {
      coinId = apiUrl.split("/").pop()
    }

    return {
      id: coinId || data.id,
      ticker: data.ticker,
      nombre: data.name,
      imagen: data.image,
      isNft: apiUrl.includes("/nfts/"),
      href: `/activos/${data.id}`,
    }
  })

const count = assets.length
const isMarqueeDesktop = count > 5
const isMarqueeMobile = count > 3

// Solo duplicamos el array si necesitamos el carrusel en alguna vista
const displayAssets = isMarqueeDesktop || isMarqueeMobile ? [...assets, ...assets] : assets

const animationClass = isMarqueeDesktop
  ? "animate-marquee-all"
  : isMarqueeMobile
    ? "animate-marquee-mobile"
    : "justify-center";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section
  class="w-full mt-0 mb-16 bg-[#0A0D10] shadow-[0_-4px_25px_rgba(6,182,212,0.15)] overflow-hidden py-10 border-y border-terminal-border/20"
>
  <div class="max-w-6xl mx-auto px-6 text-center mb-8">
    <h2 class="text-2xl md:text-3xl font-bold text-white tracking-tight">
      {t('ticker.title')}
    </h2>
    <p class="text-terminal-secondary text-sm mt-3 max-w-2xl mx-auto leading-relaxed">
      {t('ticker.desc')}
    </p>
  </div>

  <div class="relative overflow-hidden py-2 group">
    <!-- Overlay degradado para suavizar los bordes del marquee -->
    <div
      class="absolute top-0 bottom-0 left-0 w-16 md:w-32 bg-gradient-to-r from-[#0A0D10] to-transparent z-10 pointer-events-none"
    >
    </div>
    <div
      class="absolute top-0 bottom-0 right-0 w-16 md:w-32 bg-gradient-to-l from-[#0A0D10] to-transparent z-10 pointer-events-none"
    >
    </div>

    <!-- Pista animada o estática -->
    <div
      class={`flex gap-3 md:gap-8 min-w-max hover:[animation-play-state:paused] px-4 mx-auto w-fit ${animationClass}`}
    >
      {
        displayAssets.map((asset, index) => {
          const isDuplicate = index >= count
          // Si es un duplicado pero en Desktop NO hay carrusel, lo ocultamos en Desktop (md:hidden)
          const duplicateClass = isDuplicate && !isMarqueeDesktop ? "flex md:hidden" : "flex"

          // Clases condicionales responsivas basadas en si el carrusel móvil está activo o no
          const cardClass = isMarqueeMobile
            ? "w-[60vw] sm:w-[220px] md:w-[250px] flex-row justify-between p-4 md:p-6"
            : "w-[28vw] sm:w-[220px] md:w-[250px] flex-col sm:flex-row items-center sm:justify-between justify-center text-center sm:text-left p-3 sm:p-4 md:p-6"

          const innerLayoutClass = isMarqueeMobile
            ? "flex items-center gap-3"
            : "flex flex-col sm:flex-row items-center gap-1.5 sm:gap-3"

          const imageSizeClass = isMarqueeMobile ? "w-10 h-10" : "w-8 h-8 sm:w-10 sm:h-10"

          const textLayoutClass = isMarqueeMobile
            ? "flex flex-col items-start"
            : "flex flex-col items-center sm:items-start"

          const tickerClass = isMarqueeMobile
            ? "text-sm md:text-base font-bold leading-none"
            : "text-xs sm:text-sm md:text-base font-bold leading-none"

          const nameClass = isMarqueeMobile
            ? "text-terminal-secondary text-[10px] md:text-xs uppercase font-mono mt-1"
            : "hidden sm:inline-block text-terminal-secondary text-[10px] md:text-xs uppercase font-mono mt-1"

          const priceWrapperClass = isMarqueeMobile
            ? "text-right"
            : "mt-1.5 sm:mt-0 text-center sm:text-right"

          const priceClass = isMarqueeMobile
            ? "price-value font-mono text-lg md:text-xl font-bold text-emerald-400 group-hover/card:text-emerald-300 transition-colors"
            : "price-value font-mono text-sm sm:text-lg md:text-xl font-bold text-emerald-400 group-hover/card:text-emerald-300 transition-colors"

          return (
            <a
              href={asset.href}
              class={`${duplicateClass} ${cardClass} flex shrink-0 bg-terminal-elevated/20 border border-terminal-border/40 rounded-2xl transition-colors hover:border-cyan-500/30 hover:bg-terminal-elevated/40 group/card cursor-pointer no-underline`}
            >
              <div class={innerLayoutClass}>
                <img
                  src={asset.imagen}
                  alt={asset.nombre}
                  class={`${imageSizeClass} rounded-full object-contain`}
                  loading="lazy"
                />
                <div class={textLayoutClass}>
                  <span class={`text-white leading-none ${tickerClass}`}>{asset.ticker}</span>
                  <span class={nameClass}>{asset.nombre}</span>
                </div>
              </div>
              <div class={priceWrapperClass}>
                <span
                  class={priceClass}
                  data-coin-id={asset.id}
                  data-is-nft={asset.isNft ? "true" : "false"}
                >
                  $---
                </span>
              </div>
            </a>
          )
        })
      }
    </div>
  </div>

  <div class="mt-8 text-center">
    <a
      href={getLocalizedPath("/activos", lang)}
      class="inline-flex items-center gap-2 text-xs md:text-sm font-mono text-emerald-500/80 hover:text-emerald-400 uppercase tracking-widest transition-colors group/btn"
    >
      {t('ticker.cta')}
      <span class="group-hover/btn:translate-x-1 transition-transform duration-300"></span>
    </a>
  </div>
</section>

<style>
  @keyframes marquee {
    0% {
      transform: translateX(0);
    }
    100% {
      /* Se desplaza exactamente la mitad del ancho total del track animado para hacer un loop perfecto con el array duplicado */
      transform: translateX(-50%);
    }
  }

  /* Cuando hay más de 5 activos (desktop + mobile) */
  .animate-marquee-all {
    animation: marquee 40s linear infinite;
  }

  /* Cuando hay entre 4-5 activos (solo aplica en móvil) */
  .animate-marquee-mobile {
    animation: marquee 30s linear infinite;
  }

  /* En móviles las animaciones van un poco más rápido */
  @media (max-width: 768px) {
    .animate-marquee-all {
      animation-duration: 30s;
    }
    .animate-marquee-mobile {
      animation-duration: 22s;
    }
  }

  /* Respetar prefers-reduced-motion */
  @media (prefers-reduced-motion: reduce) {
    .animate-marquee-all,
    .animate-marquee-mobile {
      animation-play-state: paused;
    }
  }
</style>

<script>
  const CACHE_KEY = "ticker_prices_v2"
  const CACHE_TTL = 5 * 60 * 1000 // 5 minutos en ms

  function getCached(): Record<string, number> | null {
    try {
      const raw = sessionStorage.getItem(CACHE_KEY)
      if (!raw) return null
      const { ts, data } = JSON.parse(raw) as { ts: number; data: Record<string, number> }
      if (Date.now() - ts > CACHE_TTL) {
        sessionStorage.removeItem(CACHE_KEY)
        return null
      }
      return data
    } catch {
      return null
    }
  }

  function setCache(data: Record<string, number>) {
    try {
      sessionStorage.setItem(CACHE_KEY, JSON.stringify({ ts: Date.now(), data }))
    } catch {
      /* quota excedida */
    }
  }

  function applyPrices(prices: Record<string, number>) {
    document.querySelectorAll<HTMLElement>(".price-value").forEach((el) => {
      const id = el.getAttribute("data-coin-id") ?? ""
      const price = prices[id]
      if (price == null) return

      const fmt = (n: number) =>
        n >= 100
          ? n.toLocaleString("en-US", {
              style: "currency",
              currency: "USD",
              minimumFractionDigits: 0,
              maximumFractionDigits: 0,
            })
          : n < 0.01
            ? "$" + n.toPrecision(4)
            : n.toLocaleString("en-US", {
                style: "currency",
                currency: "USD",
                minimumFractionDigits: 2,
                maximumFractionDigits: 4,
              })

      el.textContent = fmt(price)
      el.classList.remove("animate-pulse")
    })
  }

  async function fetchPrices() {
    // 1. Intentar servir desde caché
    const cached = getCached()
    if (cached) {
      applyPrices(cached)
      return
    }

    const elements = document.querySelectorAll<HTMLElement>(".price-value")
    const coinIds = new Set<string>()
    const nftIds = new Set<string>()

    elements.forEach((el) => {
      const id = el.getAttribute("data-coin-id") ?? ""
      if (el.getAttribute("data-is-nft") === "true") nftIds.add(id)
      else coinIds.add(id)
    })

    if (coinIds.size === 0 && nftIds.size === 0) return

    const prices: Record<string, number> = {}
    let btcUsd = 0

    // 2. Fetch de tokens normales (batch)
    if (coinIds.size > 0) {
      try {
        const res = await fetch(
          `https://api.coingecko.com/api/v3/simple/price?ids=${[...coinIds].join(",")}&vs_currencies=usd`,
        )
        const data = (await res.json()) as Record<string, { usd: number }>
        for (const [id, val] of Object.entries(data)) {
          prices[id] = val.usd
          if (id === "bitcoin") btcUsd = val.usd
        }
      } catch (err) {
        console.error("CoinGecko tokens:", err)
      }
    }

    // 3. Fetch de NFTs (secuencial — API no permite batch)
    for (const nftId of nftIds) {
      try {
        const res = await fetch(`https://api.coingecko.com/api/v3/nfts/${nftId}`)
        const data = (await res.json()) as {
          floor_price?: { usd?: number; native_currency?: number }
        }
        const usd =
          data.floor_price?.usd ??
          (data.floor_price?.native_currency && btcUsd > 0
            ? data.floor_price.native_currency * btcUsd
            : 0)
        if (usd > 0) prices[nftId] = usd
      } catch (err) {
        console.error(`CoinGecko NFT ${nftId}:`, err)
      }
    }

    // 4. Aplicar precios y guardar en caché
    applyPrices(prices)
    if (Object.keys(prices).length > 0) setCache(prices)

    // 5. Marcar como N/A los que fallaron
    elements.forEach((el) => {
      if (el.textContent === "$---") {
        el.textContent = "N/A"
        el.classList.remove("text-emerald-400")
        el.classList.add("text-terminal-muted")
      }
    })
  }

  document.addEventListener("astro:page-load", fetchPrices)
  if (document.readyState === "complete" || document.readyState === "interactive") {
    fetchPrices()
  } else {
    document.addEventListener("DOMContentLoaded", fetchPrices)
  }
</script>
