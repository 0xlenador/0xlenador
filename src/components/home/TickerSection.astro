---
/**
 * TickerSection.astro — Carrusel infinito (Marquee) de precios
 * Extrae datos en vivo de la API de CoinGecko
 */

const dataFiles = import.meta.glob("../../data/*.json", { eager: true });
const assets = Object.values(dataFiles)
  .filter(
    (file: any) =>
      file.default && file.default.price && file.default.price.apiUrl,
  )
  .map((file: any) => {
    const data = file.default;
    const apiUrl = data.price.apiUrl || "";

    let coinId = "";
    if (apiUrl.includes("/simple/price")) {
      const match = apiUrl.match(/ids=([^&]+)/);
      if (match) coinId = match[1];
    } else if (apiUrl.includes("/nfts/")) {
      coinId = apiUrl.split("/").pop();
    }

    return {
      id: coinId || data.id,
      ticker: data.ticker,
      nombre: data.name,
      imagen: data.image,
      isNft: apiUrl.includes("/nfts/"),
      href: `/${data.id}`,
    };
  });

const count = assets.length;
const isMarqueeDesktop = count > 5;
const isMarqueeMobile = count > 3;

// Solo duplicamos el array si necesitamos el carrusel en alguna vista
const displayAssets =
  isMarqueeDesktop || isMarqueeMobile ? [...assets, ...assets] : assets;

const animationClass = isMarqueeDesktop
  ? "animate-marquee-all"
  : isMarqueeMobile
    ? "animate-marquee-mobile"
    : "justify-center";
---

<section
  class="w-full mt-0 mb-16 bg-[#0A0D10] shadow-[0_-4px_25px_rgba(6,182,212,0.15)] overflow-hidden py-10 border-y border-terminal-border/20"
>
  <div class="max-w-6xl mx-auto px-6 text-center mb-8">
    <h2 class="text-2xl md:text-3xl font-bold text-white tracking-tight">
      Watchlist de activos en observación
    </h2>
    <p
      class="text-terminal-secondary text-sm mt-3 max-w-2xl mx-auto leading-relaxed"
    >
      Seguimiento algorítmico y en tiempo real. Entender la volatilidad del
      mercado es el primer paso para ejecutar operaciones con frialdad
      matemática.
    </p>
  </div>

  <div class="relative overflow-hidden py-2 group">
    <!-- Overlay degradado para suavizar los bordes del marquee -->
    <div
      class="absolute top-0 bottom-0 left-0 w-16 md:w-32 bg-gradient-to-r from-[#0A0D10] to-transparent z-10 pointer-events-none"
    >
    </div>
    <div
      class="absolute top-0 bottom-0 right-0 w-16 md:w-32 bg-gradient-to-l from-[#0A0D10] to-transparent z-10 pointer-events-none"
    >
    </div>

    <!-- Pista animada o estática -->
    <div
      class={`flex gap-3 md:gap-8 min-w-max hover:[animation-play-state:paused] px-4 mx-auto w-fit ${animationClass}`}
    >
      {
        displayAssets.map((asset, index) => {
          const isDuplicate = index >= count;
          // Si es un duplicado pero en Desktop NO hay carrusel, lo ocultamos en Desktop (md:hidden)
          const duplicateClass =
            isDuplicate && !isMarqueeDesktop ? "flex md:hidden" : "flex";

          // Clases condicionales responsivas basadas en si el carrusel móvil está activo o no
          const cardClass = isMarqueeMobile
            ? "w-[60vw] sm:w-[220px] md:w-[250px] flex-row justify-between p-4 md:p-6"
            : "w-[28vw] sm:w-[220px] md:w-[250px] flex-col sm:flex-row items-center sm:justify-between justify-center text-center sm:text-left p-3 sm:p-4 md:p-6";

          const innerLayoutClass = isMarqueeMobile
            ? "flex items-center gap-3"
            : "flex flex-col sm:flex-row items-center gap-1.5 sm:gap-3";

          const imageSizeClass = isMarqueeMobile
            ? "w-10 h-10"
            : "w-8 h-8 sm:w-10 sm:h-10";

          const textLayoutClass = isMarqueeMobile
            ? "flex flex-col items-start"
            : "flex flex-col items-center sm:items-start";

          const tickerClass = isMarqueeMobile
            ? "text-sm md:text-base font-bold leading-none"
            : "text-xs sm:text-sm md:text-base font-bold leading-none";

          const nameClass = isMarqueeMobile
            ? "text-terminal-secondary text-[10px] md:text-xs uppercase font-mono mt-1"
            : "hidden sm:inline-block text-terminal-secondary text-[10px] md:text-xs uppercase font-mono mt-1";

          const priceWrapperClass = isMarqueeMobile
            ? "text-right"
            : "mt-1.5 sm:mt-0 text-center sm:text-right";

          const priceClass = isMarqueeMobile
            ? "price-value font-mono text-lg md:text-xl font-bold text-emerald-400 group-hover/card:text-emerald-300 transition-colors"
            : "price-value font-mono text-sm sm:text-lg md:text-xl font-bold text-emerald-400 group-hover/card:text-emerald-300 transition-colors";

          return (
            <a
              href={asset.href}
              class={`${duplicateClass} ${cardClass} flex shrink-0 bg-terminal-elevated/20 border border-terminal-border/40 rounded-2xl transition-colors hover:border-cyan-500/30 hover:bg-terminal-elevated/40 group/card cursor-pointer no-underline`}
            >
              <div class={innerLayoutClass}>
                <img
                  src={asset.imagen}
                  alt={asset.nombre}
                  class={`${imageSizeClass} rounded-full object-contain`}
                  loading="lazy"
                />
                <div class={textLayoutClass}>
                  <span class={`text-white leading-none ${tickerClass}`}>
                    {asset.ticker}
                  </span>
                  <span class={nameClass}>
                    {asset.nombre}
                  </span>
                </div>
              </div>
              <div class={priceWrapperClass}>
                <span
                  class={priceClass}
                  data-coin-id={asset.id}
                  data-is-nft={asset.isNft ? "true" : "false"}
                >
                  $---
                </span>
              </div>
            </a>
          );
        })
      }
    </div>
  </div>

  <div class="mt-8 text-center">
    <a
      href="/activos"
      class="inline-flex items-center gap-2 text-xs md:text-sm font-mono text-emerald-500/80 hover:text-emerald-400 uppercase tracking-widest transition-colors group/btn"
    >
      > Ver más...
      <span
        class="group-hover/btn:translate-x-1 transition-transform duration-300"
        >→</span
      >
    </a>
  </div>
</section>

<style>
  @keyframes marquee {
    0% {
      transform: translateX(0);
    }
    100% {
      /* Se desplaza exactamente la mitad del ancho total del track animado para hacer un loop perfecto con el array duplicado */
      transform: translateX(-50%);
    }
  }

  .animate-marquee {
    animation: marquee 40s linear infinite;
  }

  /* En móviles va un poco más rápido */
  @media (max-width: 768px) {
    .animate-marquee {
      animation-duration: 30s;
    }
  }
</style>

<script>
  // Obtenemos los precios desde el cliente al cargar el componente
  async function fetchPrices() {
    const elements = document.querySelectorAll(".price-value");
    const coinIds = new Set();
    const nftIds = new Set();

    elements.forEach((el) => {
      if (el.getAttribute("data-is-nft") === "true") {
        nftIds.add(el.getAttribute("data-coin-id"));
      } else {
        coinIds.add(el.getAttribute("data-coin-id"));
      }
    });

    if (coinIds.size === 0 && nftIds.size === 0) return;

    let btcUsd = 0;

    // 1. Fetch de tokens normales
    if (coinIds.size > 0) {
      try {
        const response = await fetch(
          `https://api.coingecko.com/api/v3/simple/price?ids=${Array.from(coinIds).join(",")}&vs_currencies=usd`,
        );
        const data = await response.json();

        // Guardamos el precio de BTC para conversiones de NFTs de Ordinals
        if (data.bitcoin && data.bitcoin.usd) {
          btcUsd = data.bitcoin.usd;
        }

        elements.forEach((el) => {
          if (el.getAttribute("data-is-nft") !== "true") {
            const id = el.getAttribute("data-coin-id");
            if (data[id] && data[id].usd) {
              const price = data[id].usd;
              const formattedPrice =
                price >= 100
                  ? price.toLocaleString("en-US", {
                      style: "currency",
                      currency: "USD",
                      minimumFractionDigits: 0,
                      maximumFractionDigits: 0,
                    })
                  : price < 0.01
                    ? "$" + price.toPrecision(4)
                    : price.toLocaleString("en-US", {
                        style: "currency",
                        currency: "USD",
                        minimumFractionDigits: 2,
                        maximumFractionDigits: 4,
                      });

              el.textContent = formattedPrice;
            }
          }
        });
      } catch (error) {
        console.error("Error fetching coin prices from CoinGecko:", error);
      }
    }

    // 2. Fetch de NFTs (ej. Runestone)
    for (const nftId of nftIds) {
      try {
        const response = await fetch(
          `https://api.coingecko.com/api/v3/nfts/${nftId}`,
        );
        const data = await response.json();

        let nftUsdPrice = 0;

        if (data.floor_price && data.floor_price.usd) {
          nftUsdPrice = data.floor_price.usd;
        } else if (
          data.floor_price &&
          data.floor_price.native_currency &&
          btcUsd > 0
        ) {
          // Si por defecto viene en BTC y no hay USD, hacemos la conversión manual
          nftUsdPrice = data.floor_price.native_currency * btcUsd;
        }

        if (nftUsdPrice > 0) {
          elements.forEach((el) => {
            if (
              el.getAttribute("data-coin-id") === nftId &&
              el.getAttribute("data-is-nft") === "true"
            ) {
              const formattedPrice =
                nftUsdPrice >= 100
                  ? nftUsdPrice.toLocaleString("en-US", {
                      style: "currency",
                      currency: "USD",
                      minimumFractionDigits: 0,
                      maximumFractionDigits: 0,
                    })
                  : nftUsdPrice < 0.01
                    ? "$" + nftUsdPrice.toPrecision(4)
                    : nftUsdPrice.toLocaleString("en-US", {
                        style: "currency",
                        currency: "USD",
                        minimumFractionDigits: 2,
                        maximumFractionDigits: 4,
                      });
              el.textContent = formattedPrice;
            }
          });
        }
      } catch (error) {
        console.error(`Error fetching NFT price for ${nftId}:`, error);
      }
    }

    // Marcar como N/A los que fallaron
    elements.forEach((el) => {
      if (el.textContent === "$---") {
        el.textContent = "N/A";
        el.classList.remove("text-emerald-400");
        el.classList.add("text-terminal-muted");
      }
    });
  }

  // Ejecutar al cargar y al cambiar de página (por las ViewTransitions de Astro)
  document.addEventListener("astro:page-load", fetchPrices);
  if (
    document.readyState === "complete" ||
    document.readyState === "interactive"
  ) {
    fetchPrices();
  } else {
    document.addEventListener("DOMContentLoaded", fetchPrices);
  }
</script>
