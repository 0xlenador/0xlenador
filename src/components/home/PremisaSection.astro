---
/**
 * PremisaSection.astro — Sección de "Nuestra Premisa" con cita y terminal.
 * Contenido estático de filosofía de inversión.
 */
import { getLangFromUrl, useTranslations } from "../../i18n/utils"

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)
---

<section class="grid grid-cols-1 md:grid-cols-2 gap-16 mb-40 items-center">
  <div class="space-y-8">
    <div class="inline-block px-3 py-1 bg-emerald-500/10 border border-emerald-500/20 rounded-full">
      <span class="text-[10px] font-mono text-emerald-500 uppercase tracking-[0.3em]"
        >{t("component.premisa.badge")}</span
      >
    </div>
    <h2 class="text-3xl md:text-4xl font-bold text-white tracking-tight leading-tight">
      {t("component.premisa.heading")} <br /> <span class="italic text-terminal-muted"
        >{t("component.premisa.heading.accent")}</span
      >.
    </h2>
    <p class="text-terminal-secondary leading-snug text-lg">
      {t("component.premisa.body")}
    </p>
    <blockquote class="border-l-2 border-emerald-500 pl-6 italic text-terminal-text/80">
      {t("component.premisa.quote")}
    </blockquote>
  </div>

  <div
    class="bg-terminal-surface/20 border border-terminal-border p-10 rounded-[3rem] relative overflow-hidden group"
  >
    <div
      class="absolute -top-24 -right-24 w-64 h-64 bg-emerald-500/5 blur-[100px] group-hover:bg-emerald-500/10 transition-all"
    >
    </div>
    <div class="space-y-6 relative z-10 font-mono">
      <div class="flex justify-between border-b border-terminal-border pb-4">
        <span class="text-terminal-subtle text-xs">{t("component.premisa.terminal.label")}</span>
        <span class="text-emerald-500 text-xs">{t("component.premisa.terminal.status")}</span>
      </div>
      <div class="text-xs space-y-4">
        <p class="text-terminal-muted text-[10px] uppercase">{t("component.premisa.terminal.protocol")}</p>
        <p class="text-terminal-text">{t("component.premisa.terminal.step1")}</p>
        <p class="text-terminal-text">{t("component.premisa.terminal.step2")}</p>
        <p class="text-terminal-text">{t("component.premisa.terminal.step3")}</p>
        <p class="text-terminal-text">{t("component.premisa.terminal.step4")}</p>
      </div>
    </div>
  </div>
</section>
