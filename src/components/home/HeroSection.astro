---
import { Image } from "astro:assets"
import logoImg from "../../assets/img/logo.webp"
import { getLangFromUrl, useTranslations, getLocalizedPath } from "../../i18n/utils"

/**
 * HeroSection.astro
 * Cabecera limpia y directa:
 * - Columna Izquierda: Identidad sin humo, acciones directas a herramientas y bitácora.
 * - Columna Derecha: Tarjeta minimalista premium estilo Apple con accesos a SFL, Yakkamon y Activos.
 */

interface CtaButton {
  texto: string
  href: string
}

interface Props {
  ctaPrimario?: CtaButton
  ctaSecundario?: CtaButton
}

const { ctaPrimario, ctaSecundario } = Astro.props

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)

const primaryCta = ctaPrimario ?? {
  texto: t("home.hero.cta.primary"),
  href: getLocalizedPath("/herramientas", lang),
}

const secondaryCta = ctaSecundario ?? {
  texto: t("home.hero.cta.secondary"),
  href: getLocalizedPath("/operaciones", lang),
}

const quickTools = [
  { nombre: t("home.hero.quick.riskfolio"), href: getLocalizedPath("/riskfolio", lang) },
  { nombre: t("home.hero.quick.intrinseco"), href: getLocalizedPath("/intrinseco", lang) },
  { nombre: t("home.hero.quick.directorio"), href: getLocalizedPath("/directorio", lang) },
]
---

<header class="relative max-w-6xl mx-auto pt-3 pb-8 md:pt-6 md:pb-12">
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-center">
    <!-- ─── COLUMNA IZQUIERDA: IDENTIDAD & HERRAMIENTAS ─── -->
    <div class="lg:col-span-7 flex flex-col justify-center space-y-5 md:space-y-6">
      <!-- Badge de estado sobrio -->
      <div class="flex items-center">
        <div
          class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/[0.04] border border-white/[0.08] text-xs font-mono text-terminal-secondary"
        >
          <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
          <span class="text-[11px] font-medium tracking-wide text-zinc-300">
            {t("home.hero.badge")}
          </span>
        </div>
      </div>

      <!-- Marca / Logo -->
      <div class="flex items-center gap-3">
        <Image
          src={logoImg}
          alt="0x Leñador"
          width={48}
          height={48}
          loading="eager"
          class="w-10 h-10 md:w-11 md:h-11 object-contain shrink-0"
        />
        <span class="text-2xl md:text-3xl font-bold tracking-tight text-white font-mono">
          0x<span class="text-emerald-500">Leñador</span>
        </span>
      </div>

      <!-- Título principal -->
      <h1
        class="text-3xl sm:text-4xl lg:text-5xl font-black text-white tracking-tight leading-[1.12]"
      >
        {t("home.hero.title.prefix")}{" "}
        <span class="text-emerald-400 font-extrabold">
          {t("home.hero.title.highlight")}
        </span>
      </h1>

      <!-- Subtítulo directo -->
      <p class="text-terminal-secondary text-sm md:text-base leading-relaxed max-w-lg">
        {t("home.hero.subtitle")}
      </p>

      <!-- Botones de Acción -->
      <div class="flex flex-wrap items-center gap-3 pt-1">
        <a
          href={primaryCta.href}
          class="px-5 py-2.5 md:px-6 md:py-3 bg-emerald-500 hover:bg-emerald-400 text-black font-bold uppercase tracking-wider text-xs rounded-xl transition-all shadow-[0_0_20px_rgba(16,185,129,0.2)] hover:shadow-[0_0_25px_rgba(16,185,129,0.35)] flex items-center gap-2 no-underline"
        >
          <svg
            class="w-4 h-4 shrink-0"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"
            ></path>
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"
            ></path>
          </svg>
          <span>{primaryCta.texto}</span>
        </a>

        <a
          href={secondaryCta.href}
          class="px-5 py-2.5 md:px-6 md:py-3 border border-terminal-border text-terminal-text hover:text-white font-bold uppercase tracking-wider text-xs rounded-xl hover:bg-terminal-surface hover:border-terminal-secondary/50 transition-all inline-flex items-center gap-2 no-underline"
        >
          <svg
            class="w-4 h-4 text-terminal-muted"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"
            ></path>
          </svg>
          <span>{secondaryCta.texto}</span>
        </a>
      </div>

      <!-- Accesos Directos -->
      <div class="pt-1 flex flex-col sm:flex-row sm:items-center gap-2 sm:gap-3 text-xs">
        <span
          class="text-[10px] font-mono font-bold uppercase tracking-widest text-terminal-subtle shrink-0"
        >
          {t("home.hero.quick.label")}
        </span>
        <div class="flex items-center gap-2 overflow-x-auto pb-1 sm:pb-0 hide-scroll">
          {
            quickTools.map((tool) => (
              <a
                href={tool.href}
                class="px-2.5 py-1 rounded-lg bg-white/[0.03] border border-white/[0.08] hover:border-emerald-500/50 hover:bg-white/[0.06] text-terminal-muted hover:text-white transition-all text-[11px] font-mono tracking-tight whitespace-nowrap flex items-center gap-1.5 no-underline"
              >
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-500/80" />
                <span>{tool.nombre}</span>
              </a>
            ))
          }
        </div>
      </div>
    </div>

    <!-- ─── COLUMNA DERECHA: TARJETA APPLE PREMIUM ─── -->
    <div class="lg:col-span-5 flex flex-col">
      <div
        class="relative rounded-3xl bg-[#161618]/90 border border-white/[0.08] p-5 sm:p-6 backdrop-blur-2xl shadow-[0_20px_50px_rgba(0,0,0,0.6)] flex flex-col justify-between overflow-hidden group"
      >
        <!-- Glow ambiental sutil -->
        <div
          class="absolute -top-24 -right-24 w-52 h-52 bg-emerald-500/10 rounded-full blur-3xl pointer-events-none group-hover:bg-emerald-500/15 transition-all"
        >
        </div>

        <!-- Encabezado de la tarjeta -->
        <div class="flex items-center justify-between mb-4 pb-3 border-b border-white/[0.06]">
          <div class="flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
            <span
              class="text-[11px] font-mono font-bold uppercase tracking-widest text-zinc-400"
            >
              {t("home.hero.apple.header")}
            </span>
          </div>
          <span class="text-[10px] font-mono text-zinc-500 uppercase tracking-wider">
            3 Módulos
          </span>
        </div>

        <!-- Lista de 3 accesos principales -->
        <div class="space-y-3">
          <!-- 1. Sunflower Land -->
          <a
            href={getLocalizedPath("/sfl-mercado", lang)}
            class="group/item flex items-center justify-between p-3.5 rounded-2xl bg-white/[0.03] hover:bg-white/[0.07] border border-white/[0.05] hover:border-white/[0.14] transition-all duration-200 no-underline"
          >
            <div class="flex items-center gap-3.5 min-w-0">
              <img
                src="/img/cripto/sunflowerland.webp"
                alt="Sunflower Land"
                class="w-11 h-11 rounded-xl object-contain bg-black/40 p-1 border border-white/[0.08] group-hover/item:scale-105 transition-transform duration-200 shrink-0"
              />
              <div class="min-w-0">
                <h3
                  class="text-sm font-semibold text-white tracking-tight group-hover/item:text-amber-300 transition-colors truncate"
                >
                  {t("home.hero.apple.sfl.title")}
                </h3>
                <p class="text-xs text-zinc-400 tracking-normal mt-0.5 truncate">
                  {t("home.hero.apple.sfl.desc")}
                </p>
              </div>
            </div>
            <svg
              class="w-4 h-4 text-zinc-500 group-hover/item:text-white group-hover/item:translate-x-0.5 transition-all shrink-0 ml-3"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              viewBox="0 0 24 24"
            >
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"></path>
            </svg>
          </a>

          <!-- 2. Yakkamon -->
          <a
            href={getLocalizedPath("/yakkamon", lang)}
            class="group/item flex items-center justify-between p-3.5 rounded-2xl bg-white/[0.03] hover:bg-white/[0.07] border border-white/[0.05] hover:border-white/[0.14] transition-all duration-200 no-underline"
          >
            <div class="flex items-center gap-3.5 min-w-0">
              <img
                src="/img/cripto/yakkamon.webp"
                alt="Yakkamon"
                class="w-11 h-11 rounded-xl object-contain bg-black/40 p-1 border border-white/[0.08] group-hover/item:scale-105 transition-transform duration-200 shrink-0"
              />
              <div class="min-w-0">
                <h3
                  class="text-sm font-semibold text-white tracking-tight group-hover/item:text-purple-300 transition-colors truncate"
                >
                  {t("home.hero.apple.yakkamon.title")}
                </h3>
                <p class="text-xs text-zinc-400 tracking-normal mt-0.5 truncate">
                  {t("home.hero.apple.yakkamon.desc")}
                </p>
              </div>
            </div>
            <svg
              class="w-4 h-4 text-zinc-500 group-hover/item:text-white group-hover/item:translate-x-0.5 transition-all shrink-0 ml-3"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              viewBox="0 0 24 24"
            >
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"></path>
            </svg>
          </a>

          <!-- 3. Activos -->
          <a
            href={getLocalizedPath("/activos", lang)}
            class="group/item flex items-center justify-between p-3.5 rounded-2xl bg-white/[0.03] hover:bg-white/[0.07] border border-white/[0.05] hover:border-white/[0.14] transition-all duration-200 no-underline"
          >
            <div class="flex items-center gap-3.5 min-w-0">
              <div
                class="w-11 h-11 rounded-xl bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-center text-emerald-400 group-hover/item:scale-105 transition-transform duration-200 shrink-0"
              >
                <svg
                  class="w-5 h-5"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"></path>
                </svg>
              </div>
              <div class="min-w-0">
                <h3
                  class="text-sm font-semibold text-white tracking-tight group-hover/item:text-emerald-400 transition-colors truncate"
                >
                  {t("home.hero.apple.activos.title")}
                </h3>
                <p class="text-xs text-zinc-400 tracking-normal mt-0.5 truncate">
                  {t("home.hero.apple.activos.desc")}
                </p>
              </div>
            </div>
            <svg
              class="w-4 h-4 text-zinc-500 group-hover/item:text-white group-hover/item:translate-x-0.5 transition-all shrink-0 ml-3"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              viewBox="0 0 24 24"
            >
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"></path>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </div>
</header>
