---
/**
 * HeroSection.astro — Header principal de la landing page.
 * Título con gradiente, subtítulo descriptivo y dos CTAs.
 */

interface CtaButton {
  texto: string;
  href: string;
}

interface Props {
  titulo: string;
  tituloHighlight: string;
  subtitulo: string;
  ctaPrimario: CtaButton;
  ctaSecundario: CtaButton;
}

const { titulo, tituloHighlight, subtitulo, ctaPrimario, ctaSecundario } =
  Astro.props;
---

<header
  class="relative max-w-4xl mx-auto mb-32 text-center overflow-hidden py-8 md:py-16"
>
  <h1
    class="relative z-10 text-4xl md:text-5xl font-black text-white mb-8 tracking-tighter uppercase leading-none"
  >
    {titulo}
    <span
      class="bg-gradient-to-r from-emerald-400 to-cyan-400 bg-clip-text text-transparent"
    >
      {tituloHighlight}
    </span>
  </h1>
  <p
    class="relative z-10 text-md md:text-lg text-slate-400 font-light leading-relaxed max-w-2xl mx-auto mb-12"
  >
    {subtitulo}
  </p>
  <div class="relative z-10 flex flex-wrap gap-4 justify-center">
    <a
      href={ctaPrimario.href}
      class="px-8 py-4 bg-gradient-to-r from-emerald-500 to-cyan-500 text-slate-950 font-black uppercase tracking-widest text-xs rounded-xl hover:bg-emerald-500 transition-all italic inline-flex items-center gap-2"
    >
      <svg
        class="w-4 h-4"
        fill="none"
        stroke="currentColor"
        stroke-width="2.5"
        viewBox="0 0 24 24"
        ><path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25"
        ></path></svg
      >
      {ctaPrimario.texto}
    </a>
    <a
      href={ctaSecundario.href}
      class="px-8 py-4 border border-slate-700 text-white font-black uppercase tracking-widest text-xs rounded-xl hover:bg-slate-900 transition-all"
    >
      {ctaSecundario.texto}
    </a>
  </div>
</header>
