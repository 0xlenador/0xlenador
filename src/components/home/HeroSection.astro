---
import { Image } from "astro:assets";

/**
 * HeroSection.astro — Header principal de la landing page.
 * Efecto typewriter/terminal: el H1 muestra "> " fijo al inicio,
 * seguido de texto que se escribe carácter por carácter, simulando
 * una consola ejecutando una tesis de inversión.
 */

interface CtaButton {
  texto: string;
  href: string;
}

interface Props {
  phrases: string[];
  ctaPrimario: CtaButton;
  ctaSecundario: CtaButton;
}

const { phrases, ctaPrimario, ctaSecundario } = Astro.props;

// Calculamos la frase más larga para establecer el ancho fijo del contenedor
// y evitar que el texto salte o se re-centre con cada letra.
const longestPhrase = phrases.reduce(
  (a, b) => (a.length > b.length ? a : b),
  ""
);
---

<header
  class="relative max-w-4xl mx-auto mb-16 md:mb-32 text-center pt-2 pb-28 md:pt-8 md:pb-24 flex flex-col justify-center md:justify-start min-h-[80vh] lg:min-h-[85vh]"
>
  <div
    id="hero-logo"
    class="flex flex-row items-center justify-center mb-2 gap-2.5 px-4 opacity-0 transition-opacity duration-1000"
  >
    <Image
      src="/img/56x.webp"
      alt="Logo 0xLeñador"
      width={56}
      height={56}
      loading="eager"
      class="w-8 h-8 md:w-12 md:h-12 object-contain"
    />
    <p
      class="text-2xl md:text-4xl font-bold tracking-tighter text-terminal-text leading-none m-0"
    >
      0x<span class="text-emerald-500">Leñador</span>
    </p>
  </div>

  <div class="h-24 md:h-32 flex items-center justify-center mb-6 px-4">
    <div class="relative text-left">
      <!-- Contenedor invisible que mantiene el ancho máximo -->
      <h1
        class="text-3xl md:text-5xl lg:text-7xl font-light text-transparent tracking-tight leading-tight select-none pointer-events-none invisible whitespace-nowrap"
        aria-hidden="true"
      >
        <span class="font-mono mr-2 md:mr-3">&gt;</span>{longestPhrase}<span
          class="font-mono inline-block ml-0.5">|</span
        >
      </h1>

      <!-- Animación real superpuesta -->
      <h1
        id="hero-typewriter"
        class="absolute top-0 left-0 w-full h-full text-3xl md:text-5xl lg:text-7xl font-light text-terminal-text tracking-tight leading-tight whitespace-nowrap"
        aria-label={phrases.join(". ")}
      >
        <span class="font-mono text-emerald-500 mr-2 md:mr-3" aria-hidden="true"
          >&gt;</span
        ><span id="typewriter-text"></span><span
          id="typewriter-cursor"
          class="terminal-cursor font-mono inline-block ml-0.5"
          aria-hidden="true">|</span
        >
      </h1>
    </div>
  </div>

  <div
    id="hero-ctas"
    class="relative z-10 flex flex-col sm:flex-row gap-3 justify-center items-center mt-2 px-4 max-w-xs sm:max-w-none mx-auto w-full sm:w-auto opacity-0 transition-opacity duration-1000"
  >
    <a
      href={ctaPrimario.href}
      class="w-full sm:w-auto px-5 py-2.5 md:px-6 md:py-3 bg-gradient-to-r from-emerald-500 to-cyan-500 text-terminal-bg font-black uppercase tracking-widest text-xs rounded-xl hover:bg-emerald-400 transition-all italic inline-flex items-center justify-center gap-2 shadow-[0_0_20px_rgba(16,185,129,0.3)]"
    >
      <svg
        class="w-4 h-4 shrink-0"
        fill="none"
        stroke="currentColor"
        stroke-width="2.5"
        viewBox="0 0 24 24"
        ><path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25"
        ></path>
      </svg>
      <span>{ctaPrimario.texto}</span>
    </a>
    <a
      href={ctaSecundario.href}
      class="w-full sm:w-auto px-5 py-2.5 md:px-6 md:py-3 border border-terminal-border text-terminal-text font-black uppercase tracking-widest text-xs rounded-xl hover:bg-terminal-surface transition-all inline-flex items-center justify-center text-center"
    >
      {ctaSecundario.texto}
    </a>
  </div>
</header>

<script define:vars={{ phrases }}>
  // ==========================================
  // MOTOR TYPEWRITER — Terminal Premium
  // Escribe carácter por carácter, pausa, borra y rota frases.
  // ==========================================
  const textEl = document.getElementById("typewriter-text");

  if (textEl && phrases && phrases.length > 0) {
    let phraseIndex = 0;
    let isFirstCycle = true;
    const TYPING_SPEED = 55; // ms por carácter al escribir
    const ERASING_SPEED = 30; // ms por carácter al borrar
    const PAUSE_AFTER_TYPE = 5000; // ms de pausa tras completar frase
    const PAUSE_AFTER_ERASE = 400; // ms de pausa tras borrar antes de la siguiente

    const capitalize = (str) => str.charAt(0).toUpperCase() + str.slice(1);

    function typePhrase(text, charIndex, callback) {
      if (charIndex <= text.length) {
        textEl.textContent = text.substring(0, charIndex);
        setTimeout(
          () => typePhrase(text, charIndex + 1, callback),
          TYPING_SPEED
        );
      } else {
        if (isFirstCycle) {
          isFirstCycle = false;
          const logoEl = document.getElementById("hero-logo");
          const ctasEl = document.getElementById("hero-ctas");
          if (logoEl) logoEl.classList.remove("opacity-0");
          if (ctasEl) ctasEl.classList.remove("opacity-0");
        }
        callback();
      }
    }

    function erasePhrase(text, charIndex, callback) {
      if (charIndex >= 0) {
        textEl.textContent = text.substring(0, charIndex);
        setTimeout(
          () => erasePhrase(text, charIndex - 1, callback),
          ERASING_SPEED
        );
      } else {
        callback();
      }
    }

    function runCycle() {
      const currentPhrase = capitalize(phrases[phraseIndex]);

      typePhrase(currentPhrase, 0, () => {
        setTimeout(() => {
          erasePhrase(currentPhrase, currentPhrase.length, () => {
            phraseIndex = (phraseIndex + 1) % phrases.length;
            setTimeout(runCycle, PAUSE_AFTER_ERASE);
          });
        }, PAUSE_AFTER_TYPE);
      });
    }

    // Arrancar el ciclo
    runCycle();
  }
</script>
