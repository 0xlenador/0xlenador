---
// src/components/IntrinsicCalculator.astro
---

<div class="hub-card p-4 rounded-xl w-full md:w-[480px] flex-shrink-0 border border-terminal-border/50 bg-[#0a0a0a]/80 backdrop-blur-sm shadow-xl">
  <div class="flex items-center justify-between mb-3">
    <div class="flex items-center gap-2">
      <div class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse shadow-[0_0_8px_rgba(16,185,129,0.8)]"></div>
      <h3 class="text-[11px] font-mono text-emerald-400 uppercase tracking-widest font-bold">Calculadora V.I.</h3>
    </div>
    <span class="text-[8px] font-mono text-terminal-subtle px-1.5 py-0.5 rounded bg-terminal-border/30">BETA</span>
  </div>
  
  <form id="vi-calculator" class="flex flex-col sm:flex-row gap-5" onsubmit="event.preventDefault();">
    
    <!-- Columna Izquierda: Entradas -->
    <div class="flex-1 space-y-3">
      <div class="flex flex-col gap-1 relative">
        <label class="text-[8px] font-mono text-terminal-subtle uppercase tracking-wider">Activo (Datos Simulados)</label>
        
        <!-- Custom Select -->
        <div id="custom-select-trigger" class="bg-terminal-dark/80 border border-terminal-border text-white text-xs rounded-md px-2.5 py-2 hover:border-emerald-500/50 transition-all cursor-pointer flex justify-between items-center group">
          <span id="selected-asset-text" class="font-mono">Apple (AAPL)</span>
          <svg class="w-3 h-3 text-terminal-subtle group-hover:text-emerald-400 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
        </div>
        
        <!-- Dropdown Menu -->
        <div id="custom-select-dropdown" class="hidden absolute top-full left-0 w-full mt-1 bg-[#0a0a0a] border border-terminal-border rounded-md shadow-2xl z-50 overflow-hidden divide-y divide-terminal-border/30">
          <div class="custom-option px-3 py-2.5 text-xs font-mono text-terminal-subtle hover:bg-emerald-500/10 hover:text-emerald-400 cursor-pointer transition-colors" data-value="AAPL">Apple (AAPL)</div>
          <div class="custom-option px-3 py-2.5 text-xs font-mono text-terminal-subtle hover:bg-emerald-500/10 hover:text-emerald-400 cursor-pointer transition-colors" data-value="MSFT">Microsoft (MSFT)</div>
          <div class="custom-option px-3 py-2.5 text-xs font-mono text-terminal-subtle hover:bg-emerald-500/10 hover:text-emerald-400 cursor-pointer transition-colors" data-value="TSLA">Tesla (TSLA)</div>
        </div>
      </div>

      <div class="flex gap-2">
        <div class="flex flex-col gap-1 w-1/2">
          <label for="growth-rate" class="text-[8px] font-mono text-terminal-subtle uppercase tracking-wider">Crecimiento</label>
          <div class="relative">
            <input type="number" id="growth-rate" value="10" step="1" class="w-full bg-terminal-dark/80 border border-terminal-border text-white text-xs rounded-md pl-2 pr-5 py-1.5 focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500/30 focus:outline-none transition-all font-mono" />
            <span class="absolute right-2 top-1/2 -translate-y-1/2 text-[9px] text-terminal-subtle font-mono">%</span>
          </div>
        </div>
        <div class="flex flex-col gap-1 w-1/2">
          <label for="discount-rate" class="text-[8px] font-mono text-terminal-subtle uppercase tracking-wider">Descuento</label>
          <div class="relative">
            <input type="number" id="discount-rate" value="10" step="1" class="w-full bg-terminal-dark/80 border border-terminal-border text-white text-xs rounded-md pl-2 pr-5 py-1.5 focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500/30 focus:outline-none transition-all font-mono" />
            <span class="absolute right-2 top-1/2 -translate-y-1/2 text-[9px] text-terminal-subtle font-mono">%</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Columna Derecha: Resultados -->
    <div class="w-full sm:w-[140px] flex flex-col justify-center items-end sm:border-l border-terminal-border/30 sm:pl-4 pt-3 sm:pt-0 border-t sm:border-t-0">
      <div class="flex flex-col items-end text-right mb-2">
        <span class="text-[8px] font-mono text-terminal-subtle uppercase tracking-wider mb-0.5">Valor Intrínseco</span>
        <span id="vi-result" class="text-2xl font-black text-white tracking-tighter transition-colors duration-300">$0.00</span>
      </div>
      <div class="flex flex-col items-end text-right">
        <span class="text-[7px] font-mono text-terminal-muted uppercase tracking-wider mb-0.5">Precio Actual</span>
        <span id="vi-price" class="text-[10px] text-terminal-subtle font-mono">$0.00</span>
      </div>
    </div>

  </form>
</div>

<script>
  // Simulated data for now
  const mockData = {
    AAPL: { price: 180.50, fcf: 106000000000, shares: 15440000000 }, 
    MSFT: { price: 410.00, fcf: 70000000000, shares: 7430000000 },   
    TSLA: { price: 200.00, fcf: 4300000000, shares: 3180000000 }     
  };

  const growthInput = document.getElementById('growth-rate') as HTMLInputElement;
  const discountInput = document.getElementById('discount-rate') as HTMLInputElement;
  const resultDisplay = document.getElementById('vi-result');
  const priceDisplay = document.getElementById('vi-price');
  
  // Custom Select Logic
  const trigger = document.getElementById('custom-select-trigger');
  const dropdown = document.getElementById('custom-select-dropdown');
  const selectedText = document.getElementById('selected-asset-text');
  const options = document.querySelectorAll('.custom-option');
  
  let currentAsset = 'AAPL';

  if (trigger && dropdown) {
    trigger.addEventListener('click', (e) => {
      e.stopPropagation();
      dropdown.classList.toggle('hidden');
    });

    options.forEach(opt => {
      opt.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        currentAsset = target.dataset.value!;
        selectedText!.textContent = target.textContent;
        dropdown.classList.add('hidden');
        calculateIntrinsicValue();
      });
    });

    // Close on click outside
    document.addEventListener('click', (e) => {
      if (!trigger.contains(e.target as Node) && !dropdown.contains(e.target as Node)) {
        dropdown.classList.add('hidden');
      }
    });
  }

  function calculateIntrinsicValue() {
    if (!growthInput || !discountInput || !resultDisplay || !priceDisplay) return;

    const ticker = currentAsset as keyof typeof mockData;
    const data = mockData[ticker];
    const growth = parseFloat(growthInput.value) / 100;
    const discount = parseFloat(discountInput.value) / 100;
    
    const fcfPerShare = data.fcf / data.shares;
    
    let intrinsicValue = 0;
    for (let i = 1; i <= 10; i++) {
      intrinsicValue += (fcfPerShare * Math.pow(1 + growth, i)) / Math.pow(1 + discount, i);
    }
    
    const perpetualGrowth = 0.025;
    if (discount > perpetualGrowth) {
      const terminalValue = (fcfPerShare * Math.pow(1 + growth, 10) * (1 + perpetualGrowth)) / (discount - perpetualGrowth);
      intrinsicValue += terminalValue / Math.pow(1 + discount, 10);
    }

    resultDisplay.textContent = `$${intrinsicValue.toFixed(2)}`;
    priceDisplay.textContent = `$${data.price.toFixed(2)}`;
    
    // Visual feedback
    if (intrinsicValue > data.price) {
      resultDisplay.className = "text-2xl font-black text-emerald-400 tracking-tighter transition-colors duration-300 drop-shadow-[0_0_8px_rgba(52,211,153,0.3)]";
    } else {
      resultDisplay.className = "text-2xl font-black text-rose-400 tracking-tighter transition-colors duration-300 drop-shadow-[0_0_8px_rgba(251,113,133,0.3)]";
    }
  }

  // Event Listeners
  if (growthInput && discountInput) {
    growthInput.addEventListener('input', calculateIntrinsicValue);
    discountInput.addEventListener('input', calculateIntrinsicValue);
    
    // Initial calc
    calculateIntrinsicValue();
  }
</script>
