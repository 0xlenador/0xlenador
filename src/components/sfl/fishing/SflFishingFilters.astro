---
import { getLangFromUrl, useTranslations } from "../../../i18n/utils"

interface Props {
  counts: {
    all: number
    fish: number
    basic: number
    advanced: number
    expert: number
    trap: number
    crabPot: number
    marinerPot: number
    marvel: number
    permanent: number
    chapters: number
    currentChapter: number
  }
}

const { counts } = Astro.props
const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)

const seasons = [
  { key: "all", label: t("sfl.fishing.filter.season.all"), icon: null },
  { key: "spring", label: t("sfl.fishing.filter.season.spring"), icon: "/img/sunflowerland/123/primavera.webp" },
  { key: "summer", label: t("sfl.fishing.filter.season.summer"), icon: "/img/sunflowerland/123/verano.webp" },
  { key: "autumn", label: t("sfl.fishing.filter.season.autumn"), icon: "/img/sunflowerland/123/otono.webp" },
  { key: "winter", label: t("sfl.fishing.filter.season.winter"), icon: "/img/sunflowerland/123/invierno.webp" },
]

const sortOptions = [
  { key: "default", label: t("sfl.fishing.sort.default"), icon: null, prefix: null },
  { key: "cheapest", label: t("sfl.fishing.sort.cheapest"), icon: "/img/sunflowerland/123/flower.jpg", prefix: null },
  { key: "expensive", label: t("sfl.fishing.sort.expensive"), icon: null, prefix: "↑" },
  { key: "xp-desc", label: t("sfl.fishing.sort.xpDesc"), icon: "/img/sunflowerland/123/energy.png", prefix: null },
  { key: "xp-asc", label: t("sfl.fishing.sort.xpAsc"), icon: null, prefix: "↓" },
]

const marvelChapters = [
  { name: "Cave Dwellers", label: "Cap. 16: Cave Dwellers", isCurrent: true },
  { name: "Ascension Age", label: "Cap. 15: Ascension Age" },
  { name: "Salt Awakening", label: "Cap. 14: Salt Awakening" },
  { name: "Crabs and Traps", label: "Cap. 13: Crabs & Traps" },
  { name: "Paw Prints", label: "Cap. 12: Paw Prints" },
  { name: "Clash of Factions", label: "Cap. 11: Clash of Factions" },
  { name: "Spring Blossom", label: "Cap. 10: Spring Blossom" },
  { name: "Pharaoh's Treasure", label: "Cap. 9: Pharaoh's Treasure" },
  { name: "Catch the Kraken", label: "Cap. 8: Catch the Kraken" },
  { name: "Witches' Eve", label: "Cap. 7: Witches' Eve" },
  { name: "Dawn Breaker", label: "Cap. 6: Dawn Breaker" },
  { name: "Solar Flare", label: "Cap. 5: Solar Flare" },
]
---

<div class="mb-6 bg-[#121214] border border-white/10 rounded-2xl p-3 sm:p-4 shadow-xl shadow-black/40 backdrop-blur-xl flex flex-col gap-3.5">
  <!-- Fila 1: Macro-Secciones (Dominio) + Buscador + Switcher de Vistas -->
  <div class="flex flex-col lg:flex-row items-stretch lg:items-center justify-between gap-3">
    <!-- Macro-Secciones Principales -->
    <div class="flex items-center gap-1.5 overflow-x-auto pb-1 lg:pb-0 scrollbar-thin scrollbar-thumb-white/10">
      <span class="text-xs font-mono uppercase tracking-wider text-white/40 shrink-0 mr-1 hidden sm:inline">
        {t("sfl.fishing.filter.section")}
      </span>

      <!-- 🐟 Peces de Caña (Activo por defecto) -->
      <button
        type="button"
        class="filter-section-btn active px-3.5 py-1.5 rounded-xl text-xs font-mono font-bold border transition-all cursor-pointer shrink-0 flex items-center gap-1.5 bg-cyan-500/15 text-cyan-300 border-cyan-500/30 shadow-sm"
        data-section="fish"
      >
        <span>🐟</span>
        <span>{t("sfl.fishing.filter.fish")}</span>
        <span class="ml-0.5 text-[10px] text-cyan-300/70">({counts.fish})</span>
      </button>

      <!-- 🦀 Crustáceos -->
      <button
        type="button"
        class="filter-section-btn px-3.5 py-1.5 rounded-xl text-xs font-mono font-medium border transition-all cursor-pointer shrink-0 flex items-center gap-1.5 bg-transparent text-white/60 border-white/5 hover:bg-white/5 hover:text-white"
        data-section="trap"
      >
        <span>🦀</span>
        <span>{t("sfl.fishing.filter.crustaceans")}</span>
        <span class="ml-0.5 text-[10px] text-white/40">({counts.trap})</span>
      </button>

      <!-- ⭐ Maravillas Marinas -->
      <button
        type="button"
        class="filter-section-btn px-3.5 py-1.5 rounded-xl text-xs font-mono font-medium border transition-all cursor-pointer shrink-0 flex items-center gap-1.5 bg-transparent text-white/60 border-white/5 hover:bg-white/5 hover:text-white"
        data-section="marvel"
      >
        <span>⭐</span>
        <span>{t("sfl.fishing.filter.marvels")}</span>
        <span class="ml-0.5 text-[10px] text-white/40">({counts.marvel})</span>
      </button>

      <!-- 🌐 Todos -->
      <button
        type="button"
        class="filter-section-btn px-3 py-1.5 rounded-xl text-xs font-mono font-medium border transition-all cursor-pointer shrink-0 flex items-center gap-1 bg-transparent text-white/40 border-white/5 hover:bg-white/5 hover:text-white"
        data-section="all"
        title="Mostrar todo el catálogo"
      >
        <span>{t("sfl.fishing.filter.all")}</span>
        <span class="text-[10px] text-white/30">({counts.all})</span>
      </button>
    </div>

    <!-- Buscador en tiempo real y Selector de Vistas -->
    <div class="flex items-center gap-2 w-full lg:w-auto shrink-0">
      <div class="relative flex-1 lg:w-60">
        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
          <svg class="w-3.5 h-3.5 text-white/30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="11" cy="11" r="8" />
            <path d="m21 21-4.35-4.35" />
          </svg>
        </div>
        <input
          type="text"
          id="fishSearchInput"
          placeholder={t("sfl.fishing.search.placeholder")}
          class="w-full bg-[#18181b]/80 border border-white/10 focus:border-cyan-400/50 rounded-xl pl-9 pr-8 py-1.5 text-xs text-white placeholder-white/30 focus:outline-none transition-colors font-mono"
        />
        <button
          id="clearSearchBtn"
          type="button"
          class="hidden absolute right-2.5 top-1.5 text-white/40 hover:text-white text-xs p-0.5 cursor-pointer"
          title="Clear search"
        >
          ✕
        </button>
      </div>

      <!-- Segmented Control de 3 Vistas -->
      <div class="flex items-center p-0.5 bg-black/40 border border-white/10 rounded-xl shrink-0" role="group" aria-label={t("sfl.fishing.view.label")}>
        <button
          type="button"
          class="view-mode-btn active px-2.5 py-1.5 rounded-lg text-xs font-mono font-medium transition-all cursor-pointer flex items-center gap-1.5 bg-white/15 text-cyan-300 border border-cyan-500/30 shadow-sm"
          data-view="normal"
          title={t("sfl.fishing.view.normal")}
        >
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="3" y="3" width="7" height="7" rx="1.5" />
            <rect x="14" y="3" width="7" height="7" rx="1.5" />
            <rect x="14" y="14" width="7" height="7" rx="1.5" />
            <rect x="3" y="14" width="7" height="7" rx="1.5" />
          </svg>
          <span class="hidden sm:inline">{t("sfl.fishing.view.normal")}</span>
        </button>

        <button
          type="button"
          class="view-mode-btn px-2.5 py-1.5 rounded-lg text-xs font-mono font-medium transition-all cursor-pointer flex items-center gap-1.5 text-white/50 hover:text-white hover:bg-white/5 border border-transparent"
          data-view="compact"
          title={t("sfl.fishing.view.compact")}
        >
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="3" y="3" width="4" height="4" rx="0.5" />
            <rect x="10" y="3" width="4" height="4" rx="0.5" />
            <rect x="17" y="3" width="4" height="4" rx="0.5" />
            <rect x="3" y="10" width="4" height="4" rx="0.5" />
            <rect x="10" y="10" width="4" height="4" rx="0.5" />
            <rect x="17" y="10" width="4" height="4" rx="0.5" />
            <rect x="3" y="17" width="4" height="4" rx="0.5" />
            <rect x="10" y="17" width="4" height="4" rx="0.5" />
            <rect x="17" y="17" width="4" height="4" rx="0.5" />
          </svg>
          <span class="hidden sm:inline">{t("sfl.fishing.view.compact")}</span>
        </button>

        <button
          type="button"
          class="view-mode-btn px-2.5 py-1.5 rounded-lg text-xs font-mono font-medium transition-all cursor-pointer flex items-center gap-1.5 text-white/50 hover:text-white hover:bg-white/5 border border-transparent"
          data-view="table"
          title={t("sfl.fishing.view.table")}
        >
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="3" y1="6" x2="21" y2="6" />
            <line x1="3" y1="12" x2="21" y2="12" />
            <line x1="3" y1="18" x2="21" y2="18" />
          </svg>
          <span class="hidden sm:inline">{t("sfl.fishing.view.table")}</span>
        </button>
      </div>
    </div>
  </div>

  <!-- Línea divisoria 1 -->
  <div class="h-px bg-white/5 w-full"></div>

  <!-- Fila 2: Subfiltros Contextuales (Izquierda) + Ordenación (Derecha - mismo nivel) -->
  <div class="flex flex-col xl:flex-row items-stretch xl:items-center justify-between gap-3">
    <!-- Subfiltros Contextuales según la Sección Activa -->
    <div class="flex items-center gap-1.5 overflow-x-auto pb-1 xl:pb-0 scrollbar-thin scrollbar-thumb-white/10">
      <!-- Subfiltros PECES -->
      <div id="subfiltersFish" class="flex items-center gap-1.5 shrink-0">
        <span class="text-xs font-mono uppercase tracking-wider text-white/40 shrink-0 mr-1 hidden sm:inline">
          {t("sfl.fishing.filter.tier")}
        </span>

        <button
          type="button"
          class="filter-tier-btn active px-3 py-1.5 rounded-xl text-xs font-mono font-medium border transition-all cursor-pointer shrink-0 bg-white/10 text-white border-white/20"
          data-tier="all"
        >
          <span>{t("sfl.fishing.filter.sub.allFish")}</span>
          <span class="ml-1 text-[10px] text-white/50">({counts.fish})</span>
        </button>

        <button
          type="button"
          class="filter-tier-btn px-3 py-1.5 rounded-xl text-xs font-mono font-medium border transition-all cursor-pointer shrink-0 bg-transparent text-white/60 border-white/5 hover:bg-white/5 hover:text-white"
          data-tier="basic"
        >
          <span class="w-2 h-2 rounded-full inline-block bg-emerald-400 mr-1.5"></span>
          <span>{t("sfl.fishing.filter.basic")}</span>
          <span class="ml-1 text-[10px] text-white/40">({counts.basic})</span>
        </button>

        <button
          type="button"
          class="filter-tier-btn px-3 py-1.5 rounded-xl text-xs font-mono font-medium border transition-all cursor-pointer shrink-0 bg-transparent text-white/60 border-white/5 hover:bg-white/5 hover:text-white"
          data-tier="advanced"
        >
          <span class="w-2 h-2 rounded-full inline-block bg-sky-400 mr-1.5"></span>
          <span>{t("sfl.fishing.filter.advanced")}</span>
          <span class="ml-1 text-[10px] text-white/40">({counts.advanced})</span>
        </button>

        <button
          type="button"
          class="filter-tier-btn px-3 py-1.5 rounded-xl text-xs font-mono font-medium border transition-all cursor-pointer shrink-0 bg-transparent text-white/60 border-white/5 hover:bg-white/5 hover:text-white"
          data-tier="expert"
        >
          <span class="w-2 h-2 rounded-full inline-block bg-purple-400 mr-1.5"></span>
          <span>{t("sfl.fishing.filter.expert")}</span>
          <span class="ml-1 text-[10px] text-white/40">({counts.expert})</span>
        </button>
      </div>

      <!-- Subfiltros CRUSTÁCEOS -->
      <div id="subfiltersTrap" class="hidden flex items-center gap-1.5 shrink-0">
        <span class="text-xs font-mono uppercase tracking-wider text-white/40 shrink-0 mr-1 hidden sm:inline">
          {t("sfl.fishing.filter.trapType")}
        </span>

        <button
          type="button"
          class="filter-trap-sub-btn active px-3 py-1.5 rounded-xl text-xs font-mono font-medium border transition-all cursor-pointer shrink-0 bg-white/10 text-white border-white/20"
          data-trap-sub="all"
        >
          <span>{t("sfl.fishing.filter.sub.allCrustaceans")}</span>
          <span class="ml-1 text-[10px] text-white/50">({counts.trap})</span>
        </button>

        <button
          type="button"
          class="filter-trap-sub-btn px-3 py-1.5 rounded-xl text-xs font-mono font-medium border transition-all cursor-pointer shrink-0 bg-transparent text-white/60 border-white/5 hover:bg-white/5 hover:text-white"
          data-trap-sub="Crab Pot"
        >
          <span class="w-2 h-2 rounded-full inline-block bg-orange-400 mr-1.5"></span>
          <span>{t("sfl.fishing.filter.sub.crabPot")}</span>
          <span class="ml-1 text-[10px] text-white/40">({counts.crabPot})</span>
        </button>

        <button
          type="button"
          class="filter-trap-sub-btn px-3 py-1.5 rounded-xl text-xs font-mono font-medium border transition-all cursor-pointer shrink-0 bg-transparent text-white/60 border-white/5 hover:bg-white/5 hover:text-white"
          data-trap-sub="Mariner Pot"
        >
          <span class="w-2 h-2 rounded-full inline-block bg-amber-500 mr-1.5"></span>
          <span>{t("sfl.fishing.filter.sub.marinerPot")}</span>
          <span class="ml-1 text-[10px] text-white/40">({counts.marinerPot})</span>
        </button>
      </div>

      <!-- Subfiltros MARAVILLAS -->
      <div id="subfiltersMarvel" class="hidden flex items-center gap-1.5 shrink-0">
        <span class="text-xs font-mono uppercase tracking-wider text-white/40 shrink-0 mr-1 hidden sm:inline">
          {t("sfl.fishing.filter.marvelType")}
        </span>

        <!-- Permanentes -->
        <button
          type="button"
          class="filter-marvel-sub-btn px-3 py-1.5 rounded-xl text-xs font-mono font-medium border transition-all cursor-pointer shrink-0 bg-transparent text-white/60 border-white/5 hover:bg-white/5 hover:text-white"
          data-marvel-sub="permanent"
        >
          <span class="w-2 h-2 rounded-full inline-block bg-amber-400 mr-1.5"></span>
          <span>{t("sfl.fishing.filter.sub.permanent")}</span>
          <span class="ml-1 text-[10px] text-white/40">({counts.permanent})</span>
        </button>

        <!-- Capítulo Actual (Cap. 16) -->
        <button
          type="button"
          class="filter-marvel-sub-btn px-3 py-1.5 rounded-xl text-xs font-mono font-bold border transition-all cursor-pointer shrink-0 bg-transparent text-cyan-300/80 border-cyan-500/20 hover:bg-cyan-500/10 hover:text-cyan-200"
          data-marvel-sub="current"
          title="Ver criaturas del Capítulo 16 actual (Cave Dwellers)"
        >
          <span class="text-cyan-400">⚡</span>
          <span>{t("sfl.fishing.filter.sub.currentChapter")}</span>
          <span class="ml-1 text-[10px] text-cyan-400/60">({counts.currentChapter})</span>
        </button>
      </div>
    </div>

    <!-- Ordenación (Subido al mismo nivel que dificultad) -->
    <div class="flex items-center gap-1.5 overflow-x-auto pb-1 xl:pb-0 scrollbar-none shrink-0">
      <span class="text-xs font-mono uppercase tracking-wider text-white/40 shrink-0 mr-1 hidden sm:inline">
        {t("sfl.fishing.sort.label")}
      </span>
      {
        sortOptions.map((opt, idx) => (
          <button
            type="button"
            class:list={[
              "sort-fish-btn px-2.5 py-1.5 rounded-xl text-xs font-mono transition-all cursor-pointer shrink-0 flex items-center gap-1.5 border",
              idx === 0
                ? "active bg-white/10 text-white border-white/20"
                : "bg-transparent text-white/60 border-white/5 hover:bg-white/5 hover:text-white",
            ]}
            data-sort={opt.key}
          >
            {opt.icon && <img src={opt.icon} alt={opt.label} class="w-3.5 h-3.5 object-contain [image-rendering:pixelated]" />}
            {opt.prefix && <span class="text-white/50 text-xs leading-none font-bold">{opt.prefix}</span>}
            <span>{opt.label}</span>
          </button>
        ))
      }
    </div>
  </div>

  <!-- Fila 3 Contextual: Estaciones (para Peces) O Selector de Capítulos (para Maravillas) -->
  <div id="bottomFilterRow" class="flex flex-col gap-3">
    <!-- Línea divisoria 2 -->
    <div id="bottomDivider" class="h-px bg-white/5 w-full"></div>

    <!-- Bloque ESTACIÓN (Solo visible para Peces y Todos) -->
    <div id="seasonFilterBlock" class="flex items-center gap-1.5 overflow-x-auto pb-1 scrollbar-none">
      <span class="text-xs font-mono uppercase tracking-wider text-white/40 shrink-0 mr-1 hidden sm:inline">
        {t("sfl.fishing.filter.season")}
      </span>
      {
        seasons.map((s, idx) => (
          <button
            type="button"
            class:list={[
              "filter-season-btn px-2.5 py-1.5 rounded-xl text-xs font-mono transition-all cursor-pointer shrink-0 flex items-center gap-1.5 border",
              idx === 0
                ? "active bg-white/10 text-white border-white/20"
                : "bg-transparent text-white/60 border-white/5 hover:bg-white/5 hover:text-white",
            ]}
            data-season={s.key}
          >
            {s.icon && <img src={s.icon} alt={s.label} class="w-3.5 h-3.5 object-contain [image-rendering:pixelated]" />}
            <span>{s.label}</span>
          </button>
        ))
      }
    </div>

    <!-- Bloque CAPÍTULOS (Solo visible para Maravillas Marinas) -->
    <div id="chapterFilterBlock" class="hidden flex items-center gap-1.5 overflow-x-auto pb-1 scrollbar-thin scrollbar-thumb-white/10">
      <span class="text-xs font-mono uppercase tracking-wider text-white/40 shrink-0 mr-1 hidden sm:inline">
        {t("sfl.fishing.filter.chapter")}
      </span>

      <!-- Todos los Capítulos -->
      <button
        type="button"
        class="filter-chapter-select-btn active px-2.5 py-1.5 rounded-xl text-xs font-mono font-medium border transition-all cursor-pointer shrink-0 bg-white/10 text-white border-white/20"
        data-chapter-name="all"
      >
        <span>{t("sfl.fishing.filter.allChapters")}</span>
      </button>

      {
        marvelChapters.map((ch) => (
          <button
            type="button"
            class:list={[
              "filter-chapter-select-btn px-2.5 py-1.5 rounded-xl text-xs font-mono transition-all cursor-pointer shrink-0 border",
              ch.isCurrent
                ? "bg-cyan-500/10 text-cyan-300 border-cyan-500/20 hover:bg-cyan-500/20 font-bold"
                : "bg-transparent text-white/60 border-white/5 hover:bg-white/5 hover:text-white",
            ]}
            data-chapter-name={ch.name}
          >
            <span>{ch.label}</span>
          </button>
        ))
      }
    </div>
  </div>
</div>
