---
import { getLangFromUrl, useTranslations } from "../../../i18n/utils"
import fishDataRaw from "../../../content/data/sfl/fishing/fish.json"

export interface Props {
  item: any
  kind: "rod" | "trap" | "marvel"
  index?: number
}

const { item, kind, index = 0 } = Astro.props
const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)

// Diccionario indexado de peces regulares para obtener datos de disparadores de mapas
const fishMap = new Map<string, any>()
fishDataRaw.forEach((f: any) => fishMap.set(f.name.toLowerCase(), f))

// Mapeo seguro de imágenes de insumos de Chum e ingredientes
const itemImageMap: Record<string, string> = {
  "Anchovy": "/img/sunflowerland/fish/Anchovy.png",
  "Apple": "/img/sunflowerland/Apple.png",
  "Artichoke": "/img/sunflowerland/Artichoke.png",
  "Banana": "/img/sunflowerland/Banana.png",
  "Beetroot": "/img/sunflowerland/Beetroot.png",
  "Blueberry": "/img/sunflowerland/Blueberry.png",
  "Broccoli": "/img/sunflowerland/Broccoli.png",
  "Cabbage": "/img/sunflowerland/Cabbage.png",
  "Carrot": "/img/sunflowerland/Carrot.png",
  "Chewed Bone": "/img/sunflowerland/Chewed Bone.png",
  "Corn": "/img/sunflowerland/Corn.png",
  "Crab": "/img/sunflowerland/fish/a/Crab.png",
  "Crab Stick": "/img/sunflowerland/fish/a/Crab Stick.png",
  "Crimstone": "/img/sunflowerland/Crimstone.png",
  "Dewberry": "/img/sunflowerland/Dewberry.png",
  "Duskberry": "/img/sunflowerland/Duskberry.png",
  "Egg": "/img/sunflowerland/Egg.png",
  "Eggplant": "/img/sunflowerland/Eggplant.png",
  "Fat Chicken": "/img/sunflowerland/powerups/fat_chicken.webp",
  "Fish Oil": "/img/sunflowerland/fish/a/fish_oil.webp",
  "Fish Stick": "/img/sunflowerland/fish/a/fish_stick.webp",
  "Fish Flake": "/img/sunflowerland/fish/a/fish_flake.webp",
  "Frost Pebble": "/img/sunflowerland/Frost Pebble.png",
  "Gold": "/img/sunflowerland/Gold.png",
  "Grape": "/img/sunflowerland/Grape.png",
  "Heart leaf": "/img/sunflowerland/Heart leaf.png",
  "Heart Leaf": "/img/sunflowerland/Heart leaf.png",
  "Honey": "/img/sunflowerland/Honey.png",
  "Horse Mackerel": "/img/sunflowerland/fish/Horse Mackerel.png",
  "Iron": "/img/sunflowerland/Iron.png",
  "Kale": "/img/sunflowerland/Kale.png",
  "Lunara": "/img/sunflowerland/Lunara.png",
  "Moonfur": "/img/sunflowerland/Moonfur.png",
  "Onion": "/img/sunflowerland/Onion.png",
  "Orange": "/img/sunflowerland/Orange.png",
  "Pepper": "/img/sunflowerland/Pepper.png",
  "Red Snapper": "/img/sunflowerland/fish/Red Snapper.png",
  "Rhubarb": "/img/sunflowerland/Rhubarb.png",
  "Ribbon": "/img/sunflowerland/Ribbon.png",
  "Rice": "/img/sunflowerland/Rice.png",
  "Rich Chicken": "/img/sunflowerland/powerups/rich_chicken.webp",
  "Ruffroot": "/img/sunflowerland/Ruffroot.png",
  "Seaweed": "/img/sunflowerland/fish/a/seaweed.webp",
  "Speed Chicken": "/img/sunflowerland/powerups/speed_chicken.webp",
  "Squid": "/img/sunflowerland/fish/Squid.png",
  "Sunfish": "/img/sunflowerland/fish/Sunfish.png",
  "Sunflower": "/img/sunflowerland/Sunflower.png",
  "Tuna": "/img/sunflowerland/fish/Tuna.png",
  "Turnip": "/img/sunflowerland/Turnip.png",
  "Wheat": "/img/sunflowerland/Wheat.png",
  "Wild Grass": "/img/sunflowerland/Wild Grass.png",
  "Wild Mushroom": "/img/sunflowerland/123/wild_mushroom.webp",
  "Yam": "/img/sunflowerland/Yam.png",
  "Zebra Turkeyfish": "/img/sunflowerland/fish/Zebra Turkeyfish.png",
  "Zucchini": "/img/sunflowerland/Zucchini.png",
  "Blue Crab": "/img/sunflowerland/fish/crabs/Blue Crab.png",
  "Hermit Crab": "/img/sunflowerland/fish/crabs/Hermit Crab.png",
  "Sea Slug": "/img/sunflowerland/fish/crabs/Sea Slug.png",
  "Mussel": "/img/sunflowerland/fish/crabs/Mussel.png",
  "Isopod": "/img/sunflowerland/fish/crabs/Isopod.png",
  "Sea Snail": "/img/sunflowerland/fish/crabs/Sea Snail.png",
  "Shrimp": "/img/sunflowerland/fish/crabs/Shrimp.png",
  "Lobster": "/img/sunflowerland/fish/crabs/Lobster.png",
  "Barnacle": "/img/sunflowerland/fish/crabs/Barnacle.png",
  "Oyster": "/img/sunflowerland/fish/crabs/Oyster.png",
  "Garden Eel": "/img/sunflowerland/fish/crabs/Garden Eel.png",
}

const baitImageMap: Record<string, string> = {
  "Earthworm": "/img/sunflowerland/fish/a/Earthworm.png",
  "Capsule Bait": "/img/sunflowerland/Capsule Bait.png",
  "Grub": "/img/sunflowerland/fish/a/Grub.png",
  "Red Wiggler": "/img/sunflowerland/fish/a/Red Wiggler.png",
  "Fishing Lure": "/img/sunflowerland/fish/a/Fishing Lure.png",
  "Crimson Baitfish": "/img/sunflowerland/Crimson Baitfish.png",
  "Umbrella Bait": "/img/sunflowerland/Umbrella Bait.png",
  "Fish Flake": "/img/sunflowerland/fish/a/fish_flake.webp",
  "Fish Stick": "/img/sunflowerland/fish/a/fish_stick.webp",
  "Fish Oil": "/img/sunflowerland/fish/a/fish_oil.webp",
  "Crab Stick": "/img/sunflowerland/fish/a/Crab Stick.png",
}

const seasonIcons: Record<string, { label: string; icon: string }> = {
  spring: { label: t("sfl.fishing.season.spring"), icon: "/img/sunflowerland/123/primavera.webp" },
  summer: { label: t("sfl.fishing.season.summer"), icon: "/img/sunflowerland/123/verano.webp" },
  autumn: { label: t("sfl.fishing.season.autumn"), icon: "/img/sunflowerland/123/otono.webp" },
  winter: { label: t("sfl.fishing.season.winter"), icon: "/img/sunflowerland/123/invierno.webp" },
}

// Configuración visual por tier / categoría estilo /directory/
const tierVisuals: Record<string, { label: string; badgeDotClass: string; hoverBorderClass: string; glowGradient: string }> = {
  basic: {
    label: t("sfl.fishing.filter.basic"),
    badgeDotClass: "bg-emerald-400/80",
    hoverBorderClass: "hover:border-emerald-500/30",
    glowGradient: "from-emerald-500/[0.04]",
  },
  advanced: {
    label: t("sfl.fishing.filter.advanced"),
    badgeDotClass: "bg-sky-400/80",
    hoverBorderClass: "hover:border-sky-500/30",
    glowGradient: "from-sky-500/[0.04]",
  },
  expert: {
    label: t("sfl.fishing.filter.expert"),
    badgeDotClass: "bg-purple-400/80",
    hoverBorderClass: "hover:border-purple-500/30",
    glowGradient: "from-purple-500/[0.04]",
  },
  trap: {
    label: t("sfl.fishing.filter.trap"),
    badgeDotClass: "bg-orange-400/80",
    hoverBorderClass: "hover:border-orange-500/30",
    glowGradient: "from-orange-500/[0.04]",
  },
  marvel: {
    label: t("sfl.fishing.filter.marvel"),
    badgeDotClass: "bg-amber-400/80",
    hoverBorderClass: "hover:border-amber-500/30",
    glowGradient: "from-amber-500/[0.04]",
  },
}

const visualKey = kind === "rod" ? (item.tier || "basic") : kind
const visual = tierVisuals[visualKey] || tierVisuals.basic

// Preparar lista unificada de cebos (incluye cebo garantizado del Fish Market si existe)
const allBaits = [...(item.baits || [])]
if (kind === "rod" && item.guaranteedBy && !allBaits.includes(item.guaranteedBy)) {
  allBaits.push(item.guaranteedBy)
}

// Combinaciones oficiales de Cebo + Chum que garantizan captura al 100%
const guaranteedChumCombos: Record<string, Record<string, string[]>> = {
  "Anchovy": {
    "Carrot": ["Earthworm", "Capsule Bait"],
    "Egg": ["Earthworm", "Capsule Bait"],
  },
  "Tuna": {
    "Orange": ["Grub", "Umbrella Bait"],
    "Wild Mushroom": ["Grub", "Umbrella Bait"],
  },
  "Red Snapper": {
    "Apple": ["Red Wiggler", "Crimson Baitfish", "Fishing Lure"],
    "Honey": ["Red Wiggler", "Crimson Baitfish", "Fishing Lure"],
  },
  "Saw Shark": {
    "Speed Chicken": ["Red Wiggler", "Crimson Baitfish", "Fishing Lure"],
  },
  "White Shark": {
    "Rich Chicken": ["Red Wiggler", "Crimson Baitfish", "Fishing Lure"],
  },
  "Whale Shark": {
    "Fat Chicken": ["Red Wiggler", "Crimson Baitfish", "Fishing Lure"],
  },
}

// Preparar datos para atributos HTML de filtrado
const filterTier = kind === "rod" ? item.tier : kind
const filterSeasons = (item.seasons || ["spring", "summer", "autumn", "winter"]).join(" ")
const filterBaits = allBaits.join(" ").toLowerCase()
const filterChum = (item.chum || []).map((c: any) => c.item).join(" ").toLowerCase()
const filterGuaranteed = item.guaranteedBy ? item.guaranteedBy.toLowerCase() : ""
---

<div
  class:list={[
    "fish-card group rounded-2xl p-4 transition-all duration-500 flex flex-col justify-between relative overflow-hidden bg-[#0a0a0a] border border-white/5 hover:shadow-2xl hover:shadow-black/80",
    visual.hoverBorderClass,
  ]}
  data-tier={filterTier}
  data-kind={kind}
  data-seasons={filterSeasons}
  data-name={item.name.toLowerCase()}
  data-raw-name={item.name}
  data-trap={item.trap || ""}
  data-bait={filterBaits}
  data-chum={filterChum}
  data-guaranteed={filterGuaranteed}
  data-chapter={item.chapter ? "chapters" : "permanent"}
  data-chapter-name={item.chapter || ""}
  data-default-order={index}
  data-xp={item.xp || 0}
  data-cost="999999"
>
  <!-- Glow temático suave estilo /directory/ -->
  <div class:list={["absolute inset-0 bg-gradient-to-br via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-700 pointer-events-none", visual.glowGradient]}></div>

  <div>
    <!-- Encabezado: Tier / Categoría + XP o Nivel -->
    <div class="flex items-center justify-between gap-2 mb-3">
      <span class="inline-flex items-center gap-1.5 text-[10px] font-mono px-2 py-0.5 rounded-md bg-white/[0.03] border border-white/10 text-white/70">
        <span class:list={["w-1.5 h-1.5 rounded-full inline-block", visual.badgeDotClass]}></span>
        <span>{visual.label}</span>
      </span>

      {kind === "rod" && (
        <span class="text-[10px] font-mono text-emerald-400/90 font-medium bg-emerald-500/[0.06] px-2 py-0.5 rounded-md border border-emerald-500/20">
          +{item.xp} XP
        </span>
      )}

      {kind === "trap" && (
        <span class="text-[10px] font-mono text-white/50 bg-white/[0.02] px-2 py-0.5 rounded-md border border-white/5 font-medium">
          Lvl {item.requiredBumpkinLevel} · {item.readyTimeHours}h
        </span>
      )}

      {kind === "marvel" && (
        <span class="text-[10px] font-mono text-white/40 bg-white/[0.02] px-2 py-0.5 rounded-md border border-white/5 uppercase tracking-wider font-medium">
          {item.chapter || t("sfl.fishing.card.permanent")}
        </span>
      )}
    </div>

    <!-- Imagen, Nombre y Estaciones -->
    <div class="flex items-center gap-3.5 mb-3.5">
      <div class="w-14 h-14 rounded-xl bg-black/60 border border-white/5 flex items-center justify-center p-1.5 shrink-0 group-hover:border-white/10 transition-all group-hover:scale-105">
        <img
          src={item.image}
          alt={item.name}
          loading="lazy"
          class="w-full h-full object-contain [image-rendering:pixelated] drop-shadow-md"
          onerror="this.src='/img/sunflowerland/fish/Anchovy.png'; this.classList.add('opacity-30')"
        />
      </div>

      <div class="min-w-0 flex-1">
        <h3 class="text-sm font-bold text-white group-hover:text-white/90 transition-colors truncate">
          {item.name}
        </h3>

        <!-- Iconos de Estaciones Climáticas (si aplica) y Buff/Decorativo -->
        <div class="flex items-center flex-wrap gap-1.5 mt-1">
          {item.seasons && item.seasons.length > 0 && (
            <div class="flex items-center gap-1">
              {item.seasons.map((sKey: string) => {
                const sObj = seasonIcons[sKey]
                return (
                  <span title={sObj?.label || sKey} class="inline-flex items-center">
                    <img src={sObj?.icon} alt={sObj?.label || sKey} class="w-3.5 h-3.5 object-contain" />
                  </span>
                )
              })}
            </div>
          )}

          {kind === "marvel" && (
            item.buff ? (
              <span class="inline-flex items-center gap-1 text-[10px] font-mono text-amber-200/90 font-medium bg-amber-500/[0.06] px-2 py-0.5 rounded-md border border-amber-500/20" title={item.buff}>
                <span class="text-amber-400/80 text-xs">★</span>
                <span>{item.buff}</span>
              </span>
            ) : (
              <span class="inline-flex items-center text-[10px] font-mono text-white/40 bg-white/[0.02] px-2 py-0.5 rounded-md border border-white/5">
                {t("sfl.fishing.card.decorative") || "Decorativo"}
              </span>
            )
          )}
        </div>

        <!-- Subtítulo contextual -->
        {kind === "trap" && (
          <span class="text-[10px] font-mono text-white/40 block mt-0.5">
            {item.trap}
          </span>
        )}
        {kind === "marvel" && item.inTime && (
          <span class="text-[10px] font-mono text-white/30 block mt-0.5">
            {item.inTime.start} → {item.inTime.end}
          </span>
        )}
      </div>
    </div>

    <!-- Costo Estimado (Calculadora Dinámica - Destacado visualmente) -->
    <div class="mb-3 p-2.5 rounded-xl flex flex-col gap-1.5 transition-all duration-300 border bg-[#0e0e11] border-white/5 group-hover:border-white/10">
      <div class="flex items-center justify-between">
        <span class="cost-title-label text-[10px] font-mono uppercase tracking-wider text-white/40 font-medium">
          {kind === "marvel" ? t("sfl.fishing.card.costMarvel") : t("sfl.fishing.card.cost")}
        </span>
        <div class="flex items-center gap-1.5 shrink-0">
          <div class="cost-flower-val font-mono font-bold flex items-center gap-1 text-sm text-white">
            <img src="/img/sunflowerland/123/flower.jpg" alt="FLOWER" class="w-3.5 h-3.5 rounded-full object-cover shrink-0 -translate-y-px" />
            <span class="cost-val-num">--</span>
            <span class="cost-usd-val text-[10px] font-mono ml-0.5 text-white/40 font-normal">
              (--)
            </span>
          </div>
        </div>
      </div>

      <div class="pt-1 border-t border-white/5 text-[10px] font-mono text-white/60">
        <div class="cost-breakdown-label block">
          {kind === "trap" ? t("sfl.fishing.card.breakdownTrap") : t("sfl.fishing.card.breakdownBase")}
        </div>
      </div>
    </div>

    <!-- SECCIÓN CONTEXTUAL 1: ROD FISH (Cebos Seleccionables e Inclusión de Cebo Garantizado) -->
    {kind === "rod" && allBaits.length > 0 && (
      <div class="mb-2.5">
        <span class="text-[10px] font-mono uppercase tracking-wider text-white/40 block mb-1 font-medium">
          {t("sfl.fishing.card.bait")}
        </span>
        <div class="flex flex-wrap gap-1.5 bait-container">
          {allBaits.map((baitName: string, idx: number) => {
            const bImg = baitImageMap[baitName] || "/img/sunflowerland/Capsule Bait.png"
            const isFree = ["Earthworm", "Grub", "Red Wiggler"].includes(baitName)
            const isGuaranteed = item.guaranteedBy === baitName
            // Prioridad inicial: el primer cebo gratis, o el primer cebo
            const defaultIdx = allBaits.findIndex((b: string) => ["Earthworm", "Grub", "Red Wiggler"].includes(b))
            const isDefault = defaultIdx >= 0 ? idx === defaultIdx : idx === 0
            return (
              <button
                type="button"
                class:list={[
                  "bait-badge group/bait inline-flex items-center gap-1.5 px-2 py-1 rounded-lg border text-[11px] font-mono transition-all cursor-pointer select-none",
                  isDefault
                    ? isFree
                      ? "active bg-white/[0.06] border-emerald-400/40 text-emerald-200 shadow-sm"
                      : "active bg-white/[0.06] border-white/25 text-white shadow-sm"
                    : "bg-[#0e0e11] border-white/5 text-white/70 hover:border-white/15 hover:bg-white/[0.02]",
                ]}
                data-bait-name={baitName}
                data-is-free={isFree ? "true" : "false"}
                data-is-guaranteed={isGuaranteed ? "true" : "false"}
                title={
                  isGuaranteed
                    ? `${baitName} (${t("sfl.fishing.card.guaranteed") || "Garantizado 100%"})`
                    : isFree
                      ? `${baitName} (${t("sfl.fishing.card.freeCompost") || "Gratis / Compost"})`
                      : baitName
                }
              >
                <img
                  src={bImg}
                  alt={baitName}
                  class="w-3.5 h-3.5 object-contain [image-rendering:pixelated] shrink-0"
                  loading="lazy"
                />
                <span class="bait-label font-medium">{baitName}</span>
                {isFree && (
                  <span class="text-[9px] font-mono text-emerald-400/80 ml-0.5">0★</span>
                )}
                {isGuaranteed && (
                  <span class="text-[9px] font-mono text-emerald-300/90 bg-emerald-500/10 px-1 py-0.2 rounded border border-emerald-500/20 ml-0.5" title={t("sfl.fishing.card.guaranteed") || "Garantizado (100%)"}>100%</span>
                )}
              </button>
            )
          })}
        </div>
      </div>
    )}

    <!-- SECCIÓN CONTEXTUAL 2: CHUM INTERACTIVO (para rod y trap) -->
    {kind !== "marvel" && item.chum && item.chum.length > 0 && (
      <div class="mb-2.5 chum-section transition-opacity duration-200">
        <span class="text-[10px] font-mono uppercase tracking-wider text-white/40 block mb-1 font-medium">
          {t("sfl.fishing.card.chum")}
        </span>
        <div class="flex flex-wrap gap-1.5 chum-container">
          {item.chum.map((c: { item: string; amount: number }) => {
            const imgPath = itemImageMap[c.item] || `/img/sunflowerland/${c.item}.png`
            const fishGuarantees = guaranteedChumCombos[item.name] || {}
            const validBaits = fishGuarantees[c.item] || []
            const isGuaranteedCombo = validBaits.length > 0
            const validBaitsAttr = validBaits.join(",")

            return (
              <button
                type="button"
                class="chum-badge group/chum inline-flex items-center gap-1.5 px-2 py-1 rounded-lg bg-[#0e0e11] border border-white/5 hover:border-white/15 hover:bg-white/[0.02] text-[11px] font-mono text-white/70 transition-all cursor-pointer select-none"
                data-chum-name={c.item}
                data-chum-amount={c.amount.toString()}
                data-guaranteed-baits={validBaitsAttr}
                title={`${c.amount}x ${c.item}${isGuaranteedCombo ? " (Garantizado 100% con cebo compatible)" : ""}`}
              >
                <img
                  src={imgPath}
                  alt={c.item}
                  class="w-3.5 h-3.5 object-contain [image-rendering:pixelated] shrink-0"
                  loading="lazy"
                />
                <span class="chum-label font-medium text-white/90">
                  {c.amount}x {c.item}
                </span>
                {isGuaranteedCombo && (
                  <span
                    class="chum-guaranteed-badge text-[9px] font-mono text-emerald-300/90 bg-emerald-500/10 px-1 py-0.2 rounded border border-emerald-500/20 hidden ml-0.5"
                    title={t("sfl.fishing.card.guaranteed") || "Garantizado (100%)"}
                  >
                    100%
                  </span>
                )}
                <span class="chum-check text-[10px] text-white/70 hidden ml-0.5">✓</span>
              </button>
            )
          })}
        </div>
      </div>
    )}

    <!-- SECCIÓN CONTEXTUAL 3: MARINE MARVEL DETAILS (Map Triggers) -->
    {kind === "marvel" && (
      <div class="mb-2.5">
        <!-- Peces que dropean Mapas (Prioridad máxima en Maravillas Marinas) -->
        {item.mapTriggers && item.mapTriggers.length > 0 && (
          <div class="mb-2">
            <div class="flex items-center gap-1.5 mb-2">
              <img
                src="/img/sunflowerland/fish/a/map_marine.webp"
                alt="Map"
                class="w-3.5 h-3.5 object-contain [image-rendering:pixelated] opacity-70"
                loading="lazy"
              />
              <span class="text-[10px] font-mono uppercase tracking-wider text-white/40 font-medium">
                {t("sfl.fishing.card.mapTriggers")}
              </span>
            </div>
            <div class="space-y-1.5 map-trigger-container">
              {item.mapTriggers.map((trig: { fish: string; odds: number }, tIdx: number) => {
                const fishObj = fishMap.get(trig.fish.toLowerCase())
                const fImg = fishObj?.image || `/img/sunflowerland/fish/${trig.fish}.png`
                const guaranteedBait = fishObj?.guaranteedBy
                const gBaitImg = guaranteedBait ? (baitImageMap[guaranteedBait] || "/img/sunflowerland/Capsule Bait.png") : null
                const isDefaultTrigger = tIdx === 0

                return (
                  <button
                    type="button"
                    class:list={[
                      "map-trigger-row group/trigger w-full text-left flex items-center justify-between gap-2 p-1.5 rounded-xl border transition-all cursor-pointer select-none",
                      isDefaultTrigger
                        ? "active bg-white/[0.05] border-white/20 text-white shadow-sm"
                        : "bg-[#0e0e11] border-white/5 text-white/70 hover:border-white/15 hover:bg-white/[0.02]",
                    ]}
                    data-fish-name={trig.fish}
                    data-bait-name={guaranteedBait || ""}
                    data-base-odds={(trig.odds * 100).toFixed(1)}
                    data-odds={(trig.odds * 100).toFixed(1)}
                  >
                    <!-- Izquierda: Cebo del Fish Market (o Caña base) -->
                    <div class="flex items-center gap-2 min-w-0">
                      {guaranteedBait ? (
                        <div class="flex items-center gap-1.5 shrink-0 bg-white/[0.03] px-1.5 py-0.5 rounded-md border border-white/5" title={`Cebo 100% garantizado: ${guaranteedBait}`}>
                          <img
                            src={gBaitImg}
                            alt={guaranteedBait}
                            class="w-3.5 h-3.5 object-contain [image-rendering:pixelated]"
                            loading="lazy"
                          />
                          <span class="text-[10px] font-medium text-white/80">
                            {guaranteedBait}
                          </span>
                        </div>
                      ) : (
                        <span class="text-[9px] text-white/30 italic px-1 shrink-0">Caña</span>
                      )}

                      <!-- Flecha separadora -->
                      <span class="text-white/20 text-[10px]">➔</span>

                      <!-- Pez objetivo que dropea el mapa -->
                      <div class="flex items-center gap-1.5 min-w-0">
                        <img
                          src={fImg}
                          alt={trig.fish}
                          class="w-4 h-4 object-contain [image-rendering:pixelated] shrink-0"
                          loading="lazy"
                        />
                        <span class="text-white/90 font-medium truncate text-[11px] leading-tight">
                          {trig.fish}
                        </span>
                      </div>
                    </div>

                    <!-- Derecha: Probabilidad de dropeo de mapa -->
                    <div class="map-odds-badge flex items-center gap-1 px-1.5 py-0.5 rounded-md bg-white/[0.03] border border-white/10 text-white/70 font-mono text-[10px] shrink-0 transition-all" title={`${(trig.odds * 100).toFixed(1)}% prob. fragmento de mapa`}>
                      <img
                        src="/img/sunflowerland/fish/a/map_marine.webp"
                        alt="Map"
                        class="w-3.5 h-3.5 object-contain [image-rendering:pixelated] opacity-70"
                        loading="lazy"
                      />
                      <span class="map-odds-val font-medium">{(trig.odds * 100).toFixed(1)}%</span>
                    </div>
                  </button>
                )
              })}
            </div>
          </div>
        )}

        <!-- Micro-botón discreto para abrir popup de Captura Directa -->
        {(allBaits.length > 0 || (item.chum && item.chum.length > 0)) && (
          <div class="flex items-center justify-end mt-1 pt-1 border-t border-white/[0.04]">
            <button
              type="button"
              class="open-direct-catch-modal group/btn inline-flex items-center gap-1 text-[9px] font-mono text-white/30 hover:text-white/70 transition-colors cursor-pointer select-none py-0.5 px-1.5 rounded hover:bg-white/[0.03]"
              title={t("sfl.fishing.card.marvelDirectCatchToggle")}
              data-modal-id={`modal-direct-${item.name.toLowerCase().replace(/[^a-z0-9]/g, '-')}`}
            >
              <span class="text-[9px] text-white/30 group-hover/btn:text-amber-300/80">⚠️</span>
              <span class="text-[10px] leading-none transition-transform group-hover/btn:translate-x-0.5 text-white/30">➔</span>
            </button>
          </div>

          <!-- Popup / Modal de Captura Directa -->
          <dialog
            id={`modal-direct-${item.name.toLowerCase().replace(/[^a-z0-9]/g, '-')}`}
            class="direct-catch-dialog bg-[#0e0e11] text-white border border-white/10 rounded-2xl p-5 max-w-sm w-[90vw] shadow-2xl backdrop:bg-black/80 backdrop:backdrop-blur-sm m-auto"
          >
            <div class="flex items-start justify-between gap-3 pb-3 border-b border-white/10">
              <div class="flex items-center gap-2.5 min-w-0">
                <div class="w-9 h-9 rounded-lg bg-black/50 border border-white/10 flex items-center justify-center p-1 shrink-0">
                  <img
                    src={item.image}
                    alt={item.name}
                    class="w-full h-full object-contain [image-rendering:pixelated]"
                  />
                </div>
                <div class="min-w-0">
                  <h4 class="text-xs font-bold text-white truncate">{item.name}</h4>
                  <span class="text-[10px] font-mono font-semibold text-amber-400 flex items-center gap-1">
                    <span>⚠️</span>
                    <span>{t("sfl.fishing.card.marvelDirectCatchToggle")}</span>
                  </span>
                </div>
              </div>
              <button
                type="button"
                class="close-direct-dialog text-white/40 hover:text-white p-1 rounded hover:bg-white/10 transition-colors text-xs font-mono"
                aria-label="Cerrar"
              >
                ✕
              </button>
            </div>

            <p class="text-[10px] font-mono text-white/60 my-3 leading-relaxed">
              {t("sfl.fishing.card.marvelDirectCatchDesc")}
            </p>

            <div class="space-y-3">
              {allBaits.length > 0 && (
                <div>
                  <span class="text-[9px] font-mono uppercase tracking-wider text-white/40 block mb-1.5">
                    {t("sfl.fishing.card.bait")}
                  </span>
                  <div class="flex flex-wrap gap-1.5">
                    {allBaits.map((baitName: string) => {
                      const bImg = baitImageMap[baitName] || "/img/sunflowerland/Capsule Bait.png"
                      const isFree = ["Earthworm", "Grub", "Red Wiggler"].includes(baitName)
                      return (
                        <div class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-white/[0.04] border border-white/10 text-[11px] font-mono text-white/80">
                          <img
                            src={bImg}
                            alt={baitName}
                            class="w-3.5 h-3.5 object-contain [image-rendering:pixelated] shrink-0"
                            loading="lazy"
                          />
                          <span>{baitName}</span>
                          {isFree && (
                            <span class="text-[9px] font-bold text-emerald-400 ml-0.5">0★</span>
                          )}
                        </div>
                      )
                    })}
                  </div>
                </div>
              )}

              {item.chum && item.chum.length > 0 && (
                <div>
                  <span class="text-[9px] font-mono uppercase tracking-wider text-white/40 block mb-1.5">
                    {t("sfl.fishing.card.chum")}
                  </span>
                  <div class="flex flex-wrap gap-1.5">
                    {item.chum.map((c: { item: string; amount: number }) => {
                      const imgPath = itemImageMap[c.item] || `/img/sunflowerland/${c.item}.png`
                      return (
                        <div class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-white/[0.04] border border-white/10 text-[11px] font-mono text-white/80">
                          <img
                            src={imgPath}
                            alt={c.item}
                            class="w-3.5 h-3.5 object-contain [image-rendering:pixelated] shrink-0"
                            loading="lazy"
                          />
                          <span>{c.amount}x {c.item}</span>
                        </div>
                      )
                    })}
                  </div>
                </div>
              )}
            </div>
          </dialog>
        )}
      </div>
    )}

    <!-- SECCIÓN CONTEXTUAL 4: TRAMPAS DE AGUA (Trampa Requerida & Receta) -->
    {kind === "trap" && (
      <div class="mb-2.5">
        <span class="text-[10px] font-mono uppercase tracking-wider text-white/40 block mb-1">
          {t("sfl.fishing.card.trapType") || "Trampa requerida:"}
        </span>
        <div class="p-2.5 rounded-xl bg-orange-500/10 border border-orange-500/20 flex items-center justify-between gap-2.5">
          <div class="flex items-center gap-2.5 min-w-0">
            <div class="w-9 h-9 rounded-lg bg-black/40 border border-white/5 flex items-center justify-center p-1 shrink-0">
              <img
                src={item.trap === "Mariner Pot" ? "/img/sunflowerland/tools/Mariner Pot.png" : "/img/sunflowerland/tools/Crab Pot.png"}
                alt={item.trap}
                class="w-full h-full object-contain [image-rendering:pixelated]"
                loading="lazy"
              />
            </div>
            <div class="min-w-0">
              <span class="text-xs font-mono font-bold text-orange-300 block truncate">
                {item.trap}
              </span>
              <span class="text-[10px] font-mono text-white/60 block truncate">
                {item.trap === "Mariner Pot" ? "10x Feather • 10x Merino Wool • 500 Coins" : "5x Feather • 3x Wool • 250 Coins"}
              </span>
            </div>
          </div>
          <div class="trap-cost-val text-[11px] font-mono font-bold text-amber-400 bg-white/5 px-2 py-1 rounded-md border border-white/10 shrink-0 flex items-center gap-1">
            <img src="/img/sunflowerland/flower.jpg" alt="FLOWER" class="w-3.5 h-3.5 rounded-full object-cover shrink-0 -translate-y-px" />
            <span class="trap-val-num">--</span>
          </div>
        </div>
      </div>
    )}
  </div>
</div>

