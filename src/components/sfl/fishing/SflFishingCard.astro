---
import { getLangFromUrl, useTranslations } from "../../../i18n/utils"

export interface Props {
  item: any
  kind: "rod" | "trap" | "marvel" | "market"
}

const { item, kind } = Astro.props
const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)

// Mapeo seguro de imágenes de insumos de Chum e ingredientes
const itemImageMap: Record<string, string> = {
  "Anchovy": "/img/sunflowerland/fish/Anchovy.png",
  "Apple": "/img/sunflowerland/Apple.png",
  "Artichoke": "/img/sunflowerland/Artichoke.png",
  "Banana": "/img/sunflowerland/Banana.png",
  "Beetroot": "/img/sunflowerland/Beetroot.png",
  "Blueberry": "/img/sunflowerland/Blueberry.png",
  "Broccoli": "/img/sunflowerland/Broccoli.png",
  "Cabbage": "/img/sunflowerland/Cabbage.png",
  "Carrot": "/img/sunflowerland/Carrot.png",
  "Chewed Bone": "/img/sunflowerland/Chewed Bone.png",
  "Corn": "/img/sunflowerland/Corn.png",
  "Crab": "/img/sunflowerland/fish/a/Crab.png",
  "Crab Stick": "/img/sunflowerland/fish/a/Crab Stick.png",
  "Crimstone": "/img/sunflowerland/Crimstone.png",
  "Dewberry": "/img/sunflowerland/Dewberry.png",
  "Duskberry": "/img/sunflowerland/Duskberry.png",
  "Egg": "/img/sunflowerland/Egg.png",
  "Eggplant": "/img/sunflowerland/Eggplant.png",
  "Fat Chicken": "/img/sunflowerland/powerups/fat_chicken.webp",
  "Fish Oil": "/img/sunflowerland/fish/a/fish_oil.webp",
  "Fish Stick": "/img/sunflowerland/fish/a/fish_stick.webp",
  "Fish Flake": "/img/sunflowerland/fish/a/fish_flake.webp",
  "Frost Pebble": "/img/sunflowerland/Frost Pebble.png",
  "Gold": "/img/sunflowerland/Gold.png",
  "Grape": "/img/sunflowerland/Grape.png",
  "Heart leaf": "/img/sunflowerland/Heart leaf.png",
  "Heart Leaf": "/img/sunflowerland/Heart leaf.png",
  "Honey": "/img/sunflowerland/Honey.png",
  "Horse Mackerel": "/img/sunflowerland/fish/Horse Mackerel.png",
  "Iron": "/img/sunflowerland/Iron.png",
  "Kale": "/img/sunflowerland/Kale.png",
  "Lunara": "/img/sunflowerland/Lunara.png",
  "Moonfur": "/img/sunflowerland/Moonfur.png",
  "Onion": "/img/sunflowerland/Onion.png",
  "Orange": "/img/sunflowerland/Orange.png",
  "Pepper": "/img/sunflowerland/Pepper.png",
  "Red Snapper": "/img/sunflowerland/fish/Red Snapper.png",
  "Rhubarb": "/img/sunflowerland/Rhubarb.png",
  "Ribbon": "/img/sunflowerland/Ribbon.png",
  "Rice": "/img/sunflowerland/Rice.png",
  "Rich Chicken": "/img/sunflowerland/powerups/rich_chicken.webp",
  "Ruffroot": "/img/sunflowerland/Ruffroot.png",
  "Seaweed": "/img/sunflowerland/fish/a/seaweed.webp",
  "Speed Chicken": "/img/sunflowerland/powerups/speed_chicken.webp",
  "Squid": "/img/sunflowerland/fish/Squid.png",
  "Sunfish": "/img/sunflowerland/fish/Sunfish.png",
  "Sunflower": "/img/sunflowerland/Sunflower.png",
  "Tuna": "/img/sunflowerland/fish/Tuna.png",
  "Turnip": "/img/sunflowerland/Turnip.png",
  "Wheat": "/img/sunflowerland/Wheat.png",
  "Wild Grass": "/img/sunflowerland/Wild Grass.png",
  "Wild Mushroom": "/img/sunflowerland/123/wild_mushroom.webp",
  "Yam": "/img/sunflowerland/Yam.png",
  "Zebra Turkeyfish": "/img/sunflowerland/fish/Zebra Turkeyfish.png",
  "Zucchini": "/img/sunflowerland/Zucchini.png",
  "Blue Crab": "/img/sunflowerland/fish/crabs/Blue Crab.png",
  "Hermit Crab": "/img/sunflowerland/fish/crabs/Hermit Crab.png",
  "Sea Slug": "/img/sunflowerland/fish/crabs/Sea Slug.png",
  "Mussel": "/img/sunflowerland/fish/crabs/Mussel.png",
  "Isopod": "/img/sunflowerland/fish/crabs/Isopod.png",
  "Sea Snail": "/img/sunflowerland/fish/crabs/Sea Snail.png",
  "Shrimp": "/img/sunflowerland/fish/crabs/Shrimp.png",
  "Lobster": "/img/sunflowerland/fish/crabs/Lobster.png",
  "Barnacle": "/img/sunflowerland/fish/crabs/Barnacle.png",
  "Oyster": "/img/sunflowerland/fish/crabs/Oyster.png",
  "Garden Eel": "/img/sunflowerland/fish/crabs/Garden Eel.png",
}

const baitImageMap: Record<string, string> = {
  "Earthworm": "/img/sunflowerland/fish/a/Earthworm.png",
  "Capsule Bait": "/img/sunflowerland/Capsule Bait.png",
  "Grub": "/img/sunflowerland/fish/a/Grub.png",
  "Red Wiggler": "/img/sunflowerland/fish/a/Red Wiggler.png",
  "Fishing Lure": "/img/sunflowerland/fish/a/Fishing Lure.png",
  "Crimson Baitfish": "/img/sunflowerland/Crimson Baitfish.png",
  "Umbrella Bait": "/img/sunflowerland/Umbrella Bait.png",
  "Fish Flake": "/img/sunflowerland/fish/a/fish_flake.webp",
  "Fish Stick": "/img/sunflowerland/fish/a/fish_stick.webp",
  "Fish Oil": "/img/sunflowerland/fish/a/fish_oil.webp",
  "Crab Stick": "/img/sunflowerland/fish/a/Crab Stick.png",
}

const seasonIcons: Record<string, { label: string; icon: string }> = {
  spring: { label: t("sfl.fishing.season.spring"), icon: "/img/sunflowerland/123/primavera.webp" },
  summer: { label: t("sfl.fishing.season.summer"), icon: "/img/sunflowerland/123/verano.webp" },
  autumn: { label: t("sfl.fishing.season.autumn"), icon: "/img/sunflowerland/123/otono.webp" },
  winter: { label: t("sfl.fishing.season.winter"), icon: "/img/sunflowerland/123/invierno.webp" },
}

// Configuración visual por tier / categoría
const tierVisuals: Record<string, { label: string; badgeClass: string; glowClass?: string }> = {
  basic: {
    label: t("sfl.fishing.filter.basic"),
    badgeClass: "bg-emerald-500/10 text-emerald-400 border-emerald-500/20",
  },
  advanced: {
    label: t("sfl.fishing.filter.advanced"),
    badgeClass: "bg-sky-500/10 text-sky-400 border-sky-500/20",
  },
  expert: {
    label: t("sfl.fishing.filter.expert"),
    badgeClass: "bg-purple-500/10 text-purple-400 border-purple-500/20",
  },
  trap: {
    label: t("sfl.fishing.filter.trap"),
    badgeClass: "bg-orange-500/10 text-orange-400 border-orange-500/20",
  },
  marvel: {
    label: t("sfl.fishing.filter.marvel"),
    badgeClass: "bg-amber-500/15 text-amber-300 border-amber-500/30",
    glowClass: "bg-amber-500/10",
  },
  market: {
    label: t("sfl.fishing.filter.market"),
    badgeClass: "bg-teal-500/10 text-teal-300 border-teal-500/20",
    glowClass: "bg-teal-500/10",
  },
}

const visualKey = kind === "rod" ? (item.tier || "basic") : kind
const visual = tierVisuals[visualKey] || tierVisuals.basic

// Preparar datos para atributos HTML de filtrado
const filterTier = kind === "rod" ? item.tier : kind
const filterSeasons = (item.seasons || ["spring", "summer", "autumn", "winter"]).join(" ")
const filterBaits = (item.baits || []).join(" ").toLowerCase()
const filterChum = (item.chum || []).map((c: any) => c.item).join(" ").toLowerCase()
const filterGuaranteed = item.guaranteedBy ? item.guaranteedBy.toLowerCase() : ""
---

<div
  class="fish-card group bg-[#18181b]/90 border border-white/10 hover:border-cyan-400/30 rounded-2xl p-4 transition-all duration-300 flex flex-col justify-between hover:shadow-xl hover:shadow-black/60 relative overflow-hidden"
  data-tier={filterTier}
  data-kind={kind}
  data-seasons={filterSeasons}
  data-name={item.name.toLowerCase()}
  data-bait={filterBaits}
  data-chum={filterChum}
  data-guaranteed={filterGuaranteed}
>
  <!-- Glow temático -->
  {visual.glowClass && (
    <div class:list={["absolute -right-8 -top-8 w-24 h-24 rounded-full blur-xl pointer-events-none", visual.glowClass]}></div>
  )}

  <div>
    <!-- Encabezado: Tier / Categoría + XP o Nivel -->
    <div class="flex items-center justify-between gap-2 mb-3">
      <span class:list={["text-[10px] font-mono uppercase tracking-wider font-bold px-2 py-0.5 rounded-md border", visual.badgeClass]}>
        {visual.label}
      </span>

      {kind === "rod" && (
        <span class="text-[11px] font-mono text-emerald-400 font-bold bg-emerald-500/10 px-2 py-0.5 rounded-md border border-emerald-500/20">
          +{item.xp} XP
        </span>
      )}

      {kind === "trap" && (
        <span class="text-[10px] font-mono text-orange-300 font-bold bg-orange-500/10 px-2 py-0.5 rounded-md border border-orange-500/20">
          Lvl {item.requiredBumpkinLevel} • {item.readyTimeHours}h
        </span>
      )}

      {kind === "marvel" && (
        <span class="text-[10px] font-mono text-amber-300 font-bold bg-amber-500/10 px-2 py-0.5 rounded-md border border-amber-500/20 uppercase tracking-wider">
          {item.chapter || t("sfl.fishing.card.permanent")}
        </span>
      )}

      {kind === "market" && (
        <span class="text-[10px] font-mono text-teal-300 font-bold bg-teal-500/10 px-2 py-0.5 rounded-md border border-teal-500/20">
          ⏱ {item.craftTimeHours}h
        </span>
      )}
    </div>

    <!-- Imagen, Nombre y Estaciones -->
    <div class="flex items-center gap-3.5 mb-3.5">
      <div class="w-14 h-14 rounded-xl bg-black/40 border border-white/5 flex items-center justify-center p-1.5 shrink-0 group-hover:scale-105 transition-transform">
        <img
          src={item.image}
          alt={item.name}
          loading="lazy"
          class="w-full h-full object-contain [image-rendering:pixelated] drop-shadow-md"
          onerror="this.src='/img/sunflowerland/fish/Anchovy.png'; this.classList.add('opacity-30')"
        />
      </div>

      <div class="min-w-0 flex-1">
        <h3 class="text-sm font-bold text-white group-hover:text-cyan-400 transition-colors truncate">
          {item.name}
        </h3>

        <!-- Iconos de Estaciones Climáticas (si aplica) -->
        {item.seasons && item.seasons.length > 0 && (
          <div class="flex items-center gap-1 mt-1">
            {item.seasons.map((sKey: string) => {
              const sObj = seasonIcons[sKey]
              return (
                <span title={sObj?.label || sKey} class="inline-flex items-center">
                  <img src={sObj?.icon} alt={sObj?.label || sKey} class="w-3.5 h-3.5 object-contain" />
                </span>
              )
            })}
          </div>
        )}

        <!-- Subtítulo contextual -->
        {kind === "trap" && (
          <span class="text-[10px] font-mono text-white/50 block mt-0.5">
            {item.trap}
          </span>
        )}
        {kind === "market" && (
          <span class="text-[10px] font-mono text-teal-400/80 block mt-0.5">
            {t("sfl.fishing.card.method.market")}
          </span>
        )}
        {kind === "marvel" && item.inTime && (
          <span class="text-[9px] font-mono text-amber-400/70 block mt-0.5">
            {item.inTime.start} → {item.inTime.end}
          </span>
        )}
      </div>
    </div>

    <!-- Costo Estimado de Intento (Calculadora Dinámica) -->
    <div class="mb-3 p-2.5 rounded-xl bg-white/[0.02] border border-white/[0.05] flex flex-col gap-1.5 transition-colors">
      <div class="flex items-center justify-between">
        <span class="text-[10px] font-mono uppercase tracking-wider text-white/50">
          {t("sfl.fishing.card.cost")}
        </span>
        <div class="flex items-center gap-1.5">
          <span class="cost-flower-val text-xs font-mono font-bold text-amber-400">
            -- FLOWER
          </span>
          <span class="cost-usd-val text-[10px] font-mono text-white/40">
            (--)
          </span>
        </div>
      </div>

      <div class="pt-1 border-t border-white/[0.04] text-[10px] font-mono">
        <span class="cost-breakdown-label text-white/70 block truncate">
          {kind === "trap" ? t("sfl.fishing.card.breakdownTrap") : kind === "market" ? t("sfl.fishing.card.breakdownMarket") : t("sfl.fishing.card.breakdownBase")}
        </span>
      </div>
    </div>

    <!-- SECCIÓN CONTEXTUAL 1: ROD FISH (Cebos y Garantías) -->
    {kind === "rod" && (
      <div class="mb-2.5">
        <span class="text-[10px] font-mono uppercase tracking-wider text-white/40 block mb-1">
          {t("sfl.fishing.card.bait")}
        </span>
        <div class="flex flex-wrap gap-1.5">
          {item.baits.map((baitName: string) => {
            const bImg = baitImageMap[baitName] || "/img/sunflowerland/Capsule Bait.png"
            return (
              <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-md bg-white/[0.03] border border-white/5 text-[11px] font-mono text-white/70">
                <img src={bImg} alt={baitName} class="w-3.5 h-3.5 object-contain [image-rendering:pixelated]" />
                <span>{baitName}</span>
              </span>
            )
          })}
        </div>
        {item.guaranteedBy && (
          <div class="mt-2 text-[10px] font-mono text-teal-400/90 flex items-center gap-1">
            <span class="text-white/40">{t("sfl.fishing.card.guaranteedBy")}</span>
            <span class="font-bold underline decoration-teal-500/40">{item.guaranteedBy}</span>
          </div>
        )}
      </div>
    )}

    <!-- SECCIÓN CONTEXTUAL 2: CHUM INTERACTIVO (para rod, trap y marvel) -->
    {item.chum && item.chum.length > 0 && (
      <div class="mb-2.5">
        <span class="text-[10px] font-mono uppercase tracking-wider text-white/40 block mb-1">
          {t("sfl.fishing.card.chum")}
        </span>
        <div class="flex flex-wrap gap-1.5">
          {item.chum.map((c: { item: string; amount: number }) => {
            const imgPath = itemImageMap[c.item] || `/img/sunflowerland/${c.item}.png`
            return (
              <button
                type="button"
                class="chum-badge group/chum inline-flex items-center gap-1.5 px-2 py-1 rounded-lg bg-white/[0.03] border border-white/5 hover:border-cyan-400/40 hover:bg-white/[0.06] text-[11px] font-mono text-white/70 transition-all cursor-pointer select-none"
                data-chum-name={c.item}
                data-chum-amount={c.amount.toString()}
                title={`${c.amount}x ${c.item}`}
              >
                <img
                  src={imgPath}
                  alt={c.item}
                  class="w-3.5 h-3.5 object-contain [image-rendering:pixelated] shrink-0"
                  loading="lazy"
                />
                <span class="chum-label font-medium text-white/90">
                  {c.amount}x {c.item}
                </span>
                <span class="chum-check text-[10px] text-cyan-400 hidden ml-0.5">✓</span>
              </button>
            )
          })}
        </div>
      </div>
    )}

    <!-- SECCIÓN CONTEXTUAL 3: MARINE MARVEL DETAILS (Buff, Map Puzzles, Triggers) -->
    {kind === "marvel" && (
      <div class="space-y-2 mb-2">
        <!-- Buff Pasivo o Trofeo -->
        {item.buff ? (
          <div class="p-2 rounded-lg bg-amber-500/10 border border-amber-500/20 text-amber-300 text-[11px] font-mono font-medium flex items-center gap-1.5">
            <span class="text-amber-400 text-sm">★</span>
            <span class="leading-tight">{item.buff}</span>
          </div>
        ) : (
          <div class="p-1.5 rounded-lg bg-white/[0.02] border border-white/[0.05] text-white/50 text-[10px] font-mono text-center">
            {t("sfl.fishing.card.trophy")}
          </div>
        )}

        <!-- Dificultad y Triggers de Mapas -->
        {item.mapTriggers && item.mapTriggers.length > 0 && (
          <div class="p-2 rounded-lg bg-white/[0.02] border border-white/[0.05] text-[10px] font-mono">
            <span class="text-white/40 block mb-1 uppercase tracking-wider">{t("sfl.fishing.card.mapTriggers")}</span>
            <div class="flex flex-wrap gap-1.5">
              {item.mapTriggers.map((trig: { fish: string; odds: number }) => (
                <span class="px-1.5 py-0.5 rounded bg-white/[0.03] border border-white/5 text-cyan-300">
                  {trig.fish}: <strong class="text-white">{(trig.odds * 100).toFixed(1)}%</strong>
                </span>
              ))}
            </div>
          </div>
        )}
      </div>
    )}

    <!-- SECCIÓN CONTEXTUAL 4: FISH MARKET DETAILS (Ingredientes y Capturas) -->
    {kind === "market" && (
      <div class="space-y-2 mb-2">
        <!-- Ingredientes Base -->
        <div class="p-2 rounded-lg bg-white/[0.02] border border-white/[0.05] text-[10px] font-mono">
          <span class="text-white/40 block mb-1 uppercase tracking-wider">{t("sfl.fishing.card.baseIngredients")}</span>
          <div class="flex flex-wrap gap-1.5">
            {Object.entries(item.baseIngredients).map(([name, qty]) => (
              <span class="px-1.5 py-0.5 rounded bg-white/[0.03] border border-white/5 text-amber-300">
                {qty}x {name}
              </span>
            ))}
          </div>
        </div>

        <!-- Capturas Garantizadas -->
        <div class="p-2 rounded-lg bg-teal-500/5 border border-teal-500/20 text-[10px] font-mono">
          <span class="text-teal-400 font-bold block mb-1">{t("sfl.fishing.card.guaranteedPool")}</span>
          <p class="text-white/70 line-clamp-2 leading-relaxed">
            {item.guaranteedCatchPool.join(", ")}
          </p>
        </div>
      </div>
    )}
  </div>
</div>

