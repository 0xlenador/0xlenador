---
import { getLangFromUrl, useTranslations } from "../../../i18n/utils"

export interface Props {
  items: any[]
}

const { items } = Astro.props
const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)

const seasonIcons: Record<string, { label: string; icon: string }> = {
  spring: { label: t("sfl.fishing.season.spring"), icon: "/img/sunflowerland/123/primavera.webp" },
  summer: { label: t("sfl.fishing.season.summer"), icon: "/img/sunflowerland/123/verano.webp" },
  autumn: { label: t("sfl.fishing.season.autumn"), icon: "/img/sunflowerland/123/otono.webp" },
  winter: { label: t("sfl.fishing.season.winter"), icon: "/img/sunflowerland/123/invierno.webp" },
}

const tierVisuals: Record<string, { label: string; badgeClass: string }> = {
  basic: {
    label: t("sfl.fishing.filter.basic"),
    badgeClass: "bg-emerald-500/10 text-emerald-400 border-emerald-500/20",
  },
  advanced: {
    label: t("sfl.fishing.filter.advanced"),
    badgeClass: "bg-sky-500/10 text-sky-400 border-sky-500/20",
  },
  expert: {
    label: t("sfl.fishing.filter.expert"),
    badgeClass: "bg-purple-500/10 text-purple-400 border-purple-500/20",
  },
  trap: {
    label: t("sfl.fishing.filter.trap"),
    badgeClass: "bg-orange-500/10 text-orange-400 border-orange-500/20",
  },
  marvel: {
    label: t("sfl.fishing.filter.marvel"),
    badgeClass: "bg-amber-500/15 text-amber-300 border-amber-500/30",
  },
}
---

<div id="fishTableContainer" class="hidden overflow-x-auto rounded-2xl border border-white/10 bg-[#121214] shadow-xl shadow-black/40 backdrop-blur-xl scrollbar-thin scrollbar-thumb-white/10 mb-8">
  <table class="w-full text-left border-collapse text-xs font-mono">
    <thead>
      <tr class="border-b border-white/10 bg-white/[0.03] text-white/50 text-[10px] uppercase tracking-wider">
        <th class="py-3 px-3.5 font-semibold">{t("sfl.fishing.table.fish")}</th>
        <th class="py-3 px-3 font-semibold">{t("sfl.fishing.table.type")}</th>
        <th class="py-3 px-3 font-semibold">{t("sfl.fishing.table.season")}</th>
        <th class="py-3 px-3 font-semibold">{t("sfl.fishing.table.bait")}</th>
        <th class="py-3 px-3 font-semibold text-right">{t("sfl.fishing.table.attemptCost")}</th>
        <th class="py-3 px-3 font-semibold text-center">{t("sfl.fishing.table.yield")}</th>
        <th class="py-3 px-3 font-semibold text-right text-cyan-300">{t("sfl.fishing.table.unitCost")}</th>
        <th class="py-3 px-3 font-semibold text-right">{t("sfl.fishing.table.xp")}</th>
        <th class="py-3 px-3.5 font-semibold text-right text-emerald-400">{t("sfl.fishing.table.xpRoi")}</th>
      </tr>
    </thead>
    <tbody id="fishTableBody" class="divide-y divide-white/5">
      {
        items.map((item, idx) => {
          const kind = item.kind
          const filterTier = kind === "rod" ? item.tier : kind
          const filterSeasons = (item.seasons || ["spring", "summer", "autumn", "winter"]).join(" ")
          const filterBaits = (item.baits || []).join(" ").toLowerCase()
          const filterChum = (item.chum || []).map((c: any) => c.item).join(" ").toLowerCase()
          const filterGuaranteed = item.guaranteedBy ? item.guaranteedBy.toLowerCase() : ""
          const visualKey = kind === "rod" ? (item.tier || "basic") : kind
          const visual = tierVisuals[visualKey] || tierVisuals.basic

          return (
            <tr
              class="fish-table-row hover:bg-white/[0.04] transition-colors"
              data-tier={filterTier}
              data-kind={kind}
              data-seasons={filterSeasons}
              data-name={item.name.toLowerCase()}
              data-raw-name={item.name}
              data-trap={item.trap || ""}
              data-bait={filterBaits}
              data-chum={filterChum}
              data-guaranteed={filterGuaranteed}
              data-chapter={item.chapter ? "chapters" : "permanent"}
              data-default-order={idx}
              data-xp={item.xp || 0}
              data-cost="999999"
            >
              <!-- Pez -->
              <td class="py-2.5 px-3.5">
                <div class="flex items-center gap-2.5">
                  <div class="w-8 h-8 rounded-lg bg-black/40 border border-white/5 flex items-center justify-center p-1 shrink-0">
                    <img src={item.image} alt={item.name} class="w-full h-full object-contain [image-rendering:pixelated]" loading="lazy" />
                  </div>
                  <div class="min-w-0">
                    <span class="font-bold text-white block truncate">{item.name}</span>
                  </div>
                </div>
              </td>

              <!-- Tipo / Tier -->
              <td class="py-2.5 px-3">
                <span class:list={["text-[10px] font-bold px-2 py-0.5 rounded border inline-block whitespace-nowrap", visual.badgeClass]}>
                  {visual.label}
                </span>
              </td>

              <!-- Estación -->
              <td class="py-2.5 px-3">
                <div class="flex items-center gap-1">
                  {item.seasons && item.seasons.length > 0 ? (
                    item.seasons.map((sKey: string) => {
                      const sObj = seasonIcons[sKey]
                      return sObj ? (
                        <span title={sObj.label} class="inline-flex items-center">
                          <img src={sObj.icon} alt={sObj.label} class="w-3.5 h-3.5 object-contain" />
                        </span>
                      ) : null
                    })
                  ) : (
                    <span class="text-white/30 text-[10px]">—</span>
                  )}
                </div>
              </td>

              <!-- Cebo / Insumo Activo -->
              <td class="py-2.5 px-3">
                <div class="table-bait-cell flex items-center gap-1.5 text-white/80">
                  <span class="table-bait-name text-xs text-white/70">
                    {kind === "trap" ? item.trap : (item.baits && item.baits[0]) || "Earthworm"}
                  </span>
                </div>
              </td>

              <!-- Costo Intento -->
              <td class="py-2.5 px-3 text-right">
                <div class="table-attempt-cost text-white/70">
                  <span class="table-attempt-num">--</span>
                  <span class="text-[10px] text-white/40 ml-0.5">🌸</span>
                </div>
              </td>

              <!-- Yield (x) -->
              <td class="py-2.5 px-3 text-center">
                <span class="table-yield-val text-cyan-400 font-bold text-[11px]">1.00x</span>
              </td>

              <!-- Costo Efectivo / Pez -->
              <td class="py-2.5 px-3 text-right">
                <div class="font-bold text-amber-300">
                  <span class="cost-val-num">--</span>
                  <span class="text-[10px] text-amber-400 ml-0.5">🌸</span>
                </div>
                <div class="cost-usd-val text-[10px] text-white/40">(--)</div>
              </td>

              <!-- XP -->
              <td class="py-2.5 px-3 text-right">
                {kind === "rod" && (
                  <span class="text-emerald-400 font-bold">+{item.xp} XP</span>
                )}
                {kind === "trap" && (
                  <span class="text-orange-300 font-bold">Lvl {item.requiredBumpkinLevel}</span>
                )}
                {kind === "marvel" && (
                  <span class="text-amber-300 font-bold">{item.buff || "★"}</span>
                )}
              </td>

              <!-- XP / FLOWER (ROI) -->
              <td class="py-2.5 px-3.5 text-right font-bold text-emerald-400">
                <span class="table-roi-val">—</span>
              </td>
            </tr>
          )
        })
      }
    </tbody>
  </table>
</div>
