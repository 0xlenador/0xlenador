---
import { getLangFromUrl, useTranslations } from "../../../i18n/utils"

export interface Props {
  item: any
  kind: "rod" | "trap" | "marvel"
  index?: number
}

const { item, kind, index = 0 } = Astro.props
const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)

const seasonIcons: Record<string, { label: string; icon: string }> = {
  spring: { label: t("sfl.fishing.season.spring"), icon: "/img/sunflowerland/123/primavera.webp" },
  summer: { label: t("sfl.fishing.season.summer"), icon: "/img/sunflowerland/123/verano.webp" },
  autumn: { label: t("sfl.fishing.season.autumn"), icon: "/img/sunflowerland/123/otono.webp" },
  winter: { label: t("sfl.fishing.season.winter"), icon: "/img/sunflowerland/123/invierno.webp" },
}

const tierVisuals: Record<string, { label: string; badgeClass: string; borderClass: string }> = {
  basic: {
    label: t("sfl.fishing.filter.basic"),
    badgeClass: "bg-emerald-500/10 text-emerald-400 border-emerald-500/20",
    borderClass: "border-emerald-500/30",
  },
  advanced: {
    label: t("sfl.fishing.filter.advanced"),
    badgeClass: "bg-sky-500/10 text-sky-400 border-sky-500/20",
    borderClass: "border-sky-500/30",
  },
  expert: {
    label: t("sfl.fishing.filter.expert"),
    badgeClass: "bg-purple-500/10 text-purple-400 border-purple-500/20",
    borderClass: "border-purple-500/30",
  },
  trap: {
    label: t("sfl.fishing.filter.trap"),
    badgeClass: "bg-orange-500/10 text-orange-400 border-orange-500/20",
    borderClass: "border-orange-500/30",
  },
  marvel: {
    label: t("sfl.fishing.filter.marvel"),
    badgeClass: "bg-amber-500/15 text-amber-300 border-amber-500/30",
    borderClass: "border-amber-500/40",
  },
}

const visualKey = kind === "rod" ? (item.tier || "basic") : kind
const visual = tierVisuals[visualKey] || tierVisuals.basic

const allBaits = [...(item.baits || [])]
if (kind === "rod" && item.guaranteedBy && !allBaits.includes(item.guaranteedBy)) {
  allBaits.push(item.guaranteedBy)
}

const filterTier = kind === "rod" ? item.tier : kind
const filterSeasons = (item.seasons || ["spring", "summer", "autumn", "winter"]).join(" ")
const filterBaits = allBaits.join(" ").toLowerCase()
const filterChum = (item.chum || []).map((c: any) => c.item).join(" ").toLowerCase()
const filterGuaranteed = item.guaranteedBy ? item.guaranteedBy.toLowerCase() : ""

const defaultBaitName = allBaits[0] || (kind === "trap" ? item.trap : "Earthworm")
---

<div
  class="fish-card-compact group bg-[#18181b]/90 hover:bg-[#202025] border border-white/10 hover:border-cyan-400/30 rounded-xl p-2.5 transition-all duration-200 flex flex-col justify-between hover:shadow-lg hover:shadow-black/60 relative overflow-hidden"
  data-tier={filterTier}
  data-kind={kind}
  data-seasons={filterSeasons}
  data-name={item.name.toLowerCase()}
  data-raw-name={item.name}
  data-trap={item.trap || ""}
  data-bait={filterBaits}
  data-chum={filterChum}
  data-guaranteed={filterGuaranteed}
  data-chapter={item.chapter ? "chapters" : "permanent"}
  data-chapter-name={item.chapter || ""}
  data-default-order={index}
  data-xp={item.xp || 0}
  data-cost="999999"
>
  <div>
    <!-- Fila 1: Miniatura + Nombre + Tier -->
    <div class="flex items-center gap-2 mb-2">
      <div class:list={["w-8 h-8 rounded-lg bg-black/50 border p-1 shrink-0 flex items-center justify-center group-hover:scale-105 transition-transform", visual.borderClass]}>
        <img
          src={item.image}
          alt={item.name}
          loading="lazy"
          class="w-full h-full object-contain [image-rendering:pixelated]"
          onerror="this.src='/img/sunflowerland/fish/Anchovy.png'; this.classList.add('opacity-30')"
        />
      </div>

      <div class="min-w-0 flex-1">
        <h4 class="text-xs font-bold text-white group-hover:text-cyan-300 transition-colors truncate leading-tight">
          {item.name}
        </h4>
        <div class="flex items-center gap-1 mt-0.5">
          <span class:list={["text-[9px] font-mono font-semibold px-1.5 py-0.2 rounded border leading-none", visual.badgeClass]}>
            {visual.label}
          </span>
          {item.seasons && item.seasons.length > 0 && (
            <div class="flex items-center gap-0.5 ml-auto">
              {item.seasons.map((sKey: string) => {
                const sObj = seasonIcons[sKey]
                return sObj ? (
                  <img src={sObj.icon} alt={sObj.label} title={sObj.label} class="w-3 h-3 object-contain" />
                ) : null
              })}
            </div>
          )}
        </div>
      </div>
    </div>

    <!-- Fila 2: Métricas de Costo Financiero -->
    <div class="bg-black/30 border border-white/5 rounded-lg px-2 py-1 flex items-center justify-between mb-2">
      <div class="cost-flower-val font-mono font-bold text-amber-400 flex items-center gap-1 text-xs">
        <img src="/img/sunflowerland/flower.jpg" alt="FLOWER" class="w-3 h-3 rounded-full object-cover shrink-0 -translate-y-px" />
        <span class="cost-val-num">--</span>
      </div>
      <div class="flex items-center gap-1">
        <span class="yield-badge-val text-[10px] font-mono font-bold text-cyan-400"></span>
        <span class="cost-usd-val text-[10px] font-mono text-white/40">(--)</span>
      </div>
    </div>
  </div>

  <!-- Fila 3: Cebo Activo / Método & XP -->
  <div class="flex items-center justify-between gap-1 pt-1.5 border-t border-white/5 text-[10px] font-mono">
    <div class="flex items-center gap-1 min-w-0 truncate text-white/60">
      <img
        src={kind === "trap" ? (item.trap === "Mariner Pot" ? "/img/sunflowerland/tools/Mariner Pot.png" : "/img/sunflowerland/tools/Crab Pot.png") : "/img/sunflowerland/fish/a/Earthworm.png"}
        alt="Bait"
        class="compact-bait-img w-3.5 h-3.5 object-contain [image-rendering:pixelated] shrink-0"
      />
      <span class="compact-bait-name truncate">{defaultBaitName}</span>
    </div>

    {kind === "rod" && (
      <span class="text-emerald-400 font-bold shrink-0">
        +{item.xp} XP
      </span>
    )}
    {kind === "trap" && (
      <span class="text-orange-300 font-bold shrink-0">
        Lvl {item.requiredBumpkinLevel}
      </span>
    )}
    {kind === "marvel" && (
      <span class="text-amber-300 font-bold shrink-0 truncate max-w-[80px]" title={item.buff || "Maravilla"}>
        {item.buff ? "★ Buff" : "Decorativo"}
      </span>
    )}
  </div>
</div>
