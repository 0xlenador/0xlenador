---
/**
 * 0xLeñador — SflBoostsConfig.astro
 *
 * Componente modular y reutilizable para configurar Potenciadores (PowerUps),
 * Habilidades (Skills), Consumibles, Santuarios y Perks de Sunflower Land.
 *
 * Filtra automáticamente los buffs pertinentes según el prop `domain`:
 * - "cooking": Cocina, Fermentación, Bumpkin XP, Combustible Oil.
 * - "fishing": Carretes, Pesca, Cebos, Habilidades de Pesca, Fisher's Hourglass.
 * - "animals": Corrales, Producción, Reducción de Sueño, Habilidades de Animales.
 * - "mining": Minería, Nodos de Piedra/Hierro/Oro/Crimstone, Ore Hourglass.
 * - "all": Catálogo completo al 100% (para sfl-constantes).
 */
import {
  getAllBuffs,
  getCookingBuffs,
  getCaveBuffs,
  getFishingBuffs,
  getAnimalBuffs,
  getMiningBuffs,
  type BuffDefinition,
} from "../../../lib/sfl/buffs"
import { getEntry } from "astro:content"
import { getLangFromUrl, useTranslations } from "../../../i18n"

interface Props {
  domain?: "cooking" | "fishing" | "animals" | "mining" | "cave" | "all"
  class?: string
  idPrefix?: string
  defaultOpen?: boolean
}

const {
  domain = "all",
  class: className = "",
  idPrefix = "sfl-boosts",
  defaultOpen = domain === "cooking",
} = Astro.props

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)

const sflSkillsEntry = await getEntry("sfl", "skills")
const sflPowerUpsEntry = await getEntry("sfl", "powerups")
const allSkillsData = sflSkillsEntry?.data || {}
const powerUpsData = sflPowerUpsEntry?.data?.power_ups || {}

// 1. Filtrar buffs según el dominio
let rawBuffs: BuffDefinition[] = []
let targetSkills: Record<string, any> = {}

if (domain === "cooking") {
  rawBuffs = getCookingBuffs()
  targetSkills = {
    ...(allSkillsData.Cooking || {}),
    ...(allSkillsData.Fishing?.["Fishy Feast"] ? { "Fishy Feast": allSkillsData.Fishing["Fishy Feast"] } : {}),
    ...(allSkillsData.Aging?.["Speedy Aging"] ? { "Speedy Aging": allSkillsData.Aging["Speedy Aging"] } : {}),
  }
} else if (domain === "cave") {
  rawBuffs = getCaveBuffs()
  targetSkills = allSkillsData.Cave || {}
} else if (domain === "fishing") {
  rawBuffs = getFishingBuffs()
  const fishingSkills = { ...(allSkillsData.Fishing || {}) }
  delete fishingSkills["Fishy Feast"] // Pertenece a cocina
  delete fishingSkills["Fishy Fortune"] // Entregas de Corale
  targetSkills = fishingSkills
} else if (domain === "animals") {
  rawBuffs = getAnimalBuffs()
  targetSkills = allSkillsData.Animals || {}
} else if (domain === "mining") {
  rawBuffs = getMiningBuffs()
  targetSkills = allSkillsData.Mining || {}
} else {
  // "all" — 100% de los buffs y skills de todos los árboles
  rawBuffs = getAllBuffs()
  for (const tree in allSkillsData) {
    Object.assign(targetSkills, allSkillsData[tree] || {})
  }
}

// 2. Agrupar por categorías
const powerups = rawBuffs.filter((b) => b.type === "collectible" || b.type === "wearable")
const skills = targetSkills
const consumables = rawBuffs.filter((b) => b.type === "consumable")
const shrines = rawBuffs.filter((b) => b.type === "shrine")
const others = rawBuffs.filter((b) => b.type === "other")

// Utilidades de formato
const formatDescription = (skill: any) => {
  let desc = skill.description || skill.boost || ""
  if (skill.mathematics_1?.calc_by_rank?.rank_1 !== undefined) {
    const m1 = skill.mathematics_1.calc_by_rank.rank_1
    desc = desc
      .replace("{math1}", m1)
      .replace("{math1_pct}", parseFloat((m1 * 100).toFixed(2)))
      .replace("{math1_days}", parseFloat((m1 / 86400000).toFixed(2)))
  }
  if (skill.mathematics_2?.calc_by_rank?.rank_1 !== undefined) {
    const m2 = skill.mathematics_2.calc_by_rank.rank_1
    desc = desc
      .replace("{math2}", m2)
      .replace("{math2_pct}", parseFloat((m2 * 100).toFixed(2)))
      .replace("{math2_days}", parseFloat((m2 / 86400000).toFixed(2)))
  }
  return desc
}

const getCompactText = (data: any, formattedDesc: string) => {
  let value = "?"
  if (!formattedDesc || typeof formattedDesc !== "string") return value
  const match = formattedDesc.match(/(?:^|\b|\s)([x+-]?\d+(?:\.\d+)?(?:%|x)?)/i)
  if (match) {
    value = match[1].trim()
    if (value.toLowerCase().endsWith("x")) value = "x" + value.slice(0, -1)
  }

  let effectType = ""
  const descLower = formattedDesc.toLowerCase()
  if (descLower.includes("prime")) effectType = " Prime"
  else if (descLower.includes("xp")) effectType = " XP"
  else if (descLower.includes("time") || descLower.includes("faster") || descLower.includes("speed"))
    effectType = " Time"
  else if (descLower.includes("yield") || descLower.includes("drop") || descLower.includes("food"))
    effectType = " Yield"

  let target = "All"
  if (data.mathematics_1) {
    if (data.mathematics_1.target_food && data.mathematics_1.target_food !== "all")
      target = data.mathematics_1.target_food
    else if (data.mathematics_1.target && data.mathematics_1.target !== "all")
      target = data.mathematics_1.target
  }
  if (data.building) target = data.building

  target = target.charAt(0).toUpperCase() + target.slice(1)
  return `${value}${effectType} [${target}] ${data.name}`
}

const getEffectType = (desc: string) => {
  if (!desc) return "other"
  const descLower = desc.toLowerCase()
  const effects = []
  if (
    descLower.includes("xp") ||
    descLower.includes("prime") ||
    descLower.includes("yield") ||
    (descLower.includes("food") && !descLower.includes("revenue"))
  )
    effects.push("xp")
  if (descLower.includes("time") || descLower.includes("faster") || descLower.includes("speed"))
    effects.push("time")
  return effects.length > 0 ? effects.join(" ") : "other"
}
---

<details
  class={`sfl-boosts-panel group bg-white/[0.02] border border-white/5 rounded-xl overflow-hidden mb-6 transition-all ${className}`}
  id={`${idPrefix}-panel`}
  data-domain={domain}
  open={defaultOpen ? true : undefined}
>
  <summary
    class="p-4 flex flex-wrap items-center justify-between gap-3 cursor-pointer select-none bg-gradient-to-r from-white/[0.03] to-transparent hover:bg-white/[0.05] transition-colors list-none [&::-webkit-details-marker]:hidden"
  >
    <div class="flex items-center gap-3">
      <svg
        class="w-4 h-4 text-emerald-400 transition-transform duration-200 group-open:rotate-90 shrink-0"
        viewBox="0 0 24 24"
        fill="currentColor"
      >
        <path d="M8 5v14l11-7z"></path>
      </svg>
      <h2 class="text-sm font-bold text-white uppercase tracking-wider inline-flex items-center">
        {t("sfl.boosts.title")}
      </h2>
    </div>

    <div
      class="text-[10px] text-white/40 font-mono group-open:hidden uppercase tracking-widest border border-white/10 px-2 py-1 rounded-md xl:ml-auto w-max"
    >
      {t("sfl.boosts.tapToExpand")}
    </div>

    <!-- Filtros de Vista (Detailed / Compact) y Efectos -->
    <div
      class="hidden group-open:xl:flex overflow-x-auto no-scrollbar w-full xl:w-auto pb-2 xl:pb-0 -mx-4 px-4 xl:mx-0 xl:px-0"
      onclick="event.preventDefault();"
    >
      <div class="flex items-center gap-3 w-max shrink-0 mx-auto xl:mx-0 xl:ml-auto">
        <div class="flex items-center gap-1 bg-[#06080A]/50 p-1 rounded-lg border border-white/5 shadow-inner">
          <button
            type="button"
            class="filter-boost-btn active px-4 py-1.5 rounded-md text-[10px] font-bold uppercase tracking-wider text-white/40 hover:text-white transition-all whitespace-nowrap shrink-0"
            data-filter="all"
          >
            {t("sfl.boosts.filterAll")}
          </button>
          <button
            type="button"
            class="filter-boost-btn px-4 py-1.5 rounded-md text-[10px] font-bold uppercase tracking-wider text-white/40 hover:text-white transition-all whitespace-nowrap shrink-0"
            data-filter="xp"
          >
            {t("sfl.boosts.filterXp")}
          </button>
          <button
            type="button"
            class="filter-boost-btn px-4 py-1.5 rounded-md text-[10px] font-bold uppercase tracking-wider text-white/40 hover:text-white transition-all whitespace-nowrap shrink-0"
            data-filter="time"
          >
            {t("sfl.boosts.filterTime")}
          </button>
        </div>

        <div class="flex items-center gap-1 bg-[#06080A]/50 p-1 rounded-lg border border-white/5 shadow-inner">
          <button
            type="button"
            class="view-switch-btn active px-4 py-1.5 rounded-md text-[10px] font-bold uppercase tracking-wider text-white/40 hover:text-white transition-all whitespace-nowrap shrink-0"
            data-action="detailed"
          >
            {t("sfl.boosts.viewDetailed")}
          </button>
          <button
            type="button"
            class="view-switch-btn px-4 py-1.5 rounded-md text-[10px] font-bold uppercase tracking-wider text-white/40 hover:text-white transition-all whitespace-nowrap shrink-0"
            data-action="compact"
          >
            {t("sfl.boosts.viewCompact")}
          </button>
        </div>
      </div>
    </div>
  </summary>

  <div class="p-4 pt-0 relative">
    <div id={`${idPrefix}-container`} class="boosts-container relative z-10" data-filter="all">
      <div class="flex flex-col items-start w-full mt-2">
        {/* 1. Sub-grupo: PowerUps (Collectibles & Wearables) */}
        {powerups.length > 0 && (
          <details class="group/sub w-full mb-1 open:mb-6" open>
            <summary class="flex items-center cursor-pointer text-xs font-bold text-white/60 uppercase tracking-wider mb-2 group-open/sub:mb-3 hover:text-emerald-400 transition-colors list-none select-none [&::-webkit-details-marker]:hidden">
              <svg class="w-2.5 h-2.5 mr-2 text-emerald-500/80 transition-transform duration-200 group-open/sub:rotate-90 shrink-0" viewBox="0 0 24 24" fill="currentColor">
                <path d="M8 5v14l11-7z"></path>
              </svg>
              {t("sfl.boosts.powerupsTitle")} ({powerups.length})
            </summary>
            <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 xl:grid-cols-7 gap-2 w-full pl-1">
              {powerups.map((buff) => {
                const isWearable = buff.type === "wearable"
                const strId = String(buff.id)
                const powerUpItem = isWearable ? powerUpsData.wearables?.[strId] : powerUpsData.collectibles?.[strId]
                const imgFile = powerUpItem?.image || buff.image || `${buff.name}.webp`
                const mainSrc = imgFile.startsWith("/")
                  ? imgFile
                  : isWearable
                    ? `/img/sunflowerland/powerups/wearables/${imgFile}`
                    : `/img/sunflowerland/powerups/${imgFile}`
                const fallbackSrc = `/img/cripto/sunflowerland.webp`
                const boostText = buff.raw?.boost || buff.description || ""
                const isDisabled = Boolean(powerUpItem?.disabled || buff.raw?.disabled)

                return (
                  <div
                    data-effect={getEffectType(boostText)}
                    class={`buff-card group flex items-center gap-2 bg-white/5 border border-white/5 rounded-lg p-1.5 transition-all ${
                      isDisabled
                        ? "opacity-30 grayscale cursor-not-allowed pointer-events-none"
                        : "cursor-pointer hover:border-emerald-500/30 hover:bg-emerald-500/10"
                    }`}
                    data-buff-id={strId}
                    style={isDisabled ? "pointer-events: none;" : ""}
                  >
                    <input
                      type="checkbox"
                      class="hidden buff-checkbox pointer-events-none w-3.5 h-3.5 rounded border-white/20 bg-white/5 text-emerald-500 focus:ring-emerald-500/50"
                      data-buff-id={strId}
                    />
                    <img
                      src={mainSrc}
                      class="w-6 h-6 object-contain drop-shadow-sm group-hover:scale-110 transition-transform shrink-0"
                      onerror={`this.onerror=null; this.src='${fallbackSrc}';`}
                      alt={buff.name}
                      title={boostText}
                      width="24"
                      height="24"
                      loading="lazy"
                      decoding="async"
                    />
                    <div class="flex flex-col normal-view min-w-0">
                      <span class="text-[10px] font-bold text-white group-[.active]:text-emerald-400 group-hover:text-emerald-400 transition-colors truncate">
                        {buff.name}
                      </span>
                      <span class="text-[9px] text-terminal-muted leading-tight line-clamp-2" title={boostText}>
                        {boostText}
                      </span>
                    </div>
                    <div class="hidden compact-view w-full">
                      <span
                        class="text-[9px] font-mono text-white/80 whitespace-nowrap overflow-hidden text-ellipsis group-[.active]:text-emerald-400 transition-colors"
                        title={boostText}
                      >
                        {getCompactText(buff.raw || buff, boostText)}
                      </span>
                    </div>
                  </div>
                )
              })}
            </div>
          </details>
        )}

        {/* 2. Sub-grupo: Habilidades Bumpkin (Skills) */}
        {Object.keys(skills).length > 0 && (
          <details class="group/sub w-full mb-1 open:mb-6" open>
            <summary class="flex items-center cursor-pointer text-xs font-bold text-white/60 uppercase tracking-wider mb-2 group-open/sub:mb-3 hover:text-blue-400 transition-colors list-none select-none [&::-webkit-details-marker]:hidden">
              <svg class="w-2.5 h-2.5 mr-2 text-blue-500/80 transition-transform duration-200 group-open/sub:rotate-90 shrink-0" viewBox="0 0 24 24" fill="currentColor">
                <path d="M8 5v14l11-7z"></path>
              </svg>
              {t("sfl.boosts.skillsTitle")} ({Object.keys(skills).length})
            </summary>
            <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 xl:grid-cols-7 gap-2 w-full pl-1">
              {Object.entries(skills).map(([skillName, skillData]: [string, any]) => {
                const mainSrc = skillData.image || `/img/cripto/sunflowerland.webp`
                const fallbackSrc = `/img/cripto/sunflowerland.webp`
                const formattedDesc = formatDescription(skillData)
                const safeId = skillName.replace(/\s+/g, "_")
                const ranksCount =
                  skillData.cost_by_rank && Object.keys(skillData.cost_by_rank).length > 0
                    ? Object.keys(skillData.cost_by_rank).length
                    : skillData.mathematics_1?.calc_by_rank
                      ? Object.keys(skillData.mathematics_1.calc_by_rank).length
                      : 1

                return (
                  <div
                    data-effect={getEffectType(formattedDesc)}
                    class={`skill-card is-skill flex flex-col bg-white/5 border border-white/5 rounded-lg p-1.5 transition-all group ${
                      skillData.disabled
                        ? "opacity-30 grayscale cursor-not-allowed"
                        : "hover:border-blue-500/30 hover:bg-blue-500/5 cursor-pointer"
                    }`}
                    data-skill-id={skillName}
                    data-type="skill"
                    data-math1={JSON.stringify(skillData.mathematics_1?.calc_by_rank || {})}
                    data-math2={JSON.stringify(skillData.mathematics_2?.calc_by_rank || {})}
                    style={skillData.disabled ? "pointer-events: none;" : ""}
                  >
                    <div class="flex items-start gap-2 mb-1.5 pointer-events-none">
                      <img
                        src={mainSrc}
                        class="w-6 h-6 object-contain drop-shadow-sm group-hover:scale-110 transition-transform shrink-0"
                        onerror={`this.onerror=null; this.src='${fallbackSrc}';`}
                        alt={skillName}
                        title={formattedDesc}
                        width="24"
                        height="24"
                        loading="lazy"
                        decoding="async"
                      />
                      <div class="flex flex-col normal-view min-w-0">
                        <span class="text-[10px] font-bold text-white group-[.active]:text-blue-400 transition-colors truncate">
                          {skillName}
                        </span>
                        <span
                          class="skill-description-text text-[9px] text-terminal-muted leading-tight line-clamp-2"
                          title={formattedDesc}
                          data-original={skillData.description}
                        >
                          {formattedDesc}
                        </span>
                      </div>
                      <div class="hidden compact-view w-full">
                        <span
                          class="compact-description-text text-[9px] font-mono text-white/80 whitespace-nowrap overflow-hidden text-ellipsis group-[.active]:text-blue-400 transition-colors"
                          title={formattedDesc}
                        >
                          {getCompactText(skillData, formattedDesc)}
                        </span>
                      </div>
                    </div>

                    {ranksCount > 1 && (
                      <div class="flex items-center justify-end gap-1.5 mt-auto pt-1 border-t border-white/5 skill-ranks-container">
                        {Array.from({ length: ranksCount }).map((_, idx) => (
                          <label class="flex items-center gap-1 cursor-pointer">
                            <input
                              type="checkbox"
                              class={`skill-rank-checkbox rank-input-${safeId} w-3 h-3 rounded-sm text-blue-500 bg-white/5 border-white/20 focus:ring-blue-500/50`}
                              data-skill-id={skillName}
                              data-rank={idx + 1}
                              value={idx + 1}
                            />
                            <span class="text-[9px] text-white/60 font-mono">{idx + 1}</span>
                          </label>
                        ))}
                      </div>
                    )}
                  </div>
                )
              })}
            </div>
          </details>
        )}

        {/* 3. Sub-grupo: Consumibles (Consumibles, Tótems y Santuarios) */}
        {(consumables.length > 0 || shrines.length > 0) && (
          <details class="group/sub w-full mb-1 open:mb-6" open>
            <summary class="flex items-center cursor-pointer text-xs font-bold text-white/60 uppercase tracking-wider mb-2 group-open/sub:mb-3 hover:text-orange-400 transition-colors list-none select-none [&::-webkit-details-marker]:hidden">
              <svg class="w-2.5 h-2.5 mr-2 text-orange-500/80 transition-transform duration-200 group-open/sub:rotate-90 shrink-0" viewBox="0 0 24 24" fill="currentColor">
                <path d="M8 5v14l11-7z"></path>
              </svg>
              {t("sfl.boosts.consumablesTitle")} ({consumables.length + shrines.length})
            </summary>
            <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 xl:grid-cols-7 gap-2 w-full pl-1">
              {consumables.map((item) => {
                const mainSrc = item.image || `/img/cripto/sunflowerland.webp`
                const fallbackSrc = `/img/cripto/sunflowerland.webp`
                const formattedDesc = formatDescription(item.raw || item)

                return (
                  <div
                    data-effect={getEffectType(formattedDesc)}
                    class="skill-card is-consumable flex flex-col bg-white/5 border border-white/5 rounded-lg p-1.5 transition-all group hover:border-amber-600/40 hover:bg-amber-600/10 cursor-pointer"
                    data-skill-id={item.name}
                    data-buff-id={item.id ? String(item.id) : undefined}
                    data-type="consumable"
                  >
                    <div class="flex items-start gap-2 mb-1.5 pointer-events-none">
                      <img
                        src={mainSrc}
                        class="w-6 h-6 object-contain drop-shadow-sm group-hover:scale-110 transition-transform shrink-0"
                        onerror={`this.onerror=null; this.src='${fallbackSrc}';`}
                        alt={item.name}
                        title={formattedDesc}
                        width="24"
                        height="24"
                        loading="lazy"
                        decoding="async"
                      />
                      <div class="flex flex-col normal-view min-w-0">
                        <span class="text-[10px] font-bold text-white group-[.active]:text-amber-400 transition-colors truncate">
                          {item.name}
                        </span>
                        <span class="skill-description-text text-[9px] text-terminal-muted leading-tight line-clamp-2" title={formattedDesc} data-original={formattedDesc}>
                          {formattedDesc}
                        </span>
                      </div>
                      <div class="hidden compact-view w-full">
                        <span
                          class="text-[9px] font-mono text-white/80 whitespace-nowrap overflow-hidden text-ellipsis group-[.active]:text-amber-400 transition-colors"
                          title={formattedDesc}
                        >
                          {getCompactText(item.raw || item, formattedDesc)}
                        </span>
                      </div>
                    </div>
                  </div>
                )
              })}

              {shrines.map((shrine) => {
                const imgFile = shrine.image || `${shrine.name}.webp`
                const mainSrc = imgFile.startsWith("/") ? imgFile : `/img/sunflowerland/shrines/${imgFile}`
                const fallbackSrc = `/img/cripto/sunflowerland.webp`
                const boostText = shrine.raw?.boost || shrine.description || ""

                return (
                  <div
                    data-effect={getEffectType(boostText)}
                    class="buff-card group flex items-center gap-2 cursor-pointer bg-white/5 border border-white/5 hover:border-orange-500/30 hover:bg-orange-500/10 rounded-lg p-1.5 transition-all"
                    data-buff-id={shrine.name}
                  >
                    <input
                      type="checkbox"
                      class="hidden buff-checkbox pointer-events-none w-3.5 h-3.5 rounded border-white/20 bg-white/5 text-orange-500 focus:ring-orange-500/50"
                      data-buff-id={shrine.name}
                    />
                    <img
                      src={mainSrc}
                      class="w-6 h-6 object-contain drop-shadow-sm group-hover:scale-110 transition-transform shrink-0"
                      onerror={`this.onerror=null; this.src='${fallbackSrc}';`}
                      alt={shrine.name}
                      title={boostText}
                      width="24"
                      height="24"
                      loading="lazy"
                      decoding="async"
                    />
                    <div class="flex flex-col normal-view min-w-0">
                      <span class="text-[10px] font-bold text-white group-[.active]:text-orange-400 group-hover:text-orange-400 transition-colors truncate">
                        {shrine.name}
                      </span>
                      <span class="text-[9px] text-terminal-muted leading-tight line-clamp-2" title={boostText}>
                        {boostText}
                      </span>
                    </div>
                    <div class="hidden compact-view w-full">
                      <span
                        class="text-[9px] font-mono text-white/80 whitespace-nowrap overflow-hidden text-ellipsis group-[.active]:text-orange-400 transition-colors"
                        title={boostText}
                      >
                        {getCompactText(shrine.raw || shrine, boostText)}
                      </span>
                    </div>
                  </div>
                )
              })}
            </div>
          </details>
        )}

        {/* 4. Sub-grupo: Global Phases & Perks (Coleccionables no vendibles, Oil, Factions, VIP) */}
        {others.length > 0 && (
          <details class="group/sub w-full mb-1 open:mb-6" open>
            <summary class="flex items-center cursor-pointer text-xs font-bold text-white/60 uppercase tracking-wider mb-2 group-open/sub:mb-3 hover:text-purple-400 transition-colors list-none select-none [&::-webkit-details-marker]:hidden">
              <svg class="w-2.5 h-2.5 mr-2 text-purple-500/80 transition-transform duration-200 group-open/sub:rotate-90 shrink-0" viewBox="0 0 24 24" fill="currentColor">
                <path d="M8 5v14l11-7z"></path>
              </svg>
              {t("sfl.boosts.othersTitle")} ({others.length})
            </summary>
            <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 xl:grid-cols-7 gap-2 w-full pl-1">
              {others.map((item) => {
                const mainSrc = item.image || `/img/cripto/sunflowerland.webp`
                const fallbackSrc = `/img/cripto/sunflowerland.webp`
                const formattedDesc = formatDescription(item.raw || item)
                const safeId = item.name.replace(/\s+/g, "_")
                const ranksCount = item.raw?.cost_by_rank
                  ? Object.keys(item.raw.cost_by_rank).length
                  : item.raw?.ranks
                    ? Object.keys(item.raw.ranks).length
                    : 1

                return (
                  <div
                    data-effect={getEffectType(formattedDesc)}
                    class="skill-card is-other flex flex-col bg-white/5 border border-white/5 rounded-lg p-1.5 transition-all group hover:border-purple-500/30 hover:bg-purple-500/5 cursor-pointer relative"
                    data-skill-id={item.name}
                    data-buff-id={item.id ? String(item.id) : undefined}
                    data-type="other"
                  >
                    <div class="flex items-start gap-2 mb-1.5 pointer-events-none">
                      <img
                        src={mainSrc}
                        class="w-6 h-6 object-contain drop-shadow-sm group-hover:scale-110 transition-transform shrink-0"
                        onerror={`this.onerror=null; this.src='${fallbackSrc}';`}
                        alt={item.name}
                        title={formattedDesc}
                        width="24"
                        height="24"
                        loading="lazy"
                        decoding="async"
                      />
                      <div class="flex flex-col normal-view min-w-0">
                        <span class="text-[10px] font-bold text-white group-[.active]:text-purple-400 transition-colors truncate">
                          {item.name}
                        </span>
                        <span class="skill-description-text text-[9px] text-terminal-muted leading-tight line-clamp-2" title={formattedDesc} data-original={formattedDesc}>
                          {formattedDesc}
                        </span>
                      </div>
                      <div class="hidden compact-view w-full">
                        <span
                          class="text-[9px] font-mono text-white/80 whitespace-nowrap overflow-hidden text-ellipsis group-[.active]:text-purple-400 transition-colors"
                          title={formattedDesc}
                        >
                          {getCompactText(item.raw || item, formattedDesc)}
                        </span>
                      </div>
                    </div>

                    {ranksCount > 1 && (
                      <div class="flex items-center gap-2.5 mt-auto pt-1.5 border-t border-white/10 skill-ranks-container" onclick="event.stopPropagation()">
                        {Array.from({ length: ranksCount }).map((_, idx) => {
                          const isFaction = item.name === "Faction Pet"
                          const labels = ["10%", "20%", "30%", "50%"]
                          const labelText = isFaction ? labels[idx] : `R${idx + 1}`
                          return (
                            <label class="flex items-center gap-1 cursor-pointer hover:opacity-80 transition-opacity">
                              <input
                                type="checkbox"
                                value={idx + 1}
                                class={`skill-rank-checkbox w-2.5 h-2.5 rounded-sm text-purple-500 bg-white/5 border-white/20 focus:ring-purple-500/50 rank-input-${safeId}`}
                                data-skill-id={item.name}
                                data-rank={idx + 1}
                              />
                              <span class="text-[8px] font-mono font-bold text-white/50">{labelText}</span>
                            </label>
                          )
                        })}
                      </div>
                    )}
                  </div>
                )
              })}
            </div>
          </details>
        )}
      </div>
    </div>
  </div>
</details>

<script>
  import { SflUserState } from "../../../lib/sfl/state"
  if (typeof window !== "undefined") {
    ;(window as any).SflUserState = SflUserState
  }

  // Script de Inicialización y Reactividad del Bloque de Boosts
  function initBoostsPanel() {
    const panels = document.querySelectorAll<HTMLDetailsElement>(".sfl-boosts-panel")
    if (!panels.length) return

    panels.forEach((panel) => {
      const container = panel.querySelector<HTMLElement>(".boosts-container")
      if (!container) return

      // 1. Restaurar estado de acordeón según preferencia manual guardada
      const panelDomain = panel.dataset.domain || "all"
      const storageKey = `sfl_boosts_expanded_${panelDomain}`
      if (typeof localStorage !== "undefined") {
        const savedPreference = localStorage.getItem(storageKey)
        if (savedPreference !== null) {
          panel.open = savedPreference === "true"
        } else {
          panel.open = panelDomain === "cooking"
        }
      }

      // 4. Sincronización con SflUserState
      const hydrateUI = () => {
        const state = SflUserState.getState()

        // Sincronizar PowerUps y Shrines
        container.querySelectorAll<HTMLInputElement>(".buff-checkbox").forEach((cb) => {
          const id = cb.dataset.buffId
          if (!id) return
          const isActive = Boolean(state.buffs?.[id] || (state.skills?.[id] && state.skills[id] > 0))
          cb.checked = isActive
          const card = cb.closest(".buff-card")
          if (card) {
            const isOrange = card.classList.contains("hover:border-orange-500/30")
            if (isActive) {
              card.classList.add("active")
              if (isOrange) {
                card.classList.add("border-orange-500/50", "bg-orange-500/10")
              } else {
                card.classList.add("border-emerald-500/50", "bg-emerald-500/10")
              }
              card.classList.remove("border-white/5", "bg-white/5")
            } else {
              card.classList.remove(
                "active",
                "border-emerald-500/50",
                "bg-emerald-500/10",
                "border-orange-500/50",
                "bg-orange-500/10"
              )
              card.classList.add("border-white/5", "bg-white/5")
            }
          }
        })

        // Sincronizar Skills, Consumibles y Others
        container.querySelectorAll<HTMLElement>(".skill-card").forEach((card) => {
          const skillId = card.dataset.skillId
          if (!skillId) return
          const buffId = card.dataset.buffId
          const rank = state.skills?.[skillId] || 0
          const isActive =
            rank > 0 ||
            Boolean(state.buffs?.[skillId]) ||
            Boolean(buffId && state.buffs?.[buffId])

          if (isActive) {
            card.classList.add("active")
            card.classList.remove("border-white/5", "bg-white/5")
          } else {
            card.classList.remove("active")
            card.classList.add("border-white/5", "bg-white/5")
          }

          // Actualizar descripción dinámica según el rango activo
          const descSpan = card.querySelector<HTMLElement>(".skill-description-text")
          const compactSpan = card.querySelector<HTMLElement>(".compact-description-text")
          const originalDesc = descSpan?.dataset.original || ""

          if (descSpan && originalDesc) {
            const effectiveRank = rank === 0 ? 1 : rank
            let updatedDesc = originalDesc

            try {
              const m1Data = JSON.parse(card.dataset.math1 || "{}")
              const m1 = m1Data[`rank_${effectiveRank}`]
              if (m1 !== undefined) {
                updatedDesc = updatedDesc
                  .replace("{math1}", m1)
                  .replace("{math1_pct}", parseFloat((m1 * 100).toFixed(2)).toString())
                  .replace("{math1_days}", parseFloat((m1 / 86400000).toFixed(2)).toString())
              }
            } catch (e) {}

            try {
              const m2Data = JSON.parse(card.dataset.math2 || "{}")
              const m2 = m2Data[`rank_${effectiveRank}`]
              if (m2 !== undefined) {
                updatedDesc = updatedDesc
                  .replace("{math2}", m2)
                  .replace("{math2_pct}", parseFloat((m2 * 100).toFixed(2)).toString())
                  .replace("{math2_days}", parseFloat((m2 / 86400000).toFixed(2)).toString())
              }
            } catch (e) {}

            if (skillId === "Frenzied Fish" && rank === 3) {
              updatedDesc = updatedDesc.replace(" and 0% chance of +1 fish", "")
            }

            descSpan.textContent = updatedDesc
            descSpan.title = updatedDesc

            if (compactSpan) {
              compactSpan.title = updatedDesc
              const match = updatedDesc.match(/(?:^|\b|\s)([x+-]?\d+(?:\.\d+)?(?:%|x)?)/i)
              if (match) {
                let val = match[1].trim()
                if (val.toLowerCase().endsWith("x")) val = "x" + val.slice(0, -1)
                compactSpan.textContent = val
              }
            }
          }

          // Checkboxes de rango progresivo (o selección única para Faction Pet)
          card.querySelectorAll<HTMLInputElement>(".skill-rank-checkbox").forEach((cb) => {
            const cbRank = parseInt(cb.dataset.rank || cb.value || "1", 10)
            const isChecked = skillId === "Faction Pet" ? cbRank === rank : cbRank <= rank
            cb.checked = isChecked

            const label = cb.closest("label")
            if (label) {
              const textSpan = label.querySelector("span")
              if (textSpan) {
                if (isChecked) {
                  textSpan.classList.add("text-blue-400", "font-bold")
                  textSpan.classList.remove("text-white/50")
                } else {
                  textSpan.classList.remove("text-blue-400", "font-bold")
                  textSpan.classList.add("text-white/50")
                }
              }
            }
          })
        })
      }

      // Registrar listeners solo una vez por panel
      if (!(panel as any).__boostsInitialized) {
        ;(panel as any).__boostsInitialized = true

        panel.addEventListener("toggle", () => {
          if (typeof localStorage !== "undefined") {
            const dom = panel.dataset.domain || "all"
            localStorage.setItem(`sfl_boosts_expanded_${dom}`, panel.open ? "true" : "false")
          }
        })

        // 2. Filtros de Vista (Detailed vs Compact)
        const viewButtons = panel.querySelectorAll<HTMLButtonElement>(".view-switch-btn")
        viewButtons.forEach((btn) => {
          btn.addEventListener("click", (e) => {
            e.stopPropagation()
            const action = btn.dataset.action
            viewButtons.forEach((b) => b.classList.remove("active", "text-white", "bg-white/10"))
            btn.classList.add("active", "text-white", "bg-white/10")

            if (action === "compact") {
              container.classList.add("is-compact")
            } else {
              container.classList.remove("is-compact")
            }
          })
        })

        // 3. Filtros por Efecto (All, XP, Time)
        const filterButtons = panel.querySelectorAll<HTMLButtonElement>(".filter-boost-btn")
        filterButtons.forEach((btn) => {
          btn.addEventListener("click", (e) => {
            e.stopPropagation()
            const filter = btn.dataset.filter || "all"
            filterButtons.forEach((b) => b.classList.remove("active", "text-white", "bg-white/10"))
            btn.classList.add("active", "text-white", "bg-white/10")
            container.dataset.filter = filter
          })
        })

        // 5. Manejador de clicks para alternar Buffs (PowerUps y Shrines)
        container.querySelectorAll<HTMLElement>(".buff-card").forEach((card) => {
          card.addEventListener("click", (e) => {
            e.preventDefault()
            const buffId =
              card.dataset.buffId ||
              card.querySelector<HTMLInputElement>(".buff-checkbox")?.dataset.buffId
            if (!buffId) return
            SflUserState.toggleBuff(buffId)
          })
        })

        // 6. Manejador de clicks para alternar Skills y Perks
        container.querySelectorAll<HTMLElement>(".skill-card").forEach((card) => {
          card.addEventListener("click", (e) => {
            // Si el click fue en un checkbox de rango específico o contenedor de rangos, dejar que su handler lo procese
            if ((e.target as HTMLElement).closest(".skill-rank-checkbox, .skill-ranks-container")) return
            const type = card.dataset.type
            if (type === "consumable" || type === "other") {
              const buffId = card.dataset.buffId || card.dataset.skillId
              if (buffId) SflUserState.toggleBuff(buffId)
              return
            }
            const skillId = card.dataset.skillId
            if (!skillId) return
            SflUserState.toggleSkill(skillId)
          })
        })

        // 7. Manejador de cambio para checkboxes de rango
        container.querySelectorAll<HTMLInputElement>(".skill-rank-checkbox").forEach((cb) => {
          cb.addEventListener("change", (e) => {
            e.stopPropagation()
            const skillId = cb.dataset.skillId
            const rank = parseInt(cb.value || cb.dataset.rank || "1", 10)
            if (!skillId) return
            if (skillId === "Faction Pet") {
              if (cb.checked) {
                SflUserState.setSkillRank(skillId, rank)
              } else {
                SflUserState.setSkillRank(skillId, 0)
              }
            } else {
              if (cb.checked) {
                SflUserState.setSkillRank(skillId, rank)
              } else {
                SflUserState.setSkillRank(skillId, rank - 1)
              }
            }
          })
        })

        // Suscribirse a cambios futuros
        SflUserState.subscribe(() => hydrateUI())
      }

      // Hidratar siempre el estado visual de las tarjetas
      hydrateUI()
    })
  }

  // Inicializar en carga y en navegaciones de Astro
  if (typeof document !== "undefined") {
    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initBoostsPanel)
    } else {
      initBoostsPanel()
    }
    document.addEventListener("astro:page-load", initBoostsPanel)
  }
</script>

<style>
  /* Estados Activos con bordes, resplandor y textos destacados */
  .buff-card.active {
    border-color: rgba(16, 185, 129, 0.7) !important;
    background-color: rgba(16, 185, 129, 0.15) !important;
    box-shadow: 0 0 10px rgba(16, 185, 129, 0.25) !important;
  }
  .buff-card.active span.font-bold {
    color: #34d399 !important;
  }

  /* Shrines (Naranja) */
  .buff-card.active.hover\:border-orange-500\/30 {
    border-color: rgba(249, 115, 22, 0.7) !important;
    background-color: rgba(249, 115, 22, 0.15) !important;
    box-shadow: 0 0 10px rgba(249, 115, 22, 0.25) !important;
  }
  .buff-card.active.hover\:border-orange-500\/30 span.font-bold {
    color: #fb923c !important;
  }

  /* Skills de Bumpkin (Azul) */
  .skill-card.is-skill.active,
  .skill-card[data-type="skill"].active {
    border-color: rgba(59, 130, 246, 0.7) !important;
    background-color: rgba(59, 130, 246, 0.15) !important;
    box-shadow: 0 0 10px rgba(59, 130, 246, 0.25) !important;
  }
  .skill-card.is-skill.active span.font-bold,
  .skill-card[data-type="skill"].active span.font-bold {
    color: #60a5fa !important;
  }

  /* Consumibles y Tótems (Marrón / Ámbar Cálido) */
  .skill-card.is-consumable.active,
  .skill-card[data-type="consumable"].active {
    border-color: rgba(180, 83, 9, 0.8) !important;
    background-color: rgba(180, 83, 9, 0.2) !important;
    box-shadow: 0 0 10px rgba(180, 83, 9, 0.3) !important;
  }
  .skill-card.is-consumable.active span.font-bold,
  .skill-card[data-type="consumable"].active span.font-bold {
    color: #fbbf24 !important;
  }

  /* Global Phases & Perks (Púrpura) */
  .skill-card.is-other.active,
  .skill-card[data-type="other"].active {
    border-color: rgba(168, 85, 247, 0.8) !important;
    background-color: rgba(168, 85, 247, 0.2) !important;
    box-shadow: 0 0 12px rgba(168, 85, 247, 0.3) !important;
  }
  .skill-card.is-other.active span.font-bold,
  .skill-card[data-type="other"].active span.font-bold {
    color: #c084fc !important;
  }

  .boosts-container[data-filter="xp"] .buff-card:not([data-effect*="xp"]),
  .boosts-container[data-filter="xp"] .skill-card:not([data-effect*="xp"]) {
    display: none !important;
  }

  .boosts-container[data-filter="time"] .buff-card:not([data-effect*="time"]),
  .boosts-container[data-filter="time"] .skill-card:not([data-effect*="time"]) {
    display: none !important;
  }

  .boosts-container.is-compact .normal-view {
    display: none !important;
  }

  .boosts-container.is-compact .compact-view {
    display: block !important;
  }

  .boosts-container.is-compact .skill-ranks-container {
    display: none !important;
  }
</style>
