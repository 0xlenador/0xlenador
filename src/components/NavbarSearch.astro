---
import { Icon } from "astro-icon/components"
import { getEcosystemCatalog } from "../data/ecosystem"
import type { Lang } from "../i18n/ui"

interface Props {
  lang: Lang
  t: (key: any) => string
}

const { lang, t } = Astro.props

// Obtenemos el catálogo dinámico unificado en tiempo de compilación (SSG)
const catalogItems = await getEcosystemCatalog(lang)

const searchData = catalogItems.map((item) => ({
  id: item.id,
  name: item.name,
  description: item.description,
  url: item.url,
  category: item.category,
  categoryLabel: item.categoryLabel,
  ecosystem: item.ecosystem,
  ecosystemLabel: item.ecosystemLabel,
  tags: item.tags,
  icon: item.icon,
  iconName: item.iconName,
  featured: item.featured ?? false,
}))

// Textos de UI localizados para el script de cliente
const uiStrings = {
  recentSearches: t("nav.search.recentSearches"),
  clearHistory: t("nav.search.clearHistory"),
  exploreTitle: t("nav.search.exploreTitle"),
  groupGames: t("nav.search.groupGames"),
  groupSfl: t("nav.search.groupSfl"),
  groupTools: t("nav.search.groupTools"),
  groupOps: t("nav.search.groupOps"),
  groupAssets: t("nav.search.groupAssets"),
  groupDirectory: t("nav.search.groupDirectory"),
  groupBlog: t("nav.search.groupBlog"),
  groupGeneral: t("nav.search.groupGeneral"),
  noResults: t("nav.search.noResults"),
  kbdHint: t("nav.search.kbdHint"),
  visit: lang === "es" ? "Visitar ↵" : "Visit ↵",
  itemsLabel: lang === "es" ? "items" : "items",
  noResultsTip:
    lang === "es"
      ? "Prueba con términos como 'animales', 'btc', 'perpetuos', 'riskfolio' o 'faucets'."
      : "Try terms like 'animals', 'btc', 'perps', 'riskfolio' or 'faucets'.",
}
---

<!-- Trigger Desktop embebido en Navbar (ocupa el espacio entre Operaciones y Blog) -->
<div class="relative flex-1 max-w-xs xl:max-w-sm 2xl:max-w-md mx-3 xl:mx-6 hidden lg:block">
  <button
    id="nav-search-trigger"
    type="button"
    class="w-full flex items-center justify-between gap-2 px-3 py-1.5 rounded-xl bg-terminal-surface/70 hover:bg-terminal-surface border border-terminal-border/80 hover:border-emerald-500/40 text-terminal-muted hover:text-white transition-all text-xs group cursor-pointer shadow-inner"
    aria-label={t("nav.search.placeholder")}
    data-open-search="true"
  >
    <span class="flex items-center gap-2 truncate">
      <svg
        class="w-4 h-4 text-terminal-muted group-hover:text-emerald-400 transition-colors shrink-0"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
      </svg>
      <span class="truncate">{t("nav.search.placeholder")}</span>
    </span>
    <!-- Badge visual de la tecla / -->
    <kbd
      class="inline-flex items-center justify-center min-w-5 h-5 px-1.5 text-[11px] font-mono font-semibold text-terminal-muted/90 bg-white/5 border border-white/10 rounded-md group-hover:border-emerald-500/40 group-hover:text-emerald-400 transition-colors shrink-0 shadow-sm"
      title="Presiona / para buscar"
    >
      /
    </kbd>
  </button>
</div>

<!-- Modal / Command Palette Dialog -->
<div
  id="search-palette-modal"
  class="fixed inset-0 z-[100] bg-black/80 backdrop-blur-md hidden items-start justify-center pt-4 sm:pt-16 md:pt-24 px-2 sm:px-4 transition-opacity duration-200"
  style="display: none;"
  role="dialog"
  aria-modal="true"
  data-lang={lang}
>
  <div
    id="search-palette-box"
    class="w-full max-w-2xl bg-[#0e0e0e] border border-white/10 rounded-2xl shadow-2xl overflow-hidden flex flex-col max-h-[88vh] md:max-h-[80vh] ring-1 ring-emerald-500/20 transform transition-all duration-200 scale-95 opacity-0"
  >
    <!-- Header del Buscador -->
    <div class="p-3.5 sm:p-4 border-b border-white/5 flex items-center gap-3 bg-white/[0.01]">
      <svg
        class="w-5 h-5 text-emerald-400 shrink-0"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
      </svg>
      <input
        id="search-palette-input"
        type="text"
        placeholder={t("nav.search.modalPlaceholder")}
        class="w-full bg-transparent text-sm md:text-base text-white placeholder:text-terminal-muted focus:outline-none"
        autocomplete="off"
        spellcheck="false"
      />
      <button
        id="search-palette-close"
        type="button"
        class="text-xs font-mono text-terminal-muted hover:text-white px-2.5 py-1 rounded bg-white/5 border border-white/10 hover:border-white/20 transition-colors cursor-pointer shrink-0"
      >
        <span class="hidden sm:inline">ESC</span>
        <span class="sm:hidden">✕</span>
      </button>
    </div>

    <!-- Sugerencias rápidas / Chips (visibles cuando el input está vacío) -->
    <div
      id="search-quick-tags"
      class="px-4 py-2.5 border-b border-white/5 bg-white/[0.02] flex items-center gap-2 overflow-x-auto hide-scrollbar text-xs"
    >
      <span class="text-terminal-muted text-[11px] font-mono shrink-0 mr-1"
        >{t("nav.search.quickSuggestions")}:</span
      >
      <button
        type="button"
        class="quick-chip px-2.5 py-1 rounded-md bg-white/5 hover:bg-emerald-500/20 hover:text-emerald-300 text-terminal-secondary border border-white/5 hover:border-emerald-500/30 transition-all shrink-0 cursor-pointer flex items-center gap-1.5"
        data-query="herramienta"
      >
        <Icon name="lucide:zap" class="w-3.5 h-3.5 text-emerald-400" />
        <span>{lang === "es" ? "Herramientas" : "Tools"}</span>
      </button>
      <button
        type="button"
        class="quick-chip px-2.5 py-1 rounded-md bg-white/5 hover:bg-emerald-500/20 hover:text-emerald-300 text-terminal-secondary border border-white/5 hover:border-emerald-500/30 transition-all shrink-0 cursor-pointer flex items-center gap-1.5"
        data-query="sfl"
      >
        <Icon name="lucide:sprout" class="w-3.5 h-3.5 text-emerald-400" />
        <span>Sunflower Land</span>
      </button>
      <button
        type="button"
        class="quick-chip px-2.5 py-1 rounded-md bg-white/5 hover:bg-emerald-500/20 hover:text-emerald-300 text-terminal-secondary border border-white/5 hover:border-emerald-500/30 transition-all shrink-0 cursor-pointer flex items-center gap-1.5"
        data-query="activo"
      >
        <Icon name="lucide:trending-up" class="w-3.5 h-3.5 text-emerald-400" />
        <span>{lang === "es" ? "Activos" : "Assets"}</span>
      </button>
      <button
        type="button"
        class="quick-chip px-2.5 py-1 rounded-md bg-white/5 hover:bg-emerald-500/20 hover:text-emerald-300 text-terminal-secondary border border-white/5 hover:border-emerald-500/30 transition-all shrink-0 cursor-pointer flex items-center gap-1.5"
        data-query="guia"
      >
        <Icon name="lucide:compass" class="w-3.5 h-3.5 text-emerald-400" />
        <span>{lang === "es" ? "Guías" : "Guides"}</span>
      </button>
      <button
        type="button"
        class="quick-chip px-2.5 py-1 rounded-md bg-white/5 hover:bg-emerald-500/20 hover:text-emerald-300 text-terminal-secondary border border-white/5 hover:border-emerald-500/30 transition-all shrink-0 cursor-pointer flex items-center gap-1.5"
        data-query="yakkamon"
      >
        <Icon name="lucide:gamepad-2" class="w-3.5 h-3.5 text-emerald-400" />
        <span>Yakkamon</span>
      </button>
    </div>

    <!-- Lista de Resultados Agrupados -->
    <div
      id="search-palette-results"
      class="overflow-y-auto p-3 space-y-4 max-h-[58vh] md:max-h-[50vh] divide-y divide-white/5 custom-scrollbar"
    >
      <!-- Se puebla dinámicamente con Pagefind / JS -->
    </div>

    <!-- Footer informativo con atajos -->
    <div
      class="px-4 py-2.5 bg-white/[0.02] border-t border-white/5 flex items-center justify-between text-[11px] text-terminal-muted font-mono"
    >
      <span class="hidden sm:inline">{uiStrings.kbdHint}</span>
      <span class="sm:hidden text-[10px] text-terminal-muted"
        >{lang === "es" ? "Toca un resultado para abrir" : "Tap result to open"}</span
      >
      <span class="text-emerald-400 font-semibold flex items-center gap-1.5">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
        0xLeñador Search
      </span>
    </div>
  </div>
</div>

<!-- Plantillas de iconos de astro-icon renderizados en build para el cliente -->
<div id="search-icon-templates" class="hidden" aria-hidden="true">
  <div data-icon-id="lucide:clock"><Icon name="lucide:clock" class="w-3.5 h-3.5" /></div>
  <div data-icon-id="lucide:zap"><Icon name="lucide:zap" class="w-3.5 h-3.5" /></div>
  <div data-icon-id="lucide:trending-up">
    <Icon name="lucide:trending-up" class="w-3.5 h-3.5" />
  </div>
  <div data-icon-id="lucide:compass"><Icon name="lucide:compass" class="w-3.5 h-3.5" /></div>
  <div data-icon-id="lucide:book-open"><Icon name="lucide:book-open" class="w-3.5 h-3.5" /></div>
  <div data-icon-id="lucide:folder"><Icon name="lucide:folder" class="w-3.5 h-3.5" /></div>
  <div data-icon-id="lucide:gamepad-2"><Icon name="lucide:gamepad-2" class="w-3.5 h-3.5" /></div>
  <div data-icon-id="lucide:sprout"><Icon name="lucide:sprout" class="w-3.5 h-3.5" /></div>
  <div data-icon-id="lucide:search"><Icon name="lucide:search" class="w-3.5 h-3.5" /></div>
  <div data-icon-id="lucide:calculator"><Icon name="lucide:calculator" class="w-3.5 h-3.5" /></div>
  <div data-icon-id="lucide:pie-chart"><Icon name="lucide:pie-chart" class="w-3.5 h-3.5" /></div>
  <div data-icon-id="lucide:coins"><Icon name="lucide:coins" class="w-3.5 h-3.5" /></div>
  <div data-icon-id="lucide:shield-check">
    <Icon name="lucide:shield-check" class="w-3.5 h-3.5" />
  </div>
  <div data-icon-id="lucide:brain"><Icon name="lucide:brain" class="w-3.5 h-3.5" /></div>
  <div data-icon-id="lucide:droplet"><Icon name="lucide:droplet" class="w-3.5 h-3.5" /></div>
  <div data-icon-id="lucide:globe"><Icon name="lucide:globe" class="w-3.5 h-3.5" /></div>
  <div data-icon-id="lucide:gem"><Icon name="lucide:gem" class="w-3.5 h-3.5" /></div>
  <div data-icon-id="lucide:share-2"><Icon name="lucide:share-2" class="w-3.5 h-3.5" /></div>
  <div data-icon-id="lucide:file-text"><Icon name="lucide:file-text" class="w-3.5 h-3.5" /></div>
  <div data-icon-id="lucide:link"><Icon name="lucide:link" class="w-3.5 h-3.5" /></div>
</div>

<!-- Datos inyectados en JSON compacto -->
<script id="search-data-json" type="application/json" set:html={JSON.stringify(searchData)} />
<script id="search-ui-json" type="application/json" set:html={JSON.stringify(uiStrings)} />

<script>
  // Variables de estado compartidas del buscador
  let catalog: any[] = []
  let ui: any = {}
  let activeItemIndex = -1
  let visibleItems: HTMLElement[] = []
  const iconTemplates: Record<string, string> = {}
  const RECENT_SEARCHES_KEY = "0x_recent_searches_v2"

  // ─── INSTANCIA DINÁMICA DE PAGEFIND ─────────────────────────
  let pagefindInstance: any = null
  let pagefindLoading: Promise<any> | null = null

  async function getPagefind() {
    if (pagefindInstance) return pagefindInstance
    if (!pagefindLoading) {
      pagefindLoading = (async () => {
        try {
          // Invocación dinámica en runtime para evitar que el analizador estático de Vite intente resolver la ruta en dev
          const dynamicImport = new Function("url", "return import(url)")
          const pf = await dynamicImport("/pagefind/pagefind.js")
          if (pf && typeof pf.init === "function") {
            await pf.init()
          }
          pagefindInstance = pf
          return pf
        } catch (e) {
          // Pagefind no disponible aún (ej. antes de generar el índice), usa fallback local
          return null
        }
      })()
    }
    return pagefindLoading
  }

  function ensureDataLoaded() {
    if (catalog.length === 0) {
      const dataElement = document.getElementById("search-data-json")
      if (dataElement) {
        try {
          catalog = JSON.parse(dataElement.textContent || "[]")
        } catch {
          catalog = []
        }
      }
    }
    if (Object.keys(ui).length === 0) {
      const uiElement = document.getElementById("search-ui-json")
      if (uiElement) {
        try {
          ui = JSON.parse(uiElement.textContent || "{}")
        } catch {
          ui = {}
        }
      }
    }
    if (Object.keys(iconTemplates).length === 0) {
      document.querySelectorAll("#search-icon-templates [data-icon-id]").forEach((el) => {
        const id = el.getAttribute("data-icon-id")
        if (id) {
          iconTemplates[id] = el.innerHTML.trim()
        }
      })
    }
  }

  function getIconMarkup(item: any): string {
    if (item.icon) {
      return `<img src="${item.icon}" alt="${(item.name || "").replace(/"/g, "&quot;")}" class="w-6 h-6 rounded-md object-cover bg-white/5 shrink-0" onerror="this.style.display='none'" />`
    }
    const iconKey =
      item.iconName ||
      (item.category === "blog"
        ? "lucide:book-open"
        : item.category === "directorio"
          ? "lucide:folder"
          : item.category === "herramientas"
            ? "lucide:calculator"
            : item.category === "guias"
              ? "lucide:compass"
              : item.category === "activos"
                ? "lucide:trending-up"
                : "lucide:link")

    const innerSvg = iconTemplates[iconKey] || iconTemplates["lucide:link"] || ""
    return `<div class="w-6 h-6 flex items-center justify-center rounded-md bg-white/5 text-emerald-400 group-hover:text-emerald-300 transition-colors shrink-0">${innerSvg}</div>`
  }

  function normalizeText(text: string) {
    return (text || "")
      .toLowerCase()
      .normalize("NFD")
      .replace(/[\u0300-\u036f]/g, "")
      .trim()
  }

  // --- Persistencia de Búsquedas Recientes (localStorage) ---
  function getRecentSearches(): any[] {
    try {
      const stored = localStorage.getItem(RECENT_SEARCHES_KEY)
      if (!stored) return []
      const parsed = JSON.parse(stored)
      if (!Array.isArray(parsed)) return []
      return parsed
        .map((r: any) => {
          const foundInCatalog = catalog.find((c) => c.id === (r.id || r))
          if (foundInCatalog) return foundInCatalog
          if (r.url && r.name) return r
          return null
        })
        .filter(Boolean)
    } catch {
      return []
    }
  }

  function saveRecentSearch(item: any) {
    try {
      let recents = getRecentSearches().filter((r: any) => r.url !== item.url)
      recents.unshift({
        id: item.id || item.url,
        name: item.name,
        url: item.url,
        description: item.description || "",
        category: item.category || "general",
        categoryLabel: item.categoryLabel || "",
        icon: item.icon,
        iconName: item.iconName,
      })
      recents = recents.slice(0, 5)
      localStorage.setItem(RECENT_SEARCHES_KEY, JSON.stringify(recents))
    } catch {}
  }

  function clearRecentSearches() {
    try {
      localStorage.removeItem(RECENT_SEARCHES_KEY)
    } catch {}
    const input = document.getElementById("search-palette-input") as HTMLInputElement | null
    renderResults(input ? input.value : "")
  }

  // ─── BÚSQUEDA AUTOMÁTICA CON PAGEFIND ───────────────────────
  async function searchWithPagefind(query: string) {
    const pf = await getPagefind()
    if (!pf) return null

    try {
      const modal = document.getElementById("search-palette-modal")
      const currentLang = modal?.getAttribute("data-lang") || "es"
      const isEn = currentLang === "en"
      const searchRes = await pf.search(query)
      if (!searchRes || !searchRes.results) return []

      const topRaw = await Promise.all(searchRes.results.slice(0, 16).map((r: any) => r.data()))

      // Filtrar páginas según el idioma de la URL
      const filtered = topRaw.filter((item: any) => {
        if (isEn) {
          return item.url.startsWith("/en/")
        } else {
          return !item.url.startsWith("/en/")
        }
      })

      return filtered.map((item: any) => {
        const rawTitle = item.meta?.title || item.url
        const cleanTitle = rawTitle.split(/\s+[|—–-]\s+0x/i)[0].trim()

        let category = "general"
        let categoryLabel = isEn ? "Page" : "Página"
        let iconName = "lucide:link"
        let icon = item.meta?.image || undefined

        const u = item.url.toLowerCase()
        if (u.includes("/blog/")) {
          category = "blog"
          categoryLabel = isEn ? "Education" : "Artículos"
          iconName = "lucide:book-open"
        } else if (u.includes("/operaciones/") || u.includes("/operations/")) {
          category = "guias"
          categoryLabel = isEn ? "Guides" : "Guías"
          iconName = "lucide:compass"
        } else if (u.includes("/activos/") || u.includes("/watchlist/")) {
          category = "activos"
          categoryLabel = isEn ? "Assets" : "Activos"
          iconName = "lucide:trending-up"
        } else if (u.includes("/sfl-") || u.includes("/sunflowerland") || u.includes("/fishing")) {
          category = "sfl"
          categoryLabel = "Sunflower Land"
          icon = "/img/cripto/sunflowerland.webp"
        } else if (u.includes("/yakkamon")) {
          category = "games"
          categoryLabel = "Yakkamon"
          icon = "/img/cripto/yakkamon.webp"
        } else if (u.includes("/faucets")) {
          category = "directorio"
          categoryLabel = "Faucets"
          iconName = "lucide:droplet"
        } else if (
          u.includes("/intrinseco") ||
          u.includes("/intrinsic") ||
          u.includes("/riskfolio") ||
          u.includes("/herramientas") ||
          u.includes("/tools")
        ) {
          category = "herramientas"
          categoryLabel = isEn ? "Tools" : "Herramientas"
          iconName = "lucide:calculator"
        } else if (
          u.includes("/directorio") ||
          u.includes("/directory") ||
          u.includes("/lista-web3") ||
          u.includes("/infravalorados")
        ) {
          category = "directorio"
          categoryLabel = isEn ? "Directory" : "Directorio"
          iconName = "lucide:folder"
        }

        return {
          id: item.url,
          name: cleanTitle,
          description: item.excerpt || item.meta?.description || "",
          url: item.url,
          category,
          categoryLabel,
          icon,
          iconName,
        }
      })
    } catch (e) {
      return null
    }
  }

  // ─── FALLBACK: Búsqueda local por tokens (instantánea) ───
  function performFallbackSearch(query: string) {
    const q = normalizeText(query)
    if (!q) {
      return catalog.filter((item) => item.featured)
    }

    const tokens = q.split(/\s+/).filter(Boolean)

    const scored = catalog
      .map((item) => {
        let score = 0
        const nameNorm = normalizeText(item.name)
        const descNorm = normalizeText(item.description)
        const ecoNorm = normalizeText(item.ecosystem)
        const ecoLabelNorm = normalizeText(item.ecosystemLabel)
        const catNorm = normalizeText(item.category)
        const catLabelNorm = normalizeText(item.categoryLabel)
        const tagsNorm = (item.tags || []).map(normalizeText)

        if (nameNorm === q) score += 120
        else if (nameNorm.startsWith(q)) score += 70
        else if (nameNorm.includes(q)) score += 45

        let matchedTokens = 0
        tokens.forEach((token) => {
          if (nameNorm.includes(token)) {
            score += 25
            matchedTokens++
          } else if (tagsNorm.some((t: string) => t.includes(token))) {
            score += 20
            matchedTokens++
          } else if (ecoNorm.includes(token) || ecoLabelNorm.includes(token)) {
            score += 15
            matchedTokens++
          } else if (catNorm.includes(token) || catLabelNorm.includes(token)) {
            score += 10
            matchedTokens++
          } else if (descNorm.includes(token)) {
            score += 8
            matchedTokens++
          }
        })

        if (tokens.length > 1 && matchedTokens === tokens.length) {
          score += 40
        }

        return { ...item, score }
      })
      .filter((item) => item.score > 0)
      .sort((a, b) => b.score - a.score)

    return scored
  }

  // Agrupación balanceada y anti-saturación
  function groupResults(items: any[], query: string) {
    const q = normalizeText(query)
    const groups: {
      id: string
      iconName: string
      title: string
      items: any[]
      canClear?: boolean
    }[] = []

    if (!q) {
      const recents = getRecentSearches()
      if (recents.length > 0) {
        groups.push({
          id: "recents",
          iconName: "lucide:clock",
          title: ui.recentSearches || "Búsquedas recientes",
          items: recents,
          canClear: true,
        })
      }

      const showcaseMap: Record<
        string,
        { id: string; iconName: string; title: string; items: any[] }
      > = {
        herramientas: {
          id: "herramientas",
          iconName: "lucide:zap",
          title: ui.groupTools || "Herramientas",
          items: [],
        },
        sfl: {
          id: "sfl",
          iconName: "lucide:sprout",
          title: ui.groupSfl || "Sunflower Land",
          items: [],
        },
        activos: {
          id: "activos",
          iconName: "lucide:trending-up",
          title: ui.groupAssets || "Activos y Tesis",
          items: [],
        },
        guias: {
          id: "guias",
          iconName: "lucide:compass",
          title: ui.groupOps || "Guías y Operaciones",
          items: [],
        },
        blog: {
          id: "blog",
          iconName: "lucide:book-open",
          title: ui.groupBlog || "Artículos y Educación",
          items: [],
        },
        directorio: {
          id: "directorio",
          iconName: "lucide:folder",
          title: ui.groupDirectory || "Directorio y Recursos",
          items: [],
        },
      }

      items.forEach((item) => {
        const cat =
          item.ecosystem === "sunflowerland" || item.category === "sfl"
            ? "sfl"
            : item.category || "directorio"
        if (showcaseMap[cat]) {
          showcaseMap[cat].items.push(item)
        } else if (showcaseMap.directorio) {
          showcaseMap.directorio.items.push(item)
        }
      })

      Object.values(showcaseMap).forEach((g) => {
        if (g.items.length > 0) {
          groups.push(g)
        }
      })

      return groups
    }

    const catMap: Record<string, { id: string; iconName: string; title: string; items: any[] }> = {
      herramientas: {
        id: "herramientas",
        iconName: "lucide:zap",
        title: ui.groupTools || "Herramientas",
        items: [],
      },
      sfl: {
        id: "sfl",
        iconName: "lucide:sprout",
        title: ui.groupSfl || "Sunflower Land",
        items: [],
      },
      games: {
        id: "games",
        iconName: "lucide:gamepad-2",
        title: ui.groupGames || "Juegos Web3",
        items: [],
      },
      activos: {
        id: "activos",
        iconName: "lucide:trending-up",
        title: ui.groupAssets || "Activos",
        items: [],
      },
      guias: {
        id: "guias",
        iconName: "lucide:compass",
        title: ui.groupOps || "Guías y Operaciones",
        items: [],
      },
      blog: {
        id: "blog",
        iconName: "lucide:book-open",
        title: ui.groupBlog || "Artículos",
        items: [],
      },
      directorio: {
        id: "directorio",
        iconName: "lucide:folder",
        title: ui.groupDirectory || "Directorio",
        items: [],
      },
      general: {
        id: "general",
        iconName: "lucide:search",
        title: ui.groupGeneral || "Resultados",
        items: [],
      },
    }

    items.forEach((item) => {
      const catKey = item.category || "general"
      const target = catMap[catKey] || catMap.general
      target.items.push(item)
    })

    Object.values(catMap).forEach((g) => {
      if (g.items.length > 0) {
        groups.push(g)
      }
    })

    return groups
  }

  async function renderResults(query: string) {
    const resultsContainer = document.getElementById("search-palette-results")
    if (!resultsContainer) return

    ensureDataLoaded()
    activeItemIndex = -1
    visibleItems = []

    let items: any[] | null = null

    if (!query.trim()) {
      items = catalog.filter((item) => item.featured)
    } else {
      try {
        items = await searchWithPagefind(query)
      } catch {
        items = null
      }
      if (items === null || items.length === 0) {
        items = performFallbackSearch(query)
      }
    }

    if (!items || items.length === 0) {
      resultsContainer.innerHTML = `
        <div class="py-12 px-4 text-center">
          <svg class="w-10 h-10 mx-auto text-terminal-muted/40 mb-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <p class="text-sm text-terminal-secondary">${ui.noResults || "No se encontraron resultados para"} "<span class="text-white font-medium">${query}</span>"</p>
          <p class="text-xs text-terminal-muted mt-1.5">${ui.noResultsTip || "Prueba con palabras como 'animales', 'btc', 'perpetuos', 'riskfolio' o 'faucets'."}</p>
        </div>
      `
      return
    }

    const groups = groupResults(items, query)

    let html = ""
    let globalIndex = 0

    groups.forEach((group) => {
      const clearButtonHtml = group.canClear
        ? `<button id="clear-recents-btn" type="button" class="text-[10px] font-mono text-terminal-muted hover:text-red-400 transition-colors cursor-pointer px-1.5 py-0.5 rounded bg-white/5 hover:bg-white/10">${ui.clearHistory || "Limpiar"}</button>`
        : `<span class="text-[10px] font-mono text-terminal-muted">${group.items.length} ${ui.itemsLabel || "items"}</span>`

      html += `
        <div class="pt-3 first:pt-0">
          <div class="px-2 py-1.5 mb-1.5 flex items-center justify-between">
            <span class="text-[11px] font-mono uppercase tracking-wider text-emerald-400 font-semibold flex items-center gap-1.5">
              <span class="w-3.5 h-3.5 inline-flex items-center justify-center shrink-0 text-emerald-400">
                ${iconTemplates[group.iconName] || iconTemplates["lucide:search"] || ""}
              </span>
              <span>${group.title}</span>
            </span>
            ${clearButtonHtml}
          </div>
          <div class="space-y-1">
      `

      group.items.forEach((item) => {
        const itemIdx = globalIndex++
        const iconMarkup = getIconMarkup(item)
        const safeName = (item.name || "").replace(/"/g, "&quot;")
        const safeUrl = (item.url || "").replace(/"/g, "&quot;")

        html += `
          <a
            href="${safeUrl}"
            data-index="${itemIdx}"
            data-item-url="${safeUrl}"
            data-item-name="${safeName}"
            class="search-result-item flex items-center justify-between p-2.5 rounded-xl text-terminal-secondary hover:text-white hover:bg-white/[0.05] border border-transparent hover:border-emerald-500/30 transition-all group cursor-pointer"
          >
            <div class="flex items-center gap-3 min-w-0 pr-3">
              ${iconMarkup}
              <div class="min-w-0">
                <div class="flex items-center gap-2">
                  <span class="text-sm font-medium text-white group-hover:text-emerald-300 transition-colors truncate">${safeName}</span>
                  <span class="text-[10px] px-1.5 py-0.5 rounded bg-white/5 text-terminal-muted border border-white/5 font-mono shrink-0">${item.categoryLabel || "Página"}</span>
                </div>
                <p class="text-xs text-terminal-muted truncate mt-0.5 group-hover:text-terminal-secondary transition-colors">${item.description || ""}</p>
              </div>
            </div>
            <div class="flex items-center gap-2 shrink-0">
              <span class="text-[10px] font-mono text-terminal-muted/60 opacity-0 group-hover:opacity-100 transition-opacity flex items-center gap-1">
                ${ui.visit || "Visitar ↵"}
              </span>
            </div>
          </a>
        `
      })

      html += `
          </div>
        </div>
      `
    })

    resultsContainer.innerHTML = html

    // Colección de nodos para navegación con flechas
    visibleItems = Array.from(resultsContainer.querySelectorAll(".search-result-item"))

    // Por defecto seleccionar el primer elemento
    if (visibleItems.length > 0) {
      updateActiveIndex(0)
    }
  }

  function updateActiveIndex(newIndex: number) {
    if (visibleItems.length === 0) return

    visibleItems.forEach((el) => {
      el.classList.remove(
        "bg-white/[0.08]",
        "border-emerald-500/40",
        "ring-1",
        "ring-emerald-500/30",
      )
    })

    if (newIndex >= 0 && newIndex < visibleItems.length) {
      activeItemIndex = newIndex
      const activeEl = visibleItems[activeItemIndex]
      activeEl.classList.add(
        "bg-white/[0.08]",
        "border-emerald-500/40",
        "ring-1",
        "ring-emerald-500/30",
      )
      activeEl.scrollIntoView({ block: "nearest", behavior: "smooth" })
    }
  }

  // ─── CONTROL DEL MODAL (Abierto / Cerrado) ───────────────────
  function openModal() {
    ensureDataLoaded()
    const modal = document.getElementById("search-palette-modal")
    const box = document.getElementById("search-palette-box")
    const input = document.getElementById("search-palette-input") as HTMLInputElement | null
    if (!modal || !box) return

    modal.style.display = "flex"
    modal.classList.remove("hidden")
    document.body.style.overflow = "hidden"

    requestAnimationFrame(() => {
      box.classList.remove("scale-95", "opacity-0")
      box.classList.add("scale-100", "opacity-100")
      if (input) {
        input.focus()
      }
    })

    getPagefind()
    try {
      renderResults(input ? input.value : "")
    } catch (e) {
      console.warn("[Search] Error al renderizar:", e)
    }
  }

  function closeModal() {
    const modal = document.getElementById("search-palette-modal")
    const box = document.getElementById("search-palette-box")
    const input = document.getElementById("search-palette-input") as HTMLInputElement | null
    if (!modal || !box) return

    box.classList.remove("scale-100", "opacity-100")
    box.classList.add("scale-95", "opacity-0")

    setTimeout(() => {
      modal.classList.add("hidden")
      modal.style.display = "none"
      document.body.style.overflow = ""
      if (input) input.value = ""
      activeItemIndex = -1
    }, 150)
  }

  // Configurar listeners del input de búsqueda (se llama idempotentemente)
  function attachInputListeners() {
    const input = document.getElementById("search-palette-input") as HTMLInputElement | null
    if (!input || input.getAttribute("data-search-ready") === "true") return
    input.setAttribute("data-search-ready", "true")

    let timeout: ReturnType<typeof setTimeout>
    input.addEventListener("input", () => {
      clearTimeout(timeout)
      timeout = setTimeout(() => {
        renderResults(input.value)
      }, 60)
    })

    input.addEventListener("keydown", (e) => {
      if (e.key === "ArrowDown") {
        e.preventDefault()
        const next = activeItemIndex + 1 >= visibleItems.length ? 0 : activeItemIndex + 1
        updateActiveIndex(next)
      } else if (e.key === "ArrowUp") {
        e.preventDefault()
        const prev = activeItemIndex - 1 < 0 ? visibleItems.length - 1 : activeItemIndex - 1
        updateActiveIndex(prev)
      } else if (e.key === "Enter") {
        e.preventDefault()
        if (activeItemIndex >= 0 && visibleItems[activeItemIndex]) {
          const activeEl = visibleItems[activeItemIndex]
          const itemUrl = activeEl.getAttribute("data-item-url")
          const itemName = activeEl.getAttribute("data-item-name")
          if (itemUrl && itemName) {
            saveRecentSearch({ url: itemUrl, name: itemName })
          }
          const link = activeEl as HTMLAnchorElement
          window.location.href = link.href
        }
      } else if (e.key === "Escape") {
        closeModal()
      }
    })
  }

  // ─── DELEGACIÓN GLOBAL DE EVENTOS (NUNCA SE PIERDE) ──────────
  function setupGlobalListeners() {
    if ((window as any).__0xSearchGlobalListenersAttached) return
    ;(window as any).__0xSearchGlobalListenersAttached = true
    ;(window as any).open0xSearch = openModal
    ;(window as any).close0xSearch = closeModal

    // Clic global con delegación
    document.addEventListener("click", (e) => {
      const target = e.target as HTMLElement | null
      if (!target) return

      // 1. Clic en trigger para abrir (desktop, móvil o cualquier elemento con data-open-search)
      if (target.closest("#nav-search-trigger, #nav-mobile-search-trigger, [data-open-search]")) {
        e.preventDefault()
        e.stopPropagation()
        openModal()
        return
      }

      // 2. Clic en botón cerrar ESC / ✕
      if (target.closest("#search-palette-close")) {
        e.preventDefault()
        closeModal()
        return
      }

      // 3. Clic directo en el backdrop oscuro exterior
      const modal = document.getElementById("search-palette-modal")
      if (modal && target === modal) {
        closeModal()
        return
      }

      // 4. Botón "Limpiar historial"
      if (target.closest("#clear-recents-btn")) {
        e.stopPropagation()
        clearRecentSearches()
        return
      }

      // 5. Clic en chip de sugerencia rápida
      const chip = target.closest<HTMLElement>(".quick-chip")
      if (chip) {
        const query = chip.dataset.query || ""
        const input = document.getElementById("search-palette-input") as HTMLInputElement | null
        if (input) {
          input.value = query
          renderResults(query)
          input.focus()
        }
        return
      }

      // 6. Guardar en recientes al hacer clic en un resultado
      const resultItem = target.closest<HTMLElement>(".search-result-item")
      if (resultItem) {
        const itemUrl = resultItem.getAttribute("data-item-url")
        const itemName = resultItem.getAttribute("data-item-name")
        if (itemUrl && itemName) {
          saveRecentSearch({ url: itemUrl, name: itemName })
        }
      }
    })

    // Atajos globales de teclado (/ y Cmd+K / Ctrl+K y Escape)
    document.addEventListener("keydown", (e) => {
      const modal = document.getElementById("search-palette-modal")
      const isModalOpen =
        modal && modal.style.display !== "none" && !modal.classList.contains("hidden")

      const activeEl = document.activeElement as HTMLElement
      const isInputActive =
        activeEl &&
        (activeEl.tagName === "INPUT" ||
          activeEl.tagName === "TEXTAREA" ||
          activeEl.isContentEditable)

      // "/" abre el modal si no estamos escribiendo en un input
      if (e.key === "/" && !isInputActive && !isModalOpen) {
        e.preventDefault()
        openModal()
        return
      }

      // Cmd+K / Ctrl+K hace toggle
      if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === "k") {
        e.preventDefault()
        if (isModalOpen) {
          closeModal()
        } else {
          openModal()
        }
        return
      }

      // ESC cierra si el modal está abierto
      if (e.key === "Escape" && isModalOpen) {
        closeModal()
        return
      }
    })
  }

  // Inicialización segura para cualquier ciclo de vida (SPA, ViewTransitions o SSR)
  function init() {
    setupGlobalListeners()
    attachInputListeners()
    ensureDataLoaded()
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", init)
  } else {
    init()
  }
  document.addEventListener("astro:page-load", init)
</script>

