---
/**
 * CalculatorForm.astro — Calculadora de Valor Intrínseco.
 * Incluye los modos Graham y Buffett con toda la lógica JS encapsulada.
 * Componente autocontenido.
 */
---

<div
  class="bg-terminal-surface/40 border border-terminal-border p-10 md:p-16 rounded-[3rem] shadow-2xl relative"
>
  <!-- Toggle Graham / Buffett -->
  <div
    class="flex bg-terminal-bg p-1 rounded-2xl border border-terminal-border mb-14 max-w-xs mx-auto"
  >
    <button
      id="btn-basic"
      class="flex-1 py-2 rounded-xl text-[10px] font-black tracking-[0.2em] transition uppercase bg-terminal-border-subtle text-white"
      >Graham</button
    >
    <button
      id="btn-advanced"
      class="flex-1 py-2 rounded-xl text-[10px] font-black tracking-[0.2em] text-terminal-muted hover:text-white transition uppercase"
      >Buffett</button
    >
  </div>

  <div class="space-y-12">
    <!-- Formulario Graham -->
    <div id="form-basic" class="grid grid-cols-1 md:grid-cols-2 gap-12">
      <div class="space-y-4">
        <label
          for="basic-eps"
          class="text-[11px] font-bold text-terminal-muted uppercase tracking-widest px-1"
          >EPS (Beneficio Acción)</label
        >
        <div class="relative">
          <span class="absolute left-5 top-1/2 -translate-y-1/2 text-emerald-400 font-bold">$</span>
          <input
            type="number"
            id="basic-eps"
            inputmode="decimal"
            placeholder="0.00"
            class="w-full bg-terminal-bg border border-terminal-border py-5 pl-10 pr-6 text-2xl font-bold text-white rounded-2xl focus:ring-2 focus:ring-emerald-400/50 focus:outline-none transition-all"
          />
        </div>
      </div>
      <div class="space-y-4">
        <label
          for="basic-growth"
          class="text-[11px] font-bold text-terminal-muted uppercase tracking-widest px-1"
          >Crecimiento (g %)</label
        >
        <div class="relative">
          <span
            class="absolute right-5 top-1/2 -translate-y-1/2 text-terminal-subtle font-bold text-xl"
            >%</span
          >
          <input
            type="number"
            id="basic-growth"
            inputmode="decimal"
            placeholder="0"
            class="w-full bg-terminal-bg border border-terminal-border py-5 px-6 text-2xl font-bold text-white rounded-2xl focus:ring-2 focus:ring-emerald-400/50 focus:outline-none transition-all"
          />
        </div>
      </div>
    </div>

    <!-- Formulario Buffett -->
    <div id="form-advanced" class="hidden space-y-12">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <div class="space-y-3">
          <div class="flex justify-between items-center px-1">
            <label
              for="adv-fcf"
              class="text-[11px] font-bold text-terminal-muted uppercase tracking-widest block"
              >Free Cash Flow</label
            >
            <label class="inline-flex items-center cursor-pointer gap-2">
              <span class="text-[9px] font-black text-terminal-subtle uppercase tracking-tighter"
                >Millones</span
              >
              <div class="relative">
                <input type="checkbox" id="fcf-millions-toggle" class="sr-only peer" />
                <div
                  class="w-7 h-4 bg-terminal-border-subtle rounded-full peer peer-checked:bg-emerald-500 peer-checked:after:translate-x-3 after:content-[''] after:absolute after:top-[2px] after:start-[2px] after:bg-terminal-secondary peer-checked:after:bg-white after:rounded-full after:h-3 after:w-3 after:transition-all"
                >
                </div>
              </div>
            </label>
          </div>
          <input
            type="number"
            id="adv-fcf"
            inputmode="decimal"
            placeholder="FCF"
            class="w-full bg-terminal-bg border border-terminal-border py-4 px-6 text-xl font-bold text-white rounded-2xl focus:ring-2 focus:ring-emerald-400/50 focus:outline-none"
          />
        </div>
        <div class="space-y-3">
          <label
            for="adv-growth"
            class="text-[11px] font-bold text-terminal-muted uppercase tracking-widest px-1 block"
            >Crecimiento %</label
          >
          <input
            type="number"
            id="adv-growth"
            inputmode="decimal"
            placeholder="10"
            class="w-full bg-terminal-bg border border-terminal-border py-4 px-6 text-xl font-bold text-white rounded-2xl focus:ring-2 focus:ring-emerald-400/50 focus:outline-none"
          />
        </div>
        <div class="space-y-3">
          <label
            for="adv-discount"
            class="text-[11px] font-bold text-terminal-muted uppercase tracking-widest px-1 block"
            >Tasa Descuento %</label
          >
          <input
            type="number"
            id="adv-discount"
            inputmode="decimal"
            value="10"
            class="w-full bg-terminal-bg border border-terminal-border py-4 px-6 text-xl font-bold text-white rounded-2xl focus:ring-2 focus:ring-emerald-400/50 focus:outline-none"
          />
        </div>
        <div class="space-y-3">
          <div class="flex justify-between items-center px-1">
            <label
              for="adv-shares"
              class="text-[11px] font-bold text-terminal-muted uppercase tracking-widest block"
              >Acciones Totales</label
            >
            <label class="inline-flex items-center cursor-pointer gap-2">
              <span class="text-[9px] font-black text-terminal-subtle uppercase tracking-tighter"
                >Millones</span
              >
              <div class="relative">
                <input type="checkbox" id="shares-millions-toggle" class="sr-only peer" />
                <div
                  class="w-7 h-4 bg-terminal-border-subtle rounded-full peer peer-checked:bg-emerald-500 peer-checked:after:translate-x-3 after:content-[''] after:absolute after:top-[2px] after:start-[2px] after:bg-terminal-secondary peer-checked:after:bg-white after:rounded-full after:h-3 after:w-3 after:transition-all"
                >
                </div>
              </div>
            </label>
          </div>
          <input
            type="number"
            id="adv-shares"
            inputmode="decimal"
            placeholder="Shares"
            class="w-full bg-terminal-bg border border-terminal-border py-4 px-6 text-xl font-bold text-white rounded-2xl focus:ring-2 focus:ring-emerald-400/50 focus:outline-none"
          />
        </div>
      </div>
      <div class="pt-6 border-t border-terminal-border/40">
        <label for="adv-margin" class="flex justify-between items-center mb-6 cursor-pointer">
          <span class="text-[11px] font-bold text-terminal-secondary uppercase tracking-widest"
            >Margen de Seguridad</span
          >
          <span id="margin-label" class="text-3xl font-black text-emerald-400 italic">30%</span>
        </label>
        <input
          type="range"
          id="adv-margin"
          min="5"
          max="50"
          value="30"
          class="w-full cursor-pointer accent-emerald-500 h-1.5 bg-terminal-border-subtle rounded-lg appearance-none"
          oninput="document.getElementById('margin-label').innerText = this.value + '%'"
        />
      </div>
    </div>

    <!-- Botón de cálculo -->
    <button
      id="calc-button"
      onclick="calculate()"
      class="w-full bg-gradient-to-r from-emerald-500 to-cyan-500 text-terminal-bg py-5 rounded-2xl font-black text-xs tracking-[0.4em] uppercase transition-all shadow-xl shadow-emerald-500/20 italic"
    >
      Ejecutar Algoritmo
    </button>
  </div>

  <!-- Zona de resultados -->
  <div id="result-area" class="hidden mt-16 border-t border-terminal-border/60 pt-16">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      <div
        class="bg-terminal-bg/60 border border-terminal-border p-10 rounded-[2rem] text-center md:text-left flex flex-col justify-center overflow-hidden"
      >
        <span
          class="text-[10px] font-bold text-terminal-muted uppercase tracking-[0.3em] mb-4 block"
          >Precio Objetivo</span
        >
        <div
          id="final-price"
          class="text-5xl md:text-4xl font-black text-white tracking-tighter mb-2 leading-tight break-all overflow-hidden"
          title="$0.00"
        >
          $0.00
        </div>
        <div
          class="text-[9px] text-emerald-400 font-black uppercase tracking-widest flex items-center gap-2"
        >
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
          Target Price Multi-Asset
        </div>
      </div>
      <div
        class="bg-terminal-bg/60 border border-terminal-border p-10 rounded-[2rem] flex flex-col justify-center overflow-hidden"
      >
        <span
          class="text-[10px] font-bold text-terminal-muted uppercase tracking-[0.3em] mb-4 block"
          >Estatus Terminal</span
        >
        <div
          id="status-text"
          class="text-xl font-bold text-white mb-3 italic tracking-tight truncate overflow-hidden"
        >
          Análisis Completado
        </div>
        <p
          id="final-desc"
          class="text-[11px] text-terminal-muted leading-relaxed font-medium italic"
        >
        </p>
      </div>
    </div>
  </div>
</div>

<script>
  // ============================================================
  // CalculatorForm — Lógica encapsulada sin variables globales
  // 5.2: Se elimina el uso de is:inline y las funciones globales.
  //       Todo queda en el scope de esta función, sin contaminar window.
  // ============================================================
  function setupCalculator() {
    let currentMode = "basic"

    const btnBasic = document.getElementById("btn-basic") as HTMLButtonElement | null
    const btnAdv = document.getElementById("btn-advanced") as HTMLButtonElement | null
    const formBasic = document.getElementById("form-basic")
    const formAdv = document.getElementById("form-advanced")
    const resultArea = document.getElementById("result-area")
    const finalPrice = document.getElementById("final-price")
    const finalDesc = document.getElementById("final-desc")
    const statusText = document.getElementById("status-text")
    const calcButton = document.getElementById("calc-button") as HTMLButtonElement | null

    if (!btnBasic || !btnAdv || !formBasic || !formAdv || !resultArea) return

    // ── Helpers ───────────────────────────────────────────────
    const highlightError = (elementId: string) => {
      const el = document.getElementById(elementId)
      if (el) {
        el.classList.add("ring-2", "ring-rose-500", "border-rose-500")
        setTimeout(() => {
          el.classList.remove("ring-2", "ring-rose-500", "border-rose-500")
        }, 2000)
      }
    }

    const setMode = (mode: "basic" | "advanced") => {
      currentMode = mode
      resultArea.classList.add("hidden")

      if (mode === "basic") {
        btnBasic.classList.replace("text-terminal-muted", "text-white")
        btnBasic.classList.add("bg-terminal-border-subtle")
        btnAdv.classList.replace("text-white", "text-terminal-muted")
        btnAdv.classList.remove("bg-terminal-border-subtle")
        formBasic.classList.remove("hidden")
        formAdv.classList.add("hidden")
      } else {
        btnAdv.classList.replace("text-terminal-muted", "text-white")
        btnAdv.classList.add("bg-terminal-border-subtle")
        btnBasic.classList.replace("text-white", "text-terminal-muted")
        btnBasic.classList.remove("bg-terminal-border-subtle")
        formAdv.classList.remove("hidden")
        formBasic.classList.add("hidden")
      }
    }

    const calculate = () => {
      if (!calcButton || !finalPrice || !finalDesc || !statusText) return

      let hasError = false

      if (currentMode === "basic") {
        const epsInput = document.getElementById("basic-eps") as HTMLInputElement | null
        const growthInput = document.getElementById("basic-growth") as HTMLInputElement | null
        if (!epsInput?.value) {
          highlightError("basic-eps")
          hasError = true
        }
        if (!growthInput?.value) {
          highlightError("basic-growth")
          hasError = true
        }
      } else {
        ;["adv-fcf", "adv-growth", "adv-discount", "adv-shares"].forEach((id) => {
          const input = document.getElementById(id) as HTMLInputElement | null
          if (!input?.value) {
            highlightError(id)
            hasError = true
          }
        })
      }

      if (hasError) return

      calcButton.disabled = true
      calcButton.innerText = "Procesando..."
      resultArea.classList.add("hidden")

      setTimeout(() => {
        let result = 0

        if (currentMode === "basic") {
          const eps = parseFloat((document.getElementById("basic-eps") as HTMLInputElement).value)
          const growth = parseFloat(
            (document.getElementById("basic-growth") as HTMLInputElement).value,
          )

          if (isNaN(eps) || isNaN(growth)) {
            calcButton.disabled = false
            calcButton.innerText = "Ejecutar Algoritmo"
            return
          }
          result = eps * (8.5 + 2 * growth)
          statusText.innerText = "Target Graham"
          finalDesc.innerText = "Estimación fundamental rápida basada en el beneficio neto actual."
        } else {
          let fcf = parseFloat((document.getElementById("adv-fcf") as HTMLInputElement).value)
          const growth =
            parseFloat((document.getElementById("adv-growth") as HTMLInputElement).value) / 100
          const discount =
            parseFloat((document.getElementById("adv-discount") as HTMLInputElement).value) / 100
          let shares = parseFloat((document.getElementById("adv-shares") as HTMLInputElement).value)
          const margin =
            parseFloat((document.getElementById("adv-margin") as HTMLInputElement).value) / 100

          if (isNaN(fcf) || isNaN(growth) || isNaN(discount) || isNaN(shares)) {
            calcButton.disabled = false
            calcButton.innerText = "Ejecutar Algoritmo"
            return
          }

          if ((document.getElementById("fcf-millions-toggle") as HTMLInputElement)?.checked)
            fcf *= 1_000_000
          if ((document.getElementById("shares-millions-toggle") as HTMLInputElement)?.checked)
            shares *= 1_000_000

          let totalPV = 0
          let currentFCF = fcf
          for (let i = 1; i <= 5; i++) {
            currentFCF *= 1 + growth
            totalPV += currentFCF / Math.pow(1 + discount, i)
          }
          const terminalVal = (currentFCF * 1.025) / (discount - 0.025)
          const terminalPV = terminalVal / Math.pow(1 + discount, 5)
          result = ((totalPV + terminalPV) / shares) * (1 - margin)

          statusText.innerText = "Target Buffett"
          finalDesc.innerText =
            "Cálculo DCF avanzado con descuento de flujos y margen de seguridad."
        }

        const formattedPrice = `$${result.toLocaleString("en-US", { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`
        finalPrice.innerText = formattedPrice
        ;(finalPrice as HTMLElement).title = formattedPrice

        resultArea.classList.remove("hidden")
        calcButton.disabled = false
        calcButton.innerText = "Ejecutar Algoritmo"

        resultArea.scrollIntoView({ behavior: "smooth", block: "center" })
      }, 600)
    }

    // ── Listeners ─────────────────────────────────────────────
    btnBasic.addEventListener("click", () => setMode("basic"))
    btnAdv.addEventListener("click", () => setMode("advanced"))
    calcButton?.addEventListener("click", calculate)

    document.querySelectorAll<HTMLInputElement>('input[type="number"]').forEach((input) => {
      input.addEventListener("keydown", (e) => {
        if (e.key === "Enter") {
          e.preventDefault()
          calculate()
        }
      })
    })
  }

  setupCalculator()
  document.addEventListener("astro:page-load", setupCalculator)
</script>
