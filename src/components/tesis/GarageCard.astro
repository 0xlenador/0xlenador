---
/**
 * GarageCard.astro — Tarjeta de activo en fase de garaje (riesgo asimétrico).
 * Estilo propio con hover en rose para diferenciar del portfolio principal.
 */

interface Props {
  nombre: string;
  imagen: string;
  descripcion: string;
  ctaLabel: string;
  link: { nombre: string; url: string };
  href?: string;
}

const { nombre, imagen, descripcion, ctaLabel, link, href } = Astro.props;
---

<div
  class={`${href ? "relative" : ""} group bg-terminal-surface/40 border border-terminal-border p-6 rounded-2xl hover:border-rose-500/30 transition-all cursor-pointer`}
>
  {href && <a href={href} class="absolute inset-0 z-0"></a>}

  <div class={`flex items-center gap-4 mb-6 ${href ? "relative z-10 pointer-events-none" : ""}`}>
    <img
      src={imagen}
      alt={nombre}
      class="w-8 h-8 rounded bg-terminal-elevated border border-terminal-border object-contain"
    />
    <h3
      class="text-lg font-bold text-white group-hover:text-rose-400 transition-colors tracking-tight"
    >
      {nombre}
    </h3>
  </div>

  <p class={`text-xs text-terminal-muted leading-relaxed italic mb-6 ${href ? "relative z-10 pointer-events-none" : ""}`}>
    {descripcion}
  </p>

  <div
    class={`pt-4 border-t border-terminal-border/50 flex flex-wrap items-center gap-2 ${href ? "relative z-10" : ""}`}
  >
    <span class="text-[9px] font-mono text-terminal-subtle uppercase italic"
      >{ctaLabel}</span
    >
    <div class="flex flex-wrap gap-1.5">
      <a
        href={link.url}
        target="_blank"
        class="px-1.5 py-0.5 bg-terminal-surface border border-terminal-border text-terminal-muted text-[9px] font-bold uppercase rounded hover:border-rose-500/50 hover:text-rose-400 transition-all"
      >
        {link.nombre}
      </a>
    </div>
  </div>
</div>
