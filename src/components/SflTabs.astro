---
import { getLangFromUrl, useTranslations, getLocalizedPath } from '../i18n/utils';

interface Props {
  activeTab: 'mercado' | 'mascotas' | 'cocinando';
}

const { activeTab } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const loc = (path: string) => getLocalizedPath(path, lang);

const tabs = [
  {
    id: 'mercado',
    href: loc('/sfl-mercado'),
    label: t('nav.sub.sfl'),
    icon: '/img/sunflowerland/123/exchange.png'
  },
  {
    id: 'mascotas',
    href: loc('/sfl-mascotas'),
    label: t('nav.sub.pets'),
    icon: '/img/sunflowerland/123/ramsey.webp'
  },
  {
    id: 'cocinando',
    href: loc('/sfl-cocinando'),
    label: t('nav.sub.cooking'),
    icon: '/img/sunflowerland/food/Pizza Margherita.png'
  }
];
---

<div class="flex justify-center mt-6 relative z-20">
  <div class="bg-white/[0.02] backdrop-blur-xl border border-white/10 rounded-full p-1.5 flex items-center shadow-lg w-full max-w-2xl justify-between sm:justify-center sm:gap-2">
    {tabs.map((tab) => {
      const isActive = tab.id === activeTab;
      return (
        <a
          href={tab.href}
          data-astro-prefetch
          class:list={[
            "flex-1 sm:flex-none flex items-center justify-center gap-2 px-2 sm:px-6 py-2 sm:py-2.5 rounded-full text-[11px] sm:text-sm font-medium transition-all duration-300 group",
            isActive
              ? "bg-emerald-500/20 text-white shadow-[0_0_15px_rgba(16,185,129,0.3)] border border-emerald-500/30"
              : "text-white/50 hover:text-white/90 hover:bg-white/5 border border-transparent"
          ]}
        >
          <img 
            src={tab.icon} 
            alt={tab.label} 
            class:list={[
              "w-4 h-4 sm:w-5 sm:h-5 object-contain drop-shadow-md", 
              isActive ? "opacity-100" : "opacity-60 grayscale-[50%] transition-all duration-300 group-hover:grayscale-0 group-hover:opacity-100"
            ]} 
            loading="lazy" 
          />
          <span class="tracking-wide whitespace-nowrap">{tab.label}</span>
        </a>
      )
    })}
  </div>
</div>
