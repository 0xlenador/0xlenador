---
import { getLangFromUrl, useTranslations, getLocalizedPath } from '../i18n/utils';

interface Props {
  activeTab: 'mercado' | 'mascotas' | 'cocinando';
}

const { activeTab } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const loc = (path: string) => getLocalizedPath(path, lang);

const tabs = [
  {
    id: 'mercado',
    href: loc('/sfl-mercado'),
    label: t('nav.sub.sfl'),
    icon: '/img/sunflowerland/123/exchange.png'
  },
  {
    id: 'mascotas',
    href: loc('/sfl-mascotas'),
    label: t('nav.sub.pets'),
    icon: '/img/sunflowerland/123/ramsey.webp'
  },
  {
    id: 'cocinando',
    href: loc('/sfl-cocinando'),
    label: t('nav.sub.cooking'),
    icon: '/img/sunflowerland/food/Pizza Margherita.png'
  }
];
---

<div class="relative z-20 w-full mb-8 lg:mb-10 border-b border-white/[0.05] pb-6 lg:pb-8">
  <div class="bg-black/20 border border-white/5 rounded-2xl p-1.5 flex items-center w-full">
    {tabs.map((tab) => {
      const isActive = tab.id === activeTab;
      return (
        <a
          href={tab.href}
          data-astro-prefetch
          class:list={[
            "flex-1 flex items-center justify-center gap-2 px-2 sm:px-4 py-3 rounded-xl text-[11px] sm:text-sm font-bold transition-all duration-300 group",
            isActive
              ? "bg-white/5 text-emerald-400 shadow-sm border border-white/5"
              : "text-white/40 hover:text-white/80 hover:bg-white/[0.02] border border-transparent"
          ]}
        >
          <img 
            src={tab.icon} 
            alt={tab.label} 
            class:list={[
              "w-5 h-5 sm:w-6 sm:h-6 object-contain drop-shadow-md", 
              isActive ? "opacity-100 scale-110" : "opacity-50 grayscale-[80%] transition-all duration-300 group-hover:grayscale-0 group-hover:opacity-100"
            ]} 
            loading="lazy" 
          />
          <span class="tracking-wide uppercase whitespace-nowrap">{tab.label}</span>
        </a>
      )
    })}
  </div>
</div>
