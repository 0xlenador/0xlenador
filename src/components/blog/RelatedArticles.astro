---
import tagsData from "../../data/tags.json"
import { getBlogPostsByLang } from "../../lib/content"
import { formatDate } from "../../i18n/utils"

const { post, lang, t } = Astro.props

// 1. Determinar el "slug base" (el español) para buscar en tags.json
// Si estamos en inglés, nuestro baseSlug es translationSlug. Si estamos en español, es post.slug
const baseSlug = lang === "en" && post.data.translationSlug ? post.data.translationSlug : post.slug

// 2. Encontrar a qué etiquetas pertenece el artículo actual
const currentTags = tagsData[baseSlug] || []

// 3. Encontrar otros slugs base (español) que compartan al menos una etiqueta
const relatedBaseSlugs = new Set<string>()

if (currentTags.length > 0) {
  for (const [slug, tags] of Object.entries(tagsData)) {
    if (slug === baseSlug) continue
    
    // Si el post iterado tiene al menos un tag en común, es un artículo relacionado
    const hasSharedTag = tags.some((tag) => currentTags.includes(tag))
    if (hasSharedTag) {
      relatedBaseSlugs.add(slug)
    }
  }
}

// 4. Obtener los artículos reales a partir de los slugs base, respetando el idioma actual
let relatedPosts = []
if (relatedBaseSlugs.size > 0) {
  const allPosts = await getBlogPostsByLang(lang)
  
  relatedPosts = allPosts.filter((p: any) => {
    if (lang === "en") {
      // En inglés, el post debe tener un translationSlug que esté en nuestro Set de relacionados
      return relatedBaseSlugs.has(p.data.translationSlug)
    } else {
      // En español, comparamos el slug directamente
      return relatedBaseSlugs.has(p.slug)
    }
  })
}

// 5. Limitar a máximo 2 o 3 artículos para no recargar la interfaz
relatedPosts = relatedPosts.slice(0, 2)
---

{relatedPosts.length > 0 && (
  <section class="mt-24 pt-12 border-t border-terminal-border/60">
    <div class="flex items-center gap-3 mb-8">
      <div class="w-1 h-6 bg-emerald-500 rounded-full shadow-[0_0_10px_rgba(16,185,129,0.5)]"></div>
      <h3 class="text-xl font-bold text-white tracking-tight">Artículos Relacionados</h3>
      {currentTags.length > 0 && (
        <div class="ml-auto flex flex-wrap gap-2 justify-end">
          {currentTags.map((tag) => (
            <span class="text-xs font-mono text-emerald-400 bg-emerald-500/10 px-2.5 py-1 rounded-md border border-emerald-500/20 shadow-sm">
              {tag}
            </span>
          ))}
        </div>
      )}
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {relatedPosts.map((post: any) => (
        <a
          href={lang === "en" ? `/en/blog/${post.slug}/` : `/blog/${post.slug}/`}
          class="group block h-full"
        >
          <div class="bg-terminal-surface/20 border border-terminal-border p-6 rounded-2xl hover:border-emerald-500/20 hover:bg-terminal-surface/35 transition-all duration-300 flex flex-col justify-between h-full relative overflow-hidden">
            {post.data.coverImage && (
              <div class="mb-5 -mx-6 -mt-6 aspect-video overflow-hidden border-b border-terminal-border/50">
                <img
                  src={post.data.coverImage.src}
                  alt={post.data.coverAlt || post.data.title}
                  class="w-full h-full object-cover group-hover:scale-[1.03] transition-transform duration-500"
                  loading="lazy"
                />
              </div>
            )}
            <div class="flex flex-col flex-grow justify-between">
              <div>
                <div class="flex justify-between items-center mb-4 font-mono text-[9px] uppercase tracking-wider">
                  <span class="text-emerald-400 bg-emerald-500/10 border border-emerald-500/10 px-2 py-0.5 rounded-md font-semibold">
                    {post.data.category}
                  </span>
                  <span class="text-terminal-muted">{formatDate(post.data.date, lang)}</span>
                </div>
                <h4 class="text-base font-bold text-white group-hover:text-emerald-400 transition-colors tracking-tight leading-snug mb-3">
                  {post.data.title}
                </h4>
                <p class="text-xs text-terminal-secondary leading-relaxed font-light line-clamp-3">
                  {post.data.description}
                </p>
              </div>

              <div class="pt-4 mt-6 border-t border-terminal-border/50 flex items-center justify-between font-mono text-[9px] text-terminal-muted">
                <span class="uppercase tracking-wider">
                  {post.data.readTime || "5 min"} {t("blog.post.read")}
                </span>
                <span class="font-bold uppercase tracking-widest text-emerald-400 group-hover:translate-x-0.5 transition-transform">
                  {t("blog.history.access")}
                </span>
              </div>
            </div>
          </div>
        </a>
      ))}
    </div>
  </section>
)}
