---
/**
 * ShareButtons.astro — Botones de compartir un artículo del blog.
 * Soporta: X (Twitter), Facebook, Telegram y copia al portapapeles.
 * El título se recibe como prop para pre-rellenar el texto del tweet/mensaje.
 */

import { getLangFromUrl, useTranslations } from "../../i18n/utils"

interface Props {
  title: string
}

const { title } = Astro.props
const encodedTitle = encodeURIComponent(title)

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)
---

<div class="bg-terminal-surface/40 p-6 rounded-2xl border border-terminal-border/60">
  <h3 class="text-white font-bold text-base mb-4">{t('blog.article.share')}</h3>
  <div class="flex items-center gap-3">
    <!-- X (Twitter) -->
    <button
      id="share-twitter"
      aria-label="Compartir en X (Twitter)"
      data-encoded-title={encodedTitle}
      class="flex-1 flex justify-center p-3 rounded-xl bg-terminal-surface border border-terminal-border text-terminal-secondary hover:text-emerald-400 hover:border-emerald-500/30 hover:bg-emerald-500/5 transition-all cursor-pointer"
    >
      <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path
          d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"
        ></path>
      </svg>
    </button>

    <!-- Facebook -->
    <button
      id="share-facebook"
      aria-label="Compartir en Facebook"
      class="flex-1 flex justify-center p-3 rounded-xl bg-terminal-surface border border-terminal-border text-terminal-secondary hover:text-emerald-400 hover:border-emerald-500/30 hover:bg-emerald-500/5 transition-all cursor-pointer"
    >
      <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path
          d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"
        ></path>
      </svg>
    </button>

    <!-- Telegram -->
    <button
      id="share-telegram"
      aria-label="Compartir en Telegram"
      data-encoded-title={encodedTitle}
      class="flex-1 flex justify-center p-3 rounded-xl bg-terminal-surface border border-terminal-border text-terminal-secondary hover:text-emerald-400 hover:border-emerald-500/30 hover:bg-emerald-500/5 transition-all cursor-pointer"
    >
      <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path
          d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"
        ></path>
      </svg>
    </button>

    <!-- Copiar enlace -->
    <button
      id="share-copy"
      aria-label="Copiar enlace al portapapeles"
      data-copied-text={t('blog.article.share.copied') as any || "Copiado / Copied"}
      class="flex-1 flex justify-center p-3 rounded-xl bg-terminal-surface border border-terminal-border text-terminal-secondary hover:text-emerald-400 hover:border-emerald-500/30 hover:bg-emerald-500/5 transition-all cursor-pointer"
    >
      <svg
        class="w-5 h-5"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
        stroke-width="2"
        aria-hidden="true"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"
        ></path>
      </svg>
    </button>
  </div>
</div>

<script>
  // Centraliza la lógica de compartir sin onclick inline ni variables globales.
  function setupShareButtons() {
    const url = window.location.href

    const twitter = document.getElementById("share-twitter")
    const facebook = document.getElementById("share-facebook")
    const telegram = document.getElementById("share-telegram")
    const copy = document.getElementById("share-copy")

    if (twitter) {
      const title = twitter.dataset.encodedTitle ?? ""
      twitter.addEventListener("click", () => {
        window.open(
          `https://twitter.com/intent/tweet?text=${title}&url=${encodeURIComponent(url)}`,
          "_blank",
          "noopener,noreferrer",
        )
      })
    }

    if (facebook) {
      facebook.addEventListener("click", () => {
        window.open(
          `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(url)}`,
          "_blank",
          "noopener,noreferrer",
        )
      })
    }

    if (telegram) {
      const title = telegram.dataset.encodedTitle ?? ""
      telegram.addEventListener("click", () => {
        window.open(
          `https://t.me/share/url?url=${encodeURIComponent(url)}&text=${title}`,
          "_blank",
          "noopener,noreferrer",
        )
      })
    }

    if (copy) {
      copy.addEventListener("click", async () => {
        try {
          await navigator.clipboard.writeText(url)
          // Feedback visual temporal en el botón
          const svg = copy.querySelector("svg")
          if (svg) {
            svg.innerHTML = `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />`
          }
          copy.classList.add("text-emerald-400", "border-emerald-500/30")
          setTimeout(() => {
            if (svg) {
              svg.innerHTML = `<path stroke-linecap="round" stroke-linejoin="round" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />`
            }
            copy.classList.remove("text-emerald-400", "border-emerald-500/30")
          }, 2000)
        } catch {
          // Fallback para contextos sin acceso al portapapeles
          alert(copy.dataset.copiedText || "Copiado al portapapeles")
        }
      })
    }
  }

  // Compatible con navegación por rutas de Astro
  document.addEventListener("astro:page-load", setupShareButtons)
  setupShareButtons()
</script>
