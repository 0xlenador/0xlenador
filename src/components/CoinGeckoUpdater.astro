---
/**
 * CoinGeckoUpdater.astro
 * Componente centralizado para extraer precios en vivo de la API de CoinGecko.
 * Funciona globalmente buscando elementos con la clase "price-value" y "cg-sparkline".
 */
---
<script>
  import { createSparklineSVG, formatNumber, initSparklineHover } from "../utils/sparklines";

  const CACHE_KEY = "ticker_prices_v3"
  const CACHE_TTL = 15 * 60 * 1000 // 15 minutos en ms

  interface CoinData {
    usd: number;
    sparkline?: number[];
    isPositive?: boolean;
    change24h?: number;
    change7d?: number;
    change30d?: number;
    totalVolume?: number;
  }

  function getCached(): Record<string, CoinData> | null {
    try {
      const raw = localStorage.getItem(CACHE_KEY)
      if (!raw) return null
      const { ts, data } = JSON.parse(raw) as { ts: number; data: Record<string, CoinData> }
      if (Date.now() - ts > CACHE_TTL) {
        localStorage.removeItem(CACHE_KEY)
        return null
      }
      return data
    } catch {
      return null
    }
  }

  function setCache(data: Record<string, CoinData>) {
    try {
      localStorage.setItem(CACHE_KEY, JSON.stringify({ ts: Date.now(), data }))
    } catch {
      /* quota excedida */
    }
  }

  function applyPrices(dataMap: Record<string, CoinData>) {
    // 1. Aplicar precios
    document.querySelectorAll<HTMLElement>(".price-value").forEach((el) => {
      const id = el.getAttribute("data-coin-id") ?? ""
      const info = dataMap[id]
      if (info == null || info.usd == null) return

      const fmt = (n: number) =>
        n >= 100
          ? n.toLocaleString("en-US", {
              style: "currency",
              currency: "USD",
              minimumFractionDigits: 0,
              maximumFractionDigits: 0,
            })
          : n < 0.01
            ? "$" + n.toPrecision(4)
            : n.toLocaleString("en-US", {
                style: "currency",
                currency: "USD",
                minimumFractionDigits: 2,
                maximumFractionDigits: 4,
              })

      el.textContent = fmt(info.usd)
      el.classList.remove("animate-pulse")
    })

    // 2. Aplicar Sparklines
    document.querySelectorAll<HTMLElement>(".cg-sparkline").forEach((el) => {
      const id = el.getAttribute("data-coin-id") ?? ""
      const info = dataMap[id]
      
      if (!info || !info.sparkline || info.sparkline.length < 2) {
        el.innerHTML = `<span class="font-mono text-[10px] text-terminal-subtle/30">N/A</span>`
        return
      }

      el.innerHTML = createSparklineSVG(info.sparkline, info.isPositive ?? true, undefined, true)
    })
  }

  function publishData(dataMap: Record<string, CoinData>) {
    (window as any).__CoinGeckoEngine = dataMap;
    document.dispatchEvent(new CustomEvent("coingecko-data-ready", { detail: dataMap }));
    applyPrices(dataMap);
  }

  async function fetchPrices() {
    const cached = getCached()
    if (cached) {
      publishData(cached)
      return
    }

    const elements = document.querySelectorAll<HTMLElement>(".price-value, .cg-sparkline")
    const coinIds = new Set<string>()
    const nftIds = new Set<string>()
    const vol7dIds = new Set<string>()

    elements.forEach((el) => {
      const id = el.getAttribute("data-coin-id") ?? ""
      if (!id) return
      if (el.getAttribute("data-is-nft") === "true") nftIds.add(id)
      else coinIds.add(id)
      
      if (el.getAttribute("data-needs-volume-7d") === "true") vol7dIds.add(id)
    })

    if (coinIds.size === 0 && nftIds.size === 0) return

    const dataMap: Record<string, CoinData> = {}
    let btcUsd = 0

    if (coinIds.size > 0) {
      try {
        const res = await fetch(
          `https://api.coingecko.com/api/v3/coins/markets?vs_currency=usd&ids=${[...coinIds].join(",")}&sparkline=true&price_change_percentage=24h,7d,30d`
        )
        const data = await res.json()
        if (Array.isArray(data)) {
          for (const coin of data) {
            dataMap[coin.id] = {
              usd: coin.current_price,
              sparkline: coin.sparkline_in_7d?.price,
              isPositive: (coin.price_change_percentage_7d_in_currency || coin.price_change_percentage_7d) >= 0 || (coin.price_change_percentage_24h_in_currency || coin.price_change_percentage_24h) >= 0,
              change24h: coin.price_change_percentage_24h_in_currency || coin.price_change_percentage_24h,
              change7d: coin.price_change_percentage_7d_in_currency || coin.price_change_percentage_7d,
              change30d: coin.price_change_percentage_30d_in_currency || coin.price_change_percentage_30d,
              totalVolume: coin.total_volume
            }
            if (coin.id === "bitcoin") btcUsd = coin.current_price
          }
        }
      } catch (err) {
        console.error("CoinGecko markets:", err)
      }

      // Fetch 7D volume for requested coins
      for (const vId of vol7dIds) {
        try {
          const resVol = await fetch(`https://api.coingecko.com/api/v3/coins/${vId}/market_chart?vs_currency=usd&days=7`)
          const volData = await resVol.json()
          if (volData && volData.total_volumes && dataMap[vId]) {
            let sumVol7d = 0
            for (let i = 0; i < volData.total_volumes.length; i += 24) {
              sumVol7d += volData.total_volumes[i][1]
            }
            if (sumVol7d > 0) {
              dataMap[vId].totalVolume = sumVol7d
            }
          }
        } catch (err) {
          console.error(`CoinGecko Volume 7D ${vId}:`, err)
        }
      }
    }

    for (const nftId of nftIds) {
      try {
        const res = await fetch(`https://api.coingecko.com/api/v3/nfts/${nftId}`)
        const data = (await res.json()) as any
        const usd =
          data.floor_price?.usd ??
          (data.floor_price?.native_currency && btcUsd > 0
            ? data.floor_price.native_currency * btcUsd
            : 0)
        if (usd > 0) {
          dataMap[nftId] = { usd }
        }
      } catch (err) {
        console.error(`CoinGecko NFT ${nftId}:`, err)
      }
    }

    publishData(dataMap)
    if (Object.keys(dataMap).length > 0) setCache(dataMap)

    document.querySelectorAll<HTMLElement>(".price-value").forEach((el) => {
      if (el.textContent === "$---") {
        el.textContent = "N/A"
        el.classList.remove("text-emerald-400")
        el.classList.add("text-terminal-muted")
      }
    })
    document.querySelectorAll<HTMLElement>(".cg-sparkline").forEach((el) => {
      if (el.innerHTML.includes("animate-pulse")) {
        el.innerHTML = `<span class="font-mono text-[10px] text-terminal-subtle/30">N/A</span>`
      }
    })
  }

  document.addEventListener("astro:page-load", () => {
    initSparklineHover()
    fetchPrices()
  })
  if (document.readyState === "complete" || document.readyState === "interactive") {
    initSparklineHover()
    fetchPrices()
  } else {
    document.addEventListener("DOMContentLoaded", () => {
      initSparklineHover()
      fetchPrices()
    })
  }
</script>
