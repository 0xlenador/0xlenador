---
import SocialLinks from "./SocialLinks.astro"
import { useTranslations, getLocalizedPath, type Lang } from "../i18n"
import { Image } from "astro:assets"
import logoImg from "../assets/img/logo.webp"

interface Props {
  lang: Lang
}

const { lang } = Astro.props
const t = useTranslations(lang)
const loc = (path: string) => getLocalizedPath(path, lang)
---

<footer class="mt-16 border-t border-terminal-border-subtle bg-terminal-bg py-16 px-6">
  <div class="max-w-6xl mx-auto">
    <!-- Disclaimer legal -->
    <div class="mb-12 pb-8 border-b border-terminal-border-subtle/50">
      <p
        class="text-[10px] font-mono text-terminal-subtle uppercase tracking-[0.2em] text-center md:text-left leading-relaxed"
      >
        <b class="text-terminal-muted font-bold">Disclaimer:</b>
        {t("footer.disclaimer")}
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-4 gap-12 mb-12">
      <!-- Identidad de marca -->
      <div class="space-y-4">
        <div class="flex items-center gap-2.5 text-2xl font-bold tracking-tighter text-white">
          <Image
            src={logoImg}
            alt="Logo 0x Leñador"
            width={56}
            height={56}
            loading="lazy"
            class="w-7 h-7 object-contain"
          />
          <span class="leading-none">0x<span class="ml-1 md:ml-1.5 text-emerald-500">Leñador</span></span>
        </div>
        <div class="text-terminal-muted text-sm leading-relaxed max-w-xs">
          <p>{t("footer.brand.description")}</p>
          <a href={loc("/autor")} class="inline-block mt-2 text-emerald-500 hover:text-emerald-400 transition-colors font-medium">
            {t("footer.link.autor")} →
          </a>
        </div>
      </div>

      <!-- Mapa del sitio -->
      <div class="flex flex-col gap-3">
        <h4 class="text-white font-bold text-xs uppercase tracking-widest mb-2">
          {t("footer.col.navegacion")}
        </h4>
        <a
          href={loc("/")}
          class="text-terminal-muted hover:text-emerald-400 text-sm transition w-fit"
        >
          {t("footer.link.inicio")}
        </a>
        <a
          href={loc("/herramientas")}
          class="text-terminal-muted hover:text-emerald-400 text-sm transition w-fit"
        >
          {t("footer.link.herramientas")}
        </a>
        <a
          href={loc("/directorio")}
          class="text-terminal-muted hover:text-emerald-400 text-sm transition w-fit"
        >
          {t("footer.link.directorio")}
        </a>
        <a
          href={loc("/activos")}
          class="text-terminal-muted hover:text-emerald-400 text-sm transition w-fit"
        >
          {t("footer.link.activos")}
        </a>
        <a
          href={loc("/operaciones")}
          class="text-terminal-muted hover:text-emerald-400 text-sm transition w-fit"
        >
          {t("footer.link.operaciones")}
        </a>
        <a
          href={loc("/blog")}
          class="text-terminal-muted hover:text-emerald-400 text-sm transition w-fit"
        >
          {t("footer.link.blog")}
        </a>
      </div>

      <!-- Comunidad -->
      <div class="flex flex-col gap-3">
        <h4 class="text-white font-bold text-xs uppercase tracking-widest mb-2">
          {t("footer.col.comunidad")}
        </h4>
        <SocialLinks variant="with-label" size="sm" />
      </div>

      <!-- Legal -->
      <div class="flex flex-col gap-3">
        <h4 class="text-white font-bold text-xs uppercase tracking-widest mb-2">
          {t("footer.col.legal")}
        </h4>
        <a
          href={loc("/privacidad")}
          class="text-terminal-muted hover:text-emerald-400 text-sm transition w-fit"
        >
          {t("footer.link.privacidad")}
        </a>
        <a
          href={loc("/terminos")}
          class="text-terminal-muted hover:text-emerald-400 text-sm transition w-fit"
        >
          {t("footer.link.terminos")}
        </a>
      </div>
    </div>

    <!-- Barra inferior de estado -->
    <div
      class="pt-8 border-t border-terminal-border-subtle flex flex-col md:flex-row justify-between items-center gap-4"
    >
      <p class="text-terminal-subtle text-[10px] uppercase tracking-widest font-mono">
        {t("footer.copyright")}
      </p>
      <div class="flex gap-6">
        <span class="text-[10px] text-terminal-dim font-mono uppercase tracking-tighter">
          {t("footer.status")}
        </span>
        <span class="text-[10px] text-emerald-500/50 font-mono animate-pulse uppercase">
          &#9679; {t("footer.live")}
        </span>
      </div>
    </div>
  </div>
</footer>
