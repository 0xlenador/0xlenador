---
interface Props {
  step: string
  text: string
}
const { step, text } = Astro.props
---

<div
  class="flex items-center gap-3 bg-terminal-surface/50 hover:bg-terminal-surface border border-terminal-border/40 hover:border-terminal-border rounded-xl p-2.5 transition-colors"
>
  <div
    class="flex-shrink-0 w-6 h-6 rounded-md bg-emerald-500/10 border border-emerald-500/30 flex items-center justify-center text-emerald-400 font-mono text-[10px] font-bold"
  >
    {step}
  </div>
  <div class="flex-grow text-sm text-terminal-secondary font-medium">
    {text}
  </div>
  <div class="flex-shrink-0 flex items-center">
    <slot />
  </div>
</div>
