---
import { getLangFromUrl, useTranslations } from "../../i18n/utils"
const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)
---

<div class="relative mb-12 group not-prose">
  <!-- Borde iluminado con gradiente (Cyan a Esmeralda) -->
  <div
    class="absolute -inset-[1px] bg-gradient-to-r from-cyan-500/40 via-emerald-500/40 to-cyan-500/40 rounded-3xl opacity-70 group-hover:opacity-100 blur-[2px] transition-opacity duration-500"
  >
  </div>
  <div
    class="absolute -inset-[1px] bg-gradient-to-r from-cyan-500/60 via-emerald-500/60 to-cyan-500/60 rounded-3xl z-0"
  >
  </div>

  <!-- Contenido de la tarjeta -->
  <div
    class="relative z-10 bg-[#0A0D10] border border-terminal-border/20 rounded-3xl p-6 md:p-8 shadow-[0_0_40px_rgba(6,182,212,0.1)]"
  >
    <div class="flex flex-col justify-center">
      <h3
        class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 to-emerald-400 font-mono text-sm uppercase tracking-widest mb-6 flex items-center gap-2 font-bold"
      >
        <svg
          class="w-5 h-5 text-cyan-400"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
          stroke-width="2"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"
          ></path>
        </svg>
        {t("ops.guide.summary")}
      </h3>
      <div class="flex flex-col gap-3">
        <slot />
      </div>
    </div>
  </div>
</div>
