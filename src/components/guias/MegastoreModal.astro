---
import ZoomableImage from "./ZoomableImage.astro"
import { Image } from "astro:assets"

import duendeShoesImg from "../../assets/img/guias/sfl-season-16/duende_shoes.png"
import duendePantsImg from "../../assets/img/guias/sfl-season-16/duende_pants.png"
import duendeShirtImg from "../../assets/img/guias/sfl-season-16/duende_shirt.png"
import duendeHatImg from "../../assets/img/guias/sfl-season-16/duende_hat.png"
import gourmetHourglassImg from "../../assets/img/guias/sfl-season-16/gourmet_hourglass.webp"
import duendeMonumentImg from "../../assets/img/guias/sfl-season-16/duende_monument.webp"
import strawHouseImg from "../../assets/img/guias/sfl-season-16/straw_house.webp"
import raffleTicketImg from "../../assets/img/guias/sfl-season-16/raffle_ticket.png"
import miningDrillImg from "../../assets/img/guias/sfl-season-16/mining_drill.webp"
import cloverCoinImg from "../../assets/img/guias/sfl-season-16/clover_coin.webp"

import coinImg from "../../assets/img/guias/sfl-season-16/coins.png"
import sflCoinImg from "../../assets/img/guias/sfl-season-16/sunflower_coin.webp"
import beetleWingImg from "../../assets/img/guias/sfl-season-16/beetle_wing.webp"

interface Props {
  lang?: "es" | "en"
}

const { lang = "es" } = Astro.props

const isEn = lang === "en"

const items = [
  {
    name: isEn ? "Duende Shoes" : "Zapatos Duende",
    src: duendeShoesImg,
    cost: "5,000",
    currency: coinImg,
    isBoost: true,
  },
  {
    name: isEn ? "Duende Pants" : "Pantalón Duende",
    src: duendePantsImg,
    cost: "10",
    currency: sflCoinImg,
    isBoost: true,
  },
  {
    name: isEn ? "Duende Shirt" : "Camisa Duende",
    src: duendeShirtImg,
    cost: "50",
    currency: sflCoinImg,
    isBoost: true,
  },
  {
    name: isEn ? "Gourmet Hourglass" : "Reloj Gourmet",
    src: gourmetHourglassImg,
    cost: "100",
    currency: beetleWingImg,
    isBoost: true,
  },
  {
    name: isEn ? "Harvest Hourglass" : "Reloj Cosecha",
    src: gourmetHourglassImg,
    cost: "200",
    currency: beetleWingImg,
    isBoost: true,
  },
  {
    name: isEn ? "Timber Hourglass" : "Reloj Madera",
    src: gourmetHourglassImg,
    cost: "200",
    currency: beetleWingImg,
    isBoost: true,
  },
  {
    name: isEn ? "Blossom Hourglass" : "Reloj Flores",
    src: gourmetHourglassImg,
    cost: "200",
    currency: beetleWingImg,
    isBoost: true,
  },
  {
    name: isEn ? "Fisher's Hourglass" : "Reloj Pesca",
    src: gourmetHourglassImg,
    cost: "200",
    currency: beetleWingImg,
    isBoost: true,
  },
  {
    name: isEn ? "Orchard Hourglass" : "Reloj Frutas",
    src: gourmetHourglassImg,
    cost: "200",
    currency: beetleWingImg,
    isBoost: true,
  },
  {
    name: isEn ? "Ore Hourglass" : "Reloj Minería",
    src: gourmetHourglassImg,
    cost: "400",
    currency: beetleWingImg,
    isBoost: true,
  },
  {
    name: isEn ? "Duende Monument" : "Monumento Duende",
    src: duendeMonumentImg,
    cost: "4,000",
    currency: beetleWingImg,
    isBoost: true,
  },
  {
    name: isEn ? "Duende Hat" : "Sombrero Duende",
    src: duendeHatImg,
    cost: "9,000",
    currency: beetleWingImg,
    isBoost: true,
  },
  {
    name: isEn ? "Straw House" : "Casa de Paja",
    src: strawHouseImg,
    cost: "9,000",
    currency: beetleWingImg,
    isBoost: true,
  },
  {
    name: isEn ? "Mining Drill" : "Taladro Minero",
    src: miningDrillImg,
    cost: "2,500",
    currency: beetleWingImg,
    isBoost: true,
  },
  {
    name: isEn ? "Pot of Luck" : "Olla de la Suerte",
    src: cloverCoinImg,
    cost: "250",
    currency: cloverCoinImg,
    isBoost: true,
  },
  {
    name: isEn ? "Raffle Ticket" : "Boleto de Rifa",
    src: raffleTicketImg,
    cost: "100",
    currency: beetleWingImg,
    isBoost: false,
  },
]
---

<div class="my-8 not-prose max-w-4xl mx-auto select-none">
  <!-- Pestañas Superiores (Tabs) -->
  <div class="flex items-end justify-between px-2 sm:px-4">
    <div class="flex items-end gap-1.5">
      <!-- Pestaña Activa -->
      <div
        class="bg-[#dfad7a] border-t-[3px] border-l-[3px] border-r-[3px] border-[#3c200c] rounded-t-xl px-3 sm:px-4 py-2 flex items-center gap-2 shadow-[0_-2px_0_rgba(255,255,255,0.2)] relative z-10"
      >
        <Image
          src={beetleWingImg}
          alt=""
          class="w-4 h-4 object-contain [image-rendering:pixelated]"
        />
        <span
          class="font-mono text-xs sm:text-sm font-black text-[#3c200c] tracking-tight"
          style="color: #3c200c !important;"
        >
          {isEn ? "Cave Dwellers Store" : "Tienda Cave Dwellers"}
        </span>
      </div>

      <!-- Pestaña Inactiva -->
      <div
        class="bg-[#a6774a] border-t-[3px] border-l-[3px] border-r-[3px] border-[#3c200c] rounded-t-xl px-3 sm:px-4 py-1.5 flex items-center gap-1.5 opacity-75 hover:opacity-90 transition-opacity cursor-default mb-0"
      >
        <span class="text-xs">🎁</span>
        <span class="font-mono text-xs font-bold text-[#f7e3cf]">
          {isEn ? "Rewards" : "Recompensas"}
        </span>
      </div>
    </div>
  </div>

  <!-- Caja Principal Estilo Modal Sunflower Land -->
  <div
    class="bg-[#dfad7a] border-[4px] border-[#3c200c] rounded-2xl p-3 sm:p-5 shadow-[0_8px_0_#241205,inset_0_3px_0_rgba(255,255,255,0.3)] relative -mt-[3px]"
  >
    <!-- Cabecera Interior: Pills y Mensaje -->
    <div class="flex flex-wrap items-center justify-between gap-2 mb-3">
      <div
        class="bg-[#f0f0f4] border-2 border-[#2b2b36] rounded-md px-2.5 py-0.5 text-xs font-black text-[#2b2b36] shadow-[inset_0_1px_0_#fff,0_2px_0_#2b2b36]"
      >
        {isEn ? "Stella's Megastore" : "Megastore de Stella"}
      </div>

      <div
        class="bg-[#e11d48] border-2 border-[#2b2b36] rounded-md px-2.5 py-0.5 text-xs font-black text-white shadow-[0_2px_0_#2b2b36] flex items-center gap-1.5"
      >
        <span>⏱️</span>
        <span>{isEn ? "Nov 2, 2026 – Feb 1, 2027" : "2 Nov 2026 – 1 Feb 2027"}</span>
      </div>
    </div>

    <!-- Subtítulo oficial del juego -->
    <p
      class="font-mono text-xs sm:text-[13px] font-bold leading-relaxed mb-4 !text-[#261306]"
      style="color: #261306 !important;"
    >
      {
        isEn
          ? "Welcome to my chapter store. Gather resources & exchange them for rare items before time runs out!"
          : "¡Bienvenido a mi tienda de capítulo! Reúne recursos y canjéalos por artículos raros antes de que se acabe el tiempo."
      }
    </p>

    <!-- Rejilla Interior de Slots (Huecos de Tienda) -->
    <div
      class="bg-[#b38050] border-2 border-[#45230c] rounded-xl p-2.5 sm:p-3.5 shadow-[inset_0_3px_6px_rgba(0,0,0,0.35)] grid grid-cols-2 sm:grid-cols-4 md:grid-cols-6 lg:grid-cols-7 gap-2 sm:gap-2.5"
    >
      {
        items.map((item) => (
          <div class="relative bg-[#dfad7a] border-2 border-[#45230c] rounded-lg p-1.5 flex flex-col items-center justify-between min-h-[110px] sm:min-h-[120px] shadow-[inset_0_2px_0_rgba(255,255,255,0.4),0_2px_0_#45230c] hover:brightness-105 transition-all group">
            {/* Rayo de Boost (Utility) en esquina superior izquierda */}
            {item.isBoost && (
              <span class="absolute top-1 left-1.5 text-xs text-amber-500 font-bold select-none leading-none drop-shadow-[0_1px_0_#45230c]">
                ⚡
              </span>
            )}

            {/* Sprite Pixel Art Centrado */}
            <div class="flex-1 flex items-center justify-center py-1 w-full">
              <ZoomableImage
                src={item.src}
                alt={item.name}
                class="w-12 h-12 sm:w-13 sm:h-13 object-contain [image-rendering:pixelated] group-hover:scale-110 transition-transform"
              />
            </div>

            {/* Barra / Pastilla de Precio anclada abajo */}
            <div class="bg-[#f6c343] border-2 border-[#45230c] rounded-md px-1.5 py-0.5 flex items-center justify-center gap-1 w-[92%] shadow-[0_2px_0_#45230c] -mb-1">
              <Image
                src={item.currency}
                alt=""
                class="w-3.5 h-3.5 object-contain [image-rendering:pixelated] -ml-0.5"
              />
              <span class="font-mono text-[11px] sm:text-xs font-black text-[#2e1505] tracking-tight">
                {item.cost}
              </span>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</div>

