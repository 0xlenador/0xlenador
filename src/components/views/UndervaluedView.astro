      <!-- Desktop Header -->
      <div class="hidden lg:grid grid-cols-[22%_8%_10%_10%_9%_8%_8%_11%_14%] border-b border-white/[0.05] pb-2 mb-2 px-6 mt-4 items-center">
        <div class="flex items-center gap-4">
          <div class="text-[13px] font-sans text-white/50 font-medium capitalize cursor-pointer hover:text-white transition-colors group select-none flex items-center gap-2" onclick="window.handleSort('name')">
            {t("undervalued.table.name")}
            <span class="sort-icon opacity-0 group-hover:opacity-50 transition-opacity" data-col="name">↕</span>
          </div>
          <button id="btn-sort-crypto" class="text-[6px] font-mono font-medium px-1 py-0.5 rounded bg-fuchsia-500/10 text-fuchsia-400/70 border border-fuchsia-500/20 hover:bg-fuchsia-500/20 hover:text-fuchsia-400 transition-all uppercase tracking-wider select-none cursor-pointer flex items-center justify-center" onclick="window.handleSort('type')">
            <svg id="crypto-btn-icon" xmlns="http://www.w3.org/2000/svg" class="h-2.5 w-2.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 2.5z"/></svg>
            <span id="crypto-btn-text" class="hidden">{t("undervalued.cryptos" as UiKey)}</span>
          </button>
        </div>
        <div class="text-[13px] font-sans text-white/50 font-medium capitalize cursor-pointer hover:text-white transition-colors group select-none flex items-center justify-end gap-2" onclick="window.handleSort('price')">
          <span class="sort-icon opacity-0 group-hover:opacity-50 transition-opacity" data-col="price">↕</span>
          {t("undervalued.table.price")}
        </div>
        <div class="text-[13px] font-sans text-white/50 font-medium capitalize cursor-pointer hover:text-white transition-colors group select-none flex items-center justify-end gap-2" onclick="window.handleSort('marketcap')">
          <span class="sort-icon opacity-0 group-hover:opacity-50 transition-opacity" data-col="marketcap">↕</span>
          {t("undervalued.table.marketcap")}
        </div>
        <div class="text-[13px] font-sans text-white/50 font-medium capitalize cursor-pointer hover:text-white transition-colors group select-none flex items-center justify-end gap-2" onclick="window.handleSort('fcf')">
          <span class="sort-icon opacity-0 group-hover:opacity-50 transition-opacity" data-col="fcf">↕</span>
          {t("undervalued.table.fcf")}
        </div>
        <div class="text-[13px] font-sans text-white/50 font-medium capitalize cursor-pointer hover:text-white transition-colors group select-none flex items-center justify-end gap-2" onclick="window.handleSort('supply')">
          <span class="sort-icon opacity-0 group-hover:opacity-50 transition-opacity" data-col="supply">↕</span>
          {t("undervalued.table.supply")}
        </div>
        <div class="text-[13px] font-sans text-white/50 font-medium capitalize cursor-pointer hover:text-white transition-colors group select-none flex items-center justify-center gap-2" onclick="window.handleSort('discount')">
          {t("undervalued.table.discount")}
          <span class="sort-icon opacity-0 group-hover:opacity-50 transition-opacity" data-col="discount">↕</span>
        </div>
        <div class="text-[13px] font-sans text-white/50 font-medium capitalize cursor-pointer hover:text-white transition-colors group select-none flex items-center justify-center gap-2" onclick="window.handleSort('growth')">
          {t("undervalued.table.growth")}
          <span class="sort-icon opacity-0 group-hover:opacity-50 transition-opacity" data-col="growth">↕</span>
        </div>
        <div class="text-[13px] font-sans text-white/50 font-medium capitalize cursor-pointer hover:text-white transition-colors group select-none flex items-center justify-end gap-2" onclick="window.handleSort('intrinsic')">
          <span class="sort-icon opacity-0 group-hover:opacity-50 transition-opacity" data-col="intrinsic">↕</span>
          {t("undervalued.table.intrinsic")}
        </div>
        <div class="pr-6 text-[13px] font-sans text-white/50 font-medium capitalize cursor-pointer hover:text-white transition-colors group select-none flex items-center justify-end gap-2" onclick="window.handleSort('margin')">
          <span class="sort-icon opacity-0 group-hover:opacity-50 transition-opacity text-emerald-400 opacity-100" data-col="margin">↓</span>
          {t("undervalued.table.margin")}
        </div>
      </div>

      <!-- Body -->
      <div id="table-body" class="flex flex-col relative z-10">
        {processedStocks.map((stock) => {
          const isUndervalued = stock.marginOfSafety > 0
          return (
            <div class="stock-row border-b border-white/5 hover:bg-white/[0.02] transition-colors group" data-type={stock.type} data-ticker={stock.ticker} data-name={stock.name} data-fcf={stock.fcf} data-shares={stock.shares} data-price={stock.price} data-marketcap={stock.marketCap} data-intrinsic={stock.intrinsicValue} data-margin={stock.marginOfSafety}>
              
              {/* DESKTOP ROW */}
              <div class="hidden lg:grid grid-cols-[22%_8%_10%_10%_9%_8%_8%_11%_14%] items-center py-3 px-6 cursor-default">
                {/* Logo y Nombre */}
                <div class="flex items-center gap-3">
                    <div class={`relative w-8 h-8 rounded bg-terminal-dark border flex items-center justify-center p-1 shrink-0 ${stock.type === 'crypto' ? 'border-fuchsia-500/50 shadow-[0_0_8px_rgba(217,70,239,0.3)]' : 'border-terminal-muted/20'}`}>
                      <img src={`https://logo.clearbit.com/${stock.website}`} alt={stock.ticker} class="w-[90%] h-[90%] object-contain rounded-full" loading="lazy" onerror={`if (this.src.includes('clearbit')) { this.src='https://www.google.com/s2/favicons?domain=${stock.website}&sz=128'; } else { this.style.display='none'; this.nextElementSibling.style.display='flex'; }`} />
                      <div class="hidden w-full h-full rounded-full bg-emerald-500/15 text-emerald-400 items-center justify-center text-[10px] font-bold absolute top-0 left-0">{stock.ticker.substring(0,2)}</div>
                    </div>
                    <div class="flex flex-col min-w-0">
                      <span class="text-[13px] font-bold text-white group-hover:text-emerald-400 transition-colors truncate">{stock.ticker}</span>
                      <span class="text-[10px] text-white/50 truncate max-w-[140px]">{stock.name}</span>
                    </div>
                </div>
                {/* Resto de Columnas */}
                <div class="text-[13px] font-mono text-white/90 text-right">${stock.price.toFixed(2)}</div>
                <div class="text-[13px] font-mono text-white/70 text-right">{formatBigNumber(stock.marketCap || 0)}</div>
                {stock.type === 'crypto' ? (
                  <div class="flex justify-end">
                    <div class="relative w-20">
                      <input type="number" class="row-fcf w-full bg-black/40 border border-white/10 text-white text-[11px] rounded px-1.5 py-1 pr-4 text-right font-mono focus:border-emerald-500 focus:outline-none" value={stock.fcf / 1000000} />
                      <span class="absolute right-1.5 top-1/2 -translate-y-1/2 text-[9px] text-white/30 pointer-events-none">M</span>
                    </div>
                  </div>
                ) : (
                  <div class={`text-[13px] font-mono text-right ${stock.fcf > 0 ? 'text-emerald-400/90' : 'text-rose-400/90'}`}>{formatBigNumber(stock.fcf || 0)}</div>
                )}
                <div class="text-[13px] font-mono text-white/50 text-right">{formatBigNumber(stock.shares).replace('$', '')}</div>
                <div class="flex justify-center">
                  <div class="relative w-14">
                    <input type="number" class="row-discount w-full bg-black/40 border border-white/10 text-white text-[11px] rounded px-1.5 py-1 pr-4 text-right font-mono focus:border-emerald-500 focus:outline-none" value="10" />
                    <span class="absolute right-1.5 top-1/2 -translate-y-1/2 text-[9px] text-white/30 pointer-events-none">%</span>
                  </div>
                </div>
                <div class="flex justify-center">
                  <div class="relative w-14">
                    <input type="number" class="row-growth w-full bg-black/40 border border-white/10 text-white text-[11px] rounded px-1.5 py-1 pr-4 text-right font-mono focus:border-emerald-500 focus:outline-none" value="10" />
                    <span class="absolute right-1.5 top-1/2 -translate-y-1/2 text-[9px] text-white/30 pointer-events-none">%</span>
                  </div>
                </div>
                <div class={`desktop-intrinsic text-[13px] font-mono font-bold text-right ${isUndervalued ? 'text-emerald-400' : 'text-rose-400'}`}>${stock.intrinsicValue.toFixed(2)}</div>
                <div class="flex justify-end pr-6">
                  <span class={`desktop-margin inline-flex items-center justify-center gap-1 text-[11px] font-bold px-2 py-1 rounded w-[60px] text-center ${isUndervalued ? 'text-emerald-400 bg-emerald-500/10 border border-emerald-500/20' : 'text-rose-400 bg-rose-500/10 border border-rose-500/20'}`}>
                    {isUndervalued ? '▲' : '▼'}{stock.marginOfSafety.toFixed(0)}%
                  </span>
                </div>
              </div>

              {/* MOBILE CARD */}
              <div class="lg:hidden flex flex-col p-4 gap-4 cursor-default">
                <div class="flex items-center justify-between">
                  <div class="flex items-center gap-3">
                    <div class={`relative w-10 h-10 rounded-lg bg-terminal-dark border flex items-center justify-center p-1 shrink-0 ${stock.type === 'crypto' ? 'border-fuchsia-500/50 shadow-[0_0_8px_rgba(217,70,239,0.3)]' : 'border-terminal-muted/20'}`}>
                      <img src={`https://logo.clearbit.com/${stock.website}`} alt={stock.ticker} class="w-[90%] h-[90%] object-contain rounded-full" loading="lazy" onerror={`if (this.src.includes('clearbit')) { this.src='https://www.google.com/s2/favicons?domain=${stock.website}&sz=128'; } else { this.style.display='none'; this.nextElementSibling.style.display='flex'; }`} />
                      <div class="hidden w-full h-full rounded-full bg-emerald-500/15 text-emerald-400 items-center justify-center text-[11px] font-bold absolute top-0 left-0">{stock.ticker.substring(0,2)}</div>
                    </div>
                    <div class="flex flex-col">
                      <span class="text-base font-bold text-white">{stock.ticker}</span>
                      <span class="text-[10px] text-white/50">{stock.name}</span>
                    </div>
                  </div>
                  <span class={`mobile-margin inline-flex items-center gap-1 text-[11px] font-mono font-bold px-2 py-1 rounded-full ${isUndervalued ? 'text-emerald-400 bg-emerald-500/10 border border-emerald-500/20' : 'text-rose-400 bg-rose-500/10 border border-rose-500/20'}`}>
                    {isUndervalued ? '▲' : '▼'} {stock.marginOfSafety.toFixed(1)}%
                  </span>
                </div>
                
                <div class="grid grid-cols-2 gap-2">
                  <div class="flex flex-col bg-black/20 p-2.5 rounded-lg border border-white/[0.02]">
                    <span class="text-[9px] font-mono text-terminal-muted mb-0.5">{t("undervalued.table.price")}</span>
                    <span class="text-sm font-mono text-white">${stock.price.toFixed(2)}</span>
                  </div>
                  <div class="flex flex-col bg-black/20 p-2.5 rounded-lg border border-white/[0.02]">
                    <span class="text-[9px] font-mono text-terminal-muted mb-0.5">{t("undervalued.table.marketcap")}</span>
                    <span class="text-sm font-mono text-white/80">{formatBigNumber(stock.marketCap || 0)}</span>
                  </div>
                  <div class="flex flex-col bg-black/20 p-2.5 rounded-lg border border-white/[0.02]">
                    <span class="text-[9px] font-mono text-terminal-muted mb-0.5">{t("undervalued.table.intrinsic")}</span>
                    <span class={`mobile-intrinsic text-sm font-mono font-bold ${isUndervalued ? 'text-emerald-400' : 'text-rose-400'}`}>${stock.intrinsicValue.toFixed(2)}</span>
                  </div>
                  <div class="flex flex-col bg-black/20 p-2.5 rounded-lg border border-white/[0.02]">
                    <span class="text-[9px] font-mono text-terminal-muted mb-0.5">{t("undervalued.table.fcf")}</span>
                    <span class={`text-sm font-mono ${stock.fcf > 0 ? 'text-emerald-400' : 'text-rose-400'}`}>{formatBigNumber(stock.fcf)}</span>
                  </div>
                  <div class="flex flex-col bg-black/20 p-2.5 rounded-lg border border-white/[0.02]">
                    <span class="text-[9px] font-mono text-terminal-muted mb-0.5">{t("undervalued.table.supply")}</span>
                    <span class="text-sm font-mono text-white/70">{formatBigNumber(stock.shares).replace('$', '')}</span>
                  </div>
                </div>
                <div class="grid grid-cols-2 gap-2">
                  <div class="flex items-center justify-between bg-black/20 p-2.5 rounded-lg border border-white/[0.02]">
                    <span class="text-[9px] font-mono text-terminal-muted">{t("undervalued.table.discount")}</span>
                    <div class="relative w-14">
                      <input type="number" class="mobile-row-discount w-full bg-black/40 border border-white/10 text-white text-[10px] rounded px-1.5 py-1 pr-4 text-right font-mono focus:border-emerald-500 focus:outline-none" value="10" />
                      <span class="absolute right-1.5 top-1/2 -translate-y-1/2 text-[8px] text-white/30 pointer-events-none">%</span>
                    </div>
                  </div>
                  <div class="flex items-center justify-between bg-black/20 p-2.5 rounded-lg border border-white/[0.02]">
                    <span class="text-[9px] font-mono text-terminal-muted">{t("undervalued.table.growth")}</span>
                    <div class="relative w-14">
                      <input type="number" class="mobile-row-growth w-full bg-black/40 border border-white/10 text-white text-[10px] rounded px-1.5 py-1 pr-4 text-right font-mono focus:border-emerald-500 focus:outline-none" value="10" />
                      <span class="absolute right-1.5 top-1/2 -translate-y-1/2 text-[8px] text-white/30 pointer-events-none">%</span>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          )
        })}
      </div>
    </div>
  ) : (
    <div class="text-center py-20 relative z-10">
      <p class="text-terminal-muted font-mono text-sm">{t("undervalued.nodata")}</p>
    </div>
  )}

  <!-- Disclaimer -->
  <p class="text-[9px] font-mono text-terminal-muted mt-6 max-w-3xl leading-relaxed opacity-60">
    {t("undervalued.disclaimer")}
  </p>
</main>

<script>
  // Filtro y reactividad del lado del cliente
  const searchInput = document.getElementById('stock-search') as HTMLInputElement | null
  const globalDiscountInput = document.getElementById('discount-input') as HTMLInputElement | null
  const globalGrowthInput = document.getElementById('growth-input') as HTMLInputElement | null
  const conservativeModeToggle = document.getElementById('conservative-mode') as HTMLInputElement | null
  const rows = document.querySelectorAll('.stock-row')

  const PERPETUAL_GROWTH = 0.025
  const YEARS = 10

  function recalculateRow(row: HTMLElement, discountVal: number, growthVal: number) {
      const fcfInput = row.querySelector('.row-fcf') as HTMLInputElement
      const fcf = fcfInput ? parseFloat(fcfInput.value || '0') * 1000000 : parseFloat(row.dataset.fcf || '0')
      
      // Update dataset for sorting if modified
      if (fcfInput) row.dataset.fcf = fcf.toString()
      
      const shares = parseFloat(row.dataset.shares || '1')
      const price = parseFloat(row.dataset.price || '0')

      if (!shares || !fcf || !price) return

      const fcfPerShare = fcf / shares

      let intrinsicValue = 0
      for (let i = 1; i <= YEARS; i++) {
        intrinsicValue += (fcfPerShare * Math.pow(1 + growthVal, i)) / Math.pow(1 + discountVal, i)
      }

      if (conservativeModeToggle && conservativeModeToggle.checked) {
        if (discountVal > PERPETUAL_GROWTH) {
          // Gordon Growth Model
          const terminalValue = (fcfPerShare * Math.pow(1 + growthVal, YEARS) * (1 + PERPETUAL_GROWTH)) / (discountVal - PERPETUAL_GROWTH)
          intrinsicValue += terminalValue / Math.pow(1 + discountVal, YEARS)
        }
      } else {
        // Exit Multiple Method (15x)
        const terminalValue = (fcfPerShare * Math.pow(1 + growthVal, YEARS)) * 15
        intrinsicValue += terminalValue / Math.pow(1 + discountVal, YEARS)
      }

      const marginOfSafety = ((intrinsicValue - price) / intrinsicValue) * 100
      const isUndervalued = marginOfSafety > 0

      // Update dataset for sorting
      row.dataset.intrinsic = intrinsicValue.toString()
      row.dataset.margin = marginOfSafety.toString()

      // Update UI
      const desktopIntrinsic = row.querySelector('.desktop-intrinsic')
      const desktopMargin = row.querySelector('.desktop-margin')
      if (desktopIntrinsic) {
        desktopIntrinsic.textContent = `$${intrinsicValue.toFixed(2)}`
        desktopIntrinsic.className = `desktop-intrinsic text-[13px] font-mono font-bold text-right ${isUndervalued ? 'text-emerald-400' : 'text-rose-400'}`
      }
      if (desktopMargin) {
        desktopMargin.innerHTML = `${isUndervalued ? '▲' : '▼'}${marginOfSafety.toFixed(0)}%`
        desktopMargin.className = `desktop-margin inline-flex items-center justify-center gap-1 text-[11px] font-bold px-2 py-1 rounded w-[60px] text-center ${isUndervalued ? 'text-emerald-400 bg-emerald-500/10 border border-emerald-500/20' : 'text-rose-400 bg-rose-500/10 border border-rose-500/20'}`
      }

      const mobileIntrinsic = row.querySelector('.mobile-intrinsic')
      const mobileMargin = row.querySelector('.mobile-margin')
      if (mobileIntrinsic) {
        mobileIntrinsic.textContent = `$${intrinsicValue.toFixed(2)}`
        mobileIntrinsic.className = `mobile-intrinsic text-sm font-mono font-bold ${isUndervalued ? 'text-emerald-400' : 'text-rose-400'}`
      }
      if (mobileMargin) {
        mobileMargin.innerHTML = `${isUndervalued ? '▲' : '▼'} ${marginOfSafety.toFixed(1)}%`
        mobileMargin.className = `mobile-margin inline-flex items-center gap-1 text-[11px] font-mono font-bold px-2 py-1 rounded-full ${isUndervalued ? 'text-emerald-400 bg-emerald-500/10 border border-emerald-500/20' : 'text-rose-400 bg-rose-500/10 border border-rose-500/20'}`
      }
  }

  function updateGlobal() {
    const dVal = parseFloat(globalDiscountInput?.value) || 10
    const gVal = parseFloat(globalGrowthInput?.value) || 10

    rows.forEach((row) => {
      // Sync row inputs with global
      row.querySelectorAll<HTMLInputElement>('.row-discount, .mobile-row-discount').forEach(i => i.value = dVal.toString())
      row.querySelectorAll<HTMLInputElement>('.row-growth, .mobile-row-growth').forEach(i => i.value = gVal.toString())
      
      recalculateRow(row as HTMLElement, dVal / 100, gVal / 100)
    })
  }

  // Bind global inputs
  if (globalDiscountInput && globalGrowthInput) {
    globalDiscountInput.addEventListener('input', updateGlobal)
    globalGrowthInput.addEventListener('input', updateGlobal)
  }

  // Bind conservative mode toggle
  if (conservativeModeToggle) {
    conservativeModeToggle.addEventListener('change', updateGlobal)
  }

  // Bind per-row inputs
  rows.forEach(row => {
      const inputs = row.querySelectorAll<HTMLInputElement>('.row-discount, .mobile-row-discount, .row-growth, .mobile-row-growth, .row-fcf')
      inputs.forEach(input => {
          input.addEventListener('input', () => {
              // Get current row values
              let rowD = 10, rowG = 10
              if (input.classList.contains('row-discount') || input.classList.contains('mobile-row-discount')) {
                  rowD = parseFloat(input.value) || 10
                  // Sync desktop/mobile counterpart
                  row.querySelectorAll<HTMLInputElement>('.row-discount, .mobile-row-discount').forEach(i => i.value = rowD.toString())
                  rowG = parseFloat(row.querySelector<HTMLInputElement>('.row-growth')?.value || '10')
              } else if (input.classList.contains('row-growth') || input.classList.contains('mobile-row-growth')) {
                  rowG = parseFloat(input.value) || 10
                  // Sync desktop/mobile counterpart
                  row.querySelectorAll<HTMLInputElement>('.row-growth, .mobile-row-growth').forEach(i => i.value = rowG.toString())
                  rowD = parseFloat(row.querySelector<HTMLInputElement>('.row-discount')?.value || '10')
              } else {
                  // It's the FCF input, just grab D and G
                  rowD = parseFloat(row.querySelector<HTMLInputElement>('.row-discount')?.value || '10')
                  rowG = parseFloat(row.querySelector<HTMLInputElement>('.row-growth')?.value || '10')
              }
              recalculateRow(row as HTMLElement, rowD / 100, rowG / 100)
          })
      })
  })

  function filterStocks(query: string) {
    const q = query.toLowerCase().trim()
    rows.forEach((row) => {
      const ticker = (row as HTMLElement).dataset.ticker?.toLowerCase() || ''
      const name = (row as HTMLElement).dataset.name?.toLowerCase() || ''
      const match = ticker.includes(q) || name.includes(q)
      ;(row as HTMLElement).style.display = match ? '' : 'none'
    })
  }

  if (searchInput) {
    searchInput.addEventListener("input", (e) => {
      const v = (e.target as HTMLInputElement).value
      const searchClearBtn = document.getElementById('search-clear-btn')
      if (searchClearBtn) {
        if (v) searchClearBtn.classList.remove('hidden')
        else searchClearBtn.classList.add('hidden')
      }
      filterStocks(v)
    })
  }

  let currentSort = { column: 'margin', direction: 'desc' };
  (window as any).handleSort = (column: string) => {
    if (column === 'type') {
      if (currentSort.column === 'type') {
        currentSort.column = 'margin'
        currentSort.direction = 'desc'
      } else {
        currentSort.column = 'type'
        currentSort.direction = 'desc'
      }
    } else {
      if (currentSort.column === column) {
        currentSort.direction = currentSort.direction === 'desc' ? 'asc' : 'desc'
      } else {
        currentSort.column = column
        currentSort.direction = 'desc'
      }
    }

    // Update icons
    document.querySelectorAll(".sort-icon").forEach((icon) => {
      icon.innerHTML = "↕"
      icon.classList.remove("text-emerald-400", "opacity-100")
      if ((icon as HTMLElement).dataset.col === currentSort.column) {
        icon.innerHTML = currentSort.direction === 'desc' ? "↓" : "↑"
        icon.classList.add("text-emerald-400", "opacity-100")
      }
    })

    // Update Criptos button glow
    const btnCrypto = document.getElementById('btn-sort-crypto')
    const textCrypto = document.getElementById('crypto-btn-text')
    const iconCrypto = document.getElementById('crypto-btn-icon')
    
    if (btnCrypto && textCrypto && iconCrypto) {
      if (currentSort.column === 'type') {
        btnCrypto.className = "text-[6px] font-mono font-medium px-1 py-0.5 rounded bg-fuchsia-500/20 text-fuchsia-300 border border-fuchsia-500/50 hover:bg-fuchsia-500/30 transition-all uppercase tracking-wider select-none cursor-pointer shadow-[0_0_8px_rgba(217,70,239,0.5)] flex items-center justify-center"
        textCrypto.classList.remove('hidden')
        iconCrypto.classList.add('hidden')
      } else {
        btnCrypto.className = "text-[6px] font-mono font-medium px-1 py-0.5 rounded bg-fuchsia-500/10 text-fuchsia-400/70 border border-fuchsia-500/20 hover:bg-fuchsia-500/20 hover:text-fuchsia-400 transition-all uppercase tracking-wider select-none cursor-pointer flex items-center justify-center"
        textCrypto.classList.add('hidden')
        iconCrypto.classList.remove('hidden')
      }
    }

    const tbody = document.getElementById('table-body')
    if (!tbody) return

    const rowsArray = Array.from(document.querySelectorAll('.stock-row'))
    rowsArray.sort((a, b) => {
      let valA: any, valB: any
      const elA = a as HTMLElement
      const elB = b as HTMLElement

      if (currentSort.column === 'name') {
        valA = elA.dataset.name?.toLowerCase() || ''
        valB = elB.dataset.name?.toLowerCase() || ''
      } else if (currentSort.column === 'type') {
        valA = elA.dataset.type === 'crypto' ? 1 : 0
        valB = elB.dataset.type === 'crypto' ? 1 : 0
      } else if (['price', 'marketcap', 'fcf', 'supply', 'intrinsic', 'margin'].includes(currentSort.column)) {
        valA = parseFloat(elA.dataset[currentSort.column] || '0')
        valB = parseFloat(elB.dataset[currentSort.column] || '0')
      } else if (currentSort.column === 'discount' || currentSort.column === 'growth') {
        valA = parseFloat(elA.querySelector<HTMLInputElement>(`.row-${currentSort.column}`)?.value || '10')
        valB = parseFloat(elB.querySelector<HTMLInputElement>(`.row-${currentSort.column}`)?.value || '10')
      }

      if (valA < valB) return currentSort.direction === 'desc' ? 1 : -1
      if (valA > valB) return currentSort.direction === 'desc' ? -1 : 1
      return 0
    })

    rowsArray.forEach(row => tbody.appendChild(row))
  }

  // Initial render calculations
  updateGlobal()
  
  // Clear Buttons Logic
  const resetAllBtn = document.getElementById('reset-all-btn')
  const searchClearBtn = document.getElementById('search-clear-btn')

  if (searchClearBtn) {
    searchClearBtn.addEventListener('click', () => {
      if (searchInput) searchInput.value = ''
      searchClearBtn.classList.add('hidden')
      filterStocks('')
    })
  }

  if (resetAllBtn) {
    resetAllBtn.addEventListener('click', () => {
      // 1. Clear search
      if (searchInput) searchInput.value = ''
      if (searchClearBtn) searchClearBtn.classList.add('hidden')
      filterStocks('')
      
      // 2. Reset global discount and growth to 10
      const discountInput = document.getElementById("discount-input") as HTMLInputElement
      const growthInput = document.getElementById("growth-input") as HTMLInputElement
      if (discountInput) discountInput.value = '10'
      if (growthInput) growthInput.value = '10'

      // 3. Reset row-specific inputs and calculations
      document.querySelectorAll('.stock-row').forEach(row => {
        const dInput = row.querySelector('.row-discount') as HTMLInputElement
        const gInput = row.querySelector('.row-growth') as HTMLInputElement
        const fcfInput = row.querySelector('.row-fcf') as HTMLInputElement
        if (dInput) dInput.value = '10'
        if (gInput) gInput.value = '10'
        if (fcfInput) {
          const originalFcf = (row as HTMLElement).dataset.fcf_original
          if (originalFcf) {
            fcfInput.value = originalFcf
            ;(row as HTMLElement).dataset.fcf = originalFcf
          }
        }
      })
      
      // Restore conservative mode
      const conservativeToggle = document.getElementById('conservative-mode') as HTMLInputElement
      if (conservativeToggle) conservativeToggle.checked = true
      
      updateGlobal()

      // 4. Reset sorting to default (margin desc)
      currentSort.column = 'margin'
      currentSort.direction = 'desc'
      
      // Update icons visually
      document.querySelectorAll(".sort-icon").forEach((icon) => {
        icon.innerHTML = "↕"
        icon.classList.remove("text-emerald-400", "opacity-100")
        if ((icon as HTMLElement).dataset.col === 'margin') {
          icon.innerHTML = "↓"
          icon.classList.add("text-emerald-400", "opacity-100")
        }
      })
      
      // Turn off Cripto glow
      const btnCrypto = document.getElementById('btn-sort-crypto')
      const textCrypto = document.getElementById('crypto-btn-text')
      const iconCrypto = document.getElementById('crypto-btn-icon')
      if (btnCrypto && textCrypto && iconCrypto) {
        btnCrypto.className = "text-[6px] font-mono font-medium px-1 py-0.5 rounded bg-fuchsia-500/10 text-fuchsia-400/70 border border-fuchsia-500/20 hover:bg-fuchsia-500/20 hover:text-fuchsia-400 transition-all uppercase tracking-wider select-none cursor-pointer flex items-center justify-center"
        textCrypto.classList.add('hidden')
        iconCrypto.classList.remove('hidden')
      }

      // Re-sort DOM
      const tbody = document.getElementById('table-body')
      if (tbody) {
        const rowsArray = Array.from(document.querySelectorAll('.stock-row'))
        rowsArray.sort((a, b) => {
          const elA = a as HTMLElement
          const elB = b as HTMLElement
          const valA = parseFloat(elA.dataset['margin'] || '0')
          const valB = parseFloat(elB.dataset['margin'] || '0')
          return valA < valB ? 1 : -1
        })
        rowsArray.forEach(row => tbody.appendChild(row))
      }
    })
  }
</script>
