<script>
  // Filtro y reactividad del lado del cliente
  const searchInput = document.getElementById('stock-search') as HTMLInputElement
  const globalDiscountInput = document.getElementById('discount-input') as HTMLInputElement
  const globalGrowthInput = document.getElementById('growth-input') as HTMLInputElement
  const rows = document.querySelectorAll('.stock-row')

  const PERPETUAL_GROWTH = 0.025
  const YEARS = 10

  function recalculateRow(row: HTMLElement, discountVal: number, growthVal: number) {
      const fcf = parseFloat(row.dataset.fcf || '0')
      const shares = parseFloat(row.dataset.shares || '1')
      const price = parseFloat(row.dataset.price || '0')

      if (!shares || !fcf || !price) return

      const fcfPerShare = fcf / shares

      let intrinsicValue = 0
      for (let i = 1; i <= YEARS; i++) {
        intrinsicValue += (fcfPerShare * Math.pow(1 + growthVal, i)) / Math.pow(1 + discountVal, i)
      }

      if (discountVal > PERPETUAL_GROWTH) {
        const terminalValue = (fcfPerShare * Math.pow(1 + growthVal, YEARS) * (1 + PERPETUAL_GROWTH)) / (discountVal - PERPETUAL_GROWTH)
        intrinsicValue += terminalValue / Math.pow(1 + discountVal, YEARS)
      }

      const marginOfSafety = ((intrinsicValue - price) / intrinsicValue) * 100
      const isUndervalued = marginOfSafety > 0

      // Update dataset for sorting
      row.dataset.intrinsic = intrinsicValue.toString()
      row.dataset.margin = marginOfSafety.toString()

      // Update UI
      const desktopIntrinsic = row.querySelector('.desktop-intrinsic')
      const desktopMargin = row.querySelector('.desktop-margin')
      if (desktopIntrinsic) {
        desktopIntrinsic.textContent = `$${intrinsicValue.toFixed(2)}`
        desktopIntrinsic.className = `desktop-intrinsic text-[13px] font-mono font-bold text-right ${isUndervalued ? 'text-emerald-400' : 'text-rose-400'}`
      }
      if (desktopMargin) {
        desktopMargin.innerHTML = `${isUndervalued ? '▲' : '▼'}${marginOfSafety.toFixed(0)}%`
        desktopMargin.className = `desktop-margin inline-flex items-center justify-center gap-1 text-[11px] font-bold px-2 py-1 rounded w-[60px] text-center ${isUndervalued ? 'text-emerald-400 bg-emerald-500/10 border border-emerald-500/20' : 'text-rose-400 bg-rose-500/10 border border-rose-500/20'}`
      }

      const mobileIntrinsic = row.querySelector('.mobile-intrinsic')
      const mobileMargin = row.querySelector('.mobile-margin')
      if (mobileIntrinsic) {
        mobileIntrinsic.textContent = `$${intrinsicValue.toFixed(2)}`
        mobileIntrinsic.className = `mobile-intrinsic text-sm font-mono font-bold ${isUndervalued ? 'text-emerald-400' : 'text-rose-400'}`
      }
      if (mobileMargin) {
        mobileMargin.innerHTML = `${isUndervalued ? '▲' : '▼'} ${marginOfSafety.toFixed(1)}%`
        mobileMargin.className = `mobile-margin inline-flex items-center gap-1 text-[11px] font-mono font-bold px-2 py-1 rounded-full ${isUndervalued ? 'text-emerald-400 bg-emerald-500/10 border border-emerald-500/20' : 'text-rose-400 bg-rose-500/10 border border-rose-500/20'}`
      }
  }

  function updateGlobal() {
    const dVal = parseFloat(globalDiscountInput?.value) || 10
    const gVal = parseFloat(globalGrowthInput?.value) || 10

    rows.forEach((row) => {
      // Sync row inputs with global
      row.querySelectorAll<HTMLInputElement>('.row-discount, .mobile-row-discount').forEach(i => i.value = dVal.toString())
      row.querySelectorAll<HTMLInputElement>('.row-growth, .mobile-row-growth').forEach(i => i.value = gVal.toString())
      
      recalculateRow(row as HTMLElement, dVal / 100, gVal / 100)
    })
  }

  // Bind global inputs
  if (globalDiscountInput && globalGrowthInput) {
    globalDiscountInput.addEventListener('input', updateGlobal)
    globalGrowthInput.addEventListener('input', updateGlobal)
  }

  // Bind per-row inputs
  rows.forEach(row => {
      const inputs = row.querySelectorAll<HTMLInputElement>('.row-discount, .mobile-row-discount, .row-growth, .mobile-row-growth')
      inputs.forEach(input => {
          input.addEventListener('input', () => {
              // Get current row values
              let rowD = 10, rowG = 10
              if (input.classList.contains('row-discount') || input.classList.contains('mobile-row-discount')) {
                  rowD = parseFloat(input.value) || 10
                  // Sync desktop/mobile counterpart
                  row.querySelectorAll<HTMLInputElement>('.row-discount, .mobile-row-discount').forEach(i => i.value = rowD.toString())
                  rowG = parseFloat(row.querySelector<HTMLInputElement>('.row-growth')?.value || '10')
              } else {
                  rowG = parseFloat(input.value) || 10
                  // Sync desktop/mobile counterpart
                  row.querySelectorAll<HTMLInputElement>('.row-growth, .mobile-row-growth').forEach(i => i.value = rowG.toString())
                  rowD = parseFloat(row.querySelector<HTMLInputElement>('.row-discount')?.value || '10')
              }
              recalculateRow(row as HTMLElement, rowD / 100, rowG / 100)
          })
      })
  })

  if (searchInput && rows.length > 0) {
    searchInput.addEventListener('input', () => {
      const query = searchInput.value.toLowerCase().trim()
      rows.forEach((row) => {
        const ticker = (row as HTMLElement).dataset.ticker?.toLowerCase() || ''
        const name = (row as HTMLElement).dataset.name?.toLowerCase() || ''
        const match = ticker.includes(query) || name.includes(query)
        ;(row as HTMLElement).style.display = match ? '' : 'none'
      })
    })
  }

  // Sorting Logic
  let currentSort = { column: 'margin', direction: 'desc' };
  (window as any).handleSort = (column: string) => {
    if (currentSort.column === column) {
      currentSort.direction = currentSort.direction === 'desc' ? 'asc' : 'desc'
    } else {
      currentSort.column = column
      currentSort.direction = 'desc'
    }

    // Update icons
    document.querySelectorAll(".sort-icon").forEach((icon) => {
      icon.innerHTML = "↕"
      icon.classList.remove("text-emerald-400", "opacity-100")
      if ((icon as HTMLElement).dataset.col === column) {
        icon.innerHTML = currentSort.direction === 'desc' ? "↓" : "↑"
        icon.classList.add("text-emerald-400", "opacity-100")
      }
    })

    const tbody = document.getElementById('table-body')
    if (!tbody) return

    const rowsArray = Array.from(document.querySelectorAll('.stock-row'))
    rowsArray.sort((a, b) => {
      let valA: any, valB: any
      const elA = a as HTMLElement
      const elB = b as HTMLElement

      if (column === 'name') {
        valA = elA.dataset.name?.toLowerCase() || ''
        valB = elB.dataset.name?.toLowerCase() || ''
      } else if (['price', 'marketcap', 'fcf', 'supply', 'intrinsic', 'margin'].includes(column)) {
        valA = parseFloat(elA.dataset[column] || '0')
        valB = parseFloat(elB.dataset[column] || '0')
      } else if (column === 'discount' || column === 'growth') {
        valA = parseFloat(elA.querySelector<HTMLInputElement>(`.row-${column}`)?.value || '10')
        valB = parseFloat(elB.querySelector<HTMLInputElement>(`.row-${column}`)?.value || '10')
      }

      if (valA < valB) return currentSort.direction === 'desc' ? 1 : -1
      if (valA > valB) return currentSort.direction === 'desc' ? -1 : 1
      return 0
    })

    rowsArray.forEach(row => tbody.appendChild(row))
  }
</script>

