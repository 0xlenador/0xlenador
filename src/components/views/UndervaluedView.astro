// ==========================================
// src/components/views/UndervaluedView.astro
// Tabla de acciones infravaloradas con DCF
// ==========================================

import FaqAccordion from "../FaqAccordion.astro"
import { getLangFromUrl, useTranslations } from "../../i18n/utils"
import stocksData from "../../content/data/stocks_data.json"

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)

// Configurar tasas por defecto
const DISCOUNT_RATE = 0.10
const GROWTH_RATE = 0.10
const PERPETUAL_GROWTH = 0.025
const YEARS = 10

// Tipo para los stocks procesados
interface StockRow {
  ticker: string
  name: string
  price: number
  fcf: number
  shares: number
  website: string
  intrinsicValue: number
  marginOfSafety: number
  fcfPerShare: number
  marketCap: number
  type: string
}

// Calcular valor intrínseco DCF para cada acción
const stockEntries = Object.entries(stocksData) as [string, { name: string; price: number; fcf: number; shares: number; website: string; marketCap: number; type: string }][]

const processedStocks: StockRow[] = stockEntries
  .filter(([, data]) => data.price && data.shares && data.fcf && data.fcf > 0)
  .map(([ticker, data]) => {
    const fcfPerShare = data.fcf / data.shares

    let intrinsicValue = 0
    for (let i = 1; i <= YEARS; i++) {
      intrinsicValue += (fcfPerShare * Math.pow(1 + GROWTH_RATE, i)) / Math.pow(1 + DISCOUNT_RATE, i)
    }

    if (DISCOUNT_RATE > PERPETUAL_GROWTH) {
      const terminalValue = (fcfPerShare * Math.pow(1 + GROWTH_RATE, YEARS) * (1 + PERPETUAL_GROWTH)) / (DISCOUNT_RATE - PERPETUAL_GROWTH)
      intrinsicValue += terminalValue / Math.pow(1 + DISCOUNT_RATE, YEARS)
    }

    const marginOfSafety = ((intrinsicValue - data.price) / intrinsicValue) * 100

    return {
      ticker,
      name: data.name,
      price: data.price,
      fcf: data.fcf,
      shares: data.shares,
      website: data.website,
      marketCap: data.marketCap,
      type: data.type,
      intrinsicValue,
      marginOfSafety,
      fcfPerShare,
    }
  })
  .sort((a, b) => b.marginOfSafety - a.marginOfSafety) // Mayor margen primero

// Estadísticas
const totalStocks = processedStocks.length
const undervaluedCount = processedStocks.filter((s) => s.marginOfSafety > 0).length
const overvaluedCount = totalStocks - undervaluedCount

// Helper para formatear números grandes
function formatBigNumber(num: number): string {
  if (Math.abs(num) >= 1e12) return `$${(num / 1e12).toFixed(1)}T`
  if (Math.abs(num) >= 1e9) return `$${(num / 1e9).toFixed(1)}B`
  if (Math.abs(num) >= 1e6) return `$${(num / 1e6).toFixed(1)}M`
  return `$${num.toLocaleString()}`
}
---

<main class="max-w-7xl mx-auto px-6 pt-10 pb-20">
  <!-- Breadcrumb -->
  <p class="text-[10px] font-mono text-emerald-500/70 uppercase tracking-[0.4em] mb-6">
    {t("undervalued.breadcrumb")}
  </p>

  <!-- Header -->
  <header class="mb-10 border-b border-terminal-border/50 pb-8">
    <h1 class="text-4xl md:text-5xl font-extrabold text-white tracking-tight mb-3">
      {t("undervalued.heading")}{" "}
      <span class="text-emerald-500">{t("undervalued.subheading")}</span>
    </h1>
    <p class="text-terminal-secondary text-sm leading-relaxed max-w-3xl font-light">
      {t("undervalued.intro")}
    </p>
  </header>

  <!-- Stats Row -->
  <div class="grid grid-cols-3 gap-4 mb-8">
    <div class="hub-card p-4 rounded-xl border border-terminal-border/50 bg-[#0a0a0a]/80">
      <p class="text-[9px] font-mono text-terminal-muted uppercase tracking-wider mb-1">{t("undervalued.stats.total")}</p>
      <p class="text-2xl font-black text-white">{totalStocks}</p>
    </div>
    <div class="hub-card p-4 rounded-xl border border-terminal-border/50 bg-[#0a0a0a]/80">
      <p class="text-[9px] font-mono text-terminal-muted uppercase tracking-wider mb-1">{t("undervalued.stats.undervalued")}</p>
      <p class="text-2xl font-black text-emerald-400">{undervaluedCount}</p>
    </div>
    <div class="hub-card p-4 rounded-xl border border-terminal-border/50 bg-[#0a0a0a]/80">
      <p class="text-[9px] font-mono text-terminal-muted uppercase tracking-wider mb-1">{t("undervalued.stats.overvalued")}</p>
      <p class="text-2xl font-black text-rose-400">{overvaluedCount}</p>
    </div>
  </div>

  <!-- Controls -->
  <div class="mb-6 flex flex-col md:flex-row gap-4 items-end">
    <div class="w-full md:w-80 relative">
      <input
        type="text"
        id="stock-search"
        placeholder={t("undervalued.search")}
        class="w-full bg-terminal-dark/80 border border-terminal-border text-white text-xs rounded-lg px-4 py-2.5 pr-10 focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500/30 focus:outline-none transition-all font-mono placeholder:text-terminal-muted"
      />
      <button id="search-clear-btn" class="absolute right-3 top-1/2 -translate-y-1/2 text-terminal-muted hover:text-white hidden transition-colors" title="Borrar búsqueda">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd" /></svg>
      </button>
    </div>
    <!-- Conservative Mode Toggle -->
    <div class="flex items-center gap-2 mb-1 md:mb-0 ml-auto md:ml-0 md:mr-auto self-center lg:self-end lg:pb-3">
      <span class="text-[10px] font-mono text-terminal-muted uppercase tracking-wider">{t("undervalued.conservative" as UiKey)}</span>
      <label class="relative inline-flex items-center cursor-pointer">
        <input type="checkbox" id="conservative-mode" class="sr-only peer" checked>
        <div class="w-9 h-5 bg-black/60 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-terminal-muted peer-checked:after:bg-emerald-400 after:border-gray-600 after:border after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-emerald-500/10 border border-white/10 peer-checked:border-emerald-500/30"></div>
      </label>
    </div>
    <div class="flex gap-4 w-full md:w-auto">
      <div class="flex flex-col gap-1 w-full md:w-auto">
        <label class="text-[9px] font-mono text-terminal-muted uppercase tracking-wider pl-1">{t("undervalued.table.discount")}</label>
        <div class="relative">
          <input
            type="number"
            id="discount-input"
            value="10"
            min="1"
            max="50"
            class="w-full md:w-28 bg-terminal-dark/80 border border-terminal-border text-white text-xs rounded-lg px-4 py-2.5 focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500/30 focus:outline-none transition-all font-mono text-right"
          />
          <span class="absolute right-3 top-1/2 -translate-y-1/2 text-terminal-muted text-xs font-mono">%</span>
        </div>
      </div>
      <div class="flex flex-col gap-1 w-full md:w-auto">
        <label class="text-[9px] font-mono text-terminal-muted uppercase tracking-wider pl-1">{t("undervalued.table.growth")}</label>
        <div class="relative">
          <input
            type="number"
            id="growth-input"
            value="10"
            min="1"
            max="50"
            class="w-full md:w-28 bg-terminal-dark/80 border border-terminal-border text-white text-xs rounded-lg px-4 py-2.5 focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500/30 focus:outline-none transition-all font-mono text-right"
          />
          <span class="absolute right-3 top-1/2 -translate-y-1/2 text-terminal-muted text-xs font-mono">%</span>
        </div>
      </div>
      <button id="reset-all-btn" class="self-end mb-0.5 w-[38px] h-[38px] shrink-0 flex items-center justify-center bg-terminal-dark/80 border border-terminal-border rounded-lg hover:border-emerald-500 hover:text-emerald-400 text-terminal-muted transition-colors" title="Restablecer tabla">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="m9 11-6 6v3h9l3-3"/><path d="m22 12-4.6 4.6a2 2 0 0 1-2.8 0l-5.2-5.2a2 2 0 0 1 0-2.8L14 4"/><path d="M11 9.5 14.5 13"/>
        </svg>
      </button>
    </div>
  </div>

  <!-- Table -->
  {processedStocks.length > 0 ? (
