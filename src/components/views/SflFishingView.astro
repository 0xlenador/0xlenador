---
import SflToolLayout from "../SflToolLayout.astro"
import { getLangFromUrl, useTranslations } from "../../i18n/utils"
import fishData from "../../content/data/sfl/fishing/fish.json"
import crustaceansData from "../../content/data/sfl/fishing/crustaceans.json"
import marvelsData from "../../content/data/sfl/fishing/marine_marvels.json"

import SflFishingDashboard from "../sfl/fishing/SflFishingDashboard.astro"
import SflFishingFilters from "../sfl/fishing/SflFishingFilters.astro"
import SflFishingCard from "../sfl/fishing/SflFishingCard.astro"
import SflFishingCardCompact from "../sfl/fishing/SflFishingCardCompact.astro"
import SflFishingTable from "../sfl/fishing/SflFishingTable.astro"
import SflBoostsConfig from "../sfl/common/SflBoostsConfig.astro"

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)

// Unificar todos los ítems marinos para el renderizado (sin Fish Market)
const allMarvels = [...marvelsData.permanent, ...marvelsData.chapters]

const allItems = [
  ...fishData.map((f) => ({ ...f, kind: "rod" as const })),
  ...crustaceansData.map((c) => ({ ...c, kind: "trap" as const })),
  ...allMarvels.map((m) => ({ ...m, kind: "marvel" as const })),
]

// Conteos reales para los filtros
const counts = {
  all: allItems.length,
  fish: fishData.length,
  basic: fishData.filter((f) => f.tier === "basic").length,
  advanced: fishData.filter((f) => f.tier === "advanced").length,
  expert: fishData.filter((f) => f.tier === "expert").length,
  trap: crustaceansData.length,
  crabPot: crustaceansData.filter((c: any) => c.trap === "Crab Pot").length,
  marinerPot: crustaceansData.filter((c: any) => c.trap === "Mariner Pot").length,
  marvel: allMarvels.length,
  permanent: marvelsData.permanent.length,
  chapters: marvelsData.chapters.length,
  currentChapter: allMarvels.filter((m: any) => m.chapter === "Cave Dwellers").length,
}
---

<SflToolLayout activeTab="fishing">
  <!-- Encabezado Principal -->
  <div class="mb-6 relative z-10 text-center sm:text-left">
    <h1 class="text-3xl md:text-4xl font-black text-white tracking-tighter mb-2">
      {t("sfl.fishing.heading")}
      <span class="text-cyan-400"> {t("sfl.fishing.heading.accent")}</span>
    </h1>
    <p class="text-terminal-secondary text-sm leading-relaxed max-w-3xl">
      {t("sfl.fishing.intro")}
    </p>
  </div>

  <!-- Dashboard Económico de Pesca -->
  <SflFishingDashboard />

  <!-- Configuración de Boosts & Habilidades de Pesca -->
  <SflBoostsConfig domain="fishing" idPrefix="fishing-boosts" />

  <!-- Panel de Control: Filtros & Búsqueda -->
  <SflFishingFilters counts={counts} />

  <!-- 1. Grilla de Tarjetas Detalladas (Original) -->
  <div id="fishGrid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-3 sm:gap-4 mb-6">
    {
      allItems.map((entry, idx) => (
        <SflFishingCard item={entry} kind={entry.kind} index={idx} />
      ))
    }
  </div>

  <!-- 2. Grilla de Tarjetas Compactas -->
  <div id="fishGridCompact" class="hidden grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 xl:grid-cols-6 gap-2.5 mb-6">
    {
      allItems.map((entry, idx) => (
        <SflFishingCardCompact item={entry} kind={entry.kind} index={idx} />
      ))
    }
  </div>

  <!-- 3. Tabla de Alta Densidad -->
  <SflFishingTable items={allItems} />

  <!-- Estado Vacío -->
  <div id="emptyResults" class="hidden p-12 text-center rounded-2xl border border-white/5 bg-[#18181b]/50 my-8">
    <div class="w-12 h-12 rounded-full bg-white/5 flex items-center justify-center mx-auto mb-3">
      <svg class="w-6 h-6 text-white/30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
      </svg>
    </div>
    <h3 class="text-base font-bold text-white mb-1">
      {t("sfl.fishing.empty.title")}
    </h3>
    <p class="text-xs text-white/50 max-w-sm mx-auto">
      {t("sfl.fishing.empty.desc")}
    </p>
  </div>
</SflToolLayout>

<!-- Motor Centralizado de Mercado y Precios -->
<script>
  import * as SflMarket from "../../lib/sfl/market"
  import * as SflPrices from "../../lib/sfl/prices"
  import * as SflFishing from "../../lib/sfl/fishing"
  import { SflUserState } from "../../lib/sfl/state"
  ;(window as any).SflMarket = SflMarket
  ;(window as any).SflPrices = SflPrices
  ;(window as any).SflFishing = SflFishing
  ;(window as any).SflUserState = SflUserState
  SflMarket.fetchMarketData()
</script>

<script
  define:vars={{
    textBase: t("sfl.fishing.card.breakdownBase"),
    textTrap: t("sfl.fishing.card.breakdownTrap"),
    textChumLabel: t("sfl.fishing.card.chumLabel"),
    textCostNormal: t("sfl.fishing.card.cost"),
    textCostPerFish: t("sfl.fishing.card.costPerFish"),
    textCostMarvel: t("sfl.fishing.card.costMarvel"),
    textCasts: t("sfl.fishing.card.casts"),
  }}
>
  function initFishing() {
    const sectionButtons = document.querySelectorAll(".filter-section-btn")
    const tierButtons = document.querySelectorAll(".filter-tier-btn")
    const trapSubButtons = document.querySelectorAll(".filter-trap-sub-btn")
    const marvelSubButtons = document.querySelectorAll(".filter-marvel-sub-btn")
    const chapterSelectButtons = document.querySelectorAll(".filter-chapter-select-btn")
    const seasonButtons = document.querySelectorAll(".filter-season-btn")
    const sortButtons = document.querySelectorAll(".sort-fish-btn")
    const viewButtons = document.querySelectorAll(".view-mode-btn")
    const searchInput = document.getElementById("fishSearchInput")
    const clearBtn = document.getElementById("clearSearchBtn")
    const subfiltersFish = document.getElementById("subfiltersFish")
    const subfiltersTrap = document.getElementById("subfiltersTrap")
    const subfiltersMarvel = document.getElementById("subfiltersMarvel")
    const bottomFilterRow = document.getElementById("bottomFilterRow")
    const seasonFilterBlock = document.getElementById("seasonFilterBlock")
    const chapterFilterBlock = document.getElementById("chapterFilterBlock")
    const fullGrid = document.getElementById("fishGrid")
    const compactGrid = document.getElementById("fishGridCompact")
    const tableContainer = document.getElementById("fishTableContainer")
    const cards = document.querySelectorAll(".fish-card")
    const compactCards = document.querySelectorAll(".fish-card-compact")
    const tableRows = document.querySelectorAll(".fish-table-row")
    const emptyState = document.getElementById("emptyResults")

    let activeSection = "fish"
    let activeTier = "all"
    let activeTrapSub = "all"
    let activeMarvelSub = "all"
    let activeChapterSelect = "all"
    let activeSeason = "all"
    let activeSort = "default"
    let searchQuery = ""
    let activeViewMode = "normal"

    try {
      const savedView = localStorage.getItem("sfl_fishing_view_mode")
      if (savedView === "normal" || savedView === "compact" || savedView === "table") {
        activeViewMode = savedView
      }
    } catch (e) {}

    function setViewMode(mode) {
      activeViewMode = mode
      try {
        localStorage.setItem("sfl_fishing_view_mode", mode)
      } catch (e) {}

      viewButtons.forEach((btn) => {
        const isTarget = btn.dataset.view === mode
        if (isTarget) {
          btn.classList.add("active", "bg-white/15", "text-cyan-300", "border-cyan-500/30", "shadow-sm")
          btn.classList.remove("text-white/50", "border-transparent")
        } else {
          btn.classList.remove("active", "bg-white/15", "text-cyan-300", "border-cyan-500/30", "shadow-sm")
          btn.classList.add("text-white/50", "border-transparent")
        }
      })

      if (fullGrid) {
        if (mode === "normal") fullGrid.classList.remove("hidden")
        else fullGrid.classList.add("hidden")
      }
      if (compactGrid) {
        if (mode === "compact") compactGrid.classList.remove("hidden")
        else compactGrid.classList.add("hidden")
      }
      if (tableContainer) {
        if (mode === "table") tableContainer.classList.remove("hidden")
        else tableContainer.classList.add("hidden")
      }
    }

    viewButtons.forEach((btn) => {
      btn.addEventListener("click", () => {
        const mode = btn.dataset.view || "normal"
        setViewMode(mode)
      })
    })

    setViewMode(activeViewMode)

    function sortContainerElements(container, selector) {
      if (!container) return
      const items = Array.from(container.querySelectorAll(selector))
      items.sort((a, b) => {
        const defaultA = parseInt(a.dataset.defaultOrder || "0", 10)
        const defaultB = parseInt(b.dataset.defaultOrder || "0", 10)

        if (activeSort === "cheapest") {
          const costA = parseFloat(a.dataset.cost || "999999")
          const costB = parseFloat(b.dataset.cost || "999999")
          if (costA !== costB) return costA - costB
          return defaultA - defaultB
        }

        if (activeSort === "expensive") {
          const costA = parseFloat(a.dataset.cost || "0")
          const costB = parseFloat(b.dataset.cost || "0")
          if (costA !== costB) return costB - costA
          return defaultA - defaultB
        }

        if (activeSort === "xp-desc") {
          const xpA = parseFloat(a.dataset.xp || "0")
          const xpB = parseFloat(b.dataset.xp || "0")
          if (xpA !== xpB) return xpB - xpA
          return defaultA - defaultB
        }

        if (activeSort === "xp-asc") {
          const xpA = parseFloat(a.dataset.xp || "0")
          const xpB = parseFloat(b.dataset.xp || "0")
          if (xpA !== xpB) return xpA - xpB
          return defaultA - defaultB
        }

        return defaultA - defaultB
      })
      items.forEach((item) => container.appendChild(item))
    }

    function applySort() {
      sortContainerElements(document.getElementById("fishGrid"), ".fish-card")
      sortContainerElements(document.getElementById("fishGridCompact"), ".fish-card-compact")
      sortContainerElements(document.getElementById("fishTableBody"), ".fish-table-row")
    }

    function checkItemMatch(el) {
      const cardKind = el.dataset.kind || ""
      const cardTier = el.dataset.tier || ""
      const cardTrap = el.dataset.trap || ""
      const cardChapter = el.dataset.chapter || ""
      const cardChapterName = el.dataset.chapterName || ""
      const cardSeasons = (el.dataset.seasons || "").split(" ")
      const cardName = el.dataset.name || ""
      const cardBait = el.dataset.bait || ""
      const cardChum = el.dataset.chum || ""
      const cardGuaranteed = el.dataset.guaranteed || ""

      // 1. Filtro por Sección Principal
      let matchesSection = false
      if (activeSection === "all") {
        matchesSection = true
      } else if (activeSection === "fish") {
        matchesSection = cardKind === "rod"
      } else if (activeSection === "trap") {
        matchesSection = cardKind === "trap"
      } else if (activeSection === "marvel") {
        matchesSection = cardKind === "marvel"
      }

      if (!matchesSection) return false

      // 2. Subfiltros contextuales
      if (activeSection === "fish" || (activeSection === "all" && cardKind === "rod")) {
        if (activeTier !== "all" && cardTier !== activeTier) {
          return false
        }
      }

      if (activeSection === "trap") {
        if (activeTrapSub !== "all" && cardTrap !== activeTrapSub) {
          return false
        }
      }

      if (activeSection === "marvel") {
        if (activeMarvelSub === "permanent" && cardChapter !== "permanent") {
          return false
        }
        if (activeMarvelSub === "chapters" && cardChapter !== "chapters") {
          return false
        }
        if (activeMarvelSub === "current" && cardChapterName !== "Cave Dwellers") {
          return false
        }
        if (activeChapterSelect !== "all" && cardChapterName !== activeChapterSelect) {
          return false
        }
      }

      // 3. Filtro por Estación (solo para Peces o vista global "all")
      if (activeSection === "fish" || activeSection === "all") {
        const matchesSeason =
          activeSeason === "all" ||
          cardSeasons.includes(activeSeason) ||
          cardSeasons.length >= 4

        if (!matchesSeason) return false
      }

      // 4. Filtro por Búsqueda
      const matchesSearch =
        !searchQuery ||
        cardName.includes(searchQuery) ||
        cardBait.includes(searchQuery) ||
        cardChum.includes(searchQuery) ||
        cardGuaranteed.includes(searchQuery)

      return matchesSearch
    }

    function updateFilters() {
      let visibleCount = 0

      cards.forEach((card) => {
        if (checkItemMatch(card)) {
          card.classList.remove("hidden")
          visibleCount++
        } else {
          card.classList.add("hidden")
        }
      })

      compactCards.forEach((cCard) => {
        if (checkItemMatch(cCard)) cCard.classList.remove("hidden")
        else cCard.classList.add("hidden")
      })

      tableRows.forEach((row) => {
        if (checkItemMatch(row)) row.classList.remove("hidden")
        else row.classList.add("hidden")
      })

      if (emptyState) {
        if (visibleCount === 0) emptyState.classList.remove("hidden")
        else emptyState.classList.add("hidden")
      }
    }

    sectionButtons.forEach((btn) => {
      btn.addEventListener("click", () => {
        sectionButtons.forEach((b) => {
          b.classList.remove("active", "bg-cyan-500/15", "text-cyan-300", "border-cyan-500/30", "shadow-sm", "bg-white/10", "text-white", "border-white/20")
          b.classList.add("bg-transparent", "text-white/60", "border-white/5")
        })
        btn.classList.add("active", "bg-cyan-500/15", "text-cyan-300", "border-cyan-500/30", "shadow-sm")
        btn.classList.remove("bg-transparent", "text-white/60", "border-white/5")

        activeSection = btn.dataset.section || "fish"

        // Subfiltros de Fila 2
        if (subfiltersFish) {
          if (activeSection === "fish" || activeSection === "all") subfiltersFish.classList.remove("hidden")
          else subfiltersFish.classList.add("hidden")
        }
        if (subfiltersTrap) {
          if (activeSection === "trap") subfiltersTrap.classList.remove("hidden")
          else subfiltersTrap.classList.add("hidden")
        }
        if (subfiltersMarvel) {
          if (activeSection === "marvel") subfiltersMarvel.classList.remove("hidden")
          else subfiltersMarvel.classList.add("hidden")
        }

        // Fila 3: Ocultar o mostrar Estación / Capítulos
        if (activeSection === "fish" || activeSection === "all") {
          if (bottomFilterRow) bottomFilterRow.classList.remove("hidden")
          if (seasonFilterBlock) seasonFilterBlock.classList.remove("hidden")
          if (chapterFilterBlock) chapterFilterBlock.classList.add("hidden")
        } else if (activeSection === "trap") {
          // Crustáceos: ocultar fila 3 (sin estación)
          if (bottomFilterRow) bottomFilterRow.classList.add("hidden")
          if (seasonFilterBlock) seasonFilterBlock.classList.add("hidden")
          if (chapterFilterBlock) chapterFilterBlock.classList.add("hidden")
        } else if (activeSection === "marvel") {
          // Maravillas: mostrar selector de capítulos en fila 3, ocultar estación
          if (bottomFilterRow) bottomFilterRow.classList.remove("hidden")
          if (seasonFilterBlock) seasonFilterBlock.classList.add("hidden")
          if (chapterFilterBlock) chapterFilterBlock.classList.remove("hidden")

          // Reset subfiltros marvel y selector de capítulos a all
          activeMarvelSub = "all"
          activeChapterSelect = "all"
          marvelSubButtons.forEach((b) => {
            b.classList.remove(
              "active",
              "bg-white/10",
              "text-white",
              "border-white/20",
              "bg-cyan-500/20",
              "text-cyan-300",
              "border-cyan-500/30"
            )
            if (b.dataset.marvelSub === "current") {
              b.classList.add("bg-transparent", "text-cyan-300/80", "border-cyan-500/20")
            } else {
              b.classList.add("bg-transparent", "text-white/60", "border-white/5")
            }
          })
          chapterSelectButtons.forEach((cb) => {
            if (cb.dataset.chapterName === "all") {
              cb.classList.add("active", "bg-white/10", "text-white", "border-white/20")
              cb.classList.remove("bg-transparent", "text-white/60", "border-white/5")
            } else {
              cb.classList.remove(
                "active",
                "bg-white/10",
                "text-white",
                "border-white/20",
                "bg-cyan-500/20",
                "text-cyan-300",
                "border-cyan-500/30"
              )
              cb.classList.add("bg-transparent", "text-white/60", "border-white/5")
            }
          })
        }

        updateFilters()
      })
    })

    tierButtons.forEach((btn) => {
      btn.addEventListener("click", () => {
        tierButtons.forEach((b) => {
          b.classList.remove("bg-white/10", "text-white", "border-white/20", "active")
          b.classList.add("bg-transparent", "text-white/60", "border-white/5")
        })
        btn.classList.add("bg-white/10", "text-white", "border-white/20", "active")
        btn.classList.remove("bg-transparent", "text-white/60", "border-white/5")

        activeTier = btn.dataset.tier || "all"
        updateFilters()
      })
    })

    trapSubButtons.forEach((btn) => {
      btn.addEventListener("click", () => {
        trapSubButtons.forEach((b) => {
          b.classList.remove("bg-white/10", "text-white", "border-white/20", "active")
          b.classList.add("bg-transparent", "text-white/60", "border-white/5")
        })
        btn.classList.add("bg-white/10", "text-white", "border-white/20", "active")
        btn.classList.remove("bg-transparent", "text-white/60", "border-white/5")

        activeTrapSub = btn.dataset.trapSub || "all"
        updateFilters()
      })
    })

    marvelSubButtons.forEach((btn) => {
      btn.addEventListener("click", () => {
        const sub = btn.dataset.marvelSub || "all"
        const isAlreadyActive = btn.classList.contains("active")

        if (isAlreadyActive) {
          // Toggle OFF: deseleccionar y volver a mostrar todas las maravillas
          btn.classList.remove(
            "active",
            "bg-white/10",
            "text-white",
            "border-white/20",
            "bg-cyan-500/20",
            "text-cyan-300",
            "border-cyan-500/30"
          )
          if (sub === "current") {
            btn.classList.add("bg-transparent", "text-cyan-300/80", "border-cyan-500/20")
          } else {
            btn.classList.add("bg-transparent", "text-white/60", "border-white/5")
          }

          activeMarvelSub = "all"
          activeChapterSelect = "all"

          // Restaurar fila 3 a "Todos los Capítulos"
          chapterSelectButtons.forEach((cb) => {
            if (cb.dataset.chapterName === "all") {
              cb.classList.add("active", "bg-white/10", "text-white", "border-white/20")
              cb.classList.remove("bg-transparent", "text-white/60", "border-white/5")
            } else {
              cb.classList.remove(
                "active",
                "bg-white/10",
                "text-white",
                "border-white/20",
                "bg-cyan-500/20",
                "text-cyan-300",
                "border-cyan-500/30"
              )
              cb.classList.add("bg-transparent", "text-white/60", "border-white/5")
            }
          })
        } else {
          // Activar este botón y desactivar el otro
          marvelSubButtons.forEach((b) => {
            b.classList.remove(
              "active",
              "bg-white/10",
              "text-white",
              "border-white/20",
              "bg-cyan-500/20",
              "text-cyan-300",
              "border-cyan-500/30"
            )
            if (b.dataset.marvelSub === "current") {
              b.classList.add("bg-transparent", "text-cyan-300/80", "border-cyan-500/20")
            } else {
              b.classList.add("bg-transparent", "text-white/60", "border-white/5")
            }
          })

          if (sub === "current") {
            btn.classList.add("active", "bg-cyan-500/20", "text-cyan-300", "border-cyan-500/30")
            btn.classList.remove("bg-transparent", "text-cyan-300/80", "border-cyan-500/20")
            activeMarvelSub = "current"
            activeChapterSelect = "Cave Dwellers"

            // Sincronizar fila 3 con Cap. 16: Cave Dwellers
            chapterSelectButtons.forEach((cb) => {
              if (cb.dataset.chapterName === "Cave Dwellers") {
                cb.classList.add("active", "bg-cyan-500/20", "text-cyan-300", "border-cyan-500/30")
                cb.classList.remove("bg-transparent", "text-white/60", "border-white/5")
              } else {
                cb.classList.remove(
                  "active",
                  "bg-white/10",
                  "text-white",
                  "border-white/20",
                  "bg-cyan-500/20",
                  "text-cyan-300",
                  "border-cyan-500/30"
                )
                cb.classList.add("bg-transparent", "text-white/60", "border-white/5")
              }
            })
          } else if (sub === "permanent") {
            btn.classList.add("active", "bg-white/10", "text-white", "border-white/20")
            btn.classList.remove("bg-transparent", "text-white/60", "border-white/5")
            activeMarvelSub = "permanent"
            activeChapterSelect = "all"

            // En fila 3 deseleccionar capítulos
            chapterSelectButtons.forEach((cb) => {
              cb.classList.remove(
                "active",
                "bg-white/10",
                "text-white",
                "border-white/20",
                "bg-cyan-500/20",
                "text-cyan-300",
                "border-cyan-500/30"
              )
              cb.classList.add("bg-transparent", "text-white/60", "border-white/5")
            })
          }
        }

        updateFilters()
      })
    })

    chapterSelectButtons.forEach((btn) => {
      btn.addEventListener("click", () => {
        chapterSelectButtons.forEach((b) => {
          b.classList.remove("active", "bg-white/10", "text-white", "border-white/20", "bg-cyan-500/20", "text-cyan-300", "border-cyan-500/30")
          b.classList.add("bg-transparent", "text-white/60", "border-white/5")
        })
        btn.classList.add("active", "bg-white/10", "text-white", "border-white/20")
        btn.classList.remove("bg-transparent", "text-white/60", "border-white/5")

        const chName = btn.dataset.chapterName || "all"
        activeChapterSelect = chName

        if (chName === "all") {
          activeMarvelSub = "all"
          marvelSubButtons.forEach((b) => {
            b.classList.remove(
              "active",
              "bg-white/10",
              "text-white",
              "border-white/20",
              "bg-cyan-500/20",
              "text-cyan-300",
              "border-cyan-500/30"
            )
            if (b.dataset.marvelSub === "current") {
              b.classList.add("bg-transparent", "text-cyan-300/80", "border-cyan-500/20")
            } else {
              b.classList.add("bg-transparent", "text-white/60", "border-white/5")
            }
          })
        } else if (chName === "Cave Dwellers") {
          activeMarvelSub = "current"
          marvelSubButtons.forEach((b) => {
            if (b.dataset.marvelSub === "current") {
              b.classList.add("active", "bg-cyan-500/20", "text-cyan-300", "border-cyan-500/30")
              b.classList.remove("bg-transparent", "text-cyan-300/80", "border-cyan-500/20")
            } else {
              b.classList.remove("active", "bg-white/10", "text-white", "border-white/20")
              b.classList.add("bg-transparent", "text-white/60", "border-white/5")
            }
          })
        } else {
          activeMarvelSub = "chapters"
          marvelSubButtons.forEach((b) => {
            b.classList.remove(
              "active",
              "bg-white/10",
              "text-white",
              "border-white/20",
              "bg-cyan-500/20",
              "text-cyan-300",
              "border-cyan-500/30"
            )
            if (b.dataset.marvelSub === "current") {
              b.classList.add("bg-transparent", "text-cyan-300/80", "border-cyan-500/20")
            } else {
              b.classList.add("bg-transparent", "text-white/60", "border-white/5")
            }
          })
        }

        updateFilters()
      })
    })

    seasonButtons.forEach((btn) => {
      btn.addEventListener("click", () => {
        seasonButtons.forEach((b) => {
          b.classList.remove("bg-white/10", "text-white", "border-white/20", "active")
          b.classList.add("bg-transparent", "text-white/60", "border-white/5")
        })
        btn.classList.add("bg-white/10", "text-white", "border-white/20", "active")
        btn.classList.remove("bg-transparent", "text-white/60", "border-white/5")

        activeSeason = btn.dataset.season || "all"
        updateFilters()
      })
    })

    sortButtons.forEach((btn) => {
      btn.addEventListener("click", () => {
        sortButtons.forEach((b) => {
          b.classList.remove("bg-white/10", "text-white", "border-white/20", "active")
          b.classList.add("bg-transparent", "text-white/60", "border-white/5")
        })
        btn.classList.add("bg-white/10", "text-white", "border-white/20", "active")
        btn.classList.remove("bg-transparent", "text-white/60", "border-white/5")

        activeSort = btn.dataset.sort || "default"
        applySort()
      })
    })

    if (searchInput) {
      searchInput.addEventListener("input", (e) => {
        searchQuery = e.target.value.toLowerCase().trim()
        if (clearBtn) {
          if (searchQuery) clearBtn.classList.remove("hidden")
          else clearBtn.classList.add("hidden")
        }
        updateFilters()
      })
    }

    if (clearBtn && searchInput) {
      clearBtn.addEventListener("click", () => {
        searchInput.value = ""
        searchQuery = ""
        clearBtn.classList.add("hidden")
        updateFilters()
        searchInput.focus()
      })
    }

    // Calculadora Económica Dinámica (Consumiendo SflPrices y SflMarket)
    let rodCost = 0
    let crabPotCost = 0
    let marinerPotCost = 0
    let baseAttemptCost = 0
    let flowerPrice = 0.0854
    let hasAncientRod = false

    // Estado reactivo de Boosts y Habilidades de Pesca
    let activeBuffs = new Set()
    let activeSkills = {}

    function loadFishingUserState() {
      try {
        const raw = localStorage.getItem("sfl_user_game_state_v1")
        if (raw) {
          const parsed = JSON.parse(raw)
          activeBuffs = new Set(Object.keys(parsed.buffs || {}).filter(k => parsed.buffs[k]))
          activeSkills = parsed.skills || {}
          hasAncientRod = Boolean(
            activeBuffs.has("Ancient Rod") ||
            activeBuffs.has("224") ||
            activeSkills["Ancient Rod"]
          )
        }
      } catch (e) {
        console.warn("[Fishing] Error al leer SflUserState", e)
      }
    }

    loadFishingUserState()

    window.addEventListener("sfl:stateUpdated", (e) => {
      if (e && e.detail) {
        const state = e.detail
        activeBuffs = new Set(Object.keys(state.buffs || {}).filter(k => state.buffs[k]))
        activeSkills = state.skills || {}
        hasAncientRod = Boolean(
          activeBuffs.has("Ancient Rod") ||
          activeBuffs.has("224") ||
          activeSkills["Ancient Rod"]
        )
        syncMarketPrices()
      }
    })

    function getBaitUnitPrice(name) {
      if (["Earthworm", "Grub", "Red Wiggler"].includes(name)) {
        return 0
      }
      if (window.SflPrices && typeof window.SflPrices.getUnitCost === "function") {
        return window.SflPrices.getUnitCost(name).flower || 0
      }
      return 0
    }

    function getChumUnitPrice(name) {
      if (window.SflPrices && typeof window.SflPrices.getUnitCost === "function") {
        return window.SflPrices.getUnitCost(name).flower || 0
      }
      return 0
    }

    function updateCardCost(card) {
      if (!card) return
      try {
        const isRod = card.dataset.kind === "rod"
        const isTrap = card.dataset.kind === "trap"
        const isMarvel = card.dataset.kind === "marvel"

        let attemptCost = baseAttemptCost
        let baseLabel = textBase
        const flowerIconHtml = `<img src="/img/sunflowerland/flower.jpg" alt="FLOWER" class="w-2.5 h-2.5 rounded-full object-cover shrink-0 inline-block align-middle -translate-y-px mr-0.5" />`

      // 1. Si es pesca con caña o maravilla marina, verificar qué cebo está seleccionado
      if (isRod || isMarvel) {
        if (isMarvel) {
          // Multiplicador de mapas por potenciadores activos (Full Moon + Deep Sea Helm + Summer Guardian + Navigation Table)
          const hasFullMoon =
            activeBuffs.has("Full Moon") || activeBuffs.has("9023") || activeSkills["Full Moon"]
          const hasSummerGuardian =
            activeBuffs.has("Summer Guardian") ||
            activeBuffs.has("2262") ||
            activeSkills["Summer Guardian"]
          const hasNavigationTable =
            activeBuffs.has("Navigation Table") ||
            activeBuffs.has("2992") ||
            activeSkills["Navigation Table"]
          const hasDeepSeaHelm =
            activeBuffs.has("Deep Sea Helm") ||
            activeBuffs.has("9024") ||
            activeSkills["Deep Sea Helm"]

          let mapMultiplier = 1.0
          const mapTags = []
          if (hasFullMoon) {
            mapMultiplier += 1.0
            mapTags.push("+100% Luna Llena")
          }
          if (hasSummerGuardian && hasFullMoon) {
            mapMultiplier += 1.0
            mapTags.push("+100% Summer Guardian")
          }
          if (hasNavigationTable) {
            mapMultiplier += 1.0
            mapTags.push("+100% Navigation Table")
          }
          if (hasDeepSeaHelm) {
            mapMultiplier += 1.0
            mapTags.push("+100% Deep Sea Helm")
          }

          // Reflejar el porcentaje potenciado en CADA fila de disparador de mapa (map-odds-val)
          const triggerRows = card.querySelectorAll(".map-trigger-row")
          triggerRows.forEach((row) => {
            const baseOdds = parseFloat(row.dataset.baseOdds || row.dataset.odds) || 0
            if (!row.dataset.baseOdds) {
              row.dataset.baseOdds = baseOdds.toString()
            }
            const effectiveOddsVal = Math.min(100, baseOdds * mapMultiplier)
            const effectiveOdds = effectiveOddsVal.toFixed(1)
            row.dataset.odds = effectiveOdds

            const oddsValEl = row.querySelector(".map-odds-val")
            if (oddsValEl) {
              oddsValEl.textContent = `${effectiveOdds}%`
            }

            const oddsBadgeEl = row.querySelector(".map-odds-badge")
            if (oddsBadgeEl) {
              if (mapMultiplier > 1) {
                oddsBadgeEl.title = `${effectiveOdds}% prob. fragmento de mapa [${mapTags.join(" + ")}]`
                oddsBadgeEl.classList.add("bg-amber-500/10", "border-amber-500/25", "text-amber-200/90")
                oddsBadgeEl.classList.remove("bg-white/[0.03]", "border-white/10", "text-white/70", "bg-cyan-500/25", "border-cyan-400", "shadow-[0_0_8px_rgba(34,211,238,0.25)]")
              } else {
                oddsBadgeEl.title = `${baseOdds.toFixed(1)}% prob. fragmento de mapa`
                oddsBadgeEl.classList.remove("bg-amber-500/10", "border-amber-500/25", "text-amber-200/90", "bg-cyan-500/25", "border-cyan-400", "shadow-[0_0_8px_rgba(34,211,238,0.25)]")
                oddsBadgeEl.classList.add("bg-white/[0.03]", "border-white/10", "text-white/70")
              }
            }
          })

          // Para maravillas marinas, dar prioridad al disparador de mapa seleccionado si existe
          const costTitleEl = card.querySelector(".cost-title-label")
          const activeTrigger = card.querySelector(".map-trigger-row.active")
          if (activeTrigger) {
            const baitName = activeTrigger.dataset.baitName || ""
            const fishName = activeTrigger.dataset.fishName || ""
            const baseOdds = parseFloat(activeTrigger.dataset.baseOdds || activeTrigger.dataset.odds) || 0
            const baitPrice = baitName ? getBaitUnitPrice(baitName) : 0

            // 1 Caña + Cebo por lanzamiento individual
            const singleAttemptCost = rodCost + baitPrice

            // Para conseguir 9 fragmentos de mapa con probabilidad efectiva p:
            const effectiveOddsVal = Math.min(100, baseOdds * mapMultiplier)
            const p = Math.min(1.0, effectiveOddsVal / 100)
            const expectedCasts = p > 0 ? 9 / p : 1
            const roundedCasts = Math.ceil(expectedCasts)

            // Costo total estadístico acumulado para los 9 mapas
            attemptCost = expectedCasts * singleAttemptCost

            if (costTitleEl) {
              costTitleEl.textContent = textCostMarvel
            }

            const effectiveOdds = effectiveOddsVal.toFixed(1)
            const rodImg = hasAncientRod
              ? "/img/sunflowerland/powerups/wearables/Ancient Rod.webp"
              : "/img/sunflowerland/tools/Rod.png"
            const rodCostVal = hasAncientRod ? "0" : rodCost.toFixed(4)

            baseLabel = `
              <span class="text-white/90 font-medium">~${roundedCasts} ${textCasts}</span>
              <span class="text-white/20">·</span>
              <span class="inline-flex items-center gap-1" title="${hasAncientRod ? 'Ancient Rod (0 FLOWER)' : 'Caña (' + rodCost.toFixed(4) + ' FLOWER)'}">
                <img src="${rodImg}" alt="Rod" class="w-3.5 h-3.5 object-contain [image-rendering:pixelated]" />
                <span class="${hasAncientRod ? 'text-emerald-400 font-medium' : 'text-white/60'}">(${flowerIconHtml}${rodCostVal})</span>
              </span>
            `

            if (baitName) {
              const baitImgEl = activeTrigger.querySelector("img")
              const baitImg = baitImgEl ? baitImgEl.getAttribute("src") : `/img/sunflowerland/fish/a/${baitName}.png`
              baseLabel += `
                <span class="text-white/20">+</span>
                <span class="inline-flex items-center gap-1" title="${baitName} (${baitPrice.toFixed(4)} FLOWER)">
                  <img src="${baitImg}" alt="${baitName}" class="w-3.5 h-3.5 object-contain [image-rendering:pixelated]" />
                  <span class="text-white/80 font-mono">(${flowerIconHtml}${baitPrice.toFixed(4)})</span>
                </span>
              `
            }

            const allTrigImgs = activeTrigger.querySelectorAll("img")
            const fishImgEl = allTrigImgs.length > 1 ? allTrigImgs[1] : allTrigImgs[0]
            const fishImg = fishImgEl ? fishImgEl.getAttribute("src") : `/img/sunflowerland/fish/${fishName}.png`

            baseLabel += `
              <span class="text-white/20 text-[9px]">➔</span>
              <span class="inline-flex items-center gap-1" title="${fishName} (${effectiveOdds}% prob. mapa)">
                <img src="${fishImg}" alt="${fishName}" class="w-3.5 h-3.5 object-contain [image-rendering:pixelated]" />
                <span class="text-amber-200/90 font-medium font-mono">(${effectiveOdds}%)</span>
              </span>
            `
          } else {
            if (costTitleEl) {
              costTitleEl.textContent = textCostNormal
            }
            const activeBait = card.querySelector(".bait-badge.active")
            if (activeBait) {
              const baitName = activeBait.dataset.baitName || "Earthworm"
              const isFree = activeBait.dataset.isFree === "true"
              const baitPrice = getBaitUnitPrice(baitName)
              attemptCost = rodCost + baitPrice

              const rodImg = hasAncientRod
                ? "/img/sunflowerland/powerups/wearables/Ancient Rod.webp"
                : "/img/sunflowerland/tools/Rod.png"
              const rodCostVal = hasAncientRod ? "0" : rodCost.toFixed(4)
              const baitImgEl = activeBait.querySelector("img")
              const baitImg = baitImgEl ? baitImgEl.getAttribute("src") : `/img/sunflowerland/fish/a/${baitName}.png`
              const baitCostVal = isFree ? "0" : baitPrice.toFixed(4)

              baseLabel = `
                <span class="inline-flex items-center gap-1" title="${hasAncientRod ? 'Ancient Rod (0 FLOWER)' : 'Caña (' + rodCost.toFixed(4) + ' FLOWER)'}">
                  <img src="${rodImg}" alt="Rod" class="w-3.5 h-3.5 object-contain [image-rendering:pixelated]" />
                  <span class="${hasAncientRod ? 'text-emerald-400 font-medium' : 'text-white/80'}">(${flowerIconHtml}${rodCostVal})</span>
                </span>
                <span class="text-white/30">+</span>
                <span class="inline-flex items-center gap-1" title="${baitName} (${baitCostVal} FLOWER)">
                  <img src="${baitImg}" alt="${baitName}" class="w-3.5 h-3.5 object-contain [image-rendering:pixelated]" />
                  <span class="${isFree ? 'text-emerald-400 font-medium' : 'text-white/80 font-medium'}">(${flowerIconHtml}${baitCostVal})</span>
                </span>
              `
            }
          }
        } else {
          const activeBait = card.querySelector(".bait-badge.active")
          if (activeBait) {
            const baitName = activeBait.dataset.baitName || "Earthworm"
            const isFree = activeBait.dataset.isFree === "true"
            const isGuaranteed = activeBait.dataset.isGuaranteed === "true"
            const baitPrice = getBaitUnitPrice(baitName)
            attemptCost = rodCost + baitPrice

            const rodImg = hasAncientRod
              ? "/img/sunflowerland/powerups/wearables/Ancient Rod.webp"
              : "/img/sunflowerland/tools/Rod.png"
            const rodCostVal = hasAncientRod ? "0" : rodCost.toFixed(4)
            const baitImgEl = activeBait.querySelector("img")
            const baitImg = baitImgEl ? baitImgEl.getAttribute("src") : `/img/sunflowerland/fish/a/${baitName}.png`
            const baitCostVal = isFree ? "0" : baitPrice.toFixed(4)

            baseLabel = `
              <span class="inline-flex items-center gap-1" title="${hasAncientRod ? 'Ancient Rod (0 FLOWER)' : 'Caña (' + rodCost.toFixed(4) + ' FLOWER)'}">
                <img src="${rodImg}" alt="Rod" class="w-3.5 h-3.5 object-contain [image-rendering:pixelated]" />
                <span class="${hasAncientRod ? 'text-emerald-400 font-medium' : 'text-white/80'}">(${flowerIconHtml}${rodCostVal})</span>
              </span>
              <span class="text-white/30">+</span>
              <span class="inline-flex items-center gap-1" title="${baitName} (${baitCostVal} FLOWER)">
                <img src="${baitImg}" alt="${baitName}" class="w-3.5 h-3.5 object-contain [image-rendering:pixelated]" />
                <span class="${isFree ? 'text-emerald-400 font-medium' : 'text-white/80 font-medium'}">(${flowerIconHtml}${baitCostVal})</span>
              </span>
            `
          }
        }
      } else if (isTrap) {
        // 2. Si es trampa de agua, calcular según la trampa específica (Crab Pot o Mariner Pot)
        const trapType = card.dataset.trap || "Crab Pot"
        const isMariner = trapType.toLowerCase().includes("mariner")
        const currentTrapCost = isMariner ? marinerPotCost : crabPotCost
        attemptCost = currentTrapCost > 0 ? currentTrapCost : baseAttemptCost
        const trapImg = isMariner ? "/img/sunflowerland/tools/Mariner Pot.png" : "/img/sunflowerland/tools/Crab Pot.png"

        // Actualizar el valor de costo en el bloque visual de trampa
        const trapValNum = card.querySelector(".trap-val-num")
        if (trapValNum && currentTrapCost > 0) {
          trapValNum.textContent = `${currentTrapCost.toFixed(4)}`
        }

        baseLabel = `
          <span class="inline-flex items-center gap-1" title="${trapType} (${currentTrapCost.toFixed(4)} FLOWER)">
            <img src="${trapImg}" alt="${trapType}" class="w-3.5 h-3.5 object-contain [image-rendering:pixelated]" />
            <span class="text-white/80 font-medium">(${flowerIconHtml}${currentTrapCost.toFixed(4)})</span>
          </span>
        `
      }

      // 3. Sumar Chum si está activo (solo para caña normal, trampas o captura directa sin trigger de mapa)
      const isMarvelWithTrigger = isMarvel && card.querySelector(".map-trigger-row.active")
      const activeBadge = isMarvelWithTrigger ? null : card.querySelector(".chum-badge.active")
      let totalCost = attemptCost
      let breakdownHtml = baseLabel

      if (activeBadge) {
        const chumName = activeBadge.dataset.chumName
        const amount = parseFloat(activeBadge.dataset.chumAmount) || 1
        const unitPrice = getChumUnitPrice(chumName)
        const chumCost = unitPrice * amount
        totalCost += chumCost
        const chumImgEl = activeBadge.querySelector("img")
        const chumImg = chumImgEl ? chumImgEl.getAttribute("src") : `/img/sunflowerland/${chumName}.png`

        const qtyPrefix = amount > 1 ? `<span class="text-white/80 font-mono text-[10px] mr-0.5">${amount}x</span>` : ""

        breakdownHtml += `
          <span class="text-white/30">+</span>
          <span class="inline-flex items-center gap-1" title="${amount}x ${chumName} (${chumCost.toFixed(4)} FLOWER)">
            ${qtyPrefix}
            <img src="${chumImg}" alt="${chumName}" class="w-3.5 h-3.5 object-contain [image-rendering:pixelated]" />
            <span class="text-white/80 font-medium">(${flowerIconHtml}${chumCost.toFixed(4)})</span>
          </span>
        `
      }

      // 4. Rendimiento de Captura (Fish Yield) según potenciadores y habilidades activas
      let fishYield = 1.0
      let bonusTags = []
      let seasonalMatches = []

      if (isRod) {
        if (window.SflFishing && typeof window.SflFishing.calculateFishYield === "function") {
          const yieldResult = window.SflFishing.calculateFishYield(
            card.dataset.tier || "basic",
            card.dataset.seasons || "",
            window.SflUserState ? window.SflUserState.getState() : null
          )
          fishYield = yieldResult.yield
          bonusTags = yieldResult.bonusTags
          seasonalMatches = yieldResult.seasonalMatches
        }
      }

      // Costo unitario efectivo por pez capturado
      const effectiveUnitCost = totalCost / fishYield

      const isReady =
        hasAncientRod ||
        rodCost > 0 ||
        isTrap ||
        isMarvel ||
        Boolean(
          window.SflPrices &&
            (window.SflPrices.resolveCost("Rod") || window.SflPrices.getUnitCost("Rod"))
        )

      const costTitleEl = card.querySelector(".cost-title-label")
      if (costTitleEl && !isMarvel) {
        if (fishYield > 1) {
          costTitleEl.textContent = textCostPerFish
        } else {
          costTitleEl.textContent = textCostNormal
        }
      }

      const flowerValNum = card.querySelector(".cost-val-num")
      if (flowerValNum) {
        flowerValNum.textContent = isReady
          ? fishYield > 1
            ? `${effectiveUnitCost.toFixed(4)}`
            : `${totalCost.toFixed(4)}`
          : "--"
      }

      const currentUnitCost = isReady
        ? (fishYield > 1 ? effectiveUnitCost : totalCost)
        : 999999
      card.dataset.cost = String(currentUnitCost)

      const usdEl = card.querySelector(".cost-usd-val")
      if (usdEl) {
        const effectiveUsd = effectiveUnitCost * flowerPrice
        usdEl.textContent = isReady
          ? fishYield > 1
            ? `($${effectiveUsd.toFixed(3)}/u)`
            : `($${(totalCost * flowerPrice).toFixed(3)})`
          : "(--)"
      }

      // 5. Recopilar potenciadores y buffs activos aplicables a este pez
      const activeBuffItems = []

      // Ancient Rod
      if (hasAncientRod && (isRod || isMarvel)) {
        activeBuffItems.push({
          name: "Ancient Rod",
          desc: "Caña gratis (0 FLOWER)",
          img: "/img/sunflowerland/powerups/wearables/Ancient Rod.webp",
        })
      }

      if (isRod) {
        if (activeBuffs.has("Sunflower Rod") || activeBuffs.has("9021") || activeSkills["Sunflower Rod"]) {
          activeBuffItems.push({
            name: "Sunflower Rod",
            desc: "+10% prob. +1 pez",
            img: "/img/sunflowerland/fish/a/sunflower_rod.webp",
          })
        }
        if (activeBuffs.has("Trident") || activeBuffs.has("9022") || activeSkills["Trident"]) {
          activeBuffItems.push({
            name: "Trident",
            desc: "+20% prob. +1 pez",
            img: "/img/sunflowerland/fish/a/tirdent.webp",
          })
        }
        if (activeBuffs.has("Fisher's Hourglass") || activeBuffs.has("9015") || activeSkills["Fisher's Hourglass"]) {
          activeBuffItems.push({
            name: "Fisher's Hourglass",
            desc: "+50% prob. +1 pez",
            img: "/img/sunflowerland/aoe/fishers_hourglass.webp",
          })
        }
        if (activeBuffs.has("Shrimp Onesie") || activeBuffs.has("562") || activeSkills["Shrimp Onesie"]) {
          activeBuffItems.push({
            name: "Shrimp Onesie",
            desc: "+1 pez cada 15 lances (+6.67%)",
            img: "/img/sunflowerland/powerups/wearables/shrimp_onesie.webp",
          })
        }
        if (activeBuffs.has("Otty the Otter") || activeBuffs.has("3050") || activeSkills["Otty the Otter"]) {
          activeBuffItems.push({
            name: "Otty the Otter",
            desc: "+1 pez cada 15 lances (+6.67%)",
            img: "/img/sunflowerland/powerups/otty_the_otter.webp",
          })
        }
        if (activeBuffs.has("Fish Frenzy") || activeBuffs.has("9020") || activeSkills["Fish Frenzy"]) {
          activeBuffItems.push({
            name: "Fish Frenzy",
            desc: "Día de Frenesí (+1 pez)",
            img: "/img/sunflowerland/aoe/frenzied_fish.webp",
          })
        }
        if (activeSkills && activeSkills["Frenzied Fish"]) {
          activeBuffItems.push({
            name: "Frenzied Fish",
            desc: `Frenzied Fish R${activeSkills["Frenzied Fish"]}`,
            img: "/img/sunflowerland/aoe/frenzied_fish.webp",
            isSkill: true,
          })
        }
        const cardTier = card.dataset.tier || ""
        if (cardTier === "basic" && activeSkills && activeSkills["Fishy Chance"]) {
          activeBuffItems.push({
            name: "Fishy Chance",
            desc: `Fishy Chance R${activeSkills["Fishy Chance"]}`,
            img: "/img/sunflowerland/skills/fishy_chance.webp",
            isSkill: true,
          })
        }
        if (cardTier === "advanced" && activeSkills && activeSkills["Fishy Roll"]) {
          activeBuffItems.push({
            name: "Fishy Roll",
            desc: `Fishy Roll R${activeSkills["Fishy Roll"]}`,
            img: "/img/sunflowerland/skills/fishy_roll.webp",
            isSkill: true,
          })
        }
        if (activeSkills && activeSkills["Angler"]) {
          activeBuffItems.push({
            name: "Angler",
            desc: `Angler R${activeSkills["Angler"]}`,
            img: "/img/sunflowerland/skills/angler.webp",
            isSkill: true,
          })
        }
        if (seasonalMatches.length > 0) {
          const mainSeasonMatch = seasonalMatches[0]
          activeBuffItems.push({
            name: mainSeasonMatch.name,
            desc:
              seasonalMatches.length > 1
                ? `Bono Estacional (+1 pez en temporada: ${seasonalMatches.map((s) => s.season).join(", ")})`
                : mainSeasonMatch.desc,
            img: mainSeasonMatch.img,
          })
        }
      }

      if (isMarvel) {
        if (activeBuffs.has("Full Moon") || activeBuffs.has("9023") || activeSkills["Full Moon"]) {
          activeBuffItems.push({
            name: "Full Moon",
            desc: "+100% chance mapas",
            img: "/img/sunflowerland/aoe/full_moon.png",
          })
        }
        if ((activeBuffs.has("Summer Guardian") || activeBuffs.has("2262") || activeSkills["Summer Guardian"]) && (activeBuffs.has("Full Moon") || activeBuffs.has("9023"))) {
          activeBuffItems.push({
            name: "Summer Guardian",
            desc: "+100% chance mapas (Luna Llena)",
            img: "/img/sunflowerland/powerups/summer_guardian.webp",
          })
        }
        if (activeBuffs.has("Navigation Table") || activeBuffs.has("2992") || activeSkills["Navigation Table"]) {
          activeBuffItems.push({
            name: "Navigation Table",
            desc: "+100% chance mapas",
            img: "/img/sunflowerland/powerups/navigation_table.webp",
          })
        }
        if (activeBuffs.has("Deep Sea Helm") || activeBuffs.has("9024") || activeSkills["Deep Sea Helm"]) {
          activeBuffItems.push({
            name: "Deep Sea Helm",
            desc: "+100% chance mapas",
            img: "/img/sunflowerland/fish/a/deep_sea_helm.webp",
          })
        }
      }

      let buffsHtml = ""
      const yieldBadgeHtml = fishYield > 1
        ? `<span class="text-cyan-400 font-bold shrink-0 text-[10px] font-mono leading-none" title="${bonusTags.join(', ')}">(~${fishYield.toFixed(2)}x)</span>`
        : ""

      if (activeBuffItems.length > 0 || fishYield > 1) {
        const buffImgs = activeBuffItems
          .map((b) => {
            const isNonStandardSkill = Boolean(b.isSkill && b.img && !b.img.startsWith("/img/sunflowerland/skills/"))
            const overlayRayHtml = isNonStandardSkill
              ? `<img src="/img/sunflowerland/123/energy.png" alt="Skill" class="absolute -top-1 -left-1 w-2 h-2 object-contain [image-rendering:pixelated] drop-shadow pointer-events-none z-10" />`
              : ""
            return `
              <div class="relative shrink-0">
                <img src="${b.img}" alt="${b.name}" title="${b.name}: ${b.desc}" onerror="this.onerror=null; this.src='/img/cripto/sunflowerland.webp';" class="w-3.5 h-3.5 object-contain [image-rendering:pixelated] rounded bg-white/5 border border-white/10 shrink-0 hover:scale-125 transition-transform cursor-help" loading="lazy" />
                ${overlayRayHtml}
              </div>
            `
          })
          .join("")

        buffsHtml = `
          <div class="flex items-center gap-1.5 pt-1 mt-1 border-t border-white/[0.04]">
            <img src="/img/sunflowerland/123/energy.png" alt="Energy" class="w-3.5 h-3.5 object-contain [image-rendering:pixelated] shrink-0" />
            ${yieldBadgeHtml}
            <div class="flex items-center flex-wrap gap-1">
              ${buffImgs}
            </div>
          </div>
        `
      }

      const breakdownEl = card.querySelector(".cost-breakdown-label")
      if (breakdownEl) {
        breakdownEl.innerHTML = `
          <div class="flex flex-col w-full">
            <div class="flex items-center flex-wrap gap-1 text-[10px] leading-tight font-mono">
              ${breakdownHtml}
            </div>
            ${buffsHtml}
          </div>
        `
      }

      // Sincronizar en vivo con tarjeta compacta y fila de tabla
      const fishItemName = card.dataset.name
      if (fishItemName) {
        const compactCard = document.querySelector(`.fish-card-compact[data-name="${fishItemName}"]`)
        if (compactCard) {
          compactCard.dataset.cost = String(currentUnitCost)
          const cVal = compactCard.querySelector(".cost-val-num")
          if (cVal) cVal.textContent = isReady ? (fishYield > 1 ? effectiveUnitCost.toFixed(4) : totalCost.toFixed(4)) : "--"
          const cUsd = compactCard.querySelector(".cost-usd-val")
          if (cUsd) {
            const effUsd = effectiveUnitCost * flowerPrice
            cUsd.textContent = isReady ? (fishYield > 1 ? `($${effUsd.toFixed(3)}/u)` : `($${(totalCost * flowerPrice).toFixed(3)})`) : "(--)"
          }
          const cYield = compactCard.querySelector(".yield-badge-val")
          if (cYield) cYield.textContent = fishYield > 1 ? `~${fishYield.toFixed(2)}x` : ""
          const cBaitName = compactCard.querySelector(".compact-bait-name")
          const cBaitImg = compactCard.querySelector(".compact-bait-img")
          const activeBait = card.querySelector(".bait-badge.active") || card.querySelector(".map-trigger-row.active")
          if (activeBait) {
            const bName = activeBait.dataset.baitName || activeBait.dataset.fishName || card.dataset.trap || ""
            if (cBaitName && bName) cBaitName.textContent = bName
            const bImg = activeBait.querySelector("img")
            if (cBaitImg && bImg) cBaitImg.src = bImg.src
          }
        }

        const tableRow = document.querySelector(`.fish-table-row[data-name="${fishItemName}"]`)
        if (tableRow) {
          tableRow.dataset.cost = String(currentUnitCost)
          const tVal = tableRow.querySelector(".cost-val-num")
          if (tVal) tVal.textContent = isReady ? (fishYield > 1 ? effectiveUnitCost.toFixed(4) : totalCost.toFixed(4)) : "--"
          const tUsd = tableRow.querySelector(".cost-usd-val")
          if (tUsd) {
            const effUsd = effectiveUnitCost * flowerPrice
            tUsd.textContent = isReady ? (fishYield > 1 ? `($${effUsd.toFixed(3)}/u)` : `($${(totalCost * flowerPrice).toFixed(3)})`) : "(--)"
          }
          const tAttempt = tableRow.querySelector(".table-attempt-num")
          if (tAttempt) tAttempt.textContent = isReady ? totalCost.toFixed(4) : "--"
          const tYield = tableRow.querySelector(".table-yield-val")
          if (tYield) tYield.textContent = `${fishYield.toFixed(2)}x`
          const tRoi = tableRow.querySelector(".table-roi-val")
          const itemXp = parseFloat(card.dataset.xp || "0")
          if (tRoi) {
            if (itemXp > 0 && currentUnitCost > 0 && currentUnitCost < 999999) {
              const roi = itemXp / currentUnitCost
              tRoi.textContent = `${Math.round(roi).toLocaleString()}`
            } else {
              tRoi.textContent = "—"
            }
          }
          const tBaitName = tableRow.querySelector(".table-bait-name")
          const activeBait = card.querySelector(".bait-badge.active") || card.querySelector(".map-trigger-row.active")
          if (activeBait && tBaitName) {
            const bName = activeBait.dataset.baitName || activeBait.dataset.fishName || card.dataset.trap || ""
            if (bName) tBaitName.textContent = bName
          }
        }
      }
    } catch (err) {
      console.error("Error updating card cost:", card?.dataset?.name, err)
    }
  }

    function updateAllCards() {
      cards.forEach((card) => updateCardCost(card))
      if (activeSort !== "default") {
        applySort()
      }
    }

    // Clic en badge de Cebo (Bait Selection)
    cards.forEach((card) => {
      const baitBadges = card.querySelectorAll(".bait-badge")
      baitBadges.forEach((badge) => {
        badge.addEventListener("click", (e) => {
          e.preventDefault()
          e.stopPropagation()

          const isAlreadyActive = badge.classList.contains("active")
          if (isAlreadyActive) return // Mantener siempre activo el cebo actual

          const activeBaitBefore = card.querySelector(".bait-badge.active")
          const wasGuaranteed = activeBaitBefore && activeBaitBefore.dataset.isGuaranteed === "true"
          const isNowGuaranteed = badge.dataset.isGuaranteed === "true"
          const isFree = badge.dataset.isFree === "true"

          baitBadges.forEach((b) => {
            b.classList.remove(
              "active",
              "bg-emerald-500/20",
              "border-emerald-400",
              "text-emerald-300",
              "bg-cyan-500/20",
              "border-cyan-400",
              "text-cyan-300",
              "ring-1",
              "ring-emerald-400/50",
              "ring-cyan-400/50",
              "bg-white/[0.06]",
              "border-white/25",
              "border-emerald-400/40",
              "text-emerald-200",
              "text-white",
              "shadow-sm"
            )
            b.classList.add("bg-[#0e0e11]", "border-white/5", "text-white/70")
          })

          badge.classList.remove("bg-[#0e0e11]", "border-white/5", "text-white/70", "bg-white/[0.03]")
          if (isFree) {
            badge.classList.add(
              "active",
              "bg-white/[0.06]",
              "border-emerald-400/40",
              "text-emerald-200",
              "shadow-sm"
            )
          } else {
            badge.classList.add(
              "active",
              "bg-white/[0.06]",
              "border-white/25",
              "text-white",
              "shadow-sm"
            )
          }

          // Si es Maravilla Marina y se selecciona un cebo directo, deseleccionar los disparadores de mapa
          if (card.dataset.kind === "marvel") {
            const triggerRows = card.querySelectorAll(".map-trigger-row")
            triggerRows.forEach((r) => {
              r.classList.remove(
                "active",
                "bg-white/[0.05]",
                "border-white/20",
                "text-white",
                "shadow-sm",
                "bg-white/[0.08]",
                "bg-cyan-500/20",
                "border-cyan-400"
              )
              r.classList.add("bg-[#0e0e11]", "border-white/5", "text-white/70")
            })
          }

          // Sincronizar disponibilidad de chum (deselecciona y bloquea si el cebo es garantizado)
          syncChumAvailability(card)

          // Si venía de cebo garantizado y pasa a cebo normal, restaurar chum si el toggle global está activo
          if (wasGuaranteed && !isNowGuaranteed) {
            const globalChum = document.getElementById("globalChumToggle")
            if (globalChum && globalChum.checked) {
              selectCheapestChum(card)
            }
          }

          updateCardCost(card)
          persistCardCombo(card)
        })
      })
    })

    // Clic en fila de Pez Disparador de Mapa (Maravillas Marinas)
    cards.forEach((card) => {
      const triggerRows = card.querySelectorAll(".map-trigger-row")
      triggerRows.forEach((row) => {
        row.addEventListener("click", (e) => {
          e.preventDefault()
          e.stopPropagation()

          const isAlreadyActive = row.classList.contains("active")
          if (isAlreadyActive) return // Mantener seleccionado como opción activa

          triggerRows.forEach((r) => {
            r.classList.remove(
              "active",
              "bg-white/[0.05]",
              "border-white/20",
              "text-white",
              "shadow-sm",
              "bg-white/[0.08]",
              "bg-cyan-500/20",
              "border-cyan-400"
            )
            r.classList.add("bg-[#0e0e11]", "border-white/5", "text-white/70")
          })

          row.classList.add(
            "active",
            "bg-white/[0.05]",
            "border-white/20",
            "text-white",
            "shadow-sm"
          )
          row.classList.remove("bg-[#0e0e11]", "border-white/5", "text-white/70")

          // Deseleccionar cualquier cebo de captura directa para evitar interferencias
          const baitBadges = card.querySelectorAll(".bait-badge")
          baitBadges.forEach((b) => {
            b.classList.remove(
              "active",
              "bg-emerald-500/20",
              "border-emerald-400",
              "text-emerald-300",
              "bg-cyan-500/20",
              "border-cyan-400",
              "text-cyan-300",
              "ring-1",
              "ring-emerald-400/50",
              "ring-cyan-400/50",
              "shadow-sm"
            )
            b.classList.add("bg-white/[0.03]", "border-white/5", "text-white/70")
          })

          updateCardCost(card)
          persistCardCombo(card)
        })
      })
    })

    // Clic en badge de Chum
    cards.forEach((card) => {
      const badges = card.querySelectorAll(".chum-badge")
      badges.forEach((badge) => {
        badge.addEventListener("click", (e) => {
          e.preventDefault()
          e.stopPropagation()

          // No permitir seleccionar chum si el cebo activo es garantizado
          const activeBait = card.querySelector(".bait-badge.active")
          if (activeBait && activeBait.dataset.isGuaranteed === "true") {
            return
          }

          const isAlreadyActive = badge.classList.contains("active")

          badges.forEach((b) => {
            b.classList.remove(
              "active",
              "bg-cyan-500/20",
              "border-cyan-400",
              "text-cyan-300",
              "ring-1",
              "ring-cyan-400/50",
              "bg-white/[0.06]",
              "border-white/25",
              "text-white",
              "shadow-sm"
            )
            b.classList.add("bg-[#0e0e11]", "border-white/5", "text-white/70")
            const check = b.querySelector(".chum-check")
            if (check) check.classList.add("hidden")
          })

          if (!isAlreadyActive) {
            badge.classList.add(
              "active",
              "bg-white/[0.06]",
              "border-white/25",
              "text-white",
              "shadow-sm"
            )
            badge.classList.remove("bg-[#0e0e11]", "border-white/5", "text-white/70", "bg-white/[0.03]")
            const check = badge.querySelector(".chum-check")
            if (check) check.classList.remove("hidden")
          }

          updateCardCost(card)
          persistCardCombo(card)
        })
      })
    })

    // Persiste en el perfil global del usuario (SflUserState) la combinación activa de cebo/chum para este pez
    function persistCardCombo(card) {
      if (!card || !window.SflUserState || typeof window.SflUserState.setFishCombo !== "function") return
      const rawName = card.dataset.rawName || card.dataset.name
      if (!rawName) return

      const activeBait = card.querySelector(".bait-badge.active")
      const baitName = activeBait ? activeBait.dataset.baitName : (card.dataset.kind === "trap" ? (card.dataset.trap || "Crab Pot") : null)

      const isMarvelWithTrigger = card.dataset.kind === "marvel" && card.querySelector(".map-trigger-row.active")
      const activeChum = isMarvelWithTrigger ? null : card.querySelector(".chum-badge.active")
      const chumName = activeChum ? activeChum.dataset.chumName : null
      const chumAmount = activeChum ? (parseFloat(activeChum.dataset.chumAmount) || 1) : null

      if (baitName) {
        window.SflUserState.setFishCombo(rawName, {
          bait: baitName,
          chum: chumName || null,
          chumAmount: chumAmount || null,
        })
      }
    }

    // Actualiza dinámicamente los badges 100% de los Chums según el cebo actualmente seleccionado
    function updateChumGuaranteedBadges(card) {
      if (!card) return
      const activeBait = card.querySelector(".bait-badge.active")
      const activeBaitName = activeBait ? activeBait.dataset.baitName : ""
      const isGuaranteedBait = activeBait && activeBait.dataset.isGuaranteed === "true"
      const chumBadges = card.querySelectorAll(".chum-badge")

      chumBadges.forEach((cb) => {
        const validBaitsStr = cb.dataset.guaranteedBaits || ""
        const badgeEl = cb.querySelector(".chum-guaranteed-badge")
        if (!badgeEl) return

        // Si el cebo activo es un cebo garantizado (Fish Flake, etc.), ocultar badge de chum
        if (isGuaranteedBait || !validBaitsStr) {
          badgeEl.classList.add("hidden")
          badgeEl.classList.remove("inline-block")
          return
        }

        const validBaits = validBaitsStr.split(",")
        if (validBaits.includes(activeBaitName)) {
          badgeEl.classList.remove("hidden")
          badgeEl.classList.add("inline-block")
        } else {
          badgeEl.classList.add("hidden")
          badgeEl.classList.remove("inline-block")
        }
      })
    }

    // Sincroniza la disponibilidad de Chum según el cebo activo (si es garantizado, bloquea y deselecciona Chum)
    function syncChumAvailability(card) {
      if (!card) return
      const activeBait = card.querySelector(".bait-badge.active")
      const isGuaranteed = activeBait && activeBait.dataset.isGuaranteed === "true"
      const chumBadges = card.querySelectorAll(".chum-badge")
      const chumSection = card.querySelector(".chum-section")

      if (isGuaranteed) {
        // Deseleccionar cualquier chum activo y deshabilitar interacción
        chumBadges.forEach((cb) => {
          cb.classList.remove(
            "active",
            "bg-cyan-500/20",
            "border-cyan-400",
            "text-cyan-300",
            "ring-1",
            "ring-cyan-400/50",
            "bg-white/[0.06]",
            "border-white/25",
            "text-white",
            "shadow-sm"
          )
          cb.classList.add(
            "opacity-35",
            "pointer-events-none",
            "cursor-not-allowed",
            "grayscale",
            "border-white/[0.03]"
          )
          const check = cb.querySelector(".chum-check")
          if (check) check.classList.add("hidden")
        })
        if (chumSection) {
          chumSection.classList.add("opacity-50")
        }
      } else {
        // Habilitar badges de chum
        chumBadges.forEach((cb) => {
          cb.classList.remove(
            "opacity-35",
            "pointer-events-none",
            "cursor-not-allowed",
            "grayscale",
            "border-white/[0.03]"
          )
          if (!cb.classList.contains("active")) {
            cb.classList.add("bg-[#0e0e11]", "border-white/5", "text-white/70")
          }
        })
        if (chumSection) {
          chumSection.classList.remove("opacity-50")
        }
      }

      updateChumGuaranteedBadges(card)
    }

    // Helper para activar un cebo específico en una tarjeta
    function activateBaitBadge(card, targetBadge) {
      const baitBadges = Array.from(card.querySelectorAll(".bait-badge"))
      baitBadges.forEach((b) => {
        b.classList.remove(
          "active",
          "bg-emerald-500/20",
          "border-emerald-400",
          "text-emerald-300",
          "bg-cyan-500/20",
          "border-cyan-400",
          "text-cyan-300",
          "ring-1",
          "ring-emerald-400/50",
          "ring-cyan-400/50",
          "bg-white/[0.06]",
          "border-white/25",
          "border-emerald-400/40",
          "text-emerald-200",
          "text-white",
          "shadow-sm"
        )
        b.classList.add("bg-[#0e0e11]", "border-white/5", "text-white/70")
      })
      if (targetBadge) {
        const isFree = targetBadge.dataset.isFree === "true"
        targetBadge.classList.remove("bg-[#0e0e11]", "border-white/5", "text-white/70", "bg-white/[0.03]")
        if (isFree) {
          targetBadge.classList.add(
            "active",
            "bg-white/[0.06]",
            "border-emerald-400/40",
            "text-emerald-200",
            "shadow-sm"
          )
        } else {
          targetBadge.classList.add(
            "active",
            "bg-white/[0.06]",
            "border-white/25",
            "text-white",
            "shadow-sm"
          )
        }
      }
    }

    // Helper para activar un chum específico (o ninguno si targetBadge es null)
    function activateChumBadge(card, targetBadge) {
      const chumBadges = Array.from(card.querySelectorAll(".chum-badge"))
      chumBadges.forEach((b) => {
        b.classList.remove(
          "active",
          "bg-cyan-500/20",
          "border-cyan-400",
          "text-cyan-300",
          "ring-1",
          "ring-cyan-400/50",
          "bg-white/[0.06]",
          "border-white/25",
          "text-white",
          "shadow-sm"
        )
        b.classList.add("bg-[#0e0e11]", "border-white/5", "text-white/70")
        const check = b.querySelector(".chum-check")
        if (check) check.classList.add("hidden")
      })
      if (targetBadge) {
        targetBadge.classList.add(
          "active",
          "bg-white/[0.06]",
          "border-white/25",
          "text-white",
          "shadow-sm"
        )
        targetBadge.classList.remove("bg-[#0e0e11]", "border-white/5", "text-white/70", "bg-white/[0.03]")
        const check = targetBadge.querySelector(".chum-check")
        if (check) check.classList.remove("hidden")
      }
    }

    // Selecciona por defecto la opción 100% garantizada más económica (o la base más barata si no tiene garantía)
    function selectOptimalCardSetup(card) {
      if (!card) return

      // Prioridad 0: Si el usuario ya configuró y guardó una combinación personalizada para este pez
      const rawName = card.dataset.rawName || card.dataset.name
      if (window.SflUserState && typeof window.SflUserState.getFishCombo === "function" && rawName) {
        const savedCombo = window.SflUserState.getFishCombo(rawName) || window.SflUserState.getFishCombo(card.dataset.name)
        if (savedCombo) {
          if (card.dataset.kind === "trap") {
            if (savedCombo.chum) {
              const targetChum = card.querySelector(`.chum-badge[data-chum-name="${savedCombo.chum}"]`)
              if (targetChum) activateChumBadge(card, targetChum)
            } else {
              activateChumBadge(card, null)
            }
            return
          } else if (savedCombo.bait) {
            const targetBait = card.querySelector(`.bait-badge[data-bait-name="${savedCombo.bait}"]`)
            if (targetBait) activateBaitBadge(card, targetBait)
            if (savedCombo.chum) {
              const targetChum = card.querySelector(`.chum-badge[data-chum-name="${savedCombo.chum}"]`)
              if (targetChum) activateChumBadge(card, targetChum)
            } else {
              activateChumBadge(card, null)
            }
            syncChumAvailability(card)
            return
          }
        }
      }

      if (card.dataset.kind === "marvel") {
        selectCheapestBait(card)
        const globalChum = document.getElementById("globalChumToggle")
        if (globalChum && globalChum.checked) {
          selectCheapestChum(card)
        }
        return
      }

      if (card.dataset.kind === "trap") {
        selectCheapestChum(card)
        return
      }

      if (card.dataset.kind !== "rod") return

      const baitBadges = Array.from(card.querySelectorAll(".bait-badge"))
      const chumBadges = Array.from(card.querySelectorAll(".chum-badge"))
      const guaranteedOptions = []

      // 1. Opciones 100% de Cebo Especializado del Fish Market (solo reservado a los 3 apex sharks de ratio superbajo)
      const cardName = card.dataset.name || ""
      const isApexShark = ["white shark", "saw shark", "whale shark"].includes(cardName)

      if (isApexShark) {
        baitBadges.forEach((bb) => {
          if (bb.dataset.isGuaranteed === "true") {
            const bName = bb.dataset.baitName
            const bPrice = getBaitUnitPrice(bName)
            guaranteedOptions.push({
              type: "specialized_bait",
              baitBadge: bb,
              chumBadge: null,
              cost: rodCost + bPrice,
            })
          }
        })
      }

      // 2. Opciones 100% de Combinación Cebo + Chum
      chumBadges.forEach((cb) => {
        const validBaitsStr = cb.dataset.guaranteedBaits || ""
        if (validBaitsStr) {
          const validBaits = validBaitsStr.split(",")
          let bestBait = null
          let lowestBaitPrice = Infinity

          baitBadges.forEach((bb) => {
            const bName = bb.dataset.baitName
            if (validBaits.includes(bName)) {
              const isFree = bb.dataset.isFree === "true"
              const bPrice = isFree ? 0 : getBaitUnitPrice(bName)
              if (bPrice < lowestBaitPrice) {
                lowestBaitPrice = bPrice
                bestBait = bb
              }
            }
          })

          if (bestBait) {
            const chumName = cb.dataset.chumName
            const chumAmount = parseFloat(cb.dataset.chumAmount) || 1
            const chumPrice = getChumUnitPrice(chumName) * chumAmount
            guaranteedOptions.push({
              type: "chum_combo",
              baitBadge: bestBait,
              chumBadge: cb,
              cost: rodCost + lowestBaitPrice + chumPrice,
            })
          }
        }
      })

      // 3. Evaluar y aplicar la mejor opción
      if (guaranteedOptions.length > 0) {
        guaranteedOptions.sort((a, b) => a.cost - b.cost)
        const best = guaranteedOptions[0]
        activateBaitBadge(card, best.baitBadge)
        activateChumBadge(card, best.chumBadge)
        syncChumAvailability(card)
      } else {
        selectCheapestBait(card)
        const globalChum = document.getElementById("globalChumToggle")
        if (globalChum && globalChum.checked) {
          selectCheapestChum(card)
        }
      }
    }

    // Inicializar estado óptimo para todas las tarjetas
    cards.forEach((card) => {
      selectOptimalCardSetup(card)
      updateCardCost(card)
    })

    // Seleccionar automáticamente el cebo más económico por tarjeta (rod y marvel)
    function selectCheapestBait(card) {
      if (!card || (card.dataset.kind !== "rod" && card.dataset.kind !== "marvel")) return

      const badges = Array.from(card.querySelectorAll(".bait-badge"))
      if (badges.length === 0) return

      let cheapestBadge = null
      let lowestCost = Infinity

      badges.forEach((badge) => {
        const baitName = badge.dataset.baitName
        const isFree = badge.dataset.isFree === "true"
        const cost = isFree ? 0 : getBaitUnitPrice(baitName)

        if (cost < lowestCost) {
          lowestCost = cost
          cheapestBadge = badge
        }
      })

      if (!cheapestBadge && badges.length > 0) {
        cheapestBadge = badges[0]
      }

      badges.forEach((b) => {
        b.classList.remove(
          "active",
          "bg-emerald-500/20",
          "border-emerald-400",
          "text-emerald-300",
          "bg-cyan-500/20",
          "border-cyan-400",
          "text-cyan-300",
          "ring-1",
          "ring-emerald-400/50",
          "ring-cyan-400/50",
          "bg-white/[0.06]",
          "border-white/25",
          "border-emerald-400/40",
          "text-emerald-200",
          "text-white",
          "shadow-sm"
        )
        b.classList.add("bg-[#0e0e11]", "border-white/5", "text-white/70")
      })

      if (cheapestBadge) {
        const isFree = cheapestBadge.dataset.isFree === "true"
        cheapestBadge.classList.remove("bg-[#0e0e11]", "border-white/5", "text-white/70", "bg-white/[0.03]")
        if (isFree) {
          cheapestBadge.classList.add(
            "active",
            "bg-white/[0.06]",
            "border-emerald-400/40",
            "text-emerald-200",
            "shadow-sm"
          )
        } else {
          cheapestBadge.classList.add(
            "active",
            "bg-white/[0.06]",
            "border-white/25",
            "text-white",
            "shadow-sm"
          )
        }
      }

      syncChumAvailability(card)
    }

    // Seleccionar automáticamente el Chum más económico por tarjeta (rod, trap y marvel)
    function selectCheapestChum(card) {
      if (!card) return

      // Si el cebo activo es garantizado, sincronizar disponibilidad y abortar
      const activeBait = card.querySelector(".bait-badge.active")
      if (activeBait && activeBait.dataset.isGuaranteed === "true") {
        syncChumAvailability(card)
        return
      }

      const badges = Array.from(card.querySelectorAll(".chum-badge"))
      if (badges.length === 0) return

      let cheapestBadge = null
      let lowestCost = Infinity

      badges.forEach((badge) => {
        const chumName = badge.dataset.chumName
        const amount = parseFloat(badge.dataset.chumAmount) || 1
        const unitPrice = getChumUnitPrice(chumName)
        const totalCost = unitPrice * amount

        if (totalCost < lowestCost) {
          lowestCost = totalCost
          cheapestBadge = badge
        }
      })

      // Fallback al primer badge si todos dieron 0 o no se encontró
      if (!cheapestBadge && badges.length > 0) {
        cheapestBadge = badges[0]
      }

      badges.forEach((b) => {
        b.classList.remove(
          "active",
          "bg-cyan-500/20",
          "border-cyan-400",
          "text-cyan-300",
          "ring-1",
          "ring-cyan-400/50",
          "bg-white/[0.06]",
          "border-white/25",
          "text-white",
          "shadow-sm"
        )
        b.classList.add("bg-[#0e0e11]", "border-white/5", "text-white/70")
        const check = b.querySelector(".chum-check")
        if (check) check.classList.add("hidden")
      })

      if (cheapestBadge) {
        cheapestBadge.classList.add(
          "active",
          "bg-white/[0.06]",
          "border-white/25",
          "text-white",
          "shadow-sm"
        )
        cheapestBadge.classList.remove("bg-[#0e0e11]", "border-white/5", "text-white/70", "bg-white/[0.03]")
        const check = cheapestBadge.querySelector(".chum-check")
        if (check) check.classList.remove("hidden")
      }
    }

    // Toggle Global de Chum
    const globalChumToggle = document.getElementById("globalChumToggle")
    if (globalChumToggle) {
      globalChumToggle.checked = true
      globalChumToggle.addEventListener("change", (e) => {
        const enableAll = e.target.checked
        cards.forEach((card) => {
          const activeBait = card.querySelector(".bait-badge.active")
          if (activeBait && activeBait.dataset.isGuaranteed === "true") {
            syncChumAvailability(card)
            updateCardCost(card)
            return
          }

          const badges = card.querySelectorAll(".chum-badge")
          if (enableAll) {
            selectCheapestChum(card)
          } else {
            badges.forEach((b) => {
              b.classList.remove(
                "active",
                "bg-cyan-500/20",
                "border-cyan-400",
                "text-cyan-300",
                "ring-1",
                "ring-cyan-400/50",
                "bg-white/[0.06]",
                "border-white/25",
                "text-white",
                "shadow-sm"
              )
              b.classList.add("bg-[#0e0e11]", "border-white/5", "text-white/70")
              const check = b.querySelector(".chum-check")
              if (check) check.classList.add("hidden")
            })
          }

          updateCardCost(card)
          persistCardCombo(card)
        })
      })
    }

    // Manejo de Modales / Popup de Captura Directa (Maravillas Marinas)
    document.querySelectorAll(".open-direct-catch-modal").forEach((btn) => {
      btn.addEventListener("click", (e) => {
        e.preventDefault()
        e.stopPropagation()
        const modalId = btn.dataset.modalId
        if (modalId) {
          const dialog = document.getElementById(modalId)
          if (dialog && typeof dialog.showModal === "function") {
            dialog.showModal()
          }
        }
      })
    })

    document.querySelectorAll(".close-direct-dialog").forEach((btn) => {
      btn.addEventListener("click", (e) => {
        e.preventDefault()
        const dialog = btn.closest("dialog")
        if (dialog) dialog.close()
      })
    })

    document.querySelectorAll("dialog.direct-catch-dialog").forEach((dialog) => {
      dialog.addEventListener("click", (e) => {
        if (e.target === dialog) {
          dialog.close()
        }
      })
    })

    // Sincronización con SflPrices y SflMarket
    function syncMarketPrices() {
      if (!window.SflPrices || !window.SflMarket) {
        updateAllCards()
        return
      }

      flowerPrice = window.SflMarket.getFlowerPrice() || 0.0854

      // 1. Costo Caña Base (resuelto directamente por el motor de recetas)
      const rodResolution = window.SflPrices.resolveCost("Rod")
      const baseRodCraft = rodResolution && rodResolution.isCraftable
        ? rodResolution.craftCostFlower
        : window.SflPrices.getUnitCost("Rod").flower || 0

      // Ancient Rod check
      hasAncientRod = Boolean(
        activeBuffs.has("Ancient Rod") ||
        activeBuffs.has("224") ||
        activeSkills["Ancient Rod"]
      )

      if (hasAncientRod) {
        rodCost = 0
      } else if (activeSkills && activeSkills["Reel Deal"]) {
        const rank = activeSkills["Reel Deal"]
        const mult = rank === 3 ? 0.4 : rank === 2 ? 0.45 : 0.5
        const stoneP = window.SflPrices.getUnitCost("Stone").flower || 0
        const woodP = (window.SflPrices.getUnitCost("Wood").flower || 0) * 3
        const coinPortion = Math.max(0, baseRodCraft - stoneP - woodP)
        rodCost = stoneP + woodP + (coinPortion * mult)
      } else {
        rodCost = baseRodCraft
      }

      // 2. Costo Crab Pot
      const crabPotResolution = window.SflPrices.resolveCost("Crab Pot")
      crabPotCost = crabPotResolution && crabPotResolution.isCraftable
        ? crabPotResolution.craftCostFlower
        : window.SflPrices.getUnitCost("Crab Pot").flower || 0

      // 3. Costo Mariner Pot
      const marinerPotResolution = window.SflPrices.resolveCost("Mariner Pot")
      marinerPotCost = marinerPotResolution && marinerPotResolution.isCraftable
        ? marinerPotResolution.craftCostFlower
        : window.SflPrices.getUnitCost("Mariner Pot").flower || 0

      // 4. Cebo de referencia (Capsule Bait)
      const capsuleBaitCost = window.SflPrices.getUnitCost("Capsule Bait").flower || 0

      baseAttemptCost = rodCost + capsuleBaitCost

      const statRod = document.getElementById("statRodCost")
      if (statRod) {
        if (hasAncientRod) {
          statRod.innerText = "0.0000 FLOWER (Ancient Rod)"
        } else if (activeSkills && activeSkills["Reel Deal"]) {
          const rank = activeSkills["Reel Deal"]
          const discountPct = rank === 3 ? 60 : rank === 2 ? 55 : 50
          statRod.innerText = `${rodCost.toFixed(4)} FLOWER (-${discountPct}% Monedas)`
        } else {
          statRod.innerText = rodCost > 0 ? `${rodCost.toFixed(4)} FLOWER` : "-- FLOWER"
        }
      }

      const statBait = document.getElementById("statBaitCost")
      if (statBait) statBait.innerText = capsuleBaitCost > 0 ? `${capsuleBaitCost.toFixed(4)} FLOWER` : "-- FLOWER"

      const statBase = document.getElementById("statBaseCost")
      if (statBase) statBase.innerText = (baseAttemptCost > 0 || hasAncientRod) ? `${baseAttemptCost.toFixed(4)} FLOWER` : "-- FLOWER"

      const statBaseUsd = document.getElementById("statBaseCostUsd")
      if (statBaseUsd) {
        statBaseUsd.innerText = (baseAttemptCost > 0 || hasAncientRod)
          ? `≈ $${(baseAttemptCost * flowerPrice).toFixed(3)} USD`
          : "--"
      }

      const statFlower = document.getElementById("statFlowerPrice")
      if (statFlower) statFlower.innerText = `$${flowerPrice.toFixed(4)}`

      // Preseleccionar automáticamente la configuración óptima (la opción 100% garantizada más barata, o la base más económica)
      cards.forEach((card) => {
        selectOptimalCardSetup(card)
      })

      updateAllCards()
    }

    // Escuchar el evento reactivo de actualización de mercado
    window.addEventListener("sfl:marketUpdated", syncMarketPrices)

    // Ejecutar sincronización inicial inmediata
    syncMarketPrices()
    updateFilters()
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initFishing)
  } else {
    initFishing()
  }
  document.addEventListener("astro:page-load", initFishing)
</script>
