    // Sincronización con SflPrices y SflMarket
    function syncMarketPrices() {
      if (!window.SflPrices || !window.SflMarket) {
        updateAllCards()
        return
      }

      flowerPrice = window.SflMarket.getFlowerPrice() || 0.0854

      // 1. Costo Caña Base (resuelto directamente por el motor de recetas)
      const rodResolution = window.SflPrices.resolveCost("Rod")
      const baseRodCraft = rodResolution && rodResolution.isCraftable
        ? rodResolution.craftCostFlower
        : window.SflPrices.getUnitCost("Rod").flower || 0

      // Ancient Rod check
      hasAncientRod = Boolean(
        activeBuffs.has("Ancient Rod") ||
        activeBuffs.has("224") ||
        activeSkills["Ancient Rod"]
      )

      if (hasAncientRod) {
        rodCost = 0
      } else if (activeSkills && activeSkills["Reel Deal"]) {
        const rank = activeSkills["Reel Deal"]
        const mult = rank === 3 ? 0.4 : rank === 2 ? 0.45 : 0.5
        const stoneP = window.SflPrices.getUnitCost("Stone").flower || 0
        const woodP = (window.SflPrices.getUnitCost("Wood").flower || 0) * 3
        const coinPortion = Math.max(0, baseRodCraft - stoneP - woodP)
        rodCost = stoneP + woodP + (coinPortion * mult)
      } else {
        rodCost = baseRodCraft
      }

      // 2. Costo Crab Pot
      const crabPotResolution = window.SflPrices.resolveCost("Crab Pot")
      crabPotCost = crabPotResolution && crabPotResolution.isCraftable
        ? crabPotResolution.craftCostFlower
        : window.SflPrices.getUnitCost("Crab Pot").flower || 0

      // 3. Costo Mariner Pot
      const marinerPotResolution = window.SflPrices.resolveCost("Mariner Pot")
      marinerPotCost = marinerPotResolution && marinerPotResolution.isCraftable
        ? marinerPotResolution.craftCostFlower
        : window.SflPrices.getUnitCost("Mariner Pot").flower || 0

      // 4. Cebo de referencia (Capsule Bait)
      const capsuleBaitCost = window.SflPrices.getUnitCost("Capsule Bait").flower || 0

      baseAttemptCost = rodCost + capsuleBaitCost

      const statRod = document.getElementById("statRodCost")
      if (statRod) {
        if (hasAncientRod) {
          statRod.innerText = "0.0000 FLOWER (Ancient Rod)"
        } else if (activeSkills && activeSkills["Reel Deal"]) {
          const rank = activeSkills["Reel Deal"]
          const discountPct = rank === 3 ? 60 : rank === 2 ? 55 : 50
          statRod.innerText = `${rodCost.toFixed(4)} FLOWER (-${discountPct}% Monedas)`
        } else {
          statRod.innerText = rodCost > 0 ? `${rodCost.toFixed(4)} FLOWER` : "-- FLOWER"
        }
      }

      const statBait = document.getElementById("statBaitCost")
      if (statBait) statBait.innerText = capsuleBaitCost > 0 ? `${capsuleBaitCost.toFixed(4)} FLOWER` : "-- FLOWER"

      const statBase = document.getElementById("statBaseCost")
      if (statBase) statBase.innerText = (baseAttemptCost > 0 || hasAncientRod) ? `${baseAttemptCost.toFixed(4)} FLOWER` : "-- FLOWER"

      const statBaseUsd = document.getElementById("statBaseCostUsd")
      if (statBaseUsd) {
        statBaseUsd.innerText = (baseAttemptCost > 0 || hasAncientRod)
          ? `≈ $${(baseAttemptCost * flowerPrice).toFixed(3)} USD`
          : "--"
      }

      const statFlower = document.getElementById("statFlowerPrice")
      if (statFlower) statFlower.innerText = `$${flowerPrice.toFixed(4)}`

      // Preseleccionar automáticamente la configuración óptima (la opción 100% garantizada más barata, o la base más económica)
      cards.forEach((card) => {
        selectOptimalCardSetup(card)
      })

      updateAllCards()
    }

    // Escuchar el evento reactivo de actualización de mercado
    window.addEventListener("sfl:marketUpdated", syncMarketPrices)

    // Si el estado de mercado ya está listo en memoria, sincronizar de inmediato
    if (window.__sflMarketState || (window.SflMarket && window.SflMarket.getState().raw)) {
      syncMarketPrices()
    }
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initFishing)
  } else {
    initFishing()
  }
  document.addEventListener("astro:page-load", initFishing)
</script>
