    // Selecciona por defecto la opción 100% garantizada más económica (o la base más barata si no tiene garantía)
    function selectOptimalCardSetup(card) {
      if (!card) return

      if (card.dataset.kind === "marvel") {
        selectCheapestBait(card)
        const globalChum = document.getElementById("globalChumToggle")
        if (globalChum && globalChum.checked) {
          selectCheapestChum(card)
        }
        return
      }

      if (card.dataset.kind === "trap") {
        selectCheapestChum(card)
        return
      }

      if (card.dataset.kind !== "rod") return

      const baitBadges = Array.from(card.querySelectorAll(".bait-badge"))
      const chumBadges = Array.from(card.querySelectorAll(".chum-badge"))
      const guaranteedOptions = []

      // 1. Opciones 100% de Cebo Especializado del Fish Market (solo reservado a los 3 apex sharks de ratio superbajo)
      const cardName = card.dataset.name || ""
      const isApexShark = ["white shark", "saw shark", "whale shark"].includes(cardName)

      if (isApexShark) {
        baitBadges.forEach((bb) => {
          if (bb.dataset.isGuaranteed === "true") {
            const bName = bb.dataset.baitName
            const bPrice = getBaitUnitPrice(bName)
            guaranteedOptions.push({
              type: "specialized_bait",
              baitBadge: bb,
              chumBadge: null,
              cost: rodCost + bPrice,
            })
          }
        })
      }

      // 2. Opciones 100% de Combinación Cebo + Chum
      chumBadges.forEach((cb) => {
        const validBaitsStr = cb.dataset.guaranteedBaits || ""
        if (validBaitsStr) {
          const validBaits = validBaitsStr.split(",")
          let bestBait = null
          let lowestBaitPrice = Infinity

          baitBadges.forEach((bb) => {
            const bName = bb.dataset.baitName
            if (validBaits.includes(bName)) {
              const isFree = bb.dataset.isFree === "true"
              const bPrice = isFree ? 0 : getBaitUnitPrice(bName)
              if (bPrice < lowestBaitPrice) {
                lowestBaitPrice = bPrice
                bestBait = bb
              }
            }
          })

          if (bestBait) {
            const chumName = cb.dataset.chumName
            const chumAmount = parseFloat(cb.dataset.chumAmount) || 1
            const chumPrice = getChumUnitPrice(chumName) * chumAmount
            guaranteedOptions.push({
              type: "chum_combo",
              baitBadge: bestBait,
              chumBadge: cb,
              cost: rodCost + lowestBaitPrice + chumPrice,
            })
          }
        }
      })

      // 3. Evaluar y aplicar la mejor opción
      if (guaranteedOptions.length > 0) {
        guaranteedOptions.sort((a, b) => a.cost - b.cost)
        const best = guaranteedOptions[0]
        activateBaitBadge(card, best.baitBadge)
        activateChumBadge(card, best.chumBadge)
        syncChumAvailability(card)
      } else {
        selectCheapestBait(card)
        const globalChum = document.getElementById("globalChumToggle")
        if (globalChum && globalChum.checked) {
          selectCheapestChum(card)
        }
      }
    }

    // Inicializar estado óptimo para todas las tarjetas
    cards.forEach((card) => {
      selectOptimalCardSetup(card)
      updateCardCost(card)
    })

    // Seleccionar automáticamente el cebo más económico por tarjeta (rod y marvel)
    function selectCheapestBait(card) {
      if (!card || (card.dataset.kind !== "rod" && card.dataset.kind !== "marvel")) return

      const badges = Array.from(card.querySelectorAll(".bait-badge"))
      if (badges.length === 0) return

      let cheapestBadge = null
      let lowestCost = Infinity

      badges.forEach((badge) => {
        const baitName = badge.dataset.baitName
        const isFree = badge.dataset.isFree === "true"
        const cost = isFree ? 0 : getBaitUnitPrice(baitName)

        if (cost < lowestCost) {
          lowestCost = cost
          cheapestBadge = badge
        }
      })

      if (!cheapestBadge && badges.length > 0) {
        cheapestBadge = badges[0]
      }

      badges.forEach((b) => {
        b.classList.remove(
          "active",
          "bg-emerald-500/20",
          "border-emerald-400",
          "text-emerald-300",
          "bg-cyan-500/20",
          "border-cyan-400",
          "text-cyan-300",
          "ring-1",
          "ring-emerald-400/50",
          "ring-cyan-400/50",
          "shadow-sm"
        )
        b.classList.add("bg-white/[0.03]", "border-white/5", "text-white/70")
      })

      if (cheapestBadge) {
        const isFree = cheapestBadge.dataset.isFree === "true"
        cheapestBadge.classList.remove("bg-white/[0.03]", "border-white/5", "text-white/70")
        if (isFree) {
          cheapestBadge.classList.add(
            "active",
            "bg-emerald-500/20",
            "border-emerald-400",
            "text-emerald-300",
            "ring-1",
            "ring-emerald-400/50",
            "shadow-sm"
          )
        } else {
          cheapestBadge.classList.add(
            "active",
            "bg-cyan-500/20",
            "border-cyan-400",
            "text-cyan-300",
            "ring-1",
            "ring-cyan-400/50",
            "shadow-sm"
          )
        }
      }

      syncChumAvailability(card)
    }

    // Seleccionar automáticamente el Chum más económico por tarjeta (rod, trap y marvel)
    function selectCheapestChum(card) {
      if (!card) return

      // Si el cebo activo es garantizado, sincronizar disponibilidad y abortar
      const activeBait = card.querySelector(".bait-badge.active")
      if (activeBait && activeBait.dataset.isGuaranteed === "true") {
        syncChumAvailability(card)
        return
      }

      const badges = Array.from(card.querySelectorAll(".chum-badge"))
      if (badges.length === 0) return

      let cheapestBadge = null
      let lowestCost = Infinity

      badges.forEach((badge) => {
        const chumName = badge.dataset.chumName
        const amount = parseFloat(badge.dataset.chumAmount) || 1
        const unitPrice = getChumUnitPrice(chumName)
        const totalCost = unitPrice * amount

        if (totalCost < lowestCost) {
          lowestCost = totalCost
          cheapestBadge = badge
        }
      })

      // Fallback al primer badge si todos dieron 0 o no se encontró
      if (!cheapestBadge && badges.length > 0) {
        cheapestBadge = badges[0]
      }

      badges.forEach((b) => {
        b.classList.remove(
          "active",
          "bg-cyan-500/20",
          "border-cyan-400",
          "text-cyan-300",
          "ring-1",
          "ring-cyan-400/50",
          "shadow-sm"
        )
        b.classList.add("bg-white/[0.03]", "border-white/5", "text-white/70")
        const check = b.querySelector(".chum-check")
        if (check) check.classList.add("hidden")
      })

      if (cheapestBadge) {
        cheapestBadge.classList.add(
          "active",
          "bg-cyan-500/20",
          "border-cyan-400",
          "text-cyan-300",
          "ring-1",
          "ring-cyan-400/50",
          "shadow-sm"
        )
        cheapestBadge.classList.remove("bg-white/[0.03]", "border-white/5", "text-white/70")
        const check = cheapestBadge.querySelector(".chum-check")
        if (check) check.classList.remove("hidden")
      }
    }

    // Toggle Global de Chum
    const globalChumToggle = document.getElementById("globalChumToggle")
    if (globalChumToggle) {
      globalChumToggle.checked = true
      globalChumToggle.addEventListener("change", (e) => {
        const enableAll = e.target.checked
        cards.forEach((card) => {
          const activeBait = card.querySelector(".bait-badge.active")
          if (activeBait && activeBait.dataset.isGuaranteed === "true") {
            syncChumAvailability(card)
            updateCardCost(card)
            return
          }

          const badges = card.querySelectorAll(".chum-badge")
          if (enableAll) {
            selectCheapestChum(card)
          } else {
            badges.forEach((b) => {
              b.classList.remove(
                "active",
                "bg-cyan-500/20",
                "border-cyan-400",
                "text-cyan-300",
                "ring-1",
                "ring-cyan-400/50",
                "shadow-sm"
              )
              b.classList.add("bg-white/[0.03]", "border-white/5", "text-white/70")
              const check = b.querySelector(".chum-check")
              if (check) check.classList.add("hidden")
            })
          }

          updateCardCost(card)
        })
      })
