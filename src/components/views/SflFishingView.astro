          })

          if (!isAlreadyActive) {
            badge.classList.add(
              "active",
              "bg-cyan-500/20",
              "border-cyan-400",
              "text-cyan-300",
              "ring-1",
              "ring-cyan-400/50",
              "shadow-sm"
            )
            badge.classList.remove("bg-white/[0.03]", "border-white/5", "text-white/70")
            const check = badge.querySelector(".chum-check")
            if (check) check.classList.remove("hidden")
          }

          updateCardCost(card)
        })
      })
    })

    // Actualiza dinámicamente los badges 100% de los Chums según el cebo actualmente seleccionado
    function updateChumGuaranteedBadges(card) {
      if (!card) return
      const activeBait = card.querySelector(".bait-badge.active")
      const activeBaitName = activeBait ? activeBait.dataset.baitName : ""
      const isGuaranteedBait = activeBait && activeBait.dataset.isGuaranteed === "true"
      const chumBadges = card.querySelectorAll(".chum-badge")

      chumBadges.forEach((cb) => {
        const validBaitsStr = cb.dataset.guaranteedBaits || ""
        const badgeEl = cb.querySelector(".chum-guaranteed-badge")
        if (!badgeEl) return

        // Si el cebo activo es un cebo garantizado (Fish Flake, etc.), ocultar badge de chum
        if (isGuaranteedBait || !validBaitsStr) {
          badgeEl.classList.add("hidden")
          badgeEl.classList.remove("inline-block")
          return
        }

        const validBaits = validBaitsStr.split(",")
        if (validBaits.includes(activeBaitName)) {
          badgeEl.classList.remove("hidden")
          badgeEl.classList.add("inline-block")
        } else {
          badgeEl.classList.add("hidden")
          badgeEl.classList.remove("inline-block")
        }
      })
    }

    // Sincroniza la disponibilidad de Chum según el cebo activo (si es garantizado, bloquea y deselecciona Chum)
    function syncChumAvailability(card) {
      if (!card) return
      const activeBait = card.querySelector(".bait-badge.active")
      const isGuaranteed = activeBait && activeBait.dataset.isGuaranteed === "true"
      const chumBadges = card.querySelectorAll(".chum-badge")
      const chumSection = card.querySelector(".chum-section")

      if (isGuaranteed) {
        // Deseleccionar cualquier chum activo y deshabilitar interacción
        chumBadges.forEach((cb) => {
          cb.classList.remove(
            "active",
            "bg-cyan-500/20",
            "border-cyan-400",
            "text-cyan-300",
            "ring-1",
            "ring-cyan-400/50",
            "shadow-sm"
          )
          cb.classList.add(
            "opacity-35",
            "pointer-events-none",
            "cursor-not-allowed",
            "grayscale",
            "border-white/[0.03]"
          )
          const check = cb.querySelector(".chum-check")
          if (check) check.classList.add("hidden")
        })
        if (chumSection) {
          chumSection.classList.add("opacity-50")
        }
      } else {
        // Habilitar badges de chum
        chumBadges.forEach((cb) => {
          cb.classList.remove(
            "opacity-35",
            "pointer-events-none",
            "cursor-not-allowed",
            "grayscale",
            "border-white/[0.03]"
          )
          if (!cb.classList.contains("active")) {
            cb.classList.add("bg-white/[0.03]", "border-white/5", "text-white/70")
          }
        })
        if (chumSection) {
          chumSection.classList.remove("opacity-50")
        }
      }

      updateChumGuaranteedBadges(card)
    }

