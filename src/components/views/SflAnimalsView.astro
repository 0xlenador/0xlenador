                      </div>

                      <!-- Columna 2: Afecto (Desktop con solapamiento del 40%) -->
                      <div class="hidden lg:flex px-3 items-center gap-2.5">
                        {
                          lvl.affectionTools && lvl.affectionTools.length > 0 ? (
                            <>
                              <!-- Stack de iconos de afecto solapados un 40% a la derecha -->
                              <div class="flex items-center -space-x-1.5 shrink-0 relative">
                                {lvl.affectionTools.map((tool, tIdx) => (
                                  <img
                                    src={tool.image}
                                    alt={tool.name}
                                    title={`${tool.name}: ${tool.percent}%`}
                                    class="w-4.5 h-4.5 object-contain rounded-full bg-black/60 border border-white/10 p-0.5 shadow-md transition-transform hover:scale-125 hover:z-20 relative cursor-help"
