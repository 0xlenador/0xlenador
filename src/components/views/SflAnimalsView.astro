                            />
                            <span>{lvl.food.costFlower.toFixed(4)}</span>
                          </div>
                          <span class="text-[9px] font-mono text-white/50 leading-tight">
                            ${lvl.food.costUsd.toFixed(4)} USD
                          </span>
