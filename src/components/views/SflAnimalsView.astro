---
// ============================================================
// src/components/views/SflAnimalsView.astro
// Vista pura para la herramienta de animales de Sunflower Land.
// Fuente única de verdad consumida por /sfl-animales/ y /en/sfl-animals/.
// El idioma se detecta dinámicamente desde la URL vía getLangFromUrl.
// ============================================================
import { getEntry } from "astro:content"
import { getLangFromUrl, useTranslations } from "../../i18n/utils"
import SflToolLayout from "../SflToolLayout.astro"
import FaqAccordion from "../FaqAccordion.astro"
import fs from "node:fs"
import path from "node:path"

import animalsDataRaw from "../../content/data/sfl/animals/animals.json"
import buildingsDataRaw from "../../content/data/sfl/animals/buildings.json"
import consumablesDataRaw from "../../content/data/sfl/animals/consumables.json"
import sflResourcesJson from "../../content/data/sfl/resources.json"

// Lectura de precios P2P en FLOWER y USD desde sfl_data.json
const marketPrices: Record<string, number> = {}
let flowerUsd = 0.1388

try {
  const sflDataPath = path.resolve(process.cwd(), "public/api/sfl_data.json")
  if (fs.existsSync(sflDataPath)) {
    const sflData = JSON.parse(fs.readFileSync(sflDataPath, "utf8"))
    flowerUsd = Number(sflData.flowerPrice) || 0.1388
    if (sflData.items) {
      Object.values(sflData.items).forEach((item: any) => {
        const colMatch = item.key?.match(/collectibles-(\d+)$/)
        if (colMatch && (sflResourcesJson as any)[colMatch[1]]) {
          marketPrices[(sflResourcesJson as any)[colMatch[1]]] = item.currentPrice || 0
        }
      })
    }
  }
} catch (e) {
  console.error("Error leyendo sfl_data.json en build:", e)
}

const sflPowerUpsEntry = await getEntry("sfl", "powerups")
const sflSkillsEntry = await getEntry("sfl", "skills")

const sflPowerUpsData = sflPowerUpsEntry?.data?.power_ups || { collectibles: {}, wearables: {} }
const sflAnimalsSkills = sflSkillsEntry?.data?.Animals || {}

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)

// ---------------------------------------------------------------------------
// Filtrado de PowerUps de Animales (Collectibles y Wearables)
// ---------------------------------------------------------------------------
interface AnimalBuffItem {
  id: string
  name: string
  boost: string
  category: "collectibles" | "wearables"
  isWearable: boolean
  image: string
  effectType: string
}

const getEffectType = (desc: string) => {
  if (!desc) return "other"
  const d = desc.toLowerCase()
  const effects: string[] = []
  if (
    d.includes("yield") ||
    d.includes("produce") ||
    d.includes("egg") ||
    d.includes("milk") ||
    d.includes("wool") ||
    d.includes("feather") ||
    d.includes("leather") ||
    d.includes("merino") ||
    d.includes("truffle") ||
    d.includes("mud")
  ) {
    effects.push("drops")
  }
  if (d.includes("sleep") || d.includes("time") || d.includes("wake") || d.includes("speed")) {
    effects.push("time")
  }
  if (
    d.includes("feed") ||
    d.includes("cost") ||
    d.includes("free") ||
    d.includes("grain") ||
    d.includes("slop") ||
    d.includes("xp")
  ) {
    effects.push("feed")
  }
  return effects.length > 0 ? effects.join(" ") : "other"
}

const isAnimalBuff = (name: string, boost: string) => {
  const n = (name || "").toLowerCase()
  const b = (boost || "").toLowerCase()
  const full = `${n} ${b}`

  if (
    n.includes("eggplant") ||
    b.includes("eggplant") ||
    n.includes("banana") ||
    n.includes("oil") ||
    n.includes("paw aura") ||
    n.includes("victoria's apron")
  ) {
    return false
  }

  return (
    full.includes("animal") ||
    full.includes("chicken") ||
    full.includes("sheep") ||
    full.includes("cow") ||
    full.includes("pig") ||
    full.includes("egg") ||
    full.includes("wool") ||
    full.includes("milk") ||
    full.includes("feather") ||
    full.includes("leather") ||
    full.includes("merino") ||
    full.includes("mud") ||
    full.includes("truffle") ||
    full.includes("barn") ||
    full.includes("hen house") ||
    full.includes("bale")
  )
}

const animalBuffs: AnimalBuffItem[] = []

for (const cat of ["collectibles", "wearables"] as const) {
  const group = sflPowerUpsData[cat] || {}
  for (const [id, item] of Object.entries(group) as [string, any][]) {
    if (isAnimalBuff(item.name, item.boost)) {
      animalBuffs.push({
        id,
        name: item.name,
        boost: item.boost,
        category: cat,
        isWearable: cat === "wearables",
        image: item.image,
        effectType: getEffectType(item.boost),
      })
    }
  }
}

// ---------------------------------------------------------------------------
// Orden estricto solicitado: Pollos (chicken), Ovejas (sheep), Vacas (cow), Cerdos (pig)
// ---------------------------------------------------------------------------
const orderedAnimalIds = ["chicken", "sheep", "cow", "pig"] as const

interface AffectionToolItem {
  id: string
  name: string
  xp: number
  percent: number
  image: string
}

interface AnimalLevelDisplay {
  fromLevel: number
  toLevel: number
  xpRequired: number
  sleepHours: number
  isInstant: boolean
  residualXp: number
  residualGenerated: number
  affectionTools: AffectionToolItem[]
  affectionXp: number
  food: {
    name: string
    image: string
    ingredient: string
    units: number
    xp: number
    costFlower: number
    costUsd: number
    isFav: boolean
  }
  totalXpObtained: number
  totalFoodXp: number
  totalAvailable: number
  resources: Array<{
    name: string
    amount: number
    image: string
  }>
  revenueFlower: number
  revenueUsd: number
  profitFlower: number
  profitUsd: number
}

// Probabilidades oficiales de Love Requests por nivel (imagen del usuario)
const LOVE_REQUESTS: Record<number, { petting: number; brush: number; music: number }> = {
  0: { petting: 0, brush: 0, music: 0 },
  1: { petting: 1.0, brush: 0, music: 0 },
  2: { petting: 0.8, brush: 0.2, music: 0 },
  3: { petting: 0.7, brush: 0.3, music: 0 },
  4: { petting: 0.6, brush: 0.3, music: 0.1 },
  5: { petting: 0.5, brush: 0.4, music: 0.1 },
  6: { petting: 0.5, brush: 0.3, music: 0.2 },
  7: { petting: 0.4, brush: 0.4, music: 0.2 },
  8: { petting: 0.4, brush: 0.3, music: 0.3 },
  9: { petting: 0.3, brush: 0.4, music: 0.3 },
  10: { petting: 0.3, brush: 0.3, music: 0.4 },
  11: { petting: 0.2, brush: 0.4, music: 0.4 },
  12: { petting: 0.2, brush: 0.3, music: 0.5 },
  13: { petting: 0.1, brush: 0.4, music: 0.5 },
  14: { petting: 0.1, brush: 0.3, music: 0.6 },
  15: { petting: 0.1, brush: 0.2, music: 0.7 },
}

// Obtiene el alimento favorito oficial y más eficiente de cada tier y animal
function getFavoriteFoodForLevel(animalId: string, toLevel: number) {
  if (animalId === "pig") {
    let slopId = "basic_slop"
    if (toLevel >= 3 && toLevel <= 5) slopId = "hearty_slop"
    else if (toLevel >= 6 && toLevel <= 9) slopId = "rich_slop"
    else if (toLevel >= 10) slopId = "gourmet_slop"

    const consumable = (consumablesDataRaw as any)[slopId]
    const options = consumable?.options || []

    let cheapestOpt = options[0] || { name: "Potato", amount: 150, image: "/img/sunflowerland/Potato.png" }
    let minCostFlower = Infinity

    for (const opt of options) {
      const price = marketPrices[opt.name] ?? 0
      if (price > 0) {
        const total = price * opt.amount
        if (total < minCostFlower) {
          minCostFlower = total
          cheapestOpt = opt
        }
      }
    }

    if (minCostFlower === Infinity) {
      minCostFlower = 0.0346
    }

    return {
      name: consumable?.name || "Slop",
      image: cheapestOpt.image || "/img/sunflowerland/Potato.png",
      ingredient: `${cheapestOpt.amount}x ${cheapestOpt.name}`,
      xp: consumable?.xp || 100,
      costFlower: minCostFlower,
      costUsd: minCostFlower * flowerUsd,
      isFav: true,
    }
  }

  // Para chicken, cow y sheep:
  // Tiers oficiales de alimento favorito:
  // Niveles 1-3: Kernel Blend (1x Corn, 60 XP)
  // Niveles 4-6: Hay (1x Wheat, 60 XP)
  // Niveles 7-10: NutriBarley (1x Barley, 60 XP)
  // Niveles 11-15: Mixed Grain (1x Corn, 1x Wheat, 1x Barley, 80 XP)
  if (toLevel <= 3) {
    const cost = marketPrices["Corn"] || 0.02
    return {
      name: "Kernel Blend",
      image: "/img/sunflowerland/Corn.png",
      ingredient: "1x Corn",
      xp: 60,
      costFlower: cost,
      costUsd: cost * flowerUsd,
      isFav: true,
    }
  } else if (toLevel <= 6) {
    const cost = marketPrices["Wheat"] || 0.01598
    return {
      name: "Hay",
      image: "/img/sunflowerland/Wheat.png",
      ingredient: "1x Wheat",
      xp: 60,
      costFlower: cost,
      costUsd: cost * flowerUsd,
      isFav: true,
    }
  } else if (toLevel <= 10) {
    const cost = marketPrices["Barley"] || 0.02285
    return {
      name: "NutriBarley",
      image: "/img/sunflowerland/Barley.png",
      ingredient: "1x Barley",
      xp: 60,
      costFlower: cost,
      costUsd: cost * flowerUsd,
      isFav: true,
    }
  } else {
    const cornCost = marketPrices["Corn"] || 0.02
    const wheatCost = marketPrices["Wheat"] || 0.01598
    const barleyCost = marketPrices["Barley"] || 0.02285
    const cost = cornCost + wheatCost + barleyCost
    return {
      name: "Mixed Grain",
      image: "/img/sunflowerland/Corn.png",
      ingredient: "1x Corn, 1x Wheat, 1x Barley",
      xp: 80,
      costFlower: cost,
      costUsd: cost * flowerUsd,
      isFav: true,
    }
  }
}

const formatProfitFlower = (val: number) => {
  const sign = val >= 0 ? "+" : ""
  return `${sign}${val.toFixed(4)} FL`
}

const formatProfitUsd = (val: number) => {
  const sign = val >= 0 ? "+" : "-"
  return `${sign}$${Math.abs(val).toFixed(4)}`
}

const resLabel = "res"
const affecLabel = lang === "en" ? "affec" : "afec"
const foodLabel = lang === "en" ? "food" : "comida"
const surplusLabel = t("sfl.animals.table.surplus")

interface AnimalMetaDisplay {
  id: (typeof orderedAnimalIds)[number]
  name: string
  tabLabel: string
  icon: string
  buildingName: string
  buildingIcon: string
  costCoins: number
  sleepHours: number
  primaryDrop: {
    name: string
    image: string
  }
  secondaryDrop?: {
    name: string
    image: string
    unlockLevel: number
  }
  careTools: Array<{ id: string; name: string; xp: number; image: string }>
  acceptedFoods: Array<{ name: string; image: string; xp?: number }>
  levels: AnimalLevelDisplay[]
}

const animalsDisplayList: AnimalMetaDisplay[] = orderedAnimalIds.map((animalId) => {
  const rawAnimal = (animalsDataRaw as any)[animalId]
  const rawBuilding = (buildingsDataRaw as any)[rawAnimal.buildingId]

  // Mapeo de alimentos con imágenes y XP de consumablesDataRaw
  const foods = rawAnimal.acceptedFoods.map((foodId: string) => {
    const consumable = (consumablesDataRaw as any)[foodId]
    if (consumable) {
      const firstIngImg = consumable.craftingIngredients?.[0]?.image || consumable.image || "/img/sunflowerland/Wheat.png"
      return {
        name: consumable.name,
        image: consumable.image || firstIngImg,
        xp: consumable.xp,
      }
    }
    return {
      name: foodId.replace(/_/g, " "),
      image: `/img/sunflowerland/${foodId.charAt(0).toUpperCase() + foodId.slice(1)}.png`,
      xp: undefined,
    }
  })

  // Alimento predeterminado para el cálculo del ciclo base (Kernel Blend = 60 XP)
  const defaultFood = foods[0] || { name: "Kernel Blend", image: "/img/sunflowerland/Corn.png", xp: 60 }
  const cycleFoodXp = defaultFood.xp || 60

  let currentCarryover = 0

  // Generación de progresión de 15 saltos de nivel con cálculo de residual
  const levels: AnimalLevelDisplay[] = rawAnimal.levels.map((lvlObj: any) => {
    const toLvl = lvlObj.level
    const fromLvl = toLvl - 1
    const xpReq = lvlObj.xpRequired
    const isFirstLevel = fromLvl === 0

    // En 0 > 1 el residual recibido es siempre 0 (es el inicio)
    // En niveles posteriores, recibe el remanente del nivel anterior
    const receivedResidual = isFirstLevel ? 0 : currentCarryover

    // En 0 > 1 es instantáneo y no hay afecto
    const isInstant = isFirstLevel
    const sleepHours = isInstant ? 0 : rawAnimal.sleepDurationHours

    // Probabilidades oficiales de Love Requests para este nivel de origen
    const loveProb = LOVE_REQUESTS[fromLvl] || { petting: 0, brush: 0, music: 0 }
    const affectionTools: AffectionToolItem[] = []

    if (!isInstant) {
      if (loveProb.petting > 0) {
        affectionTools.push({
          id: "petting_hand",
          name: "Petting Hand",
          xp: 10,
          percent: Math.round(loveProb.petting * 100),
          image: "/img/sunflowerland/tools/Petting Hand.webp",
        })
      }
      if (loveProb.brush > 0) {
        affectionTools.push({
          id: "brush",
          name: "Brush",
          xp: 20,
          percent: Math.round(loveProb.brush * 100),
          image: "/img/sunflowerland/tools/Brush.webp",
        })
      }
      if (loveProb.music > 0) {
        affectionTools.push({
          id: "music_box",
          name: "Music Box",
          xp: 40,
          percent: Math.round(loveProb.music * 100),
          image: "/img/sunflowerland/tools/Music Box.webp",
        })
      }
    }

    // Afecto diario: son 2 caricias al día con valor esperado según probabilidades
    const singleAffectionXp = (loveProb.petting * 10) + (loveProb.brush * 20) + (loveProb.music * 40)
    const affectionXp = isInstant ? 0 : Math.round(singleAffectionXp * 2)

    // Alimento favorito oficial para este nivel
    const favFood = getFavoriteFoodForLevel(animalId, toLvl)
    const unitFoodXp = favFood.xp

    // XP que falta cubrir con alimento tras descontar el residual previo y el afecto
    const neededFromFood = Math.max(0, xpReq - receivedResidual - affectionXp)

    // Unidades de alimento necesarias para que el animal alcance o supere el umbral del nivel
    const foodUnits = Math.max(1, Math.ceil(neededFromFood / unitFoodXp))

    // Costo total de las raciones completas compradas para este nivel
    const foodCostFlower = foodUnits * favFood.costFlower
    const foodCostUsd = foodUnits * favFood.costUsd

    // XP total de comida suministrada y XP total obtenida en el ciclo
    const totalFoodXp = foodUnits * unitFoodXp
    const totalXpObtained = affectionXp + totalFoodXp

    // Total acumulado disponible y remanente residual que pasa al siguiente nivel
    const totalAvailable = receivedResidual + totalXpObtained
    const residualGenerated = Math.max(0, totalAvailable - xpReq)
    currentCarryover = residualGenerated

    // Recursos obtenidos en el nivel
    let primaryAmount = 1
    if (toLvl >= 6 && toLvl <= 10) primaryAmount = 2
    if (toLvl >= 11) primaryAmount = 3

    const secUnlock = rawAnimal.drops.secondary?.unlockLevel || 99
    const secondaryAmount = toLvl >= secUnlock ? 1 : 0

    const resources: AnimalLevelDisplay["resources"] = [
      {
        name: rawAnimal.drops.primary.name,
        amount: primaryAmount,
        image: rawAnimal.drops.primary.image,
      },
    ]

    if (secondaryAmount > 0 && rawAnimal.drops.secondary) {
      resources.push({
        name: rawAnimal.drops.secondary.name,
        amount: secondaryAmount,
        image: rawAnimal.drops.secondary.image,
      })
    }

    // Ingresos brutos por venta de recursos en FLOWER y USD
    const primaryUnitPrice = marketPrices[rawAnimal.drops.primary.name] || 0
    const secondaryUnitPrice = rawAnimal.drops.secondary
      ? (marketPrices[rawAnimal.drops.secondary.name] || 0)
      : 0
    const revenueFlower = (primaryAmount * primaryUnitPrice) + (secondaryAmount * secondaryUnitPrice)
    const revenueUsd = revenueFlower * flowerUsd

    // Profit neto exclusivo en FLOWER y USD imputando exactamente el costo de alimento consumido
    const profitFlower = revenueFlower - foodCostFlower
    const profitUsd = profitFlower * flowerUsd

    return {
      fromLevel: fromLvl,
      toLevel: toLvl,
      xpRequired: xpReq,
      sleepHours,
      isInstant,
      residualXp: receivedResidual,
      residualGenerated,
      affectionTools,
      affectionXp,
      food: {
        name: favFood.name,
        image: favFood.image,
        ingredient: favFood.ingredient,
        units: foodUnits,
        xp: unitFoodXp,
        costFlower: foodCostFlower,
        costUsd: foodCostUsd,
        isFav: favFood.isFav,
      },
      totalXpObtained,
      totalFoodXp,
      totalAvailable,
      resources,
      revenueFlower,
      revenueUsd,
      profitFlower,
      profitUsd,
    }
  })

  const tabLabels: Record<string, string> = {
    chicken: t("sfl.animals.tabs.chickens"),
    sheep: t("sfl.animals.tabs.sheep"),
    cow: t("sfl.animals.tabs.cows"),
    pig: t("sfl.animals.tabs.pigs"),
  }

  return {
    id: animalId,
    name: rawAnimal.name,
    tabLabel: tabLabels[animalId] || rawAnimal.name,
    icon: rawAnimal.icon,
    buildingName: rawBuilding?.name || rawAnimal.buildingId,
    buildingIcon: rawBuilding?.icon || rawAnimal.icon,
    costCoins: rawAnimal.purchaseCost.coins,
    sleepHours: rawAnimal.sleepDurationHours,
    primaryDrop: {
      name: rawAnimal.drops.primary.name,
      image: rawAnimal.drops.primary.image,
    },
    secondaryDrop: rawAnimal.drops.secondary
      ? {
          name: rawAnimal.drops.secondary.name,
          image: rawAnimal.drops.secondary.image,
          unlockLevel: rawAnimal.drops.secondary.unlockLevel,
        }
      : undefined,
    careTools: rawAnimal.careTools,
    acceptedFoods: foods,
    levels,
  }
})

// FAQ Items
const faqItems = [
  { pregunta: t("sfl.animals.faq.q1"), respuesta: t("sfl.animals.faq.a1") },
  { pregunta: t("sfl.animals.faq.q2"), respuesta: t("sfl.animals.faq.a2") },
  { pregunta: t("sfl.animals.faq.q3"), respuesta: t("sfl.animals.faq.a3") },
  { pregunta: t("sfl.animals.faq.q4"), respuesta: t("sfl.animals.faq.a4") },
]
---

<SflToolLayout activeTab="animales">
  <!-- Encabezado Principal -->
  <div class="mb-5 relative z-10 text-center sm:text-left">
    <h1 class="text-3xl md:text-4xl font-black text-white tracking-tighter mb-2">
      {t("sfl.animals.heading")}
      <span class="text-emerald-500"> {t("sfl.animals.heading.accent")}</span>
    </h1>
    <p class="text-terminal-secondary text-sm leading-relaxed max-w-3xl">
      {t("sfl.animals.intro")}
    </p>
  </div>

  <!-- Dashboard Inicial Minimalista (Vacío / En fase de preparación) -->
  <div class="w-full mb-8 relative z-10 flex flex-col gap-4">
    <!-- Fila 1: Tarjetas de Dashboard -->
    <div class="grid grid-cols-1 md:grid-cols-12 gap-4 items-stretch">
      <!-- Bloque Izquierdo: HERO DASHBOARD VACÍO (md:col-span-7 xl:col-span-8) -->
      <div
        class="md:col-span-7 xl:col-span-8 bg-[#18181b]/95 border border-white/10 rounded-2xl p-5 sm:p-6 flex flex-col justify-between shadow-xl backdrop-blur-md relative z-20 overflow-hidden"
      >
        <!-- Resplandor verde esmeralda difuminado suave -->
        <div class="absolute left-1/4 top-1/2 -translate-y-1/2 w-64 h-32 bg-emerald-500/15 blur-3xl rounded-full pointer-events-none -z-0"></div>

        <div class="relative z-10">
          <!-- Header sutil -->
          <div class="flex items-center justify-between gap-2 mb-4">
            <span class="text-xs font-mono font-bold tracking-widest uppercase text-white/60 block">
              {t("sfl.animals.dash.title")}
            </span>
            <span class="text-[10px] font-mono px-2 py-0.5 rounded-full bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
              {t("sfl.animals.dash.emptyNotice")}
            </span>
          </div>

          <!-- Hero Content -->
          <div class="flex items-center gap-5 my-3">
            <div class="relative shrink-0 w-16 h-16 sm:w-20 sm:h-20 bg-white/5 border border-white/10 rounded-2xl p-2.5 flex items-center justify-center shadow-inner">
              <img
                src="/img/sunflowerland/123/Chicken.png"
                alt="Sunflower Land Animals"
                class="w-full h-full object-contain drop-shadow-md animate-pulse"
                loading="lazy"
                decoding="async"
              />
            </div>

            <div class="flex flex-col min-w-0">
              <h2 class="text-lg sm:text-xl font-bold text-white tracking-wide truncate">
                {t("sfl.animals.dash.subtitle")}
              </h2>
              <p class="text-xs sm:text-sm text-terminal-secondary mt-1 max-w-xl leading-relaxed">
                {t("sfl.animals.dash.emptyDesc")}
              </p>
            </div>
          </div>
        </div>

        <!-- Footer del Bloque Izquierdo -->
        <div class="mt-4 pt-4 border-t border-white/5 flex items-center justify-between text-xs font-mono text-white/40 relative z-10">
          <span>0xLeñador Engine · SFL v2.0</span>
          <span class="text-emerald-400/80">4 / 4 Especies</span>
        </div>
      </div>

      <!-- Bloque Derecho: ESTADÍSTICAS GLOBALES (md:col-span-5 xl:col-span-4) -->
      <div
        class="md:col-span-5 xl:col-span-4 bg-[#18181b]/95 border border-white/10 rounded-2xl p-5 sm:p-6 flex flex-col justify-between shadow-xl backdrop-blur-md relative z-20"
      >
        <div>
          <!-- Header sutil -->
          <span class="text-xs font-mono font-bold tracking-widest uppercase text-white/60 block mb-4">
            Constantes de Granja
          </span>

          <div class="grid grid-cols-2 gap-2.5">
            <!-- Stat 1 -->
            <div class="bg-black/40 border border-white/5 rounded-xl p-3 flex flex-col justify-between">
              <span class="text-[9px] font-mono text-white/40 uppercase tracking-wider">{t("sfl.animals.dash.statAnimals")}</span>
              <span class="text-xl font-mono font-black text-emerald-400 mt-1">4</span>
            </div>

            <!-- Stat 2 -->
            <div class="bg-black/40 border border-white/5 rounded-xl p-3 flex flex-col justify-between">
              <span class="text-[9px] font-mono text-white/40 uppercase tracking-wider">{t("sfl.animals.dash.statMaxLevel")}</span>
              <span class="text-xl font-mono font-black text-white mt-1">Lvl 15</span>
            </div>

            <!-- Stat 3 -->
            <div class="bg-black/40 border border-white/5 rounded-xl p-3 flex flex-col justify-between col-span-2">
              <span class="text-[9px] font-mono text-white/40 uppercase tracking-wider">{t("sfl.animals.dash.statCycle")}</span>
              <div class="flex items-center justify-between mt-1">
                <span class="text-base font-mono font-bold text-emerald-400">{t("sfl.animals.dash.statCycleVal")}</span>
