interface FoodCandidate {
  id: string
  name: string
  displayName?: string
  image: string
  ingredient: string
  ingredientImage?: string
  ingredientName?: string
  ingredientAmount?: number
  xp: number
  unitCostFlower: number
  requiredPerFeed: number
  costPerFeed: number
  costPerXp: number
  isFav: boolean
  isOptimal?: boolean
}

// Obtiene todas las opciones de alimento elegibles para el nivel y determina la matemáticamente más óptima
function getAllFoodOptionsForLevel(animalId: string, currentLevel: number): {
  optimal: FoodCandidate
  options: FoodCandidate[]
} {
  const candidates: FoodCandidate[] = []

  // 1. Alimento regular (Slops para Pig, Granos para otros)
  if (animalId === "pig") {
    let slopId = "basic_slop"
    let slopXp = 60
    if (currentLevel >= 3 && currentLevel <= 5) {
      slopId = "hearty_slop"
      slopXp = 60
    } else if (currentLevel >= 6 && currentLevel <= 9) {
      slopId = "rich_slop"
      slopXp = 60
    } else if (currentLevel >= 10) {
      slopId = "gourmet_slop"
      slopXp = 80
    }

    const consumable = (consumablesDataRaw as any)[slopId]
    const options = consumable?.options || []

    for (const opt of options) {
      const price = marketPrices[opt.name] ?? 0
      if (price > 0) {
        const totalCost = price * opt.amount
        candidates.push({
          id: `${slopId}_${opt.name}`,
          name: consumable?.name || "Slop",
          displayName: `${consumable?.name || "Slop"} (${opt.name})`,
          image: consumable?.image || `/img/sunflowerland/animals/${slopId}.webp`,
          ingredient: `${opt.amount}x ${opt.name}`,
          ingredientImage: opt.image,
          ingredientName: opt.name,
          ingredientAmount: opt.amount,
          xp: slopXp,
          unitCostFlower: totalCost,
          requiredPerFeed: 1,
          costPerFeed: totalCost,
          costPerXp: totalCost / slopXp,
          isFav: true,
          isOptimal: false,
        })
      }
    }

    if (candidates.length === 0) {
      candidates.push({
        id: slopId,
        name: consumable?.name || "Slop",
        displayName: consumable?.name || "Slop",
        image: consumable?.image || `/img/sunflowerland/animals/${slopId}.webp`,
        ingredient: "150x Potato",
        ingredientImage: "/img/sunflowerland/Potato.png",
        ingredientName: "Potato",
        ingredientAmount: 150,
        xp: slopXp,
        unitCostFlower: 0.0346,
        requiredPerFeed: 1,
        costPerFeed: 0.0346,
        costPerXp: 0.0346 / slopXp,
        isFav: true,
        isOptimal: false,
      })
    }
  } else {
    // chicken, cow, sheep
    const reqQty = REQUIRED_FOOD_QTY[animalId] || 1

    const grainsDef = [
      {
        id: "kernel_blend",
        name: "Kernel Blend",
        image: "/img/sunflowerland/animals/kernel_blend.webp",
        ingredient: "1x Corn",
        price: marketPrices["Corn"] || 0.02,
        xp: currentLevel <= 2 ? 60 : 10,
        isFav: currentLevel <= 2,
      },
      {
        id: "hay",
        name: "Hay",
        image: "/img/sunflowerland/animals/hay.webp",
        ingredient: "1x Wheat",
        price: marketPrices["Wheat"] || 0.01598,
        xp: currentLevel >= 3 && currentLevel <= 5 ? 60 : (currentLevel <= 2 ? 10 : 20),
        isFav: currentLevel >= 3 && currentLevel <= 5,
      },
      {
        id: "nutribarley",
        name: "NutriBarley",
        image: "/img/sunflowerland/animals/nutri_barley.webp",
        ingredient: "1x Barley",
        price: marketPrices["Barley"] || 0.02285,
        xp: currentLevel >= 6 && currentLevel <= 9 ? 60 : (currentLevel <= 5 ? 20 : 30),
        isFav: currentLevel >= 6 && currentLevel <= 9,
      },
      {
        id: "mixed_grain",
        name: "Mixed Grain",
        image: "/img/sunflowerland/animals/mixed_grain.webp",
        ingredient: "1x Corn, 1x Wheat, 1x Barley",
        price: (marketPrices["Corn"] || 0.02) + (marketPrices["Wheat"] || 0.01598) + (marketPrices["Barley"] || 0.02285),
        xp: currentLevel >= 10 ? 80 : 30,
        isFav: currentLevel >= 10,
      },
    ]

    for (const g of grainsDef) {
      const costPerFeed = reqQty * g.price
      candidates.push({
        id: g.id,
        name: g.name,
        displayName: g.name,
        image: g.image,
        ingredient: g.ingredient,
        xp: g.xp,
        unitCostFlower: g.price,
        requiredPerFeed: reqQty,
        costPerFeed,
        costPerXp: costPerFeed / g.xp,
        isFav: g.isFav,
        isOptimal: false,
      })
    }

    // Omnifeed (Chicken, Cow, Sheep)
    if (gemFlowerPrice > 0) {
      const omniXp = currentLevel <= 9 ? 60 : 80
      const costPerFeed = reqQty * gemFlowerPrice
      const omniDef = (consumablesDataRaw as any)["omnifeed"]
      candidates.push({
        id: "omnifeed",
        name: omniDef?.name || "Omnifeed",
        displayName: "Omnifeed",
        image: omniDef?.image || "/img/sunflowerland/animals/omnifeed.webp",
        ingredient: "1x Gem",
        xp: omniXp,
        unitCostFlower: gemFlowerPrice,
        requiredPerFeed: reqQty,
        costPerFeed,
        costPerXp: costPerFeed / omniXp,
        isFav: true,
        isOptimal: false,
      })
    }
  }

  // 2. Escarabajos (Chicken, Cow, Sheep, Pig)
  const beetlesList = [
    { id: "green_beetle", name: "Green Beetle", xp: 100, img: "/img/sunflowerland/green_beetle.webp" },
    { id: "blue_beetle", name: "Blue Beetle", xp: 200, img: "/img/sunflowerland/blue_beetle.webp" },
    { id: "pink_beetle", name: "Pink Beetle", xp: 400, img: "/img/sunflowerland/pink_beetle.webp" },
    { id: "amber_beetle", name: "Amber Beetle", xp: 800, img: "/img/sunflowerland/amber_beetle.webp" },
  ]

  for (const b of beetlesList) {
    const price = marketPrices[b.name] || 0
    if (price > 0) {
      candidates.push({
        id: b.id,
        name: b.name,
        displayName: b.name,
        image: b.img,
        ingredient: "Beetle P2P",
        xp: b.xp,
        unitCostFlower: price,
        requiredPerFeed: 1,
        costPerFeed: price,
        costPerXp: price / b.xp,
        isFav: true,
        isOptimal: false,
      })
    }
  }

  // Selección matemática del de menor costo por unidad de XP
  const optimal = candidates.reduce((best, curr) => (curr.costPerXp < best.costPerXp ? curr : best))
  optimal.isOptimal = true

  return { optimal, options: candidates }
}

function getOptimalFoodForLevel(animalId: string, currentLevel: number): FoodCandidate {
  return getAllFoodOptionsForLevel(animalId, currentLevel).optimal
}

const formatProfitFlower = (val: number) => {
  const sign = val >= 0 ? "+" : ""
  return `${sign}${val.toFixed(4)} FL`
}

const formatProfitUsd = (val: number) => {
  const sign = val >= 0 ? "+" : "-"
  return `${sign}$${Math.abs(val).toFixed(4)}`
}

const resLabel = "res"
const affecLabel = lang === "en" ? "affec" : "afec"
const foodLabel = lang === "en" ? "food" : "comida"
const surplusLabel = t("sfl.animals.table.surplus")

interface AnimalMetaDisplay {
  id: (typeof orderedAnimalIds)[number]
  name: string
  tabLabel: string
  icon: string
  buildingName: string
  buildingIcon: string
  costCoins: number
  sleepHours: number
  primaryDrop: {
    name: string
    image: string
  }
  secondaryDrop?: {
    name: string
    image: string
    unlockLevel: number
  }
  careTools: Array<{ id: string; name: string; xp: number; image: string }>
  acceptedFoods: Array<{ name: string; image: string; xp?: number }>
  totalProfitFlower: number
  totalProfitUsd: number
  levels: AnimalLevelDisplay[]
}

const clientAnimalsData: Record<string, any> = {}

const animalsDisplayList: AnimalMetaDisplay[] = orderedAnimalIds.map((animalId) => {
  const rawAnimal = (animalsDataRaw as any)[animalId]
  const rawBuilding = (buildingsDataRaw as any)[rawAnimal.buildingId]

  clientAnimalsData[animalId] = {
    id: animalId,
    name: rawAnimal.name,
    sleepHours: rawAnimal.sleepDurationHours,
    requiredPerFeed: REQUIRED_FOOD_QTY[animalId] || 1,
    primaryDropName: rawAnimal.drops.primary.name,
    secondaryDropName: rawAnimal.drops.secondary?.name,
    boosts: {
      food: 1,
      foodXp: 1,
      careMultiplier: 1,
      primaryDrop: 0,
      secondaryDrop: 0,
    },
    targetLevel: 15,
    levels: []
  }

  // Mapeo de alimentos con imágenes reales y XP de consumablesDataRaw
  const foods = rawAnimal.acceptedFoods.map((foodId: string) => {
    const consumable = (consumablesDataRaw as any)[foodId]
    if (consumable) {
      return {
        name: consumable.name,
        image: consumable.image || `/img/sunflowerland/animals/${foodId}.webp`,
        xp: consumable.xp,
      }
    }
    return {
      name: foodId.replace(/_/g, " "),
      image: `/img/sunflowerland/animals/${foodId}.webp`,
      xp: undefined,
    }
  })

  // Alimento predeterminado para el cálculo del ciclo base
  const defaultFood = foods[0] || { name: "Kernel Blend", image: "/img/sunflowerland/animals/kernel_blend.webp", xp: 60 }
  const cycleFoodXp = defaultFood.xp || 60

  let currentCarryover = 0

  // Generación de progresión de 15 saltos de nivel con cálculo de residual
  const levels: AnimalLevelDisplay[] = rawAnimal.levels.map((lvlObj: any) => {
    const toLvl = lvlObj.level
    const fromLvl = toLvl - 1
    const xpReq = lvlObj.xpRequired
    const isFirstLevel = fromLvl === 0

    // En 0 > 1 el residual recibido es siempre 0 (es el inicio)
    // En niveles posteriores, recibe el remanente del nivel anterior
    const receivedResidual = isFirstLevel ? 0 : currentCarryover

    // En 0 > 1 es instantáneo y no hay afecto
    const isInstant = isFirstLevel
    const sleepHours = isInstant ? 0 : rawAnimal.sleepDurationHours

    // Probabilidades oficiales de Love Requests para este nivel de origen
    const loveProb = LOVE_REQUESTS[fromLvl] || { petting: 0, brush: 0, music: 0 }
    const affectionTools: AffectionToolItem[] = []

    if (!isInstant) {
      if (loveProb.petting > 0) {
        affectionTools.push({
          id: "petting_hand",
          name: "Petting Hand",
          xp: 10,
          percent: Math.round(loveProb.petting * 100),
          image: "/img/sunflowerland/tools/Petting Hand.webp",
        })
      }
      if (loveProb.brush > 0) {
        affectionTools.push({
          id: "brush",
          name: "Brush",
          xp: 20,
          percent: Math.round(loveProb.brush * 100),
          image: "/img/sunflowerland/tools/Brush.webp",
        })
      }
      if (loveProb.music > 0) {
        affectionTools.push({
          id: "music_box",
          name: "Music Box",
          xp: 40,
          percent: Math.round(loveProb.music * 100),
          image: "/img/sunflowerland/tools/Music Box.webp",
        })
      }
    }

    // Afecto diario: son 2 caricias al día con valor esperado según probabilidades
    const singleAffectionXp = (loveProb.petting * 10) + (loveProb.brush * 20) + (loveProb.music * 40)
    const affectionXp = isInstant ? 0 : Math.round(singleAffectionXp * 2)

    // Alimento óptimo más económico por unidad de XP y opciones completas
    const { optimal: optFood, options: foodOptions } = getAllFoodOptionsForLevel(animalId, fromLvl)
    const unitFoodXp = optFood.xp

    // XP que falta cubrir con alimento tras descontar el residual previo y el afecto
    const neededFromFood = Math.max(0, xpReq - receivedResidual - affectionXp)

    // Cada acción de alimentación otorga unitFoodXp y consume optFood.requiredPerFeed unidades físicas
    const neededFeeds = Math.max(1, Math.ceil(neededFromFood / unitFoodXp))
    const foodUnits = neededFeeds * optFood.requiredPerFeed

    // Costo total de las raciones completas compradas para este nivel
    const foodCostFlower = neededFeeds * optFood.costPerFeed
    const foodCostUsd = foodCostFlower * flowerUsd

    // XP total de comida suministrada y XP total obtenida en el ciclo
    const totalFoodXp = neededFeeds * unitFoodXp
    const totalXpObtained = affectionXp + totalFoodXp

    // Total acumulado disponible y remanente residual que pasa al siguiente nivel
    const totalAvailable = receivedResidual + totalXpObtained
    const residualGenerated = Math.max(0, totalAvailable - xpReq)
    currentCarryover = residualGenerated

    // Recursos obtenidos oficialmente según ANIMAL_RESOURCE_DROP
    const resources: AnimalLevelDisplay["resources"] = OFFICIAL_RESOURCE_DROPS[animalId]?.[toLvl] || []

    // Ingresos brutos por venta de recursos en FLOWER y USD
    let revenueFlower = 0
    for (const res of resources) {
      const unitPrice = marketPrices[res.name] || 0
      revenueFlower += res.amount * unitPrice
    }
    const revenueUsd = revenueFlower * flowerUsd

    // Profit neto exclusivo en FLOWER y USD imputando exactamente el costo de alimento consumido
    const profitFlower = revenueFlower - foodCostFlower
    const profitUsd = profitFlower * flowerUsd

    clientAnimalsData[animalId].levels.push({
      level: toLvl,
      fromLevel: fromLvl,
      xpRequired: xpReq,
      isInstant,
      affectionXp,
      baseAffectionXp: affectionXp,
      loveProb: isInstant ? { petting: 0, brush: 0, music: 0 } : loveProb,
      baseResources: resources.map((r) => ({
        name: r.name,
        amount: r.amount,
        image: r.image,
        unitPrice: marketPrices[r.name] || 0,
        isPrimary: r.name === rawAnimal.drops.primary.name,
        isSecondary: rawAnimal.drops.secondary ? r.name === rawAnimal.drops.secondary.name : false,
      })),
      revenueFlower,
      revenueUsd,
      selectedFoodId: optFood.id,
      optimalFoodId: optFood.id,
      options: foodOptions,
    })

    return {
      fromLevel: fromLvl,
      toLevel: toLvl,
      xpRequired: xpReq,
      sleepHours,
      isInstant,
      residualXp: receivedResidual,
      residualGenerated,
      affectionTools,
      affectionXp,
      food: {
        name: optFood.name,
        image: optFood.image,
        ingredient: optFood.ingredient,
        ingredientImage: optFood.ingredientImage,
        ingredientName: optFood.ingredientName,
        ingredientAmount: optFood.ingredientAmount,
        units: foodUnits,
        xp: unitFoodXp,
        costFlower: foodCostFlower,
        costUsd: foodCostUsd,
        isFav: optFood.isFav,
      },
      totalXpObtained,
      totalFoodXp,
      totalAvailable,
      resources,
      revenueFlower,
      revenueUsd,
      profitFlower,
      profitUsd,
    }
  })

  const tabLabels: Record<string, string> = {
    chicken: t("sfl.animals.tabs.chickens"),
    sheep: t("sfl.animals.tabs.sheep"),
    cow: t("sfl.animals.tabs.cows"),
    pig: t("sfl.animals.tabs.pigs"),
  }

  return {
    id: animalId,
    name: rawAnimal.name,
    tabLabel: tabLabels[animalId] || rawAnimal.name,
    icon: rawAnimal.icon,
    buildingName: rawBuilding?.name || rawAnimal.buildingId,
    buildingIcon: rawBuilding?.icon || rawAnimal.icon,
    costCoins: rawAnimal.purchaseCost.coins,
    sleepHours: rawAnimal.sleepDurationHours,
    primaryDrop: {
      name: rawAnimal.drops.primary.name,
      image: rawAnimal.drops.primary.image,
    },
    secondaryDrop: rawAnimal.drops.secondary
      ? {
          name: rawAnimal.drops.secondary.name,
          image: rawAnimal.drops.secondary.image,
          unlockLevel: rawAnimal.drops.secondary.unlockLevel,
        }
      : undefined,
    careTools: rawAnimal.careTools,
    acceptedFoods: foods,
    totalProfitFlower: levels.reduce((acc, l) => acc + l.profitFlower, 0),
    totalProfitUsd: levels.reduce((acc, l) => acc + l.profitUsd, 0),
    levels,
  }
})

const clientPayload = {
  flowerUsd,
  resLabel,
  affecLabel,
  foodLabel,
  surplusLabel,
  totalProfitLabel: t("sfl.animals.card.totalProfit"),
  animals: clientAnimalsData,
}

// FAQ Items
const faqItems = [
  { pregunta: t("sfl.animals.faq.q1"), respuesta: t("sfl.animals.faq.a1") },
