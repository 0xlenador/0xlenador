  </div>

  <!-- Modal / Dropdown Flotante Minimalista de Selección de Alimento -->
  <div
    id="sflFoodDropdown"
    class="fixed hidden z-50 bg-[#161616]/98 border border-white/10 rounded-2xl p-2 shadow-2xl backdrop-blur-xl max-h-80 overflow-y-auto no-scrollbar w-72 flex flex-col gap-1.5 transition-all duration-150"
    style="box-shadow: 0 20px 40px -15px rgba(0,0,0,0.9);"
  ></div>

  <script id="sflAnimalsData" type="application/json" set:html={JSON.stringify(clientPayload)} />

  <div slot="footer" class="mt-12">
    <!-- Acordeón de Preguntas Frecuentes (FAQ) -->
    <FaqAccordion
      title={t("sfl.animals.faq.title")}
