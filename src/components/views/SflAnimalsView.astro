                        <div class="flex flex-col">
                          <span class="text-xs font-bold text-white">{animal.secondaryDrop.name}</span>
                          <span class="text-[9px] font-mono text-emerald-400">Lvl {animal.secondaryDrop.unlockLevel}+</span>
                        </div>
                      </div>
                    </div>
                  )}

                  <!-- Herramientas de Cuidado -->
                  <div class="flex flex-col">
                    <span class="text-[10px] font-mono uppercase tracking-wider text-white/40 mb-1">
                      {t("sfl.animals.card.tools")}
                    </span>
                    <div class="flex items-center gap-1.5 bg-black/40 border border-white/5 rounded-xl px-2.5 py-1.5">
                      {animal.careTools.map((tool) => (
                        <img
                          src={tool.image}
                          alt={tool.name}
                          title={`${tool.name} (+${tool.xp} XP)`}
