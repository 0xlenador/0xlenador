            class="flex items-center cursor-pointer text-xs font-bold text-white/60 uppercase tracking-wider mb-2 group-open/sub:mb-3 hover:text-emerald-400 transition-colors list-none select-none [&::-webkit-details-marker]:hidden"
          >
            <svg
              class="w-2.5 h-2.5 mr-2 text-emerald-500/80 transition-transform duration-200 group-open/sub:rotate-90 shrink-0"
              viewBox="0 0 24 24"
              fill="currentColor"
            >
              <path d="M8 5v14l11-7z"></path>
            </svg>
            {t("sfl.animals.boosts.powerupsTitle")} ({animalBuffs.length})
          </summary>
          <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 xl:grid-cols-7 gap-2 w-full pl-1">
            {
              animalBuffs.map((buff) => {
                const imgPath = buff.isWearable
                  ? `/img/sunflowerland/powerups/wearables/${buff.image}`
                  : `/img/sunflowerland/powerups/${buff.image}`

                return (
                  <label
                    data-effect={buff.effectType}
                    class="animal-buff-card group flex items-center gap-2 cursor-pointer bg-white/5 border border-white/5 hover:border-emerald-500/30 hover:bg-emerald-500/10 rounded-lg p-1.5 transition-all"
                  >
                    <input
                      type="checkbox"
                      class="hidden animal-buff-checkbox"
                      data-buff-id={buff.id}
                    />
                    <img
                      src={imgPath}
                      class="w-6 h-6 object-contain drop-shadow-sm group-hover:scale-110 transition-transform shrink-0"
                      onerror="this.onerror=null; this.src='/img/cripto/sunflowerland.webp';"
                      alt={buff.name}
                      title={buff.boost}
                      width="24"
                      height="24"
                      loading="lazy"
                      decoding="async"
                    />
                    <div class="flex flex-col normal-view min-w-0">
                      <span class="text-[10px] font-bold text-white group-[.active]:text-emerald-400 group-hover:text-emerald-400 transition-colors truncate">
                        {buff.name}
                      </span>
                      <span class="text-[9px] text-terminal-muted leading-tight line-clamp-2" title={buff.boost}>
                        {buff.boost}
                      </span>
                    </div>
                    <div class="hidden compact-view w-full">
                      <span class="text-[9px] font-mono text-white/80 whitespace-nowrap overflow-hidden text-ellipsis group-[.active]:text-emerald-400 transition-colors" title={buff.boost}>
                        {buff.name}
                      </span>
                    </div>
                  </label>
                )
              })
            }
          </div>
        </details>

        <!-- Subgrupo: Habilidades Bumpkin (Skills) -->
        <details class="group/sub w-full mb-1 open:mb-6" open>
          <summary
            class="flex items-center cursor-pointer text-xs font-bold text-white/60 uppercase tracking-wider mb-2 group-open/sub:mb-3 hover:text-blue-400 transition-colors list-none select-none [&::-webkit-details-marker]:hidden"
          >
            <svg
              class="w-2.5 h-2.5 mr-2 text-blue-500/80 transition-transform duration-200 group-open/sub:rotate-90 shrink-0"
              viewBox="0 0 24 24"
              fill="currentColor"
            >
              <path d="M8 5v14l11-7z"></path>
            </svg>
            {t("sfl.animals.boosts.skillsTitle")} ({Object.keys(sflAnimalsSkills).length})
          </summary>
          <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 xl:grid-cols-7 gap-2 w-full pl-1">
            {
              Object.entries(sflAnimalsSkills).map(([skillName, skillData]: [string, any]) => {
                const effectType = getEffectType(skillData.description)
                return (
                  <div
                    data-effect={effectType}
                    class="animal-skill-card flex flex-col bg-white/5 border border-white/5 rounded-lg p-1.5 transition-all group hover:border-blue-500/30 hover:bg-blue-500/5 cursor-pointer"
                    data-skill-id={skillName}
                  >
                    <div class="flex items-start gap-2 mb-1.5 pointer-events-none">
                      <img
                        src={skillData.image}
                        class="w-6 h-6 object-contain drop-shadow-sm group-hover:scale-110 transition-transform shrink-0"
                        onerror="this.onerror=null; this.src='/img/cripto/sunflowerland.webp';"
                        alt={skillName}
                        title={skillData.description}
                        width="24"
                        height="24"
                        loading="lazy"
                        decoding="async"
                      />
                      <div class="flex flex-col normal-view min-w-0">
                        <span class="text-[10px] font-bold text-white group-[.active]:text-blue-400 transition-colors truncate">
                          {skillName}
                        </span>
                        <span class="text-[9px] text-terminal-muted leading-tight line-clamp-2" title={skillData.description}>
                          {skillData.description}
                        </span>
                      </div>
                      <div class="hidden compact-view w-full mr-2">
                        <span class="text-[9px] font-mono text-white/80 whitespace-nowrap overflow-hidden text-ellipsis group-[.active]:text-blue-400 transition-colors" title={skillData.description}>
                          {skillName}
                        </span>
                      </div>
                    </div>

                    {skillData.cost_by_rank && Object.keys(skillData.cost_by_rank).length > 0 && (
                      <div class="flex items-center gap-2 mt-auto pt-1.5 border-t border-white/10" onclick="event.stopPropagation()">
                        {Object.keys(skillData.cost_by_rank).map((_, idx) => (
                          <label class="flex items-center gap-1 cursor-pointer hover:opacity-80 transition-opacity">
                            <input
                              type="checkbox"
                              value={idx + 1}
                              class="animal-skill-rank-checkbox w-2.5 h-2.5 rounded-sm text-blue-500 bg-white/5 border-white/20 focus:ring-blue-500/50"
                              data-skill-id={skillName}
                              data-rank={idx + 1}
                            />
                            <span class="text-[8px] font-mono font-bold text-white/50">R{idx + 1}</span>
                          </label>
                        ))}
                      </div>
                    )}
                  </div>
                )
              })
            }
          </div>
        </details>
      </div>
    </div>
  </details>

  <!-- Controles y Pestañas de Animales -->
  <!-- ORDEN ESTRICTO: Pollos (chicken), Ovejas (sheep), Vacas (cow), Cerdos (pig) -->
  <div class="sticky top-0 z-40 bg-[#06080A]/95 backdrop-blur-md py-4 border-b border-white/5 mb-6 -mx-4 px-4 sm:mx-0 sm:px-0 sm:bg-transparent sm:border-0 sm:static sm:py-0">
    <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 relative z-10">
      <!-- Pestañas ordenadas -->
      <div class="flex gap-2 overflow-x-auto w-full sm:w-auto pb-2 sm:pb-0 no-scrollbar snap-x" id="animalTabsContainer">
        {
          animalsDisplayList.map((animal, idx) => {
            const isFirst = idx === 0
            return (
              <button
                type="button"
                class:list={[
                  "animal-tab-btn snap-start px-4 py-2 rounded-xl text-xs font-bold uppercase tracking-wider transition-all whitespace-nowrap shrink-0 flex items-center gap-2 cursor-pointer",
                  isFirst
                    ? "active bg-emerald-500/20 text-emerald-400 border border-emerald-500/40 shadow-sm"
                    : "bg-white/5 text-white/50 border border-white/10 hover:bg-white/10 hover:text-white",
                ]}
                data-animal-id={animal.id}
              >
                <img
                  src={animal.icon}
                  alt={animal.tabLabel}
                  class="w-5 h-5 object-contain drop-shadow"
                  loading="lazy"
                  decoding="async"
                />
                <span>{animal.tabLabel}</span>
              </button>
            )
          })
        }
      </div>

      <!-- Buscador rápido por nivel/hito -->
      <div class="relative w-full sm:w-72 shrink-0 md:ml-auto">
        <input
          type="text"
          id="animalSearchInput"
          placeholder={t("sfl.animals.search.placeholder")}
          class="w-full bg-white/5 border border-white/10 rounded-xl px-4 py-2 text-sm text-white placeholder-white/30 focus:outline-none focus:ring-2 focus:ring-emerald-500/50 focus:border-emerald-500/50 transition-all font-mono"
        />
      </div>
    </div>
  </div>

  <!-- Contenedores de cada animal con su tarjeta de resumen y su tabla de niveles -->
  <div id="animalsViewsWrapper" class="relative z-10">
    {
      animalsDisplayList.map((animal, idx) => {
        const isFirst = idx === 0
        return (
          <div
            id={`animal-panel-${animal.id}`}
            class:list={["animal-panel flex flex-col gap-6", isFirst ? "" : "hidden"]}
            data-animal-id={animal.id}
          >
            <!-- Tarjeta de Resumen del Animal Activo -->
            <div class="bg-[#18181b]/95 border border-white/10 rounded-2xl p-5 sm:p-6 shadow-xl backdrop-blur-md">
              <div class="flex flex-col xl:flex-row items-start xl:items-center justify-between gap-6">
                <!-- Info Principal del Animal -->
                <div class="flex items-center gap-4 sm:gap-5 shrink-0">
                  <div class="w-16 h-16 sm:w-20 sm:h-20 bg-white/5 border border-white/10 rounded-2xl p-2 flex items-center justify-center shrink-0 shadow-inner">
                    <img
                      src={animal.icon}
                      alt={animal.name}
                      class="w-full h-full object-contain drop-shadow-md"
                      loading="lazy"
                      decoding="async"
                    />
                  </div>
                  <div class="flex flex-col justify-center">
                    <!-- Título -->
                    <h2 class="text-xl sm:text-2xl font-black text-white tracking-tight leading-tight">
                      {animal.tabLabel}
                    </h2>
                    <!-- Building debajo del nombre -->
                    <div class="flex items-center gap-1.5 mt-0.5">
                      <img src={animal.buildingIcon} alt={animal.buildingName} class="w-3.5 h-3.5 object-contain opacity-70" />
                      <span class="text-xs font-mono text-white/60">{animal.buildingName}</span>
                    </div>
                    <!-- Costo de compra y debajo Tiempo -->
                    <div class="flex flex-col gap-0.5 mt-2 text-xs font-mono">
                      <div class="flex items-center gap-1.5 text-white/60">
                        <span>{t("sfl.animals.card.cost")}:</span>
                        <strong class="text-emerald-400 font-semibold">{animal.costCoins} Monedas</strong>
                      </div>
                      <div class="flex items-center gap-1.5 text-white/60">
                        <span>{t("sfl.animals.card.sleep")}:</span>
                        <strong class="text-white font-semibold">{animal.sleepHours}h</strong>
                      </div>
                    </div>
                  </div>
                </div>

                <!-- Bloque Central: Barra de Boosts centrada + Selector de Nivel Objetivo con Puntos -->
                <div class="flex flex-col items-center justify-center flex-1 w-full xl:w-auto xl:max-w-2xl px-1 sm:px-2 gap-3 border-t xl:border-t-0 pt-4 xl:pt-0 border-white/5">
                  <!-- Título y Barra de Boosts -->
                  <div class="flex flex-col items-center w-full">
                    <span class="text-[10px] font-mono uppercase tracking-wider text-white/40 mb-1.5 self-center">
                      {t("sfl.animals.card.boostsTitle")}
                    </span>
                    <div class="flex items-center justify-center gap-1.5 sm:gap-2 flex-wrap bg-black/40 border border-white/5 rounded-2xl p-2 sm:px-3 sm:py-2 w-full max-w-fit shadow-inner">
                      <!-- Food: 1 -->
                      <div class="flex items-center gap-1.5 bg-white/5 hover:bg-white/[0.08] transition-colors rounded-xl px-2 sm:px-2.5 py-1.5 border border-white/5">
                        <span class="text-xs font-mono font-medium text-white/80">Food:</span>
                        <input
                          type="number"
                          step="1"
                          min="0"
                          value="1"
                          data-animal={animal.id}
                          data-boost-type="food"
                          class="animal-boost-input w-11 bg-black/60 border border-white/10 rounded-md px-1.5 py-0.5 text-xs font-mono text-emerald-400 text-center focus:outline-none focus:border-emerald-500/60 transition-all font-semibold"
                          title="Multiplicador de consumo de alimento"
                        />
                      </div>

                      <!-- Food XP: 1 -->
                      <div class="flex items-center gap-1.5 bg-white/5 hover:bg-white/[0.08] transition-colors rounded-xl px-2 sm:px-2.5 py-1.5 border border-white/5">
                        <span class="text-xs font-mono font-medium text-white/80">Food XP:</span>
                        <input
                          type="number"
                          step="0.1"
                          min="0.1"
                          value="1"
                          data-animal={animal.id}
                          data-boost-type="foodXp"
                          class="animal-boost-input w-11 bg-black/60 border border-white/10 rounded-md px-1.5 py-0.5 text-xs font-mono text-emerald-400 text-center focus:outline-none focus:border-emerald-500/60 transition-all font-semibold"
                          title="Multiplicador de XP obtenida de los alimentos"
                        />
                      </div>

                      <!-- Care Tools Multiplier (los 3 iconos con sus tooltips + input multiplicador) -->
                      <div class="flex items-center gap-2 bg-white/5 hover:bg-white/[0.08] transition-colors rounded-xl px-2 sm:px-2.5 py-1.5 border border-white/5">
                        <div class="flex items-center -space-x-1 shrink-0">
                          {animal.careTools.map((tool, tIdx) => (
                            <img
                              src={tool.image}
                              alt={tool.name}
                              title={`${tool.name} (+${tool.xp} XP)`}
                              class="w-4.5 h-4.5 object-contain drop-shadow hover:scale-125 transition-transform cursor-help relative"
                              style={`z-index: ${tIdx + 1};`}
                            />
                          ))}
                        </div>
                        <input
                          type="number"
                          step="0.1"
                          min="0.1"
                          value="1"
                          data-animal={animal.id}
                          data-boost-type="careMultiplier"
                          class="animal-boost-input w-11 bg-black/60 border border-white/10 rounded-md px-1.5 py-0.5 text-xs font-mono text-emerald-400 text-center focus:outline-none focus:border-emerald-500/60 transition-all font-semibold"
                          title="Multiplicador de XP para las herramientas de afecto (ej: 1.5 = +50% XP)"
                        />
                      </div>

                      <!-- Primary Drop (ej. Egg: +0.00) -->
                      <div class="flex items-center gap-1.5 bg-white/5 hover:bg-white/[0.08] transition-colors rounded-xl px-2 sm:px-2.5 py-1.5 border border-white/5">
                        <img src={animal.primaryDrop.image} alt={animal.primaryDrop.name} class="w-4 h-4 object-contain" />
                        <span class="text-xs font-mono font-medium text-white/80">{animal.primaryDrop.name}:</span>
                        <input
                          type="number"
                          step="0.1"
                          min="0"
                          value="0"
                          placeholder="+0.00"
                          data-animal={animal.id}
                          data-boost-type="primaryDrop"
                          class="animal-boost-input w-14 bg-black/60 border border-white/10 rounded-md px-1.5 py-0.5 text-xs font-mono text-emerald-400 text-center focus:outline-none focus:border-emerald-500/60 transition-all font-semibold"
                          title={`Bonus de drop para ${animal.primaryDrop.name}`}
                        />
                      </div>

                      <!-- Secondary Drop (ej. Feather: +0.00) -->
                      {animal.secondaryDrop && (
                        <div class="flex items-center gap-1.5 bg-white/5 hover:bg-white/[0.08] transition-colors rounded-xl px-2 sm:px-2.5 py-1.5 border border-white/5">
                          <img src={animal.secondaryDrop.image} alt={animal.secondaryDrop.name} class="w-4 h-4 object-contain" />
                          <span class="text-xs font-mono font-medium text-white/80">{animal.secondaryDrop.name}:</span>
                          <input
                            type="number"
                            step="0.1"
                            min="0"
                            value="0"
                            placeholder="+0.00"
                            data-animal={animal.id}
                            data-boost-type="secondaryDrop"
                            class="animal-boost-input w-14 bg-black/60 border border-white/10 rounded-md px-1.5 py-0.5 text-xs font-mono text-emerald-400 text-center focus:outline-none focus:border-emerald-500/60 transition-all font-semibold"
                            title={`Bonus de drop para ${animal.secondaryDrop.name}`}
                          />
                        </div>
                      )}
                    </div>
                  </div>

                  <!-- Línea de Puntos: Selector de Nivel Objetivo (1 al 15) -->
                  <div class="flex flex-col items-center w-full max-w-lg px-2">
                    <div class="flex items-center justify-between w-full mb-1 text-[10px] font-mono text-white/40">
                      <span class="flex items-center gap-1">
                        <span>🎯</span>
                        <span>{t("sfl.animals.card.targetLevel")}:</span>
                        <strong class="text-emerald-400 font-bold target-level-number" data-animal={animal.id}>Lvl 15</strong>
                      </span>
                      <span class="text-white/30 hidden sm:inline">Clic en un nivel para limitar cálculo</span>
                    </div>

                    <!-- Pista interactiva de 15 puntos -->
                    <div class="relative w-full flex items-center justify-between py-1 px-1 animal-target-track" data-animal={animal.id}>
                      <div class="absolute left-2 right-2 top-1/2 -translate-y-1/2 h-1 bg-white/10 rounded-full z-0"></div>
                      <div
                        class="target-level-progress-bar absolute left-2 top-1/2 -translate-y-1/2 h-1 bg-emerald-500 rounded-full z-0 transition-all duration-200"
                        data-animal={animal.id}
                        style="width: 100%;"
                      ></div>

                      {Array.from({ length: 15 }, (_, i) => i + 1).map((lvlNum) => {
                        const isSelected = lvlNum === 15
                        return (
                          <button
                            type="button"
                            class:list={[
                              "target-level-dot relative z-10 w-4 h-4 sm:w-5 sm:h-5 rounded-full flex items-center justify-center transition-all cursor-pointer font-mono text-[9px] font-bold select-none focus:outline-none",
                              isSelected
                                ? "bg-emerald-400 text-black border-2 border-emerald-500 ring-2 ring-emerald-400/50 scale-110 shadow-sm shadow-emerald-500/50"
                                : "bg-emerald-500/80 text-black border border-emerald-400/60 hover:scale-110"
                            ]}
                            data-animal={animal.id}
                            data-target-level={lvlNum}
                            title={`Calcular profit hasta Nivel ${lvlNum}`}
                          >
                            <span class="pointer-events-none">{lvlNum}</span>
                          </button>
                        )
                      })}
                    </div>
                  </div>
                </div>

                <!-- Cuadro de Profit Total Acumulado (Extremo Derecho) -->
                <div class="flex flex-col shrink-0 self-center xl:self-auto border-t xl:border-t-0 pt-4 xl:pt-0 border-white/5 w-full xl:w-auto">
                  <span
                    class="animal-total-profit-title text-[10px] font-mono uppercase tracking-wider text-white/40 mb-1.5 text-center xl:text-right"
                    data-animal={animal.id}
                  >
                    {t("sfl.animals.card.totalProfit")} (Lvl 1-15)
                  </span>
                  <div
                    class:list={[
                      "animal-total-profit-badge flex flex-col items-center xl:items-end justify-center px-4 py-2 rounded-2xl border font-mono transition-colors min-w-[130px]",
                      animal.totalProfitFlower >= 0
                        ? "bg-emerald-500/10 border-emerald-500/20 text-emerald-400"
                        : "bg-rose-500/10 border-rose-500/20 text-rose-400"
                    ]}
                    data-animal={animal.id}
                  >
                    <span
                      class="animal-total-profit-flower font-black text-sm sm:text-base leading-tight"
                      data-animal={animal.id}
                    >
                      {formatProfitFlower(animal.totalProfitFlower)}
                    </span>
                    <span
                      class="animal-total-profit-usd text-xs leading-tight opacity-80 mt-0.5"
                      data-animal={animal.id}
                    >
                      {formatProfitUsd(animal.totalProfitUsd)} USD
                    </span>
                  </div>
                </div>
              </div>
            </div>

            <!-- Tabla de Niveles del Animal (Desktop Header + Rows con 6 columnas) -->
            <div class="w-full">
              <!-- Header Tabla Desktop (6 columnas: Nivel & Tiempo, Afecto, Alimento, Cálculo XP, Recursos, Profit) -->
              <div class="hidden lg:grid grid-cols-[16%_16%_22%_20%_13%_13%] p-3 bg-white/[0.02] border border-white/5 rounded-2xl mb-3 items-center text-xs font-mono text-terminal-muted uppercase tracking-wider font-semibold">
                <div class="px-3">{t("sfl.animals.table.colLevelTime")}</div>
                <div class="px-3">{t("sfl.animals.table.colAffection")}</div>
                <div class="px-3">{t("sfl.animals.table.colFeed")}</div>
                <div class="px-3">{t("sfl.animals.table.colXpCalc")}</div>
                <div class="px-3">{t("sfl.animals.table.colYield")}</div>
                <div class="px-3">{t("sfl.animals.table.colProfit")}</div>
              </div>

              <!-- Body de Filas -->
              <div class="flex flex-col gap-3 lg:gap-0 lg:bg-white/[0.01] lg:border lg:border-white/5 lg:rounded-3xl lg:p-2 lg:overflow-hidden animal-rows-container">
                {animal.levels.map((lvl) => {
                  return (
                    <div
                      class="animal-level-row hover:bg-white/[0.02] transition-colors group block border border-white/5 bg-white/[0.02] rounded-2xl p-4 lg:p-0 lg:border-0 lg:border-b lg:border-white/5 last:lg:border-b-0 lg:bg-transparent lg:rounded-none lg:grid lg:grid-cols-[16%_16%_22%_20%_13%_13%] lg:items-center lg:py-3.5"
                      data-animal={animal.id}
                      data-level={lvl.toLevel}
                      data-from-level={lvl.fromLevel}
                      data-search={`${lvl.fromLevel} ${lvl.toLevel} ${lvl.food?.name || ''} ${(lvl.affectionTools || []).map(t => t.name).join(' ')} ${(lvl.resources || []).map(r => r?.name || '').join(' ')}`}
                    >
                      <!-- Columna 1: Nivel (0 > 1) - XP y debajo tiempo (24h) -->
                      <div class="lg:px-3 flex flex-col justify-center mb-3 lg:mb-0">
                        <div class="flex items-center gap-2">
                          <span class="font-mono font-bold text-white text-sm">
                            {lvl.fromLevel} &gt; {lvl.toLevel}
                          </span>
                          <span class="text-[10px] font-mono text-emerald-400 bg-emerald-500/10 px-1.5 py-0.5 rounded border border-emerald-500/20">
                            {lvl.xpRequired} XP
                          </span>
                          {lvl.toLevel === 15 && (
                            <span class="text-[9px] font-mono px-1.5 py-0.5 rounded bg-amber-500/20 text-amber-300 border border-amber-500/30">
                              CAP
                            </span>
                          )}
                        </div>
                        {lvl.isInstant ? (
                          <span class="text-[11px] font-mono text-cyan-300 flex items-center gap-1 mt-0.5 font-semibold">
                            <span>⚡</span> {t("sfl.animals.table.instant")}
                          </span>
                        ) : (
                          <span class="text-[11px] font-mono text-terminal-muted flex items-center gap-1 mt-0.5">
                            <span>🕒</span> {lvl.sleepHours}h
                          </span>
                        )}
                      </div>

                      <!-- Mobile Grid de Métricas (2 columnas) -->
                      <div class="grid grid-cols-2 gap-2 mb-3 lg:hidden">
                        <!-- Mobile: Afecto -->
                        <div class="bg-black/30 border border-white/5 rounded-xl p-2.5 flex flex-col justify-between">
                          <span class="text-[9px] text-white/40 uppercase font-mono">{t("sfl.animals.table.colAffection")}</span>
                          {
                            lvl.affectionTools && lvl.affectionTools.length > 0 ? (
                              <div class="flex items-center justify-between gap-1 mt-1">
                                <div class="flex items-center -space-x-1.5 shrink-0">
                                  {lvl.affectionTools.map((tool, tIdx) => (
                                    <img
                                      src={tool.image}
                                      alt={tool.name}
                                      title={`${tool.name} (${tool.percent}%)`}
                                      class="w-4 h-4 object-contain rounded-full bg-black/60 border border-white/10 p-0.5 relative"
                                      style={`z-index: ${tIdx + 1};`}
                                    />
