</SflToolLayout>

<script is:inline>
  // ---------------------------------------------------------------------------
  // Lógica interactiva en cliente (Pestañas, Buscador, Filtros de Boosts)
  // ---------------------------------------------------------------------------
  document.addEventListener("DOMContentLoaded", () => {
    // 1. Manejo de Pestañas de Animales (Pollos, Ovejas, Vacas, Cerdos)
    const tabBtns = document.querySelectorAll(".animal-tab-btn")
    const panels = document.querySelectorAll(".animal-panel")

    tabBtns.forEach((btn) => {
      btn.addEventListener("click", () => {
        const animalId = btn.getAttribute("data-animal-id")

        tabBtns.forEach((b) => {
          b.classList.remove("active", "bg-emerald-500/20", "text-emerald-400", "border-emerald-500/40")
          b.classList.add("bg-white/5", "text-white/50", "border-white/10")
        })

        btn.classList.add("active", "bg-emerald-500/20", "text-emerald-400", "border-emerald-500/40")
        btn.classList.remove("bg-white/5", "text-white/50", "border-white/10")

        panels.forEach((p) => {
          if (p.getAttribute("data-animal-id") === animalId) {
            p.classList.remove("hidden")
          } else {
            p.classList.add("hidden")
          }
        })
      })
    })

    // 2. Buscador rápido en la tabla
    const searchInput = document.getElementById("animalSearchInput")
    if (searchInput) {
      searchInput.addEventListener("input", (e) => {
        const query = (e.target.value || "").toLowerCase().trim()
        const activePanel = document.querySelector(".animal-panel:not(.hidden)")
        if (!activePanel) return

        const rows = activePanel.querySelectorAll(".animal-level-row")
        rows.forEach((row) => {
          const lvl = row.getAttribute("data-level") || ""
          const searchAttr = (row.getAttribute("data-search") || "").toLowerCase()
          const text = (row.textContent || "").toLowerCase()

          if (!query || lvl.includes(query) || searchAttr.includes(query) || text.includes(query)) {
            row.style.display = ""
          } else {
            row.style.display = "none"
          }
        })
      })
    }

    // 3. Filtros de Boosts (All, Drops, Time, Feed)
    const filterBtns = document.querySelectorAll(".animal-filter-boost-btn")
    const buffCards = document.querySelectorAll(".animal-buff-card, .animal-skill-card")

    filterBtns.forEach((btn) => {
      btn.addEventListener("click", () => {
        const filter = btn.getAttribute("data-filter")

        filterBtns.forEach((b) => {
          if (b.getAttribute("data-filter") === filter) {
            b.classList.add("active", "text-white", "bg-white/10")
            b.classList.remove("text-white/40")
          } else {
            b.classList.remove("active", "text-white", "bg-white/10")
            b.classList.add("text-white/40")
          }
        })

        buffCards.forEach((card) => {
          const cardEffects = (card.getAttribute("data-effect") || "").split(" ")
          if (filter === "all" || cardEffects.includes(filter)) {
            card.style.display = ""
          } else {
            card.style.display = "none"
          }
        })
      })
    })

    // 4. Conmutador de vista Detailed / Compact para Boosts
    const viewSwitchBtns = document.querySelectorAll(".animal-view-switch-btn")
    viewSwitchBtns.forEach((btn) => {
      btn.addEventListener("click", () => {
        const action = btn.getAttribute("data-action")

        viewSwitchBtns.forEach((b) => {
          if (b.getAttribute("data-action") === action) {
            b.classList.add("active", "text-white", "bg-white/10")
            b.classList.remove("text-white/40")
          } else {
            b.classList.remove("active", "text-white", "bg-white/10")
            b.classList.add("text-white/40")
          }
        })

        const normalViews = document.querySelectorAll(".normal-view")
        const compactViews = document.querySelectorAll(".compact-view")

        if (action === "compact") {
          normalViews.forEach((el) => el.classList.add("hidden"))
          compactViews.forEach((el) => el.classList.remove("hidden"))
        } else {
          normalViews.forEach((el) => el.classList.remove("hidden"))
          compactViews.forEach((el) => el.classList.add("hidden"))
        }
      })
    })

    // 5. Selector flotante de alimentos y recálculo en tiempo real
    const dataScript = document.getElementById("sflAnimalsData")
    if (dataScript) {
      try {
        const clientState = JSON.parse(dataScript.textContent || "{}")
        const dropdown = document.getElementById("sflFoodDropdown")
        let activeTrigger = null

        const closeDropdown = () => {
          if (dropdown) {
            dropdown.classList.add("hidden")
            dropdown.innerHTML = ""
          }
          activeTrigger = null
        }

        const openDropdown = (trigger, animalId, level) => {
          if (!dropdown) return
          if (activeTrigger === trigger) {
            closeDropdown()
            return
          }

          const animal = clientState.animals?.[animalId]
          if (!animal) return

          const lvlData = animal.levels?.find((l) => l.level === Number(level))
          if (!lvlData || !lvlData.options) return

          activeTrigger = trigger

          // Renderizar opciones minimalistas
          dropdown.innerHTML = `
            <div class="px-2 py-1 text-[10px] font-mono uppercase tracking-wider text-white/40 border-b border-white/5 flex items-center justify-between">
              <span>Alimento (Nivel ${lvlData.level})</span>
              <span class="text-[9px] text-emerald-400/80">Seleccionar</span>
            </div>
            <div class="flex flex-col gap-1 mt-1 max-h-64 overflow-y-auto no-scrollbar">
              ${lvlData.options
                .map((opt) => {
                  const isSelected = opt.id === lvlData.selectedFoodId
                  const isOptimal = opt.isOptimal
                  return `
                  <button
                    type="button"
                    class="food-option-btn text-left p-1.5 rounded-xl transition-all cursor-pointer border flex items-center justify-between gap-2 ${
                      isSelected
                        ? "bg-white/10 border-emerald-500/40 text-white"
                        : "bg-white/[0.02] border-transparent hover:bg-white/5 text-white/80"
                    }"
                    data-animal="${animalId}"
                    data-level="${level}"
                    data-food-id="${opt.id}"
                  >
                    <div class="flex items-center gap-2 min-w-0">
                      <div class="relative shrink-0 flex items-center justify-center w-6 h-6 rounded-lg bg-black/40 border border-white/10">
                        <img src="${opt.image}" alt="${opt.name}" class="w-4 h-4 object-contain" />
                        ${
                          opt.ingredientImage
                            ? `<img src="${opt.ingredientImage}" alt="" class="absolute -bottom-1 -right-1 w-2.5 h-2.5 object-contain drop-shadow" />`
                            : ""
                        }
                      </div>
                      <div class="flex flex-col min-w-0">
                        <div class="flex items-center gap-1.5 flex-wrap">
                          <span class="text-xs font-medium text-white truncate">${opt.name}</span>
                          ${
                            isOptimal
                              ? `<span class="text-[9px] font-mono px-1 py-0.2 rounded bg-emerald-500/20 text-emerald-300 border border-emerald-500/30">ÓPTIMO</span>`
                              : ""
                          }
                        </div>
                        <span class="text-[9px] font-mono text-white/40 truncate">${opt.ingredient || ""}</span>
                      </div>
                    </div>
                    <div class="flex flex-col items-end shrink-0 font-mono text-right">
                      <span class="text-[11px] font-bold text-emerald-400">+${opt.xp} XP</span>
                      <span class="text-[9px] text-white/50">${opt.costPerFeed.toFixed(4)} FL</span>
                    </div>
                  </button>
                `
                })
                .join("")}
            </div>
          `

          // Posicionamiento flotante seguro
          const rect = trigger.getBoundingClientRect()
          const menuWidth = 288
          let left = rect.left
          if (left + menuWidth > window.innerWidth - 12) {
            left = window.innerWidth - menuWidth - 12
          }
          if (left < 12) left = 12

          let top = rect.bottom + 6
          const menuHeight = 280
          if (top + menuHeight > window.innerHeight - 12) {
            top = Math.max(12, rect.top - menuHeight - 6)
          }

          dropdown.style.top = `${top}px`
          dropdown.style.left = `${left}px`
          dropdown.classList.remove("hidden")
        }

        const recalculateAnimalProgression = (animalId) => {
          const animal = clientState.animals?.[animalId]
          if (!animal || !animal.levels) return
          const boosts = animal.boosts || { food: 1, foodXp: 1, careMultiplier: 1, primaryDrop: 0, secondaryDrop: 0 }
          const targetLevel = animal.targetLevel || 15

          let currentCarryover = 0
          let totalAnimalProfitFlower = 0
          let totalAnimalProfitUsd = 0

          animal.levels.forEach((lvl) => {
            const isFirst = lvl.fromLevel === 0
            const receivedResidual = isFirst ? 0 : currentCarryover
            const xpReq = lvl.xpRequired

            // Cálculo dinámico de afecto con Care Multiplier (ej: 1.5 = +50% XP a las 3 care tools)
            const careMultiplier = boosts.careMultiplier !== undefined ? boosts.careMultiplier : 1
            let affectionXp = 0
            if (!lvl.isInstant && lvl.loveProb) {
              const p = lvl.loveProb
              const singleAffectionXp = ((p.petting * 10) + (p.brush * 20) + (p.music * 40)) * careMultiplier
              affectionXp = Math.round(singleAffectionXp * 2)
            } else {
              affectionXp = lvl.baseAffectionXp !== undefined ? Math.round(lvl.baseAffectionXp * careMultiplier) : 0
            }

            const chosenFood =
              lvl.options.find((opt) => opt.id === lvl.selectedFoodId) ||
              lvl.options.find((opt) => opt.isOptimal) ||
              lvl.options[0]

            // Multiplicador de Food XP
            const foodXpMultiplier = boosts.foodXp !== undefined ? boosts.foodXp : 1
            const unitFoodXp = Math.max(1, Math.round(chosenFood.xp * foodXpMultiplier))

            const neededFromFood = Math.max(0, xpReq - receivedResidual - affectionXp)
            const neededFeeds = Math.max(1, Math.ceil(neededFromFood / unitFoodXp))

            // Multiplicador de consumo de comida
            const foodMultiplier = boosts.food !== undefined ? boosts.food : 1
            const foodUnits = Math.round(neededFeeds * chosenFood.requiredPerFeed * foodMultiplier)

            const foodCostFlower = neededFeeds * chosenFood.costPerFeed * foodMultiplier
            const foodCostUsd = foodCostFlower * clientState.flowerUsd

            const totalFoodXp = neededFeeds * unitFoodXp
            const totalXpObtained = affectionXp + totalFoodXp
            const totalAvailable = receivedResidual + totalXpObtained
            const residualGenerated = Math.max(0, totalAvailable - xpReq)
            currentCarryover = residualGenerated

            // Cálculo dinámico de recursos con boosts
            let revenueFlower = 0
            const boostedResources = (lvl.baseResources || []).map((res) => {
              let amount = res.amount
              if (res.isPrimary && boosts.primaryDrop) amount += boosts.primaryDrop
              if (res.isSecondary && boosts.secondaryDrop) amount += boosts.secondaryDrop
              amount = Math.max(0, amount)
              revenueFlower += amount * res.unitPrice
              return {
                name: res.name,
                amount,
                image: res.image,
              }
            })
            const revenueUsd = revenueFlower * clientState.flowerUsd

            const profitFlower = revenueFlower - foodCostFlower
            const profitUsd = profitFlower * clientState.flowerUsd
            if (lvl.level <= targetLevel) {
              totalAnimalProfitFlower += profitFlower
              totalAnimalProfitUsd += profitUsd
            }

            // Formateadores
            const signFlower = profitFlower >= 0 ? "+" : ""
            const formattedProfitFlower = `${signFlower}${profitFlower.toFixed(4)} FL`
            const signUsd = profitUsd >= 0 ? "+" : "-"
            const formattedProfitUsd = `${signUsd}$${Math.abs(profitUsd).toFixed(4)} USD`

            // Actualizar filas de DOM
            const rows = document.querySelectorAll(
              `.animal-level-row[data-animal="${animalId}"][data-level="${lvl.level}"]`
            )
            rows.forEach((row) => {
              if (lvl.level > targetLevel) {
                row.classList.add("opacity-35")
              } else {
                row.classList.remove("opacity-35")
              }

              // 0. Affection XP
              const affectionXpEls = row.querySelectorAll(".row-affection-xp")
              affectionXpEls.forEach((el) => {
                el.textContent = `+${affectionXp} XP`
              })

              // 1. Food img & overlay
              const foodImgs = row.querySelectorAll(".row-food-img")
              foodImgs.forEach((img) => {
                img.src = chosenFood.image
                img.alt = chosenFood.name
              })
              const overlayWraps = row.querySelectorAll(".row-food-overlay-wrap")
              overlayWraps.forEach((wrap) => {
                if (chosenFood.ingredientImage) {
                  wrap.innerHTML = `<img src="${chosenFood.ingredientImage}" alt="${chosenFood.ingredientName || ""}" title="${chosenFood.ingredient}" class="absolute -bottom-1 -right-1 lg:-right-1.5 w-2.5 h-2.5 lg:w-3 lg:h-3 object-contain drop-shadow z-10" loading="lazy" />`
                  wrap.classList.remove("hidden")
                } else {
                  wrap.innerHTML = ""
                  wrap.classList.add("hidden")
                }
              })

              // 2. Food name
              const foodNameEls = row.querySelectorAll(".row-food-name")
              const unitsPrefix = foodUnits > 1 ? `${foodUnits}x ` : ""
              foodNameEls.forEach((el) => {
                el.textContent = `${unitsPrefix}${chosenFood.name}`
                el.title = chosenFood.ingredient
                  ? `${chosenFood.name} (${chosenFood.ingredient})`
                  : chosenFood.name
              })

              // 3. Food cost FLOWER & USD
              const foodFlowerEls = row.querySelectorAll(".row-food-flower")
              foodFlowerEls.forEach((el) => {
                el.textContent = foodCostFlower.toFixed(4)
              })
              const foodUsdEls = row.querySelectorAll(".row-food-usd")
              foodUsdEls.forEach((el) => {
                el.textContent = `$${foodCostUsd.toFixed(4)} USD`
              })

              // 4. XP Total
              const xpTotalEls = row.querySelectorAll(".row-xp-total")
              xpTotalEls.forEach((el) => {
                el.textContent = `+${totalAvailable} XP`
              })

              // 5. XP Breakdown
              const xpBreakdownEls = row.querySelectorAll(".row-xp-breakdown")
              const breakdownText = `${receivedResidual} ${clientState.resLabel} + ${affectionXp} ${clientState.affecLabel} + ${totalFoodXp} ${clientState.foodLabel}`
              xpBreakdownEls.forEach((el) => {
                el.textContent = breakdownText
                el.title = breakdownText
              })

              // 6. XP Surplus
              const xpSurplusEls = row.querySelectorAll(".row-xp-surplus")
              xpSurplusEls.forEach((el) => {
                el.textContent = `(${clientState.surplusLabel} +${residualGenerated} XP)`
              })

              // 7. Recursos Obtenidos (Amounts & Revenue)
              const resWraps = row.querySelectorAll(".row-resources-wrap")
              resWraps.forEach((wrap) => {
                wrap.innerHTML = boostedResources
                  .map(
                    (r) => `
                    <div class="flex items-center gap-1 bg-white/5 px-1.5 py-0.5 rounded-md border border-white/5">
                      <img src="${r.image}" alt="${r.name}" class="w-3.5 h-3.5 object-contain" />
                      <span class="text-[11px] font-mono font-bold text-white">${Number(r.amount.toFixed(2))}x</span>
                    </div>
                  `
                  )
                  .join("")
              })

              const yieldFlowerEls = row.querySelectorAll(".row-yield-flower")
              yieldFlowerEls.forEach((el) => {
                el.textContent = `+${revenueFlower.toFixed(4)}`
              })

              const yieldUsdEls = row.querySelectorAll(".row-yield-usd")
              yieldUsdEls.forEach((el) => {
                el.textContent = `+$${revenueUsd.toFixed(4)} USD`
              })

              // 8. Profit FLOWER & USD & Badge
              const profitFlowerEls = row.querySelectorAll(".row-profit-flower")
              profitFlowerEls.forEach((el) => {
                el.textContent = formattedProfitFlower
                if (profitFlower >= 0) {
                  el.classList.remove("text-rose-400")
                  el.classList.add("text-emerald-400")
                } else {
                  el.classList.remove("text-emerald-400")
                  el.classList.add("text-rose-400")
                }
              })

              const profitUsdEls = row.querySelectorAll(".row-profit-usd")
              profitUsdEls.forEach((el) => {
                el.textContent = formattedProfitUsd
                if (profitUsd >= 0) {
                  el.classList.remove("text-rose-400", "text-rose-400/80")
                  el.classList.add("text-emerald-400", "text-emerald-400/80")
                } else {
                  el.classList.remove("text-emerald-400", "text-emerald-400/80")
                  el.classList.add("text-rose-400", "text-rose-400/80")
                }
              })

              const profitBadges = row.querySelectorAll(".row-profit-badge")
              profitBadges.forEach((badge) => {
                if (profitFlower >= 0) {
                  badge.classList.remove("bg-rose-500/10", "border-rose-500/20", "text-rose-400")
                  badge.classList.add("bg-emerald-500/10", "border-emerald-500/20", "text-emerald-400")
                } else {
                  badge.classList.remove("bg-emerald-500/10", "border-emerald-500/20", "text-emerald-400")
                  badge.classList.add("bg-rose-500/10", "border-rose-500/20", "text-rose-400")
                }
              })
            })
          })

          // Actualizar cuadro de Profit Total Acumulado en el extremo derecho
          const totalFlowerEl = document.querySelector(`.animal-total-profit-flower[data-animal="${animalId}"]`)
          const totalUsdEl = document.querySelector(`.animal-total-profit-usd[data-animal="${animalId}"]`)
          const totalBadgeEl = document.querySelector(`.animal-total-profit-badge[data-animal="${animalId}"]`)

          if (totalFlowerEl) {
            const signFlower = totalAnimalProfitFlower >= 0 ? "+" : ""
            totalFlowerEl.textContent = `${signFlower}${totalAnimalProfitFlower.toFixed(4)} FL`
          }
          if (totalUsdEl) {
            const signUsd = totalAnimalProfitUsd >= 0 ? "+" : "-"
            totalUsdEl.textContent = `${signUsd}$${Math.abs(totalAnimalProfitUsd).toFixed(4)} USD`
          }
          if (totalBadgeEl) {
            if (totalAnimalProfitFlower >= 0) {
              totalBadgeEl.classList.remove("bg-rose-500/10", "border-rose-500/20", "text-rose-400")
              totalBadgeEl.classList.add("bg-emerald-500/10", "border-emerald-500/20", "text-emerald-400")
            } else {
              totalBadgeEl.classList.remove("bg-emerald-500/10", "border-emerald-500/20", "text-emerald-400")
              totalBadgeEl.classList.add("bg-rose-500/10", "border-rose-500/20", "text-rose-400")
            }
          }

          // Actualizar UI del Nivel Objetivo (Título, Indicador de Nivel, Barra de Progreso y Puntos)
          const titleEl = document.querySelector(`.animal-total-profit-title[data-animal="${animalId}"]`)
          if (titleEl) {
            titleEl.textContent = `${clientState.totalProfitLabel || "Profit Total"} (Lvl 1-${targetLevel})`
          }
          const targetNumEl = document.querySelector(`.target-level-number[data-animal="${animalId}"]`)
          if (targetNumEl) {
            targetNumEl.textContent = `Lvl ${targetLevel}`
          }
          const progressBar = document.querySelector(`.target-level-progress-bar[data-animal="${animalId}"]`)
          if (progressBar) {
            const pct = Math.max(0, Math.min(100, ((targetLevel - 1) / 14) * 100))
            progressBar.style.width = `${pct}%`
          }
          const dots = document.querySelectorAll(`.target-level-dot[data-animal="${animalId}"]`)
          dots.forEach((dot) => {
            const dLvl = Number(dot.getAttribute("data-target-level"))
            if (dLvl === targetLevel) {
              dot.className =
                "target-level-dot relative z-10 w-4 h-4 sm:w-5 sm:h-5 rounded-full flex items-center justify-center transition-all cursor-pointer font-mono text-[9px] font-bold select-none focus:outline-none bg-emerald-400 text-black border-2 border-emerald-500 ring-2 ring-emerald-400/50 scale-110 shadow-sm shadow-emerald-500/50"
            } else if (dLvl < targetLevel) {
              dot.className =
                "target-level-dot relative z-10 w-4 h-4 sm:w-5 sm:h-5 rounded-full flex items-center justify-center transition-all cursor-pointer font-mono text-[9px] font-bold select-none focus:outline-none bg-emerald-500/80 text-black border border-emerald-400/60 hover:scale-110"
            } else {
              dot.className =
                "target-level-dot relative z-10 w-4 h-4 sm:w-5 sm:h-5 rounded-full flex items-center justify-center transition-all cursor-pointer font-mono text-[9px] font-bold select-none focus:outline-none bg-white/10 text-white/30 border border-white/20 hover:bg-white/20 hover:text-white"
            }
          })
        }

        // Manejador de cambios en los inputs de Boosts del animal
        document.addEventListener("input", (e) => {
          const input = e.target.closest(".animal-boost-input")
          if (!input) return
          const animalId = input.getAttribute("data-animal")
          const boostType = input.getAttribute("data-boost-type")
          const rawVal = parseFloat(input.value)

          const animal = clientState.animals?.[animalId]
          if (!animal) return
          if (!animal.boosts) {
            animal.boosts = { food: 1, foodXp: 1, careMultiplier: 1, primaryDrop: 0, secondaryDrop: 0 }
          }

          if (boostType === "food") {
            animal.boosts.food = isNaN(rawVal) || rawVal < 0 ? 1 : rawVal
          } else if (boostType === "foodXp") {
            animal.boosts.foodXp = isNaN(rawVal) || rawVal < 0.1 ? 1 : rawVal
          } else if (boostType === "careMultiplier") {
            animal.boosts.careMultiplier = isNaN(rawVal) || rawVal < 0.1 ? 1 : rawVal
          } else if (boostType === "primaryDrop") {
            animal.boosts.primaryDrop = isNaN(rawVal) || rawVal < 0 ? 0 : rawVal
          } else if (boostType === "secondaryDrop") {
            animal.boosts.secondaryDrop = isNaN(rawVal) || rawVal < 0 ? 0 : rawVal
          }

          recalculateAnimalProgression(animalId)
        })

        // Delegación de eventos para clicks
        document.addEventListener("click", (e) => {
          const dotBtn = e.target.closest(".target-level-dot")
          if (dotBtn) {
            e.stopPropagation()
            const animalId = dotBtn.getAttribute("data-animal")
            const newTarget = Number(dotBtn.getAttribute("data-target-level"))
            const animal = clientState.animals?.[animalId]
            if (animal && newTarget >= 1 && newTarget <= 15) {
              animal.targetLevel = newTarget
              recalculateAnimalProgression(animalId)
            }
            return
          }

          const trigger = e.target.closest(".food-selector-trigger")
          if (trigger) {
            e.stopPropagation()
            const animalId = trigger.getAttribute("data-animal")
            const level = trigger.getAttribute("data-level")
            openDropdown(trigger, animalId, level)
            return
          }

          const optionBtn = e.target.closest(".food-option-btn")
          if (optionBtn) {
            e.stopPropagation()
            const animalId = optionBtn.getAttribute("data-animal")
            const level = Number(optionBtn.getAttribute("data-level"))
            const foodId = optionBtn.getAttribute("data-food-id")

            const animal = clientState.animals?.[animalId]
            if (animal) {
              const lvlObj = animal.levels?.find((l) => l.level === level)
              if (lvlObj) {
                lvlObj.selectedFoodId = foodId
                recalculateAnimalProgression(animalId)
              }
            }
            closeDropdown()
            return
          }

          // Clic fuera del menú
          if (dropdown && !dropdown.contains(e.target)) {
            closeDropdown()
          }
        })

        // Cerrar con Escape, scroll o resize
        window.addEventListener("keydown", (e) => {
          if (e.key === "Escape") closeDropdown()
        })
        window.addEventListener("scroll", closeDropdown, { passive: true })
        window.addEventListener("resize", closeDropdown, { passive: true })
      } catch (err) {
        console.error("Error al inicializar el selector de alimentos:", err)
      }
    }
  })
</script>
