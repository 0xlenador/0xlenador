// Vista pura para la herramienta de animales de Sunflower Land.
// Fuente única de verdad consumida por /sfl-animales/ y /en/sfl-animals/.
// El idioma se detecta dinámicamente desde la URL vía getLangFromUrl.
// ============================================================
import { getEntry } from "astro:content"
import { getLangFromUrl, useTranslations } from "../../i18n/utils"
import SflToolLayout from "../SflToolLayout.astro"
import FaqAccordion from "../FaqAccordion.astro"
import fs from "node:fs"
import path from "node:path"

import animalsDataRaw from "../../content/data/sfl/animals/animals.json"
import buildingsDataRaw from "../../content/data/sfl/animals/buildings.json"
import consumablesDataRaw from "../../content/data/sfl/animals/consumables.json"
import sflResourcesJson from "../../content/data/sfl/resources.json"
import { calculateGemCostUsd } from "../../lib/sfl/market"

// Lectura de precios P2P en FLOWER y USD desde sfl_data.json
const marketPrices: Record<string, number> = {}
let flowerUsd = 0.1388

try {
  const sflDataPath = path.resolve(process.cwd(), "public/api/sfl_data.json")
  if (fs.existsSync(sflDataPath)) {
    const sflData = JSON.parse(fs.readFileSync(sflDataPath, "utf8"))
    flowerUsd = Number(sflData.flowerPrice) || 0.1388
    if (sflData.items) {
      Object.values(sflData.items).forEach((item: any) => {
        const colMatch = item.key?.match(/(?:collectibles|resources)-(\d+)$/)
        if (colMatch && (sflResourcesJson as any)[colMatch[1]]) {
          marketPrices[(sflResourcesJson as any)[colMatch[1]]] = item.currentPrice || 0
        }
      })
    }
  }
} catch (e) {
  console.error("Error leyendo sfl_data.json en build:", e)
}

// Costo de 1 Gema en FLOWER (para Omnifeed)
const gemCostUsd = calculateGemCostUsd(1).unitUsd
const gemFlowerPrice = flowerUsd > 0 ? gemCostUsd / flowerUsd : 0

const sflPowerUpsEntry = await getEntry("sfl", "powerups")
const sflSkillsEntry = await getEntry("sfl", "skills")

const sflPowerUpsData = sflPowerUpsEntry?.data?.power_ups || { collectibles: {}, wearables: {} }
const sflAnimalsSkills = sflSkillsEntry?.data?.Animals || {}

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)

// ---------------------------------------------------------------------------
// Filtrado de PowerUps de Animales (Collectibles y Wearables)
// ---------------------------------------------------------------------------
interface AnimalBuffItem {
  id: string
  name: string
  boost: string
  category: "collectibles" | "wearables"
  isWearable: boolean
  image: string
  effectType: string
}

const getEffectType = (desc: string) => {
  if (!desc) return "other"
  const d = desc.toLowerCase()
  const effects: string[] = []
  if (
    d.includes("yield") ||
    d.includes("produce") ||
    d.includes("egg") ||
    d.includes("milk") ||
    d.includes("wool") ||
    d.includes("feather") ||
    d.includes("leather") ||
    d.includes("merino") ||
    d.includes("truffle") ||
    d.includes("mud")
  ) {
    effects.push("drops")
  }
  if (d.includes("sleep") || d.includes("time") || d.includes("wake") || d.includes("speed")) {
    effects.push("time")
  }
  if (
    d.includes("feed") ||
    d.includes("cost") ||
    d.includes("free") ||
    d.includes("grain") ||
    d.includes("slop") ||
    d.includes("xp")
  ) {
    effects.push("feed")
  }
  return effects.length > 0 ? effects.join(" ") : "other"
}

const isAnimalBuff = (name: string, boost: string) => {
  const n = (name || "").toLowerCase()
  const b = (boost || "").toLowerCase()
  const full = `${n} ${b}`

  if (
    n.includes("eggplant") ||
    b.includes("eggplant") ||
    n.includes("banana") ||
    n.includes("oil") ||
    n.includes("paw aura") ||
    n.includes("victoria's apron")
  ) {
    return false
  }

  return (
    full.includes("animal") ||
    full.includes("chicken") ||
    full.includes("sheep") ||
    full.includes("cow") ||
    full.includes("pig") ||
    full.includes("egg") ||
    full.includes("wool") ||
    full.includes("milk") ||
    full.includes("feather") ||
    full.includes("leather") ||
    full.includes("merino") ||
    full.includes("mud") ||
    full.includes("truffle") ||
    full.includes("barn") ||
    full.includes("hen house") ||
    full.includes("bale")
  )
}

const animalBuffs: AnimalBuffItem[] = []

for (const cat of ["collectibles", "wearables"] as const) {
  const group = sflPowerUpsData[cat] || {}
  for (const [id, item] of Object.entries(group) as [string, any][]) {
    if (isAnimalBuff(item.name, item.boost)) {
      animalBuffs.push({
        id,
        name: item.name,
        boost: item.boost,
        category: cat,
        isWearable: cat === "wearables",
        image: item.image,
        effectType: getEffectType(item.boost),
      })
    }
  }
}

