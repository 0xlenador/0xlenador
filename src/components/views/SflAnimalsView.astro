---
// ============================================================
// src/components/views/SflAnimalsView.astro
// Vista modular para la herramienta de animales de Sunflower Land.
// Fuente única de verdad consumida por /sfl-animales/ y /en/sfl-animals/.
// ============================================================
import fs from "node:fs"
import path from "node:path"

import { getLangFromUrl, useTranslations } from "../../i18n/utils"
import SflToolLayout from "../SflToolLayout.astro"
import FaqAccordion from "../FaqAccordion.astro"
import SflBoostsConfig from "../sfl/common/SflBoostsConfig.astro"
import SflAnimalsDashboard from "../sfl/animals/SflAnimalsDashboard.astro"
import SflAnimalsSummaryCard from "../sfl/animals/SflAnimalsSummaryCard.astro"
import SflAnimalsTable from "../sfl/animals/SflAnimalsTable.astro"

import sflResourcesJson from "../../content/data/sfl/resources.json"
import bettyPricesJson from "../../content/data/sfl/betty_prices.json"
import { OFFICIAL_COINS_PER_FLOWER } from "../../lib/sfl/constants"
import {
  ORDERED_ANIMAL_IDS,
  calculateAnimalProgression,
  getTreatUnitPrices,
  type AnimalId,
} from "../../lib/sfl/animals"

// 1. Lectura de snapshot de mercado en build para renderizado SSR inicial
const marketPrices: Record<string, number> = {}
let flowerUsd = 0.1388
let bettyRatio = OFFICIAL_COINS_PER_FLOWER

try {
  const sflDataPath = path.resolve(process.cwd(), "public/api/sfl_data.json")
  if (fs.existsSync(sflDataPath)) {
    const sflData = JSON.parse(fs.readFileSync(sflDataPath, "utf8"))
    flowerUsd = Number(sflData.flowerPrice) || 0.1388
    if (sflData.items) {
      Object.values(sflData.items).forEach((item: any) => {
        const colMatch = item.key?.match(/(?:collectibles|resources)-(\d+)$/)
        if (colMatch && (sflResourcesJson as any)[colMatch[1]]) {
          marketPrices[(sflResourcesJson as any)[colMatch[1]]] = item.currentPrice || 0
        }
      })
    }
  }
} catch (e) {
  console.error("Error leyendo sfl_data.json en build:", e)
}

// Tasa Betty óptima inicial
let maxCoinsPerFlower = 0
Object.entries(bettyPricesJson as Record<string, { sellPrice: number }>).forEach(
  ([cropName, info]) => {
    const p2pPrice = marketPrices[cropName]
    if (p2pPrice && p2pPrice > 0 && info?.sellPrice > 0) {
      const ratio = info.sellPrice / p2pPrice
      if (ratio > maxCoinsPerFlower) maxCoinsPerFlower = ratio
    }
  },
)
if (maxCoinsPerFlower > 0) bettyRatio = maxCoinsPerFlower

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)

const tabLabels: Record<AnimalId, string> = {
  chicken: t("sfl.animals.tabs.chickens"),
  sheep: t("sfl.animals.tabs.sheep"),
  cow: t("sfl.animals.tabs.cows"),
  pig: t("sfl.animals.tabs.pigs"),
}

// 2. Calcular progresiones SSR iniciales con el motor SSOT animals.ts
const progressions = ORDERED_ANIMAL_IDS.map((animalId) =>
  calculateAnimalProgression(animalId, {
    marketPrices,
    flowerPriceUsd: flowerUsd,
    coinsPerFlower: bettyRatio,
  }),
)

const treatPrices = getTreatUnitPrices(marketPrices, flowerUsd, bettyRatio)

const bootPayload = {
  marketPrices,
  flowerUsd,
  bettyRatio,
  tabLabels,
  labels: {
    resLabel: t("sfl.animals.table.xpResLabel"),
    affecLabel: t("sfl.animals.table.xpAffecLabel"),
    foodLabel: t("sfl.animals.table.xpFoodLabel"),
    surplusLabel: t("sfl.animals.table.surplus"),
    totalProfitLabel: t("sfl.animals.card.totalProfit"),
    levelPrefix: t("sfl.animals.card.levelPrefix"),
    dropdownFoodLabel: t("sfl.animals.dropdown.food"),
    levelLabel: t("sfl.animals.dropdown.level"),
    selectLabel: t("sfl.animals.dropdown.select"),
    optimalLabel: t("sfl.animals.dropdown.optimal"),
    honeyTreatPickLevel: t("sfl.animals.card.honeyTreatPickLevel"),
    honeyTreatNoLvl1: t("sfl.animals.card.honeyTreatNoLvl1"),
    honeyShort: t("sfl.animals.card.honeyShort"),
    treatHoneyLabel: t("sfl.animals.card.treatHoneyLabel"),
    treatSaltLabel: t("sfl.animals.card.treatSaltLabel"),
    treatTruffleLabel: t("sfl.animals.card.treatTruffleLabel"),
    treatSaltShort: t("sfl.animals.card.treatSaltShort"),
    treatTruffleShort: t("sfl.animals.card.treatTruffleShort"),
    noBoostsActive: t("sfl.animals.dash.noBoostsActive"),
    roiLabel: t("sfl.animals.dash.roiLabel"),
    feedsUnit: t("sfl.animals.dash.feedsUnit"),
    honeyTreatBtn: t("sfl.animals.card.honeyTreatBtn"),
  },
}

const faqItems = [
  { pregunta: t("sfl.animals.faq.q1"), respuesta: t("sfl.animals.faq.a1") },
  { pregunta: t("sfl.animals.faq.q2"), respuesta: t("sfl.animals.faq.a2") },
  { pregunta: t("sfl.animals.faq.q3"), respuesta: t("sfl.animals.faq.a3") },
  { pregunta: t("sfl.animals.faq.q4"), respuesta: t("sfl.animals.faq.a4") },
]
---

<SflToolLayout activeTab="animales">
  <!-- Encabezado Principal -->
  <div class="mb-5 relative z-10 text-center sm:text-left">
    <h1 class="text-3xl md:text-4xl font-black text-white tracking-tighter mb-2">
      {t("sfl.animals.heading")}
      <span class="text-emerald-500"> {t("sfl.animals.heading.accent")}</span>
    </h1>
    <p class="text-terminal-secondary text-sm leading-relaxed max-w-3xl">
      {t("sfl.animals.intro")}
    </p>
  </div>

  <!-- Dashboard Hero Operativo en Vivo -->
  <SflAnimalsDashboard
    initialProgressions={progressions}
    tabLabels={tabLabels}
    flowerUsd={flowerUsd}
    bettyRatio={bettyRatio}
    treatPrices={treatPrices}
  />

  <!-- Configuración Centralizada de Skills, Collectibles, Wearables, Shrines y Perks -->
  <div class="mb-8">
    <SflBoostsConfig domain="animals" idPrefix="animals-boosts" />
  </div>

  <!-- Pestañas de Especies y Buscador -->
  <div
    class="sticky top-0 z-40 bg-terminal-bg/95 backdrop-blur-md py-4 border-b border-white/5 mb-6 -mx-4 px-4 sm:mx-0 sm:px-0 sm:bg-transparent sm:border-0 sm:static sm:py-0"
  >
    <div
      class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 relative z-10"
    >
      <div
        class="flex gap-2 overflow-x-auto w-full sm:w-auto pb-2 sm:pb-0 no-scrollbar snap-x"
        id="animalTabsContainer"
      >
        {
          progressions.map((animal, idx) => (
            <button
              type="button"
              class:list={[
                "animal-tab-btn snap-start px-4 py-2 rounded-xl text-xs font-bold uppercase tracking-wider transition-all whitespace-nowrap shrink-0 flex items-center gap-2 cursor-pointer",
                idx === 0
                  ? "active bg-emerald-500/20 text-emerald-400 border border-emerald-500/40 shadow-sm"
                  : "bg-white/5 text-white/50 border border-white/10 hover:bg-white/10 hover:text-white",
              ]}
              data-animal-id={animal.animalId}
            >
              <img
                src={animal.icon}
                alt={tabLabels[animal.animalId] || animal.name}
                class="w-5 h-5 object-contain drop-shadow"
                loading="lazy"
                decoding="async"
              />
              <span>{tabLabels[animal.animalId] || animal.name}</span>
            </button>
          ))
        }
      </div>

      <div class="relative w-full sm:w-72 shrink-0 md:ml-auto">
        <input
          type="text"
          id="animalSearchInput"
          placeholder={t("sfl.animals.search.placeholder")}
          class="input-premium w-full rounded-xl px-4 py-2 text-sm placeholder-white/30 font-mono"
        />
      </div>
    </div>
  </div>

  <!-- Vista por Especie (SummaryCard + Tabla) -->
  <div id="animalsViewsWrapper" class="relative z-10">
    {
      progressions.map((animal, idx) => (
        <div
          id={`animal-panel-${animal.animalId}`}
          class:list={["animal-panel flex flex-col gap-6", idx === 0 ? "" : "hidden"]}
          data-animal-id={animal.animalId}
        >
          <SflAnimalsSummaryCard
            animal={animal}
            tabLabel={tabLabels[animal.animalId] || animal.name}
          />
          <SflAnimalsTable animal={animal} />
        </div>
      ))
    }
  </div>

  <!-- Dropdown Flotante de Selección de Alimento -->
  <div
    id="sflFoodDropdown"
    class="fixed hidden z-50 bg-terminal-surface/98 border border-terminal-border rounded-2xl p-2 shadow-2xl backdrop-blur-xl max-h-80 overflow-y-auto no-scrollbar w-72 flex flex-col gap-1.5 transition-all duration-150"
    style="box-shadow: 0 20px 40px -15px rgba(0,0,0,0.9);"
  >
  </div>

  <script id="sflAnimalsBootData" type="application/json" set:html={JSON.stringify(bootPayload)} />

  <div slot="footer" class="mt-12">
    <FaqAccordion
      titulo={t("sfl.animals.faq.title")}
      subtitulo={t("sfl.animals.faq.subtitle")}
      items={faqItems}
    />
  </div>
</SflToolLayout>

<script>
  import * as SflMarket from "../../lib/sfl/market"
  import { SflUserState } from "../../lib/sfl/state"
  import { SflAnimals } from "../../lib/sfl/animals"
  import { initAnimalsView } from "../../lib/sfl/animalsClient"

  if (typeof window !== "undefined") {
    ;(window as any).SflMarket = SflMarket
    ;(window as any).SflUserState = SflUserState
    ;(window as any).SflAnimals = SflAnimals
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initAnimalsView)
  } else {
    initAnimalsView()
  }
  document.addEventListener("astro:page-load", initAnimalsView)
</script>
