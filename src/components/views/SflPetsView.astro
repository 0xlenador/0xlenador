        <h2 class="text-2xl font-black text-white flex items-center gap-2">
          <i class="bi bi-bank text-cyan-400"></i> {t('sfl.pets.shrines.title')}
        </h2>
        <div class="text-[11px] text-white/40 italic sm:mb-1">
          {t('sfl.pets.shrines.no.acorn')} <strong class="text-white/60">Acorn</strong>
        </div>
      </div>
      
      <div class="overflow-x-auto no-scrollbar">
        <table class="w-full text-left border-collapse min-w-[500px]">
          <thead>
            <tr class="border-b border-white/10 text-[10px] uppercase tracking-widest text-white/40">
              <th class="p-4 font-mono w-2/5">{t('sfl.pets.shrines.col.altar')}</th>
              <th class="p-4 font-mono w-2/5">{t('sfl.pets.shrines.col.resources')}</th>
              <th class="p-4 font-mono text-right w-1/5">{t('sfl.pets.shrines.col.cost')}</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-white/5">
            {sflPets.shrines.map(shrine => (
              <tr class="hover:bg-white/[0.03] transition-colors group">
                <td class="p-4 align-top">
                  <div class="flex items-start gap-3">
                    <img src={`/img/sunflowerland/shrines/${shrine.name.toLowerCase().replace(' ', '_')}.webp`} class="w-10 h-10 object-contain drop-shadow-lg" onerror="this.onerror=null; this.src='/img/cripto/sunflowerland.webp';" />
                    <div>
                      <h3 class="text-sm font-bold text-cyan-300 leading-tight">{shrine.name}</h3>
                      <p class="text-[11px] text-terminal-muted mt-1 leading-relaxed max-w-[200px]">{shrine.effects}</p>
                    </div>
                  </div>
                </td>
                <td class="p-4 align-top">
                  <div class="flex flex-col gap-2">
                    {shrine.resources.map(res => (
                      <div class="flex items-center gap-2">
                        <img src={getResourceImg(res.name)} class="w-4 h-4 object-contain" onerror="this.onerror=null; this.src='/img/cripto/sunflowerland.webp';" />
                        <span class="text-xs text-white/80">{res.name} <span class="text-white/40 font-mono">({res.amount})</span></span>
                      </div>
                    ))}
                  </div>
                </td>
                <td class="p-4 align-top text-right">
                  <div class="flex items-center justify-end gap-1.5" set:html={getShrineCostHtml(shrine)}></div>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>

  </main>

<script is:inline define:vars={{ foodCostsDict, calcResources, priceDict, maxRPE, tAcornTip: t('sfl.pets.calc.acorn.tip'), tFossilTip: t('sfl.pets.calc.fossil.tip'), tNA: t('sfl.pets.calc.na.info'), tCost: t('sfl.pets.calc.cost.label'), tLoss: t('sfl.pets.calc.loss'), tPlaceholder: t('sfl.pets.calc.select.placeholder') }}>
  const formatPriceNum = (num) => {
    if (num === 0) return '0.00';
    return new Intl.NumberFormat('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 4 }).format(num);
  };

  const updateCalculator = () => {
    // 1. Calcular multiplicadores
    const walrusActive = document.getElementById('toggle-walrus')?.checked;
    const extraEnergy = walrusActive ? 5 : 0;
    
    const energies = { easy: 20 + extraEnergy, medium: 100 + extraEnergy, hard: 300 + extraEnergy };
    
    // 2. Actualizar etiquetas visuales de energía
    const headerEasy = document.getElementById('header-easy-energy');
    if (headerEasy) headerEasy.innerText = `${energies.easy}⚡`;
    const headerMedium = document.getElementById('header-medium-energy');
    if (headerMedium) headerMedium.innerText = `${energies.medium}⚡`;
    const headerHard = document.getElementById('header-hard-energy');
    if (headerHard) headerHard.innerText = `${energies.hard}⚡`;

    // 3. Re-calcular checks de rentabilidad (✓) en los menús desplegables
    ['easy', 'medium', 'hard'].forEach(diff => {
      const currentEnergy = energies[diff];
      const list = document.getElementById(`list-${diff}`);
      if (list) {
        list.querySelectorAll('.dropdown-option').forEach(opt => {
          const check = opt.querySelector('.profitable-check');
          if (!check) return;
          const cost = parseFloat(opt.getAttribute('data-cost'));
          if (isNaN(cost)) {
            check.classList.add('hidden');
          } else {
            const cpe = cost / currentEnergy;
            if (cpe <= maxRPE) {
              check.classList.remove('hidden');
            } else {
              check.classList.add('hidden');
            }
          }
        });
      }

      // También actualizar el check del item actualmente seleccionado en el botón principal
      const dropdown = document.querySelector(`[data-id="calc-select-${diff}"]`);
      if (dropdown) {
        const selectedCost = parseFloat(dropdown.getAttribute('data-cost'));
        const check = dropdown.querySelector('.dropdown-selected-text .profitable-check');
        if (check) {
          if (isNaN(selectedCost)) {
            check.classList.add('hidden');
          } else {
            const cpe = selectedCost / currentEnergy;
            if (cpe <= maxRPE) check.classList.remove('hidden');
            else check.classList.add('hidden');
          }
        }
      }
    });

    // 4. Obtener las comidas seleccionadas
    const selectedFoods = {
      easy: document.querySelector('[data-id="calc-select-easy"]').getAttribute('data-value') || "",
      medium: document.querySelector('[data-id="calc-select-medium"]').getAttribute('data-value') || "",
      hard: document.querySelector('[data-id="calc-select-hard"]').getAttribute('data-value') || ""
    };
    
    // 5. Recalcular las ganancias y ROI para cada recurso
    calcResources.forEach(res => {
      const resPrice = priceDict[res.name] || 0;
      const safeId = res.name.replace(/\s+/g, '_');
      
      ['easy', 'medium', 'hard'].forEach(diff => {
        const cell = document.getElementById(`calc-res-${safeId}-${diff}`);
        if (!cell) return;
        
        if (!selectedFoods[diff]) {
          cell.innerHTML = '<span class="text-[10px] text-white/20 italic">-</span>';
          return;
        }
        
        if (res.name === 'Acorn') {
          cell.innerHTML = `<span class="text-[10px] text-emerald-500/70 italic block mt-1">${tAcornTip}</span>`;
          return;
        }
        
        if (res.name === 'Fossil Shell') {
          cell.innerHTML = `<span class="text-[10px] text-cyan-500/70 italic block mt-1">${tFossilTip}</span>`;
          return;
        }
        
        const foodCost = foodCostsDict[selectedFoods[diff]];
        if (foodCost === null || foodCost === undefined || resPrice === 0) {
          cell.innerHTML = `<span class="text-[10px] text-yellow-500/50 italic">${tNA}</span>`;
          return;
        }
        
        const cpe = foodCost / energies[diff];
        const obtainCost = res.energy * cpe;
        
        const ratio = (resPrice / obtainCost) * 100;
        const roi = ((resPrice - obtainCost) / obtainCost) * 100;
        
        const isProfitable = roi >= 0;
        const roiFormatted = new Intl.NumberFormat('en-US', { maximumFractionDigits: 0 }).format(Math.abs(roi));
        const sign = isProfitable ? '+' : '-';
        
        const colorClass = isProfitable ? 'bg-emerald-400 shadow-[0_0_8px_rgba(52,211,153,0.6)]' : 'bg-red-500/80';
        const textClass = isProfitable ? 'text-emerald-400' : 'text-red-400';
        
        const barWidth = Math.min(ratio, 500);
        
        cell.innerHTML = `
          <div class="w-full flex flex-col gap-1 px-4">
            <div class="flex justify-between items-end">
              <span class="text-[10px] text-white/50">${tCost} <span class="text-white/80">${formatPriceNum(obtainCost)}</span></span>
              <span class="text-[11px] font-mono font-bold ${textClass}">${sign}${roiFormatted}% ${!isProfitable ? `<span class="text-[9px] font-sans opacity-70 italic ml-0.5">${tLoss}</span>` : ''}</span>
            </div>
            <div class="w-full h-1.5 bg-black/40 rounded-full overflow-hidden border border-white/10 relative">
              <!-- Punto de equilibrio al 100% de ratio (20% visual) -->
              <div class="absolute top-0 bottom-0 left-[20%] w-[1px] bg-white/40 z-10"></div>
              <div class="h-full ${colorClass} rounded-full transition-all duration-500 relative z-0" style="width: ${barWidth / 5}%;"></div>
            </div>
          </div>
        `;
      });
    });
  };

  document.addEventListener('DOMContentLoaded', () => {
    // Inicializar Custom Dropdowns
    document.querySelectorAll('.custom-dropdown').forEach(dropdown => {
      const toggle = dropdown.querySelector('.dropdown-toggle');
      const menu = dropdown.querySelector('.dropdown-menu');
      const selectedText = dropdown.querySelector('.dropdown-selected-text');
      const options = dropdown.querySelectorAll('.dropdown-option');
      const arrow = dropdown.querySelector('.dropdown-arrow');
      
      toggle.addEventListener('click', (e) => {
        e.stopPropagation();
        // Cerrar todos los demás menús primero
        document.querySelectorAll('.dropdown-menu').forEach(m => {
          if (m !== menu) {
            m.classList.add('hidden');
            m.parentElement.querySelector('.dropdown-arrow')?.classList.remove('rotate-180');
          }
        });
        menu.classList.toggle('hidden');
        arrow.classList.toggle('rotate-180');
      });
      
      options.forEach(option => {
        option.addEventListener('click', (e) => {
          e.stopPropagation();
          const val = option.getAttribute('data-value');
          dropdown.setAttribute('data-value', val);
          
          if (val === "") {
            selectedText.innerHTML = `<span class="text-white/40">${tPlaceholder}</span>`;
            dropdown.removeAttribute('data-cost');
          } else {
            // Copiar todo el html interno de la opción (imagen + texto + precio)
            selectedText.innerHTML = option.innerHTML;
            const cost = option.getAttribute('data-cost');
            dropdown.setAttribute('data-cost', cost);
          }
          
          menu.classList.add('hidden');
          arrow.classList.remove('rotate-180');
          
          // Refrescar cálculos
          updateCalculator();
        });
      });
    });
    
    // Cerrar menús si el usuario hace click afuera
    document.addEventListener('click', () => {
      document.querySelectorAll('.dropdown-menu').forEach(menu => {
        menu.classList.add('hidden');
        menu.parentElement.querySelector('.dropdown-arrow')?.classList.remove('rotate-180');
      });
    });

    // Escuchar cambios en los multiplicadores
    const walrusToggle = document.getElementById('toggle-walrus');
    if (walrusToggle) {
      walrusToggle.addEventListener('change', updateCalculator);
    }

    // Calcular en la carga por si hay valores por defecto
    updateCalculator();
  });
</script>

