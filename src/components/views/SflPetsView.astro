---
// ============================================================
// src/components/views/SflPetsView.astro
// View puro para la herramienta de mascotas SFL.
// ============================================================
import { getEntry } from 'astro:content';
import fs from 'fs';
import path from 'path';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import SflTabs from '../SflTabs.astro';

const sflPetsEntry = await getEntry("sfl", "pets");
const sflRecipesEntry = await getEntry("sfl", "recipes");
const sflIdsEntry = await getEntry("sfl", "resources");

const sflPets = sflPetsEntry.data;
const sflRecipes = sflRecipesEntry.data;
const sflIds = sflIdsEntry.data;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const getResourceImg = (name) => {
  if (name === 'Acorn' || name === 'Fossil Shell') return `/img/sunflowerland/123/${name}.webp`;
  return `/img/sunflowerland/${name}.png`;
};

// -------------------------------------------------------------
// Lógica de cálculo estático (Server-side / Build-time)
// -------------------------------------------------------------
let priceDict = {};
try {
  const sflDataPath = path.resolve(process.cwd(), 'public/api/sfl_data.json');
  const sflData = JSON.parse(fs.readFileSync(sflDataPath, 'utf8'));
  
  if (sflData.items) {
    Object.values(sflData.items).forEach(data => {
      const colMatch = data.key.match(/collectibles-(\d+)$/);
      if (colMatch && sflIds[colMatch[1]]) {
        priceDict[sflIds[colMatch[1]]] = data.currentPrice || 0;
      }
      const resMatch = data.key.match(/resources-(\d+)$/);
      if (resMatch && sflIds[resMatch[1]]) {
        priceDict[sflIds[resMatch[1]]] = data.currentPrice || 0;
      }
    });
  }
  priceDict['SFL'] = sflData.flowerPrice || 0;
} catch (e) {
  console.error("Error reading sfl_data.json in build", e);
}

const calculateRecipeCost = (ingredients, visited = new Set()) => {
  let total = 0;
  let missing = false;
  for (const ing of ingredients) {
    if (priceDict[ing.name]) {
      total += priceDict[ing.name] * ing.amount;
    } else {
      const subRecipe = sflRecipes.recipes.find(r => r.name === ing.name);
      if (subRecipe && !visited.has(ing.name)) {
        visited.add(ing.name);
        const subCost = calculateRecipeCost(subRecipe.ingredients, visited);
        if (subCost.missing) missing = true;
        total += subCost.total * ing.amount;
      } else {
        missing = true;
      }
    }
  }
  return { total, missing };
};

const foodCostsDict = {};
for (const recipe of sflRecipes.recipes) {
  const costObj = calculateRecipeCost(recipe.ingredients);
  foodCostsDict[recipe.name] = costObj.missing ? null : costObj.total;
}

const calcResources = sflPets.resources;

let maxRPE = 0;
for (const res of calcResources) {
  if (res.name === 'Acorn' || res.name === 'Fossil Shell') continue;
  if (priceDict[res.name]) {
    const rpe = priceDict[res.name] / res.energy;
    if (rpe > maxRPE) maxRPE = rpe;
  }
}



const formatPrice = (num) => {
  if (num === 0) return '0';
  return new Intl.NumberFormat('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 4 }).format(num);
};

const getShrineCostHtml = (shrine) => {
  let total = 0;
  let missing = false;
  for (const res of shrine.resources) {
    if (res.name === 'Acorn') continue;
    if (priceDict[res.name]) {
      total += priceDict[res.name] * res.amount;
    } else {
      missing = true;
    }
  }
  if (missing && total === 0) return `<span class="text-xs text-white/40 italic">N/A</span>`;
  if (total === 0) return `<span class="text-xs text-white/40">-</span>`;
  let html = `<span class="text-sm font-mono text-white/90">${formatPrice(total)}</span>`;
  if (missing) html += ` <span class="text-[10px] text-yellow-500/70 italic" title="Precio incompleto">*Inc</span>`;
  return html;
};

