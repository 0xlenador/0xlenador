---
// ==========================================
// src/components/views/DirectoryView.astro
// View puro para la página de directorio
// ==========================================

import FaqAccordion from "../FaqAccordion.astro"

import { directoryData } from "../../lib/data"

import { getLangFromUrl, useTranslations, getLocalizedPath } from "../../i18n/utils"

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)

// Categorías únicas del directorio, ordenadas
const categories = [...new Set(directoryData.map((item) => item.category))].sort()



const faqItems = [
  {
    pregunta: t("directory.faq.q1"),
    respuesta: t("directory.faq.a1"),
  },
  {
    pregunta: t("directory.faq.q2"),
    respuesta: t("directory.faq.a2"),
  },
  {
    pregunta: t("directory.faq.q3"),
    respuesta: t("directory.faq.a3"),
  },
  {
    pregunta: t("directory.faq.q4"),
    respuesta: t("directory.faq.a4"),
  },
  {
    pregunta: t("directory.faq.q5"),
    respuesta: t("directory.faq.a5"),
  },
  {
    pregunta: t("directory.faq.q6"),
    respuesta: t("directory.faq.a6"),
  },
]
---

<main class="max-w-6xl mx-auto px-6 pt-10 pb-20">
  <!-- Breadcrumb -->
  <p class="text-[10px] font-mono text-emerald-500/70 uppercase tracking-[0.4em] mb-6">
    {t("directory.breadcrumb")}
  </p>

  <!-- Header -->
  <header class="mb-6">
    <h1 class="text-4xl md:text-5xl font-extrabold text-white tracking-tight mb-3">
      {t("directory.heading")}{" "}
      <span class="text-emerald-500">{t("directory.subheading")}</span>
    </h1>
    <p class="text-terminal-secondary text-sm leading-relaxed max-w-2xl font-light">
      {t("directory.intro")}
    </p>
  </header>

  <!-- ─── SECCIÓN 1: Recursos y Plataformas ─── -->
  <section class="mb-20">
    <div class="flex items-center gap-4 mb-6">
      <h2
        class="text-[10px] font-mono text-terminal-muted uppercase tracking-[0.5em] whitespace-nowrap"
      >
        {t("directory.section.resources")}
      </h2>
      <div class="h-px flex-grow bg-terminal-border/40"></div>
      <span class="text-[10px] font-mono text-terminal-muted whitespace-nowrap">
        {directoryData.length} {t("directory.section.subresources")}
      </span>
    </div>

    <!-- Filtros -->
    <div class="flex flex-wrap gap-2 mb-8" id="dir-filter-bar">
      <button class="badge badge-active filter-btn" data-filter="all" id="dir-filter-all">
        {t("directory.filter.all")}
      </button>
      {
        categories.map((cat) => (
          <button
            class="badge filter-btn bg-terminal-surface/60 text-terminal-muted border border-terminal-border hover:border-emerald-500/40 hover:text-emerald-400 transition-colors"
            data-filter={cat}
          >
            {cat}
          </button>
        ))
      }
    </div>

    <!-- Grid de recursos -->
    <div
      class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 xl:grid-cols-6 gap-3"
      id="dir-grid"
    >
      {
        directoryData.map((item) => (
          <a
            href={item.url}
            target="_blank"
            rel="noopener noreferrer"
            data-category={item.category}
            id={`dir-${item.id}`}
            class="group flex flex-col items-center gap-2.5 p-4 rounded-2xl bg-white/[0.02] border border-white/[0.05] hover:border-white/[0.1] hover:bg-white/[0.04] transition-all duration-300 no-underline text-center relative overflow-hidden hover:shadow-[0_4px_20px_rgba(0,0,0,0.3)]"
          >
            {/* Shimmer line on hover */}
            <div class="absolute top-0 inset-x-0 h-px bg-gradient-to-r from-transparent via-white/[0.08] to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500" />

            <img
              src={item.logo}
              alt={item.alt_logo}
              width={40}
              height={40}
              loading="lazy"
              class="w-10 h-10 object-contain rounded-xl"
            />
            <div>
              <p class="text-white text-xs font-semibold leading-tight group-hover:text-emerald-400 transition-colors duration-300">
                {item.name}
              </p>
              <p class="text-terminal-muted text-[9px] mt-0.5 font-mono">{item.category}</p>
            </div>
            {item.sponsored && (
              <span class="text-[8px] font-mono text-emerald-500/40 uppercase tracking-wider">
                ref
              </span>
            )}
          </a>
        ))
      }
    </div>
  </section>



  <!-- FAQ -->
  <div class="border-t border-terminal-border/60 pt-14">
    <h2 class="text-xl font-bold text-white tracking-tight mb-1">{t("directory.faq.heading")}</h2>
    <p class="text-xs text-terminal-subtle mb-8">{t("directory.faq.subheading")}</p>
    <FaqAccordion
      titulo={t("directory.faq.title")}
      subtitulo={t("directory.faq.subtitle")}
      startId={500}
      items={faqItems}
    />
  </div>
</main>

<script>
  const setupDirectoryFilter = () => {
    const buttons = document.querySelectorAll<HTMLButtonElement>(".filter-btn")
    const cards = document.querySelectorAll<HTMLAnchorElement>("#dir-grid a[data-category]")

    buttons.forEach((btn) => {
      btn.addEventListener("click", () => {
        const filter = btn.dataset.filter

        buttons.forEach((b) => {
          b.classList.remove("badge-active")
          b.classList.add("bg-terminal-surface/60", "text-terminal-muted")
        })
        btn.classList.add("badge-active")
        btn.classList.remove("bg-terminal-surface/60", "text-terminal-muted")

        cards.forEach((card) => {
          const show = filter === "all" || card.dataset.category === filter
          card.style.display = show ? "" : "none"
        })
      })
    })
  }

  setupDirectoryFilter()
  document.addEventListener("astro:page-load", setupDirectoryFilter)
</script>
