---
// ==========================================
// src/components/views/NotFoundView.astro
// View puro para la página 404
// ==========================================

import { getLangFromUrl, useTranslations } from "../../i18n/utils"

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)
---

<meta slot="head" name="robots" content="noindex, follow" />

<main class="flex-1 flex items-center justify-center px-6 py-20 md:py-32 relative overflow-hidden">
  <!-- Glow de fondo -->
  <div
    class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-emerald-500/5 blur-[160px] rounded-full pointer-events-none"
  >
  </div>

  <div class="relative z-10 max-w-2xl w-full text-center">
    <!-- Etiqueta de estado -->
    <div
      class="inline-flex items-center gap-2 px-3 py-1 bg-rose-500/10 border border-rose-500/20 rounded-full mb-8"
    >
      <span class="w-1.5 h-1.5 rounded-full bg-rose-500 animate-pulse"></span>
      <span class="text-[10px] font-mono text-rose-400 uppercase tracking-[0.3em] font-bold"
        >{t("404.badge")}</span
      >
    </div>

    <!-- Número 404 con efecto glitch -->
    <div class="relative mb-6">
      <h1
        class="text-[8rem] md:text-[12rem] font-black text-white leading-none tracking-tighter select-none glitch-text"
        data-text="404"
      >
        4<span class="bg-gradient-to-b from-emerald-400 to-cyan-400 bg-clip-text text-transparent"
          >0</span
        >4
      </h1>
      <div class="absolute inset-0 flex items-center justify-center pointer-events-none">
        <div
          class="w-full h-px bg-gradient-to-r from-transparent via-emerald-500/30 to-transparent scanline"
        >
        </div>
      </div>
    </div>

    <!-- Mensaje principal -->
    <h2 class="text-xl md:text-2xl font-bold text-white mb-4 tracking-tight">
      {t("404.heading")}
    </h2>
    <p class="text-terminal-secondary text-sm md:text-base leading-relaxed mb-10 max-w-md mx-auto">
      {t("404.body")}
    </p>

    <!-- Terminal log simulado -->
    <div
      class="bg-terminal-surface/60 border border-terminal-border rounded-2xl p-5 mb-10 text-left font-mono text-[11px] space-y-2 max-w-md mx-auto"
    >
      <div class="flex items-center gap-2 mb-3">
        <div class="w-2.5 h-2.5 rounded-full bg-rose-500/80"></div>
        <div class="w-2.5 h-2.5 rounded-full bg-amber-500/80"></div>
        <div class="w-2.5 h-2.5 rounded-full bg-emerald-500/80"></div>
        <span class="text-terminal-subtle text-[9px] ml-2 uppercase tracking-widest"
          >{t("404.terminal.label")}</span
        >
      </div>
      <p class="text-terminal-muted log-line" style="--delay: 0.1s">
        <span class="text-terminal-subtle">[SYS]</span>
        {t("404.terminal.sys")}
      </p>
      <p class="text-terminal-muted log-line" style="--delay: 0.4s">
        <span class="text-terminal-subtle">[GET]</span>
        <span class="text-cyan-400 break-all" id="current-path">/*</span>
      </p>
      <p class="text-rose-400/80 log-line" style="--delay: 0.7s">
        <span class="text-terminal-subtle">[ERR]</span>
        {t("404.terminal.err")}
      </p>
      <p class="text-emerald-400/70 log-line" style="--delay: 1.0s">
        <span class="text-terminal-subtle">[FIX]</span>
        {t("404.terminal.fix")}
        <span class="text-white">/</span><span class="terminal-cursor">▊</span>
      </p>
    </div>

    <!-- Acciones -->
    <div class="flex flex-col sm:flex-row gap-3 justify-center mb-12">
      <a
        href="/"
        class="px-8 py-4 bg-gradient-to-r from-emerald-500 to-cyan-500 text-terminal-bg font-black uppercase tracking-widest text-xs rounded-xl hover:shadow-lg hover:shadow-emerald-500/20 transition-all inline-flex items-center justify-center gap-2 italic"
      >
        <svg
          class="w-4 h-4"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          viewBox="0 0 24 24"
          ><path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M2.25 12l8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25"
          ></path></svg
        >
        {t("404.btn.home")}
      </a>
      <button
        id="back-button"
        type="button"
        class="px-8 py-4 border border-terminal-border-subtle text-white font-black uppercase tracking-widest text-xs rounded-xl hover:bg-terminal-surface hover:border-terminal-subtle transition-all cursor-pointer"
      >
        {t("404.btn.back")}
      </button>
    </div>

    <!-- Grid de atajos rápidos -->
    <div class="border-t border-terminal-border/60 pt-8">
      <p class="text-[10px] font-mono text-terminal-subtle uppercase tracking-[0.4em] mb-5">
        {t("404.shortcuts.title")}
      </p>
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 max-w-lg mx-auto">
        <a
          href="/blog/tesis-de-inversion/"
          class="group p-3 bg-terminal-surface/30 border border-terminal-border/60 rounded-xl hover:border-emerald-500/30 hover:bg-terminal-surface/60 transition-all"
        >
          <span
            class="text-terminal-secondary group-hover:text-emerald-400 text-xs font-bold transition-colors block"
            >Tesis</span
          >
          <span class="text-terminal-subtle text-[9px] font-mono">/blog/tesis/</span>
        </a>
        <a
          href="/blog/"
          class="group p-3 bg-terminal-surface/30 border border-terminal-border/60 rounded-xl hover:border-emerald-500/30 hover:bg-terminal-surface/60 transition-all"
        >
          <span
            class="text-terminal-secondary group-hover:text-emerald-400 text-xs font-bold transition-colors block"
            >Blog</span
          >
          <span class="text-terminal-subtle text-[9px] font-mono">/blog/</span>
        </a>
        <a
          href="/faucets/"
          class="group p-3 bg-terminal-surface/30 border border-terminal-border/60 rounded-xl hover:border-emerald-500/30 hover:bg-terminal-surface/60 transition-all"
        >
          <span
            class="text-terminal-secondary group-hover:text-emerald-400 text-xs font-bold transition-colors block"
            >Faucets</span
          >
          <span class="text-terminal-subtle text-[9px] font-mono">/faucets/</span>
        </a>
        <a
          href="/intrinseco/"
          class="group p-3 bg-terminal-surface/30 border border-terminal-border/60 rounded-xl hover:border-emerald-500/30 hover:bg-terminal-surface/60 transition-all"
        >
          <span
            class="text-terminal-secondary group-hover:text-emerald-400 text-xs font-bold transition-colors block"
            >Intrínseco</span
          >
          <span class="text-terminal-subtle text-[9px] font-mono">/intrinseco/</span>
        </a>
      </div>
    </div>
  </div>
</main>

<script>
  // Inyectar la ruta actual en el log del terminal
  const pathEl = document.getElementById("current-path")
  if (pathEl) {
    pathEl.textContent = window.location.pathname
  }

  // Manejar el botón de regresar con fallback inteligente
  const backBtn = document.getElementById("back-button")
  if (backBtn) {
    backBtn.addEventListener("click", () => {
      if (document.referrer) {
        window.history.back()
      } else {
        window.location.href = "/"
      }
    })
  }
</script>
