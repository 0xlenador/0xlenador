<!-- Motor Centralizado de Mercado (compilado por Vite con ES Modules) -->
<script>
  import * as SflMarket from "../../lib/sfl/market"
  import { initSflTradingModal } from "../../lib/sfl/marketChart"
  import {
    initSflMarketDashboard,
    renderSflDashboard,
    updateDash61Changes,
  } from "../../lib/sfl/marketDashboard"
  ;(window as unknown as { SflMarket: typeof SflMarket }).SflMarket = SflMarket
  window.__initSflTradingModal = initSflTradingModal
  if (window.__sflMarketModalCtx) {
    initSflTradingModal(window.__sflMarketModalCtx)
  }
  window.__initSflMarketDashboard = initSflMarketDashboard
  window.__renderSflDashboard = renderSflDashboard
  window.updateDash61Changes = updateDash61Changes
  if (window.__sflMarketDashboardCtx) {
    initSflMarketDashboard(window.__sflMarketDashboardCtx)
    if (window.__sflMarketDashboardCtx.getMarketData().length > 0) {
      renderSflDashboard()
    }
  }
  if (window.__CoinGeckoEngine) {
    updateDash61Changes(window.__CoinGeckoEngine)
  }
  // Iniciar descarga deduplicada del mercado
  SflMarket.fetchMarketData()
</script>

