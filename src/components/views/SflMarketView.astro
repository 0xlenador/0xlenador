---
// ============================================================
// src/components/views/SflMarketView.astro
// View puro para la herramienta de mercado SFL.
// ============================================================
import { getEntry } from "astro:content"
import { getLangFromUrl, useTranslations } from "../../i18n/utils"
import SflTabs from "../SflTabs.astro"

const sflIdsEntry = await getEntry("sfl", "resources")
const sflPowerUpsEntry = await getEntry("sfl", "powerups")
const sflCosmeticsEntry = await getEntry("sfl", "cosmetics")
const sflIds = sflIdsEntry.data
const sflPowerUps = sflPowerUpsEntry.data
const sflCosmetics = sflCosmeticsEntry.data

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)
---

<main class="max-w-7xl mx-auto sm:px-6">
  <fieldset
    class="border border-white/[0.05] bg-white/[0.02] backdrop-blur-2xl rounded-t-[24px] rounded-b-none sm:rounded-b-[24px] p-2 lg:p-8 mb-10 shadow-2xl relative block min-w-0"
    style="background-image: radial-gradient(circle at top right, rgba(16, 185, 129, 0.12) 0%, transparent 350px);"
  >
    <legend class="ml-6 lg:ml-8 px-3 flex items-center gap-2 float-none w-auto">
      <img
        src="/img/cripto/sunflowerland.webp"
        alt="Sunflower Land"
        class="w-5 h-5 rounded-full object-contain bg-white/[0.05] p-[2px] border border-white/[0.1]"
      />
      <span
        class="text-[9px] font-mono text-emerald-500/80 uppercase tracking-widest font-semibold"
      >
        {t("sfl.breadcrumb")}
      </span>
    </legend>

    <SflTabs activeTab="mercado" />

    <div
      class="flex flex-col lg:flex-row justify-between items-center lg:items-start gap-6 mb-10 relative z-10 text-center sm:text-left"
    >
      <div class="w-full lg:w-auto">
        <h1 class="text-3xl md:text-4xl font-black text-white tracking-tighter mb-3">
          {t("sfl.heading")}
          <span class="text-emerald-500"> {t("sfl.heading.accent")}</span>
        </h1>
        <p class="text-terminal-secondary text-sm leading-relaxed max-w-2xl mx-auto sm:mx-0">
          {t("sfl.intro")}
        </p>
      </div>
      <div class="hidden lg:flex w-full lg:w-auto justify-center lg:justify-end shrink-0 lg:pt-1 gap-4">
        <!-- Tarjeta Yakkamon -->
        <div
          class="relative bg-white/[0.02] border border-amber-500/20 pr-4 rounded-2xl flex items-stretch shadow-[0_0_15px_rgba(245,158,11,0.05)] hover:border-amber-500/40 transition-colors group"
        >
          <!-- Badge Nuevo Juego sin fondo negro extra -->
          <span class="absolute -top-[7px] left-1/2 -translate-x-1/2 bg-[#0c1015] text-amber-500/90 border border-amber-500/20 px-1.5 py-[1px] rounded-[3px] text-[7px] font-mono font-bold uppercase tracking-widest whitespace-nowrap">{t("sfl.newGame")}</span>

          <!-- Imagen alto completo al borde sin espacio -->
          <a href="https://yakkamon.com/" target="_blank" rel="noopener noreferrer" class="w-12 shrink-0 overflow-hidden cursor-pointer flex items-center justify-center rounded-l-[15px] bg-amber-500/5">
            <img
              src="/img/cripto/yakkamon.webp"
              alt="Yakkamon"
              class="w-full h-full object-cover group-hover:scale-110 transition-transform"
            />
          </a>
          
          <div class="flex flex-col text-left justify-center py-2 pl-3">
            <a href="https://yakkamon.com/" target="_blank" rel="noopener noreferrer" class="flex items-center gap-1 text-[15px] text-white font-black tracking-wider leading-none hover:text-amber-400 transition-colors mb-1">
              Yakkamon
              <svg class="w-3 h-3 text-amber-500/70" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </a>
            <div class="flex items-center gap-1 group/code cursor-pointer" onclick="navigator.clipboard.writeText('YAKKA-VNTB4Y'); const i=this.querySelector('.copy-icon'); const c=this.querySelector('.check-icon'); i.classList.add('hidden'); c.classList.remove('hidden'); setTimeout(()=>{i.classList.remove('hidden'); c.classList.add('hidden');}, 2000)" title="Copiar código">
              <span class="text-[7px] font-mono text-terminal-secondary group-hover/code:text-amber-400 transition-colors uppercase tracking-widest">Code: <span class="text-[9px] font-bold text-white group-hover/code:text-amber-400">YAKKA-VNTB4Y</span></span>
              
              <!-- Ícono de copiar normal -->
              <svg class="w-2.5 h-2.5 text-terminal-muted/60 group-hover/code:text-amber-400/80 transition-colors copy-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/>
              </svg>

              <!-- Ícono de check verde (oculto por defecto) -->
              <svg class="w-2.5 h-2.5 text-emerald-500 hidden check-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
              </svg>
            </div>
          </div>
        </div>


      </div>
    </div>

    <div
      id="loadingState"
      class="hidden py-20 flex flex-col items-center justify-center relative z-10"
    >
      <svg
        class="animate-spin h-8 w-8 text-emerald-500 mb-4"
        xmlns="http://www.w3.org/2000/svg"
        fill="none"
        viewBox="0 0 24 24"
      >
        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"
        ></circle>
        <path
          class="opacity-75"
          fill="currentColor"
          d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"
        ></path>
      </svg>
      <p class="text-terminal-muted font-mono text-xs animate-pulse">{t("sfl.loading")}</p>
    </div>

    <div
      id="errorState"
      class="hidden py-12 px-6 bg-red-500/10 border border-red-500/20 rounded-xl relative z-10"
    >
      <p id="errorMsg" class="text-red-400 text-sm text-center">{t("sfl.error")}</p>
    </div>

    <div id="dataContainer" class="hidden relative z-10">
      <!-- Dashboard Resumen -->
      <div class="relative mb-10">
        <div
          class="flex overflow-x-auto snap-x snap-mandatory gap-4 pb-4 md:grid md:grid-cols-3 md:gap-6 md:pb-0 no-scrollbar"
        >
          <div
            class="min-w-[85vw] sm:min-w-[320px] md:min-w-0 snap-center shrink-0 bg-white/[0.02] border border-white/[0.05] rounded-[20px] p-4 lg:p-5 shadow-inner flex flex-col justify-start min-h-[160px] lg:min-h-[180px]"
          >
            <h3
              class="text-[10px] lg:text-xs font-mono text-terminal-muted uppercase tracking-wider mb-2 lg:mb-3 flex items-center gap-2"
            >
              <svg
                class="w-3.5 h-3.5 lg:w-4 lg:h-4 text-emerald-500"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                ><path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"></path></svg
              >
              Top Volume 24h
            </h3>
            <div id="dashTopVolume" class="h-auto flex-grow flex flex-col justify-center">
              <div class="h-8 bg-white/[0.05] rounded-lg w-3/4 animate-pulse"></div>
            </div>
          </div>

          <div
            class="min-w-[85vw] sm:min-w-[320px] md:min-w-0 snap-center shrink-0 bg-white/[0.02] border border-white/[0.05] rounded-[20px] shadow-inner relative min-h-[160px] lg:min-h-[180px] group/carousel cursor-pointer"
          >
            <div class="absolute top-4 right-4 w-4 h-4 z-20 pointer-events-none">
              <svg class="w-full h-full -rotate-90" viewBox="0 0 24 24">
                <circle
                  class="text-white/10"
                  stroke-width="3"
                  stroke="currentColor"
                  fill="transparent"
                  r="10"
                  cx="12"
                  cy="12"></circle>
                <circle
                  id="gainerProgress"
                  class="text-emerald-500 transition-colors duration-500 group-hover/carousel:![animation-play-state:paused]"
                  stroke-width="3"
                  stroke-linecap="round"
                  stroke="currentColor"
                  fill="transparent"
                  r="10"
                  cx="12"
                  cy="12"
                  stroke-dasharray="62.83"
                  stroke-dashoffset="62.83"></circle>
              </svg>
            </div>
            <div id="dashTopGainerCarousel" class="w-full h-full absolute inset-0 p-4 lg:p-5">
              <div class="flex flex-col justify-start h-full">
                <h3
                  class="text-[10px] lg:text-xs font-mono text-terminal-muted uppercase tracking-wider mb-2 lg:mb-3 flex items-center gap-2"
                >
                  <svg
                    class="w-3.5 h-3.5 lg:w-4 lg:h-4 text-emerald-500"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    ><path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M5 10l7-7m0 0l7 7m-7-7v18"></path></svg
                  >
                  Calculando...
                </h3>
                <div class="h-auto flex-grow flex items-center">
                  <div class="h-8 bg-white/[0.05] rounded-lg w-2/3 animate-pulse"></div>
                </div>
              </div>
            </div>
          </div>

          <div
            class="min-w-[85vw] sm:min-w-[320px] md:min-w-0 snap-center shrink-0 bg-white/[0.02] border border-white/[0.05] rounded-[20px] shadow-inner relative min-h-[160px] lg:min-h-[180px] group/carousel cursor-pointer"
          >
            <div class="absolute top-4 right-4 w-4 h-4 z-20 pointer-events-none">
              <svg class="w-full h-full -rotate-90" viewBox="0 0 24 24">
                <circle
                  class="text-white/10"
                  stroke-width="3"
                  stroke="currentColor"
                  fill="transparent"
                  r="10"
                  cx="12"
                  cy="12"></circle>
                <circle
                  id="extremesProgress"
                  class="text-emerald-500 transition-colors duration-500 group-hover/carousel:![animation-play-state:paused]"
                  stroke-width="3"
                  stroke-linecap="round"
                  stroke="currentColor"
                  fill="transparent"
                  r="10"
                  cx="12"
                  cy="12"
                  stroke-dasharray="62.83"
                  stroke-dashoffset="62.83"></circle>
              </svg>
            </div>
            <div id="dashAthAtlCarousel" class="w-full h-full absolute inset-0 p-4 lg:p-5">
              <div class="flex flex-col justify-start h-full">
                <h3
                  class="text-[10px] lg:text-xs font-mono text-terminal-muted uppercase tracking-wider mb-2 lg:mb-3 flex items-center gap-2"
                >
                  <svg
                    class="w-3.5 h-3.5 lg:w-4 lg:h-4 text-emerald-500"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    ><path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg
                  >
                  Calculando...
                </h3>
                <div class="flex flex-wrap gap-2 h-auto flex-grow items-center">
                  <div
                    class="h-10 w-10 bg-white/[0.05] rounded-lg animate-pulse border border-white/10"
                  >
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div
        class="flex flex-col sm:flex-row items-start sm:items-center justify-between mb-4 gap-4 sm:gap-2"
      >
        <div class="flex items-center flex-wrap gap-3">
          <h2 class="text-lg font-semibold text-white">
            {t("sfl.activity")}
            <span
              class="text-xs text-terminal-muted font-normal ml-2 tracking-wide hidden sm:inline"
              >P2P History</span>
          </h2>
        </div>
        <div class="flex items-center gap-2 w-full sm:w-auto">
          <button
            id="fetchBtn"
            class="px-3 py-1.5 bg-emerald-500/10 hover:bg-emerald-500/20 border border-emerald-500/30 text-emerald-400 font-bold text-xs rounded-xl transition-colors whitespace-nowrap flex items-center gap-2 group w-full sm:w-auto justify-center"
          >
            <svg
              class="w-3.5 h-3.5 group-hover:rotate-180 transition-transform duration-500 shrink-0"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"
              ></path></svg
            >
            {t("sfl.refresh")}
          </button>
        </div>
      </div>

      <!-- Filtros y Buscador -->
      <div
        class="bg-black/20 backdrop-blur-xl border border-white/10 rounded-2xl p-3 lg:p-5 mb-6 flex flex-col lg:flex-row lg:items-center justify-between gap-3 lg:gap-6 relative z-30 shadow-2xl"
      >
        <!-- Buscador Pro -->
        <div class="w-full lg:w-1/3 relative z-40 group">
          <div
            class="relative flex items-center w-full bg-black/40 border border-white/10 rounded-xl overflow-hidden focus-within:border-emerald-500/50 focus-within:ring-1 focus-within:ring-emerald-500/30 transition-all duration-300"
          >
            <div class="pl-4 pr-2 flex items-center justify-center">
              <svg
                id="searchIcon"
                class="w-4 h-4 text-white/40 group-focus-within:text-emerald-400 transition-colors duration-300"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
              </svg>
            </div>
            <input
              type="text"
              id="searchInput"
              placeholder={t("sfl.search.placeholder")}
              autocomplete="off"
              spellcheck="false"
              style="outline: none !important; box-shadow: none !important; border: none !important; background-color: transparent !important;"
              class="w-full px-2 py-3 text-white placeholder-white/30 text-sm"
            />
            <button
              id="clearSearchBtn"
              class="hidden absolute right-3 focus:outline-none hover:bg-white/10 p-1 rounded-full transition-colors"
            >
              <svg
                class="w-4 h-4 text-white/50 hover:text-white"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M6 18L18 6M6 6l12 12"></path>
              </svg>
            </button>
          </div>
        </div>

        <div class="w-full lg:w-auto flex flex-col lg:flex-row lg:items-center gap-3 lg:gap-5">
          <!-- Segmented Control para Categorías (Scroll horizontal en móvil con sangría) -->
          <div class="relative w-full lg:w-auto scroll-hint-wrapper">
            <div
              class="w-[calc(100%)] lg:w-auto lg:ml-0 lg:px-0 overflow-x-auto no-scrollbar pb-1 lg:pb-0 scroll-area"
            >
              <div
                class="flex items-center bg-black/40 border border-white/10 rounded-xl p-1 w-max md:w-full lg:w-max md:gap-1 lg:gap-0"
              >
                <button
                  class="category-btn relative px-5 py-2.5 rounded-lg text-xs font-bold uppercase tracking-wider text-emerald-400 bg-white/5 shadow-[0_0_15px_rgba(16,185,129,0.1)] whitespace-nowrap shrink-0 transition-all duration-300 flex items-center justify-center gap-2 md:flex-1 lg:flex-none"
                  data-category="resources"
                  onclick="window.handleCategory('resources')"
                >
                  <img
                    src="/img/sunflowerland/Eggplant.png"
                    alt="Resources"
                    class="w-4 h-4 object-contain"
                  />
                  Resources
                </button>
                <button
                  class="category-btn relative px-5 py-2.5 rounded-lg text-xs font-bold uppercase tracking-wider text-white/50 hover:text-white hover:bg-white/5 whitespace-nowrap shrink-0 transition-all duration-300 flex items-center justify-center gap-2 md:flex-1 lg:flex-none"
                  data-category="powerups"
                  onclick="window.handleCategory('powerups')"
                >
                  <img
                    src="/img/sunflowerland/123/energy.png"
                    alt="Power Ups"
                    class="w-4 h-4 object-contain"
                  />
                  Power Ups
                </button>
                <button
                  class="category-btn relative px-5 py-2.5 rounded-lg text-xs font-bold uppercase tracking-wider text-white/50 hover:text-white hover:bg-white/5 whitespace-nowrap shrink-0 transition-all duration-300 flex items-center justify-center gap-2 md:flex-1 lg:flex-none"
                  data-category="cosmetics"
                  onclick="window.handleCategory('cosmetics')"
                >
                  <img
                    src="/img/sunflowerland/123/bear.png"
                    alt="Cosmetics"
                    class="w-4 h-4 object-contain"
                  />
                  Cosmetics
                </button>
                <button
                  class="px-5 py-2.5 rounded-lg text-xs font-bold uppercase tracking-wider text-white/20 cursor-not-allowed whitespace-nowrap shrink-0 flex items-center justify-center md:flex-1 lg:flex-none"
                  disabled
                  title="Próximamente">Buds</button
                >
                <button
                  class="px-5 py-2.5 rounded-lg text-xs font-bold uppercase tracking-wider text-white/20 cursor-not-allowed whitespace-nowrap shrink-0 flex items-center justify-center md:flex-1 lg:flex-none"
                  disabled
                  title="Próximamente">Pets</button
                >
              </div>
            </div>
            <div
              class="scroll-hint absolute right-0 top-0 bottom-1 w-12 bg-gradient-to-l from-[#111] to-transparent pointer-events-none flex justify-end items-center transition-opacity duration-300 lg:hidden pr-1 opacity-0"
            >
              <svg
                class="w-4 h-4 text-emerald-500/70 animate-pulse"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                ><path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M9 5l7 7-7 7"></path></svg
              >
            </div>
          </div>

          <!-- Contenedor Tablet para Subfiltros y Ordenamiento (Fila Única en md) -->
          <div
            class="flex flex-col md:flex-row md:items-center md:justify-between lg:justify-start gap-3 md:gap-4 w-full lg:w-auto md:border-t md:border-white/5 md:pt-3 lg:border-none lg:pt-0"
          >
            <div class="hidden lg:block w-px h-10 bg-white/10"></div>
            <!-- Separador vertical Desktop -->

            <!-- Subfiltros Integrados -->
            <div class="relative w-full md:w-auto lg:w-max scroll-hint-wrapper">
              <div
                id="subfilters-container"
                class="flex items-center gap-5 opacity-30 grayscale pointer-events-none transition-all duration-300 w-full lg:w-max overflow-x-auto no-scrollbar pl-1 lg:pl-0 pb-2 lg:pb-0 scroll-area"
              >
                <label class="flex items-center gap-2 cursor-pointer group/label shrink-0">
                  <input
                    type="checkbox"
                    value="collectibles"
                    checked
                    onchange="window.toggleSubCategory('collectibles')"
                    class="sub-checkbox-common w-4 h-4 accent-emerald-500 bg-black/50 border-white/20 rounded cursor-pointer"
                  />
                  <img
                    src="/img/sunflowerland/powerups/freya_fox.png"
                    alt="Collectibles"
                    class="w-4 h-4 object-contain"
                  />
                  <span
                    class="text-xs font-semibold text-white/70 group-hover/label:text-white transition-colors uppercase tracking-widest"
                    >Collectibles</span
                  >
                </label>
                <div class="w-px h-4 bg-white/10 shrink-0"></div>
                <label class="flex items-center gap-2 cursor-pointer group/label shrink-0">
                  <input
                    type="checkbox"
                    value="wearables"
                    checked
                    onchange="window.toggleSubCategory('wearables')"
                    class="sub-checkbox-common w-4 h-4 accent-emerald-500 bg-black/50 border-white/20 rounded cursor-pointer"
                  />
                  <img
                    src="/img/sunflowerland/123/hat-wearables.webp"
                    alt="Wearables"
                    class="w-4 h-4 object-contain"
                  />
                  <span
                    class="text-xs font-semibold text-white/70 group-hover/label:text-white transition-colors uppercase tracking-widest"
                    >Wearables</span
                  >
                </label>
              </div>
              <div
                class="scroll-hint absolute right-0 top-0 bottom-2 w-12 bg-gradient-to-l from-[#111] to-transparent pointer-events-none flex justify-end items-center transition-opacity duration-300 lg:hidden pr-1 opacity-0"
              >
                <svg
                  class="w-4 h-4 text-emerald-500/70 animate-pulse"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  ><path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M9 5l7 7-7 7"></path></svg
                >
              </div>
            </div>

            <!-- Ordenamiento Móvil Estilo App -->
            <div
              class="relative w-[calc(100%)] md:w-auto md:max-w-[55%] md:flex-grow lg:hidden border-t border-white/5 pt-3 md:border-none md:pt-0 scroll-hint-wrapper overflow-hidden"
            >
              <div class="w-full overflow-x-auto no-scrollbar scroll-area md:flex md:justify-end">
                <div class="flex items-center gap-1 w-max pr-6 md:pr-0">
                  <span
                    class="text-[10px] font-mono text-white/30 uppercase tracking-widest mr-1 shrink-0"
                    >{t("sfl.market.sortby")}</span
                  >
                  <button
                    class="px-3 py-1.5 bg-black/40 border border-white/10 rounded-lg text-[10px] font-semibold text-white/60 hover:text-white hover:bg-white/10 transition-all whitespace-nowrap flex items-center gap-1.5"
                    onclick="window.handleSort('name')"
                    >{t("sfl.market.sort.name")}
                    <span class="sort-icon hidden" data-col="name">↓</span></button
                  >
                  <button
                    class="px-3 py-1.5 bg-black/40 border border-white/10 rounded-lg text-[10px] font-semibold text-white/60 hover:text-white hover:bg-white/10 transition-all whitespace-nowrap flex items-center gap-1.5"
                    onclick="window.handleSort('price')"
                    >{t("sfl.market.sort.price")}
                    <span class="sort-icon hidden" data-col="price">↓</span></button
                  >
                  <button
                    class="px-3 py-1.5 bg-black/40 border border-white/10 rounded-lg text-[10px] font-semibold text-white/60 hover:text-white hover:bg-white/10 transition-all whitespace-nowrap flex items-center gap-1.5"
                    onclick="window.handleSort('1d')"
                    >{t("sfl.market.sort.24h")}
                    <span class="sort-icon hidden" data-col="1d">↓</span></button
                  >
                  <button
