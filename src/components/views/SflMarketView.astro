                 <div class="desktop-graph-7d w-full h-full ${window.activeGraphPeriod === '7d' ? '' : 'hidden'}">${getCardColumnHTML(tCol7d, calculateChange(item.currentPrice, item.history["7d"]), item.history.sparkline7d, 8, false, item.currentPrice)}</div>
                 <div class="desktop-graph-30d w-full h-full ${window.activeGraphPeriod === '30d' ? '' : 'hidden'}">${getCardColumnHTML(tCol30d, calculateChange(item.currentPrice, item.history["30d"]), item.history.sparkline30d, 31, false, item.currentPrice)}</div>
                 <div class="desktop-graph-180d w-full h-full ${window.activeGraphPeriod === '180d' ? '' : 'hidden'}">${getCardColumnHTML(tCol180d, calculateChange(item.currentPrice, item.history["180d"]), item.history.sparkline180d, 181, false, item.currentPrice)}</div>
              </div>
            </div>
          `}
        </div>
      `
      fragment.appendChild(row)
    })

    const oldTrigger = document.getElementById("loadMoreTrigger")
    if (oldTrigger) oldTrigger.remove()

    tableBody.appendChild(fragment)

    if (end < window.__currentFilteredData.length) {
      const trigger = document.createElement("div")
      trigger.id = "loadMoreTrigger"
      trigger.className = "h-4 w-full opacity-0 pointer-events-none -mt-4"
      tableBody.appendChild(trigger)

      if (!loadMoreObserver) {
        loadMoreObserver = new IntersectionObserver(
          (entries) => {
            if (entries[0].isIntersecting) {
              currentPage++
              sessionStorage.setItem("sfl_market_page", currentPage)
              renderPage(currentPage)
            }
          },
          { rootMargin: "300px" },
        )
      }

      loadMoreObserver.disconnect()
      loadMoreObserver.observe(trigger)
    }
  }
  
  window.reRenderTable = () => {
    const searchInput = document.getElementById("searchInput")
    renderTable(searchInput ? searchInput.value : "")
  }

  document.addEventListener("coingecko-data-ready", (e) => {
    const dataMap = e.detail
    if (window.updateDash61Changes) window.updateDash61Changes(dataMap);
    const flowerData = dataMap["flower-2"]
    if (flowerData && flowerData.usd) {
      window.sflUsdPrice = flowerData.usd;
      window.__flowerData = {
        name: "FLOWER",
        key: "flower",
        currentPrice: flowerData.usd,
        history: {
          "1d": flowerData.usd / (1 + (flowerData.change24h || 0) / 100),
          "7d": flowerData.usd / (1 + (flowerData.change7d || 0) / 100),
          "30d": flowerData.usd / (1 + (flowerData.change30d || 0) / 100),
          "sparkline7d": flowerData.sparkline ? (() => {
            const raw = flowerData.sparkline;
            const reduced = [];
            for (let i = 0; i < raw.length; i += Math.ceil(raw.length / 7)) {
              reduced.push(raw[i]);
            }
            if (reduced[reduced.length - 1] !== raw[raw.length - 1]) {
              reduced.push(raw[raw.length - 1]);
            }
            return reduced.slice(-8);
          })() : []
        },
        trades7d: flowerData.totalVolume || 0,
        supply: 256000000,
        category: "resources"
      }
      
      if (window.__sflMarketInitialized && typeof marketData !== "undefined" && marketData.length > 0) {
        if (typeof renderDashboard === "function") renderDashboard();
      }

      if (typeof renderTable === "function") {
        const searchInput = document.getElementById("searchInput");
        renderTable(searchInput ? searchInput.value : "", true);
      }
    }
  })

  window.closeFlowerRow = () => {
    const flowerRowToggle = document.getElementById("flowerRowToggle")
    if (flowerRowToggle) flowerRowToggle.checked = false
    window.__showFlowerRow = false
    localStorage.setItem("hide_flower_row", "true")
    renderTable(searchInput ? searchInput.value : "")
  }

  const fetchData = async (silent = false, forceRefresh = false) => {
    try {
      if (!silent) {
        loadingState.classList.remove("hidden")
        errorState.classList.add("hidden")
        dataContainer.classList.add("hidden")
      } else if (fetchBtn) {
        const svg = fetchBtn.querySelector("#fetchBtnRefreshIcon")
        if (svg) svg.classList.add("animate-spin")
      }

      // Ventana de caché de 5 minutos (evita re-descargar 3.6MB innecesariamente en cada recarga o navegación rápida)
      // Si el usuario presiona el botón "Refrescar", se fuerza con Date.now()
      const cacheBuster = forceRefresh ? Date.now() : Math.floor(Date.now() / (5 * 60 * 1000))

      // Consultar datos de mercado (usa SflMarket centralizado si está disponible)
      let json = null
      if (window.SflMarket && typeof window.SflMarket.fetchMarketData === "function") {
        json = await window.SflMarket.fetchMarketData(forceRefresh)
      }

      if (!json) {
        const response = await fetch(`/api/sfl_data.json?v=${cacheBuster}`)
        if (!response.ok) {
          throw new Error(`No se pudo cargar el archivo local: ${response.status}`)
        }
        json = await response.json()
      }
      
      try {
         const dashResponse = await fetch(`/api/sfl_dashboard.json?v=${cacheBuster}`)
         if (dashResponse.ok) {
            dashboardData = await dashResponse.json()
         }
      } catch (e) {
         console.warn("No se pudo cargar sfl_dashboard.json", e)
      }

      if (!json || !json.items) {
        throw new Error(`El archivo de datos estáticos no contiene historial de items.`)
      }

      if (json.budsSummary) {
        window.sflBudsSummary = json.budsSummary
      }

      let bestCoinsPerFlower = 0
      if (window.SflMarket && typeof window.SflMarket.getBettyRatio === "function") {
        bestCoinsPerFlower = window.SflMarket.getBettyRatio()
      }
      if (bestCoinsPerFlower <= 0) {
        Object.keys(bettyPrices).forEach(name => {
          const itemConfig = bettyPrices[name]
          const itemId = Object.keys(sflIds).find(key => sflIds[key] === name)
          const internalKey = `collectibles-${itemId}`
          const marketItem = json.items[internalKey]

          const bettyPriceCoins = itemConfig.sellPrice
          const p2pPriceFlower = marketItem ? marketItem.currentPrice : 0

          if (p2pPriceFlower > 0) {
            const coinsPerFlower = bettyPriceCoins / p2pPriceFlower
            if (coinsPerFlower > bestCoinsPerFlower) {
              bestCoinsPerFlower = coinsPerFlower
            }
          }
        })
      }
      window.sflBestCoinsPerFlower = bestCoinsPerFlower

      // Calcular precio dinámico del Oil basado en receta del Oil Drill (16.67 Oil)
      // Receta: 20 Wood (601) + 9 Iron (603) + 10 Leather (641) + 100 Coins
      let woodPrice = 0, ironPrice = 0, leatherPrice = 0;
      
      const woodItem = json.items['collectibles-601'];
      if (woodItem) woodPrice = woodItem.currentPrice || 0;
      
      const ironItem = json.items['collectibles-603'];
      if (ironItem) ironPrice = ironItem.currentPrice || 0;

      const leatherItem = json.items['collectibles-641'];
      if (leatherItem) leatherPrice = leatherItem.currentPrice || 0;
      
      const coinsCostInFlower = 100 / (window.sflBestCoinsPerFlower || 1330);
      const oilDrillCost = (20 * woodPrice) + (9 * ironPrice) + (10 * leatherPrice) + coinsCostInFlower;
      
      window.sflOilDrillCost = oilDrillCost;
      window.sflBestOilPriceFlower = oilDrillCost > 0 ? oilDrillCost / (window.sflOilMultiplier || 16.67) : 0.107;

      // Mapear el nuevo formato histórico JSON filtrando por sfl_ids.json y sfl_powerups.json
      marketData = Object.values(json.items)
        .reduce((acc, data) => {
          const parts = data.key.split("-")
          if (parts.length >= 2) {
            const type = parts[0]
            const id = parts[1]
            if (type === "collectibles" && sflIds[id]) {
              acc.push({
                ...data,
                name: sflIds[id],
                trades7d: data.trades7d,
                category: "resources",
              })
            } else if (type === "collectibles" && sflPowerUps.power_ups.collectibles[id]) {
              acc.push({
                ...data,
                name: sflPowerUps.power_ups.collectibles[id].name,
                boost: sflPowerUps.power_ups.collectibles[id].boost,
                image: sflPowerUps.power_ups.collectibles[id].image,
                supply: sflPowerUps.power_ups.collectibles[id].supply,
                trades7d: data.trades7d,
                category: "powerups",
                isWearable: false,
              })
            } else if (
              type === "collectibles" &&
              sflCosmetics.cosmetics &&
              sflCosmetics.cosmetics.collectibles &&
              sflCosmetics.cosmetics.collectibles[id]
            ) {
              acc.push({
                ...data,
                name: sflCosmetics.cosmetics.collectibles[id].name,
                boost: "",
                image: sflCosmetics.cosmetics.collectibles[id].image,
                supply: sflCosmetics.cosmetics.collectibles[id].supply,
                trades7d: data.trades7d,
                category: "cosmetics",
                isWearable: false,
              })
            } else if (
              type === "wearables" &&
              sflPowerUps.power_ups.wearables &&
              sflPowerUps.power_ups.wearables[id]
            ) {
              acc.push({
                ...data,
                name: sflPowerUps.power_ups.wearables[id].name,
                boost: sflPowerUps.power_ups.wearables[id].boost,
                image: sflPowerUps.power_ups.wearables[id].image,
                supply: sflPowerUps.power_ups.wearables[id].supply,
                trades7d: data.trades7d,
                category: "powerups",
                isWearable: true,
              })
            } else if (
              type === "wearables" &&
              sflCosmetics.cosmetics.wearables &&
              sflCosmetics.cosmetics.wearables[id]
            ) {
              acc.push({
                ...data,
                name: sflCosmetics.cosmetics.wearables[id].name,
                boost: "",
                image: sflCosmetics.cosmetics.wearables[id].image,
                supply: sflCosmetics.cosmetics.wearables[id].supply,
                trades7d: data.trades7d,
                category: "cosmetics",
                isWearable: true,
              })
            } else if (type === "buds") {
              acc.push({
                ...data,
                name: `Bud #${id}`,
                budId: id,
                image: `https://buds.sunflower-land.com/nfts/${id}.gif`,
                supply: 1,
                trades7d: data.trades7d,
                category: "buds",
                isWearable: false,
              })
            }
          }
          return acc
        }, [])
        .sort((a, b) => b.volume - a.volume)

      // Sincronizar el último punto de todos los sparklines con el precio actual del ítem
      marketData.forEach((item) => {
        if (item.currentPrice > 0 && item.history) {
          ['sparkline7d', 'sparkline30d', 'sparkline180d'].forEach((key) => {
            if (Array.isArray(item.history[key]) && item.history[key].length > 0) {
              item.history[key][item.history[key].length - 1] = item.currentPrice
            }
          })
        }
      })

      // Actualizar el widget de precio FLOWER con el dato inyectado desde sfl_data.json
      // Guardamos el precio interno del juego intacto para la calculadora
      let internalPrice = json.flowerPrice ? parseFloat(json.flowerPrice) : 0.0854;
      window.sflInternalPrice = internalPrice;

      // Actualizar el widget de precio FLOWER con el dato inyectado desde sfl_data.json
      let fallbackPrice = internalPrice;
      if (window.__CoinGeckoEngine && window.__CoinGeckoEngine["flower-2"] && window.__CoinGeckoEngine["flower-2"].usd) {
          fallbackPrice = window.__CoinGeckoEngine["flower-2"].usd;
      }
      window.sflUsdPrice = fallbackPrice;
      const priceEl = document.getElementById("sflPriceValue")
      const changeEl = document.getElementById("sflPriceChange")
      const imgEl = document.getElementById("sflTokenImg")

      if (json.flowerPrice) {
        if (priceEl) priceEl.innerText = "$" + parseFloat(json.flowerPrice).toFixed(4)
        if (changeEl) changeEl.innerText = ""
        if (imgEl) imgEl.classList.remove("animate-pulse")
      } else {
        if (priceEl) priceEl.innerText = "N/A"
        if (imgEl) imgEl.classList.remove("animate-pulse")
      }


      renderDashboard()
      renderTable(searchInput ? searchInput.value : "", true)

      if (!silent) {
        // Preparar transición suave siempre para evitar parpadeos y cortes bruscos
        dataContainer.style.opacity = "0"
        dataContainer.classList.remove("hidden")

        // Damos 1 frame para que el navegador construya el DOM renderizado
        requestAnimationFrame(() => {
          const savedScroll = sessionStorage.getItem("sfl_market_scroll")
          if (savedScroll) {
            window.scrollTo({ top: parseInt(savedScroll), behavior: "instant" })
            sessionStorage.removeItem("sfl_market_scroll")
          }

          loadingState.classList.add("hidden") // Ocultamos skeleton
          
          // Iniciamos el fade in
          dataContainer.style.transition = "opacity 0.2s ease-in-out"
          dataContainer.style.opacity = "1"

          setTimeout(() => {
            dataContainer.style.transition = ""
            dataContainer.style.opacity = ""
          }, 250)
        })
      }
    } catch (err) {
      console.error(err)
      errorMsg.innerText = err.message || "Error desconocido al consultar la API."
      
      if (!silent) {
        errorState.classList.remove("hidden")
        loadingState.classList.add("hidden")
      }

      const priceEl = document.getElementById("sflPriceValue")
      const imgEl = document.getElementById("sflTokenImg")
      if (priceEl) priceEl.innerText = "Error"
      if (imgEl) imgEl.classList.remove("animate-pulse")
    } finally {
      if (silent && fetchBtn) {
        const refreshIcon = fetchBtn.querySelector("#fetchBtnRefreshIcon")
        const checkIcon = fetchBtn.querySelector("#fetchBtnCheckIcon")
        const textSpan = fetchBtn.querySelector("#fetchBtnText")
        
        if (refreshIcon) {
            refreshIcon.classList.remove("animate-spin")
            refreshIcon.classList.add("hidden")
        }
        if (checkIcon) checkIcon.classList.remove("hidden")
        if (textSpan) textSpan.innerText = textSpan.dataset.updatedText || "Up to date"
        
        fetchBtn.disabled = true
        fetchBtn.classList.remove("hover:bg-emerald-500/20")
        fetchBtn.classList.add("opacity-50", "cursor-not-allowed", "bg-emerald-500/20")
        
        setTimeout(() => {
          if (refreshIcon) refreshIcon.classList.remove("hidden")
          if (checkIcon) checkIcon.classList.add("hidden")
          if (textSpan) textSpan.innerText = textSpan.dataset.originalText || "Refresh"
          
          fetchBtn.disabled = false
          fetchBtn.classList.add("hover:bg-emerald-500/20")
          fetchBtn.classList.remove("opacity-50", "cursor-not-allowed", "bg-emerald-500/20")
        }, 60000)
      }
    }
  }

  const initDashboardController = () => {
    const dashboardCtx = {
      getMarketData: () => marketData,
      getDashboardData: () => dashboardData,
      getItemImageSrc,
      formatNumber,
      createSparklineSVG,
      calculateChange,
      labels: {
        dashMcapTitle: tDashMcapTitle,
        dashMcapTooltipTitle: tDashMcapTooltipTitle,
        dashMcapTooltipDesc: tDashMcapTooltipDesc,
        dashCatPowerups: tDashCatPowerups,
        dashCatResources: tDashCatResources,
        dashCatCosmetics: tDashCatCosmetics,
        dashPending: tDashPending,
        dashCatVol: tDashCatVol,
        dashCatSales: tDashCatSales,
        dashCatTitle: tDashCatTitle,
        dashCatTooltipTitle: tDashCatTooltipTitle,
        dashCatTooltipDesc: tDashCatTooltipDesc,
        seasons: tSeasons,
        days: tDays,
        seasonOf: tOf,
        dashWhales: tDashWhales,
        dashFgNeutral: tDashFgNeutral,
        dashFgExtremeFear: tDashFgExtremeFear,
        dashFgFear: tDashFgFear,
        dashFgGreed: tDashFgGreed,
        dashFgExtremeGreed: tDashFgExtremeGreed,
        dashFgTitle: tDashFgTitle,
        dashFgTooltipTitle: tDashFgTooltipTitle,
        dashFgTooltipDesc: tDashFgTooltipDesc,
        dashOverviewTitle: tDashOverviewTitle,
        dashOverviewFullTime: tDashOverviewFullTime,
        dashOverviewTotalVol: tDashOverviewTotalVol,
        dashOverviewTotalTrades: tDashOverviewTotalTrades,
        dashOverviewHolders: tDashOverviewHolders,
        vol: tVol,
        gainer24h: tGainer24h,
        topGainers: tTopGainers,
        gainer30d: tGainer30d,
        gainer180d: tGainer180d,
        nearAth: tNearAth,
        nearAtl: tNearAtl,
        tooltipAth: tTooltipAth,
        tooltipAtl: tTooltipAtl,
      },
    }
    window.__sflMarketDashboardCtx = dashboardCtx
    if (window.__initSflMarketDashboard) {
      window.__initSflMarketDashboard(dashboardCtx)
    }
  }

  const initModalController = () => {
    const modalCtx = {
      clientLang,
      getMarketData: () => marketData,
      getSflUsdPrice: () => window.sflUsdPrice || 0.085,
      getItemImageSrc,
      parseBoosts,
      formatModalPrice,
      formatModalUsd,
      formatNumber,
      calculateChange,
      labels: {
        maxCompare: tModalMaxCompare,
        noItemsFound: tModalNoItemsFound,
        clearComparison: tModalClearComparison,
        selectItemToCompare: tModalSelectItemToCompare,
        supply: tModalSupply,
        loading: tModalLoading,
        noListings: tModalNoListings,
        seller: tModalSeller,
      },
    }
    window.__sflMarketModalCtx = modalCtx
    if (window.__initSflTradingModal) {
      window.__initSflTradingModal(modalCtx)
    }
  }

  // Prevenir inicializaciones dobles en Astro
  const init = () => {
    // Evitar que el navegador salte al fondo durante las recargas asíncronas
    if ("scrollRestoration" in history) {
      history.scrollRestoration = "manual"
    }

    // Si ya inicializamos, salimos
    if (window.__sflMarketInitialized) return
    window.__sflMarketInitialized = true

    initDashboardController()
    initModalController()

    // Guardar la posición de scroll exacta antes de recargar/salir
    window.addEventListener("beforeunload", () => {
      sessionStorage.setItem("sfl_market_scroll", window.scrollY)
    })

    if (fetchBtn) {
      fetchBtn.addEventListener("click", () => {
        if (fetchBtn.disabled) return
        sessionStorage.setItem("sfl_market_scroll", window.scrollY)
        fetchData(true, true)
      })
    }

    const flowerRowToggle = document.getElementById("flowerRowToggle")
    if (flowerRowToggle) {
      const isHidden = localStorage.getItem("hide_flower_row") === "true"
      flowerRowToggle.checked = !isHidden
      window.__showFlowerRow = !isHidden
      
      flowerRowToggle.addEventListener("change", (e) => {
        window.__showFlowerRow = e.target.checked
        localStorage.setItem("hide_flower_row", !e.target.checked)
        renderTable(searchInput ? searchInput.value : "")
      })
    }

    // Acordeón para dispositivos móviles (Lazy render de sparklines para móviles de baja RAM)
    if (tableBody) {
      tableBody.addEventListener("click", (e) => {
        // Ignorar si estamos en escritorio (Tailwind lg: >= 1024px)
        if (window.innerWidth >= 1024) return

        const rowToggle = e.target.closest(".mobile-row-toggle")
        if (!rowToggle) return
        
        // Encontrar la fila actual
        const row = rowToggle.closest("[data-row-id]")
        if (!row) return

        // Lazy-render de las gráficas móviles solo cuando se expande la fila por primera vez
        const mobileSparklines = row.querySelector(".mobile-sparklines")
        if (mobileSparklines && mobileSparklines.dataset.rendered !== "true" && row._itemData) {
          const item = row._itemData
          if (row._isFlowerRow) {
            mobileSparklines.innerHTML = getCardColumnHTML(tCol7d, calculateChange(item.currentPrice, item.history["7d"]), item.history.sparkline7d, 8, false, item.currentPrice)
          } else {
            mobileSparklines.innerHTML = `
              ${getCardColumnHTML(tCol7d, calculateChange(item.currentPrice, item.history["7d"]), item.history.sparkline7d, 8, false, item.currentPrice)}
              ${getCardColumnHTML(tCol30d, calculateChange(item.currentPrice, item.history["30d"]), item.history.sparkline30d, 31, false, item.currentPrice)}
              ${getCardColumnHTML(tCol180d, calculateChange(item.currentPrice, item.history["180d"]), item.history.sparkline180d, 181, false, item.currentPrice)}
            `
          }
          mobileSparklines.dataset.rendered = "true"
        }

        // Alternar la visibilidad de la fila clickeada
        const chartsContainer = row.querySelector(".mobile-charts-container")
        if (chartsContainer) {
          chartsContainer.classList.toggle("hidden")
          row.classList.toggle("is-expanded")
        }
      })
    }

    if (searchInput) {
      let debounceTimeout
      searchInput.addEventListener("input", (e) => {
        const val = e.target.value

        // Si el usuario busca "bud" o números de ID, cargar buds bajo demanda
        if (val.trim().length > 0 && !window.__budsLoaded) {
          const lowerVal = val.toLowerCase()
          if (lowerVal.includes("bud") || /^\d+$/.test(val.trim()) || val.includes("#")) {
            window.loadBudsData()
          }
        }

        clearTimeout(debounceTimeout)
        debounceTimeout = setTimeout(() => {
          renderTable(val)
        }, 150)

        if (searchIcon && clearSearchBtn) {
          if (val.length > 0) {
            searchIcon.classList.add("hidden")
            clearSearchBtn.classList.remove("hidden")
          } else {
            searchIcon.classList.remove("hidden")
            clearSearchBtn.classList.add("hidden")
          }
        }
      })
    }

    if (clearSearchBtn) {
      clearSearchBtn.addEventListener("click", () => {
        if (searchInput) {
          searchInput.value = ""
          renderTable("")
          searchInput.focus()

          if (searchIcon) searchIcon.classList.remove("hidden")
          clearSearchBtn.classList.add("hidden")
        }
      })
    }

    // Primer fetch automático
    fetchData()

    if (window.currentSort.direction !== "none") {
      const activeIcons = document.querySelectorAll(`.sort-icon[data-col="${window.currentSort.column}"]`)
      activeIcons.forEach((activeIcon) => {
        activeIcon.innerHTML = window.currentSort.direction === "desc" ? "↓" : "↑"
        activeIcon.classList.remove("hidden", "opacity-0")
        activeIcon.classList.add("text-emerald-400", "opacity-100")
      })
    }

    if (window.__initSparklineHover) {
      window.__initSparklineHover()
    }
  }

  // Manejar el ciclo de vida de Astro ViewTransitions
  document.addEventListener("astro:page-load", () => {
    window.__sflMarketInitialized = false // Reset en navegacion
    init()
  })

  // Por si ViewTransitions no está activo
  if (document.readyState === "complete" || document.readyState === "interactive") {
    setTimeout(init, 1)
  } else {
    document.addEventListener("DOMContentLoaded", init)
  }

  // Mejora 11 — Pausar carruseles cuando el usuario cambia de pestaña.
  // Los navegadores acumulan eventos 'animationend' en segundo plano y los
  // disparan todos de golpe al volver, haciendo girar el carrusel como loco.
  // Guardia para evitar duplicar el listener si Astro ViewTransitions recarga la página
  if (!window.__sflVisibilityListenerRegistered) {
    window.__sflVisibilityListenerRegistered = true
    document.addEventListener("visibilitychange", () => {
      const isHidden = document.visibilityState === "hidden"
      if (isHidden) {
        // Los carruseles ahora usan CSS animationend secuencial sin setInterval,
        // por lo que el navegador los pausa naturalmente en segundo plano sin acumular eventos.
      } else {
        if (marketData.length > 0 && window.__initSparklineHover) {
           window.__initSparklineHover();
        }
      }
    })
  }

  // Lógica para indicadores visuales de scroll
  const initScrollHints = () => {
    const wrappers = document.querySelectorAll(".scroll-hint-wrapper")
    wrappers.forEach((wrapper) => {
      const area = wrapper.querySelector(".scroll-area")
      const hint = wrapper.querySelector(".scroll-hint")
      if (!area || !hint) return

      let interacted = false

      const checkScroll = () => {
        if (interacted) return
        // Mostrar solo si hay overflow
        if (area.scrollWidth > area.clientWidth + 5) {
          hint.classList.remove("opacity-0")
          hint.classList.add("opacity-100")
        } else {
          hint.classList.add("opacity-0")
          hint.classList.remove("opacity-100")
        }
      }

      area.addEventListener("scroll", () => {
        if (area.scrollLeft > 5) {
          interacted = true
          hint.classList.add("opacity-0")
          hint.classList.remove("opacity-100")
        } else if (!interacted) {
          hint.classList.remove("opacity-0")
          hint.classList.add("opacity-100")
        }
      })

      // Chequear al montar
      setTimeout(checkScroll, 300)
      window.addEventListener("resize", checkScroll)
    })
  }

  const initStickyHeader = () => {
    const sentinel = document.getElementById("headerSentinel")
    const header = document.getElementById("desktopHeader")
    if (sentinel && header) {
      const observer = new IntersectionObserver(
        ([e]) => {
          header.classList.toggle("is-sticky", e.intersectionRatio < 1)
        },
        { threshold: [1] }
      )
      observer.observe(sentinel)
    }
  }

  document.addEventListener("astro:page-load", () => {
    initScrollHints()
    initStickyHeader()
  })
  if (document.readyState === "complete" || document.readyState === "interactive") {
    setTimeout(() => {
      initScrollHints()
      initStickyHeader()
    }, 1)
  } else {
    document.addEventListener("DOMContentLoaded", () => {
      initScrollHints()
      initStickyHeader()
    })
  }
</script>
