      const newBadgeHTML = hasIncompleteGraph ? `<div class="absolute -top-[5px] -right-[5px] bg-[#f59e0b] text-black text-[7.5px] font-black px-[4px] py-[1.5px] rounded-[3px] uppercase tracking-wider shadow-md border border-black/20 whitespace-nowrap z-20 leading-none pointer-events-none select-none">NEW</div>` : ""

