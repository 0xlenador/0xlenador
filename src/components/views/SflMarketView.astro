---
// ============================================================
// src/components/views/SflMarketView.astro
// View puro para la herramienta de mercado SFL.
// ============================================================
import { getLangFromUrl, useTranslations } from "../../i18n/utils"
import SflToolLayout from "../SflToolLayout.astro"
import SflTradingModal from "../sfl/market/SflTradingModal.astro"

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)

const marketConfig = {
  clientLang: lang,
  tableLabels: {
    emptySearch: t("sfl.market.emptySearch"),
    colPrice: t("sfl.market.col.price"),
    col24h: t("sfl.market.col.24h"),
    col7d: t("sfl.market.col.7d"),
    col30d: t("sfl.market.col.30d"),
    col180d: t("sfl.market.col.180d"),
    colMarketcap: t("sfl.market.col.marketcap"),
    hideFlower: t("sfl.market.hideFlower"),
    modalViewChart: t("sfl.modal.viewChart"),
  },
  dashboardLabels: {
    dashMcapTitle: t("sfl.dashboard.mcap.title"),
    dashMcapTooltipTitle: t("sfl.dashboard.mcap.tooltip.title"),
    dashMcapTooltipDesc: t("sfl.dashboard.mcap.tooltip.desc"),
    dashCatPowerups: t("sfl.dashboard.cat.powerups"),
    dashCatResources: t("sfl.dashboard.cat.resources"),
    dashCatCosmetics: t("sfl.dashboard.cat.cosmetics"),
    dashPending: t("sfl.dashboard.pending"),
    dashCatVol: t("sfl.dashboard.cat.vol"),
    dashCatSales: t("sfl.dashboard.cat.sales"),
    dashCatTitle: t("sfl.dashboard.cat.title"),
    dashCatTooltipTitle: t("sfl.dashboard.cat.tooltip.title"),
    dashCatTooltipDesc: t("sfl.dashboard.cat.tooltip.desc"),
    seasons: [
      t("sfl.season.winter"),
      t("sfl.season.spring"),
      t("sfl.season.summer"),
      t("sfl.season.autumn"),
    ],
    days: [
      t("sfl.day.monday"),
      t("sfl.day.tuesday"),
      t("sfl.day.wednesday"),
      t("sfl.day.thursday"),
      t("sfl.day.friday"),
      t("sfl.day.saturday"),
      t("sfl.day.sunday"),
    ],
    seasonOf: t("sfl.season.of"),
    dashWhales: t("sfl.dashboard.whales.title"),
    dashFgNeutral: t("sfl.dashboard.fg.neutral"),
    dashFgExtremeFear: t("sfl.dashboard.fg.extremeFear"),
    dashFgFear: t("sfl.dashboard.fg.fear"),
    dashFgGreed: t("sfl.dashboard.fg.greed"),
    dashFgExtremeGreed: t("sfl.dashboard.fg.extremeGreed"),
    dashFgTitle: t("sfl.dashboard.fg.title"),
    dashFgTooltipTitle: t("sfl.dashboard.fg.tooltip.title"),
    dashFgTooltipDesc: t("sfl.dashboard.fg.tooltip.desc"),
    dashOverviewTitle: t("sfl.dashboard.overview.title"),
    dashOverviewFullTime: t("sfl.dashboard.overview.fullTime"),
    dashOverviewTotalVol: t("sfl.dashboard.overview.totalVol"),
    dashOverviewTotalTrades: t("sfl.dashboard.overview.totalTrades"),
    dashOverviewHolders: t("sfl.dashboard.overview.holders"),
    vol: t("sfl.slider.vol"),
    gainer24h: t("sfl.slider.topGainer.24h"),
    topGainers: t("sfl.dashboard.topGainers"),
    gainer30d: t("sfl.slider.topGainer.30d"),
    gainer180d: t("sfl.slider.topGainer.180d"),
    nearAth: t("sfl.dashboard.nearAth"),
    nearAtl: t("sfl.slider.nearAtl"),
    tooltipAth: t("sfl.slider.tooltip.ath"),
    tooltipAtl: t("sfl.slider.tooltip.atl"),
  },
  modalLabels: {
    maxCompare: t("sfl.modal.maxCompare"),
    noItemsFound: t("sfl.modal.noItemsFound"),
    clearComparison: t("sfl.modal.clearComparison"),
    selectItemToCompare: t("sfl.modal.selectItemToCompare"),
    supply: t("sfl.modal.supply"),
    loading: t("sfl.modal.loading"),
    noListings: t("sfl.modal.noListings"),
    seller: t("sfl.modal.seller"),
  },
}
---

<SflToolLayout activeTab="mercado">
    <div
      class="flex flex-col lg:flex-row justify-between items-center lg:items-start gap-3 mb-2 relative z-10 text-center sm:text-left"
    >
      <div class="w-full lg:w-auto">
        <h1 class="text-xl md:text-2xl font-black text-white tracking-tighter mb-1">
          {t("sfl.heading")}
          <span class="text-emerald-500"> {t("sfl.heading.accent")}</span>
        </h1>
        <p class="text-terminal-secondary text-sm leading-snug max-w-2xl mx-auto sm:mx-0">
          {t("sfl.intro")}
        </p>
      </div>
      <div class="hidden lg:flex w-full lg:w-auto justify-center lg:justify-end shrink-0 lg:pt-1 gap-4">
        <!-- Tarjeta Yakkamon -->
        <div
          class="relative bg-white/[0.02] border border-amber-500/20 pr-4 rounded-2xl flex items-stretch shadow-[0_0_15px_rgba(245,158,11,0.05)] hover:border-amber-500/40 transition-colors group"
        >
          <!-- Badge Nuevo Juego sin fondo negro extra -->
          <span class="absolute -top-[7px] left-1/2 -translate-x-1/2 bg-[#0c1015] text-amber-500/90 border border-amber-500/20 px-1.5 py-[1px] rounded-[3px] text-[7px] font-mono font-bold uppercase tracking-widest whitespace-nowrap">{t("sfl.newGame")}</span>

          <!-- Imagen alto completo al borde sin espacio -->
          <a href="https://yakkamon.com/?code=VNTB4Y" target="_blank" rel="noopener noreferrer" class="w-12 shrink-0 overflow-hidden cursor-pointer flex items-center justify-center rounded-l-[15px] bg-amber-500/5">
            <img
              src="/img/cripto/yakkamon.webp"
              alt="Yakkamon"
              class="w-full h-full object-cover group-hover:scale-110 transition-transform"
            />
          </a>
          
          <div class="flex flex-col text-left justify-center py-2 pl-3">
            <a href="https://yakkamon.com/?code=VNTB4Y" target="_blank" rel="noopener noreferrer" class="flex items-center gap-1 text-[15px] text-white font-black tracking-wider leading-none hover:text-amber-400 transition-colors mb-1">
              Yakkamon
              <svg class="w-3 h-3 text-amber-500/70" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </a>
            <div class="flex items-center gap-1 group/code cursor-pointer" onclick="navigator.clipboard.writeText('YAKKA-VNTB4Y'); const i=this.querySelector('.copy-icon'); const c=this.querySelector('.check-icon'); i.classList.add('hidden'); c.classList.remove('hidden'); setTimeout(()=>{i.classList.remove('hidden'); c.classList.add('hidden');}, 2000)" title="Copiar código">
              <span class="text-[7px] font-mono text-terminal-secondary group-hover/code:text-amber-400 transition-colors uppercase tracking-widest">Code: <span class="text-[9px] font-bold text-white group-hover/code:text-amber-400">YAKKA-VNTB4Y</span></span>
              
              <!-- Ícono de copiar normal -->
              <svg class="w-2.5 h-2.5 text-terminal-muted/60 group-hover/code:text-amber-400/80 transition-colors copy-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/>
              </svg>

              <!-- Ícono de check verde (oculto por defecto) -->
              <svg class="w-2.5 h-2.5 text-emerald-500 hidden check-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
              </svg>
            </div>
          </div>
        </div>


      </div>
    </div>

    <div
      id="loadingState"
      class="relative z-10 mb-2 min-h-[100vh]"
    >
      <div class="grid grid-cols-[max-content_max-content_max-content_max-content] overflow-x-auto snap-x snap-mandatory gap-2 mt-7 mb-7 pb-6 lg:grid-cols-4 lg:gap-2 lg:pb-0 lg:overflow-visible no-scrollbar">
        <!-- Fila 1 -->
        <div class="min-w-[85vw] sm:min-w-[320px] lg:min-w-0 snap-center shrink-0 h-[130px] bg-white/[0.03] rounded-[16px] animate-pulse border border-white/5"></div>
        <div class="min-w-[85vw] sm:min-w-[320px] lg:min-w-0 snap-center shrink-0 h-[130px] bg-white/[0.03] rounded-[16px] animate-pulse border border-white/5"></div>
        <div class="min-w-[85vw] sm:min-w-[320px] lg:min-w-0 snap-center shrink-0 h-[130px] bg-white/[0.03] rounded-[16px] animate-pulse border border-white/5"></div>
        <div class="flex h-[268px] min-w-[85vw] sm:min-w-[320px] lg:min-w-0 snap-center shrink-0 bg-white/[0.03] rounded-[16px] animate-pulse border border-white/5 row-span-2"></div>
        <!-- Fila 2 -->
        <div class="min-w-[85vw] sm:min-w-[320px] lg:min-w-0 snap-center shrink-0 h-[130px] bg-white/[0.03] rounded-[16px] animate-pulse border border-white/5"></div>
        <div class="min-w-[85vw] sm:min-w-[320px] lg:min-w-0 snap-center shrink-0 h-[130px] bg-white/[0.03] rounded-[16px] animate-pulse border border-white/5"></div>
        <div class="min-w-[85vw] sm:min-w-[320px] lg:min-w-0 snap-center shrink-0 h-[130px] bg-white/[0.03] rounded-[16px] animate-pulse border border-white/5"></div>
      </div>

      <!-- Skeleton de Título y Botón Refresh -->
      <div class="flex flex-wrap items-center justify-between mb-2 gap-2 mt-2">
        <div class="h-7 w-48 bg-white/[0.03] rounded-lg animate-pulse border border-white/5"></div>
        <div class="h-8 w-full sm:w-24 bg-white/[0.03] rounded-xl animate-pulse border border-white/5"></div>
      </div>

      <!-- Skeleton de Filtros y Buscador -->
      <div class="bg-black/20 border border-white/10 rounded-xl p-2 lg:p-3 mb-3 flex flex-col lg:flex-row lg:items-center justify-between gap-2 lg:gap-3 shadow-2xl animate-pulse">
        <div class="h-10 w-full lg:w-1/3 bg-white/[0.03] rounded-lg border border-white/5"></div>
        <div class="h-10 w-full lg:w-1/2 bg-white/[0.03] rounded-lg border border-white/5"></div>
      </div>

      <!-- Skeleton de Cabecera (solo desktop) -->
      <div class="hidden lg:grid grid-cols-[22%_10%_8%_11%_12%_10%_27%] border-b border-white/[0.05] py-4">
        <div class="h-4 w-16 bg-white/[0.03] rounded border border-white/5 ml-4"></div>
        <div class="h-4 w-16 bg-white/[0.03] rounded border border-white/5 ml-auto"></div>
        <div class="h-4 w-12 bg-white/[0.03] rounded border border-white/5 ml-auto"></div>
        <div class="h-4 w-16 bg-white/[0.03] rounded border border-white/5 ml-auto"></div>
        <div class="h-4 w-14 bg-white/[0.03] rounded border border-white/5 ml-auto"></div>
        <div class="h-4 w-14 bg-white/[0.03] rounded border border-white/5 ml-auto"></div>
        <div class="h-4 w-28 bg-white/[0.03] rounded border border-white/5 ml-auto mr-4"></div>
      </div>

      <!-- Skeleton de Filas de Tabla -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:block gap-4 lg:gap-0 lg:divide-y lg:divide-white/[0.02] mt-4 lg:mt-0">
        {[1, 2, 3, 4, 5, 6].map(() => (
          <div class="bg-black/20 lg:bg-transparent rounded-xl lg:rounded-none p-4 lg:p-0 border border-white/5 lg:border-none">
            <!-- Diseño móvil/tablet: skeleton de carta -->
            <div class="lg:hidden flex flex-col gap-4 animate-pulse">
              <div class="flex justify-between items-center">
                <div class="flex items-center gap-3">
                  <div class="w-12 h-12 rounded-lg bg-white/[0.03] border border-white/5"></div>
                  <div class="flex flex-col gap-2">
                    <div class="w-24 h-4 rounded bg-white/[0.03] border border-white/5"></div>
                    <div class="w-16 h-3 rounded bg-white/[0.03] border border-white/5"></div>
                  </div>
                </div>
                <div class="w-20 h-8 rounded-lg bg-white/[0.03] border border-white/5"></div>
              </div>
              <div class="w-full h-10 rounded-lg bg-white/[0.03] border border-white/5"></div>
            </div>
            
            <!-- Diseño desktop: skeleton de fila -->
            <div class="hidden lg:grid grid-cols-[22%_10%_8%_11%_12%_10%_27%] items-center py-4 animate-pulse">
              <div class="flex items-center gap-3 px-4">
                <div class="w-10 h-10 rounded-lg bg-white/[0.03] border border-white/5"></div>
                <div class="flex flex-col gap-2">
                  <div class="w-24 h-4 rounded bg-white/[0.03] border border-white/5"></div>
                  <div class="w-16 h-3 rounded bg-white/[0.03] border border-white/5"></div>
                </div>
              </div>
              <div class="flex justify-end px-4"><div class="w-16 h-4 rounded bg-white/[0.03] border border-white/5"></div></div>
              <div class="flex justify-end px-3"><div class="w-12 h-4 rounded bg-white/[0.03] border border-white/5"></div></div>
              <div class="flex justify-end px-3"><div class="w-16 h-4 rounded bg-white/[0.03] border border-white/5"></div></div>
              <div class="flex justify-end px-3"><div class="w-14 h-4 rounded bg-white/[0.03] border border-white/5"></div></div>
              <div class="flex justify-end px-3"><div class="w-14 h-4 rounded bg-white/[0.03] border border-white/5"></div></div>
              <div class="flex justify-end px-4"><div class="w-44 h-10 rounded-lg bg-white/[0.03] border border-white/5"></div></div>
            </div>
          </div>
        ))}
      </div>
    </div>

    <div
      id="errorState"
      class="hidden py-12 px-6 bg-red-500/10 border border-red-500/20 rounded-xl relative z-10"
    >
      <p id="errorMsg" class="text-red-400 text-sm text-center">{t("sfl.error")}</p>
    </div>

    <div id="dataContainer" class="hidden relative z-10">
      <!-- Dashboard Resumen -->
      <!-- Nuevo Dashboard (Estructura de 7 Cajas) -->
      <div class="relative mb-2">
        <div class="grid grid-cols-[max-content_max-content_max-content_max-content] overflow-x-auto snap-x snap-mandatory gap-2 mt-7 mb-7 pb-6 lg:grid-cols-4 lg:gap-2 lg:pb-0 lg:overflow-visible no-scrollbar">
          <!-- Fila 1 -->
          <div id="dashBox1" class="relative min-w-[85vw] sm:min-w-[320px] lg:min-w-0 snap-center shrink-0 bg-white/[0.03] border border-white/5 rounded-[16px] shadow-inner flex flex-col items-center justify-center min-h-[130px]">
            <span class="text-4xl font-bold text-white/20">1</span>
          </div>
          <div id="dashBox2" class="relative min-w-[85vw] sm:min-w-[320px] lg:min-w-0 snap-center shrink-0 bg-white/[0.03] border border-white/5 rounded-[16px] shadow-inner flex flex-col items-center justify-center min-h-[130px]">
            <span class="text-sm font-bold text-white/20 uppercase tracking-widest">{t("sfl.dashboard.pending")}</span>
          </div>
          <div id="dashBox3" class="relative min-w-[85vw] sm:min-w-[320px] lg:min-w-0 snap-center shrink-0 bg-white/[0.03] border border-white/5 rounded-[16px] shadow-inner flex flex-col items-center justify-center min-h-[130px]">
            <span class="text-sm font-bold text-white/20 uppercase tracking-widest">{t("sfl.dashboard.pending")}</span>
          </div>
          <div id="dashBox4" class="relative flex bg-white/[0.03] border border-white/5 rounded-[16px] shadow-inner flex-col items-center justify-center min-h-[268px] row-span-2 min-w-[85vw] sm:min-w-[320px] lg:min-w-0 snap-center shrink-0">
            <span class="text-6xl font-bold text-white/20">4</span>
          </div>
          <!-- Fila 2 -->
          <div id="dashBox5" class="relative min-w-[85vw] sm:min-w-[320px] lg:min-w-0 snap-center shrink-0 bg-white/[0.03] border border-white/5 rounded-[16px] shadow-inner flex flex-col items-center justify-center min-h-[130px]">
            <span class="text-4xl font-bold text-white/20">5</span>
          </div>
          <div class="relative min-w-[85vw] sm:min-w-[320px] lg:min-w-0 snap-center shrink-0 flex flex-row gap-2 h-full">
            <div id="dashBox6" class="flex-1 bg-white/[0.03] border border-white/5 rounded-[16px] shadow-inner flex flex-col items-center justify-center relative min-h-[130px]">
              <span class="text-4xl font-bold text-white/20">6</span>
            </div>
            <div id="dashBox6_1" class="flex-1 bg-white/[0.03] border border-white/5 rounded-[16px] shadow-inner flex flex-col items-center justify-center relative min-h-[130px]">
              <span class="text-3xl font-bold text-white/20">6.1</span>
            </div>
          </div>
          <div id="dashBox7" class="relative min-w-[85vw] sm:min-w-[320px] lg:min-w-0 snap-center shrink-0 bg-white/[0.03] border border-white/5 rounded-[16px] shadow-inner flex flex-col items-center justify-center min-h-[130px]">
            <span class="text-4xl font-bold text-white/20">7</span>
          </div>
        </div>
      </div>

      <!-- Ancla Oculta para el Motor Central -->
      <span class="price-value hidden" data-coin-id="flower-2" data-needs-volume-7d="true"></span>
      <span class="price-value hidden" data-coin-id="bitcoin"></span>
      <div
        class="flex flex-wrap items-center justify-between mb-2 gap-2"
      >
        <div class="flex items-center flex-wrap gap-2">
          <h2 class="text-[20px] font-semibold text-white">
            {t("sfl.activity")}
            <span
              class="text-[10px] text-terminal-muted font-normal ml-2 tracking-wide hidden sm:inline"
              >P2P History</span>
          </h2>
        </div>
        
        <label class="flex items-center cursor-pointer gap-2 mr-1 sm:mr-3 group ml-auto" title="Mostrar fila de $FLOWER">
          <span class="text-[10px] sm:text-xs font-bold text-terminal-muted group-hover:text-white transition-colors">$FLOWER</span>
          <div class="relative flex items-center">
            <input type="checkbox" id="flowerRowToggle" class="sr-only peer" checked>
            <div class="w-8 h-4 bg-black/50 border border-white/10 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-4 peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-terminal-muted peer-checked:after:bg-emerald-400 after:border-transparent after:rounded-full after:h-3 after:w-3 after:transition-all peer-checked:bg-emerald-500/20"></div>
          </div>
        </label>
        
        <button
          id="fetchBtn"
          class="px-3 py-1.5 bg-emerald-500/10 hover:bg-emerald-500/20 border border-emerald-500/30 text-emerald-400 font-bold text-xs rounded-xl transition-colors whitespace-nowrap flex items-center gap-2 group w-full sm:w-auto shrink-0 justify-center"
        >
          <svg
            id="fetchBtnRefreshIcon"
            class="w-3.5 h-3.5 group-hover:rotate-180 transition-transform duration-500 shrink-0"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            ><path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"
            ></path></svg
          >
          <svg 
            id="fetchBtnCheckIcon"
            class="w-3.5 h-3.5 shrink-0 hidden" 
            fill="none" 
            viewBox="0 0 24 24" 
            stroke="currentColor"
            ><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
          <span id="fetchBtnText" data-original-text={t("sfl.refresh")} data-updated-text={t("sfl.updated")}>{t("sfl.refresh")}</span>
        </button>
      </div>

      <!-- Filtros y Buscador -->
      <div
        class="bg-black/20 backdrop-blur-xl border border-white/10 rounded-xl p-2 lg:p-3 mb-3 flex flex-col lg:flex-row lg:items-center justify-between gap-2 lg:gap-3 relative z-30 shadow-2xl"
      >
        <!-- Buscador Pro -->
        <div class="w-full lg:w-1/3 relative z-40 group">
          <div
            class="relative flex items-center w-full bg-black/40 border border-white/10 rounded-lg overflow-hidden focus-within:border-emerald-500/50 focus-within:ring-1 focus-within:ring-emerald-500/30 transition-all duration-300"
          >
            <div class="pl-3 pr-2 flex items-center justify-center">
              <svg
                id="searchIcon"
                class="w-4 h-4 text-white/40 group-focus-within:text-emerald-400 transition-colors duration-300"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
              </svg>
            </div>
            <input
              type="text"
              id="searchInput"
              placeholder={t("sfl.search.placeholder")}
              autocomplete="off"
              spellcheck="false"
              style="outline: none !important; box-shadow: none !important; border: none !important; background-color: transparent !important;"
              class="w-full px-2 py-3 text-white placeholder-white/30 text-sm"
            />
            <button
              id="clearSearchBtn"
              class="hidden absolute right-3 focus:outline-none hover:bg-white/10 p-1 rounded-full transition-colors"
            >
              <svg
                class="w-4 h-4 text-white/50 hover:text-white"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M6 18L18 6M6 6l12 12"></path>
              </svg>
            </button>
          </div>
        </div>

        <div class="w-full lg:w-auto flex flex-col lg:flex-row lg:items-center gap-3 lg:gap-5">
          <!-- Segmented Control para Categorías (Scroll horizontal en móvil con sangría) -->
          <div class="relative w-full lg:w-auto scroll-hint-wrapper">
            <div
              class="w-[calc(100%)] lg:w-auto lg:ml-0 lg:px-0 overflow-x-auto no-scrollbar pb-1 lg:pb-0 scroll-area"
            >
              <div
                class="flex items-center bg-black/40 border border-white/10 rounded-xl p-1 w-max md:w-full lg:w-max md:gap-1 lg:gap-0"
              >
                <button
                  class="category-btn relative px-5 py-2.5 rounded-lg text-xs font-bold uppercase tracking-wider text-emerald-400 bg-white/5 shadow-[0_0_15px_rgba(16,185,129,0.1)] whitespace-nowrap shrink-0 transition-all duration-300 flex items-center justify-center gap-2 md:flex-1 lg:flex-none"
                  data-category="resources"
                  onclick="window.handleCategory('resources')"
                >
                  <img
                    src="/img/sunflowerland/Eggplant.png"
