<script
  define:vars={{
    sflIds,
    sflPowerUps,
    sflCosmetics,
    tTopGainers: t("sfl.dashboard.topGainers"),
    tNearAth: t("sfl.dashboard.nearAth"),
    tVol: t("sfl.slider.vol"),
    tGainer24h: t("sfl.slider.topGainer.24h"),
    tGainer30d: t("sfl.slider.topGainer.30d"),
    tGainer180d: t("sfl.slider.topGainer.180d"),
    tNearAtl: t("sfl.slider.nearAtl"),
    tTooltipAth: t("sfl.slider.tooltip.ath"),
    tTooltipAtl: t("sfl.slider.tooltip.atl"),
    tEmptySearch: t("sfl.market.emptySearch"),
    tColPrice: t("sfl.market.col.price"),
    tCol24h: t("sfl.market.col.24h"),
    tCol7d: t("sfl.market.col.7d"),
    tCol30d: t("sfl.market.col.30d"),
    tCol180d: t("sfl.market.col.180d"),
    tColMarketcap: t("sfl.market.col.marketcap"),
  }}
>
  const searchInput = document.getElementById("searchInput")
  const tableBody = document.getElementById("tableBody")
  const filterContainer = document.getElementById("filterContainer")
  const desktopHeader = document.getElementById("desktopHeader")
  const supplyHeader = document.getElementById("supplyHeader")
  const marketcapHeader = document.getElementById("marketcapHeader")
  const searchIcon = document.getElementById("searchIcon")
  const clearSearchBtn = document.getElementById("clearSearchBtn")
  const fetchBtn = document.getElementById("fetchBtn")
  const loadingState = document.getElementById("loadingState")
  const errorState = document.getElementById("errorState")
  const errorMsg = document.getElementById("errorMsg")
  const dataContainer = document.getElementById("dataContainer")

  let marketData = []
  let currentCategory = "resources"
  let currentSubCategories = ["collectibles", "wearables"]
  let searchQuery = ""

  window.toggleGraph = (period) => {
    document.querySelectorAll('.desktop-graph-7d, .desktop-graph-30d, .desktop-graph-180d').forEach(el => {
      el.classList.add('hidden')
    })
    
    document.querySelectorAll(`.desktop-graph-${period}`).forEach(el => {
      el.classList.remove('hidden')
    })
    
    document.querySelectorAll('.graph-toggle-btn').forEach(btn => {
      btn.classList.remove('bg-white/10', 'text-white')
      btn.classList.add('text-terminal-muted')
    })
    
    const activeBtn = document.getElementById(`btn-graph-${period}`)
    if (activeBtn) {
      activeBtn.classList.remove('text-terminal-muted')
      activeBtn.classList.add('bg-white/10', 'text-white')
    }

    const titleEl = document.getElementById("graph-col-title")
    const sortBtn = document.getElementById("graph-sort-btn")
    const sortIcon = document.getElementById("graph-sort-icon")
    
    if (titleEl && sortBtn && sortIcon) {
      const isEn = window.location.pathname.includes('/en/')
      const prefix = isEn ? 'Price Change' : 'Cambio de precio'
      titleEl.innerText = `${prefix} (${period})`
      sortBtn.setAttribute("onclick", `window.handleSort('${period}')`)
      sortIcon.setAttribute("data-col", period)
    }
  }

  window.currentSort = { column: "trades24h", direction: "desc" }

  window.handleCategory = function (category) {
    currentCategory = category
    currentSubCategories = ["collectibles", "wearables"]

    const filterContainer = document.getElementById("subfilters-container")
    const desktopHeader = document.getElementById("desktopHeader")
    const supplyHeader = document.getElementById("supplyHeader")
    const marketcapHeader = document.getElementById("marketcapHeader")

    if (category === "powerups" || category === "cosmetics") {
      if (filterContainer) {
        filterContainer.classList.remove("opacity-30", "grayscale", "pointer-events-none")
        filterContainer.classList.add("opacity-100")
      }
      if (desktopHeader) {
        desktopHeader.classList.remove("grid-cols-[25%_15%_17%_17%_26%]")
        desktopHeader.classList.add("grid-cols-[20%_10%_12%_13%_10%_12%_23%]")
      }
      if (supplyHeader) supplyHeader.classList.remove("hidden")
      if (marketcapHeader) marketcapHeader.classList.remove("hidden")
      document.querySelectorAll(".sub-checkbox-common").forEach((cb) => (cb.checked = true))
    } else {
      if (filterContainer) {
        filterContainer.classList.add("pointer-events-none")
        filterContainer.classList.remove("opacity-100")
      }
      if (desktopHeader) {
        desktopHeader.classList.remove("grid-cols-[20%_10%_12%_13%_10%_12%_23%]")
        desktopHeader.classList.add("grid-cols-[25%_15%_17%_17%_26%]")
      }
      if (supplyHeader) supplyHeader.classList.add("hidden")
      if (marketcapHeader) marketcapHeader.classList.add("hidden")
    }

    document.querySelectorAll(".category-btn").forEach((btn) => {
      if (btn.dataset.category === category) {
        btn.className =
          "category-btn relative px-5 py-2.5 rounded-lg text-xs font-bold uppercase tracking-wider text-emerald-400 bg-white/5 shadow-[0_0_15px_rgba(16,185,129,0.1)] whitespace-nowrap shrink-0 transition-all duration-300 flex items-center gap-2"
      } else {
        btn.className =
          "category-btn relative px-5 py-2.5 rounded-lg text-xs font-bold uppercase tracking-wider text-white/50 hover:text-white hover:bg-white/5 whitespace-nowrap shrink-0 transition-all duration-300 flex items-center gap-2"
      }
    })

    renderTable(searchInput ? searchInput.value : "")
  }

  window.toggleSubCategory = function (subCategory) {
    if (currentSubCategories.includes(subCategory)) {
      if (currentSubCategories.length === 1) {
        currentSubCategories = subCategory === "collectibles" ? ["wearables"] : ["collectibles"]
      } else {
        currentSubCategories = currentSubCategories.filter((sc) => sc !== subCategory)
      }
    } else {
      currentSubCategories.push(subCategory)
    }

    document.querySelectorAll(".sub-checkbox-common").forEach((cb) => {
      cb.checked = currentSubCategories.includes(cb.value)
    })

    renderTable(searchInput ? searchInput.value : "")
  }

  window.handleSort = (column) => {
    if (window.currentSort.column === column) {
      if (window.currentSort.direction === "none") window.currentSort.direction = "desc"
      else if (window.currentSort.direction === "desc") window.currentSort.direction = "asc"
      else window.currentSort.direction = "none"
    } else {
      window.currentSort.column = column
      window.currentSort.direction = "desc"
    }

    document.querySelectorAll(".sort-icon").forEach((icon) => {
      icon.innerHTML = "↓"
      icon.classList.add("hidden")
      icon.classList.remove("text-emerald-400")
    })

    if (window.currentSort.direction !== "none") {
      const activeIcons = document.querySelectorAll(`.sort-icon[data-col="${column}"]`)
      activeIcons.forEach((activeIcon) => {
        activeIcon.innerHTML = window.currentSort.direction === "desc" ? "↓" : "↑"
        activeIcon.classList.remove("hidden")
        activeIcon.classList.add("text-emerald-400")
      })
    }

    const searchInput = document.getElementById("searchInput")
    renderTable(searchInput ? searchInput.value : "")
  }

  window.scrollToItem = (itemName, event) => {
    if (event) {
      event.stopPropagation()
      event.preventDefault()
    }

    const targetItem = marketData.find((item) => item.name === itemName)
    if (targetItem) {
      const targetCategory = targetItem.category
      if (currentCategory !== targetCategory) {
        window.handleCategory(targetCategory)
      }
    }

    const searchInput = document.getElementById("searchInput")
    if (searchInput && searchInput.value !== "") {
      searchInput.value = ""
      renderTable()
    }

    if (window.__currentFilteredData) {
      const targetIndex = window.__currentFilteredData.findIndex((item) => item.name === itemName)
      if (targetIndex !== -1) {
        const targetPage = Math.floor(targetIndex / ITEMS_PER_PAGE) + 1
        while (currentPage < targetPage) {
          currentPage++
          renderPage(currentPage)
        }
      }
    }

    requestAnimationFrame(() => {
      const safeName = itemName.replace(/"/g, '\\"')
      const row = document.querySelector(`div[data-row-id="${safeName}"]`)

      if (row) {
        row.scrollIntoView({ behavior: "smooth", block: "center" })
        row.classList.add("!bg-emerald-500/20", "lg:rounded-xl", "transition-all", "duration-500")
        setTimeout(() => {
          row.classList.remove(
            "!bg-emerald-500/20",
            "lg:rounded-xl",
            "transition-all",
            "duration-500",
          )
        }, 1500)
      }
    })
  }

  const formatNumber = (num, decimals = 2) => {
    if (num === undefined || num === null || num === 0) return "0"
    if (num < 0.0001) return num.toExponential(2)
    return new Intl.NumberFormat("en-US", {
      minimumFractionDigits: 0,
      maximumFractionDigits: decimals,
    }).format(num)
  }

  const createSparklineSVG = (dataArray, isPositive, expectedLength) => {
    if (!dataArray) return ""
    const validData = dataArray.filter((v) => v !== null && v !== undefined)
    if (validData.length < 2) return ""

    expectedLength = expectedLength || validData.length
    const width = 100
    const height = 30
    const max = Math.max(...validData)
    const min = Math.min(...validData)
    const range = max - min || 1

    const getX = (i) => {
      const daysAgo = validData.length - 1 - i
      const xProgress = 1 - (daysAgo / Math.max(1, expectedLength - 1))
      return xProgress * width
    }
    const getY = (val) => height - ((val - min) / range) * height

    const pointsArray = validData.map((val, i) => [getX(i), getY(val)])

    const getCurve = (pts) => {
      if (pts.length === 2) return `L ${pts[1][0]},${pts[1][1]}`
      let d = ""
      for (let i = 0; i < pts.length - 1; i++) {
        const p0 = pts[i === 0 ? 0 : i - 1]
        const p1 = pts[i]
        const p2 = pts[i + 1]
        const p3 = pts[i + 2 === pts.length ? i + 1 : i + 2]
        
        const cp1x = p1[0] + (p2[0] - p0[0]) / 6
        const cp1y = p1[1] + (p2[1] - p0[1]) / 6
        const cp2x = p2[0] - (p3[0] - p1[0]) / 6
        const cp2y = p2[1] - (p3[1] - p1[1]) / 6
        
        d += ` C ${cp1x},${cp1y} ${cp2x},${cp2y} ${p2[0]},${p2[1]}`
      }
      return d
    }

    const strokePath = `M ${pointsArray[0][0]},${pointsArray[0][1]} ${getCurve(pointsArray)}`
    const fillPath = `${strokePath} L ${width},${height} L ${pointsArray[0][0]},${height} Z`

    const maxIndex = validData.indexOf(max)
    const minIndex = validData.indexOf(min)
    const finalIndex = validData.length - 1

    const strokeColor = isPositive ? "#10b981" : "#ef4444"
    const dotColor = "#f59e0b"

    return `
      <div class="relative w-full h-full sparkline-container cursor-crosshair group/spark" 
           data-points='${JSON.stringify(validData)}' 
           data-min="${min}" 
           data-range="${range}"
           data-expected-length="${expectedLength}">
        <svg width="100%" height="100%" viewBox="-2 -2 104 34" preserveAspectRatio="none" class="opacity-70 group-hover/spark:opacity-100 transition-opacity drop-shadow-md relative z-0">
          <path d="${fillPath}" fill="${strokeColor}" fill-opacity="0.6" style="-webkit-mask-image: linear-gradient(to bottom, black 0%, transparent 100%); mask-image: linear-gradient(to bottom, black 0%, transparent 100%);" stroke="none" />
          <path d="${strokePath}" fill="none" stroke="${strokeColor}" stroke-width="0.4" stroke-linecap="round" stroke-linejoin="round" />
          
          <circle cx="${getX(maxIndex)}" cy="${getY(max)}" r="1.5" fill="${dotColor}" />
          <circle cx="${getX(minIndex)}" cy="${getY(min)}" r="1.5" fill="${dotColor}" />
          <circle cx="${getX(finalIndex)}" cy="${getY(validData[finalIndex])}" r="1.5" fill="${dotColor}" />
          
          <line class="hover-line hidden pointer-events-none" y1="-2" y2="34" stroke="rgba(255,255,255,0.4)" stroke-width="0.5" />
          <circle class="hover-dot hidden pointer-events-none" r="2" fill="${strokeColor}" stroke="#1e1e1e" stroke-width="1" />
        </svg>
        
        <div class="hover-tooltip hidden absolute bg-terminal-dark border border-white/20 text-white text-[9px] font-mono px-2 py-1 rounded shadow-xl pointer-events-none z-10 transition-all duration-75 whitespace-nowrap flex flex-col items-center" 
             style="transform: translateX(-50%) translateY(-100%); margin-top: -6px;">
        </div>
      </div>
    `
  }

  const calculateChange = (current, past) => {
    if (!past || past === 0 || !current)
      return { val: 0, text: "-", isPositive: null, pastPrice: null }
    const change = ((current - past) / past) * 100
    const isPositive = change >= 0
    const displayText =
      Math.abs(change) > 9999
        ? isPositive
          ? ">9999%"
          : "<-9999%"
        : `${isPositive ? "+" : ""}${change.toFixed(2)}%`
    return {
      val: Math.min(Math.max(change, -9999), 9999),
      text: displayText,
      isPositive,
      pastPrice: past,
    }
  }

  const getBadgeHTML = (changeObj, isLarge = false) => {
    if (changeObj.isPositive === null)
      return '<span class="text-terminal-muted/50 font-mono text-xs">-</span>'
    const colorClass = changeObj.isPositive
      ? "text-emerald-500 bg-emerald-500/10 border-emerald-500/20"
      : "text-red-500 bg-red-500/10 border-red-500/20"

    const containerClass = isLarge
      ? `text-[11px] font-bold font-mono px-1.5 py-[2px] rounded border ${colorClass} inline-flex items-center whitespace-nowrap shrink-0 leading-none`
      : `text-[10px] lg:text-[11px] font-bold font-mono px-0.5 py-[1px] lg:px-1 lg:py-[2px] rounded-sm lg:rounded border ${colorClass} inline-flex items-center whitespace-nowrap shrink-0 leading-none`

    return `
        <span class="${containerClass}">
          ${changeObj.text}
        </span>
    `
  }

  const getCardColumnHTML = (title, changeObj, sparklineData, expectedLength) => {
    const isLarge = !sparklineData
    const badgeHTML = getBadgeHTML(changeObj, isLarge)

    if (isLarge) {
      return `
        <div class="flex flex-col justify-center items-center lg:flex-row lg:justify-center lg:items-center bg-terminal-bg/50 lg:bg-transparent p-4 rounded-xl lg:p-0 lg:rounded-none border border-white/[0.02] lg:border-none w-full">
          <p class="text-xs font-mono text-terminal-muted mb-3 uppercase lg:hidden font-semibold text-center w-full">${title}</p>
          <div class="flex justify-center lg:justify-center w-full">
            ${badgeHTML}
          </div>
        </div>
      `
    }

    const graphHTML = `<div class="h-8 lg:h-10 w-full flex items-center">${createSparklineSVG(sparklineData, changeObj.isPositive, expectedLength)}</div>`

    return `
      <div class="flex flex-col justify-between lg:flex-row lg:items-center bg-terminal-bg/50 lg:bg-transparent p-3 rounded-xl lg:p-0 lg:rounded-none border border-white/[0.02] lg:border-none w-full h-full lg:h-auto">
        <div class="flex justify-between items-center mb-2 w-full lg:hidden">
          <p class="text-[10px] font-mono text-terminal-muted uppercase font-semibold">${title}</p>
        </div>
        <div class="w-full lg:hidden flex-grow flex flex-col justify-end">
          ${graphHTML}
        </div>
        <div class="hidden lg:flex flex-row items-center justify-between gap-3 w-full lg:px-4">
          ${graphHTML}
        </div>
      </div>
    `
  }

  const getTextColumnHTML = (title, changeObj) => {
    let textHTML = ""
    if (changeObj.isPositive === null) {
      textHTML = '<span class="text-white/30 font-sans text-[13px] font-medium">-</span>'
    } else {
      const colorClass = changeObj.isPositive ? "text-emerald-500" : "text-red-500"
      textHTML = `
        <span class="text-[13px] font-medium font-sans inline-flex items-center whitespace-nowrap shrink-0 leading-none ${colorClass}">
          ${changeObj.text}
        </span>
      `
    }
    
    return `
        <div class="flex flex-col justify-center items-center lg:flex-row lg:justify-end lg:items-center bg-terminal-bg/50 lg:bg-transparent p-4 rounded-xl lg:p-0 lg:rounded-none border border-white/[0.02] lg:border-none w-full lg:pr-4">
          <p class="text-xs font-mono text-terminal-muted mb-3 uppercase lg:hidden font-semibold text-center w-full">${title}</p>
          <div class="flex justify-center lg:justify-end w-full">
            ${textHTML}
          </div>
        </div>
    `
  }

  const getSupplyColumnHTML = (title, supply) => {
    const text = supply !== undefined ? formatNumber(supply, 0) : "-"
    const containerClass = "text-[13px] font-medium font-sans text-white/90 inline-flex items-center whitespace-nowrap shrink-0 leading-none"
    const badgeHTML = `
        <span class="${containerClass}">
          ${text}
        </span>
    `
    return `
        <div class="flex flex-col justify-center items-center lg:flex-row lg:justify-end lg:items-center bg-terminal-bg/50 lg:bg-transparent p-4 rounded-xl lg:p-0 lg:rounded-none border border-white/[0.02] lg:border-none w-full lg:pr-4">
          <p class="text-xs font-mono text-terminal-muted mb-3 uppercase lg:hidden font-semibold text-center w-full">${title}</p>
          <div class="flex justify-center lg:justify-end w-full">
            ${badgeHTML}
          </div>
        </div>
    `
  }

  const getMarketcapColumnHTML = (title, mcap) => {
    const text = mcap !== undefined ? formatNumber(mcap, 0) : "-"
    const containerClass = "text-[13px] font-medium font-sans text-white/90 inline-flex items-center whitespace-nowrap shrink-0 leading-none"
    const badgeHTML = `
        <span class="${containerClass}">
          ${mcap !== undefined ? '<img src="/img/sunflowerland/flower.jpg" class="w-3 h-3 mr-1" alt="SFL" />' : ''}
          ${text}
        </span>
    `
    return `
        <div class="flex flex-col justify-center items-center lg:flex-row lg:justify-end lg:items-center bg-terminal-bg/50 lg:bg-transparent p-4 rounded-xl lg:p-0 lg:rounded-none border border-white/[0.02] lg:border-none w-full lg:pr-4">
          <p class="text-xs font-mono text-terminal-muted mb-3 uppercase lg:hidden font-semibold text-center w-full">${title}</p>
          <div class="flex justify-center lg:justify-end w-full">
            ${badgeHTML}
          </div>
        </div>
    `
  }

  const renderDashboard = () => {
    const topVolResource = marketData.find((item) => item.category === "resources")
    const topVolPowerUp = marketData.find((item) => item.category === "powerups")
    const topVolCosmetic = marketData.find((item) => item.category === "cosmetics")

    const renderDashItem = (item, subtitle) => {
      if (!item) return ""
      let basePath = "/img/sunflowerland/"
      let isCollectible = false
      if (item.category === "powerups") {
        basePath += "powerups/" + (item.isWearable ? "wearables/" : "")
      } else if (item.category === "cosmetics") {
        basePath += "cosmetics/" + (item.isWearable ? "wearables/" : "collectibles/")
        if (!item.isWearable) isCollectible = true
      }
      let filename = item.image || item.name + ".png"
      if (isCollectible) {
        filename = filename.replace(/\.png$/i, ".webp")
      }
      const imgSrc = encodeURI(basePath + filename)
      const imgSize = item.category !== "resources" ? "w-[85%] h-[85%]" : "w-[60%] h-[60%]"
      return `
        <div class="flex items-center gap-2 cursor-pointer hover:opacity-80 transition-opacity" onclick="window.scrollToItem('${item.name}', event)" title="${item.name}">
          <div class="w-8 h-8 lg:w-9 lg:h-9 rounded bg-terminal-dark border border-terminal-muted/20 flex items-center justify-center p-1 shrink-0">
            <img src="${imgSrc}" class="${imgSize} object-contain drop-shadow-sm" onerror="this.style.display='none'" />
          </div>
          <div class="flex flex-col min-w-0">
            <span class="text-white font-bold text-xs lg:text-sm leading-tight truncate">${item.name}</span>
            <span class="text-[10px] text-emerald-400 font-mono">${subtitle}</span>
          </div>
        </div>
      `
    }

    document.getElementById("dashTopVolume").innerHTML = `
      <div class="flex flex-col h-full justify-center gap-1.5 lg:gap-2">
        ${renderDashItem(topVolResource, topVolResource ? formatNumber(topVolResource.volume, 0) + tVol : "")}
        ${topVolPowerUp ? '<div class="w-full border-t border-white/5 my-0.5"></div>' : ""}
        ${renderDashItem(topVolPowerUp, topVolPowerUp ? formatNumber(topVolPowerUp.volume, 0) + tVol : "")}
        ${topVolCosmetic ? '<div class="w-full border-t border-white/5 my-0.5"></div>' : ""}
        ${renderDashItem(topVolCosmetic, topVolCosmetic ? formatNumber(topVolCosmetic.volume, 0) + tVol : "")}
      </div>
    `

    const getTopGainer = (periodKey, categoryFilter) => {
      const sorted = [...marketData]
        .filter((i) => i.category === categoryFilter)
        .map((item) => {
          const change = calculateChange(item.currentPrice, item.history[periodKey])
          return { ...item, changeObj: change }
        })
        .sort((a, b) => b.changeObj.val - a.changeObj.val)
      return sorted[0]
    }

    const slidesData = [
      {
        title: tGainer24h,
        res: getTopGainer("1d", "resources"),
        pwup: getTopGainer("1d", "powerups"),
        cosm: getTopGainer("1d", "cosmetics"),
      },
      {
        title: tTopGainers,
        res: getTopGainer("7d", "resources"),
        pwup: getTopGainer("7d", "powerups"),
        cosm: getTopGainer("7d", "cosmetics"),
      },
      {
        title: tGainer30d,
        res: getTopGainer("30d", "resources"),
        pwup: getTopGainer("30d", "powerups"),
        cosm: getTopGainer("30d", "cosmetics"),
      },
      {
        title: tGainer180d,
        res: getTopGainer("180d", "resources"),
        pwup: getTopGainer("180d", "powerups"),
        cosm: getTopGainer("180d", "cosmetics"),
      },
    ]

    let carouselHTML = ""
    slidesData.forEach((slide, idx) => {
      const isFirst = idx === 0
      carouselHTML += `
        <div class="gainer-slide slide-item absolute inset-0 p-4 lg:p-5 transition-opacity duration-500 flex flex-col justify-start ${isFirst ? "opacity-100 z-10" : "opacity-0 z-0"}">
          <h3 class="text-[10px] lg:text-xs font-mono text-terminal-muted uppercase tracking-wider mb-2 lg:mb-3 flex items-center gap-2">
            <svg class="w-3.5 h-3.5 lg:w-4 lg:h-4 text-emerald-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 10l7-7m0 0l7 7m-7-7v18"/></svg>
            <span class="truncate">${slide.title}</span>
          </h3>
          <div class="h-auto flex-grow flex flex-col justify-center gap-1.5 lg:gap-2">
            ${renderDashItem(slide.res, slide.res ? `+${slide.res.changeObj.val.toFixed(2)}%` : "")}
            ${slide.pwup ? '<div class="w-full border-t border-white/5 my-0.5"></div>' : ""}
            ${renderDashItem(slide.pwup, slide.pwup ? `+${slide.pwup.changeObj.val.toFixed(2)}%` : "")}
            ${slide.cosm ? '<div class="w-full border-t border-white/5 my-0.5"></div>' : ""}
            ${renderDashItem(slide.cosm, slide.cosm ? `+${slide.cosm.changeObj.val.toFixed(2)}%` : "")}
          </div>
        </div>
      `
    })

    const carouselContainer = document.getElementById("dashTopGainerCarousel")
    carouselContainer.innerHTML = carouselHTML

    const calculateRatio = (items, type) => {
      return items
        .map((item) => {
          const history180d = item.history.sparkline180d
            ? item.history.sparkline180d.filter((v) => v !== null && v !== undefined)
            : []
          if (type === "ath") {
            const ath = Math.max(...history180d, item.currentPrice)
            const ratio = ath > 0 ? (item.currentPrice / ath) * 100 : 0
            return { ...item, ratio, refPrice: ath }
          } else {
            const atl = Math.min(...history180d, item.currentPrice)
            const ratio = item.currentPrice > 0 ? (atl / item.currentPrice) * 100 : 0
            return { ...item, ratio, refPrice: atl }
          }
        })
        .sort((a, b) => b.ratio - a.ratio)
    }

    const allAth = calculateRatio(marketData, "ath")
    const allAtl = calculateRatio(marketData, "atl")

    const extremesSlides = [
      {
        title: tNearAth,
        icon: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>',
        colorClass: "text-emerald-500",
        borderClass: "border-emerald-500/30",
        shadowClass: "shadow-[0_0_10px_rgba(16,185,129,0.15)]",
        res: allAth.filter((i) => i.category === "resources").slice(0, 4),
        pwup: allAth.filter((i) => i.category === "powerups").slice(0, 4),
        cosm: allAth.filter((i) => i.category === "cosmetics").slice(0, 4),
        tooltipSuffix: tTooltipAth,
      },
      {
        title: tNearAtl,
        icon: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"/>',
        colorClass: "text-red-500",
        borderClass: "border-red-500/30",
        shadowClass: "shadow-[0_0_10px_rgba(239,68,68,0.15)]",
        res: allAtl.filter((i) => i.category === "resources").slice(0, 4),
        pwup: allAtl.filter((i) => i.category === "powerups").slice(0, 4),
        cosm: allAtl.filter((i) => i.category === "cosmetics").slice(0, 4),
        tooltipSuffix: tTooltipAtl,
      },
    ]

    let extremesHTML = ""
    extremesSlides.forEach((slide, idx) => {
      const isFirst = idx === 0

      const renderMiniIcons = (items, isNotRes) => {
        return items
          .map((item) => {
            let basePath = "/img/sunflowerland/"
            let isCollectible = false
            if (item.category === "powerups")
              basePath += "powerups/" + (item.isWearable ? "wearables/" : "")
            else if (item.category === "cosmetics") {
              basePath += "cosmetics/" + (item.isWearable ? "wearables/" : "collectibles/")
              if (!item.isWearable) isCollectible = true
            }
            let filename = item.image || item.name + ".png"
            if (isCollectible) {
              filename = filename.replace(/\.png$/i, ".webp")
            }
            const imgSrc = encodeURI(basePath + filename)
            return `
          <div class="w-7 h-7 sm:w-8 sm:h-8 rounded bg-terminal-dark border ${slide.borderClass} flex items-center justify-center p-1 relative group cursor-pointer hover:scale-110 transition-transform ${slide.shadowClass} shrink-0" onclick="window.scrollToItem('${item.name}', event)">
            <img src="${imgSrc}" class="${isNotRes ? "w-[85%] h-[85%]" : "w-[60%] h-[60%]"} object-contain drop-shadow-sm" onerror="this.style.display='none'" />
            <div class="absolute -top-8 left-1/2 -translate-x-1/2 bg-black text-[9px] text-white px-2 py-1 rounded opacity-0 group-hover:opacity-100 transition-opacity whitespace-nowrap pointer-events-none z-10 border border-white/20">
              ${item.name} (${item.ratio.toFixed(1)}% ${slide.tooltipSuffix})
            </div>
          </div>
        `
          })
          .join("")
      }

      extremesHTML += `
        <div class="extremes-slide slide-item absolute inset-0 p-4 lg:p-5 transition-opacity duration-500 flex flex-col justify-start ${isFirst ? "opacity-100 z-10" : "opacity-0 z-0"}">
          <h3 class="text-[10px] lg:text-xs font-mono text-terminal-muted uppercase tracking-wider mb-2 lg:mb-3 flex items-center gap-2">
            <svg class="w-3.5 h-3.5 lg:w-4 lg:h-4 ${slide.colorClass} shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">${slide.icon}</svg>
            <span class="truncate">${slide.title}</span>
          </h3>
          <div class="h-auto flex-grow flex flex-col justify-center gap-1.5">
            <div class="flex gap-1.5 sm:gap-2 items-center w-full">
              ${renderMiniIcons(slide.res, false)}
            </div>
            ${slide.pwup.length > 0 ? '<div class="w-full border-t border-white/5 my-0.5"></div>' : ""}
            <div class="flex gap-1.5 sm:gap-2 items-center w-full">
              ${renderMiniIcons(slide.pwup, true)}
            </div>
            ${slide.cosm.length > 0 ? '<div class="w-full border-t border-white/5 my-0.5"></div>' : ""}
            <div class="flex gap-1.5 sm:gap-2 items-center w-full">
              ${renderMiniIcons(slide.cosm, true)}
            </div>
          </div>
        </div>
      `
    })

    const extremesContainer = document.getElementById("dashAthAtlCarousel")
    extremesContainer.innerHTML = extremesHTML

    const setupCarousel = (containerId, circleId, durationSec, abortKey) => {
      const container = document.getElementById(containerId)
      let circle = document.getElementById(circleId)
      if (!container || !circle) return

      const wrapper = container.parentElement
      const slides = container.querySelectorAll(".slide-item")
      if (slides.length <= 1) return

      if (window[abortKey]) window[abortKey].abort()
      window[abortKey] = new AbortController()
      const signal = window[abortKey].signal

      let currentIdx = 0

      const nextSlide = () => {
        slides[currentIdx].classList.remove("opacity-100", "z-10")
        slides[currentIdx].classList.add("opacity-0", "z-0")

        currentIdx = (currentIdx + 1) % slides.length

        slides[currentIdx].classList.remove("opacity-0", "z-0")
        slides[currentIdx].classList.add("opacity-100", "z-10")

        const newCircle = circle.cloneNode(true)
        circle.parentNode.replaceChild(newCircle, circle)
        circle = newCircle

        if (circleId === "extremesProgress") {
          if (currentIdx === 0) {
            circle.classList.remove("text-red-500")
            circle.classList.add("text-emerald-500")
          } else {
            circle.classList.remove("text-emerald-500")
            circle.classList.add("text-red-500")
          }
        }

        circle.style.animation = `fillCircle ${durationSec}s linear forwards`
        circle.addEventListener("animationend", nextSlide, { signal })
      }

      wrapper.addEventListener("click", nextSlide, { signal })

      circle.style.animation = `fillCircle ${durationSec}s linear forwards`
      circle.addEventListener("animationend", nextSlide, { signal })
    }

    if (window.__gainerInterval) clearInterval(window.__gainerInterval)
    if (window.__extremesInterval) clearInterval(window.__extremesInterval)

    setupCarousel("dashTopGainerCarousel", "gainerProgress", 5, "__gainerAborter")
    setupCarousel("dashAthAtlCarousel", "extremesProgress", 15, "__extremesAborter")
  }

  let currentPage = 1
  const ITEMS_PER_PAGE = 30
  let loadMoreObserver = null

  const renderTable = (filterText = "", isInitialLoad = false) => {
    const term = filterText
    const filtered = marketData.filter((item) => {
      const matchSearch =
        item.name.toLowerCase().includes(term.toLowerCase()) ||
        item.key.toLowerCase().includes(term.toLowerCase()) ||
        (item.boost && item.boost.toLowerCase().includes(term.toLowerCase()))

      let matchCategory = item.category === currentCategory

      let matchSubCategory = true
      if (item.category === "powerups" || item.category === "cosmetics") {
        const itemType = item.isWearable ? "wearables" : "collectibles"
        if (!currentSubCategories.includes(itemType)) {
          matchSubCategory = false
        }
      }

      if (term !== "") {
        return matchSearch
      }

      return matchSearch && matchCategory && matchSubCategory
    })

    let sortedFiltered = [...filtered]

    if (
      window.currentSort &&
      window.currentSort.column &&
      window.currentSort.direction !== "none"
    ) {
      const { column, direction } = window.currentSort
      sortedFiltered.sort((a, b) => {
        let valA, valB
        if (column === "name") {
          valA = a.name.toLowerCase()
          valB = b.name.toLowerCase()
        } else if (column === "price") {
          valA = a.currentPrice
          valB = b.currentPrice
        } else if (column === "supply") {
          valA = a.supply !== undefined ? a.supply : Infinity
          valB = b.supply !== undefined ? b.supply : Infinity
        } else if (column === "trades24h") {
          valA = a.trades24h || 0
          valB = b.trades24h || 0
        } else if (column === "marketcap") {
          valA = (a.supply || 0) * a.currentPrice
          valB = (b.supply || 0) * b.currentPrice
        } else {
          const changeA = calculateChange(a.currentPrice, a.history[column])
          const changeB = calculateChange(b.currentPrice, b.history[column])
          valA = (changeA.sign === "-" ? -1 : 1) * changeA.val
          valB = (changeB.sign === "-" ? -1 : 1) * changeB.val
        }

        if (valA < valB) return direction === "asc" ? -1 : 1
        if (valA > valB) return direction === "asc" ? 1 : -1
        return 0
      })
    }

    if (
      term !== "" &&
      (!window.currentSort || !window.currentSort.column || window.currentSort.direction === "none")
    ) {
      sortedFiltered.sort((a, b) => {
        const aIsCurrent = a.category === currentCategory ? 1 : 0
        const bIsCurrent = b.category === currentCategory ? 1 : 0
        return bIsCurrent - aIsCurrent
      })
    }

    window.__currentFilteredData = sortedFiltered

    if (isInitialLoad) {
      const savedPage = parseInt(sessionStorage.getItem("sfl_market_page")) || 1
      for (let i = 1; i <= savedPage; i++) {
        currentPage = i
        renderPage(i)
      }
    } else {
      currentPage = 1
      sessionStorage.setItem("sfl_market_page", 1)
      renderPage(1)
    }
  }

  const renderPage = (page) => {
    if (page === 1) tableBody.innerHTML = ""

    const start = (page - 1) * ITEMS_PER_PAGE
    const end = start + ITEMS_PER_PAGE
    const items = window.__currentFilteredData.slice(start, end)

    if (items.length === 0 && page === 1) {
      tableBody.innerHTML = `<div class="py-8 text-center text-terminal-muted text-sm">${tEmptySearch}</div>`
      return
    }

    if (items.length === 0) return

    const fragment = document.createDocumentFragment()

    items.forEach((item) => {
      const isResources = item.category === "resources"
      const row = document.createElement("div")
      row.className =
        `hover:bg-white/[0.02] transition-colors group flex flex-col justify-between border border-white/5 bg-white/[0.02] rounded-[20px] p-3 lg:p-0 lg:border-0 lg:border-b lg:border-white/5 last:lg:border-b-0 lg:bg-transparent lg:rounded-none lg:grid ${isResources ? 'lg:grid-cols-[25%_15%_17%_17%_26%]' : 'lg:grid-cols-[20%_10%_12%_13%_10%_12%_23%]'} lg:items-center lg:py-3`
      row.setAttribute("data-row-id", item.name)

      // Calculate trend colors for mobile dots
      const getTrendColor = (historyKey) => {
        if (item.currentPrice === 0) return "bg-terminal-muted/30"
        const change = calculateChange(item.currentPrice, item.history[historyKey])
        if (change.val === 0) return "bg-terminal-muted/30"
        return change.isPositive ? "bg-emerald-500" : "bg-red-500"
      }
      const color24h = getTrendColor("1d")
      const color7d = getTrendColor("7d")
      const color30d = getTrendColor("30d")
      const color180d = getTrendColor("180d")

      row.innerHTML = `
        <!-- Card Header (Móvil) / Columna 1 (Desktop) -->
        <div class="py-2 lg:py-0 lg:px-4 font-medium text-white flex items-center justify-between lg:justify-start lg:h-full cursor-pointer lg:cursor-default mobile-row-toggle">
          <div class="flex items-center gap-4 lg:gap-3">
            <div class="w-12 h-12 lg:w-8 lg:h-8 rounded-lg lg:rounded bg-terminal-dark border border-terminal-muted/20 flex items-center justify-center p-2 lg:p-1 shrink-0">
              <img src="${encodeURI("/img/sunflowerland/" + (item.category === "resources" ? item.name + ".png" : item.category === "cosmetics" ? "cosmetics/" + (item.isWearable ? "wearables/" + (item.image || item.name + ".png") : "collectibles/" + (item.image ? item.image.replace(/\.png$/i, ".webp") : item.name + ".webp")) : "powerups/" + (item.isWearable ? "wearables/" : "") + (item.image || item.name + ".png")))}" alt="${item.name}" class="${item.category !== "resources" ? "w-[85%] h-[85%]" : "w-[60%] h-[60%]"} object-contain drop-shadow-sm" onerror="this.onerror=null; this.parentElement.innerHTML='📦';" />
            </div>
            <div>
              <div class="flex items-center gap-2 flex-wrap">
                <p class="text-base lg:text-sm font-semibold text-white group-hover:text-emerald-400 transition-colors">${item.name}</p>
                ${
                  item.category !== currentCategory && searchInput && searchInput.value !== ""
                    ? `<span class="px-1 py-[1px] rounded-[3px] text-[8px] uppercase tracking-wider font-semibold ${
                        item.category === "powerups"
                          ? "bg-amber-500/10 text-amber-500/80 border border-amber-500/20"
                          : item.category === "cosmetics"
                            ? "bg-purple-500/10 text-purple-400/80 border border-purple-500/20"
                            : "bg-emerald-500/10 text-emerald-500/80 border border-emerald-500/20"
                      }">${item.category === "powerups" ? "Power Up" : item.category === "cosmetics" ? "Cosmetic" : "Resource"}</span>`
                    : ""
                }
              </div>
              ${item.category === "powerups" && item.boost ? `<p class="text-[9px] text-emerald-400/80 leading-tight lg:leading-none mt-1 max-w-[180px] lg:max-w-none">${item.boost}</p>` : ""}
            </div>
          </div>
          <!-- Precio Móvil y 4 Círculos -->
          <div class="lg:hidden flex items-center justify-end gap-3">
             <!-- Indicadores de Tendencia -->
             <div class="flex items-center gap-1.5 mt-0.5">
                <div class="flex flex-col items-center gap-1.5">
                   <span class="text-[8px] font-mono text-terminal-muted/70 leading-none">24H</span>
                   <div class="w-1.5 h-1.5 rounded-full ${color24h}"></div>
                </div>
                <div class="flex flex-col items-center gap-1.5">
                   <span class="text-[8px] font-mono text-terminal-muted/70 leading-none">7D</span>
                   <div class="w-1.5 h-1.5 rounded-full ${color7d}"></div>
                </div>
                <div class="flex flex-col items-center gap-1.5">
                   <span class="text-[8px] font-mono text-terminal-muted/70 leading-none">30D</span>
                   <div class="w-1.5 h-1.5 rounded-full ${color30d}"></div>
                </div>
                <div class="flex flex-col items-center gap-1.5">
                   <span class="text-[8px] font-mono text-terminal-muted/70 leading-none">180D</span>
                   <div class="w-1.5 h-1.5 rounded-full ${color180d}"></div>
                </div>
             </div>
             <!-- Precio -->
             <div class="flex flex-col items-end justify-center border-l border-white/5 pl-2.5 min-w-[55px]">
               <span class="text-[9px] font-mono text-terminal-muted mb-1">${tColPrice}</span>
               <span class="text-sm font-bold text-white leading-none">${formatNumber(item.currentPrice, 4)}</span>
             </div>
             <!-- Expand Indicator -->
             <div class="expand-indicator lg:hidden flex items-center pl-1 transition-opacity group-[.is-expanded]:hidden">
               <svg class="w-3.5 h-3.5 text-terminal-muted/60" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                 <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
               </svg>
             </div>
          </div>
        </div>
        
        <!-- Precio Desktop -->
        <div class="hidden lg:flex lg:py-0 pr-4 items-center justify-end h-full">
          <span class="text-[13px] font-sans font-medium text-white/90">${formatNumber(item.currentPrice, 4)}</span>
        </div>
        
        <!-- Contenedor de gráficas (Oculto por defecto en móvil, Acordeón) -->
        <div class="hidden lg:contents mobile-charts-container w-full">
          ${item.currentPrice === 0 ? `
            <div class="mt-2 pt-3 border-t border-white/5 lg:border-none lg:pt-0 lg:mt-0 lg:col-span-4 lg:h-full flex items-center justify-center lg:py-2 w-full">
              <div class="w-full h-full min-h-[80px] lg:min-h-0 rounded-lg border border-dashed border-white/10 bg-white/[0.01] flex items-center justify-center">
                <span class="text-[10px] font-mono text-terminal-muted/40 uppercase tracking-widest">No Sales Data</span>
              </div>
            </div>
          ` : `
            <div class="grid grid-cols-2 gap-2 mt-2 pt-3 border-t border-white/5 lg:border-none lg:pt-0 lg:mt-0 lg:contents w-full">
              ${getTextColumnHTML(tCol24h, calculateChange(item.currentPrice, item.history["1d"]))}
              ${isResources ? '' : getMarketcapColumnHTML(tColMarketcap, (item.supply || 0) * item.currentPrice)}
              ${getSupplyColumnHTML("Vol. 24H", item.trades24h)}
              ${isResources ? '' : getSupplyColumnHTML("Circ. Supply", item.supply)}
              
              <div class="lg:hidden contents">
                ${getCardColumnHTML(tCol7d, calculateChange(item.currentPrice, item.history["7d"]), item.history.sparkline7d, 8)}
                ${getCardColumnHTML(tCol30d, calculateChange(item.currentPrice, item.history["30d"]), item.history.sparkline30d, 31)}
                ${getCardColumnHTML(tCol180d, calculateChange(item.currentPrice, item.history["180d"]), item.history.sparkline180d, 181)}
              </div>
              
              <div class="hidden lg:block w-full max-w-[250px] ml-auto h-full">
                 <div class="desktop-graph-7d w-full h-full">${getCardColumnHTML(tCol7d, calculateChange(item.currentPrice, item.history["7d"]), item.history.sparkline7d, 8)}</div>
                 <div class="desktop-graph-30d w-full h-full hidden">${getCardColumnHTML(tCol30d, calculateChange(item.currentPrice, item.history["30d"]), item.history.sparkline30d, 31)}</div>
                 <div class="desktop-graph-180d w-full h-full hidden">${getCardColumnHTML(tCol180d, calculateChange(item.currentPrice, item.history["180d"]), item.history.sparkline180d, 181)}</div>
              </div>
            </div>
          `}
        </div>
      `
      fragment.appendChild(row)
    })

    const oldTrigger = document.getElementById("loadMoreTrigger")
    if (oldTrigger) oldTrigger.remove()

    tableBody.appendChild(fragment)

    if (end < window.__currentFilteredData.length) {
      const trigger = document.createElement("div")
      trigger.id = "loadMoreTrigger"
      trigger.className = "h-4 w-full opacity-0 pointer-events-none -mt-4"
      tableBody.appendChild(trigger)

      if (!loadMoreObserver) {
        loadMoreObserver = new IntersectionObserver(
          (entries) => {
            if (entries[0].isIntersecting) {
              currentPage++
              sessionStorage.setItem("sfl_market_page", currentPage)
              renderPage(currentPage)
            }
          },
          { rootMargin: "300px" },
        )
      }

      loadMoreObserver.disconnect()
      loadMoreObserver.observe(trigger)
    }
  }

  const fetchData = async () => {
    try {
      loadingState.classList.remove("hidden")
      errorState.classList.add("hidden")
      dataContainer.classList.add("hidden")

      // Consultar el asset estático que actualiza el cron job
      const response = await fetch(`/api/sfl_data.json?t=${new Date().getTime()}`)

      if (!response.ok) {
        throw new Error(`No se pudo cargar el archivo local: ${response.status}`)
      }

      const json = await response.json()

      if (!json.items) {
        throw new Error(`El archivo de datos estáticos no contiene historial de items.`)
      }

      // Mapear el nuevo formato histórico JSON filtrando por sfl_ids.json y sfl_powerups.json
      marketData = Object.values(json.items)
        .reduce((acc, data) => {
          const parts = data.key.split("-")
          if (parts.length >= 2) {
            const type = parts[0]
            const id = parts[1]
            if (type === "collectibles" && sflIds[id]) {
              acc.push({
                ...data,
                name: sflIds[id],
                trades24h: data.trades24h,
                category: "resources",
              })
            } else if (type === "collectibles" && sflPowerUps.power_ups.collectibles[id]) {
              acc.push({
                ...data,
                name: sflPowerUps.power_ups.collectibles[id].name,
                boost: sflPowerUps.power_ups.collectibles[id].boost,
                image: sflPowerUps.power_ups.collectibles[id].image,
                supply: sflPowerUps.power_ups.collectibles[id].supply,
                trades24h: data.trades24h,
                category: "powerups",
                isWearable: false,
              })
            } else if (
              type === "collectibles" &&
              sflCosmetics.cosmetics &&
              sflCosmetics.cosmetics.collectibles &&
              sflCosmetics.cosmetics.collectibles[id]
            ) {
              acc.push({
                ...data,
                name: sflCosmetics.cosmetics.collectibles[id].name,
                boost: "",
                image: sflCosmetics.cosmetics.collectibles[id].image,
                supply: sflCosmetics.cosmetics.collectibles[id].supply,
                trades24h: data.trades24h,
                category: "cosmetics",
                isWearable: false,
              })
            } else if (
              type === "wearables" &&
              sflPowerUps.power_ups.wearables &&
              sflPowerUps.power_ups.wearables[id]
            ) {
              acc.push({
                ...data,
                name: sflPowerUps.power_ups.wearables[id].name,
                boost: sflPowerUps.power_ups.wearables[id].boost,
                image: sflPowerUps.power_ups.wearables[id].image,
                supply: sflPowerUps.power_ups.wearables[id].supply,
                trades24h: data.trades24h,
                category: "powerups",
                isWearable: true,
              })
            } else if (
              type === "wearables" &&
              sflCosmetics.cosmetics.wearables &&
              sflCosmetics.cosmetics.wearables[id]
            ) {
              acc.push({
                ...data,
                name: sflCosmetics.cosmetics.wearables[id].name,
                boost: "",
                image: sflCosmetics.cosmetics.wearables[id].image,
                supply: sflCosmetics.cosmetics.wearables[id].supply,
                trades24h: data.trades24h,
                category: "cosmetics",
                isWearable: true,
              })
            }
          }
          return acc
        }, [])
        .sort((a, b) => b.volume - a.volume)

      // Actualizar el widget de precio FLOWER con el dato inyectado desde sfl_data.json
      const priceEl = document.getElementById("sflPriceValue")
      const changeEl = document.getElementById("sflPriceChange")
      const imgEl = document.getElementById("sflTokenImg")

      if (json.flowerPrice) {
        if (priceEl) priceEl.innerText = "$" + parseFloat(json.flowerPrice).toFixed(4)
        if (changeEl) changeEl.innerText = ""
        if (imgEl) imgEl.classList.remove("animate-pulse")
      } else {
        if (priceEl) priceEl.innerText = "N/A"
        if (imgEl) imgEl.classList.remove("animate-pulse")
      }

      renderDashboard()
      renderTable(searchInput ? searchInput.value : "", true)

      const savedScroll = sessionStorage.getItem("sfl_market_scroll")
      if (savedScroll) {
        // Ocultar temporalmente para evitar el "salto visual"
        dataContainer.style.opacity = "0"
        dataContainer.classList.remove("hidden")

        setTimeout(() => {
          window.scrollTo({ top: parseInt(savedScroll), behavior: "instant" })
          sessionStorage.removeItem("sfl_market_scroll")

          // Revelar suavemente
          dataContainer.style.transition = "opacity 0.2s ease-in-out"
          dataContainer.style.opacity = "1"

          setTimeout(() => {
            dataContainer.style.transition = ""
            dataContainer.style.opacity = ""
          }, 250)
        }, 20) // Damos un margen mínimo al navegador para renderizar el alto de la página
      } else {
        dataContainer.classList.remove("hidden")
      }
    } catch (err) {
      console.error(err)
      errorMsg.innerText = err.message || "Error desconocido al consultar la API."
      errorState.classList.remove("hidden")

      const priceEl = document.getElementById("sflPriceValue")
      const imgEl = document.getElementById("sflTokenImg")
      if (priceEl) priceEl.innerText = "Error"
      if (imgEl) imgEl.classList.remove("animate-pulse")
    } finally {
      loadingState.classList.add("hidden")
    }
  }

  // Prevenir inicializaciones dobles en Astro
  const init = () => {
    // Evitar que el navegador salte al fondo durante las recargas asíncronas
    if ("scrollRestoration" in history) {
      history.scrollRestoration = "manual"
    }

    // Si ya inicializamos, salimos
    if (window.__sflMarketInitialized) return
    window.__sflMarketInitialized = true

    // Guardar la posición de scroll exacta antes de recargar/salir
    window.addEventListener("beforeunload", () => {
      sessionStorage.setItem("sfl_market_scroll", window.scrollY)
    })

    if (fetchBtn) {
      fetchBtn.addEventListener("click", () => {
        sessionStorage.setItem("sfl_market_scroll", window.scrollY)
        fetchData()
      })
    }

    // Acordeón para dispositivos móviles
    if (tableBody) {
      tableBody.addEventListener("click", (e) => {
        // Ignorar si estamos en escritorio (Tailwind lg: >= 1024px)
        if (window.innerWidth >= 1024) return

        const rowToggle = e.target.closest(".mobile-row-toggle")
        if (!rowToggle) return
        
        // Encontrar la fila actual
        const row = rowToggle.closest("[data-row-id]")
        if (!row) return

        // Alternar la visibilidad de la fila clickeada
        const chartsContainer = row.querySelector(".mobile-charts-container")
        if (chartsContainer) {
          chartsContainer.classList.toggle("hidden")
          row.classList.toggle("is-expanded")
        }
      })
    }

    if (searchInput) {
      let debounceTimeout
      searchInput.addEventListener("input", (e) => {
        const val = e.target.value

        clearTimeout(debounceTimeout)
        debounceTimeout = setTimeout(() => {
          renderTable(val)
        }, 150)

        if (searchIcon && clearSearchBtn) {
          if (val.length > 0) {
            searchIcon.classList.add("hidden")
            clearSearchBtn.classList.remove("hidden")
          } else {
            searchIcon.classList.remove("hidden")
            clearSearchBtn.classList.add("hidden")
          }
        }
      })
    }

    if (clearSearchBtn) {
      clearSearchBtn.addEventListener("click", () => {
        if (searchInput) {
          searchInput.value = ""
          renderTable("")
          searchInput.focus()

          if (searchIcon) searchIcon.classList.remove("hidden")
          clearSearchBtn.classList.add("hidden")
        }
      })
    }

    // Primer fetch automático
    fetchData()

    if (window.currentSort && window.currentSort.column) {
      const activeIcons = document.querySelectorAll(`.sort-icon[data-col="${window.currentSort.column}"]`)
      activeIcons.forEach((activeIcon) => {
        activeIcon.innerHTML = window.currentSort.direction === "desc" ? "↓" : "↑"
        activeIcon.classList.remove("hidden")
        activeIcon.classList.add("text-emerald-400")
      })
    }

    let activeSparkline = null

    const hideSparklineElements = (container) => {
      if (!container) return
      const line = container.querySelector(".hover-line")
      const dot = container.querySelector(".hover-dot")
      const tooltip = container.querySelector(".hover-tooltip")
      if (line) line.classList.add("hidden")
      if (dot) dot.classList.add("hidden")
      if (tooltip) tooltip.classList.add("hidden")
    }

    // Lógica para interactividad de las gráficas
    tableBody.addEventListener("mousemove", (e) => {
      const container = e.target.closest(".sparkline-container")

      if (container !== activeSparkline) {
        if (activeSparkline) hideSparklineElements(activeSparkline)
        activeSparkline = container
      }

      if (!container) return

      const rect = container.getBoundingClientRect()
      const xPos = e.clientX - rect.left
      const width = rect.width

      const dataPoints = JSON.parse(container.dataset.points)
      const numPoints = dataPoints.length
      const expectedLength = parseInt(container.dataset.expectedLength) || numPoints
      
      const daysAgoHovered = Math.round((1 - (xPos / width)) * Math.max(1, expectedLength - 1))
      let index = numPoints - 1 - daysAgoHovered

      const line = container.querySelector(".hover-line")
      const dot = container.querySelector(".hover-dot")
      const tooltip = container.querySelector(".hover-tooltip")

      if (index < 0 || index >= numPoints) {
        if (line) line.classList.add("hidden")
        if (dot) dot.classList.add("hidden")
        if (tooltip) tooltip.classList.add("hidden")
        return
      }

      const val = dataPoints[index]
      const min = parseFloat(container.dataset.min)
      const range = parseFloat(container.dataset.range)

      const svgWidth = 100
      const svgHeight = 30
      
      const daysAgo = numPoints - 1 - index
      const xProgress = 1 - (daysAgo / Math.max(1, expectedLength - 1))
      const mappedX = xProgress * svgWidth
      const mappedY = svgHeight - ((val - min) / range) * svgHeight

      if (line && dot && tooltip) {
        line.classList.remove("hidden")
        line.setAttribute("x1", mappedX)
        line.setAttribute("x2", mappedX)

        dot.classList.remove("hidden")
        dot.setAttribute("cx", mappedX)
        dot.setAttribute("cy", mappedY)

        tooltip.classList.remove("hidden")
        
        const finalPrice = dataPoints[numPoints - 1]
        let tooltipHTML = `<div class="leading-none">${formatNumber(val, 4)}`
        if (finalPrice && val > 0) {
          const pct = ((finalPrice - val) / val) * 100
          if (Math.abs(pct) > 0) {
            const sign = pct > 0 ? "+" : ""
            const colorClass = pct > 0 ? "text-emerald-400" : "text-red-400"
            tooltipHTML += ` <span class="${colorClass} text-[7.5px] tracking-tight opacity-90">${sign}${pct.toFixed(2)}%</span>`
          }
        }
        tooltipHTML += `</div>`

        const daysAgo = numPoints - 1 - index
        const d = new Date()
        d.setDate(d.getDate() - daysAgo)
        const isEn = window.location.pathname.includes('/en/')
        const dateStr = d.toLocaleDateString(isEn ? 'en-US' : 'es-ES', { year: 'numeric', month: 'short', day: 'numeric' })

        tooltip.innerHTML = `<div class="text-[7.5px] font-sans text-white/50 leading-none pb-1">${dateStr}</div>${tooltipHTML}`

        tooltip.style.left = `${(mappedX / svgWidth) * 100}%`
        tooltip.style.top = `${(mappedY / svgHeight) * 100}%`
      }
    })

    tableBody.addEventListener("mouseleave", () => {
      if (activeSparkline) {
        hideSparklineElements(activeSparkline)
        activeSparkline = null
      }
    })
  }

  // Manejar el ciclo de vida de Astro ViewTransitions
  document.addEventListener("astro:page-load", () => {
    window.__sflMarketInitialized = false // Reset en navegacion
    init()
  })

  // Por si ViewTransitions no está activo
  if (document.readyState === "complete" || document.readyState === "interactive") {
    setTimeout(init, 1)
  } else {
    document.addEventListener("DOMContentLoaded", init)
  }

  // Mejora 11 — Pausar carruseles cuando el usuario cambia de pestaña.
  // Los navegadores acumulan eventos 'animationend' en segundo plano y los
  // disparan todos de golpe al volver, haciendo girar el carrusel como loco.
  // Guardia para evitar duplicar el listener si Astro ViewTransitions recarga la página
  if (!window.__sflVisibilityListenerRegistered) {
    window.__sflVisibilityListenerRegistered = true
    document.addEventListener("visibilitychange", () => {
      const isHidden = document.visibilityState === "hidden"
      if (isHidden) {
        if (window.__gainerAborter) window.__gainerAborter.abort()
        if (window.__extremesAborter) window.__extremesAborter.abort()
      } else {
        if (marketData.length > 0) renderDashboard()
      }
    })
  }

  // Lógica para indicadores visuales de scroll
  const initScrollHints = () => {
    const wrappers = document.querySelectorAll(".scroll-hint-wrapper")
    wrappers.forEach((wrapper) => {
      const area = wrapper.querySelector(".scroll-area")
      const hint = wrapper.querySelector(".scroll-hint")
      if (!area || !hint) return

      let interacted = false

      const checkScroll = () => {
        if (interacted) return
        // Mostrar solo si hay overflow
        if (area.scrollWidth > area.clientWidth + 5) {
          hint.classList.remove("opacity-0")
          hint.classList.add("opacity-100")
        } else {
          hint.classList.add("opacity-0")
          hint.classList.remove("opacity-100")
        }
      }

      area.addEventListener("scroll", () => {
        if (area.scrollLeft > 5) {
          interacted = true
          hint.classList.add("opacity-0")
          hint.classList.remove("opacity-100")
        } else if (!interacted) {
          hint.classList.remove("opacity-0")
          hint.classList.add("opacity-100")
        }
      })

      // Chequear al montar
      setTimeout(checkScroll, 300)
      window.addEventListener("resize", checkScroll)
    })
  }

  document.addEventListener("astro:page-load", initScrollHints)
  if (document.readyState === "complete" || document.readyState === "interactive") {
    setTimeout(initScrollHints, 1)
  } else {
    document.addEventListener("DOMContentLoaded", initScrollHints)
  }
</script>
