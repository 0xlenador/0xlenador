              <!-- Contadores de Recompensas -->
              <div class="grid grid-cols-3 gap-1 pt-0.5 border-t border-white/5">
                <!-- Escarabajos -->
                <div class="flex flex-col items-center justify-center bg-black/40 p-1 rounded-lg border border-white/5 text-center">
                  <img
                    src="/img/sunflowerland/green_beetle.webp"
                    alt="Beetle"
                    class="w-3.5 h-3.5 object-contain mb-0.5 [image-rendering:pixelated]"
                  />
                  <span class="text-[8px] font-mono text-terminal-muted">Beetles</span>
                  <span class="text-[9.5px] font-mono font-bold text-amber-400 leading-tight">
                    <span id="caveBeetlesCount">0</span>/<span id="caveBeetlesGoal">2</span>
                  </span>
                </div>

                <!-- Hongos -->
                <div class="flex flex-col items-center justify-center bg-black/40 p-1 rounded-lg border border-white/5 text-center">
                  <img
                    src="/img/sunflowerland/123/wild_mushroom.webp"
                    alt="Mushroom"
                    class="w-3.5 h-3.5 object-contain mb-0.5 [image-rendering:pixelated]"
                  />
                  <span class="text-[8px] font-mono text-terminal-muted">Mushrooms</span>
                  <span class="text-[9.5px] font-mono font-bold text-red-400 leading-tight">
                    <span id="caveMushroomsCount">0</span>/<span id="caveMushroomsGoal">6</span>
                  </span>
                </div>

                <!-- Mud -->
                <div class="flex flex-col items-center justify-center bg-black/40 p-1 rounded-lg border border-white/5 text-center">
                  <img
                    src="/img/sunflowerland/123/mud.webp"
                    alt="Mud"
                    class="w-3.5 h-3.5 object-contain mb-0.5 [image-rendering:pixelated]"
                  />
                  <span class="text-[8px] font-mono text-terminal-muted">Mud</span>
                  <span class="text-[9.5px] font-mono font-bold text-amber-600 leading-tight">
                    <span id="caveMudCount">0</span>/<span id="caveMudGoal">17</span>
                  </span>
                </div>
              </div>
            </div>

            <!-- Cuadrícula 5x5 de Excavación con Estilo Oficial de Parche Subterráneo SFL -->
            <div
              class="relative rounded-2xl bg-[#5c3a23]/30 border-2 border-dashed border-[#8a5d3b]/50 p-2.5 shadow-inner flex flex-col items-center justify-center select-none"
            >
              <div id="caveDigGrid" class="grid grid-cols-5 gap-1.5 w-full max-w-[195px]">
                {Array.from({ length: 25 }).map((_, idx) => (
                  <button
                    type="button"
                    class="cave-cell cursor-shovel relative aspect-square rounded-full bg-[#dfbe99] hover:bg-[#ebd1b0] border border-[#c49c71] shadow-[inset_0_-2px_3px_rgba(0,0,0,0.25)] active:scale-95 transition-all flex items-center justify-center p-0.5 group select-none"
                    data-cell-index={idx}
                  >
                    <!-- Textura de montículo arenoso inicial con Indicador de Probabilidad Solver -->
                    <div class="cell-mound w-full h-full flex flex-col items-center justify-center relative">
                      <div class="cell-mound-dot w-2 h-2 rounded-full bg-[#cfa47c]/60 group-hover:scale-110 transition-transform shadow-inner" />
                      <!-- Porcentaje calculado del Solver -->
                      <span class="cell-prob-badge hidden absolute inset-0 flex items-center justify-center font-mono font-black text-[10px] sm:text-[10.5px] leading-none pointer-events-none select-none text-stone-950 tracking-tight">
                        --%
                      </span>
                    </div>

                    <!-- Contenedor descubierto (Hoyo excavado) -->
                    <div class="cell-revealed hidden w-full h-full flex flex-col items-center justify-center animate-fade-in relative">
                      <!-- Imagen del item (Escarabajo, Hongo o Mud) -->
                      <img
                        src=""
                        alt=""
                        class="cell-revealed-img w-3.5 h-3.5 object-contain [image-rendering:pixelated] drop-shadow-sm select-none pointer-events-none"
                      />

                      <!-- Checkmark oficial para Escarabajos en la orilla exterior del círculo -->
                      <span class="cell-beetle-check hidden absolute -top-1 -right-1 w-3 h-3 rounded-full bg-emerald-500 border border-emerald-300 text-white flex items-center justify-center text-[7.5px] font-black shadow-sm z-20">
                        ✓
                      </span>

                      <!-- Número de pista (para Hongos y Mud: 0 a 4; oculto en Escarabajos) -->
                      <span class="cell-clue-number hidden relative z-10 font-mono font-black text-[11px] sm:text-xs leading-none drop-shadow-[0_1.5px_2px_rgba(0,0,0,1)] text-white mt-0.5 select-none pointer-events-none">
                        0
                      </span>
                    </div>
                  </button>
                ))}
              </div>

              <!-- Píldoras oficiales de estado del parche con Alto Contraste -->
              <div class="flex flex-col gap-1.5 w-full max-w-[195px] mt-2.5 select-none">
                <div class="w-full py-1 px-2 rounded-full bg-emerald-500 border border-emerald-300 text-stone-950 text-[10px] font-mono font-black text-center shadow-md">
                  {t("sfl.constants.cave.readyToDig")}
                </div>

                <div
                  id="caveBeetlesStatusPill"
                  class="w-full py-1 px-2 rounded-full bg-black/80 border border-white/20 text-white text-[9.5px] font-mono font-bold text-center flex items-center justify-center gap-1.5 shadow-sm transition-all"
                >
                  <img src="/img/sunflowerland/green_beetle.webp" class="w-3.5 h-3.5 object-contain shrink-0" alt="" />
                  <span id="caveBeetlesStatusText">{t("sfl.constants.cave.beetlesFound")}: 0/2</span>
                </div>

                <div
                  id="caveMushroomsStatusPill"
                  class="w-full py-1 px-2 rounded-full bg-black/80 border border-white/20 text-white text-[9.5px] font-mono font-bold text-center flex items-center justify-center gap-1.5 shadow-sm transition-all"
                >
                  <img src="/img/sunflowerland/123/wild_mushroom.webp" class="w-3.5 h-3.5 object-contain shrink-0" alt="" />
                  <span id="caveMushroomsStatusText">{t("sfl.constants.cave.mushroomsFound")}: 0/6</span>
                </div>
              </div>

              <!-- Botones de Acción del Tablero con Alto Contraste -->
              <div class="flex items-center gap-1.5 mt-2.5 w-full max-w-[195px]">
                <button
                  type="button"
                  id="caveDigAllBtn"
                  class="flex-1 py-1.5 px-2 rounded-xl text-[10.5px] font-mono font-black bg-gradient-to-r from-amber-400 to-amber-500 hover:from-amber-300 hover:to-amber-400 text-stone-950 border border-amber-300 transition-all cursor-pointer flex items-center justify-center gap-1.5 shadow-md active:scale-98"
                >
                  <img
                    src="/img/sunflowerland/tools/sand_shovel.png"
                    class="w-4 h-4 object-contain shrink-0 [image-rendering:pixelated] drop-shadow-sm"
                    alt="Sand Shovel"
                  />
                  <span>{t("sfl.constants.cave.digAll")}</span>
                </button>
                <button
                  type="button"
                  id="caveResetBtn"
                  class="py-1.5 px-2 rounded-xl text-xs font-mono font-bold text-white bg-white/10 hover:bg-white/20 border border-white/25 transition-all cursor-pointer flex items-center justify-center shadow-sm active:scale-95"
                  title={t("sfl.constants.cave.reset")}
                >
                  <span>🔄</span>
                </button>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</SflToolLayout>

<script is:inline define:vars={{ bettyPrices, sflIds, caveData, sflSkills, tFree: t("sfl.constants.detail.free"), tAllBeetlesFound: t("sfl.constants.cave.allBeetlesFound"), tAllMushroomsFound: t("sfl.constants.cave.allMushroomsFound"), tBeetlesFound: t("sfl.constants.cave.beetlesFound"), tMushroomsFound: t("sfl.constants.cave.mushroomsFound") }}>
  ;(function () {
    // -------------------------------------------------------------
    // Gestión de Boosts & Buffs (PowerUps, Skills, Others)
    // -------------------------------------------------------------
    window.setViewStyle = function (style) {
      const container = document.getElementById("boosts-container")
      if (!container) return
      if (style === "compact") {
        container.classList.add("is-compact")
      } else {
        container.classList.remove("is-compact")
      }

      document.querySelectorAll(".view-switch-btn").forEach((b) => b.classList.remove("active"))
      document.querySelectorAll('.view-switch-btn[data-action="' + style + '"]').forEach((btn) => btn.classList.add("active"))
    }

    const activeSkills = {}
    const activeBuffs = new Set()
    let caveManager = null

    function triggerCaveUpdate() {
      if (caveManager && typeof caveManager.update === "function") {
        caveManager.update()
        if (typeof caveManager.checkBuffsBoardSync === "function") {
          caveManager.checkBuffsBoardSync()
        }
      }
    }

    function getBuffsModifiers() {
      // 1. Lean Compost: reduce ingredientes del compost en Myco Bin
      // R1: x0.95 (-5%), R2: x0.90 (-10%), R3: x0.85 (-15%)
      const leanCompostRank = activeSkills["Lean Compost"] || 0
      let leanCompostMultiplier = 1.0
      if (leanCompostRank === 1) leanCompostMultiplier = 0.95
      else if (leanCompostRank === 2) leanCompostMultiplier = 0.90
      else if (leanCompostRank === 3) leanCompostMultiplier = 0.85

      // 2. Sturdy Shovel: probabilidad de no gastar pala => descuento directo al costo de Sand Shovel
      // R1: 10% (-10%), R2: 20% (-20%), R3: 30% (-30%)
      const sturdyShovelRank = activeSkills["Sturdy Shovel"] || 0
      let sturdyShovelDiscount = 0
      if (sturdyShovelRank === 1) sturdyShovelDiscount = 0.10
      else if (sturdyShovelRank === 2) sturdyShovelDiscount = 0.20
      else if (sturdyShovelRank === 3) sturdyShovelDiscount = 0.30

      // 3. Beetle Nest: +1, +2, +3 baldosas de escarabajos por lote
      const beetleNestRank = activeSkills["Beetle Nest"] || 0
      let beetleNestBonus = 0
      if (beetleNestRank === 1) beetleNestBonus = 1
      else if (beetleNestRank === 2) beetleNestBonus = 2
      else if (beetleNestRank === 3) beetleNestBonus = 3

      // 4. Twin Beetles: 5%, 10%, 15% chance de escarabajo extra al excavar
      const twinBeetlesRank = activeSkills["Twin Beetles"] || 0
      let twinBeetlesMultiplier = 1.0
      if (twinBeetlesRank === 1) twinBeetlesMultiplier = 1.05
      else if (twinBeetlesRank === 2) twinBeetlesMultiplier = 1.10
      else if (twinBeetlesRank === 3) twinBeetlesMultiplier = 1.15

      // 5. Mushroom Bloom: +1, +2, +3 baldosas de hongo por lote
      const mushroomBloomRank = activeSkills["Mushroom Bloom"] || 0
      let mushroomBloomBonus = 0
      if (mushroomBloomRank === 1) mushroomBloomBonus = 1
      else if (mushroomBloomRank === 2) mushroomBloomBonus = 2
      else if (mushroomBloomRank === 3) mushroomBloomBonus = 3

      // 6. Fungal Harvest: +0.2, +0.3, +0.4 Mushrooms por casilla de hongo excavada
      const fungalHarvestRank = activeSkills["Fungal Harvest"] || 0
      let fungalHarvestBonus = 0
      if (fungalHarvestRank === 1) fungalHarvestBonus = 0.2
      else if (fungalHarvestRank === 2) fungalHarvestBonus = 0.3
      else if (fungalHarvestRank === 3) fungalHarvestBonus = 0.4

      // 7. PowerUps & Others (Yield de Mushrooms por baldosa)
      // Mushroom Hat (+0.1), Mushroom House (+0.2), Fairy Circle (+0.2)
      let mushroomPowerUpBonus = 0
      if (activeBuffs.has("mushroom_hat")) mushroomPowerUpBonus += 0.1
      if (activeBuffs.has("mushroom_house")) mushroomPowerUpBonus += 0.2
      if (activeBuffs.has("fairy_circle")) mushroomPowerUpBonus += 0.2

      const totalMushroomYieldPerTile = 1 + fungalHarvestBonus + mushroomPowerUpBonus

      // 8. Muddy Bounty: +10%, +20%, +30% Mud obtenido
      const muddyBountyRank = activeSkills["Muddy Bounty"] || 0
      let muddyBountyMultiplier = 1.0
      if (muddyBountyRank === 1) muddyBountyMultiplier = 1.10
      else if (muddyBountyRank === 2) muddyBountyMultiplier = 1.20
      else if (muddyBountyRank === 3) muddyBountyMultiplier = 1.30

      // 9. Rapid Mycelium: x0.95, x0.90, x0.85 tiempo de compostaje
      const rapidMyceliumRank = activeSkills["Rapid Mycelium"] || 0
      let rapidMyceliumMultiplier = 1.0
      if (rapidMyceliumRank === 1) rapidMyceliumMultiplier = 0.95
      else if (rapidMyceliumRank === 2) rapidMyceliumMultiplier = 0.90
      else if (rapidMyceliumRank === 3) rapidMyceliumMultiplier = 0.85

      return {
        leanCompostMultiplier,
        sturdyShovelDiscount,
        beetleNestBonus,
        twinBeetlesMultiplier,
        mushroomBloomBonus,
        fungalHarvestBonus,
        mushroomPowerUpBonus,
        totalMushroomYieldPerTile,
        muddyBountyMultiplier,
        rapidMyceliumMultiplier
      }
    }

    const formatSkillDescription = (skillName, rank, originalDesc) => {
      const skill = sflSkills?.[skillName]
      if (!skill) return originalDesc

      const effectiveRank = rank === 0 ? 1 : rank
      let updatedDesc = originalDesc

      if (skill.mathematics_1 && skill.mathematics_1.calc_by_rank) {
        const m1 = skill.mathematics_1.calc_by_rank[`rank_${effectiveRank}`]
        if (m1 !== undefined) {
          updatedDesc = updatedDesc.replace("{math1}", m1)
          updatedDesc = updatedDesc.replace("{math1_pct}", parseFloat((m1 * 100).toFixed(2)))
          updatedDesc = updatedDesc.replace("{math1_days}", parseFloat((m1 / 86400000).toFixed(2)))
        }
      }

      if (skill.mathematics_2 && skill.mathematics_2.calc_by_rank) {
        const m2 = skill.mathematics_2.calc_by_rank[`rank_${effectiveRank}`]
        if (m2 !== undefined) {
          updatedDesc = updatedDesc.replace("{math2}", m2)
          updatedDesc = updatedDesc.replace("{math2_pct}", parseFloat((m2 * 100).toFixed(2)))
          updatedDesc = updatedDesc.replace("{math2_days}", parseFloat((m2 / 86400000).toFixed(2)))
        }
      }

      return updatedDesc
    }

    const updateSkillUI = (skillId) => {
      const rank = activeSkills[skillId] || 0
      const card = document.querySelector(`.skill-card[data-skill-id="${skillId}"]`)
      if (card) {
        if (rank > 0) {
          card.classList.add("border-blue-500/50", "bg-blue-500/10", "active")
          card.classList.remove("border-white/5", "bg-white/5")
        } else {
          card.classList.remove("border-blue-500/50", "bg-blue-500/10", "active")
          card.classList.add("border-white/5", "bg-white/5")
        }

        const descSpan = card.querySelector(".skill-description-text")
        if (descSpan) {
          descSpan.textContent = formatSkillDescription(skillId, rank, descSpan.dataset.original)
        }

        const checkboxes = card.querySelectorAll(".skill-rank-checkbox")
        checkboxes.forEach((cb) => {
          const cbRank = parseInt(cb.value)
          cb.checked = cbRank <= rank
        })
      }
    }

    // Buffs listeners (PowerUps y Others)
    document.querySelectorAll(".buff-card").forEach((card) => {
      const checkbox = card.querySelector(".buff-checkbox")
      if (!checkbox) return

      checkbox.addEventListener("change", () => {
        const buffId = checkbox.dataset.buffId
        const isPurple = card.classList.contains("hover:border-purple-500/30")
        if (checkbox.checked) {
          activeBuffs.add(buffId)
          card.classList.add("active")
          if (isPurple) {
            card.classList.add("border-purple-500/50", "bg-purple-500/10")
          } else {
            card.classList.add("border-emerald-500/50", "bg-emerald-500/10")
          }
          card.classList.remove("border-white/5", "bg-white/5")
        } else {
          activeBuffs.delete(buffId)
          card.classList.remove("active")
          if (isPurple) {
            card.classList.remove("border-purple-500/50", "bg-purple-500/10")
          } else {
            card.classList.remove("border-emerald-500/50", "bg-emerald-500/10")
          }
          card.classList.add("border-white/5", "bg-white/5")
        }
        triggerCaveUpdate()
      })
    })

    // Skills listeners (Card click y Rank checkboxes)
    document.querySelectorAll(".skill-card").forEach((card) => {
      card.addEventListener("click", (e) => {
        if (e.target.closest(".skill-rank-checkbox") || e.target.closest("label")) return
        const skillId = card.dataset.skillId
        const currentRank = activeSkills[skillId] || 0
        if (currentRank > 0) {
          delete activeSkills[skillId]
        } else {
          activeSkills[skillId] = 1
        }
        updateSkillUI(skillId)
        triggerCaveUpdate()
      })
    })

    document.querySelectorAll(".skill-rank-checkbox").forEach((cb) => {
      cb.addEventListener("change", (e) => {
        const skillId = e.target.dataset.skillId
        const rank = parseInt(e.target.value)
        if (e.target.checked) {
          activeSkills[skillId] = rank
        } else {
          if (rank - 1 > 0) {
            activeSkills[skillId] = rank - 1
          } else {
            delete activeSkills[skillId]
          }
        }
        updateSkillUI(skillId)
        triggerCaveUpdate()
      })
    })

    let liveFlowerPrice = 0.144
    let activeCoinsPerFlower = 320 // Paridad inicial fallback
    let marketDataCache = null

    function getBaseMaterialUnitPrice(materialName) {
      if (!marketDataCache || !marketDataCache.items || !sflIds) return 0
      const itemId = Object.keys(sflIds).find((k) => sflIds[k] === materialName)
      if (!itemId) return 0
      const item = marketDataCache.items[`collectibles-${itemId}`]
      return item && item.currentPrice ? parseFloat(item.currentPrice) : 0
    }

    function createCaveController() {
      if (!caveData || !caveData.mixes || caveData.mixes.length === 0) return null

      let activeMix = caveData.mixes[0]
      let board = []
      let discoveredBeetles = 0
      let discoveredMushrooms = 0
      let discoveredMud = 0

      // Estado para Mud Mix
      let selectedCropIndex = -1 // -1 = automático / óptimo
      let optimalCropIndex = 0

      // Estado del Modo Simulación en Vivo y Asistente Solver
      let isSimulationActive = false
      let isSolverActive = true
      let simShovelsUsed = 0
      let simDiscoveredBeetles = []
      let simMushrooms = 0
      let simMud = 0

      // Elementos DOM
      const simulateToggleBtn = document.getElementById("caveSimulateToggleBtn")
      const simulateStatusText = document.getElementById("caveSimulateStatusText")
      const mudBoostBadge = document.getElementById("caveMudBoostBadge")
      const beetlesCountDisplay = document.getElementById("caveBeetlesCount")
      const beetlesGoalDisplay = document.getElementById("caveBeetlesGoal")
      const mushroomsCountDisplay = document.getElementById("caveMushroomsCount")
      const mushroomsGoalDisplay = document.getElementById("caveMushroomsGoal")
      const mudCountDisplay = document.getElementById("caveMudCount")
      const mudGoalDisplay = document.getElementById("caveMudGoal")
      const beetlesStatusPill = document.getElementById("caveBeetlesStatusPill")
      const beetlesStatusText = document.getElementById("caveBeetlesStatusText")
      const mushroomsStatusPill = document.getElementById("caveMushroomsStatusPill")
      const mushroomsStatusText = document.getElementById("caveMushroomsStatusText")
      const digAllBtn = document.getElementById("caveDigAllBtn")
      const resetBtn = document.getElementById("caveResetBtn")
      const successBanner = document.getElementById("caveSuccessBanner")
      const mixBtns = document.querySelectorAll(".cave-mix-tab-btn")
      const cells = document.querySelectorAll(".cave-cell")

      // Elementos de economía
      const batchShovelsText = document.getElementById("caveBatchShovelsText")
      const batchShovelsFlower = document.getElementById("caveBatchShovelsFlower")
      const batchReqImg = document.getElementById("caveBatchReqImg")
      const batchReqText = document.getElementById("caveBatchReqText")
      const batchReqFlower = document.getElementById("caveBatchReqFlower")
      const cropStandardRow = document.getElementById("caveBatchReqStandardRow")
      const cropSelectContainer = document.getElementById("caveCropSelectContainer")
      const cropDropdownTrigger = document.getElementById("caveCropDropdownTrigger")
      const cropTriggerImg = document.getElementById("caveCropTriggerImg")
      const cropTriggerLabel = document.getElementById("caveCropTriggerLabel")
      const cropTriggerBadge = document.getElementById("caveCropTriggerBadge")
      const cropTriggerFlower = document.getElementById("caveCropTriggerFlower")
      const cropTriggerArrow = document.getElementById("caveCropTriggerArrow")
      const cropDropdownMenu = document.getElementById("caveCropDropdownMenu")
      const beetlesPerBatchBadge = document.getElementById("caveBeetlesPerBatchBadge")
      const totalCostFlower = document.getElementById("caveTotalCostFlower")
      const totalCostUsd = document.getElementById("caveTotalCostUsd")
      const beetleOddsRows = document.getElementById("caveBeetleOddsRows")
      const totalBeetleRevFlower = document.getElementById("caveTotalBeetleRevFlower")
      const totalBeetleRevUsd = document.getElementById("caveTotalBeetleRevUsd")
      const residualCard = document.getElementById("caveResidualCard")
      const balanceLabel = document.getElementById("caveBalanceLabel")
      const balanceBadge = document.getElementById("caveBalanceBadge")
      const balanceContainer = document.getElementById("caveBalanceContainer")
      const deficitFlower = document.getElementById("caveDeficitFlower")
      const deficitUsd = document.getElementById("caveDeficitUsd")
      const mushroomFreeBadge = document.getElementById("caveMushroomFreeBadge")
      const mudFreeBadge = document.getElementById("caveMudFreeBadge")
      const mushroomUnitFlower = document.getElementById("caveMushroomUnitFlower")
      const mushroomUnitUsd = document.getElementById("caveMushroomUnitUsd")
      const mudUnitFlower = document.getElementById("caveMudUnitFlower")
      const mudUnitUsd = document.getElementById("caveMudUnitUsd")

      function getActiveBeetleOdds(baseOdds) {
        if (!baseOdds || baseOdds.length === 0) return []
        const rareBreedsRank = activeSkills["Rare Breeds"] || 0

        let chances = null
        if (rareBreedsRank === 1) {
          // Rank 1: Green 35%, Blue 35%, Pink 15%, Amber 15%
          chances = {
            green_beetle: 0.35,
            blue_beetle: 0.35,
            pink_beetle: 0.15,
            amber_beetle: 0.15
          }
        } else if (rareBreedsRank === 2) {
          // Rank 2: Green 30%, Blue 30%, Pink 20%, Amber 20%
          chances = {
            green_beetle: 0.30,
            blue_beetle: 0.30,
            pink_beetle: 0.20,
            amber_beetle: 0.20
          }
        } else if (rareBreedsRank === 3) {
          // Rank 3: Todos 25% (Green 25%, Blue 25%, Pink 25%, Amber 25%)
          chances = {
            green_beetle: 0.25,
            blue_beetle: 0.25,
            pink_beetle: 0.25,
            amber_beetle: 0.25
          }
        }

        if (!chances) return baseOdds

        return baseOdds.map((odd) => ({
          ...odd,
          chance: chances[odd.id] !== undefined ? chances[odd.id] : odd.chance
        }))
      }

      function pickRandomBeetle(odds) {
        const rnd = Math.random()
        let acc = 0
        for (const item of odds) {
          acc += item.chance
          if (rnd <= acc) return item
        }
        return odds[0]
      }

      function getBeetleP2PPrice(sflId) {
        if (marketDataCache && marketDataCache.items) {
          const item = marketDataCache.items[`collectibles-${sflId}`]
          if (item && item.currentPrice) {
            return parseFloat(item.currentPrice)
          }
        }
        return 0
      }

      function getCropUnitFlowerPrice(crop) {
        if (marketDataCache && marketDataCache.items) {
          const item = marketDataCache.items[`collectibles-${crop.sflId}`]
          if (item && (item.currentPrice || item.price)) {
            const p = parseFloat(item.currentPrice || item.price)
            if (p > 0) return p
          }
        }
        const betty = (typeof bettyPrices !== "undefined" && bettyPrices) ? bettyPrices[crop.name] : null
        const sellPrice = betty ? betty.sellPrice : 0.02
        const coinsFlw = activeCoinsPerFlower > 0 ? 1 / activeCoinsPerFlower : 0.005
        return sellPrice * coinsFlw
      }

      function getActiveCropRequirement() {
        const modifiers = getBuffsModifiers()
        const leanMult = modifiers.leanCompostMultiplier

        const reqConfig = activeMix.requirement || { name: "Wood", amount: 10, image: "/img/sunflowerland/Wood.png" }
        if (!reqConfig.options || reqConfig.options.length === 0) {
          if (cropSelectContainer) cropSelectContainer.classList.add("hidden")
          if (cropStandardRow) cropStandardRow.classList.remove("hidden")
          if (mudBoostBadge) {
            mudBoostBadge.classList.add("hidden")
            mudBoostBadge.classList.remove("flex")
          }
          const effectiveAmount = Math.round((reqConfig.amount * leanMult) * 100) / 100
          return {
            name: reqConfig.name,
            amount: effectiveAmount,
            baseAmount: reqConfig.amount,
            image: reqConfig.image,
            unitPriceFlw: getBaseMaterialUnitPrice(reqConfig.name),
            isOptimal: false
          }
        }

        if (cropSelectContainer) cropSelectContainer.classList.remove("hidden")
        if (cropStandardRow) cropStandardRow.classList.add("hidden")
        if (mudBoostBadge) {
          mudBoostBadge.classList.remove("hidden")
          mudBoostBadge.classList.add("flex")
        }

        let lowestCost = Infinity
        optimalCropIndex = 0

        const optionsWithCost = reqConfig.options.map((opt, idx) => {
          const unitP = getCropUnitFlowerPrice(opt)
          const effectiveAmount = Math.round((opt.amount * leanMult) * 100) / 100
          const totalCost = unitP * effectiveAmount
          if (totalCost < lowestCost) {
            lowestCost = totalCost
            optimalCropIndex = idx
          }
          return {
            ...opt,
            amount: effectiveAmount,
            baseAmount: opt.amount,
            unitP,
            totalCost,
            index: idx
          }
        })

        const chosenIndex = selectedCropIndex >= 0 && selectedCropIndex < reqConfig.options.length
          ? selectedCropIndex
          : optimalCropIndex

        const chosenOpt = optionsWithCost[chosenIndex] || optionsWithCost[0]
        const isOptimal = chosenIndex === optimalCropIndex

        // Actualizar visual del botón Trigger Custom
        if (cropTriggerImg) cropTriggerImg.src = chosenOpt.image
        if (cropTriggerLabel) cropTriggerLabel.innerText = `${chosenOpt.amount}x ${chosenOpt.name}`
        if (cropTriggerFlower) cropTriggerFlower.innerText = chosenOpt.totalCost.toFixed(4)
        if (cropTriggerBadge) {
          if (isOptimal) {
            cropTriggerBadge.classList.remove("hidden")
          } else {
            cropTriggerBadge.classList.add("hidden")
          }
        }

        // Renderizar opciones estilizadas en el menú desplegable
        if (cropDropdownMenu) {
          const currentPopulatedKey = `${activeMix.id}-${activeCoinsPerFlower}-${chosenIndex}-${leanMult}`
          if (cropDropdownMenu.dataset.populatedKey !== currentPopulatedKey) {
            cropDropdownMenu.dataset.populatedKey = currentPopulatedKey
            cropDropdownMenu.innerHTML = ""

            optionsWithCost.forEach((opt) => {
              const btn = document.createElement("button")
              btn.type = "button"
              const isOpt = opt.index === optimalCropIndex
              const isSelected = opt.index === chosenIndex
              btn.className = `w-full py-1.5 px-2 rounded-lg text-left flex items-center justify-between transition-all cursor-pointer ${
                isSelected
                  ? "bg-amber-500/15 border border-amber-500/40 text-amber-200"
                  : "hover:bg-white/[0.06] border border-transparent text-white/80 hover:text-white"
              }`
              btn.innerHTML = `
                <div class="flex items-center gap-2 min-w-0">
                  <img src="${opt.image}" class="w-4 h-4 object-contain shrink-0 [image-rendering:pixelated]" alt="${opt.name}" />
                  <span class="text-[11px] font-mono font-medium truncate">${opt.amount}x ${opt.name}</span>
                  ${isOpt ? `<span class="text-[8px] px-1 py-0.2 rounded font-mono font-bold bg-emerald-500/20 text-emerald-300 border border-emerald-500/30">Óptimo</span>` : ""}
                </div>
                <div class="flex items-center gap-1 font-mono text-[10.5px] font-bold text-emerald-400 shrink-0">
                  <img src="/img/sunflowerland/flower.jpg" class="w-3 h-3 rounded-full object-cover shrink-0" alt="FLOWER" />
                  <span>${opt.totalCost.toFixed(4)}</span>
                </div>
              `
              btn.addEventListener("click", () => {
                selectedCropIndex = opt.index
                if (cropDropdownMenu) cropDropdownMenu.classList.add("hidden")
                if (cropTriggerArrow) cropTriggerArrow.classList.remove("rotate-180")
                updateEconomics()
              })
              cropDropdownMenu.appendChild(btn)
            })
          }
        }

        return {
          name: chosenOpt.name,
          amount: chosenOpt.amount,
          image: chosenOpt.image,
          unitPriceFlw: chosenOpt.unitP,
          isOptimal
        }
      }

      function getOrthogonalNeighbors(idx) {
        const row = Math.floor(idx / 5)
        const col = idx % 5
        const n = []
        if (row > 0) n.push((row - 1) * 5 + col) // Arriba (Norte)
        if (row < 4) n.push((row + 1) * 5 + col) // Abajo (Sur)
        if (col > 0) n.push(row * 5 + (col - 1)) // Izquierda (Oeste)
        if (col < 4) n.push(row * 5 + (col + 1)) // Derecha (Este)
        return n
      }

      function generateBoard() {
        discoveredBeetles = 0
        discoveredMushrooms = 0
        discoveredMud = 0

        if (successBanner) {
          successBanner.classList.add("hidden")
        }

        const modifiers = getBuffsModifiers()
        const isMudMix = activeMix.id === "mud_mix"
        const beetlesCount = (activeMix.rewards.beetles || 2) + modifiers.beetleNestBonus
        const mushroomsCount = (activeMix.rewards.mushrooms || (isMudMix ? 3 : 6)) + modifiers.mushroomBloomBonus
        const mudCellsCount = isMudMix ? 20 : Math.max(0, 25 - beetlesCount - mushroomsCount)
        const mudPerCell = isMudMix ? 2 : 1

        const effectiveOdds = getActiveBeetleOdds(activeMix.beetleOdds)
        const beetleItems = []
        for (let i = 0; i < beetlesCount; i++) {
          const beetle = pickRandomBeetle(effectiveOdds)
          beetleItems.push({
            type: "beetle",
            name: beetle.name,
            sflId: beetle.sflId,
            image: beetle.image,
            amount: 1
          })
        }

        const mushroomItems = []
        for (let i = 0; i < mushroomsCount; i++) {
          const isMagic = Math.random() < 0.10 // 10% probabilidad oficial de Magic Mushroom
          mushroomItems.push({
            type: "mushroom",
            name: isMagic ? "Magic Mushroom" : "Wild Mushroom",
            image: isMagic
              ? "/img/sunflowerland/123/magic_mushroom.webp"
              : "/img/sunflowerland/123/wild_mushroom.webp",
            amount: 1,
            isMagic
          })
        }

        const mudItems = []
        for (let i = 0; i < mudCellsCount; i++) {
          mudItems.push({
            type: "mud",
            name: "Mud",
            image: "/img/sunflowerland/123/mud.webp",
            amount: mudPerCell
          })
        }

        const allItems = [...beetleItems, ...mushroomItems, ...mudItems]
        while (allItems.length < 25) {
          allItems.push({
            type: "empty",
            name: "Empty",
            image: "",
            amount: 0
          })
        }

        // Barajado aleatorio Fisher-Yates
        for (let i = allItems.length - 1; i > 0; i--) {
          const j = Math.floor(Math.random() * (i + 1));
          [allItems[i], allItems[j]] = [allItems[j], allItems[i]]
        }

        board = allItems.map((item, idx) => ({
          ...item,
          index: idx,
          revealed: false,
          flagged: false,
          clue: 0
        }))

        // Cálculo de pistas Buscaminas (Cruz ortogonal: Arriba, Abajo, Izquierda, Derecha)
        for (let i = 0; i < board.length; i++) {
          const neighbors = getOrthogonalNeighbors(i)
          const targetCount = neighbors.filter(
            (nIdx) => board[nIdx].type === "beetle" || board[nIdx].type === "mushroom"
          ).length
          board[i].clue = targetCount
        }

        cells.forEach((cell) => {
          cell.className = "cave-cell cursor-shovel relative aspect-square rounded-full bg-[#dfbe99] hover:bg-[#ebd1b0] border border-[#c49c71] shadow-[inset_0_-2px_3px_rgba(0,0,0,0.25)] active:scale-95 transition-all flex items-center justify-center p-0.5 group select-none"

          const mound = cell.querySelector(".cell-mound")
          const revealed = cell.querySelector(".cell-revealed")
          const beetleCheck = cell.querySelector(".cell-beetle-check")
          const clueNumber = cell.querySelector(".cell-clue-number")

          if (mound) mound.classList.remove("hidden")
          if (revealed) revealed.classList.add("hidden")
          if (beetleCheck) beetleCheck.classList.add("hidden")
          if (clueNumber) clueNumber.classList.add("hidden")
        })

        updateCounters()
        updateSolverProbabilities()
      }

      function updateCounters() {
        const modifiers = getBuffsModifiers()
        const isMudMix = activeMix.id === "mud_mix"
        const beetlesGoal = (activeMix.rewards.beetles || 2) + modifiers.beetleNestBonus
        const mushroomsGoal = (activeMix.rewards.mushrooms || (isMudMix ? 3 : 6)) + modifiers.mushroomBloomBonus
        const mudGoal = isMudMix
          ? (activeMix.rewards.mudBoosted || 40)
          : (activeMix.rewards.mud || 17)

        if (beetlesCountDisplay) beetlesCountDisplay.innerText = discoveredBeetles.toString()
        if (beetlesGoalDisplay) beetlesGoalDisplay.innerText = beetlesGoal.toString()
        if (mushroomsCountDisplay) mushroomsCountDisplay.innerText = discoveredMushrooms.toString()
        if (mushroomsGoalDisplay) mushroomsGoalDisplay.innerText = mushroomsGoal.toString()
        if (mudCountDisplay) mudCountDisplay.innerText = discoveredMud.toString()
        if (mudGoalDisplay) mudGoalDisplay.innerText = mudGoal.toString()

        // Píldoras oficiales de estado estilo Sunflower Land con Alto Contraste
        if (beetlesStatusPill && beetlesStatusText) {
          if (discoveredBeetles >= beetlesGoal) {
            beetlesStatusPill.className = "w-full py-1 px-2 rounded-full bg-emerald-500 border border-emerald-300 text-stone-950 text-[10px] font-mono font-black text-center flex items-center justify-center gap-1.5 shadow-md"
            if (isSimulationActive && simShovelsUsed > 0 && 25 - simShovelsUsed > 0) {
              beetlesStatusText.innerText = `¡${discoveredBeetles}/${beetlesGoal} Escarabajos! (Ahorro: -${25 - simShovelsUsed} palas)`
            } else {
              beetlesStatusText.innerText = tAllBeetlesFound
            }
          } else {
            beetlesStatusPill.className = "w-full py-1 px-2 rounded-full bg-black/80 border border-white/20 text-white text-[9.5px] font-mono font-bold text-center flex items-center justify-center gap-1.5 shadow-sm"
            beetlesStatusText.innerText = `${tBeetlesFound}: ${discoveredBeetles}/${beetlesGoal}`
          }
        }

        if (mushroomsStatusPill && mushroomsStatusText) {
          if (discoveredMushrooms >= mushroomsGoal) {
            mushroomsStatusPill.className = "w-full py-1 px-2 rounded-full bg-emerald-500 border border-emerald-300 text-stone-950 text-[10px] font-mono font-black text-center flex items-center justify-center gap-1.5 shadow-md"
            mushroomsStatusText.innerText = tAllMushroomsFound
          } else {
            mushroomsStatusPill.className = "w-full py-1 px-2 rounded-full bg-black/80 border border-white/20 text-white text-[9.5px] font-mono font-bold text-center flex items-center justify-center gap-1.5 shadow-sm"
            mushroomsStatusText.innerText = `${tMushroomsFound}: ${discoveredMushrooms}/${mushroomsGoal}`
          }
        }
      }

      function updateSolverProbabilities() {
        if (!isSolverActive) {
          cells.forEach((cell) => {
            const probBadge = cell.querySelector(".cell-prob-badge")
            const moundDot = cell.querySelector(".cell-mound-dot")
            if (probBadge) probBadge.classList.add("hidden")
            if (moundDot) moundDot.classList.remove("hidden")
            cell.classList.remove("ring-2", "ring-emerald-400", "shadow-[0_0_8px_rgba(52,211,153,0.7)]")
          })
          return
        }

        let totalValuable = 0
        let foundValuable = 0
        const unrevealed = []
        for (let i = 0; i < 25; i++) {
          if (board[i].type === "beetle" || board[i].type === "mushroom") {
            totalValuable++
          }
          if (board[i].revealed) {
            if (board[i].type === "beetle" || board[i].type === "mushroom") {
              foundValuable++
            }
          } else {
            unrevealed.push(i)
          }
        }

        const remainingValuable = Math.max(0, totalValuable - foundValuable)

        // Si ya se encontraron todos los objetivos de valor, todas las celdas ocultas son 0%
        if (remainingValuable === 0) {
          cells.forEach((cell, idx) => {
            if (!board[idx].revealed) {
              renderCellProb(cell, 0)
            }
          })
          return
        }

        // Si las celdas ocultas restantes son exactamente iguales a los objetivos restantes: 100%
        if (unrevealed.length === remainingValuable) {
          cells.forEach((cell, idx) => {
            if (!board[idx].revealed) {
              renderCellProb(cell, 100)
            }
          })
          return
        }

        // Si no se ha excavado ninguna celda: probabilidad base uniforme
        if (unrevealed.length === 25) {
          const baseProb = Math.round((totalValuable / 25) * 100)
          cells.forEach((cell) => {
            renderCellProb(cell, baseProb)
          })
          return
        }

        // Recolectar restricciones de celdas reveladas que tienen pista
        const constraints = []
        const constrainedVarsSet = new Set()

        for (let i = 0; i < 25; i++) {
          if (board[i].revealed) {
            const clue = board[i].clue
            const neighbors = getOrthogonalNeighbors(i)

            let valInRevealed = 0
            const unrevealedNeighbors = []

            neighbors.forEach((nIdx) => {
              if (board[nIdx].revealed) {
                if (board[nIdx].type === "beetle" || board[nIdx].type === "mushroom") {
                  valInRevealed++
                }
              } else {
                unrevealedNeighbors.push(nIdx)
              }
            })

            const remForNeighbors = clue - valInRevealed
            if (unrevealedNeighbors.length > 0) {
              constraints.push({
                cellIndex: i,
                vars: unrevealedNeighbors,
                sum: Math.max(0, remForNeighbors)
              })
              unrevealedNeighbors.forEach((v) => constrainedVarsSet.add(v))
            }
          }
        }

        // Si no hay restricciones activas, probabilidad homogénea restante
        if (constraints.length === 0 || constrainedVarsSet.size === 0) {
          const prob = Math.round((remainingValuable / unrevealed.length) * 100)
          cells.forEach((cell, idx) => {
            if (!board[idx].revealed) {
              renderCellProb(cell, prob)
            }
          })
          return
        }

        // Solver CSP por enumeración exacta de mundos posibles
        const varList = Array.from(constrainedVarsSet)
        const varIndexMap = new Map()
        varList.forEach((v, idx) => varIndexMap.set(v, idx))

        const compiledConstraints = constraints.map((c) => ({
          indices: c.vars.map((v) => varIndexMap.get(v)),
          sum: c.sum
        }))

        const unconstrainedCount = unrevealed.length - varList.length
        function nCr(n, r) {
          if (r < 0 || r > n) return 0
          if (r === 0 || r === n) return 1
          if (r > n / 2) r = n - r
          let res = 1
          for (let i = 1; i <= r; i++) {
            res = (res * (n - i + 1)) / i
          }
          return res
        }

        let totalValidWeight = 0
        const varTrueWeight = new Array(varList.length).fill(0)
        let unconstrainedTrueWeightSum = 0

        const currentAssignment = new Array(varList.length).fill(0)

        function backtrack(varIdx, currentSum) {
          if (currentSum > remainingValuable) return

          // Poda rápida de restricciones parciales
          for (let ci = 0; ci < compiledConstraints.length; ci++) {
            const c = compiledConstraints[ci]
            let partialSum = 0
            let unassignedCount = 0

            for (let j = 0; j < c.indices.length; j++) {
              const vi = c.indices[j]
              if (vi < varIdx) {
                partialSum += currentAssignment[vi]
              } else {
                unassignedCount++
              }
            }

            if (partialSum > c.sum) return
            if (partialSum + unassignedCount < c.sum) return
          }

          if (varIdx === varList.length) {
            for (let ci = 0; ci < compiledConstraints.length; ci++) {
              const c = compiledConstraints[ci]
              let s = 0
              for (let j = 0; j < c.indices.length; j++) {
                s += currentAssignment[c.indices[j]]
              }
              if (s !== c.sum) return
            }

            const neededInUnconstrained = remainingValuable - currentSum
            if (neededInUnconstrained < 0 || neededInUnconstrained > unconstrainedCount) return

            const weight = nCr(unconstrainedCount, neededInUnconstrained)
            if (weight > 0) {
              totalValidWeight += weight
              for (let i = 0; i < varList.length; i++) {
                if (currentAssignment[i] === 1) {
                  varTrueWeight[i] += weight
                }
              }
              unconstrainedTrueWeightSum += weight * neededInUnconstrained
            }
            return
          }

          // Probar 1 (tiene objetivo valioso)
          currentAssignment[varIdx] = 1
          backtrack(varIdx + 1, currentSum + 1)

          // Probar 0 (no tiene objetivo valioso)
          currentAssignment[varIdx] = 0
          backtrack(varIdx + 1, currentSum)
        }

        backtrack(0, 0)

        const probs = new Map()

        if (totalValidWeight > 0) {
          varList.forEach((vIdx, i) => {
            const p = Math.round((varTrueWeight[i] / totalValidWeight) * 100)
            probs.set(vIdx, p)
          })

          const unconstrainedProb = unconstrainedCount > 0
            ? Math.round((unconstrainedTrueWeightSum / (totalValidWeight * unconstrainedCount)) * 100)
            : 0

          unrevealed.forEach((cellIdx) => {
            if (!probs.has(cellIdx)) {
              probs.set(cellIdx, unconstrainedProb)
            }
          })
        } else {
          const fallbackProb = Math.round((remainingValuable / unrevealed.length) * 100)
          unrevealed.forEach((cellIdx) => {
            probs.set(cellIdx, fallbackProb)
          })
        }

        cells.forEach((cell, idx) => {
          if (!board[idx].revealed) {
            const p = probs.get(idx) ?? 0
            renderCellProb(cell, p)
          }
        })
      }

      function renderCellProb(cell, p) {
        const probBadge = cell.querySelector(".cell-prob-badge")
        const moundDot = cell.querySelector(".cell-mound-dot")
        if (!probBadge) return

        probBadge.classList.remove("hidden")
        if (moundDot) moundDot.classList.add("hidden")

        probBadge.innerText = `${p}%`
        probBadge.className = "cell-prob-badge absolute inset-0 flex items-center justify-center font-mono font-black text-[10px] sm:text-[10.5px] leading-none pointer-events-none select-none text-stone-950 tracking-tight"

        // Limpiar clases previas de borde y efectos de la celda
        cell.classList.remove(
          "border",
          "border-2",
          "border-[#c49c71]",
          "border-[#a87f54]",
          "border-emerald-500",
          "border-rose-500/80",
          "border-amber-500",
          "border-yellow-500",
          "ring-2",
          "ring-emerald-400",
          "shadow-[0_0_10px_rgba(16,185,129,0.8)]",
          "shadow-[0_0_6px_rgba(245,158,11,0.4)]",
          "animate-pulse"
        )

        // El borde del campo se colorea según el porcentaje (100% verde)
        if (p === 100) {
          cell.classList.add("border-2", "border-emerald-500", "ring-2", "ring-emerald-400", "shadow-[0_0_10px_rgba(16,185,129,0.8)]", "animate-pulse")
          cell.title = "¡100% Certeza de Objetivo Valioso! (Borde verde - Excavación recomendada)"
        } else if (p === 0) {
          cell.classList.add("border-2", "border-rose-500/80")
          cell.title = "0% Probabilidad (100% Mud seguro - Ahorra tu pala)"
        } else if (p >= 65) {
          cell.classList.add("border-2", "border-amber-500", "shadow-[0_0_6px_rgba(245,158,11,0.4)]")
          cell.title = `${p}% de Probabilidad de Objetivo Valioso`
        } else if (p >= 40) {
          cell.classList.add("border-2", "border-yellow-500")
          cell.title = `${p}% de Probabilidad de Objetivo Valioso`
        } else {
          cell.classList.add("border-2", "border-[#a87f54]")
          cell.title = `${p}% de Probabilidad de Objetivo Valioso`
        }
      }

      function setSimulationActive(active) {
        isSimulationActive = active
        if (simulateToggleBtn) {
          simulateToggleBtn.dataset.active = isSimulationActive ? "true" : "false"
          if (isSimulationActive) {
            simulateToggleBtn.classList.remove("bg-black/50", "text-white/50", "border-white/10")
            simulateToggleBtn.classList.add("bg-amber-500/15", "text-amber-300", "border-amber-500/40", "shadow-sm")
            if (simulateStatusText) {
              simulateStatusText.innerText = "ON"
              simulateStatusText.className = "text-[9px] px-1.5 py-0.5 rounded font-mono font-bold bg-amber-500/20 text-amber-300 border border-amber-500/30"
            }
          } else {
            simulateToggleBtn.classList.add("bg-black/50", "text-white/50", "border-white/10")
            simulateToggleBtn.classList.remove("bg-amber-500/15", "text-amber-300", "border-amber-500/40", "shadow-sm")
            if (simulateStatusText) {
              simulateStatusText.innerText = "OFF"
              simulateStatusText.className = "text-[9px] px-1.5 py-0.5 rounded font-mono font-bold bg-white/5 text-white/40 border border-white/5"
            }
          }
        }
      }

      function revealCell(idx) {
        if (!board[idx] || board[idx].revealed) return
        board[idx].revealed = true

        if (!isSimulationActive) {
          setSimulationActive(true)
        }

        const cell = cells[idx]
        if (!cell) return

        cell.className = "cave-cell relative aspect-square rounded-full bg-[#26150c] border border-[#1b0d06] shadow-[inset_0_2px_4px_rgba(0,0,0,0.6)] flex items-center justify-center p-0.5 group select-none cursor-default"

        const mound = cell.querySelector(".cell-mound")
        const revealed = cell.querySelector(".cell-revealed")
        const revealedImg = cell.querySelector(".cell-revealed-img")
        const beetleCheck = cell.querySelector(".cell-beetle-check")
        const clueNumber = cell.querySelector(".cell-clue-number")

        if (mound) mound.classList.add("hidden")
        if (revealed) revealed.classList.remove("hidden")

        const data = board[idx]
        const clue = data.clue || 0

        function applyClueNumber(el, val, itemLabel) {
          if (!el) return
          el.innerText = val.toString()
          el.classList.remove("hidden")
          if (val === 0) {
            el.className = "cell-clue-number relative z-10 font-mono font-black text-[11px] sm:text-xs leading-none drop-shadow-[0_1.5px_2px_rgba(0,0,0,1)] text-white/70"
            cell.title = `0: Ningún objetivo contiguo (${itemLabel})`
          } else if (val === 1) {
            el.className = "cell-clue-number relative z-10 font-mono font-black text-[11px] sm:text-xs leading-none drop-shadow-[0_1.5px_2px_rgba(0,0,0,1)] text-sky-300"
            cell.title = `1: 1 objetivo en cruz (${itemLabel})`
          } else if (val === 2) {
            el.className = "cell-clue-number relative z-10 font-mono font-black text-[11px] sm:text-xs leading-none drop-shadow-[0_1.5px_2px_rgba(0,0,0,1)] text-amber-300 animate-pulse"
            cell.title = `2: ¡2 objetivos en cruz! (${itemLabel})`
          } else if (val === 3) {
            el.className = "cell-clue-number relative z-10 font-mono font-black text-[11px] sm:text-xs leading-none drop-shadow-[0_1.5px_2px_rgba(0,0,0,1)] text-rose-400"
            cell.title = `3: ¡3 objetivos en cruz! (${itemLabel})`
          } else {
            el.className = "cell-clue-number relative z-10 font-mono font-black text-[11px] sm:text-xs leading-none drop-shadow-[0_1.5px_2px_rgba(0,0,0,1)] text-purple-300"
            cell.title = `4: ¡4 objetivos en cruz! (${itemLabel})`
          }
        }

        if (data.type === "beetle") {
          // Escarabajo: sprite + checkmark verde. NUNCA lleva número (lógica oficial SFL)
          cell.classList.add("border-amber-400/80")
          if (revealedImg) {
            revealedImg.src = data.image || ""
            revealedImg.alt = data.name || ""
            revealedImg.className = "cell-revealed-img w-4 h-4 object-contain [image-rendering:pixelated] drop-shadow-sm select-none pointer-events-none"
          }
          if (beetleCheck) beetleCheck.classList.remove("hidden")
          if (clueNumber) clueNumber.classList.add("hidden")

          const modifiers = getBuffsModifiers()
          discoveredBeetles++
          if (isSimulationActive) {
            const p2pPrice = getBeetleP2PPrice(data.sflId)
            simDiscoveredBeetles.push({
              name: data.name,
              image: data.image,
              price: p2pPrice * modifiers.twinBeetlesMultiplier
            })
          }
        } else if (data.type === "mushroom") {
          // Hongo: sprite (Wild Mushroom o Magic Mushroom) + número de pista debajo (0 a 4)
          if (data.isMagic) {
            cell.classList.add("border-cyan-400/80")
          } else {
            cell.classList.add("border-red-400/60")
          }
          if (revealedImg) {
            revealedImg.src = data.image || (data.isMagic ? "/img/sunflowerland/123/magic_mushroom.webp" : "/img/sunflowerland/123/wild_mushroom.webp")
            revealedImg.alt = data.name || (data.isMagic ? "Magic Mushroom" : "Wild Mushroom")
            revealedImg.className = "cell-revealed-img w-3.5 h-3.5 object-contain [image-rendering:pixelated] drop-shadow-sm select-none pointer-events-none"
          }
          if (beetleCheck) beetleCheck.classList.add("hidden")
          applyClueNumber(clueNumber, clue, data.isMagic ? "+1 Magic Mushroom" : "+1 Hongo")

          const modifiers = getBuffsModifiers()
          discoveredMushrooms++
          if (isSimulationActive) simMushrooms += modifiers.totalMushroomYieldPerTile
        } else {
          // Lodo (Mud): sprite de mud + número de pista debajo (0 a 4)
          if (revealedImg) {
            revealedImg.src = "/img/sunflowerland/123/mud.webp"
            revealedImg.alt = "Mud"
            revealedImg.className = "cell-revealed-img w-3.5 h-3.5 object-contain [image-rendering:pixelated] opacity-75 select-none pointer-events-none"
          }
          if (beetleCheck) beetleCheck.classList.add("hidden")
          applyClueNumber(clueNumber, clue, `+${data.amount} Mud`)

          const modifiers = getBuffsModifiers()
          discoveredMud += data.amount
          if (isSimulationActive) simMud += data.amount * modifiers.muddyBountyMultiplier
        }

        if (isSimulationActive) {
          simShovelsUsed++
          updateEconomics()
        }

        updateCounters()
        updateSolverProbabilities()
      }

      function digAll() {
        if (!isSimulationActive) {
          setSimulationActive(true)
        }
        for (let i = 0; i < board.length; i++) {
          if (!board[i].revealed) {
            revealCell(i)
          }
        }
      }

      function updateEconomics() {
        if (!activeMix) return

        const modifiers = getBuffsModifiers()
        const isMudMix = activeMix.id === "mud_mix"
        const coinsFlw = activeCoinsPerFlower > 0 ? 20 / activeCoinsPerFlower : 0
        const woodUnitFlw = getBaseMaterialUnitPrice("Wood")
        const stoneUnitFlw = getBaseMaterialUnitPrice("Stone")
        const baseShovelUnitCost = coinsFlw + (2 * woodUnitFlw) + (1 * stoneUnitFlw)
        const shovelUnitCost = baseShovelUnitCost * (1 - modifiers.sturdyShovelDiscount)

        // Requerimiento dinámico (evaluando opciones si es mud_mix y aplicando Lean Compost)
        const req = getActiveCropRequirement()
        const totalReqCost = req.amount * req.unitPriceFlw

        if (batchReqImg) batchReqImg.src = req.image
        if (batchReqText) batchReqText.innerText = `${req.amount}x ${req.name}`
        if (batchReqFlower) batchReqFlower.innerText = totalReqCost.toFixed(4)

        const totalBeetlesPerBatch = (activeMix.rewards.beetles || 2) + modifiers.beetleNestBonus
        const effectiveBeetlesPerBatch = totalBeetlesPerBatch * modifiers.twinBeetlesMultiplier

        if (beetlesPerBatchBadge) {
          const displayBeetles = Number(effectiveBeetlesPerBatch.toFixed(2))
          beetlesPerBatchBadge.innerText = `${displayBeetles} Escarabajos / Lote`
        }

        const mudTheoreticalGoal = isMudMix
          ? (activeMix.rewards.mudBoosted || 40)
          : (activeMix.rewards.mud || 17)

        if (isSimulationActive) {
          // MODO SIMULACIÓN EN TIEMPO REAL
          const shovelsCount = simShovelsUsed
          const totalShovelsCost = shovelsCount * shovelUnitCost
          const grandTotalInvested = totalShovelsCost + totalReqCost
          const grandTotalInvestedUsd = grandTotalInvested * liveFlowerPrice

          if (batchShovelsText) {
            const beetlesGoal = (activeMix.rewards.beetles || 2) + modifiers.beetleNestBonus
            const savedShovels = Math.max(0, 25 - shovelsCount)
            if (shovelsCount > 0 && discoveredBeetles >= beetlesGoal && savedShovels > 0) {
              batchShovelsText.innerHTML = `${shovelsCount}x Shovel <span class="text-emerald-400 text-[9.5px] font-bold">(-${savedShovels} palas)</span>`
            } else {
              batchShovelsText.innerText = `${shovelsCount}x Sand Shovel`
            }
          }
          if (batchShovelsFlower) batchShovelsFlower.innerText = totalShovelsCost.toFixed(4)
          if (totalCostFlower) totalCostFlower.innerText = grandTotalInvested.toFixed(4)
          if (totalCostUsd) totalCostUsd.innerText = `~$${grandTotalInvestedUsd.toFixed(4)}`

          // Escarabajos reales encontrados
          let simBeetleRev = 0
          let simRowsHtml = ""

          if (simDiscoveredBeetles.length === 0) {
            simRowsHtml = `
              <div class="py-1 text-center text-white/40 text-[10px] italic">
                Excava casillas para encontrar escarabajos...
              </div>
            `
          } else {
            simDiscoveredBeetles.forEach((b) => {
              simBeetleRev += b.price || 0
              simRowsHtml += `
                <div class="grid grid-cols-4 gap-1 items-center py-0.5 text-white/90">
                  <div class="flex items-center gap-1 truncate col-span-2">
                    <img src="${b.image}" class="w-3.5 h-3.5 object-contain" alt="${b.name}" />
                    <span class="truncate">${b.name}</span>
                  </div>
                  <div class="flex items-center justify-end gap-1 col-span-2 text-emerald-400 font-bold">
                    <img src="/img/sunflowerland/flower.jpg" class="w-3 h-3 rounded-full object-cover shrink-0" alt="FLOWER" />
                    <span>${b.price > 0 ? b.price.toFixed(4) : "--"}</span>
                  </div>
                </div>
              `
            })
          }

          if (beetleOddsRows) beetleOddsRows.innerHTML = simRowsHtml

          const simBeetleRevUsd = simBeetleRev * liveFlowerPrice
          if (totalBeetleRevFlower) totalBeetleRevFlower.innerText = simBeetleRev.toFixed(4)
          if (totalBeetleRevUsd) totalBeetleRevUsd.innerText = `~$${simBeetleRevUsd.toFixed(4)}`

          const netBalance = simBeetleRev - grandTotalInvested
          const labelProfit = residualCard?.dataset?.labelProfit || "¡Ganancia Neta Directa!:"
          const labelDeficit = residualCard?.dataset?.labelDeficit || "Déficit cubierto con cosecha:"
          const textFreeProfit = residualCard?.dataset?.textFreeprofit || "(¡Gratis con Ganancia!)"

          if (netBalance > 0) {
            if (balanceLabel) balanceLabel.innerText = labelProfit
            if (balanceBadge) balanceBadge.classList.remove("hidden")
            if (balanceContainer) {
              balanceContainer.className = "flex items-center gap-1 font-bold text-emerald-400"
            }
            if (deficitFlower) deficitFlower.innerText = `+${netBalance.toFixed(4)}`
            if (deficitUsd) deficitUsd.innerText = `(~+$${(netBalance * liveFlowerPrice).toFixed(4)})`

            if (mushroomFreeBadge) mushroomFreeBadge.classList.remove("hidden")
            if (mudFreeBadge) mudFreeBadge.classList.remove("hidden")
            if (mushroomUnitFlower) mushroomUnitFlower.innerText = "0.0000"
            if (mushroomUnitUsd) {
              mushroomUnitUsd.innerText = textFreeProfit
              mushroomUnitUsd.className = "text-[9px] font-mono text-emerald-400 font-bold"
            }
            if (mudUnitFlower) mudUnitFlower.innerText = "0.0000"
            if (mudUnitUsd) {
              mudUnitUsd.innerText = textFreeProfit
              mudUnitUsd.className = "text-[9px] font-mono text-emerald-400 font-bold"
            }
          } else {
            const deficit = Math.abs(netBalance)
            const deficitUsdVal = deficit * liveFlowerPrice
            if (balanceLabel) balanceLabel.innerText = labelDeficit
            if (balanceBadge) balanceBadge.classList.add("hidden")
            if (balanceContainer) {
              balanceContainer.className = "flex items-center gap-1 font-bold text-amber-400"
            }
            if (deficitFlower) deficitFlower.innerText = deficit.toFixed(4)
            if (deficitUsd) deficitUsd.innerText = `(~$${deficitUsdVal.toFixed(4)})`

            if (mushroomFreeBadge) mushroomFreeBadge.classList.add("hidden")
            if (mudFreeBadge) mudFreeBadge.classList.add("hidden")

            const harvestedCount = simMushrooms + simMud
            const unitResidual = harvestedCount > 0 ? deficit / harvestedCount : 0
            const unitResidualUsd = unitResidual * liveFlowerPrice

            if (mushroomUnitFlower) mushroomUnitFlower.innerText = unitResidual.toFixed(4)
            if (mushroomUnitUsd) {
              mushroomUnitUsd.innerText = `~$${unitResidualUsd.toFixed(4)}`
              mushroomUnitUsd.className = "text-[9px] font-mono text-white/40"
            }
            if (mudUnitFlower) mudUnitFlower.innerText = unitResidual.toFixed(4)
            if (mudUnitUsd) {
              mudUnitUsd.innerText = `~$${unitResidualUsd.toFixed(4)}`
              mudUnitUsd.className = "text-[9px] font-mono text-white/40"
            }
          }

        } else {
          // MODO TEÓRICO COMPLETO POR LOTE (1 Lote = 25 Palas)
          const totalShovels = 25
          const totalShovelsCost = totalShovels * shovelUnitCost
          const grandTotalInvested = totalShovelsCost + totalReqCost
          const grandTotalInvestedUsd = grandTotalInvested * liveFlowerPrice

          if (batchShovelsText) batchShovelsText.innerText = `${totalShovels}x Sand Shovel`
          if (batchShovelsFlower) batchShovelsFlower.innerText = totalShovelsCost.toFixed(4)
          if (totalCostFlower) totalCostFlower.innerText = grandTotalInvested.toFixed(4)
          if (totalCostUsd) totalCostUsd.innerText = `~$${grandTotalInvestedUsd.toFixed(4)}`

          let expectedBeetleUnitValue = 0
          let oddsHtml = ""

          const effectiveOdds = getActiveBeetleOdds(activeMix.beetleOdds)
          if (effectiveOdds && Array.isArray(effectiveOdds)) {
            effectiveOdds.forEach((odd) => {
              const p2pPrice = getBeetleP2PPrice(odd.sflId)
              const expectedContribution = p2pPrice * odd.chance
              expectedBeetleUnitValue += expectedContribution

              oddsHtml += `
                <div class="grid grid-cols-4 gap-1 items-center py-0.5 text-white/90">
                  <div class="flex items-center gap-1 truncate">
                    <img src="${odd.image}" class="w-3.5 h-3.5 object-contain" alt="${odd.name}" />
                    <span class="truncate">${odd.name.replace(" Beetle", "")}</span>
                  </div>
                  <span class="text-center text-terminal-muted">${Math.round(odd.chance * 100)}%</span>
                  <span class="text-right text-emerald-400 font-bold">${p2pPrice > 0 ? p2pPrice.toFixed(4) : "--"}</span>
                  <span class="text-right text-cyan-400 font-bold">${expectedContribution > 0 ? expectedContribution.toFixed(4) : "--"}</span>
                </div>
              `
            })
          }

          if (beetleOddsRows) beetleOddsRows.innerHTML = oddsHtml

          const grandTotalBeetleRev = effectiveBeetlesPerBatch * expectedBeetleUnitValue
          const grandTotalBeetleRevUsd = grandTotalBeetleRev * liveFlowerPrice

          if (totalBeetleRevFlower) totalBeetleRevFlower.innerText = grandTotalBeetleRev.toFixed(4)
          if (totalBeetleRevUsd) totalBeetleRevUsd.innerText = `~$${grandTotalBeetleRevUsd.toFixed(4)}`

          const netBalance = grandTotalBeetleRev - grandTotalInvested
          const labelProfit = residualCard?.dataset?.labelProfit || "¡Ganancia Neta Directa!:"
          const labelDeficit = residualCard?.dataset?.labelDeficit || "Déficit cubierto con cosecha:"
          const textFreeProfit = residualCard?.dataset?.textFreeprofit || "(¡Gratis con Ganancia!)"

          if (netBalance > 0) {
            if (balanceLabel) balanceLabel.innerText = labelProfit
            if (balanceBadge) balanceBadge.classList.remove("hidden")
            if (balanceContainer) {
              balanceContainer.className = "flex items-center gap-1 font-bold text-emerald-400"
            }
            if (deficitFlower) deficitFlower.innerText = `+${netBalance.toFixed(4)}`
            if (deficitUsd) deficitUsd.innerText = `(~+$${(netBalance * liveFlowerPrice).toFixed(4)})`

            if (mushroomFreeBadge) mushroomFreeBadge.classList.remove("hidden")
            if (mudFreeBadge) mudFreeBadge.classList.remove("hidden")
            if (mushroomUnitFlower) mushroomUnitFlower.innerText = "0.0000"
            if (mushroomUnitUsd) {
              mushroomUnitUsd.innerText = textFreeProfit
              mushroomUnitUsd.className = "text-[9px] font-mono text-emerald-400 font-bold"
            }
            if (mudUnitFlower) mudUnitFlower.innerText = "0.0000"
            if (mudUnitUsd) {
              mudUnitUsd.innerText = textFreeProfit
              mudUnitUsd.className = "text-[9px] font-mono text-emerald-400 font-bold"
            }
          } else {
            const deficit = Math.abs(netBalance)
            const deficitUsdVal = deficit * liveFlowerPrice
            if (balanceLabel) balanceLabel.innerText = labelDeficit
            if (balanceBadge) balanceBadge.classList.add("hidden")
            if (balanceContainer) {
              balanceContainer.className = "flex items-center gap-1 font-bold text-amber-400"
            }
            if (deficitFlower) deficitFlower.innerText = deficit.toFixed(4)
            if (deficitUsd) deficitUsd.innerText = `(~$${deficitUsdVal.toFixed(4)})`

            if (mushroomFreeBadge) mushroomFreeBadge.classList.add("hidden")
            if (mudFreeBadge) mudFreeBadge.classList.add("hidden")

            const baseMushrooms = activeMix.rewards.mushrooms || (isMudMix ? 3 : 6)
            const effectiveMushroomsHarvested = (baseMushrooms + modifiers.mushroomBloomBonus) * modifiers.totalMushroomYieldPerTile
            const effectiveMudHarvested = mudTheoreticalGoal * modifiers.muddyBountyMultiplier
            const totalHarvestItems = effectiveMushroomsHarvested + effectiveMudHarvested
            const residualUnitCost = totalHarvestItems > 0 ? deficit / totalHarvestItems : 0
            const residualUnitCostUsd = residualUnitCost * liveFlowerPrice

            if (mushroomUnitFlower) mushroomUnitFlower.innerText = residualUnitCost.toFixed(4)
            if (mushroomUnitUsd) {
              mushroomUnitUsd.innerText = `~$${residualUnitCostUsd.toFixed(4)}`
              mushroomUnitUsd.className = "text-[9px] font-mono text-white/40"
            }
            if (mudUnitFlower) mudUnitFlower.innerText = residualUnitCost.toFixed(4)
            if (mudUnitUsd) {
              mudUnitUsd.innerText = `~$${residualUnitCostUsd.toFixed(4)}`
              mudUnitUsd.className = "text-[9px] font-mono text-white/40"
            }
          }
        }
      }

      // Manejo del botón toggle de simulación
      if (simulateToggleBtn) {
        simulateToggleBtn.addEventListener("click", () => {
          if (!isSimulationActive) {
            setSimulationActive(true)
            simShovelsUsed = 0
            simDiscoveredBeetles = []
            simMushrooms = 0
            simMud = 0
            generateBoard()
            updateEconomics()
          } else {
            setSimulationActive(false)
            simShovelsUsed = 0
            simDiscoveredBeetles = []
            simMushrooms = 0
            simMud = 0
            generateBoard()
            updateEconomics()
          }
        })
      }

      // Control del Dropdown Custom de Cultivos (Mud Mix)
      if (cropDropdownTrigger) {
        cropDropdownTrigger.addEventListener("click", (e) => {
          e.stopPropagation()
          if (cropDropdownMenu) {
            const isClosed = cropDropdownMenu.classList.contains("hidden")
            if (isClosed) {
              cropDropdownMenu.classList.remove("hidden")
              if (cropTriggerArrow) cropTriggerArrow.classList.add("rotate-180")
            } else {
              cropDropdownMenu.classList.add("hidden")
              if (cropTriggerArrow) cropTriggerArrow.classList.remove("rotate-180")
            }
          }
        })
      }

      // Cerrar dropdown al hacer click fuera
      document.addEventListener("click", (e) => {
        if (cropDropdownMenu && !cropDropdownMenu.classList.contains("hidden")) {
          const target = e.target
          if (cropDropdownTrigger && cropDropdownTrigger.contains(target)) return
          if (cropDropdownMenu.contains(target)) return
          cropDropdownMenu.classList.add("hidden")
          if (cropTriggerArrow) cropTriggerArrow.classList.remove("rotate-180")
        }
      })

      mixBtns.forEach((btn) => {
        btn.addEventListener("click", () => {
          mixBtns.forEach((b) => {
            b.classList.remove("bg-white/10", "text-amber-400", "border-amber-500/30", "shadow-sm")
            b.classList.add("text-white/50", "border-transparent")
          })
          btn.classList.add("bg-white/10", "text-amber-400", "border-amber-500/30", "shadow-sm")
          btn.classList.remove("text-white/50", "border-transparent")

          try {
            activeMix = JSON.parse(btn.dataset.mixData)
            selectedCropIndex = -1 // Resetear al óptimo automáticamente
            if (cropDropdownMenu) {
              cropDropdownMenu.dataset.populatedKey = ""
              cropDropdownMenu.classList.add("hidden")
            }
            if (cropTriggerArrow) cropTriggerArrow.classList.remove("rotate-180")
            if (isSimulationActive) {
              simShovelsUsed = 0
              simDiscoveredBeetles = []
              simMushrooms = 0
              simMud = 0
            }
            generateBoard()
            updateEconomics()
          } catch (e) {}
        })
      })

      cells.forEach((cell, idx) => {
        cell.addEventListener("click", () => {
          revealCell(idx)
        })
      })

      if (digAllBtn) {
        digAllBtn.addEventListener("click", digAll)
      }

      if (resetBtn) {
        resetBtn.addEventListener("click", () => {
          simShovelsUsed = 0
          simDiscoveredBeetles = []
          simMushrooms = 0
          simMud = 0
          generateBoard()
          updateEconomics()
        })
      }

      generateBoard()
      updateEconomics()

      return {
        update: updateEconomics,
        reset: generateBoard,
        checkBuffsBoardSync: () => {
          if (simShovelsUsed === 0 && !isSimulationActive) {
            generateBoard()
          } else {
            updateCounters()
          }
        }
      }
    }


    caveManager = createCaveController()

    function applyBettyRatio(ratio) {
      if (!ratio || ratio <= 0) return
      activeCoinsPerFlower = ratio
      if (caveManager) {
        caveManager.update()
      }
    }

    function updateAll() {
      if (caveManager) {
        caveManager.update()
      }
    }

    async function fetchLiveMarketData() {
      try {
        const res = await fetch("/api/sfl_data.json?t=" + Date.now())
        if (res.ok) {
          const data = await res.json()
          marketDataCache = data

          if (data && data.flowerPrice) {
            liveFlowerPrice = parseFloat(data.flowerPrice)
          }

          if (data && data.items && bettyPrices && sflIds) {
            let bestRatio = 0
            Object.keys(bettyPrices).forEach((name) => {
              const itemConfig = bettyPrices[name]
              const itemId = Object.keys(sflIds).find((key) => sflIds[key] === name)
              const internalKey = `collectibles-${itemId}`
              const marketItem = data.items[internalKey]

              const bettyPriceCoins = itemConfig.sellPrice
              const p2pPriceFlower = marketItem ? marketItem.currentPrice : 0
              if (p2pPriceFlower > 0) {
                const ratio = bettyPriceCoins / p2pPriceFlower
                if (ratio > bestRatio) {
                  bestRatio = ratio
                }
              }
            })

            if (bestRatio > 0) {
              applyBettyRatio(bestRatio)
            }
          }
        }
      } catch (err) {
        console.error("Error al obtener datos de mercado SFL:", err)
      }
      updateAll()
    }

    updateAll()
    fetchLiveMarketData()
  })()
</script>

