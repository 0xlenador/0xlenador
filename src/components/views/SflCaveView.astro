            </div>
          </div>

          <!-- Columna Derecha: Minijuego Visual Angostado y Compactado (md:col-span-4) -->
          <div class="md:col-span-4 flex flex-col gap-2">
            <!-- Requisitos y Contadores de Progreso Compactos -->
            <div class="bg-black/40 border border-white/10 rounded-xl p-2 flex flex-col gap-1.5">
              <!-- Control: Modo Simulación en Vivo -->
