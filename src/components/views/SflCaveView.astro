                    <!-- 1 Mud -->
                    <div class="relative bg-black/40 border border-white/5 rounded-lg p-1.5 flex flex-col items-center text-center overflow-hidden">
                      <span id="caveMudFreeBadge" class="hidden absolute top-1 right-1 px-1 py-0.2 text-[8px] font-bold rounded bg-emerald-500/25 text-emerald-300 border border-emerald-500/40">
