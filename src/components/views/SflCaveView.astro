                <div
                  id="caveResidualCard"
                  class="rounded-xl bg-gradient-to-br from-amber-500/[0.08] to-emerald-500/[0.04] border border-amber-500/20 p-2 flex flex-col gap-1.5 transition-colors"
                  data-label-profit={t("sfl.constants.cave.netProfit")}
                  data-label-deficit={t("sfl.constants.cave.netLoss")}
                  data-badge-free={t("sfl.constants.cave.freeHarvest")}
