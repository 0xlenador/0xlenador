---
// ============================================================
// src/components/views/SflCaveView.astro
// View puro para la herramienta de Cueva & Excavación Subterránea SFL.
// Fuente única de verdad: consumido por sfl-cueva.astro y en/sfl-cave.astro.
// El idioma se detecta desde la URL vía getLangFromUrl.
// ============================================================
import { getEntry } from "astro:content"
import { getLangFromUrl, useTranslations } from "../../i18n/utils"
import SflToolLayout from "../SflToolLayout.astro"
import { caveData } from "../../content/data/sfl/cave_mining"
import bettyPrices from "../../content/data/sfl/betty_prices.json"

const sflIdsEntry = await getEntry("sfl", "resources")
const sflIds = sflIdsEntry?.data || {}

const sflSkillsEntry = await getEntry("sfl", "skills")
const sflSkills = sflSkillsEntry?.data?.Cave || {}

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)

const cavePowerUps = [
  {
    id: "mushroom_hat",
    name: "Mushroom Hat",
    boost: "+0.1 Wild Mushroom",
    image: "/img/sunflowerland/powerups/wearables/Mushroom Hat.webp",
  },
  {
    id: "mushroom_house",
    name: "Mushroom House",
    boost: "+0.2 Wild Mushroom",
    image: "/img/sunflowerland/powerups/mushroom_house.png",
  },
]

const caveOthers = [
  {
    id: "fairy_circle",
    name: "Fairy Circle",
    boost: "+0.2 Wild Mushroom",
    image: "/img/sunflowerland/collectible/fairy_circle.webp",
  },
]

const formatAstroDescription = (skill: any) => {
  let desc = skill.description || ""
  if (skill.mathematics_1?.calc_by_rank?.rank_1 !== undefined) {
    const m1 = skill.mathematics_1.calc_by_rank.rank_1
    desc = desc
      .replace("{math1}", m1)
      .replace("{math1_pct}", parseFloat((m1 * 100).toFixed(2)).toString())
      .replace("{math1_days}", parseFloat((m1 / 86400000).toFixed(2)).toString())
  }
  if (skill.mathematics_2?.calc_by_rank?.rank_1 !== undefined) {
    const m2 = skill.mathematics_2.calc_by_rank.rank_1
    desc = desc
      .replace("{math2}", m2)
      .replace("{math2_pct}", parseFloat((m2 * 100).toFixed(2)).toString())
      .replace("{math2_days}", parseFloat((m2 / 86400000).toFixed(2)).toString())
  }
  return desc
}

const getCompactSkillText = (skillData: any, formattedDesc: string) => {
  let value = "?"
  const match = formattedDesc.match(/(?:^|\b|\s)([x+-]?\d+(?:\.\d+)?(?:%|x)?)/i)
  if (match) {
    value = match[1].trim()
    if (value.toLowerCase().endsWith("x")) {
      value = "x" + value.slice(0, -1)
    }
  }
  return `${value} ${skillData.name || ""}`
}

const getCompactText = (name: string, boost: string) => {
  return `${boost} ${name}`
}
---

<SflToolLayout activeTab="cueva">
  <!-- Encabezado Principal -->
  <div class="mb-5 relative z-10 text-center sm:text-left">
    <h1 class="text-3xl md:text-4xl font-black text-white tracking-tighter mb-2">
      {t("sfl.cave.heading")}
      <span class="text-emerald-500"> {t("sfl.cave.heading.accent")}</span>
    </h1>
    <p class="text-terminal-secondary text-sm leading-relaxed max-w-3xl">
      {t("sfl.cave.intro")}
    </p>
  </div>

  <!-- Boosts (PowerUps, Skills & Others) -->
  <details class="group w-full mb-8 bg-white/[0.02] border border-white/5 rounded-2xl" open>
    <summary class="flex flex-col xl:flex-row xl:items-center justify-between p-4 cursor-pointer hover:bg-white/[0.02] transition-colors rounded-2xl list-none gap-4">
      <div class="flex items-center gap-2 shrink-0">
        <svg class="w-2.5 h-2.5 text-emerald-500 transition-transform duration-200 group-open:rotate-90 shrink-0" viewBox="0 0 24 24" fill="currentColor">
          <path d="M8 5v14l11-7z" />
        </svg>
        <span class="text-sm font-bold text-white uppercase tracking-wider">✨ Configure Boosts & Buffs</span>
      </div>

      <div class="text-[10px] text-white/40 font-mono group-open:hidden uppercase tracking-widest border border-white/10 px-2 py-1 rounded-md xl:ml-auto w-max">Tap to expand</div>

      <!-- Filters (Desktop Only) -->
      <div class="hidden group-open:xl:flex overflow-x-auto no-scrollbar w-full xl:w-auto pb-2 xl:pb-0 -mx-4 px-4 xl:mx-0 xl:px-0" onclick="event.preventDefault();">
        <div class="flex items-center gap-3 w-max shrink-0 mx-auto xl:mx-0 xl:ml-auto">
          <div class="flex items-center gap-1 bg-[#06080A]/50 p-1 rounded-lg border border-white/5 shadow-inner">
            <button class="view-switch-btn active px-4 py-1.5 rounded-md text-[10px] font-bold uppercase tracking-wider text-white/40 hover:text-white transition-all whitespace-nowrap shrink-0" data-action="detailed" onclick="window.setViewStyle('detailed'); event.stopPropagation();">Detailed</button>
            <button class="view-switch-btn px-4 py-1.5 rounded-md text-[10px] font-bold uppercase tracking-wider text-white/40 hover:text-white transition-all whitespace-nowrap shrink-0" data-action="compact" onclick="window.setViewStyle('compact'); event.stopPropagation();">Compact</button>
          </div>
        </div>
      </div>
    </summary>

    <div class="p-4 pt-0 relative">
      <div id="boosts-peek-wrapper" class="relative">
        <div id="boosts-container" class="relative z-10">
          <!-- Filters (Mobile Only) -->
          <div class="flex items-center justify-end mb-5 xl:hidden">
            <div class="flex items-center gap-2 flex-wrap sm:flex-nowrap w-full sm:w-auto">
              <div class="flex items-center gap-1 bg-[#06080A]/50 p-1 rounded-lg border border-white/5 w-full sm:w-auto justify-center shadow-inner">
                <button class="view-switch-btn active flex-1 sm:flex-none px-3 py-1 rounded-md text-[10px] font-bold uppercase tracking-wider text-white/40 hover:text-white transition-all" data-action="detailed" onclick="window.setViewStyle('detailed')">Detailed</button>
                <button class="view-switch-btn flex-1 sm:flex-none px-3 py-1 rounded-md text-[10px] font-bold uppercase tracking-wider text-white/40 hover:text-white transition-all" data-action="compact" onclick="window.setViewStyle('compact')">Compact</button>
              </div>
            </div>
          </div>

          <div class="flex flex-col items-start w-full mt-2">
            <!-- PowerUps Sub-group -->
            <details class="group/sub w-full mb-1 open:mb-6" open>
              <summary class="flex items-center cursor-pointer text-xs font-bold text-white/60 uppercase tracking-wider mb-2 group-open/sub:mb-3 hover:text-emerald-400 transition-colors list-none select-none [&::-webkit-details-marker]:hidden">
                <svg class="w-2.5 h-2.5 mr-2 text-emerald-500/80 transition-transform duration-200 group-open/sub:rotate-90 shrink-0" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M8 5v14l11-7z" />
                </svg>
                PowerUps
              </summary>
              <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 xl:grid-cols-7 gap-2 w-full pl-1">
                {cavePowerUps.map((buff) => (
                  <label class="buff-card group flex items-center gap-2 cursor-pointer bg-white/5 border border-white/5 hover:border-emerald-500/30 hover:bg-emerald-500/10 rounded-lg p-1.5 transition-all" data-buff-id={buff.id}>
                    <input type="checkbox" class="hidden buff-checkbox w-3.5 h-3.5 rounded border-white/20 bg-white/5 text-emerald-500 focus:ring-emerald-500/50" data-buff-id={buff.id} />
                    <img src={buff.image} class="w-6 h-6 object-contain drop-shadow-sm group-hover:scale-110 transition-transform" onerror="this.onerror=null; this.src='/img/cripto/sunflowerland.webp';" alt={buff.name} title={buff.boost} />
                    <div class="flex flex-col normal-view">
                      <span class="text-[10px] font-bold text-white group-[.active]:text-emerald-400 group-hover:text-emerald-400 transition-colors">{buff.name}</span>
                      <span class="text-[9px] text-terminal-muted leading-tight" title={buff.boost}>{buff.boost}</span>
                    </div>
                    <div class="hidden compact-view w-full">
                      <span class="text-[9px] font-mono text-white/80 whitespace-nowrap overflow-hidden text-ellipsis group-[.active]:text-emerald-400 transition-colors" title={buff.boost}>{getCompactText(buff.name, buff.boost)}</span>
                    </div>
                  </label>
                ))}
              </div>
            </details>

            <!-- Skills Sub-group -->
            <details class="group/sub w-full mb-1 open:mb-6" open>
              <summary class="flex items-center cursor-pointer text-xs font-bold text-white/60 uppercase tracking-wider mb-2 group-open/sub:mb-3 hover:text-blue-400 transition-colors list-none select-none [&::-webkit-details-marker]:hidden">
                <svg class="w-2.5 h-2.5 mr-2 text-blue-500/80 transition-transform duration-200 group-open/sub:rotate-90 shrink-0" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M8 5v14l11-7z" />
                </svg>
                Skills
              </summary>
              <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 xl:grid-cols-7 gap-2 w-full pl-1">
                {Object.entries(sflSkills).map(([skillName, skillData]: [string, any]) => {
                  const mainSrc = skillData.image || "/img/sunflowerland/123/Hammer.png";
                  const fallbackSrc = "/img/cripto/sunflowerland.webp";
                  const formattedDesc = formatAstroDescription(skillData);
                  return (
                    <div class={`skill-card flex flex-col bg-white/5 border border-white/5 rounded-lg p-1.5 transition-all group ${skillData.disabled ? "opacity-30 grayscale cursor-not-allowed" : "hover:border-blue-500/30 hover:bg-blue-500/5 cursor-pointer"}`} data-skill-id={skillName} style={skillData.disabled ? "pointer-events: none;" : ""}>
                      <div class="flex items-start gap-2 mb-1.5 pointer-events-none">
                        <img src={mainSrc} class="w-6 h-6 object-contain drop-shadow-sm group-hover:scale-110 transition-transform shrink-0" onerror={`this.onerror=null; this.src='${fallbackSrc}';`} alt={skillName} title={formattedDesc} />
                        <div class="flex flex-col normal-view">
                          <span class="text-[10px] font-bold text-white group-[.active]:text-blue-400 transition-colors">{skillName}</span>
                          <span class="skill-description-text text-[9px] text-terminal-muted leading-tight" title={formattedDesc} data-original={skillData.description}>{formattedDesc}</span>
                        </div>
                        <div class="hidden compact-view w-full mr-2">
                          <span class="text-[9px] font-mono text-white/80 whitespace-nowrap overflow-hidden text-ellipsis group-[.active]:text-blue-400 transition-colors" title={formattedDesc}>{getCompactSkillText(skillData, formattedDesc)}</span>
                        </div>
                      </div>

                      {skillData.cost_by_rank && Object.keys(skillData.cost_by_rank).length > 0 && (
                        <div class="flex items-center gap-2.5 mt-auto pt-1.5 border-t border-white/10" onclick="event.stopPropagation()">
                          {Object.keys(skillData.cost_by_rank).map((_, idx) => (
                            <label class="flex items-center gap-1 cursor-pointer hover:opacity-80 transition-opacity">
                              <input type="checkbox" value={idx + 1} class={`skill-rank-checkbox w-2.5 h-2.5 rounded-sm text-blue-500 bg-white/5 border-white/20 focus:ring-blue-500/50 rank-input-${skillName.replace(/\s+/g, '_')}`} data-skill-id={skillName} data-rank={idx + 1} />
                              <span class="text-[8px] font-mono font-bold text-white/50">R{idx + 1}</span>
                            </label>
                          ))}
                        </div>
                      )}
                    </div>
                  )
                })}
              </div>
            </details>

            <!-- Others Sub-group -->
            <details class="group/sub w-full mb-1 open:mb-6" open>
              <summary class="flex items-center cursor-pointer text-xs font-bold text-white/60 uppercase tracking-wider mb-2 group-open/sub:mb-3 hover:text-purple-400 transition-colors list-none select-none [&::-webkit-details-marker]:hidden">
                <svg class="w-2.5 h-2.5 mr-2 text-purple-500/80 transition-transform duration-200 group-open/sub:rotate-90 shrink-0" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M8 5v14l11-7z" />
                </svg>
                Others
              </summary>
              <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 xl:grid-cols-7 gap-2 w-full pl-1">
                {caveOthers.map((item) => (
                  <label class="buff-card group flex items-center gap-2 cursor-pointer bg-white/5 border border-white/5 hover:border-purple-500/30 hover:bg-purple-500/10 rounded-lg p-1.5 transition-all" data-buff-id={item.id}>
                    <input type="checkbox" class="hidden buff-checkbox w-3.5 h-3.5 rounded border-white/20 bg-white/5 text-purple-500 focus:ring-purple-500/50" data-buff-id={item.id} />
                    <img src={item.image} class="w-6 h-6 object-contain drop-shadow-sm group-hover:scale-110 transition-transform" onerror="this.onerror=null; this.src='/img/cripto/sunflowerland.webp';" alt={item.name} title={item.boost} />
                    <div class="flex flex-col normal-view">
                      <span class="text-[10px] font-bold text-white group-[.active]:text-purple-400 group-hover:text-purple-400 transition-colors">{item.name}</span>
                      <span class="text-[9px] text-terminal-muted leading-tight" title={item.boost}>{item.boost}</span>
                    </div>
                    <div class="hidden compact-view w-full">
                      <span class="text-[9px] font-mono text-white/80 whitespace-nowrap overflow-hidden text-ellipsis group-[.active]:text-purple-400 transition-colors" title={item.boost}>{getCompactText(item.name, item.boost)}</span>
                    </div>
                  </label>
                ))}
              </div>
            </details>
          </div>
        </div>
      </div>
    </div>
  </details>

  <!-- Segundo Bloque: Cueva Subterránea (Centrado en PC: max-w-4xl mx-auto) -->

  <!-- Segundo Bloque: Cueva Subterránea (Centrado en PC: max-w-4xl mx-auto) -->
  <div class="max-w-4xl mx-auto w-full mb-8 relative z-10">
    <!-- BLOQUE 3: CUEVA & MINIJUEGO DE COMPOSTAJE (Ocupa 50% en escritorio) -->
    <div
      class="bg-[#18181b]/95 border border-white/10 rounded-2xl shadow-xl backdrop-blur-md overflow-hidden flex flex-col"
    >
      <!-- Cabecera del Edificio con Icono y Selector de Mix debajo del texto -->
      <div class="p-3.5 sm:p-4 border-b border-white/10 bg-black/20">
        <div class="flex items-center gap-2.5 mb-2.5">
          <div
            class="w-10 h-10 sm:w-11 sm:h-11 rounded-xl bg-amber-500/10 border border-amber-500/30 flex items-center justify-center shrink-0 p-1"
          >
            <img
              src="/img/sunflowerland/build/cave_entrance.webp"
              alt="Cave Entrance"
              class="w-8 h-8 object-contain [image-rendering:pixelated]"
            />
          </div>
          <div>
            <h3 class="text-base sm:text-lg font-bold text-white tracking-tight flex items-center gap-2">
              <span>{t("sfl.constants.building.cave")}</span>
              <span class="text-[10px] font-mono px-2 py-0.5 rounded-full bg-white/5 border border-white/10 text-terminal-muted font-normal">
                5x5 Grid (25 Shovels)
              </span>
            </h3>
            <p class="text-xs text-terminal-muted">
              {t("sfl.constants.building.cave.desc")}
            </p>
          </div>
        </div>

        <!-- Selector de Mix de Cultivo (debajo del párrafo) -->
        <div class="flex items-center gap-1.5 bg-black/40 p-1 rounded-xl border border-white/5">
          {
            caveData.mixes.map((mix, idx) => (
              <button
                type="button"
                class={`cave-mix-tab-btn flex-1 py-1 px-2 rounded-lg text-xs font-mono font-bold transition-all cursor-pointer flex items-center justify-center gap-1.5 ${
                  idx === 0
                    ? "bg-white/10 text-amber-400 border border-amber-500/30 shadow-sm"
                    : "text-white/50 hover:text-white/80 hover:bg-white/[0.04] border border-transparent"
                }`}
                data-mix-id={mix.id}
                data-mix-data={JSON.stringify(mix)}
              >
                <img
                  src={mix.image}
                  alt={mix.name}
                  class="w-3.5 h-3.5 object-contain [image-rendering:pixelated]"
                />
                <span>{mix.name}</span>
              </button>
            ))
          }
        </div>
      </div>

      <!-- Contenido en 2 Columnas: Izquierda (md:col-span-8) = Desglose de Costos, Derecha (md:col-span-4) = Minijuego Compacto -->
      <div class="p-3.5 sm:p-4">
        <div class="grid grid-cols-1 md:grid-cols-12 gap-3.5">
          <!-- Columna Izquierda: Desglose de Inversión, Retorno y Costo Residual (md:col-span-8) -->
          <div class="md:col-span-8 flex flex-col gap-2.5">
            <div class="bg-black/40 border border-white/10 rounded-xl p-3 flex flex-col gap-2.5">
              <!-- Sección 1: Costo Total Invertido -->
              <div class="flex flex-col gap-1.5">
                <span class="text-[10px] font-mono uppercase tracking-wider text-terminal-muted font-bold">
                  {t("sfl.constants.cave.investedCosts")}
                </span>

                <div class="bg-black/30 border border-white/5 rounded-lg p-2 flex flex-col gap-1 text-xs font-mono">
                  <!-- Palas requeridas -->
                  <div class="flex items-center justify-between">
                    <div class="flex items-center gap-1.5">
                      <img src="/img/sunflowerland/tools/sand_shovel.png" class="w-3.5 h-3.5 object-contain" alt="Sand Shovel" />
                      <span id="caveBatchShovelsText" class="text-white text-[11px]">25x Sand Shovel</span>
                    </div>
                    <div class="flex items-center gap-1 text-emerald-400 font-bold text-[11px]">
                      <img src="/img/sunflowerland/flower.jpg" class="w-3 h-3 rounded-full object-cover shrink-0" alt="FLOWER" />
                      <span id="caveBatchShovelsFlower">0.0000</span>
                    </div>
                  </div>

                  <!-- Requisito Estándar (para Mushroom Mix y Beetle Mix) -->
                  <div id="caveBatchReqStandardRow" class="flex items-center justify-between">
                    <div class="flex items-center gap-1.5 min-w-0">
                      <img id="caveBatchReqImg" src="/img/sunflowerland/Wood.png" class="w-3.5 h-3.5 object-contain shrink-0" alt="Requirement" />
                      <span id="caveBatchReqText" class="text-white text-[11px] truncate">10x Wood</span>
                    </div>
                    <div class="flex items-center gap-1 text-emerald-400 font-bold text-[11px] shrink-0">
                      <img src="/img/sunflowerland/flower.jpg" class="w-3 h-3 rounded-full object-cover shrink-0" alt="FLOWER" />
                      <span id="caveBatchReqFlower">0.0000</span>
                    </div>
                  </div>

                  <!-- Selector Custom Estilizado para Mud Mix (25 Cultivos) -->
                  <div id="caveCropSelectContainer" class="hidden relative">
                    <!-- Botón Trigger Custom -->
                    <button
                      type="button"
                      id="caveCropDropdownTrigger"
                      class="w-full py-1.5 px-2 rounded-lg bg-black/60 hover:bg-white/[0.04] border border-white/10 hover:border-amber-500/40 text-left flex items-center justify-between transition-all cursor-pointer group"
                    >
                      <div class="flex items-center gap-1.5 min-w-0">
                        <img
                          id="caveCropTriggerImg"
                          src="/img/sunflowerland/Sunflower.png"
                          class="w-4 h-4 object-contain shrink-0 [image-rendering:pixelated]"
                          alt=""
                        />
                        <span id="caveCropTriggerLabel" class="text-[11px] font-mono font-bold text-white truncate">
                          500x Sunflower
                        </span>
                        <span
                          id="caveCropTriggerBadge"
                          class="text-[8.5px] px-1 py-0.2 rounded font-mono font-bold bg-emerald-500/15 text-emerald-300 border border-emerald-500/30"
                        >
                          {t("sfl.constants.cave.optimalBadge")}
                        </span>
                      </div>
                      <div class="flex items-center gap-2 shrink-0">
                        <div class="flex items-center gap-1 font-mono text-[11px] font-bold text-emerald-400">
                          <img
                            src="/img/sunflowerland/flower.jpg"
                            class="w-3 h-3 rounded-full object-cover shrink-0"
                            alt="FLOWER"
                          />
                          <span id="caveCropTriggerFlower">0.0000</span>
                        </div>
                        <svg
                          id="caveCropTriggerArrow"
                          class="w-3.5 h-3.5 text-white/40 group-hover:text-white transition-transform duration-200"
                          xmlns="http://www.w3.org/2000/svg"
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="2.5"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        >
                          <polyline points="6 9 12 15 18 9"></polyline>
                        </svg>
                      </div>
                    </button>

                    <!-- Menú Flotante Desplegable con Lista Estilizada -->
                    <div
                      id="caveCropDropdownMenu"
                      class="hidden absolute left-0 right-0 top-full mt-1.5 p-1 bg-[#121214] border border-white/15 rounded-xl shadow-2xl z-[95] max-h-56 overflow-y-auto flex flex-col gap-0.5 backdrop-blur-md"
                    >
                      <!-- Cultivos inyectados dinámicamente con estética Leñador -->
                    </div>
                  </div>

                  <!-- Subtotal Inversión -->
                  <div class="border-t border-white/5 pt-1 mt-0.5 flex items-center justify-between font-bold">
                    <span class="text-terminal-secondary text-[10.5px]">Total Inversión:</span>
                    <div class="flex flex-col items-end leading-tight">
                      <div class="flex items-center gap-1 text-emerald-400 text-xs">
                        <img src="/img/sunflowerland/flower.jpg" class="w-3 h-3 rounded-full object-cover shrink-0" alt="FLOWER" />
                        <span id="caveTotalCostFlower">0.0000</span>
                      </div>
                      <span id="caveTotalCostUsd" class="text-[9.5px] text-white/50 font-normal">~$0.00</span>
                    </div>
                  </div>
                </div>
              </div>

              <!-- Sección 2: Ingreso Esperado por Escarabajos (P2P Odds) -->
              <div class="flex flex-col gap-1">
                <div class="flex items-center justify-between">
                  <span class="text-[10px] font-mono uppercase tracking-wider text-terminal-muted font-bold">
                    {t("sfl.constants.cave.beetleRevenue")}
                  </span>
                  <span id="caveBeetlesPerBatchBadge" class="text-[9px] font-mono text-cyan-400 font-semibold">2 Escarabajos / Lote</span>
                </div>

                <!-- Tabla de Odds de Escarabajos -->
                <div class="bg-black/30 border border-white/5 rounded-lg p-2 flex flex-col gap-0.5 text-[10.5px] font-mono">
                  <div class="grid grid-cols-4 gap-1 pb-1 border-b border-white/5 text-[9px] text-terminal-muted font-bold">
                    <span>Tipo</span>
                    <span class="text-center">Prob</span>
                    <span class="text-right">P2P Uni</span>
                    <span class="text-right">Exp</span>
                  </div>

                  <div id="caveBeetleOddsRows" class="flex flex-col gap-0.5">
                    <!-- Inyectado dinámicamente -->
                  </div>

                  <!-- Total Retorno Escarabajos -->
                  <div class="border-t border-white/5 pt-1 mt-0.5 flex items-center justify-between font-bold">
                    <span class="text-terminal-secondary text-[10.5px]">Retorno Escarabajos:</span>
                    <div class="flex flex-col items-end leading-tight">
                      <div class="flex items-center gap-1 text-cyan-400 text-xs">
                        <img src="/img/sunflowerland/flower.jpg" class="w-3 h-3 rounded-full object-cover shrink-0" alt="FLOWER" />
