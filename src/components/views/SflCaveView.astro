                  <!-- Estado del Balance -->
                  <div class="flex items-center justify-between text-xs font-mono pb-1 border-b border-white/10">
                    <div class="flex items-center gap-1.5">
                      <span id="caveBalanceLabel" class="text-terminal-secondary text-[11px]">{t("sfl.constants.cave.netLoss")}</span>
                      <span id="caveBalanceBadge" class="hidden px-1.5 py-0.2 text-[8.5px] font-bold rounded bg-emerald-500/20 text-emerald-400 border border-emerald-500/40 animate-pulse">¡PROFIT!</span>
                    </div>
                    <div id="caveBalanceContainer" class="flex items-center gap-1 font-bold text-amber-400">
                      <img src="/img/sunflowerland/flower.jpg" class="w-3 h-3 rounded-full object-cover shrink-0" alt="FLOWER" />
                      <span id="caveDeficitFlower">0.0000</span>
                      <span id="caveDeficitUsd" class="text-[9.5px] font-normal text-white/50 ml-0.5">~$0.0000</span>
                    </div>
                  </div>

                  <!-- Costo unitario por recurso no comerciable -->
                  <div class="grid grid-cols-2 gap-1.5">
                    <!-- 1 Wild Mushroom -->
                    <div class="relative bg-black/40 border border-white/5 rounded-lg p-1.5 flex flex-col items-center text-center overflow-hidden">
                      <span id="caveMushroomFreeBadge" class="hidden absolute top-1 right-1 px-1 py-0.2 text-[8px] font-bold rounded bg-emerald-500/25 text-emerald-300 border border-emerald-500/40">
