    });
    
    // Inputs Personalizados
    const presetValues = [1000, 5000, 10000];
    const customInputs = [document.getElementById('dashCustomHideXp'), document.getElementById('custom-hide-xp')].filter(Boolean);
    customInputs.forEach(input => {
      if (source === 'preset') {
        input.value = "";
      } else if (source === 'init') {
        if (limit === 0 || presetValues.includes(limit)) {
          input.value = "";
        } else {
          input.value = limit;
        }
      } else if (source === 'custom') {
        if (input !== triggerInput && document.activeElement !== input) {
          input.value = limit > 0 ? limit : "";
        }
      }
    });

    if (typeof updateSkillCalculator === "function") {
      updateSkillCalculator();
    }
    
    const searchInput = document.getElementById("searchInput");
    renderTable(searchInput ? searchInput.value : "");
    if (typeof saveState === "function") saveState();
  };
  
  let activeBuffs = new Set()
  let activeSkills = {} // Format: { "Skill Name": rank (1, 2 or 3) }
  window.manualSelectedDish = null;
  window.sflCustomCoinsPerFlower = null;
  window.sflCustomRodCost = null;
  window.sflCustomFishFlakeCost = null;
  window.sflCustomFishStickCost = null;
  window.sflCustomCrabStickCost = null;
  window.sflCustomFishOilCost = null;

  const CACHE_KEY = "sfl_cooking_state";
  const saveState = () => {
    // SflUserState gestiona los buffs y skills de forma independiente.
    // Aquí solo guardamos preferencias numéricas y filtros en localStorage para compatibilidad.
    if (window.SflUserState) {
      window.SflUserState.setPreferences({
        coinsPerFlower: window.sflCustomCoinsPerFlower,
        rodCost: window.sflCustomRodCost,
        customFishFlakeCost: window.sflCustomFishFlakeCost,
        customFishStickCost: window.sflCustomFishStickCost,
        customCrabStickCost: window.sflCustomCrabStickCost,
        customFishOilCost: window.sflCustomFishOilCost,
      });
    }

    const state = {
      activeBuffs: Array.from(activeBuffs),
      activeSkills: activeSkills,
      currentHideXpLimit: window.currentHideXpLimit,
      currentCategory: currentCategory,
      manualSelectedDish: window.manualSelectedDish || null,
      customCoins: window.sflCustomCoinsPerFlower !== null && window.sflCustomCoinsPerFlower !== undefined ? window.sflCustomCoinsPerFlower : null,
      customRod: window.sflCustomRodCost !== null && window.sflCustomRodCost !== undefined ? window.sflCustomRodCost : null,
      customFishFlake: window.sflCustomFishFlakeCost !== null && window.sflCustomFishFlakeCost !== undefined ? window.sflCustomFishFlakeCost : null,
      customFishStick: window.sflCustomFishStickCost !== null && window.sflCustomFishStickCost !== undefined ? window.sflCustomFishStickCost : null,
      customCrabStick: window.sflCustomCrabStickCost !== null && window.sflCustomCrabStickCost !== undefined ? window.sflCustomCrabStickCost : null,
      customFishOil: window.sflCustomFishOilCost !== null && window.sflCustomFishOilCost !== undefined ? window.sflCustomFishOilCost : null,
      boostFilter: document.querySelector('.filter-boost-btn.active')?.dataset?.filter || 'all',
      viewStyle: document.querySelector('.view-switch-btn.active')?.dataset?.action || 'detailed',
      skillStartLevel: document.getElementById('skillStartLevelRange')?.value || '1',
      skillLevel: document.getElementById('skillLevelRange')?.value || '100'
    };
    localStorage.setItem(CACHE_KEY, JSON.stringify(state));
  };


  const isTargetMatch = (item, target) => {
    if (target === "all") return true;
    if (target === "Cakes") return item.building === "Bakery" || item.name.includes("Cake");
    if (target === "Fermented Carrots") return item.name === "Fermented Carrots";
    if (target === "Cheese Recipes") return item.name.includes("Cheese") || item.ingredients.some(ing => ing.name.includes("Cheese"));
    if (target === "Fish") {
      const fishIngs = ['Anchovy', 'Butterflyfish', 'Blowfish', 'Clownfish', 'Seaweed', 'Squid', 'Red Snapper', 'Sunfish', 'Horse Mackerel', 'Tuna', 'Olive Flounder', 'Angelfish', 'Halibut', 'Surgeonfish', 'Napoleanfish', 'Zebra Turkeyfish', 'Ray', 'Hammerhead Shark', 'Great White Shark', 'Octopus', 'Mahi Mahi', 'Blue Marlin', 'Moray Eel', 'Crab', 'Starfish', 'Seahorse', 'Crab Stick', 'Fish Stick'];
      return item.building === "Fish" || item.name.includes("Fish") || item.ingredients.some(ing => fishIngs.includes(ing.name)) || ["Gumbo", "Chowder", "Steamed Red Snapper", "Surimi Rice Bowl"].includes(item.name);
    }
    if (target === "Honey Foods") {
      return item.ingredients.some(ing => ing.name === "Honey");
    }
    if (target === "Aged Fish") {
      return item.building === "Aging Shed" || item.name.startsWith("Aged ");
    }
    return false;
  };

  const isBuffActive = (buff) => {
    const name = buff.name;
    const id = buff.id ? String(buff.id) : null;
    if (buff.type === "skill") {
      return Boolean(activeSkills && activeSkills[name] && activeSkills[name] > 0);
    }
    if (buff.type === "collectible" || buff.type === "wearable" || buff.type === "shrine") {
      return Boolean(activeBuffs && (activeBuffs.has(name) || (id && activeBuffs.has(id))));
    }
    if (buff.type === "consumable" || buff.type === "other") {
      return Boolean(
        (activeSkills && activeSkills[name] && activeSkills[name] > 0) ||
        (activeBuffs && (activeBuffs.has(name) || (id && activeBuffs.has(id))))
      );
    }
    return false;
  };

  const doesBuffApplyToItem = (buff, item) => {
    const name = buff.name;
    const building = item.building || "";
    const isFishBuilding = building === "Fish";
    const isAgingBuilding = building === "Aging Shed" || item.name.startsWith("Aged ");
    const hasTime = parseTime(item.time) > 0;

    // 1. Buffs de reducción de tiempo de cocina tradicional
    if ([
      "Desert Gnome", "Time Warp Totem", "Super Totem", "Gourmet Hourglass", 
      "Faction Medallion", "Boar Shrine", "Legendary Shrine"
    ].includes(name)) {
      return !isFishBuilding && !isAgingBuilding && hasTime;
    }

    // 2. Oil
    if (name === "Oil") {
      return !isFishBuilding && !isAgingBuilding && ["Fire Pit", "Kitchen", "Bakery", "Deli"].includes(building);
    }

    // 3. Fast Feasts (Fire Pit y Kitchen con tiempo)
    if (name === "Fast Feasts") {
      return (building === "Fire Pit" || building === "Kitchen") && hasTime;
    }

    // 4. Swift Sizzle (Fire Pit con tiempo)
    if (name === "Swift Sizzle") {
      return building === "Fire Pit" && hasTime;
    }

    // 5. Turbo Fry (Kitchen con tiempo)
    if (name === "Turbo Fry") {
      return building === "Kitchen" && hasTime;
    }

    // 6. Frosted Cakes (Bakery o Cakes con tiempo)
    if (name === "Frosted Cakes") {
      return (building === "Bakery" || item.name.includes("Cake")) && hasTime;
    }

    // 7. Fry Frenzy (Deli con tiempo)
    if (name === "Fry Frenzy") {
      return building === "Deli" && hasTime;
    }

    // 8. Fiery Jackpot (Fire Pit)
    if (name === "Fiery Jackpot") {
      return building === "Fire Pit";
    }

    // 9. Juicy Boost (Smoothie Shack)
    if (name === "Juicy Boost") {
      return building === "Smoothie Shack";
    }

    // 10. Drive-Through Deli (Deli)
    if (name === "Drive-Through Deli") {
      return building === "Deli";
    }

    // 11. Speedy Aging (Aging Shed con tiempo)
    if (name === "Speedy Aging") {
      return isAgingBuilding && hasTime;
    }

    // 12. Double Nom (Cocina tradicional, no Aging Shed ni Fish crudo)
    if (name === "Double Nom") {
      return !isAgingBuilding && !isFishBuilding;
    }

    // 13. Fishy Feast, Luminous Anglerfish y Skill Shrimpy (Fish)
    if (name === "Fishy Feast" || name === "Luminous Anglerfish" || name === "Skill Shrimpy") {
      return isTargetMatch(item, "Fish");
    }

    // 14. Buzzworthy Treats (Honey Foods)
    if (name === "Buzzworthy Treats") {
      return isTargetMatch(item, "Honey Foods");
    }

    // 15. All-food XP buffs: VIP Pass, Blossom Beard, Faction Pet, Munching Mastery, Nom Nom
    if (["VIP Pass", "Blossom Beard", "Faction Pet", "Munching Mastery", "Nom Nom"].includes(name)) {
      return true;
    }

    // 16. Aging Prime buffs
    if (buff.effects && buff.effects.some(e => e.category === "aging_prime")) {
      return isAgingBuilding && Boolean(item.agedXp);
    }

    // 17. Genérico por MathEffects de Collectibles / Wearables
    if (buff.effects && buff.effects.length > 0) {
      return buff.effects.some(eff => {
        const target = eff.target || eff.target_food || "all";
        const cat = eff.category || "";
        if (cat === "cooking_time" || cat === "cooking_speed") {
          if (isFishBuilding || isAgingBuilding || !hasTime) return false;
        }
        return isTargetMatch(item, target);
      });
    }

    return false;
  };

  const getActiveBuffsForItem = (item) => {
    if (!item || typeof cookingBuffsCatalog === "undefined" || !cookingBuffsCatalog) return [];
    return cookingBuffsCatalog.filter(b => isBuffActive(b) && doesBuffApplyToItem(b, item));
  };

  const getBuffEffectDesc = (buff, item) => {
    const name = buff.name;
    const building = item ? item.building : "";

    // 1. Others & Consumables
    if (name === "VIP Pass") return "+10% XP";
    if (name === "Blossom Beard") return "+10% XP";
    if (name === "Luminous Anglerfish") return "+50% XP";
    if (name === "Desert Gnome") return "-10% tiempo";
    if (name === "Gourmet Hourglass") return "-50% tiempo";
    if (name === "Time Warp Totem") return "-50% tiempo";
    if (name === "Super Totem") return "-50% tiempo";
    if (name === "Faction Medallion") return "-25% tiempo";
    if (name === "Boar Shrine") return "-20% tiempo";
    if (name === "Legendary Shrine") return "-50% tiempo";

    // 2. Oil según edificio
    if (name === "Oil") {
      if (building === "Fire Pit") return "-20% tiempo";
      if (building === "Kitchen") return "-25% tiempo";
      if (building === "Bakery") return "-35% tiempo";
      if (building === "Deli") return "-40% tiempo";
      return "-20% a -40% tiempo";
    }

    // 3. Faction Pet (por rango)
    if (name === "Faction Pet") {
      const rank = activeSkills && activeSkills["Faction Pet"] ? activeSkills["Faction Pet"] : 1;
      const petLabels = ["+10% XP", "+20% XP", "+30% XP", "+50% XP"];
      return petLabels[rank - 1] || "+10% XP";
    }

    // 4. Skills con rangos o fijos
    if (name === "Speedy Aging") {
      const rank = activeSkills && activeSkills["Speedy Aging"] ? activeSkills["Speedy Aging"] : 1;
      const agingLabels = ["-10% tiempo", "-15% tiempo", "-20% tiempo"];
      return agingLabels[rank - 1] || "-10% tiempo";
    }
    if (name === "Drive-Through Deli") {
      const rank = activeSkills && activeSkills["Drive-Through Deli"] ? activeSkills["Drive-Through Deli"] : 1;
      const deliLabels = ["+15% XP", "+20% XP", "+25% XP"];
      return deliLabels[rank - 1] || "+15% XP";
    }
    if (name === "Munching Mastery") return "+5% XP";
    if (name === "Nom Nom") return "+10% XP";
    if (name === "Juicy Boost") return "+10% XP";
    if (name === "Double Nom") return "+100% XP (x2)";
    if (name === "Fiery Jackpot") return "+20% chance x2";
    if (name === "Fishy Feast") return "+20% XP";
    if (name === "Buzzworthy Treats") return "+10% XP";
    if (name === "Fast Feasts") return "-10% tiempo";
    if (name === "Frosted Cakes") return "-20% tiempo";
    if (name === "Swift Sizzle") return "-30% tiempo";
    if (name === "Turbo Fry") return "-40% tiempo";
    if (name === "Fry Frenzy") return "-50% tiempo";
    if (name === "Instant Gratification") return "Instantáneo";

    // 5. Collectibles & Wearables
    if (name === "Skill Shrimpy") return "+20% XP";
    if (name === "Grain Grinder") return "+20% XP";
    if (name === "Hungry Hare") return "+2x XP";
    if (name === "Swiss Whiskers") return "+20 XP";
    if (name === "Observatory") return "+5% XP";
    if (name === "Astrolabe") return "+10% XP";
    if (name === "Winged Vase") return "+50% XP";
    if (name === "Golden Spatula") return "+10% XP";
    if (name === "Luna's Hat") return "-50% tiempo";
    if (name === "Pan") return "+25% XP";
    if (name === "Master Chef's Cleaver") return "+10% XP";

    // 6. Genérico desde effects si los hay
    if (buff.effects && buff.effects.length > 0) {
      const eff = buff.effects[0];
      if (eff.calc) {
        if (eff.mathematics_operation === "multiply" || eff.mathematics_operation === "speed_multiplier") {
          if (eff.category === "cooking_time" && eff.calc < 1) {
            return `-${Math.round((1 - eff.calc) * 100)}% tiempo`;
          }
          if (eff.calc > 1) {
            return `+${Math.round((eff.calc - 1) * 100)}%`;
          }
        }
        if (eff.mathematics_operation === "add") {
          return `+${eff.calc} XP`;
        }
      }
    }

    return buff.description || "";
  };

  const renderBuffSquare = (buff, item, size = "md", idx = 0) => {
    const desc = getBuffEffectDesc(buff, item);
    const titleText = desc ? `${buff.name}: ${desc}` : buff.name;
    const isSkillNoStd = Boolean(buff.type === "skill" && buff.image && !buff.image.startsWith("/img/sunflowerland/skills/"));
    const raySize = size === "sm" ? "w-2 h-2" : "w-2.5 h-2.5";
    const overlayRayHtml = isSkillNoStd
      ? `<img src="/img/sunflowerland/123/energy.png" alt="Skill" class="absolute -top-1 -left-1 ${raySize} object-contain [image-rendering:pixelated] drop-shadow pointer-events-none z-10" />`
      : "";

    const containerSize = size === "sm" ? "w-4 h-4 sm:w-4.5 sm:h-4.5" : "w-5 h-5 sm:w-6 sm:h-6";

    return `
      <div
        class="buff-square shrink-0 ${containerSize} rounded bg-[#161618] border border-white/10 p-0.5 flex items-center justify-center cursor-help"
        style="z-index: ${idx + 1};"
        title="${titleText}"
      >
        <img
          src="${buff.image}"
          alt="${buff.name}"
          class="w-full h-full object-contain [image-rendering:pixelated] pointer-events-none"
          loading="lazy"
          decoding="async"
          onerror="window.handleImgError(this)"
        />
        ${overlayRayHtml}
      </div>
    `;
  };

  const getCalculatedXp = (item) => {
    let baseExp = item.xp;
    if (item.building === "Aging Shed" && item.agedXp && item.primeAgedXp) {
      let primeChance = 0.10;
      activeBuffs.forEach(id => {
        const buff = sflBuffs[id];
        if (buff) {
          [buff.mathematics_1, buff.mathematics_2, buff.mathematics_3, buff.mathematics_4, buff.mathematics_5, buff.mathematics_6].forEach(math => {
            if (math && math.category === "aging_prime" && math.calc) {
              primeChance += (math.calc / 100);
            }
          });
        }
      });
      primeChance = Math.min(1, Math.max(0, primeChance));
      baseExp = Math.round(item.agedXp * (1 - primeChance) + item.primeAgedXp * primeChance);
    }

    let boostedExp = baseExp;
    let additions = 0;
    
    activeBuffs.forEach(id => {
      const buff = sflBuffs[id];
      if (buff) {
        [buff.mathematics_1, buff.mathematics_2, buff.mathematics_3, buff.mathematics_4, buff.mathematics_5, buff.mathematics_6].forEach(math => {
          if (math && math.category === "bumpkin_xp" && isTargetMatch(item, math.target_food || math.target || "all")) {
            if (math.mathematics_operation === "multiply") {
              boostedExp *= math.calc;
            } else if (math.mathematics_operation === "add") {
              additions += math.calc;
            }
          }
        });
      }
    });
    
    // Helper para verificar si un buff/skill/consumible/other está activo en activeSkills o activeBuffs
    const isBuffOrSkillActive = (name, id) => {
      return Boolean(
        (activeSkills && activeSkills[name] && activeSkills[name] > 0) ||
        (activeBuffs && (activeBuffs.has(name) || (id && activeBuffs.has(String(id)))))
      );
    };

    // Others XP Buffs (VIP Pass, Blossom Beard, Luminous Anglerfish, Faction Pet)
    if (isBuffOrSkillActive("VIP Pass", 9001)) {
      boostedExp *= 1.1;
    }
    if (isBuffOrSkillActive("Blossom Beard", 9002)) {
      boostedExp *= 1.1;
    }
    if (isBuffOrSkillActive("Luminous Anglerfish", 9004) && isTargetMatch(item, "Fish")) {
      boostedExp *= 1.5;
    }
    if (activeSkills && activeSkills["Faction Pet"]) {
      const petBonus = activeSkills["Faction Pet"] === 1 ? 0.1 : activeSkills["Faction Pet"] === 2 ? 0.2 : activeSkills["Faction Pet"] === 3 ? 0.3 : 0.5;
      boostedExp *= (1 + petBonus);
    }

    // Skills Logic for XP (Multiplicative compounding according to SFL engine)
    if (activeSkills) {
      Object.entries(activeSkills).forEach(([skillName, rank]) => {
        if (!rank || rank <= 0) return;
        if (["VIP Pass", "Blossom Beard", "Luminous Anglerfish", "Faction Pet"].includes(skillName)) return;

        const skill = sflSkills[skillName] || sflOthers[skillName] || sflConsumables[skillName];
        if (!skill) return;
        const math1 = skill.mathematics_1?.calc_by_rank?.[`rank_${rank}`] ?? skill.mathematics_1?.calc;
        if (math1 === undefined || math1 === null) return;
        
        // Munching Mastery (+5% XP)
        if (skillName === "Munching Mastery") {
          boostedExp *= (1 + math1);
        }
        // Juicy Boost (+10% XP for Smoothie Shack)
        if (skillName === "Juicy Boost" && item.building === "Smoothie Shack") {
          boostedExp *= (1 + math1);
        }
        // Double Nom (+1 food = 2x XP essentially) - Solo para cocina, NO para Aging Shed ni Fish crudo
        if (skillName === "Double Nom" && item.building !== "Aging Shed" && item.building !== "Fish") {
          boostedExp *= (1 + math1);
        }
        // Fiery Jackpot (+20% chance of +1 food in Fire Pit)
        if (skillName === "Fiery Jackpot" && item.building === "Fire Pit") {
          boostedExp *= (1 + (math1 / 100));
        }
        // Fishy Feast (+20% XP for Fish)
        if (skillName === "Fishy Feast" && isTargetMatch(item, "Fish")) {
          boostedExp *= (1 + math1);
        }
        // Buzzworthy Treats (+10% XP for Honey Foods)
        if (skillName === "Buzzworthy Treats" && isTargetMatch(item, "Honey Foods")) {
          boostedExp *= (1 + math1);
        }
        // Drive-Through Deli (+15%/+20%/+25% XP for Deli)
        if (skillName === "Drive-Through Deli" && item.building === "Deli") {
          boostedExp *= (1 + math1);
        }
      });
    }
    
    return boostedExp + additions;
  };

  const getCalculatedTime = (item) => {
    let timeSeconds = parseTime(item.time);
    if (timeSeconds === 0) return 0;
    
    // Si el ítem es de Aging Shed, los aceleradores de cocina NO aplican!
    if (item.building === "Aging Shed") {
      let agingMultiplier = 1;
      if (activeSkills && activeSkills["Speedy Aging"]) {
        const rank = activeSkills["Speedy Aging"];
        const ranks = [0.9, 0.85, 0.8];
        agingMultiplier *= (ranks[rank - 1] || 0.9);
      }
      return timeSeconds * agingMultiplier;
    }

    let timeMultiplier = 1;
    
    // Helper para verificar si un buff/skill/consumible/other está activo en activeSkills o activeBuffs
    const isTimeBuffActive = (name, id) => {
      return Boolean(
        (activeSkills && activeSkills[name] && activeSkills[name] > 0) ||
        (activeBuffs && (activeBuffs.has(name) || (id && activeBuffs.has(String(id)))))
      );
    };

    // Reducciones de tiempo de Consumibles, Otros y Santuarios
    if (isTimeBuffActive("Desert Gnome", 9003)) { timeMultiplier *= 0.9; }
    if (isTimeBuffActive("Time Warp Totem", 9015) || isTimeBuffActive("Super Totem", 9016)) { timeMultiplier *= 0.5; }
    if (isTimeBuffActive("Gourmet Hourglass", 9007)) { timeMultiplier *= 0.5; }
    if (isTimeBuffActive("Faction Medallion", 9008)) { timeMultiplier *= 0.75; }
    if (isTimeBuffActive("Boar Shrine", 9018)) { timeMultiplier *= 0.8; }
    if (isTimeBuffActive("Legendary Shrine", 9019)) { timeMultiplier *= 0.5; }

    // Fast Feasts (Fire Pit and Kitchen)
    if (activeSkills && activeSkills["Fast Feasts"] && (item.building === "Fire Pit" || item.building === "Kitchen")) {
      timeMultiplier *= 0.9;
    }
    // Frosted Cakes (Bakery / Cakes)
    if (activeSkills && activeSkills["Frosted Cakes"] && (item.building === "Bakery" || item.name.includes("Cake"))) {
      timeMultiplier *= 0.8;
    }
    // Swift Sizzle (Fire Pit con oil)
    if (activeSkills && activeSkills["Swift Sizzle"] && item.building === "Fire Pit") {
      timeMultiplier *= 0.7;
    }
    // Turbo Fry (Kitchen con oil)
    if (activeSkills && activeSkills["Turbo Fry"] && item.building === "Kitchen") {
      timeMultiplier *= 0.6;
    }
    // Fry Frenzy (Deli con oil)
    if (activeSkills && activeSkills["Fry Frenzy"] && item.building === "Deli") {
      timeMultiplier *= 0.5;
    }

    // Boost Base de Oil en edificios (cuando Oil está activo y no se sobreescribe por una skill superior)
    const hasOil = Boolean(activeSkills && activeSkills["Oil"]);
    if (hasOil) {
      if (item.building === "Fire Pit" && !(activeSkills && activeSkills["Swift Sizzle"])) {
        timeMultiplier *= 0.8; // -20% tiempo base Fire Pit con Oil
      } else if (item.building === "Kitchen" && !(activeSkills && activeSkills["Turbo Fry"])) {
        timeMultiplier *= 0.75; // -25% tiempo base Kitchen con Oil
      } else if (item.building === "Bakery") {
        timeMultiplier *= 0.65; // -35% tiempo base Bakery con Oil
      } else if (item.building === "Deli" && !(activeSkills && activeSkills["Fry Frenzy"])) {
        timeMultiplier *= 0.6; // -40% tiempo base Deli con Oil
      }
    }
      activeBuffs.forEach(id => {
        const buff = sflBuffs[id];
        if (buff) {
          [buff.mathematics_1, buff.mathematics_2, buff.mathematics_3, buff.mathematics_4, buff.mathematics_5, buff.mathematics_6].forEach(math => {
            if (!math) return;
            if (math.category === "cooking_time" && isTargetMatch(item, math.target_food || math.target || "all")) {
              if (math.mathematics_operation === "multiply") {
                timeMultiplier *= math.calc;
              }
            }
            if (math.category === "cooking_speed" && isTargetMatch(item, math.target || "all")) {
              if (math.mathematics_operation === "speed_multiplier" && math.calc > 0) {
                timeMultiplier *= (1 / math.calc);
              }
            }
          });
        }
      });
    
    return timeSeconds * timeMultiplier;
  };

  const parseTime = (timeStr) => {
    if (!timeStr) return 0
    let days = 0
    let tStr = timeStr
    if (timeStr.includes("d ")) {
      const parts = timeStr.split("d ")
      days = parseInt(parts[0])
      tStr = parts[1]
    }
    const [h, m, s] = tStr.split(":").map(Number)
    return days * 86400 + h * 3600 + m * 60 + (s || 0)
  }

  const formatSeconds = (totalSeconds) => {
    if (!totalSeconds) return "00:00:00";
    let days = Math.floor(totalSeconds / 86400);
    let remaining = totalSeconds % 86400;
    let h = Math.floor(remaining / 3600);
    remaining %= 3600;
    let m = Math.floor(remaining / 60);
    let s = Math.floor(remaining % 60);
    
    let timeStr = `${h.toString().padStart(2, '0')}:${m.toString().padStart(2, '0')}:${s.toString().padStart(2, '0')}`;
    return days > 0 ? `${days}d ${timeStr}` : timeStr;
  }

  window.handleCategory = (category) => {
    currentCategory = category

    document.querySelectorAll(".category-btn").forEach((btn) => {
      if (btn.dataset.category === category) {
        btn.className =
          "category-btn active snap-start px-3.5 py-1.5 bg-emerald-500/20 text-emerald-400 border border-emerald-500/30 rounded-xl text-xs font-mono font-bold uppercase tracking-wider hover:bg-emerald-500/30 transition-colors whitespace-nowrap shrink-0 shadow-sm shadow-emerald-950/40"
      } else {
        btn.className =
          "category-btn snap-start px-3.5 py-1.5 bg-white/5 text-white/50 border border-white/10 rounded-xl text-xs font-mono font-medium uppercase tracking-wider hover:bg-white/10 hover:text-white transition-colors whitespace-nowrap shrink-0"
      }
    })

    renderTable(searchInput ? searchInput.value : "")
    if (typeof saveState === "function") saveState();
  }

  window.handleSort = (column) => {
    if (window.currentSort.column === column) {
      if (window.currentSort.direction === "none") window.currentSort.direction = "desc"
      else if (window.currentSort.direction === "desc") window.currentSort.direction = "asc"
      else window.currentSort.direction = "none"
    } else {
      window.currentSort.column = column
      window.currentSort.direction = "desc"
    }

    document.querySelectorAll(".sort-icon").forEach((icon) => {
      icon.innerHTML = "↕"
      icon.classList.remove("opacity-100", "text-emerald-500")
      icon.classList.add("opacity-0", "group-hover:opacity-50")
    })
    
    document.querySelectorAll(".mobile-sort-btn").forEach((btn) => {
      btn.className = "mobile-sort-btn px-3 py-1.5 bg-black/40 border border-white/10 rounded-lg text-[10px] font-semibold text-white/60 hover:text-white hover:bg-white/10 transition-all whitespace-nowrap flex items-center gap-1.5";
    })

    if (window.currentSort.direction !== "none") {
      document.querySelectorAll(`.sort-icon[data-col="${column}"]`).forEach((activeIcon) => {
        activeIcon.innerHTML = window.currentSort.direction === "desc" ? "↓" : "↑"
        activeIcon.classList.remove("opacity-0", "group-hover:opacity-50")
        activeIcon.classList.add("opacity-100", "text-emerald-500")
      })
      
      const activeMobileBtn = document.querySelector(`.mobile-sort-btn[data-col="${column}"]`);
      if (activeMobileBtn) {
        activeMobileBtn.className = "mobile-sort-btn px-3 py-1.5 bg-emerald-500/10 border border-emerald-500/30 rounded-lg text-[10px] font-semibold text-emerald-400 hover:bg-emerald-500/20 transition-all whitespace-nowrap flex items-center gap-1.5";
      }
    }

    renderTable(searchInput ? searchInput.value : "")
  }

  const formatNumber = (num, decimals = 2) => {
    if (num === undefined || num === null || isNaN(num)) return "0"
    if (num > 0 && num < 0.0001) return num.toExponential(2)
    return new Intl.NumberFormat("en-US", {
      minimumFractionDigits: 0,
      maximumFractionDigits: decimals,
    }).format(num)
  }

  // Caché de costo de captura de peces para evitar recálculos redundantes en renderizado y filtros
  const fishCatchCostCache = new Map();
  window.clearFishCostCache = () => fishCatchCostCache.clear();

  const calculateRecipeCost = (ingredients, visited = new Set(), isTopLevel = true, isAgingShed = false, isFish = false) => {
    let total = 0
    let missing = false
    
    const fishNames = [
      "Anchovy", "Angelfish", "Barred Knifejaw", "Blowfish", "Blue Marlin", "Butterflyfish", 
      "Clownfish", "Cobia", "Coelacanth", "Football fish", "Halibut", "Hammerhead shark", 
      "Horse Mackerel", "Mahi Mahi", "Napoleanfish", "Oarfish", "Olive Flounder", "Parrotfish", 
      "Phantom Barracuda", "Porgy", "Ray", "Red Snapper", "Rock Blackfish", "Saw Shark", 
      "Sea Bass", "Sea Horse", "Squid", "Sunfish", "Surgeonfish", "Tilapia", "Trout", 
      "Tuna", "Walleye", "Weakfish", "Whale Shark", "White Shark", "Zebra Turkeyfish",
      "Crystal Shrimp", "Deep Sea Pig", "Deep Sea Slug", "Dollocaris", "Garden Eel", 
      "Giant Isopod", "Gilded Swordfish", "Longhorn Cowfish", "Nautilus", "Twilight Anglerfish",
      "Octopus", "Moray Eel"
    ];

    for (const ing of ingredients) {
      const isKnownFish = fishNames.includes(ing.name) || (window.SflConstants && typeof window.SflConstants.isFish === "function" && window.SflConstants.isFish(ing.name));
      const marketPrice = (priceDict[ing.name] !== undefined)
        ? priceDict[ing.name]
        : (window.SflMarket && typeof window.SflMarket.getItemPrice === "function" ? window.SflMarket.getItemPrice(ing.name) : 0);

      if (isKnownFish) {
        let fishCost = window.sflRodCost || 0;
        if (fishCatchCostCache.has(ing.name)) {
          fishCost = fishCatchCostCache.get(ing.name);
        } else if (window.SflPrices && typeof window.SflPrices.getUnitCost === "function") {
          const costObj = window.SflPrices.getUnitCost(ing.name, window.sflFlowerPrice);
          if (costObj && costObj.flower > 0) {
            fishCost = costObj.flower;
          }
          fishCatchCostCache.set(ing.name, fishCost);
        } else if (window.SflConstants && typeof window.SflConstants.calculateFishCatchCost === "function") {
          const catchObj = window.SflConstants.calculateFishCatchCost(ing.name, {
            coinsPerFlower: window.sflBestCoinsPerFlower || 1330,
            flowerPriceUsd: window.sflFlowerPrice || 0.0854,
            resolveBasePrice: (n) => priceDict[n] || (window.SflMarket ? window.SflMarket.getItemPrice(n) : 0),
          });
          if (catchObj && catchObj.totalFlower > 0) {
            fishCost = catchObj.totalFlower;
          }
          fishCatchCostCache.set(ing.name, fishCost);
        }
        total += fishCost * ing.amount;
      } else if (marketPrice > 0) {
        total += marketPrice * ing.amount
      } else if (ing.name.startsWith("Aged ") && window.SflPrices && typeof window.SflPrices.getUnitCost === "function") {
        let agedCost = 0;
        if (fishCatchCostCache.has(ing.name)) {
          agedCost = fishCatchCostCache.get(ing.name);
        } else {
          const costObj = window.SflPrices.getUnitCost(ing.name, window.sflFlowerPrice);
          if (costObj && costObj.flower > 0) {
            agedCost = costObj.flower;
          }
          fishCatchCostCache.set(ing.name, agedCost);
        }
        total += agedCost * ing.amount;
      } else if (ing.name === "Fish Flake") {
        const flakeCost = (window.sflCustomFishFlakeCost !== null && window.sflCustomFishFlakeCost !== undefined && window.sflCustomFishFlakeCost >= 0)
          ? window.sflCustomFishFlakeCost
          : (window.sflAutoFishFlakeCost || (window.SflPrices ? window.SflPrices.getUnitCost("Fish Flake").flower : 0));
        total += flakeCost * ing.amount;
      } else if (ing.name === "Fish Stick") {
        const stickCost = (window.sflCustomFishStickCost !== null && window.sflCustomFishStickCost !== undefined && window.sflCustomFishStickCost >= 0)
          ? window.sflCustomFishStickCost
          : (window.sflAutoFishStickCost || (window.SflPrices ? window.SflPrices.getUnitCost("Fish Stick").flower : 0));
        total += stickCost * ing.amount;
      } else if (ing.name === "Fish Oil") {
        const oilCost = (window.sflCustomFishOilCost !== null && window.sflCustomFishOilCost !== undefined && window.sflCustomFishOilCost >= 0)
          ? window.sflCustomFishOilCost
          : (window.sflAutoFishOilCost || (window.SflPrices ? window.SflPrices.getUnitCost("Fish Oil").flower : 0));
        total += oilCost * ing.amount;
      } else if (ing.name === "Crab Stick") {
        const crabCost = (window.sflCustomCrabStickCost !== null && window.sflCustomCrabStickCost !== undefined && window.sflCustomCrabStickCost >= 0)
          ? window.sflCustomCrabStickCost
          : (window.sflAutoCrabStickCost || (window.SflPrices ? window.SflPrices.getUnitCost("Crab Stick").flower : 0));
        total += crabCost * ing.amount;
      } else {
        // Buscar si el ingrediente es en realidad otra receta
        const subRecipe = recipesData.find((r) => r.name === ing.name)
        if (subRecipe && !visited.has(ing.name)) {
          visited.add(ing.name)
          const subCost = calculateRecipeCost(subRecipe.ingredients, visited, false)
          if (subCost.missing) missing = true
          total += subCost.total * ing.amount
        } else if (window.SflPrices && typeof window.SflPrices.getUnitCost === "function") {
          const costObj = window.SflPrices.getUnitCost(ing.name, window.sflFlowerPrice);
          if (costObj && costObj.flower > 0) {
            total += costObj.flower * ing.amount;
          } else {
            missing = true;
          }
        } else {
          missing = true
        }
      }
    }
    
    // Skills Logic for Cost (Debuffs) - Solo para cocina, NO para Aging Shed ni Fish crudo
    let costMultiplier = 1;
    if (isTopLevel && !isAgingShed && !isFish) {
      activeSkills && Object.entries(activeSkills).forEach(([skillName, rank]) => {
        const skill = sflSkills[skillName] || sflOthers[skillName] || sflConsumables[skillName];
        if (!skill) return;
        
        // Double Nom Debuff (2x ingredients)
        if (skillName === "Double Nom" && skill.mathematics_2) {
          costMultiplier *= skill.mathematics_2.calc_by_rank[`rank_${rank}`];
        }
        // Instant Gratification Debuff (2x ingredients)
        if (skillName === "Instant Gratification") {
          // Assume default x2 since rank logic is complex for this one
          costMultiplier *= 2; 
        }
      });
    }
    
    return { total: total * costMultiplier, missing, baseTotal: total }
  }

  renderTable = (searchTerm = "") => {
    window.renderTable = renderTable;
    let doubleNomMultiplier = 1;
    if (activeSkills && activeSkills["Double Nom"]) {
      const rank = activeSkills["Double Nom"];
      const math1 = sflSkills["Double Nom"]?.mathematics_1?.calc_by_rank[`rank_${rank}`] || 0;
      doubleNomMultiplier = 1 + math1;
    }

    const term = searchTerm.toLowerCase();
    const prepared = [];

    for (const item of recipesData) {
      const nameMatch = item.name.toLowerCase().includes(term);
      const isRaw = item.building === "Fish";
      let searchIngs = item.ingredients;
      if (isRaw) {
        const cap = getFishCaptureBreakdown(item.name);
        if (cap) {
          const capNames = [cap.rod?.name, cap.bait?.name, cap.chum?.name].filter(Boolean);
          searchIngs = capNames.map((n) => ({ name: n }));
        }
      }
      const ingMatch = searchIngs.some((ing) =>
        ing.name.toLowerCase().includes(term)
      );
      if (!nameMatch && !ingMatch) continue;
      if (currentCategory !== "all" && item.building !== currentCategory) continue;

      const finalXp = getCalculatedXp(item);
      if (window.currentHideXpLimit > 0 && finalXp < window.currentHideXpLimit) continue;

      const isAgingDish = item.building === "Aging Shed";
      const isFishDish = item.building === "Fish";
      const costObj = calculateRecipeCost(item.ingredients, new Set(), true, isAgingDish, isFishDish);
      const timeSeconds = getCalculatedTime(item);
      const xpPerSfl = costObj.total > 0 ? finalXp / costObj.total : 0;
      const xpPerDay = timeSeconds > 0 ? (86400 / timeSeconds) * finalXp : 0;

      prepared.push({
        item,
        finalXp,
        costObj,
        timeSeconds,
        xpPerSfl,
        xpPerDay
      });
    }

    if (
      window.currentSort &&
      window.currentSort.column &&
      window.currentSort.direction !== "none"
    ) {
      const { column, direction } = window.currentSort;
      prepared.sort((a, b) => {
        let valA, valB;
        if (column === "name") {
          valA = a.item.name.toLowerCase();
          valB = b.item.name.toLowerCase();
        } else if (column === "xp") {
          valA = a.finalXp;
          valB = b.finalXp;
        } else if (column === "cost") {
          valA = a.costObj.total;
          valB = b.costObj.total;
        } else if (column === "xpsfl") {
          valA = a.xpPerSfl;
          valB = b.xpPerSfl;
        } else if (column === "xpday") {
          valA = a.xpPerDay;
          valB = b.xpPerDay;
        }

        if (valA < valB) return direction === "asc" ? -1 : 1;
        if (valA > valB) return direction === "asc" ? 1 : -1;
        return 0;
      });
    }

    tableBody.innerHTML = "";

    if (prepared.length === 0) {
      tableBody.innerHTML = `<div class="py-8 text-center text-terminal-muted text-sm">${tEmpty}</div>`;
      return;
    }

    const rowsHtml = prepared.map(({ item, finalXp, costObj, timeSeconds, xpPerSfl, xpPerDay }) => {
      // Format visual time
      const displayTime = formatSeconds(timeSeconds);
      const isAging = item.building === "Aging Shed" || item.name.startsWith("Aged ");
      const isRawFish = item.building === "Fish";
      const isCookingDish = !isAging && !isRawFish;
      const effectiveDoubleNom = isCookingDish ? doubleNomMultiplier : 1;
      const displayName = effectiveDoubleNom > 1 ? `${item.name} x${effectiveDoubleNom}` : item.name;
      const dishImg = item.image || `/img/sunflowerland/food/${item.name}.png`;
      const rawFishName = isAging ? item.name.replace(/^Aged\s+/i, "") : null;
      const rawFishImg = isAging ? (item.image || `/img/sunflowerland/fish/${rawFishName}.png`) : null;

      let effectiveIngredients = item.ingredients;
      let rawFishYield = 1.0;
      let fishingBuffsBarHtml = "";

      if (isRawFish) {
        const yieldAndBuffs = getFishYieldAndBuffs(item.name);
        rawFishYield = yieldAndBuffs.fishYield;
        fishingBuffsBarHtml = renderFishingBuffsBar(yieldAndBuffs, "pt-1 mt-1 border-t border-white/[0.04]");

        const capture = getFishCaptureBreakdown(item.name);
        if (capture) {
          const captureList = [];
          if (capture.rod) {
            captureList.push({
              name: capture.rod.name,
              amount: capture.rod.amount || 1,
              image: capture.rod.img,
            });
          }
          if (capture.bait) {
            captureList.push({
              name: capture.bait.name,
              amount: capture.bait.amount || 1,
              image: capture.bait.img,
            });
          }
          if (capture.chum) {
            captureList.push({
              name: capture.chum.name,
              amount: capture.chum.amount || 1,
              image: capture.chum.img,
            });
          }
          if (captureList.length > 0) {
            effectiveIngredients = captureList;
          }
        }
      }

      const ingredientsHtml = effectiveIngredients
        .map((ing) => {
          const totalAmount = ing.amount * effectiveDoubleNom;
          const priceInfo = getIngredientPriceInfo(ing.name, totalAmount);
          const imgSrc = getIngredientImg(ing);
          const safeName = ing.name.replace(/'/g, "\\'");

          // Si es pez crudo, el costo de cada ingrediente por unidad producida se divide entre rawFishYield
          const displayFlower = isRawFish && rawFishYield > 1 ? priceInfo.totalFlower / rawFishYield : priceInfo.totalFlower;
          const displayUsd = isRawFish && rawFishYield > 1 ? priceInfo.totalUsd / rawFishYield : priceInfo.totalUsd;

          let captureHtml = "";
          let ingFishYield = 1.0;
          let isSubRecipe = false;
          let subRecipeObj = null;

          if (!isRawFish && priceInfo.isFishOrCrust) {
            const ingYieldAndBuffs = getFishYieldAndBuffs(ing.name);
            ingFishYield = ingYieldAndBuffs.fishYield || 1.0;
            const ingBuffsHtml = renderFishingBuffsBar(ingYieldAndBuffs, "pl-5.5 py-0.5");

            const capture = getFishCaptureBreakdown(ing.name);
            const parts = [];
            if (capture) {
              if (capture.rod) {
                parts.push(`
                  <span class="inline-flex items-center gap-1" title="${capture.rod.name}">
                    <img src="${capture.rod.img}" alt="${capture.rod.name}" class="w-3.5 h-3.5 object-contain [image-rendering:pixelated]" loading="lazy" />
                    <span class="text-[10px] text-white/70 font-mono">${capture.rod.name}</span>
                  </span>
                `);
              }
              if (capture.bait) {
                parts.push(`
                  <span class="inline-flex items-center gap-1" title="${capture.bait.name}">
                    <img src="${capture.bait.img}" alt="${capture.bait.name}" class="w-3.5 h-3.5 object-contain [image-rendering:pixelated]" loading="lazy" />
                    <span class="text-[10px] text-white/70 font-mono">${capture.bait.name}</span>
                  </span>
                `);
              }
              if (capture.chum) {
                parts.push(`
                  <span class="inline-flex items-center gap-1" title="${capture.chum.name} x${capture.chum.amount}">
                    <img src="${capture.chum.img}" alt="${capture.chum.name}" class="w-3.5 h-3.5 object-contain [image-rendering:pixelated]" loading="lazy" />
                    <span class="text-[10px] text-white/70 font-mono">${capture.chum.amount > 1 ? `${capture.chum.amount} ` : ""}${capture.chum.name}</span>
                  </span>
                `);
              }
            }

            if (parts.length > 0 || ingBuffsHtml) {
              captureHtml = `
                ${parts.length > 0 ? `
                  <div class="flex items-center gap-1.5 text-[10px] font-mono text-terminal-muted/80 pl-5.5 py-0.5 flex-wrap">
                    ${parts.join('<span class="text-white/30 text-[10px] font-bold">+</span>')}
                  </div>
                ` : ''}
                ${ingBuffsHtml}
              `;
            }
          } else if (!isRawFish) {
            subRecipeObj = recipesData.find((r) => r.name === ing.name);
            if (subRecipeObj && subRecipeObj.ingredients && subRecipeObj.ingredients.length > 0) {
              isSubRecipe = true;
              const parts = [];
              const fishBuffsList = [];

              subRecipeObj.ingredients.forEach((subIng) => {
                const scaledAmount = subIng.amount * totalAmount;
                const subImg = getIngredientImg(subIng);
                const isSubFish = isFishOrCrust(subIng.name);

                parts.push(`
                  <span class="inline-flex items-center gap-1" title="${subIng.name} x${scaledAmount}">
                    <img src="${subImg}" alt="${subIng.name}" class="w-3.5 h-3.5 object-contain [image-rendering:pixelated]" loading="lazy" />
                    <span class="text-[10px] text-white/70 font-mono">${scaledAmount > 1 ? `${scaledAmount} ` : ""}${subIng.name}</span>
                  </span>
                `);

                if (isSubFish) {
                  const subYieldAndBuffs = getFishYieldAndBuffs(subIng.name);
                  const subBuffsHtml = renderFishingBuffsBar(subYieldAndBuffs, "pl-5.5 py-0.5");
                  if (subBuffsHtml) fishBuffsList.push(subBuffsHtml);
                }
              });

              if (parts.length > 0) {
                captureHtml = `
                  <div class="flex items-center gap-1.5 text-[10px] font-mono text-terminal-muted/80 pl-5.5 py-0.5 flex-wrap">
                    ${parts.join('<span class="text-white/30 text-[10px] font-bold">+</span>')}
                  </div>
                  ${fishBuffsList.join('')}
                `;
              }
            }
          }

          const currentMode = window.ingredientCurrencyMode || "flower";
          const formattedPrice = formatPriceDisplay(displayFlower, displayUsd, currentMode);

          return `
            <div class="flex flex-col py-0.5">
              <div class="flex items-center gap-1.5 flex-wrap">
                <img src="${imgSrc}" alt="${safeName}" class="w-4 h-4 object-contain drop-shadow-sm shrink-0" width="16" height="16" loading="lazy" decoding="async" onerror="window.handleImgError(this)" />
                <span class="text-[11px] lg:text-xs text-white/80">${ing.name} <span class="text-white/40 font-mono ml-0.5">x${totalAmount}</span></span>
                <button
                  type="button"
                  class="ingredient-price-btn inline-flex items-center gap-1 font-mono text-[10px] lg:text-[11px] text-white/70 hover:text-emerald-400 cursor-pointer transition-colors select-none ml-1 bg-transparent border-0 p-0"
                  data-flower="${displayFlower}"
                  data-usd="${displayUsd}"
                  title="${isRawFish && rawFishYield > 1 ? `Costo unitario por pez capturado (rendimiento ~${rawFishYield.toFixed(2)}x)` : (!isRawFish && priceInfo.isFishOrCrust && ingFishYield > 1 ? `Costo unitario por pez capturado (rendimiento ~${ingFishYield.toFixed(2)}x)` : (isSubRecipe && subRecipeObj ? `Sub-receta: ${subRecipeObj.ingredients.map(si => `${si.amount * totalAmount} ${si.name}`).join(' + ')}` : (tToggleCurrency || 'Clic para alternar entre FLOWER y USD')))}"
                >
                  ${formattedPrice}
                </button>
              </div>
              ${captureHtml}
            </div>
          `;
        })
        .join("");

      const itemBuffs = getActiveBuffsForItem(item);
      let itemBuffsHtmlDesktop = "";
      let itemBuffsHtmlMobile = "";

      if (itemBuffs.length > 0) {
        const overlapClassDesktop = itemBuffs.length > 4 ? "-space-x-reverse -space-x-2" : itemBuffs.length > 2 ? "-space-x-reverse -space-x-1.5" : "-space-x-reverse -space-x-1";
        itemBuffsHtmlDesktop = `
          <div class="flex flex-row-reverse items-center justify-start ${overlapClassDesktop} mt-1 max-w-full overflow-visible flex-nowrap" title="${itemBuffs.map(b => `${b.name} (${getBuffEffectDesc(b, item)})`).join(' • ')}">
            ${itemBuffs.map((b, idx) => renderBuffSquare(b, item, "sm", idx)).join("")}
          </div>
        `;

        const overlapClassMobile = itemBuffs.length > 4 ? "-space-x-reverse -space-x-2" : "-space-x-reverse -space-x-1.5";
        itemBuffsHtmlMobile = `
          <div class="flex flex-row-reverse items-center justify-end ${overlapClassMobile} mt-1.5 relative z-10 max-w-full overflow-visible flex-nowrap" title="${itemBuffs.map(b => `${b.name} (${getBuffEffectDesc(b, item)})`).join(' • ')}">
            ${itemBuffs.map((b, idx) => renderBuffSquare(b, item, "sm", idx)).join("")}
          </div>
        `;
      }

      return `
        <div class="recipe-row hover:bg-white/[0.02] transition-colors group block border border-white/5 bg-white/[0.02] rounded-[20px] p-5 lg:p-0 lg:border-0 lg:border-b lg:border-white/5 last:lg:border-b-0 lg:bg-transparent lg:rounded-none lg:grid lg:grid-cols-[25%_10%_15%_15%_15%_20%] lg:items-center lg:py-3">
          <div class="lg:px-4 font-medium text-white flex items-center justify-between lg:justify-start h-full mb-3 lg:mb-0">
            <div class="flex items-center gap-3 lg:gap-3 w-full">
              <div class="relative w-12 h-12 lg:w-8 lg:h-8 flex items-center justify-center shrink-0 bg-white/5 rounded-xl lg:bg-transparent lg:rounded-none p-1 lg:p-0">
                ${
                  isAging && rawFishImg
                    ? `
                  <div class="absolute -top-1 -left-1 w-4 h-4 lg:w-3.5 lg:h-3.5 rounded-full bg-black/90 border border-white/25 p-0.5 flex items-center justify-center pointer-events-none z-10 shadow-[0_1px_3px_rgba(0,0,0,0.8)]" title="${rawFishName}">
                    <img src="${rawFishImg}" alt="${rawFishName}" width="14" height="14" class="w-full h-full object-contain [image-rendering:pixelated]" loading="lazy" decoding="async" />
                  </div>
                `
                    : ""
                }
                <img src="${dishImg}" alt="${item.name}" class="w-full h-full object-contain drop-shadow-sm ${isAging ? 'aged-fish-filter [image-rendering:pixelated]' : ''}" width="32" height="32" loading="lazy" decoding="async" onerror="window.handleImgError(this)" />
              </div>
              <div class="flex flex-col flex-1">
                <div class="flex items-center gap-1.5 flex-wrap">
                  <span class="text-sm font-semibold text-white group-hover:text-emerald-400 transition-colors">${displayName}</span>
                  ${
                    item.event
                      ? `<span class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded text-[10px] font-mono font-medium ${isEventEnded(item) ? 'bg-amber-500/15 text-amber-300 border border-amber-500/30' : 'bg-purple-500/20 text-purple-300 border border-purple-500/40'}" title="${item.eventDate ? `${item.event} • ${item.eventDate}` : item.event}">✨ ${item.event}${isEventEnded(item) ? ` (${item.eventDate || tEventEnded})` : ''}</span>`
                      : ""
                  }

                </div>
                <div class="flex items-center justify-between lg:justify-start w-full">
                  ${
                    isRawFish
                      ? `<span class="text-[11px] text-emerald-400 font-mono mt-0.5 flex items-center gap-1">⚡ ${tInstant || "Instant"}</span>`
                      : `<span class="text-[11px] text-terminal-muted mt-0.5 ${timeSeconds < parseTime(item.time) ? 'text-blue-400' : ''}">🕒 ${displayTime}</span>`
                  }
                  ${
                    item.instant
                      ? `<span class="text-[11px] font-mono text-cyan-300 flex items-center gap-1 ml-2"><img src="/img/sunflowerland/123/Gem.png" class="w-3 h-3 object-contain" alt="Gem" width="12" height="12" loading="lazy" decoding="async" onerror="this.onerror=null; this.outerHTML='💎';" /> ${item.instant}</span>`
                      : ""
                  }
                </div>
              </div>
            </div>
          </div>
          
          <div class="grid grid-cols-2 gap-2 mb-3 lg:hidden">
            <div class="bg-white/5 border border-white/5 rounded-lg p-2.5 flex flex-col justify-center relative overflow-visible">
              <div class="absolute -right-2 -bottom-2 text-white/5 text-4xl font-black pointer-events-none">XP</div>
              <span class="text-[9px] text-white/40 uppercase tracking-wider font-bold mb-0.5 relative z-10">${tTotalXp}</span>
              <div class="flex items-center gap-1 relative z-10 flex-wrap">
                <span class="text-white text-[15px] font-bold ${finalXp > item.xp ? 'text-emerald-400' : ''}" ${isAging && item.agedXp ? `title="Aged (90%): +${item.agedXp} XP · Prime (10%): +${item.primeAgedXp} XP"` : ''}>${formatNumber(finalXp, 0)}</span>
                ${finalXp > item.xp ? `<img src="/img/sunflowerland/123/energy.png" alt="⚡" class="w-3.5 h-3.5 object-contain [image-rendering:pixelated] inline-block shrink-0" title="Base: ${formatNumber(item.xp, 0)}" />` : ""}
                ${isAging && item.primeAgedXp ? `<span class="text-[9px] font-mono px-1 py-0.2 rounded bg-yellow-400/10 text-yellow-300 border border-yellow-400/20" title="Aged: +${item.agedXp} XP (90%) · Prime: +${item.primeAgedXp} XP (10%)">🎲 90/10</span>` : ''}
              </div>
              ${itemBuffsHtmlMobile}
            </div>
            <div class="bg-white/5 border border-white/5 rounded-lg p-2.5 flex flex-col justify-center relative overflow-hidden">
              <div class="absolute -right-2 -bottom-2 text-white/5 text-4xl font-black pointer-events-none">$</div>
              <span class="text-[9px] text-white/40 uppercase tracking-wider font-bold mb-0.5 relative z-10">${tFlowerCost}</span>
              <div class="flex flex-col relative z-10">
                <div class="flex items-center gap-1">
                  <img src="/img/sunflowerland/flower.jpg" class="w-3.5 h-3.5 rounded-full object-cover shrink-0" width="14" height="14" loading="lazy" decoding="async" alt="FLOWER" />
                  <span class="text-white text-[15px] font-mono ${costObj.total > costObj.baseTotal ? 'text-red-400' : ''}">${costObj.total > 0 ? formatNumber(costObj.total, costObj.total >= 100 ? 0 : 2) : "0"}</span>
                  ${costObj.missing && costObj.total > 0 ? `<span class="text-[9px] text-yellow-500/70" title="${tIncompleteTooltip}">${tIncompletePrice}</span>` : ""}
                </div>
                ${costObj.total > costObj.baseTotal ? `<span class="text-[8px] text-red-500/70 leading-none mt-0.5">Debuff x${(costObj.total/costObj.baseTotal).toFixed(2)}</span>` : ""}
              </div>
            </div>
            <div class="bg-white/5 border border-white/5 rounded-lg p-2.5 flex flex-col justify-center">
              <span class="text-[9px] text-white/40 uppercase tracking-wider font-bold mb-0.5">XP/FLOWER</span>
              <span class="text-emerald-300/90 text-sm font-mono">${xpPerSfl > 0 ? formatNumber(xpPerSfl, xpPerSfl >= 100 ? 0 : 2) : "0.00"}</span>
            </div>
            <div class="bg-white/5 border border-white/5 rounded-lg p-2.5 flex flex-col justify-center">
              <span class="text-[9px] text-white/40 uppercase tracking-wider font-bold mb-0.5">XP/Day</span>
              <span class="text-blue-300/90 text-sm font-bold font-mono">${timeSeconds > 0 ? formatNumber(xpPerDay, 0) : '<span class="text-white/30 font-normal">—</span>'}</span>
            </div>
          </div>

          <div class="hidden lg:flex mt-2 lg:mt-0 lg:px-4 flex-col items-end justify-center">
            <div class="flex items-center gap-1.5 flex-wrap justify-end">
              <span class="text-white text-sm font-bold ${finalXp > item.xp ? 'text-emerald-400' : ''}" ${isAging && item.agedXp ? `title="Aged (90%): +${item.agedXp} XP · Prime (10%): +${item.primeAgedXp} XP"` : ''}>${formatNumber(finalXp, 0)}</span>
              ${finalXp > item.xp ? `<img src="/img/sunflowerland/123/energy.png" alt="⚡" class="w-3.5 h-3.5 object-contain [image-rendering:pixelated] inline-block shrink-0" title="Base: ${formatNumber(item.xp, 0)}" />` : ""}
              ${isAging && item.primeAgedXp ? `<span class="text-[9px] font-mono px-1 py-0.2 rounded bg-yellow-400/10 text-yellow-300 border border-yellow-400/20" title="Aged: +${item.agedXp} XP (90%) · Prime: +${item.primeAgedXp} XP (10%)">🎲 90/10</span>` : ''}
            </div>
            ${itemBuffsHtmlDesktop}
          </div>
          
          <div class="hidden lg:flex mt-2 lg:mt-0 lg:px-4 flex-col justify-center">
            <div class="flex items-center gap-1.5">
              <img src="/img/sunflowerland/flower.jpg" class="w-3.5 h-3.5 rounded-full object-cover shrink-0" width="14" height="14" loading="lazy" decoding="async" alt="FLOWER" />
              <span class="text-white text-sm ${costObj.total > costObj.baseTotal ? 'text-red-400' : ''}">${costObj.total > 0 ? formatNumber(costObj.total, costObj.total >= 100 ? 0 : 2) : "0"}</span>
              ${costObj.missing && costObj.total > 0 ? `<span class="text-[9px] text-yellow-500/70" title="${tIncompleteTooltip}">${tIncompletePrice}</span>` : ""}
            </div>
            ${costObj.total > costObj.baseTotal ? `<span class="text-[9px] text-red-500/70" title="Base: ${formatNumber(costObj.baseTotal, 2)}">Debuff x${(costObj.total/costObj.baseTotal).toFixed(2)}</span>` : ""}
          </div>
          
          <div class="hidden lg:flex mt-2 lg:mt-0 lg:px-4 items-center">
            <span class="text-white text-sm font-mono">${xpPerSfl > 0 ? formatNumber(xpPerSfl, xpPerSfl >= 100 ? 0 : 2) : "0.00"}</span>
          </div>

          <div class="hidden lg:flex mt-2 lg:mt-0 lg:px-4 items-center">
            <span class="text-white text-sm font-bold font-mono">${timeSeconds > 0 ? formatNumber(xpPerDay, 0) : '<span class="text-white/30 font-normal">—</span>'}</span>
          </div>

          <div class="mt-2 lg:mt-0 lg:px-4 flex flex-col justify-start lg:justify-center pt-3 lg:pt-0 border-t border-white/5 lg:border-0 w-full">
            ${ingredientsHtml}
            ${fishingBuffsBarHtml}
          </div>
        </div>
      `;
    });

    tableBody.innerHTML = rowsHtml.join("");
  }

  const getBestRecipe = () => {
    if (window.manualSelectedDish) {
      const manualRecipe = recipesData.find((r) => r.name === window.manualSelectedDish);
      if (manualRecipe) {
        const calcXp = getCalculatedXp(manualRecipe);
        const costObj = calculateRecipeCost(manualRecipe.ingredients, new Set(), true, manualRecipe.building === "Aging Shed", manualRecipe.building === "Fish");
        const totalCost = costObj.total;
        const efficiency = totalCost > 0 ? calcXp / totalCost : 0;
        return {
          ...manualRecipe,
          xp: calcXp,
          rawBaseXp: manualRecipe.xp,
          baseCost: totalCost,
          efficiency,
          isManual: true,
        };
      }
    }

    let best = null;
    let maxEfficiency = 0;
    const minXp = window.currentHideXpLimit || 0;

    for (const recipe of recipesData) {
      if (isEventEnded(recipe)) continue;
      const calcXp = getCalculatedXp(recipe);
      if (!calcXp || calcXp <= 0) continue;
      if (calcXp < minXp) continue;
      const costObj = calculateRecipeCost(recipe.ingredients, new Set(), true, recipe.building === "Aging Shed", recipe.building === "Fish");
      const totalCost = costObj.total;
      if (totalCost > 0 && !costObj.missing) {
        const efficiency = calcXp / totalCost;
        if (efficiency > maxEfficiency) {
          maxEfficiency = efficiency;
          best = { ...recipe, xp: calcXp, rawBaseXp: recipe.xp, baseCost: totalCost, efficiency };
        }
      }
    }

    if (!best) {
      for (const recipe of recipesData) {
        if (isEventEnded(recipe)) continue;
        const calcXp = getCalculatedXp(recipe);
        if (!calcXp || calcXp <= 0) continue;
        if (calcXp < minXp) continue;
        const costObj = calculateRecipeCost(recipe.ingredients, new Set(), true, recipe.building === "Aging Shed", recipe.building === "Fish");
        const totalCost = costObj.total;
        if (totalCost > 0) {
          const efficiency = calcXp / totalCost;
          if (efficiency > maxEfficiency) {
            maxEfficiency = efficiency;
            best = { ...recipe, xp: calcXp, rawBaseXp: recipe.xp, baseCost: totalCost, efficiency };
          }
        }
      }
    }

    return best;
  };

  const formatCompactXp = (xp, isDelta = true) => {
    if (xp === 0) return "0 XP";
    const prefix = isDelta ? "+" : "";
    if (xp >= 1000000) return `${prefix}${(xp / 1000000).toFixed(2)}M XP`;
    if (xp >= 10000) return `${prefix}${(xp / 1000).toFixed(1)}k XP`;
    return `${prefix}${formatNumber(xp, 0)} XP`;
  };

  const updateRangeHighlight = (start, target) => {
    const highlight = document.getElementById("skillRangeHighlight");
    if (!highlight) return;
    const s = Math.max(1, Math.min(200, start));
    const t = Math.max(1, Math.min(200, target));
    const pct1 = Math.max(0, Math.min(100, ((s - 1) / 199) * 100));
    const pct2 = Math.max(0, Math.min(100, ((t - 1) / 199) * 100));
    highlight.style.left = `${pct1}%`;
    highlight.style.right = `${100 - pct2}%`;
  };

  const updateSkillCalculator = () => {
    const startRange = document.getElementById("skillStartLevelRange");
    const startInput = document.getElementById("skillStartLevelInput");
    const levelRange = document.getElementById("skillLevelRange");
    const levelInput = document.getElementById("skillLevelInput");
    if (!levelRange) return;

    let rawStart = parseInt(startInput ? startInput.value : (startRange ? startRange.value : 1));
    let rawTarget = parseInt(levelInput ? levelInput.value : (levelRange ? levelRange.value : 100));

    if (isNaN(rawStart)) rawStart = 1;
    if (isNaN(rawTarget)) rawTarget = 100;

    const clampedStart = Math.max(1, Math.min(200, rawStart));
    const clampedTarget = Math.max(1, Math.min(200, rawTarget));

    // Solo sincronizar el valor de los sliders si no tienen el foco activo
    if (startRange && document.activeElement !== startRange) {
      startRange.value = clampedStart;
    }
    if (levelRange && document.activeElement !== levelRange) {
      levelRange.value = clampedTarget;
    }

    const startLevel = Math.min(clampedStart, clampedTarget);
    const targetLevel = Math.max(clampedStart, clampedTarget);

    updateRangeHighlight(startLevel, targetLevel);

    const best = getBestRecipe();

    const skillRangeXpDisplay = document.getElementById("skillRangeXpDisplay");
    const skillRangeCostDisplay = document.getElementById("skillRangeCostDisplay");
    const skillRangeDishCount = document.getElementById("skillRangeDishCount");

    const skillAvgCostDisplay = document.getElementById("skillAvgCostDisplay");
    const skillAvgXpDisplay = document.getElementById("skillAvgXpDisplay");
    const skillAvgDishImg = document.getElementById("skillAvgDishImg");
    const skillAvgDishCount = document.getElementById("skillAvgDishCount");

    const skillNextCostDisplay = document.getElementById("skillNextCostDisplay");
    const skillNextDeltaXpDisplay = document.getElementById("skillNextDeltaXpDisplay");
    const skillNextLabel = document.getElementById("skillNextLabel");
    const skillNextDishImg = document.getElementById("skillNextDishImg");
    const skillNextDishCount = document.getElementById("skillNextDishCount");

    const totalCostDisplay = document.getElementById("skillTotalCostDisplay");
    const totalXpDisplay = document.getElementById("skillTotalXpDisplay");
    const skillTotalDishImg = document.getElementById("skillTotalDishImg");
    const skillTotalDishCount = document.getElementById("skillTotalDishCount");

    const bestFoodImg = document.getElementById("bestFoodImg");
    const bestFoodNameDisplay = document.getElementById("bestFoodNameDisplay");
    const bestFoodEfficiencyDisplay = document.getElementById("bestFoodEfficiencyDisplay");
    const bestFoodCostDisplay = document.getElementById("bestFoodCostDisplay");
    const bestFoodXpDisplay = document.getElementById("bestFoodXpDisplay");

    if (!best || !best.efficiency || best.efficiency <= 0) {
      if (skillRangeXpDisplay) skillRangeXpDisplay.innerText = "...";
      if (skillRangeCostDisplay) skillRangeCostDisplay.innerText = "...";
      if (skillRangeDishCount) skillRangeDishCount.innerText = "...";
      if (skillAvgCostDisplay) skillAvgCostDisplay.innerText = "...";
      if (skillAvgXpDisplay) skillAvgXpDisplay.innerText = "...";
      if (skillAvgDishCount) skillAvgDishCount.innerText = "...";
      if (skillNextCostDisplay) skillNextCostDisplay.innerText = "...";
      if (skillNextDeltaXpDisplay) skillNextDeltaXpDisplay.innerText = "...";
      if (totalCostDisplay) totalCostDisplay.innerText = "...";
      if (totalXpDisplay) totalXpDisplay.innerText = "...";
      if (skillNextDishCount) skillNextDishCount.innerText = "...";
      if (skillTotalDishCount) skillTotalDishCount.innerText = "...";
      if (bestFoodNameDisplay) bestFoodNameDisplay.innerText = "...";
      if (bestFoodEfficiencyDisplay) bestFoodEfficiencyDisplay.innerText = "...";
      if (bestFoodCostDisplay) bestFoodCostDisplay.innerText = "...";
      if (bestFoodXpDisplay) bestFoodXpDisplay.innerText = "...";
      const heroBuffsEmpty = document.getElementById("heroActiveBuffsList");
      if (heroBuffsEmpty) heroBuffsEmpty.innerHTML = "";
      return;
    }

    const startXp = levelExperience[startLevel] || 0;
    const targetXp = levelExperience[targetLevel] || 0;
    const rangeXp = Math.max(0, targetXp - startXp);

    const nextLevelXp = targetLevel < 200 ? (levelExperience[targetLevel + 1] || targetXp) : targetXp;
    const nextDeltaXp = targetLevel < 200 ? (nextLevelXp - targetXp) : 0;

    const dishesRange = (best.xp > 0 && rangeXp > 0) ? Math.ceil(rangeXp / best.xp) : 0;
    const dishesNextLevel = (best.xp > 0 && nextDeltaXp > 0) ? Math.ceil(nextDeltaXp / best.xp) : 0;
    const dishesTotal = (best.xp > 0 && targetXp > 0) ? Math.ceil(targetXp / best.xp) : 0;

    const rangeCost = rangeXp / best.efficiency;
    const costNextLevel = nextDeltaXp / best.efficiency;
    const totalCost = targetXp / best.efficiency;

    // Skills en el rango seleccionado
    const skillsEarnedInRange = Math.max(1, targetLevel - startLevel);
    const avgCostPerSkill = rangeCost / skillsEarnedInRange;
    const avgXpPerSkill = rangeXp / skillsEarnedInRange;
    const dishesAvgSkill = (best.xp > 0 && avgXpPerSkill > 0) ? Math.ceil(avgXpPerSkill / best.xp) : 0;

    const dishImgSrc = best.image || `/img/sunflowerland/food/${best.name}.png`;

    // Métrica Hero: XP REQUERIDA (Rango seleccionado) y Leyenda Costo FLOWER
    if (skillRangeXpDisplay) {
      skillRangeXpDisplay.innerText = `${formatNumber(rangeXp, 0)} XP`;
      skillRangeXpDisplay.title = `Rango Lvl ${startLevel} → ${targetLevel}: ${formatNumber(rangeXp, 0)} XP`;
    }
    if (skillRangeCostDisplay) {
      const rangeCostDecimals = rangeCost >= 100 ? 0 : 2;
      skillRangeCostDisplay.innerText = `~${formatNumber(rangeCost, rangeCostDecimals)} FLOWER`;
    }
    if (skillRangeDishCount) {
      skillRangeDishCount.innerText = formatNumber(dishesRange, 0);
      skillRangeDishCount.title = `${formatNumber(dishesRange, 0)}x ${best.name}`;
    }

    // Col 1: Promedio por Skill en el rango
    if (skillAvgCostDisplay) {
      const avgDecimals = avgCostPerSkill >= 100 ? 0 : 2;
      skillAvgCostDisplay.innerText = `${formatNumber(avgCostPerSkill, avgDecimals)} FLOWER`;
    }
    if (skillAvgXpDisplay) {
      skillAvgXpDisplay.innerText = `(~${formatCompactXp(avgXpPerSkill, false)})`;
      skillAvgXpDisplay.title = `Promedio: ${formatNumber(avgXpPerSkill, 0)} XP`;
    }
    if (skillAvgDishImg) {
      skillAvgDishImg.src = dishImgSrc;
      skillAvgDishImg.alt = best.name;
      skillAvgDishImg.title = best.name;
      skillAvgDishImg.onerror = function() { window.handleImgError(this); };
    }
    if (skillAvgDishCount) {
      skillAvgDishCount.innerText = formatNumber(dishesAvgSkill, 0);
      skillAvgDishCount.title = `${formatNumber(dishesAvgSkill, 0)}x ${best.name}`;
    }

    if (skillNextDishImg) {
      skillNextDishImg.src = dishImgSrc;
      skillNextDishImg.alt = best.name;
      skillNextDishImg.onerror = function() { window.handleImgError(this); };
    }
    if (skillTotalDishImg) {
      skillTotalDishImg.src = dishImgSrc;
      skillTotalDishImg.alt = best.name;
      skillTotalDishImg.onerror = function() { window.handleImgError(this); };
    }

    const isBestAging = best && (best.building === "Aging Shed" || best.name.startsWith("Aged "));
    [skillAvgDishImg, skillNextDishImg, skillTotalDishImg].forEach((img) => {
      if (!img) return;
      if (isBestAging) {
        img.classList.add("aged-fish-filter", "[image-rendering:pixelated]");
      } else {
        img.classList.remove("aged-fish-filter", "[image-rendering:pixelated]");
      }
    });

    // Col 2: Próximo nivel
    if (skillNextLabel) {
      const prefix = skillNextLabel.dataset.prefix || "Próx. Lvl";
      skillNextLabel.innerText = targetLevel < 200 ? `${prefix} ${targetLevel + 1}` : "Max Lvl";
    }
    if (skillNextDishCount) {
      if (targetLevel >= 200) {
        skillNextDishCount.innerText = "-";
        skillNextDishCount.title = "Max Lvl";
      } else {
        skillNextDishCount.innerText = formatNumber(dishesNextLevel, 0);
        skillNextDishCount.title = `${formatNumber(dishesNextLevel, 0)}x ${best.name}`;
      }
    }
    if (skillNextDishImg) {
      skillNextDishImg.src = dishImgSrc;
      skillNextDishImg.alt = best.name;
      skillNextDishImg.title = best.name;
      skillNextDishImg.onerror = function() { window.handleImgError(this); };
    }
    if (skillNextCostDisplay) {
      if (targetLevel >= 200) {
        skillNextCostDisplay.innerText = "-";
      } else {
        const costNextLevelDecimals = costNextLevel >= 100 ? 0 : 2;
        skillNextCostDisplay.innerText = `${formatNumber(costNextLevel, costNextLevelDecimals)} FLOWER`;
      }
    }
    if (skillNextDeltaXpDisplay) {
      if (targetLevel >= 200) {
        skillNextDeltaXpDisplay.innerText = "(Max)";
      } else {
        skillNextDeltaXpDisplay.innerText = `(${formatCompactXp(nextDeltaXp, true)})`;
        skillNextDeltaXpDisplay.title = `${formatNumber(nextDeltaXp, 0)} XP`;
      }
    }

    // Col 3: Histórico total acumulado
    if (skillTotalDishCount) {
      skillTotalDishCount.innerText = formatNumber(dishesTotal, 0);
      skillTotalDishCount.title = `${formatNumber(dishesTotal, 0)}x ${best.name}`;
    }
    if (skillTotalDishImg) {
      skillTotalDishImg.src = dishImgSrc;
      skillTotalDishImg.alt = best.name;
      skillTotalDishImg.title = best.name;
      skillTotalDishImg.onerror = function() { window.handleImgError(this); };
    }
    if (totalCostDisplay) {
      const totalCostDecimals = totalCost >= 100 ? 0 : 2;
      totalCostDisplay.innerText = `${formatNumber(totalCost, totalCostDecimals)} FLOWER`;
    }
    if (totalXpDisplay) {
      totalXpDisplay.innerText = `(${formatCompactXp(targetXp, false)})`;
      totalXpDisplay.title = `Total: ${formatNumber(targetXp, 0)} XP`;
    }

    // Tarjeta 2: Alimento Más Rentable & XP por FLOWER
    if (bestFoodNameDisplay) bestFoodNameDisplay.innerText = best.name;
    if (bestFoodEfficiencyDisplay) {
      const effDecimals = best.efficiency >= 100 ? 0 : 1;
      bestFoodEfficiencyDisplay.innerText = `${formatNumber(best.efficiency, effDecimals)} XP/FLOWER`;
    }
    const baseCostDecimals = best.baseCost >= 100 ? 0 : 3;
    if (bestFoodCostDisplay) bestFoodCostDisplay.innerText = `${formatNumber(best.baseCost, baseCostDecimals)} FLOWER`;
    if (bestFoodXpDisplay) {
      const bestBuffs = getActiveBuffsForItem(best);
      const isBoosted = (best.rawBaseXp && best.xp > best.rawBaseXp) || (bestBuffs && bestBuffs.length > 0);
      const isLowXp = best.xp < 1000;
      const labelLowXp = bestFoodXpDisplay.dataset.labelLowXp || "Baja XP (< 1,000 XP)";
      bestFoodXpDisplay.innerHTML = `${formatNumber(best.xp, 0)}${isBoosted ? ` <img src="/img/sunflowerland/123/energy.png" alt="⚡" class="w-3.5 h-3.5 object-contain [image-rendering:pixelated] inline-block shrink-0 ml-1" title="Base: ${formatNumber(best.rawBaseXp || best.xp, 0)}" />` : ""}${isLowXp ? ` <span class="inline-block text-xs select-none ml-1 cursor-help" title="${labelLowXp}">😐</span>` : ""}`;
    }

    if (bestFoodImg) {
      bestFoodImg.src = best.image || `/img/sunflowerland/food/${best.name}.png`;
      bestFoodImg.alt = best.name;
      bestFoodImg.onerror = function() { window.handleImgError(this); };
    }

    const dishManualBadge = document.getElementById("dishManualBadge");
    if (dishManualBadge) {
      if (window.manualSelectedDish) {
        dishManualBadge.classList.remove("hidden");
        dishManualBadge.classList.add("inline-flex");
      } else {
        dishManualBadge.classList.add("hidden");
        dishManualBadge.classList.remove("inline-flex");
      }
    }

    // Actualizar cuadritos de buffs activos para el Alimento Óptimo
    const heroBuffsContainer = document.getElementById("heroActiveBuffsList");
    if (heroBuffsContainer) {
      const bestBuffs = getActiveBuffsForItem(best);
      if (bestBuffs.length === 0) {
        heroBuffsContainer.innerHTML = "";
      } else {
        const overlapClassHero = bestBuffs.length > 4 ? "-space-x-1 sm:-space-x-1.5" : "gap-1 sm:gap-1.5";
        heroBuffsContainer.className = `flex items-center ${overlapClassHero} flex-nowrap overflow-visible ml-1.5 shrink-0`;
        heroBuffsContainer.innerHTML = `
          <img src="/img/sunflowerland/123/energy.png" alt="⚡" class="w-4 h-4 object-contain [image-rendering:pixelated] shrink-0 mr-0.5" title="Buffs Activos" />
          ${bestBuffs.map((buff, idx) => renderBuffSquare(buff, best, "md", idx)).join("")}
        `;
      }
    }

    const menu = document.getElementById("dishSelectDropdownMenu");
    if (menu && !menu.classList.contains("hidden")) {
      const searchInput = document.getElementById("dishDropdownSearch");
      renderDishDropdownList(searchInput ? searchInput.value : "");
    }
  };

  const syncWithMarketData = (marketPayload) => {
    if (!marketPayload) return;
    const json = marketPayload.raw || (marketPayload.items ? marketPayload : null);
    if (!json || !json.items) return;

    try {
      // Sincronizar catálogo P2P con SflMarket si está disponible
      if (window.SflMarket && typeof window.SflMarket.getItemPrice === "function") {
        Object.values(sflIds).forEach((name) => {
          const p = window.SflMarket.getItemPrice(name);
          if (p > 0) priceDict[name] = p;
        });
      }

      Object.values(json.items).forEach((data) => {
        const idMatch = data.key.match(/collectibles-(\d+)$/)
        if (idMatch) {
          const id = idMatch[1]
          if (sflIds[id]) {
            priceDict[sflIds[id]] = data.currentPrice
          }
        }
      })

      Object.values(json.items).forEach((data) => {
        if (!data.key.startsWith("collectibles-")) {
          const resMatch = data.key.match(/resources-(\d+)$/)
          if (resMatch && sflIds[resMatch[1]]) {
            priceDict[sflIds[resMatch[1]]] = data.currentPrice
          }
        }
      })

      // 1. Precio de FLOWER (USD) vía SflMarket
      const flowerPrice = window.SflMarket && typeof window.SflMarket.getFlowerPrice === "function"
        ? window.SflMarket.getFlowerPrice()
        : (json.flowerPrice ? parseFloat(json.flowerPrice) : 0.0854);
      window.sflFlowerPrice = flowerPrice;
      const flowerDisplay = document.getElementById("quickFlowerPriceDisplay");
      if (flowerDisplay) {
        flowerDisplay.innerText = "$" + flowerPrice.toFixed(4);
      }

      // 2. Precio de Coins (Ratio P2P) vía SflMarket
      let bestCoinsPerFlower = window.SflMarket && typeof window.SflMarket.getBettyRatio === "function"
        ? window.SflMarket.getBettyRatio()
        : 0;
      if (bestCoinsPerFlower <= 0) {
        if (json.items && bettyPrices) {
          Object.keys(bettyPrices).forEach((name) => {
            const itemConfig = bettyPrices[name];
            const itemId = Object.keys(sflIds).find((key) => sflIds[key] === name);
            if (!itemId) return;
            const internalKey = `collectibles-${itemId}`;
            const marketItem = json.items[internalKey];
            const bettyPriceCoins = itemConfig.sellPrice;
            const p2pPriceFlower = marketItem ? marketItem.currentPrice : 0;
            if (p2pPriceFlower > 0) {
              const coinsPerFlower = bettyPriceCoins / p2pPriceFlower;
              if (coinsPerFlower > bestCoinsPerFlower) {
                bestCoinsPerFlower = coinsPerFlower;
              }
            }
          });
        }
      }
      if (bestCoinsPerFlower <= 0) bestCoinsPerFlower = 1330;
      window.sflAutoCoinsPerFlower = bestCoinsPerFlower;

      // 3. Caña de Pescar (1 Stone + 3 Wood + 20 Coins)
      const stonePrice = (window.SflMarket && window.SflMarket.getItemPrice("Stone")) || priceDict["Stone"] || (json.items['collectibles-602']?.currentPrice) || 0;
      const woodPrice = (window.SflMarket && window.SflMarket.getItemPrice("Wood")) || priceDict["Wood"] || (json.items['collectibles-601']?.currentPrice) || 0;
      window.sflStonePrice = stonePrice;
      window.sflWoodPrice = woodPrice;

      // 4. Petróleo / Oil (Materiales base)
      const ironPrice = (window.SflMarket && window.SflMarket.getItemPrice("Iron")) || priceDict["Iron"] || (json.items['collectibles-603']?.currentPrice) || 0;
      const leatherPrice = (window.SflMarket && window.SflMarket.getItemPrice("Leather")) || priceDict["Leather"] || (json.items['collectibles-641']?.currentPrice) || 0;
      window.sflIronPrice = ironPrice;
      window.sflLeatherPrice = leatherPrice;

      // Actualizar precios clave dinámicos (soporta edición personalizada de Coins y Rod)
      window.updateKeyPrices();

      // 5. Gemas / Gems (Gema P2P: 0.0103 USD con 29% bonus -> convertido a FLOWER)
      const gemBaseUsd = 0.0103;
      const gemBonus = 0.29;
      const gemCostUsd = gemBaseUsd / (1 + gemBonus);
      const gemCostFlower = gemCostUsd / (flowerPrice || 0.0854);
      window.sflGemPrice = gemCostFlower;
      const gemsDisplay = document.getElementById("quickGemsPriceDisplay");
      if (gemsDisplay) {
        gemsDisplay.innerText = formatNumber(gemCostFlower, 4);
      }

      loadingState.classList.add("hidden");
      dataContainer.classList.remove("hidden");

      renderTable();
      updateSkillCalculator();
    } catch (err) {
      console.error(err);
      loadingState.innerHTML = `<p class="text-red-500 text-sm">${tError}</p>`;
    }
  };

  const fetchPrices = async () => {
    try {
      loadingState.classList.remove("hidden");
      dataContainer.classList.add("hidden");

      let data = null;
      if (window.SflMarket && typeof window.SflMarket.fetchMarketData === "function") {
        data = await window.SflMarket.fetchMarketData();
      }
      if (!data) {
        const response = await fetch("/api/sfl_data.json");
        if (!response.ok) throw new Error("Error loading data");
        data = await response.json();
      }

      if (data) {
        syncWithMarketData(data);
      }
    } catch (err) {
      console.error(err);
      loadingState.innerHTML = `<p class="text-red-500 text-sm">${tError}</p>`;
    }
  };

  // Reactividad global con el evento de SflMarket
  window.addEventListener("sfl:marketUpdated", (e) => {
