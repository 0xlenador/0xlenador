  if (dishDropdownSearch) {
    dishDropdownSearch.addEventListener("input", (e) => {
      renderDishDropdownList(e.target.value);
    });
    dishDropdownSearch.addEventListener("click", (e) => {
      e.stopPropagation();
    });
  }

  document.addEventListener("click", (e) => {
    const container = document.getElementById("dishSelectContainer");
    if (container && !container.contains(e.target)) {
      closeDishDropdown();
    }
  });

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") closeDishDropdown();
  });

  const formatSkillDescription = (skillName, rank, originalDesc) => {
    if (!originalDesc || typeof originalDesc !== "string") return "";
    const skill = sflSkills[skillName] || sflOthers[skillName] || sflConsumables[skillName];
    if (!skill) return originalDesc;
    
    // When rank is 0, we still want to show the rank_1 values instead of {math} templates
    const effectiveRank = rank === 0 ? 1 : rank;
    let updatedDesc = originalDesc;
    
    if (skill.mathematics_1 && skill.mathematics_1.calc_by_rank) {
      const m1 = skill.mathematics_1.calc_by_rank[`rank_${effectiveRank}`];
      if (m1 !== undefined) {
         updatedDesc = updatedDesc.replace('{math1}', m1);
         updatedDesc = updatedDesc.replace('{math1_pct}', parseFloat((m1 * 100).toFixed(2)));
         updatedDesc = updatedDesc.replace('{math1_days}', parseFloat((m1 / 86400000).toFixed(2)));
      }
    }
    
    if (skill.mathematics_2 && skill.mathematics_2.calc_by_rank) {
      const m2 = skill.mathematics_2.calc_by_rank[`rank_${effectiveRank}`];
      if (m2 !== undefined) {
         updatedDesc = updatedDesc.replace('{math2}', m2);
         updatedDesc = updatedDesc.replace('{math2_pct}', parseFloat((m2 * 100).toFixed(2)));
         updatedDesc = updatedDesc.replace('{math2_days}', parseFloat((m2 / 86400000).toFixed(2)));
      }
    }
    
    return updatedDesc;
  };

  const updateSkillUI = (skillId) => {
    try {
      const rank = activeSkills[skillId] || 0;
      const safeId = skillId.replace(/\s+/g, '_');
      
      const card = document.querySelector(`.skill-card[data-skill-id="${skillId}"]`);
      if (card) {
        const descSpan = card.querySelector('.skill-description-text');
        const originalText = descSpan?.dataset?.original || descSpan?.getAttribute("title") || descSpan?.textContent || "";
        let updatedDesc = originalText;
        if (descSpan && originalText) {
          updatedDesc = formatSkillDescription(skillId, rank, originalText) || originalText;
          descSpan.textContent = updatedDesc;
        }
        
        const compactSpan = card.querySelector('.compact-view span');
        if (compactSpan) {
          if (skillId === "Faction Pet") {
            const labels = ["10%", "20%", "30%", "50%"];
            const displayVal = rank > 0 ? "+" + labels[rank - 1] : "?";
            compactSpan.textContent = compactSpan.textContent.replace(/^[^\s]+/, displayVal);
          } else if (originalText) {
            const descToParse = rank === 0 ? formatSkillDescription(skillId, 1, originalText) : updatedDesc;
            if (descToParse && typeof descToParse === "string") {
              const match = descToParse.match(/(?:^|\b|\s)([x+-]?\d+(?:\.\d+)?(?:%|x)?)/i);
              if (match) {
                let newVal = match[1].trim();
                if (newVal.toLowerCase().endsWith('x')) newVal = 'x' + newVal.slice(0, -1);
                compactSpan.textContent = compactSpan.textContent.replace(/^[^\s]+/, newVal);
              }
            }
          }
        }
      }
      
      // Update checkboxes progressively
      document.querySelectorAll(`.rank-input-${safeId}`).forEach((cb) => {
        const cbRank = parseInt(cb.dataset.rank || cb.value || "1", 10);
        cb.checked = skillId === "Faction Pet" ? cbRank === rank : cbRank <= rank;
      });
    } catch (err) {
      console.warn("Error updating skill UI for", skillId, err);
    }
  };

  document.querySelectorAll(".category-btn").forEach((btn) => {
    btn.addEventListener("click", (e) => {
      window.handleCategory(e.target.dataset.category)
    })
  })

  if (searchInput) {
    searchInput.addEventListener("input", (e) => {
      renderTable(e.target.value)
    })
  }


  window.setViewStyle = function(style) {
    const container = document.getElementById('boosts-container');
    if (style === 'compact') container.classList.add('is-compact');
    else container.classList.remove('is-compact');
    
    document.querySelectorAll('.view-switch-btn').forEach(b => b.classList.remove('active'));
    document.querySelectorAll('.view-switch-btn[data-action="' + style + '"]').forEach(btn => btn.classList.add('active'));
    
    if (typeof saveState === "function") saveState();
  };

  window.toggleBoostFilter = function(filter) {
    const container = document.getElementById("boosts-container");
    document.querySelectorAll(".filter-boost-btn").forEach(btn => btn.classList.remove("active"));
    
    if (filter === 'all') {
      container.removeAttribute("data-filter");
    } else {
      container.setAttribute("data-filter", filter);
    }
    document.querySelectorAll('.filter-boost-btn[data-filter="' + filter + '"]').forEach(btn => btn.classList.add('active'));
    
    if (typeof saveState === "function") saveState();
  };

  const loadState = () => {
    // 1. Cargar buffs, skills y preferencias desde el almacén global SflUserState
    // Leemos de forma síncrona desde localStorage para no depender del timing de carga de módulos
    try {
      const rawGlobal = localStorage.getItem("sfl_user_game_state_v1");
      if (rawGlobal) {
        const globalState = JSON.parse(rawGlobal);
        if (globalState.buffs) {
          Object.entries(globalState.buffs).forEach(([buffId, active]) => {
            if (active) activeBuffs.add(String(buffId));
          });
        }
        if (globalState.skills) {
          Object.entries(globalState.skills).forEach(([name, rank]) => {
            if (rank > 0) activeSkills[name] = rank;
          });
        }
        if (globalState.preferences) {
          if (globalState.preferences.coinsPerFlower) window.sflCustomCoinsPerFlower = globalState.preferences.coinsPerFlower;
          if (globalState.preferences.rodCost) window.sflCustomRodCost = globalState.preferences.rodCost;
          if (globalState.preferences.customFishFlakeCost !== undefined && globalState.preferences.customFishFlakeCost !== null) window.sflCustomFishFlakeCost = globalState.preferences.customFishFlakeCost;
          if (globalState.preferences.customFishStickCost !== undefined && globalState.preferences.customFishStickCost !== null) window.sflCustomFishStickCost = globalState.preferences.customFishStickCost;
          if (globalState.preferences.customCrabStickCost !== undefined && globalState.preferences.customCrabStickCost !== null) window.sflCustomCrabStickCost = globalState.preferences.customCrabStickCost;
          if (globalState.preferences.customFishOilCost !== undefined && globalState.preferences.customFishOilCost !== null) window.sflCustomFishOilCost = globalState.preferences.customFishOilCost;
        }
      }
    } catch (e) {
      console.warn("Failed to load sfl_user_game_state_v1 in loadState", e);
    }

    const cached = localStorage.getItem(CACHE_KEY);
    if (cached) {
      try {
        const state = JSON.parse(cached);
        if (state.activeBuffs && activeBuffs.size === 0) {
          state.activeBuffs.forEach(buffId => {
            activeBuffs.add(String(buffId));
          });
        }
        if (state.activeSkills && Object.keys(activeSkills).length === 0) {
          activeSkills = { ...state.activeSkills };
        }

        // Marcar checkboxes y clases activas para los buffs cargados
        activeBuffs.forEach(buffId => {
          const cb = document.querySelector(`.buff-checkbox[data-buff-id="${buffId}"]`);
          if (cb) {
            cb.checked = true;
            const card = cb.closest('.buff-card');
            if (card) {
              const isOrange = card.classList.contains("hover:border-orange-500/30");
              card.classList.add("active");
              if (isOrange) {
                card.classList.add("border-orange-500/50", "bg-orange-500/10");
              } else {
                card.classList.add("border-emerald-500/50", "bg-emerald-500/10");
              }
              card.classList.remove("border-white/5", "bg-white/5");
            }
          }
        });
        Object.keys(activeSkills).forEach(skillId => updateSkillUI(skillId));

        if (state.currentCategory) {
          window.handleCategory(state.currentCategory);
        }
        if (state.currentHideXpLimit !== undefined) {
          window.setHideXpLimit(state.currentHideXpLimit, 'init');
        } else {
          window.setHideXpLimit(1000, 'init');
        }
        if (state.manualSelectedDish) {
          window.manualSelectedDish = state.manualSelectedDish;
        }
        
        if (state.customCoins && !window.sflCustomCoinsPerFlower) {
          window.sflCustomCoinsPerFlower = parseFloat(state.customCoins);
        }
        if (state.customRod !== null && state.customRod !== undefined) {
          window.sflCustomRodCost = parseFloat(state.customRod);
        }
        if (state.customFishFlake !== null && state.customFishFlake !== undefined) {
          window.sflCustomFishFlakeCost = parseFloat(state.customFishFlake);
        }
        if (state.customFishStick !== null && state.customFishStick !== undefined) {
          window.sflCustomFishStickCost = parseFloat(state.customFishStick);
        }
        if (state.customCrabStick !== null && state.customCrabStick !== undefined) {
          window.sflCustomCrabStickCost = parseFloat(state.customCrabStick);
        }
        if (state.customFishOil !== null && state.customFishOil !== undefined) {
          window.sflCustomFishOilCost = parseFloat(state.customFishOil);
        }
        const isFirstTimeBoosts = localStorage.getItem("sfl_boosts_expanded_cooking") !== "true";
        if (state.boostFilter && !isFirstTimeBoosts) {
          window.toggleBoostFilter(state.boostFilter);
        } else {
          window.toggleBoostFilter('all');
        }
        if (state.viewStyle && !isFirstTimeBoosts) {
          window.setViewStyle(state.viewStyle);
        } else {
          window.setViewStyle('detailed');
        }
        const startLevel = state.skillStartLevel || "1";
        const targetLevel = (state.skillLevel && state.skillLevel !== "10") ? state.skillLevel : "100";
        const startRange = document.getElementById("skillStartLevelRange");
        const startInput = document.getElementById("skillStartLevelInput");
        const range = document.getElementById("skillLevelRange");
        const input = document.getElementById("skillLevelInput");
        if (startRange) startRange.value = startLevel;
        if (startInput) startInput.value = startLevel;
        if (range) range.value = targetLevel;
        if (input) input.value = targetLevel;
        updateRangeHighlight(parseInt(startLevel), parseInt(targetLevel));
      } catch (e) {
        console.error("Failed to parse cached state", e);
      }
    } else {
      window.setHideXpLimit(1000, 'init');
      window.toggleBoostFilter('all');
      window.setViewStyle('detailed');
    }
    Object.keys(activeSkills).forEach(skillId => updateSkillUI(skillId));
  };

  window.updateKeyPrices = function() {
    // 1. Coins
    const autoCoins = window.sflAutoCoinsPerFlower || 1330;
    const isCustomCoins = window.sflCustomCoinsPerFlower !== null && window.sflCustomCoinsPerFlower !== undefined && window.sflCustomCoinsPerFlower > 0;
    const effectiveCoins = isCustomCoins ? window.sflCustomCoinsPerFlower : autoCoins;
    window.sflBestCoinsPerFlower = effectiveCoins;

    const coinsInput = document.getElementById("quickCoinsInput");
    const resetCoinsBtn = document.getElementById("resetCoinsBtn");
    if (coinsInput) {
      coinsInput.value = Math.round(effectiveCoins);
      if (isCustomCoins) {
        coinsInput.classList.add("text-amber-400", "border-amber-400/80");
        coinsInput.classList.remove("text-emerald-400", "border-white/20");
      } else {
        coinsInput.classList.remove("text-amber-400", "border-amber-400/80");
        coinsInput.classList.add("text-emerald-400", "border-white/20");
      }
    }
    if (resetCoinsBtn) {
      if (isCustomCoins) resetCoinsBtn.classList.remove("hidden");
      else resetCoinsBtn.classList.add("hidden");
    }

    // 2. Rod
    const stoneP = window.sflStonePrice || 0;
    const woodP = window.sflWoodPrice || 0;
    const rodCoinsInFlower = 20 / effectiveCoins;
    const autoRodCost = (1 * stoneP) + (3 * woodP) + rodCoinsInFlower;
    window.sflAutoRodCost = autoRodCost;

    const isCustomRod = window.sflCustomRodCost !== null && window.sflCustomRodCost !== undefined && window.sflCustomRodCost >= 0;
    const effectiveRod = isCustomRod ? window.sflCustomRodCost : autoRodCost;
    // Limpiar caché de costo de peces al actualizar precios base
    if (typeof window.clearFishCostCache === "function") {
      window.clearFishCostCache();
    }
    window.sflRodCost = effectiveRod;

    const rodInput = document.getElementById("fishingRodInput");
    const resetRodBtn = document.getElementById("resetRodBtn");
    if (rodInput) {
      rodInput.value = isCustomRod ? effectiveRod.toString() : formatNumber(effectiveRod, 4);
      if (isCustomRod) {
        rodInput.classList.add("text-amber-400", "border-amber-400/80");
        rodInput.classList.remove("text-emerald-400", "border-white/20");
      } else {
        rodInput.classList.remove("text-amber-400", "border-amber-400/80");
        rodInput.classList.add("text-emerald-400", "border-white/20");
      }
    }
    if (resetRodBtn) {
      if (isCustomRod) resetRodBtn.classList.remove("hidden");
      else resetRodBtn.classList.add("hidden");
    }

    // Helper para actualizar inputs de derivados
    const updateDerivedPriceInput = (inputId, resetBtnId, customCost, autoCost) => {
      const isCustom = customCost !== null && customCost !== undefined && customCost >= 0;
      const effectiveVal = isCustom ? customCost : autoCost;
      const inputEl = document.getElementById(inputId);
      const resetEl = document.getElementById(resetBtnId);
      if (inputEl) {
        inputEl.value = isCustom ? effectiveVal.toString() : formatNumber(effectiveVal, 4);
        if (isCustom) {
          inputEl.classList.add("text-amber-400", "border-amber-400/80");
          inputEl.classList.remove("text-emerald-400", "border-white/20");
        } else {
          inputEl.classList.remove("text-amber-400", "border-amber-400/80");
          inputEl.classList.add("text-emerald-400", "border-white/20");
        }
      }
      if (resetEl) {
        if (isCustom) resetEl.classList.remove("hidden");
        else resetEl.classList.add("hidden");
      }
    };

    // Helper para obtener el costo real automático desde el motor central SflPrices
    const getAutoFishMarketCost = (name, fallbackFactor) => {
      if (window.SflPrices && typeof window.SflPrices.resolveCost === "function") {
        try {
          const res = window.SflPrices.resolveCost(name);
          if (res) {
            if (res.isCraftable && res.craftCostFlower > 0) return res.craftCostFlower;
            if (res.marketPriceFlower > 0) return res.marketPriceFlower;
          }
        } catch (e) {}
      }
      if (window.SflPrices && typeof window.SflPrices.getUnitCost === "function") {
        try {
          const u = window.SflPrices.getUnitCost(name);
          if (u && u.flower > 0) return u.flower;
        } catch (e) {}
      }
      if (window.SflMarket && typeof window.SflMarket.getItemPrice === "function") {
        const mp = window.SflMarket.getItemPrice(name);
        if (mp > 0) return mp;
      }
      return fallbackFactor * effectiveRod;
    };

    const autoFishFlake = getAutoFishMarketCost("Fish Flake", 8);
    const autoFishStick = getAutoFishMarketCost("Fish Stick", 10);
    const autoCrabStick = getAutoFishMarketCost("Crab Stick", 30);
    const autoFishOil = getAutoFishMarketCost("Fish Oil", 14);

    window.sflAutoFishFlakeCost = autoFishFlake;
    window.sflAutoFishStickCost = autoFishStick;
    window.sflAutoCrabStickCost = autoCrabStick;
    window.sflAutoFishOilCost = autoFishOil;

    // 3. Fish Flake
    updateDerivedPriceInput(
      "quickFishFlakeInput",
      "resetFishFlakeBtn",
      window.sflCustomFishFlakeCost,
      autoFishFlake
    );

    // 4. Fish Stick
    updateDerivedPriceInput(
      "quickFishStickInput",
      "resetFishStickBtn",
      window.sflCustomFishStickCost,
      autoFishStick
    );

    // 5. Crab Stick
    updateDerivedPriceInput(
      "quickCrabStickInput",
      "resetCrabStickBtn",
      window.sflCustomCrabStickCost,
      autoCrabStick
    );

    // 6. Fish Oil
    updateDerivedPriceInput(
      "quickFishOilInput",
      "resetFishOilBtn",
      window.sflCustomFishOilCost,
      autoFishOil
    );
  };

  const setupEditablePrice = (inputId, resetBtnId, customKey) => {
    const inputEl = document.getElementById(inputId);
    const resetBtnEl = document.getElementById(resetBtnId);
    if (inputEl) {
      const handleChange = (e) => {
        const rawStr = (e.target.value || "").trim().replace(',', '.');
        const val = parseFloat(rawStr);
        if (!isNaN(val) && val >= 0) {
          window[customKey] = val;
        } else {
          window[customKey] = null;
        }
        window.updateKeyPrices();
        renderTable(searchInput ? searchInput.value : "");
        updateSkillCalculator();
        if (typeof saveState === "function") saveState();
      };
      inputEl.addEventListener("change", handleChange);
      inputEl.addEventListener("keydown", (e) => {
        if (e.key === "Enter") inputEl.blur();
      });
    }
    if (resetBtnEl) {
      resetBtnEl.addEventListener("click", (e) => {
        e.stopPropagation();
        window[customKey] = null;
        window.updateKeyPrices();
        renderTable(searchInput ? searchInput.value : "");
        updateSkillCalculator();
        if (typeof saveState === "function") saveState();
      });
    }
  };

  setupEditablePrice("quickCoinsInput", "resetCoinsBtn", "sflCustomCoinsPerFlower");
  setupEditablePrice("fishingRodInput", "resetRodBtn", "sflCustomRodCost");
  setupEditablePrice("quickFishFlakeInput", "resetFishFlakeBtn", "sflCustomFishFlakeCost");
  setupEditablePrice("quickFishStickInput", "resetFishStickBtn", "sflCustomFishStickCost");
  setupEditablePrice("quickCrabStickInput", "resetCrabStickBtn", "sflCustomCrabStickCost");
  setupEditablePrice("quickFishOilInput", "resetFishOilBtn", "sflCustomFishOilCost");

  const boostsExpandBtn = document.getElementById("boosts-expand-btn");
  if (boostsExpandBtn && window.expandBoosts) {
    boostsExpandBtn.addEventListener("click", window.expandBoosts);
  }
  
  // Init
  loadState();
  fetchPrices();

  // Sincronización en vivo con el almacén global SflUserState (vía CustomEvent nativo)
  const syncCookingFromGlobalState = (newState) => {
    if (!newState) return;
    fishCatchCostCache.clear();
    let hasChanges = false;

    // Sincronizar activeBuffs
    if (newState.buffs) {
      const nextBuffs = new Set();
      Object.entries(newState.buffs).forEach(([id, active]) => {
        if (active) nextBuffs.add(String(id));
      });
      if (nextBuffs.size !== activeBuffs.size || Array.from(nextBuffs).some((id) => !activeBuffs.has(id))) {
        activeBuffs = nextBuffs;
        hasChanges = true;
      }
    }

    // Sincronizar activeSkills (incluyendo eliminación de habilidades desactivadas)
    if (newState.skills) {
      const currentSkillKeys = Object.keys(activeSkills);
      currentSkillKeys.forEach((k) => {
        if (!newState.skills[k] || newState.skills[k] <= 0) {
          delete activeSkills[k];
          hasChanges = true;
          updateSkillUI(k);
        }
      });
      Object.entries(newState.skills).forEach(([sName, sRank]) => {
        if (sRank > 0 && activeSkills[sName] !== sRank) {
          activeSkills[sName] = sRank;
          hasChanges = true;
          updateSkillUI(sName);
        }
      });
    }

    // Siempre re-renderizar tabla y calculadora ante cambios de estado global (para reflejar yields y costos dinámicos de pesca/aging)
    const searchInput = document.getElementById("searchInput");
    renderTable(searchInput ? searchInput.value : "");
    updateSkillCalculator();
  };

  // Escuchar el evento nativo del navegador inmediatamente (funciona sin importar el orden de carga)
  window.addEventListener("sfl:stateUpdated", (e) => {
    if (e && e.detail) {
      syncCookingFromGlobalState(e.detail);
    }
  });

  // Suscripción de respaldo si SflUserState ya está disponible
  if (window.SflUserState && typeof window.SflUserState.subscribe === "function") {
    window.SflUserState.subscribe(syncCookingFromGlobalState);
  }

  // Alternar moneda global para precios de ingredientes en la columna
  window.ingredientCurrencyMode = window.ingredientCurrencyMode || "flower";
  window.toggleIngredientCurrency = () => {
    window.ingredientCurrencyMode = window.ingredientCurrencyMode === "usd" ? "flower" : "usd";
    updateAllIngredientPrices();
  };

  function updateAllIngredientPrices() {
    const isUsd = window.ingredientCurrencyMode === "usd";
    const headerToggle = document.getElementById("ingredientCurrencyToggleHeader");
    if (headerToggle) {
      headerToggle.innerText = isUsd ? "[~usd]" : "[flower]";
    }

    document.querySelectorAll(".ingredient-price-btn").forEach((btn) => {
      const flower = parseFloat(btn.dataset.flower) || 0;
      const usd = parseFloat(btn.dataset.usd) || 0;
      btn.innerHTML = formatPriceDisplay(flower, usd, window.ingredientCurrencyMode);
    });
  }

  if (tableBody) {
    tableBody.addEventListener("click", (e) => {
      const priceBtn = e.target.closest(".ingredient-price-btn");
      if (priceBtn) {
        e.preventDefault();
        e.stopPropagation();
        window.toggleIngredientCurrency();
      }
    });
  }

  const headerCurrencyToggle = document.getElementById("ingredientCurrencyToggleHeader");
  if (headerCurrencyToggle) {
    headerCurrencyToggle.addEventListener("click", (e) => {
      e.preventDefault();
      e.stopPropagation();
      window.toggleIngredientCurrency();
    });
  }
</script>





