---
// ============================================================
// src/components/views/SflCookingView.astro
// View puro para la herramienta de cocina SFL.
// Fuente única de verdad: consumido por sfl-cocinando.astro y en/sfl-cooking.astro.
// El idioma se detecta desde la URL vía getLangFromUrl.
// ============================================================
import { getEntry } from "astro:content"
import { getLangFromUrl, useTranslations } from "../../i18n/utils"
import SflToolLayout from "../SflToolLayout.astro"

const sflRecipesEntry = await getEntry("sfl", "recipes")
const sflIdsEntry = await getEntry("sfl", "resources")
const sflBuffsEntry = await getEntry("sfl", "calculo_buffs")
const sflPowerUpsDataEntry = await getEntry("sfl", "powerups")
const sflSkillsEntry = await getEntry("sfl", "skills")
const sflRecipes = sflRecipesEntry.data
const sflIds = sflIdsEntry.data
const sflBuffsRaw = sflBuffsEntry.data
const sflBuffs = sflBuffsRaw.powerups || sflBuffsRaw;
const sflShrines = sflBuffsRaw.shrines || {};
const sflPowerUpsData = sflPowerUpsDataEntry.data.power_ups
const sflSkills = { ...(sflSkillsEntry.data.Cooking || {}) }
if (sflSkillsEntry.data.Fishing && sflSkillsEntry.data.Fishing["Fishy Feast"]) {
  sflSkills["Fishy Feast"] = sflSkillsEntry.data.Fishing["Fishy Feast"]
}
const sflOthers = sflBuffsRaw.others || {}
const sflConsumables = sflBuffsRaw.consumables || {}
import levelExperience from "../../content/data/sfl/level_experience.json"
import bettyPrices from "../../content/data/sfl/betty_prices.json"

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)


const getCompactText = (data, formattedDesc, typeName) => {
  let value = "?";
  const match = formattedDesc.match(/(?:^|\b|\s)([x+-]?\d+(?:\.\d+)?(?:%|x)?)/i);
  if (match) {
    value = match[1].trim();
    if (value.toLowerCase().endsWith('x')) {
      value = 'x' + value.slice(0, -1);
    }
  }

  let effectType = "";
  const descLower = formattedDesc.toLowerCase();
  if (descLower.includes("xp")) {
    effectType = " XP";
  } else if (descLower.includes("time") || descLower.includes("faster") || descLower.includes("speed")) {
    effectType = " Time";
  } else if (descLower.includes("food") || descLower.includes("yield")) {
    effectType = " Food";
  }

  let target = "All";
  if (data.mathematics_1) {
    if (data.mathematics_1.target_food && data.mathematics_1.target_food !== "all") {
       target = data.mathematics_1.target_food;
    } else if (data.mathematics_1.target && data.mathematics_1.target !== "all") {
       target = data.mathematics_1.target;
    }
  }
  if (data.building) {
    target = data.building;
  }
  
  target = target.charAt(0).toUpperCase() + target.slice(1);
  return `${value}${effectType} [${target}] ${data.name}`;
}

const getEffectType = (desc) => {
  if (!desc) return "other";
  const descLower = desc.toLowerCase();
  if (descLower.includes("xp") || descLower.includes("yield") || (descLower.includes("food") && !descLower.includes("revenue"))) return "xp";
  if (descLower.includes("time") || descLower.includes("faster") || descLower.includes("speed")) return "time";
  return "other";
};

const formatAstroDescription = (skill) => {
  let desc = skill.description || "";
  if (skill.mathematics_1?.calc_by_rank?.rank_1 !== undefined) {
    const m1 = skill.mathematics_1.calc_by_rank.rank_1;
    desc = desc.replace("{math1}", m1).replace("{math1_pct}", parseFloat((m1 * 100).toFixed(2))).replace("{math1_days}", parseFloat((m1 / 86400000).toFixed(2)));
  }
  if (skill.mathematics_2?.calc_by_rank?.rank_1 !== undefined) {
    const m2 = skill.mathematics_2.calc_by_rank.rank_1;
    desc = desc.replace("{math2}", m2).replace("{math2_pct}", parseFloat((m2 * 100).toFixed(2))).replace("{math2_days}", parseFloat((m2 / 86400000).toFixed(2)));
  }
  return desc;
};
---

<SflToolLayout activeTab="cocinando">

    <!-- Encabezado Principal -->
    <div class="mb-5 relative z-10 text-center sm:text-left">
      <h1 class="text-3xl md:text-4xl font-black text-white tracking-tighter mb-2">
