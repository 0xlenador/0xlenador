  }
  .filter-boost-btn.active[data-filter="xp"] { background-color: rgba(16, 185, 129, 0.25); color: rgb(52, 211, 153); box-shadow: inset 0 1px 0 0 rgba(16, 185, 129, 0.3); }
  .filter-boost-btn.active[data-filter="time"] { background-color: rgba(59, 130, 246, 0.25); color: rgb(96, 165, 250); box-shadow: inset 0 1px 0 0 rgba(59, 130, 246, 0.3); }
  
  #boosts-container[data-filter="xp"] .buff-card:not([data-effect*="xp"]), #boosts-container[data-filter="xp"] .skill-card:not([data-effect*="xp"]) { display: none !important; }
  #boosts-container[data-filter="time"] .buff-card:not([data-effect*="time"]), #boosts-container[data-filter="time"] .skill-card:not([data-effect*="time"]) { display: none !important; }

  #boosts-peek-wrapper.is-peek {
    max-height: 380px;
    overflow: hidden;
  }
</style>

