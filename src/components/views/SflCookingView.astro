                  <img id="skillTotalDishImg" src="/img/sunflowerland/food/Boiled Eggs.png" class="w-4 h-4 sm:w-5 sm:h-5 object-contain drop-shadow shrink-0" alt="Dish" />
                  <div class="flex items-baseline gap-0.5">
                    <span id="skillTotalDishCount" class="text-xs sm:text-sm font-mono font-bold text-white">...</span>
                    <span class="text-[8px] sm:text-[9px] font-mono text-white/50 uppercase">{t("sfl.cooking.dash.dishesLabel")}</span>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

      </div>

      <!-- Fila 2: Franja Horizontal de Precios Clave (Coins, Rod, Fish Flake, Fish Stick, Crab Stick, Fish Oil) -->
