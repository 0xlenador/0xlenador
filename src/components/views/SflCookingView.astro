                <!-- Botón discreto y sutil al lado derecho del nombre -->
                <button
                  type="button"
                  id="dishSelectDropdownBtn"
                  class="p-1 rounded-lg bg-white/5 hover:bg-white/10 border border-white/10 hover:border-white/25 text-white/50 hover:text-emerald-400 transition-all flex items-center justify-center cursor-pointer"
