<script
  define:vars={{
    sflRecipes: allSflRecipes,
    sflIds,
      sflBuffs: { ...sflBuffs, ...sflShrines },
    sflSkills,
      sflOthers,
      sflConsumables,
      cookingBuffsCatalog,
    levelExperience,
    bettyPrices,
    tEmpty: t("sfl.cooking.empty"),
    tError: t("sfl.cooking.error"),
    tTime: t("sfl.cooking.col.time"),
    tInstant: t("sfl.cooking.col.instant"),
    tEvent: t("sfl.cooking.badge.event"),
    tEventEnded: t("sfl.cooking.badge.eventEnded"),
    tTotalXp: t("sfl.cooking.table.totalXp"),
    tFlowerCost: t("sfl.cooking.table.colCost"),
    tIncompletePrice: t("sfl.cooking.table.incompletePrice"),
    tIncompleteTooltip: t("sfl.cooking.table.incompletePriceTooltip"),
    tToggleCurrency: t("sfl.cooking.table.togglePriceCurrency"),
    rawFishList,
  }}
>
  window.handleImgError = function(img) {
    img.onerror = null;
    img.src = "/img/cripto/sunflowerland.webp";
  };

  const isEventEnded = (recipe) => {
    if (!recipe || !recipe.event) return false;
    if (!recipe.eventDate) return true;
    const parts = recipe.eventDate.split(/\s+[-–—]\s+|\s+to\s+/i).map((s) => s.trim()).filter(Boolean);
    const endStr = parts[parts.length - 1];
    const endDate = new Date(endStr);
    if (!isNaN(endDate.getTime())) {
      endDate.setHours(23, 59, 59, 999);
      return Date.now() > endDate.getTime();
    }
    return true;
  };

  const FISH_NAMES_FULL = [
    'Anchovy', 'Angelfish', 'Barred Knifejaw', 'Blowfish', 'Blue Marlin', 'Butterflyfish', 
    'Clownfish', 'Cobia', 'Coelacanth', 'Football fish', 'Halibut', 'Hammerhead shark', 
    'Horse Mackerel', 'Mahi Mahi', 'Napoleanfish', 'Oarfish', 'Olive Flounder', 'Parrotfish', 
    'Phantom Barracuda', 'Porgy', 'Ray', 'Red Snapper', 'Rock Blackfish', 'Saw Shark', 
    'Sea Bass', 'Sea Horse', 'Squid', 'Sunfish', 'Surgeonfish', 'Tilapia', 'Trout', 
    'Tuna', 'Walleye', 'Weakfish', 'Whale Shark', 'White Shark', 'Zebra Turkeyfish',
    'Crystal Shrimp', 'Deep Sea Pig', 'Deep Sea Slug', 'Dollocaris', 'Garden Eel', 
    'Giant Isopod', 'Gilded Swordfish', 'Longhorn Cowfish', 'Nautilus', 'Twilight Anglerfish',
    'Octopus', 'Moray Eel',
    'Crab', 'Blue Crab', 'Hermit Crab', 'Sea Slug', 'Mussel', 'Isopod', 'Sea Snail',
    'Shrimp', 'Lobster', 'Barnacle', 'Oyster'
  ];
  const KNOWN_FISH_SET = new Set(FISH_NAMES_FULL.map(f => f.toLowerCase()));

  function isFishOrCrust(name) {
    if (!name) return false;
    if (KNOWN_FISH_SET.has(name.toLowerCase())) return true;
    if (window.SflConstants) {
      if (typeof window.SflConstants.isFish === "function" && window.SflConstants.isFish(name)) return true;
      if (typeof window.SflConstants.isCrustacean === "function" && window.SflConstants.isCrustacean(name)) return true;
    }
    return false;
  }

  const fishDataMap = new Map();
  if (Array.isArray(rawFishList)) {
    rawFishList.forEach(f => {
      if (f && f.name) {
        fishDataMap.set(f.name.toLowerCase().trim(), f);
        if (f.id) fishDataMap.set(String(f.id).toLowerCase().trim(), f);
      }
    });
  }

  function getFishData(name) {
    if (!name) return null;
    const clean = String(name).toLowerCase().trim();
    if (fishDataMap.has(clean)) return fishDataMap.get(clean);
    if (window.SflConstants && typeof window.SflConstants.getFishData === "function") {
      return window.SflConstants.getFishData(name);
    }
    return null;
  }

  function getFishYieldAndBuffs(fishName) {
    const fishInfo = getFishData(fishName);
    const tier = fishInfo?.tier || "basic";
    const seasons = fishInfo?.seasons || [];

    const userState = window.SflUserState && typeof window.SflUserState.getState === "function"
      ? window.SflUserState.getState()
      : null;

    let fishYield = 1.0;
    let bonusTags = [];
    let seasonalMatches = [];

    if (window.SflFishing && typeof window.SflFishing.calculateFishYield === "function") {
      const yieldRes = window.SflFishing.calculateFishYield(tier, seasons, userState);
      fishYield = Math.max(1, yieldRes.yield || 1);
      bonusTags = yieldRes.bonusTags || [];
      seasonalMatches = yieldRes.seasonalMatches || [];
    }

    const hasAncientRod = Boolean(
      window.sflHasAncientRod ||
      (activeBuffs && (activeBuffs.has("Ancient Rod") || activeBuffs.has("224"))) ||
      (activeSkills && activeSkills["Ancient Rod"])
    );

    const activeBuffItems = [];

    if (hasAncientRod) {
      activeBuffItems.push({
        name: "Ancient Rod",
        desc: "Caña gratis (0 FLOWER)",
        img: "/img/sunflowerland/powerups/wearables/Ancient Rod.webp",
      });
    }
    if (activeBuffs && (activeBuffs.has("Walrus") || activeBuffs.has("9025") || (activeSkills && activeSkills["Walrus"]))) {
      activeBuffItems.push({
        name: "Walrus",
        desc: "+1 pez garantizado",
        img: "/img/sunflowerland/powerups/walrus.webp",
      });
    }
    if (tier === "basic" && activeBuffs && (activeBuffs.has("Alba") || activeBuffs.has("9026") || (activeSkills && activeSkills["Alba"]))) {
      activeBuffItems.push({
        name: "Alba",
        desc: "+50% prob. +1 pez básico",
        img: "/img/sunflowerland/powerups/alba.webp",
      });
    }
    if (activeBuffs && (activeBuffs.has("Dumbo Octopus") || activeBuffs.has("9027") || (activeSkills && activeSkills["Dumbo Octopus"]))) {
      activeBuffItems.push({
        name: "Dumbo Octopus",
        desc: "+20% prob. +1 pez",
        img: "/img/sunflowerland/powerups/dumbo_octopus.webp",
      });
    }
    if (activeBuffs && (activeBuffs.has("Sunflower Rod") || activeBuffs.has("9021") || (activeSkills && activeSkills["Sunflower Rod"]))) {
      activeBuffItems.push({
        name: "Sunflower Rod",
        desc: "+10% prob. +1 pez",
        img: "/img/sunflowerland/fish/a/sunflower_rod.webp",
      });
    }
    if (activeBuffs && (activeBuffs.has("Trident") || activeBuffs.has("9022") || (activeSkills && activeSkills["Trident"]))) {
      activeBuffItems.push({
        name: "Trident",
        desc: "+20% prob. +1 pez",
        img: "/img/sunflowerland/fish/a/tirdent.webp",
      });
    }
    if (activeBuffs && (activeBuffs.has("Fisher's Hourglass") || activeBuffs.has("9015") || (activeSkills && activeSkills["Fisher's Hourglass"]))) {
      activeBuffItems.push({
        name: "Fisher's Hourglass",
        desc: "+50% prob. +1 pez",
        img: "/img/sunflowerland/aoe/fishers_hourglass.webp",
      });
    }
    if (activeBuffs && (activeBuffs.has("Shrimp Onesie") || activeBuffs.has("562") || (activeSkills && activeSkills["Shrimp Onesie"]))) {
      activeBuffItems.push({
        name: "Shrimp Onesie",
        desc: "+1 pez cada 15 lances (+6.67%)",
        img: "/img/sunflowerland/powerups/wearables/shrimp_onesie.webp",
      });
    }
    if (activeBuffs && (activeBuffs.has("Otty the Otter") || activeBuffs.has("3050") || (activeSkills && activeSkills["Otty the Otter"]))) {
      activeBuffItems.push({
        name: "Otty the Otter",
        desc: "+1 pez cada 15 lances (+6.67%)",
        img: "/img/sunflowerland/powerups/otty_the_otter.webp",
      });
    }
    if (activeBuffs && (activeBuffs.has("Fish Frenzy") || activeBuffs.has("9020") || (activeSkills && activeSkills["Fish Frenzy"]))) {
      activeBuffItems.push({
        name: "Fish Frenzy",
        desc: "Día de Frenesí (+1 pez)",
        img: "/img/sunflowerland/aoe/frenzied_fish.webp",
      });
    }
    if (activeSkills && activeSkills["Frenzied Fish"]) {
      activeBuffItems.push({
        name: "Frenzied Fish",
        desc: `Frenzied Fish R${activeSkills["Frenzied Fish"]}`,
        img: "/img/sunflowerland/aoe/frenzied_fish.webp",
        isSkill: true,
      });
    }
    if (tier === "basic" && activeSkills && activeSkills["Fishy Chance"]) {
      activeBuffItems.push({
        name: "Fishy Chance",
        desc: `Fishy Chance R${activeSkills["Fishy Chance"]}`,
        img: "/img/sunflowerland/skills/fishy_chance.webp",
        isSkill: true,
      });
    }
    if (tier === "advanced" && activeSkills && activeSkills["Fishy Roll"]) {
      activeBuffItems.push({
        name: "Fishy Roll",
        desc: `Fishy Roll R${activeSkills["Fishy Roll"]}`,
        img: "/img/sunflowerland/skills/fishy_roll.webp",
        isSkill: true,
      });
    }
    if (tier === "expert" && activeSkills && activeSkills["Fishy Gamble"]) {
      activeBuffItems.push({
        name: "Fishy Gamble",
        desc: `Fishy Gamble R${activeSkills["Fishy Gamble"]}`,
        img: "/img/sunflowerland/skills/fishy_gamble.webp",
        isSkill: true,
      });
    }
    if (activeSkills && activeSkills["Angler"]) {
      activeBuffItems.push({
        name: "Angler",
        desc: `Angler R${activeSkills["Angler"]}`,
        img: "/img/sunflowerland/skills/angler.webp",
        isSkill: true,
      });
    }
    if (seasonalMatches.length > 0) {
      const mainMatch = seasonalMatches[0];
      activeBuffItems.push({
        name: mainMatch.name,
        desc: seasonalMatches.length > 1
          ? `Bono Estacional (+1 pez en temporada: ${seasonalMatches.map((s) => s.season).join(", ")})`
          : mainMatch.desc,
        img: mainMatch.img,
      });
    }

    return {
      fishYield,
      bonusTags,
      activeBuffItems,
    };
  }

  function renderFishingBuffsBar(yieldAndBuffs, extraClasses = "") {
    if (!yieldAndBuffs) return "";
    const fishYield = yieldAndBuffs.fishYield || 1.0;
    if (yieldAndBuffs.activeBuffItems.length === 0 && fishYield <= 1) return "";

    const yieldBadgeHtml = fishYield > 1
      ? `<span class="text-cyan-400 font-bold shrink-0 text-[10px] font-mono leading-none" title="${yieldAndBuffs.bonusTags.join(', ')}">(~${fishYield.toFixed(2)}x)</span>`
      : "";

    const buffImgs = yieldAndBuffs.activeBuffItems
      .map((b) => {
        const isNonStandardSkill = Boolean(b.isSkill && b.img && !b.img.startsWith("/img/sunflowerland/skills/"));
        const overlayRayHtml = isNonStandardSkill
          ? `<img src="/img/sunflowerland/123/energy.png" alt="Skill" class="absolute -top-1 -left-1 w-2 h-2 object-contain [image-rendering:pixelated] drop-shadow pointer-events-none z-10" />`
          : "";
        return `
          <div class="relative shrink-0">
            <img src="${b.img}" alt="${b.name}" title="${b.name}: ${b.desc}" onerror="this.onerror=null; this.src='/img/cripto/sunflowerland.webp';" class="w-3.5 h-3.5 object-contain [image-rendering:pixelated] rounded bg-white/5 border border-white/10 shrink-0 hover:scale-125 transition-transform cursor-help" loading="lazy" />
            ${overlayRayHtml}
          </div>
        `;
      })
      .join("");

    return `
      <div class="flex items-center gap-1.5 text-[10px] font-mono flex-wrap ${extraClasses}">
        <img src="/img/sunflowerland/123/energy.png" alt="Energy" class="w-3.5 h-3.5 object-contain [image-rendering:pixelated] shrink-0" />
        ${yieldBadgeHtml}
        <div class="flex items-center flex-wrap gap-1">
          ${buffImgs}
        </div>
      </div>
    `;
  }

  function getIngredientImg(ing) {
    if (ing && typeof ing === 'object' && ing.image) return ing.image;
    const name = typeof ing === 'string' ? ing : (ing?.name || '');
    const recipeMatch = recipesData.find(r => r.name === name);
    if (recipeMatch && recipeMatch.image) return recipeMatch.image;
    if (name === 'Magic Mushroom') return '/img/sunflowerland/123/magic_mushroom.webp';
    if (name === 'Wild Mushroom') return '/img/sunflowerland/123/wild_mushroom.webp';
    if (name === 'Seaweed') return '/img/sunflowerland/fish/a/seaweed.webp';
    if (name === 'Fish Flake') return '/img/sunflowerland/fish/a/fish_flake.webp';
    if (name === 'Fish Stick') return '/img/sunflowerland/fish/a/fish_stick.webp';
    if (name === 'Crab Stick') return '/img/sunflowerland/fish/a/Crab Stick.png';
    if (name === 'Fish Oil') return '/img/sunflowerland/fish/a/fish_oil.webp';
    if (name === 'Truffle') return '/img/sunflowerland/truffle.webp';
    if (name === 'Salt') return '/img/sunflowerland/Salt.png';
    if (name === 'Rod') return '/img/sunflowerland/tools/Rod.png';
    if (name === 'Ancient Rod') return '/img/sunflowerland/powerups/wearables/Ancient Rod.webp';
    if (name === 'Crab Pot') return '/img/sunflowerland/tools/Crab Pot.png';
    if (name === 'Mariner Pot') return '/img/sunflowerland/tools/Mariner Pot.png';
    if (name === 'Earthworm') return '/img/sunflowerland/fish/a/Earthworm.png';
    if (name === 'Grub') return '/img/sunflowerland/fish/a/Grub.png';
    if (name === 'Red Wiggler') return '/img/sunflowerland/fish/a/Red Wiggler.png';
    if (name === 'Fishing Lure') return '/img/sunflowerland/fish/a/Fishing Lure.png';
    if (name === 'Capsule Bait') return '/img/sunflowerland/Capsule Bait.png';
    if (name === 'Crimson Baitfish') return '/img/sunflowerland/Crimson Baitfish.png';
    if (name === 'Umbrella Bait') return '/img/sunflowerland/Umbrella Bait.png';
    if (isFishOrCrust(name)) return `/img/sunflowerland/fish/${name}.png`;
    return `/img/sunflowerland/${name}.png`;
  }

  function getIngredientPriceInfo(ingName, amt) {
    let unitFlower = 0;
    const flowerUsd = window.sflFlowerPrice || 0.0854;
    const isFish = isFishOrCrust(ingName);

    if (isFish) {
      if (fishCatchCostCache.has(ingName)) {
        unitFlower = fishCatchCostCache.get(ingName);
      } else if (window.SflPrices && typeof window.SflPrices.getUnitCost === "function") {
        const costObj = window.SflPrices.getUnitCost(ingName, flowerUsd);
        if (costObj && costObj.flower > 0) {
          unitFlower = costObj.flower;
        }
        fishCatchCostCache.set(ingName, unitFlower);
      } else if (window.SflConstants && typeof window.SflConstants.calculateFishCatchCost === "function") {
        const catchObj = window.SflConstants.calculateFishCatchCost(ingName, {
          coinsPerFlower: window.sflBestCoinsPerFlower || 1330,
          flowerPriceUsd: flowerUsd,
          resolveBasePrice: (n) => priceDict[n] || (window.SflMarket ? window.SflMarket.getItemPrice(n) : 0),
        });
        if (catchObj && catchObj.totalFlower > 0) {
          unitFlower = catchObj.totalFlower;
        }
        fishCatchCostCache.set(ingName, unitFlower);
      }
    } else if (priceDict[ingName] !== undefined && priceDict[ingName] > 0) {
      unitFlower = priceDict[ingName];
    } else if (window.SflMarket && typeof window.SflMarket.getItemPrice === "function" && window.SflMarket.getItemPrice(ingName) > 0) {
      unitFlower = window.SflMarket.getItemPrice(ingName);
    } else if (ingName.startsWith("Aged ") && window.SflPrices && typeof window.SflPrices.getUnitCost === "function") {
      if (fishCatchCostCache.has(ingName)) {
        unitFlower = fishCatchCostCache.get(ingName);
      } else {
        const costObj = window.SflPrices.getUnitCost(ingName, flowerUsd);
        if (costObj && costObj.flower > 0) {
          unitFlower = costObj.flower;
        }
        fishCatchCostCache.set(ingName, unitFlower);
      }
    } else if (ingName === "Fish Flake") {
      unitFlower = (window.sflCustomFishFlakeCost !== null && window.sflCustomFishFlakeCost !== undefined && window.sflCustomFishFlakeCost >= 0)
        ? window.sflCustomFishFlakeCost
        : (window.sflAutoFishFlakeCost || (window.SflPrices ? window.SflPrices.getUnitCost("Fish Flake").flower : 0));
    } else if (ingName === "Fish Stick") {
      unitFlower = (window.sflCustomFishStickCost !== null && window.sflCustomFishStickCost !== undefined && window.sflCustomFishStickCost >= 0)
        ? window.sflCustomFishStickCost
        : (window.sflAutoFishStickCost || (window.SflPrices ? window.SflPrices.getUnitCost("Fish Stick").flower : 0));
    } else if (ingName === "Fish Oil") {
      unitFlower = (window.sflCustomFishOilCost !== null && window.sflCustomFishOilCost !== undefined && window.sflCustomFishOilCost >= 0)
        ? window.sflCustomFishOilCost
        : (window.sflAutoFishOilCost || (window.SflPrices ? window.SflPrices.getUnitCost("Fish Oil").flower : 0));
    } else if (ingName === "Crab Stick") {
      unitFlower = (window.sflCustomCrabStickCost !== null && window.sflCustomCrabStickCost !== undefined && window.sflCustomCrabStickCost >= 0)
        ? window.sflCustomCrabStickCost
        : (window.sflAutoCrabStickCost || (window.SflPrices ? window.SflPrices.getUnitCost("Crab Stick").flower : 0));
    } else if ((ingName === "Rod" || ingName === "Ancient Rod") && window.sflRodCost) {
      unitFlower = window.sflRodCost;
    } else if (window.SflPrices && typeof window.SflPrices.getUnitCost === "function") {
      const costObj = window.SflPrices.getUnitCost(ingName, flowerUsd);
      if (costObj && costObj.flower > 0) {
        unitFlower = costObj.flower;
      }
    }

    const totalFlower = unitFlower * amt;
    const totalUsd = totalFlower * flowerUsd;

    return {
      unitFlower,
      totalFlower,
      totalUsd,
      isFishOrCrust: isFish,
    };
  }

  function getFishCaptureBreakdown(fishName) {
    if (!fishName) return null;

    const isTrap = window.SflConstants && typeof window.SflConstants.isCrustacean === "function" && window.SflConstants.isCrustacean(fishName);
    const hasAncient = Boolean(
      window.sflHasAncientRod ||
      (activeBuffs && (activeBuffs.has("Ancient Rod") || activeBuffs.has("224"))) ||
      (activeSkills && activeSkills["Ancient Rod"])
    );
    const defaultRod = isTrap ? "Crab Pot" : (hasAncient ? "Ancient Rod" : "Rod");

    // 1. Verificar si el usuario tiene una combinación guardada en SflUserState
    const userCombo = window.SflUserState && typeof window.SflUserState.getFishCombo === "function"
      ? (window.SflUserState.getFishCombo(fishName) || window.SflUserState.getFishCombo(fishName.toLowerCase()))
      : null;

    if (userCombo && (userCombo.bait || isTrap)) {
      const rodName = isTrap ? (userCombo.bait || "Crab Pot") : defaultRod;
      const baitName = isTrap ? null : userCombo.bait;
      const chumName = userCombo.chum || null;
      const chumAmt = userCombo.chumAmount || 1;

      return {
        rod: { name: rodName, amount: 1, img: getIngredientImg(rodName) },
        bait: baitName ? { name: baitName, amount: 1, img: getIngredientImg(baitName) } : null,
        chum: chumName ? { name: chumName, amount: chumAmt, img: getIngredientImg(chumName) } : null,
      };
    }

    // 2. Si no hay combo personalizado, resolver desde SflPrices.resolveCost
    if (window.SflPrices && typeof window.SflPrices.resolveCost === "function") {
      try {
        const costRes = window.SflPrices.resolveCost(fishName);
        if (costRes && costRes.ingredients && costRes.ingredients.length > 0) {
          const first = costRes.ingredients[0];
          const isRodOrTrap = ["Rod", "Ancient Rod", "Crab Pot", "Mariner Pot"].includes(first.name);
          const rodName = isRodOrTrap ? first.name : defaultRod;

          let baitItem = null;
          let chumItem = null;

          if (isTrap) {
            if (costRes.ingredients.length > 1) {
              const c = costRes.ingredients[1];
              chumItem = { name: c.name, amount: c.amount || 1, img: getIngredientImg(c.name) };
            }
          } else {
            if (costRes.ingredients.length > 1) {
              const b = costRes.ingredients[1];
              baitItem = { name: b.name, amount: b.amount || 1, img: getIngredientImg(b.name) };
            }
            if (costRes.ingredients.length > 2) {
              const c = costRes.ingredients[2];
              chumItem = { name: c.name, amount: c.amount || 1, img: getIngredientImg(c.name) };
            }
          }

          return {
            rod: { name: rodName, amount: 1, img: getIngredientImg(rodName) },
            bait: baitItem,
            chum: chumItem,
          };
        }
      } catch (e) {
        console.warn("[CookingView] Error resolviendo ingredientes de captura:", fishName, e);
      }
    }

    return {
      rod: { name: defaultRod, amount: 1, img: getIngredientImg(defaultRod) },
      bait: isTrap ? null : { name: "Earthworm", amount: 1, img: getIngredientImg("Earthworm") },
      chum: null,
    };
  }

  function formatPriceDisplay(flower, usd, mode = "flower") {
    if (mode === "usd") {
      if (usd <= 0) return `<span class="text-emerald-400/90 font-mono text-[10px] lg:text-[11px]">~$0.00</span>`;
      const decimals = usd >= 10 ? 2 : (usd >= 1 ? 2 : (usd >= 0.01 ? 3 : 4));
      return `<span class="text-emerald-400/90 font-mono text-[10px] lg:text-[11px]">~$${formatNumber(usd, decimals)}</span>`;
    }
    const flowerImg = `<img src="/img/sunflowerland/flower.jpg" class="w-3.5 h-3.5 rounded-full object-cover shrink-0 inline-block align-middle" alt="FLOWER" />`;
    if (flower <= 0) return `${flowerImg} <span class="text-white/80 font-mono text-[10px] lg:text-[11px]">0</span>`;
    const decimals = flower >= 10 ? 2 : (flower >= 1 ? 2 : (flower >= 0.01 ? 3 : 4));
    return `${flowerImg} <span class="text-white/90 font-mono text-[10px] lg:text-[11px]">${formatNumber(flower, decimals)}</span>`;
  }

  const searchInput = document.getElementById("searchInput")
  const loadingState = document.getElementById("loadingState")
  const dataContainer = document.getElementById("dataContainer")
  const tableBody = document.getElementById("tableBody")

  let recipesData = (sflRecipes.recipes || []).filter(r => !r.hidden)
  let priceDict = {}

  window.currentSort = { column: "xpsfl", direction: "desc" }
  let currentCategory = "all"
  
  let renderTable = (searchTerm = "") => {
    if (typeof window.renderTable === "function") {
      window.renderTable(searchTerm);
    }
  };

  window.currentHideXpLimit = 1000;
  window.setHideXpLimit = (limit, source = 'preset', triggerInput = null) => {
    window.currentHideXpLimit = limit;
    
    // Botones del Dashboard
    document.querySelectorAll('.dash-hide-xp-btn').forEach(btn => {
      const minXp = parseInt(btn.dataset.minXp);
      if (source !== 'custom' && minXp === limit) {
        btn.classList.add('active', 'bg-emerald-500/20', 'text-emerald-400', 'border-emerald-500/40');
        btn.classList.remove('bg-[#141414]', 'text-white/60', 'border-white/10');
      } else {
        btn.classList.remove('active', 'bg-emerald-500/20', 'text-emerald-400', 'border-emerald-500/40');
        btn.classList.add('bg-[#141414]', 'text-white/60', 'border-white/10');
      }
    });

    // Botones de la Tabla
    document.querySelectorAll('.hide-xp-btn').forEach(btn => {
      const xp = parseInt(btn.dataset.xp);
      if (source !== 'custom' && xp === limit && limit > 0) {
        btn.classList.add('active', 'bg-emerald-500/20', 'text-emerald-400', 'border-emerald-500/40');
        btn.classList.remove('bg-white/5', 'text-white/50', 'border-white/10');
      } else {
        btn.classList.remove('active', 'bg-emerald-500/20', 'text-emerald-400', 'border-emerald-500/40');
        btn.classList.add('bg-white/5', 'text-white/50', 'border-white/10');
