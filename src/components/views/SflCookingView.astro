          </div>

          <!-- 4. Fish Stick (Clic para editar costo) -->
          <div class="flex items-center gap-3 sm:justify-center pt-2 sm:pt-0 sm:pl-3" title={t("sfl.cooking.dash.clickToEditStick")}>
