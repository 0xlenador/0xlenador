            <!-- Métrica Principal Destacada: COSTO PROMEDIO POR SKILL (El que prima) -->
            <div class="border border-emerald-500/50 bg-emerald-950/30 rounded-xl p-3 sm:p-3.5 flex flex-col items-center justify-center text-center shadow-[0_0_20px_rgba(16,185,129,0.12)] transition-all hover:border-emerald-500/70">
