      </div>

      <!-- Fila 2: Franja Horizontal de Precios Clave (Coins, Rod, Fish Flake, Fish Stick, Crab Stick, Fish Oil) -->
      <div class="w-full bg-[#18181b]/95 border border-white/10 rounded-2xl p-3 sm:px-4 sm:py-3.5 shadow-xl backdrop-blur-md">
