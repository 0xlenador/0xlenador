---
// ============================================================
// src/components/views/SflCookingView.astro
// View puro para la herramienta de cocina SFL.
// Fuente única de verdad: consumido por sfl-cocinando.astro y en/sfl-cooking.astro.
// El idioma se detecta desde la URL vía getLangFromUrl.
// ============================================================
import { getEntry } from "astro:content"
import { getLangFromUrl, useTranslations } from "../../i18n/utils"
import SflToolLayout from "../SflToolLayout.astro"

const sflRecipesEntry = await getEntry("sfl", "recipes")
const sflIdsEntry = await getEntry("sfl", "resources")
const sflBuffsEntry = await getEntry("sfl", "calculo_buffs")
const sflPowerUpsDataEntry = await getEntry("sfl", "powerups")
const sflSkillsEntry = await getEntry("sfl", "skills")
const sflRecipes = sflRecipesEntry.data
const sflIds = sflIdsEntry.data
const sflBuffs = sflBuffsEntry.data
const sflPowerUpsData = sflPowerUpsDataEntry.data.power_ups
const sflSkills = { ...(sflSkillsEntry.data.Cooking || {}) }
if (sflSkillsEntry.data.Fishing && sflSkillsEntry.data.Fishing["Fishy Feast"]) {
  sflSkills["Fishy Feast"] = sflSkillsEntry.data.Fishing["Fishy Feast"]
}
const sflOthers = sflSkillsEntry.data.Others || {}
const sflConsumables = sflSkillsEntry.data.Consumables || {}

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)

const formatAstroDescription = (skill) => {
  let desc = skill.description || "";
  if (skill.mathematics_1?.calc_by_rank?.rank_1 !== undefined) {
    const m1 = skill.mathematics_1.calc_by_rank.rank_1;
    desc = desc.replace("{math1}", m1).replace("{math1_pct}", parseFloat((m1 * 100).toFixed(2))).replace("{math1_days}", parseFloat((m1 / 86400000).toFixed(2)));
  }
  if (skill.mathematics_2?.calc_by_rank?.rank_1 !== undefined) {
    const m2 = skill.mathematics_2.calc_by_rank.rank_1;
    desc = desc.replace("{math2}", m2).replace("{math2_pct}", parseFloat((m2 * 100).toFixed(2))).replace("{math2_days}", parseFloat((m2 / 86400000).toFixed(2)));
  }
  return desc;
};
---

<SflToolLayout activeTab="cocinando">

    <div class="mb-4 relative z-10 text-center sm:text-left">
      <h1 class="text-3xl md:text-4xl font-black text-white tracking-tighter mb-3">
        {t("sfl.cooking.heading")}
        <span class="text-emerald-500"> {t("sfl.cooking.heading.accent")}</span>
      </h1>
      <p class="text-terminal-secondary text-sm leading-relaxed max-w-2xl">
        {t("sfl.cooking.intro")}
      </p>
    </div>

    <!-- Boosts (PowerUps & Skills) -->
    <div class="mb-8 relative z-10 bg-white/[0.02] border border-white/5 rounded-2xl p-5">
      <h3 class="text-sm font-bold text-white mb-4 uppercase tracking-wider flex items-center gap-2">
        <span class="text-emerald-500">✨</span> Boosts
      </h3>
      
      <!-- PowerUps Sub-group -->
      <details class="group mb-6" open>
        <summary class="flex items-center cursor-pointer text-xs font-bold text-white/60 uppercase tracking-wider mb-3 hover:text-emerald-400 transition-colors list-none">
          <span class="mr-2 transform group-open:rotate-90 transition-transform text-emerald-500/50">▶</span> PowerUps
        </summary>
        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 xl:grid-cols-7 gap-2 w-full pl-1">
          {
            Object.entries(sflBuffs).map(([id, buff]) => {
              const group = buff.type + "s";
              const imgFile = sflPowerUpsData[group]?.[id]?.image || `${buff.name}.webp`;
              const mainSrc = `/img/sunflowerland/powerups/${imgFile}`;
              const fallbackSrc = `/img/sunflowerland/powerups/wearables/${imgFile}`;
              const errorFallback = `/img/cripto/sunflowerland.webp`;
              
              return (
              <label class="buff-card group flex items-center gap-2 cursor-pointer bg-white/5 border border-white/5 hover:border-emerald-500/30 hover:bg-emerald-500/10 rounded-lg p-1.5 transition-all">
                <input type="checkbox" class="buff-checkbox w-3.5 h-3.5 rounded border-white/20 bg-white/5 text-emerald-500 focus:ring-emerald-500/50" data-buff-id={id} />
                <img src={mainSrc} class="w-6 h-6 object-contain drop-shadow-sm group-hover:scale-110 transition-transform" onerror={`this.onerror=null; this.src='${fallbackSrc}'; this.onerror=function(){this.src='${errorFallback}'};`} alt={buff.name} title={buff.boost} />
                <div class="flex flex-col">
                  <span class="text-[10px] font-bold text-white group-[.active]:text-emerald-400 group-hover:text-emerald-400 transition-colors">{buff.name}</span>
                  <span class="text-[9px] text-terminal-muted leading-tight" title={buff.boost}>{buff.boost}</span>
                </div>
              </label>
              );
            })
          }
        </div>
      </details>

      <!-- Skills Sub-group -->
      <details class="group mb-6" open>
        <summary class="flex items-center cursor-pointer text-xs font-bold text-white/60 uppercase tracking-wider mb-3 hover:text-blue-400 transition-colors list-none">
          <span class="mr-2 transform group-open:rotate-90 transition-transform text-blue-500/50">▶</span> Skills
        </summary>
        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 xl:grid-cols-7 gap-2 w-full pl-1">
          {
            Object.entries(sflSkills).map(([skillName, skillData]) => {
              const mainSrc = skillData.image;
              const fallbackSrc = `/img/cripto/sunflowerland.webp`;
                const formattedDesc = formatAstroDescription(skillData);
              
              return (

              <div class={`skill-card flex flex-col bg-white/5 border border-white/5 rounded-lg p-1.5 transition-all group ${skillData.disabled ? "opacity-30 grayscale cursor-not-allowed" : "hover:border-blue-500/30 hover:bg-blue-500/5 cursor-pointer"}`} data-skill-id={skillName} style={skillData.disabled ? "pointer-events: none;" : ""}>
                <div class="flex items-start gap-2 mb-1.5 pointer-events-none">
                  <img src={mainSrc} class="w-6 h-6 object-contain drop-shadow-sm group-hover:scale-110 transition-transform shrink-0" onerror={`this.onerror=null; this.src='${fallbackSrc}';`} alt={skillName} title={formattedDesc} />
                  <div class="flex flex-col">
                    <span class="text-[10px] font-bold text-white group-[.active]:text-blue-400 transition-colors">{skillName}</span>
                    <span class="skill-description-text text-[9px] text-terminal-muted leading-tight" title={formattedDesc} data-original={skillData.description}>{formattedDesc}</span>
                  </div>
                </div>
                
                {skillData.cost_by_rank && Object.keys(skillData.cost_by_rank).length > 0 && (
                  <div class="flex items-center gap-2.5 mt-auto pt-1.5 border-t border-white/10" onclick="event.stopPropagation()">
                    {Object.keys(skillData.cost_by_rank).map((rankKey, idx) => (
                      <label class="flex items-center gap-1 cursor-pointer hover:opacity-80 transition-opacity">
                        <input type="checkbox" value={idx + 1} class={`skill-rank-checkbox w-2.5 h-2.5 rounded-sm text-blue-500 bg-white/5 border-white/20 focus:ring-blue-500/50 rank-input-${skillName.replace(/\s+/g, '_')}`} data-skill-id={skillName} data-rank={idx + 1} />
                        <span class="text-[8px] font-mono font-bold text-white/50">R{idx + 1}</span>
                      </label>
                    ))}
                  </div>
                )}
              </div>
              );
            })
          }
        </div>
      </details>

        <details class="group mb-6" open>
          <summary class="flex items-center cursor-pointer text-xs font-bold text-white/60 uppercase tracking-wider mb-3 hover:text-purple-400 transition-colors list-none">
            <span class="mr-2 transform group-open:rotate-90 transition-transform text-purple-500/50">▶</span> Others
          </summary>
          <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 xl:grid-cols-7 gap-2 w-full pl-1">
            {
              Object.entries(sflOthers).map(([skillName, skillData]) => {
                const mainSrc = skillData.image;
                const fallbackSrc = `/img/cripto/sunflowerland.webp`;
                const formattedDesc = formatAstroDescription(skillData);
                
                return (
                <div class={`skill-card flex flex-col bg-white/5 border border-white/5 rounded-lg p-1.5 transition-all group ${skillData.disabled ? "opacity-30 grayscale cursor-not-allowed" : "hover:border-purple-500/30 hover:bg-purple-500/5 cursor-pointer"}`} data-skill-id={skillName} style={skillData.disabled ? "pointer-events: none;" : ""}>
                  <div class="flex items-start gap-2 mb-1.5 pointer-events-none">
                    <img src={mainSrc} class="w-6 h-6 object-contain drop-shadow-sm group-hover:scale-110 transition-transform shrink-0" onerror={`this.onerror=null; this.src='${fallbackSrc}';`} alt={skillName} title={formattedDesc} />
                    <div class="flex flex-col">
                      <span class="text-[10px] font-bold text-white group-[.active]:text-purple-400 transition-colors">{skillName}</span>
                      <span class="skill-description-text text-[9px] text-terminal-muted leading-tight" title={formattedDesc} data-original={skillData.description}>{formattedDesc}</span>
                    </div>
                  </div>
                  
                  {skillData.cost_by_rank && Object.keys(skillData.cost_by_rank).length > 0 && (
                    <div class="flex items-center gap-2.5 mt-auto pt-1.5 border-t border-white/10" onclick="event.stopPropagation()">
                      {Object.keys(skillData.cost_by_rank).map((rankKey, idx) => {
                        const isFaction = skillName === "Faction Pet";
                        const labels = ["10%", "20%", "30%", "50%"];
                        const labelText = isFaction ? labels[idx] : `R${idx + 1}`;
                        
                        return (
                        <label class="flex items-center gap-1 cursor-pointer hover:opacity-80 transition-opacity">
                          <input type="checkbox" value={idx + 1} class={`skill-rank-checkbox w-2.5 h-2.5 rounded-sm text-purple-500 bg-white/5 border-white/20 focus:ring-purple-500/50 rank-input-${skillName.replace(/\s+/g, '_')}`} data-skill-id={skillName} data-rank={idx + 1} />
                          <span class="text-[8px] font-mono font-bold text-white/50">{labelText}</span>
                        </label>
                        );
                      })}
                    </div>
                  )}
                </div>
                );
              })
            }
          </div>
        </details>

        <details class="group mb-6" open>
          <summary class="flex items-center cursor-pointer text-xs font-bold text-white/60 uppercase tracking-wider mb-3 hover:text-orange-400 transition-colors list-none">
            <span class="mr-2 transform group-open:rotate-90 transition-transform text-orange-500/50">▶</span> Consumables
          </summary>
          <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 xl:grid-cols-7 gap-2 w-full pl-1">
            {
              Object.entries(sflConsumables).map(([skillName, skillData]) => {
                const mainSrc = skillData.image;
                const fallbackSrc = `/img/cripto/sunflowerland.webp`;
                const formattedDesc = formatAstroDescription(skillData);
                
                return (
                <div class={`skill-card flex flex-col bg-white/5 border border-white/5 rounded-lg p-1.5 transition-all group ${skillData.disabled ? "opacity-30 grayscale cursor-not-allowed" : "hover:border-orange-500/30 hover:bg-orange-500/5 cursor-pointer"}`} data-skill-id={skillName} style={skillData.disabled ? "pointer-events: none;" : ""}>
                  <div class="flex items-start gap-2 mb-1.5 pointer-events-none">
                    <img src={mainSrc} class="w-6 h-6 object-contain drop-shadow-sm group-hover:scale-110 transition-transform shrink-0" onerror={`this.onerror=null; this.src='${fallbackSrc}';`} alt={skillName} title={formattedDesc} />
                    <div class="flex flex-col">
                      <span class="text-[10px] font-bold text-white group-[.active]:text-orange-400 transition-colors">{skillName}</span>
                      <span class="skill-description-text text-[9px] text-terminal-muted leading-tight" title={formattedDesc} data-original={skillData.description}>{formattedDesc}</span>
                    </div>
                  </div>
                </div>
                );
              })
            }
          </div>
        </details>

    </div>

    <!-- Controles y Filtros -->
    <div
      class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-8 relative z-10"
    >
      <div class="flex gap-2 overflow-x-auto w-full sm:w-auto pb-2 sm:pb-0 no-scrollbar">
        <button
          class="category-btn active px-4 py-2 bg-emerald-500/20 text-emerald-400 border border-emerald-500/30 rounded-xl text-xs font-bold uppercase tracking-wider hover:bg-emerald-500/30 transition-colors whitespace-nowrap shrink-0"
          data-category="all"
        >
          {t("sfl.cooking.filter.all")}
        </button>
        <button
          class="category-btn px-4 py-2 bg-white/5 text-white/40 border border-white/10 rounded-xl text-xs font-bold uppercase tracking-wider hover:bg-white/10 hover:text-white transition-colors whitespace-nowrap shrink-0"
          data-category="Fire Pit"
        >
          Fire Pit
        </button>
        <button
          class="category-btn px-4 py-2 bg-white/5 text-white/40 border border-white/10 rounded-xl text-xs font-bold uppercase tracking-wider hover:bg-white/10 hover:text-white transition-colors whitespace-nowrap shrink-0"
          data-category="Kitchen"
        >
          Kitchen
        </button>
        <button
          class="category-btn px-4 py-2 bg-white/5 text-white/40 border border-white/10 rounded-xl text-xs font-bold uppercase tracking-wider hover:bg-white/10 hover:text-white transition-colors whitespace-nowrap shrink-0"
          data-category="Deli"
        >
          Deli
        </button>
        <button
          class="category-btn px-4 py-2 bg-white/5 text-white/40 border border-white/10 rounded-xl text-xs font-bold uppercase tracking-wider hover:bg-white/10 hover:text-white transition-colors whitespace-nowrap shrink-0"
          data-category="Smoothie Shack"
        >
          Smoothie Shack
        </button>
        <button
          class="category-btn px-4 py-2 bg-white/5 text-white/40 border border-white/10 rounded-xl text-xs font-bold uppercase tracking-wider hover:bg-white/10 hover:text-white transition-colors whitespace-nowrap shrink-0"
          data-category="Bakery"
        >
          Bakery
        </button>
      </div>

      <div class="relative w-full sm:w-72 shrink-0">
        <input
          type="text"
          id="searchInput"
          placeholder={t("sfl.cooking.search.placeholder")}
          class="w-full bg-white/5 border border-white/10 rounded-xl px-4 py-2.5 text-sm text-white placeholder-white/30 focus:outline-none focus:ring-2 focus:ring-emerald-500/50 focus:border-emerald-500/50 transition-all font-mono"
        />
      </div>
    </div>

    <!-- Estado de Carga -->
    <div
      id="loadingState"
      class="py-12 flex flex-col items-center justify-center gap-4 relative z-10"
    >
      <div
        class="w-8 h-8 border-2 border-emerald-500 border-t-transparent rounded-full animate-spin"
      >
      </div>
      <p class="text-terminal-muted font-mono text-xs animate-pulse">{t("sfl.cooking.loading")}</p>
    </div>



    <!-- Tabla de Recetas -->
    <div id="dataContainer" class="hidden relative z-10">
      <!-- Header Tabla Desktop -->
      <div
        class="hidden lg:grid grid-cols-[25%_10%_15%_15%_15%_20%] gap-4 px-6 py-4 bg-white/[0.02] border border-white/5 rounded-2xl mb-4"
      >
        <div
          class="text-xs font-mono text-terminal-muted uppercase tracking-wider font-semibold cursor-pointer group flex items-center gap-2"
          onclick="window.handleSort('name')"
        >
          Name <span
            class="sort-icon opacity-0 group-hover:opacity-50 transition-opacity"
            data-col="name">↕</span
          >
        </div>
        <div
          class="text-xs font-mono text-terminal-muted uppercase tracking-wider font-semibold cursor-pointer group flex items-center gap-2"
          onclick="window.handleSort('xp')"
        >
          XP <span class="sort-icon opacity-100 text-emerald-500 transition-opacity" data-col="xp"
            >↓</span
          >
        </div>
        <div
          class="text-xs font-mono text-terminal-muted uppercase tracking-wider font-semibold cursor-pointer group flex items-center gap-2"
          onclick="window.handleSort('cost')"
        >
          SFL Cost <span
            class="sort-icon opacity-0 group-hover:opacity-50 transition-opacity"
            data-col="cost">↕</span
          >
        </div>
        <div
          class="text-xs font-mono text-terminal-muted uppercase tracking-wider font-semibold cursor-pointer group flex items-center gap-2"
          onclick="window.handleSort('xpsfl')"
        >
          XP/SFL <span
            class="sort-icon opacity-0 group-hover:opacity-50 transition-opacity"
            data-col="xpsfl">↕</span
          >
        </div>
        <div
          class="text-xs font-mono text-terminal-muted uppercase tracking-wider font-semibold cursor-pointer group flex items-center gap-2"
          onclick="window.handleSort('xpday')"
        >
          XP/Day <span
            class="sort-icon opacity-0 group-hover:opacity-50 transition-opacity"
            data-col="xpday">↕</span
          >
        </div>
        <div class="text-xs font-mono text-terminal-muted uppercase tracking-wider font-semibold">
          Ingredients
        </div>
      </div>

      <!-- Body Tabla -->
      <div
        id="tableBody"
        class="flex flex-col gap-4 lg:gap-0 lg:bg-white/[0.01] lg:border lg:border-white/5 lg:rounded-3xl lg:p-2 lg:overflow-hidden relative z-10"
      >
        <!-- JS inyectará filas aquí -->
      </div>
    </div>
</SflToolLayout>

<style is:global>
  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .no-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>

<script
  define:vars={{
    sflRecipes,
    sflIds,
    sflBuffs,
    sflSkills,
      sflOthers,
      sflConsumables,
    tEmpty: t("sfl.cooking.empty"),
    tError: t("sfl.cooking.error"),
    tTime: t("sfl.cooking.col.time"),
    tInstant: t("sfl.cooking.col.instant"),
  }}
>
  const searchInput = document.getElementById("searchInput")
  const loadingState = document.getElementById("loadingState")
  const dataContainer = document.getElementById("dataContainer")
  const tableBody = document.getElementById("tableBody")

  let recipesData = sflRecipes.recipes
  let priceDict = {}

  window.currentSort = { column: "xp", direction: "desc" }
  let currentCategory = "all"
  
  let activeBuffs = new Set()
  let activeSkills = {} // Format: { "Skill Name": rank (1, 2 or 3) }

  const isTargetMatch = (item, target) => {
    if (target === "all") return true;
    if (target === "Cakes") return item.building === "Bakery" || item.name.includes("Cake");
    if (target === "Fermented Carrots") return item.name === "Fermented Carrots";
    if (target === "Cheese Recipes") return item.name.includes("Cheese") || item.ingredients.some(ing => ing.name.includes("Cheese"));
    if (target === "Fish") {
      const fishIngs = ['Anchovy', 'Butterflyfish', 'Blowfish', 'Clownfish', 'Seaweed', 'Squid', 'Red Snapper', 'Sunfish', 'Horse Mackerel', 'Tuna', 'Olive Flounder', 'Angelfish', 'Halibut', 'Surgeonfish', 'Napoleanfish', 'Zebra Turkeyfish', 'Ray', 'Hammerhead Shark', 'Great White Shark', 'Octopus', 'Mahi Mahi', 'Blue Marlin', 'Moray Eel', 'Crab', 'Starfish', 'Seahorse', 'Crab Stick', 'Fish Stick'];
      return item.name.includes("Fish") || item.ingredients.some(ing => fishIngs.includes(ing.name)) || ["Gumbo", "Chowder", "Steamed Red Snapper", "Surimi Rice Bowl"].includes(item.name);
    }
    return false;
  };

  const getCalculatedXp = (item) => {
    let finalXp = item.xp;
    let multipliers = 1;
    let additions = 0;
    
    activeBuffs.forEach(id => {
      const buff = sflBuffs[id];
      if (buff && buff.mathematics_1) {
         const math = buff.mathematics_1;
         if (math.category === "bumpkin_xp" && isTargetMatch(item, math.target_food)) {
           if (math.mathematics_operation === "multiply") {
             multipliers += (math.calc - 1); // convert 1.2 to +0.2
           } else if (math.mathematics_operation === "add") {
             additions += math.calc;
           }
         }
      }
    });
    
    // Skills Logic for XP
    activeSkills && Object.entries(activeSkills).forEach(([skillName, rank]) => {
      const skill = sflSkills[skillName] || sflOthers[skillName] || sflConsumables[skillName];
      if (!skill) return;
      const math1 = skill.mathematics_1?.calc_by_rank[`rank_${rank}`];
      
      // Others XP Buffs
      if (skillName === "VIP Pass") { multipliers += math1; }
      if (skillName === "Blossom Beard") { multipliers += math1; }
      if (skillName === "Luminous Anglerfish" && isTargetMatch(item, "Fish")) { multipliers += math1; }
      if (skillName === "Faction Pet") { multipliers += math1; }
      
      // Munching Mastery (+5% XP)
      if (skillName === "Munching Mastery") {
        multipliers += math1;
      }
      // Juicy Boost (+10% XP for Smoothie Shack)
      if (skillName === "Juicy Boost" && item.building === "Smoothie Shack") {
        multipliers += math1;
      }
      // Double Nom (+1 food = 2x XP essentially)
      if (skillName === "Double Nom") {
        multipliers += math1; // +1 = 100% more XP
      }
      // Fiery Jackpot (+20% chance of +1 food in Fire Pit)
      if (skillName === "Fiery Jackpot" && item.building === "Fire Pit") {
        multipliers += (math1 / 100); // 20% = 0.2 expected XP increase
      }
      // Fishy Feast (+20% XP for Fish)
      if (skillName === "Fishy Feast" && isTargetMatch(item, "Fish")) {
        multipliers += math1;
      }
    });
    
    return (finalXp * multipliers) + additions;
  };

  const getCalculatedTime = (item) => {
    let timeSeconds = parseTime(item.time);
    if (timeSeconds === 0) return 0;
    
    let timeMultiplier = 1;
    
    activeSkills && Object.entries(activeSkills).forEach(([skillName, rank]) => {
      const skill = sflSkills[skillName] || sflOthers[skillName] || sflConsumables[skillName];
      if (!skill) return;
      const math1 = skill.mathematics_1?.calc_by_rank[`rank_${rank}`];
      
      // Others Time Buffs
      if (skillName === "Desert Gnome") { timeMultiplier *= math1; }
      if (skillName === "Time Warp Totem") { timeMultiplier *= math1; }
      if (skillName === "Gourmet Hourglass") { timeMultiplier *= math1; }
      
      // Fast Feasts (Fire Pit and Kitchen)
      if (skillName === "Fast Feasts" && (item.building === "Fire Pit" || item.building === "Kitchen")) {
        timeMultiplier *= math1;
      }
      // Frosted Cakes (Bakery / Cakes)
      if (skillName === "Frosted Cakes" && (item.building === "Bakery" || item.name.includes("Cake"))) {
        timeMultiplier *= math1;
      }
      // Swift Sizzle (Fire Pit with oil)
      if (skillName === "Swift Sizzle" && item.building === "Fire Pit") {
        timeMultiplier *= math1;
      }
      // Turbo Fry (Kitchen with oil)
      if (skillName === "Turbo Fry" && item.building === "Kitchen") {
        timeMultiplier *= math1;
      }
      // Fry Frenzy (Deli with oil)
      if (skillName === "Fry Frenzy" && item.building === "Deli") {
        timeMultiplier *= math1;
      }
    });
    
    return timeSeconds * timeMultiplier;
  };

  const parseTime = (timeStr) => {
    if (!timeStr) return 0
    let days = 0
    let tStr = timeStr
    if (timeStr.includes("d ")) {
      const parts = timeStr.split("d ")
      days = parseInt(parts[0])
      tStr = parts[1]
    }
    const [h, m, s] = tStr.split(":").map(Number)
    return days * 86400 + h * 3600 + m * 60 + (s || 0)
  }

  const formatSeconds = (totalSeconds) => {
    if (!totalSeconds) return "00:00:00";
    let days = Math.floor(totalSeconds / 86400);
    let remaining = totalSeconds % 86400;
    let h = Math.floor(remaining / 3600);
    remaining %= 3600;
    let m = Math.floor(remaining / 60);
    let s = Math.floor(remaining % 60);
    
    let timeStr = `${h.toString().padStart(2, '0')}:${m.toString().padStart(2, '0')}:${s.toString().padStart(2, '0')}`;
    return days > 0 ? `${days}d ${timeStr}` : timeStr;
  }

  window.handleCategory = (category) => {
    currentCategory = category

    document.querySelectorAll(".category-btn").forEach((btn) => {
      if (btn.dataset.category === category) {
        btn.className =
          "category-btn active px-4 py-2 bg-emerald-500/20 text-emerald-400 border border-emerald-500/30 rounded-xl text-xs font-bold uppercase tracking-wider hover:bg-emerald-500/30 transition-colors whitespace-nowrap shrink-0"
      } else {
        btn.className =
          "category-btn px-4 py-2 bg-white/5 text-white/40 border border-white/10 rounded-xl text-xs font-bold uppercase tracking-wider hover:bg-white/10 hover:text-white transition-colors whitespace-nowrap shrink-0"
      }
    })

    renderTable(searchInput ? searchInput.value : "")
  }

  window.handleSort = (column) => {
    if (window.currentSort.column === column) {
      if (window.currentSort.direction === "none") window.currentSort.direction = "desc"
      else if (window.currentSort.direction === "desc") window.currentSort.direction = "asc"
      else window.currentSort.direction = "none"
    } else {
      window.currentSort.column = column
      window.currentSort.direction = "desc"
    }

    document.querySelectorAll(".sort-icon").forEach((icon) => {
      icon.innerHTML = "↕"
      icon.classList.remove("opacity-100", "text-emerald-500")
      icon.classList.add("opacity-0", "group-hover:opacity-50")
    })

    if (window.currentSort.direction !== "none") {
      const activeIcon = document.querySelector(`.sort-icon[data-col="${column}"]`)
      if (activeIcon) {
        activeIcon.innerHTML = window.currentSort.direction === "desc" ? "↓" : "↑"
        activeIcon.classList.remove("opacity-0", "group-hover:opacity-50")
        activeIcon.classList.add("opacity-100", "text-emerald-500")
      }
    }

    renderTable(searchInput ? searchInput.value : "")
  }

  const formatNumber = (num, decimals = 2) => {
    if (num === undefined || num === null || isNaN(num)) return "0"
    if (num > 0 && num < 0.0001) return num.toExponential(2)
    return new Intl.NumberFormat("en-US", {
      minimumFractionDigits: 0,
      maximumFractionDigits: decimals,
    }).format(num)
  }

  const calculateRecipeCost = (ingredients, visited = new Set(), isTopLevel = true) => {
    let total = 0
    let missing = false
    for (const ing of ingredients) {
      if (priceDict[ing.name]) {
        total += priceDict[ing.name] * ing.amount
      } else {
        // Buscar si el ingrediente es en realidad otra receta
        const subRecipe = recipesData.find((r) => r.name === ing.name)
        if (subRecipe && !visited.has(ing.name)) {
          visited.add(ing.name)
          const subCost = calculateRecipeCost(subRecipe.ingredients, visited, false)
          if (subCost.missing) missing = true
          total += subCost.total * ing.amount
        } else {
          missing = true
        }
      }
    }
    
    // Skills Logic for Cost (Debuffs)
    let costMultiplier = 1;
    if (isTopLevel) {
      activeSkills && Object.entries(activeSkills).forEach(([skillName, rank]) => {
        const skill = sflSkills[skillName] || sflOthers[skillName] || sflConsumables[skillName];
        if (!skill) return;
        
        // Double Nom Debuff (2x ingredients)
        if (skillName === "Double Nom" && skill.mathematics_2) {
          costMultiplier *= skill.mathematics_2.calc_by_rank[`rank_${rank}`];
        }
        // Instant Gratification Debuff (2x ingredients)
        if (skillName === "Instant Gratification") {
          // Assume default x2 since rank logic is complex for this one
          costMultiplier *= 2; 
        }
      });
    }
    
    return { total: total * costMultiplier, missing, baseTotal: total }
  }

  window.renderTable = (searchTerm = "") => {
    let filtered = recipesData.filter((item) => {
      const nameMatch = item.name.toLowerCase().includes(searchTerm.toLowerCase())
      const ingMatch = item.ingredients.some((ing) =>
        ing.name.toLowerCase().includes(searchTerm.toLowerCase()),
      )
      const matchesSearch = nameMatch || ingMatch

      const matchesCategory = currentCategory === "all" || item.building === currentCategory
      return matchesSearch && matchesCategory
    })

    if (
      window.currentSort &&
      window.currentSort.column &&
      window.currentSort.direction !== "none"
    ) {
      const { column, direction } = window.currentSort
      filtered.sort((a, b) => {
        let valA, valB
        if (column === "name") {
          valA = a.name.toLowerCase()
          valB = b.name.toLowerCase()
        } else if (column === "xp") {
          valA = getCalculatedXp(a)
          valB = getCalculatedXp(b)
        } else if (column === "cost") {
          const costA = calculateRecipeCost(a.ingredients)
          const costB = calculateRecipeCost(b.ingredients)
          valA = costA.total
          valB = costB.total
        } else if (column === "xpsfl") {
          const costA = calculateRecipeCost(a.ingredients)
          const costB = calculateRecipeCost(b.ingredients)
          valA = costA.total > 0 ? getCalculatedXp(a) / costA.total : 0
          valB = costB.total > 0 ? getCalculatedXp(b) / costB.total : 0
        } else if (column === "xpday") {
          const timeA = parseTime(a.time)
          const timeB = parseTime(b.time)
          valA = timeA > 0 ? (86400 / timeA) * getCalculatedXp(a) : 0
          valB = timeB > 0 ? (86400 / timeB) * getCalculatedXp(b) : 0
        }

        if (valA < valB) return direction === "asc" ? -1 : 1
        if (valA > valB) return direction === "asc" ? 1 : -1
        return 0
      })
    }

    tableBody.innerHTML = ""

    if (filtered.length === 0) {
      tableBody.innerHTML = `<div class="py-8 text-center text-terminal-muted text-sm">${tEmpty}</div>`
      return
    }

    filtered.forEach((item) => {
      let doubleNomMultiplier = 1;
      if (activeSkills && activeSkills["Double Nom"]) {
        const rank = activeSkills["Double Nom"];
        const math1 = sflSkills["Double Nom"]?.mathematics_1?.calc_by_rank[`rank_${rank}`] || 0;
        doubleNomMultiplier = 1 + math1;
      }
      
      const costObj = calculateRecipeCost(item.ingredients)
      const timeSeconds = getCalculatedTime(item)
      const finalXp = getCalculatedXp(item);
      const xpPerSfl = costObj.total > 0 ? finalXp / costObj.total : 0
      const xpPerDay = timeSeconds > 0 ? (86400 / timeSeconds) * finalXp : 0

      // Format visual time
      const displayTime = formatSeconds(timeSeconds);
      const displayName = doubleNomMultiplier > 1 ? `${item.name} x${doubleNomMultiplier}` : item.name;

      const row = document.createElement("div")
      row.className =
        "hover:bg-white/[0.02] transition-colors group block border border-white/5 bg-white/[0.02] rounded-[20px] p-5 lg:p-0 lg:border-0 lg:border-b lg:border-white/5 last:lg:border-b-0 lg:bg-transparent lg:rounded-none lg:grid lg:grid-cols-[25%_10%_15%_15%_15%_20%] lg:items-center lg:py-3"

      const ingredientsHtml = item.ingredients
        .map((ing) => {
          const isFood = recipesData.some((r) => r.name === ing.name)
          const basePath = isFood ? "/img/sunflowerland/food" : "/img/sunflowerland"
          const fallbackPath = isFood ? "/img/sunflowerland" : "/img/sunflowerland/food"

          return `
          <div class="flex items-center gap-2">
            <img src="${basePath}/${ing.name}.png" class="w-4 h-4 object-contain drop-shadow-sm" onerror="this.onerror=null; this.src='${fallbackPath}/${ing.name}.png'; this.onerror=function(){this.src='/img/cripto/sunflowerland.webp'};" />
            <span class="text-xs text-white/80">${ing.name} (${ing.amount * doubleNomMultiplier})</span>
          </div>
        `
        })
        .join("")

      row.innerHTML = `
        <!-- Name Column -->
        <div class="lg:px-4 font-medium text-white flex items-center justify-between lg:justify-start h-full">
          <div class="flex items-center gap-4 lg:gap-3">
            <div class="w-10 h-10 lg:w-8 lg:h-8 flex items-center justify-center shrink-0">
              <img src="/img/sunflowerland/food/${item.name}.png" alt="${item.name}" class="w-full h-full object-contain drop-shadow-sm" onerror="this.onerror=null; this.src='/img/cripto/sunflowerland.webp';" />
            </div>
            <div class="flex flex-col">
              <span class="text-sm font-semibold text-white group-hover:text-emerald-400 transition-colors">${displayName}</span>
              <span class="text-[11px] text-terminal-muted mt-0.5 ${timeSeconds < parseTime(item.time) ? 'text-blue-400' : ''}">${tTime} ${displayTime}</span>
              ${
                item.instant
                  ? `
                <div class="flex items-center gap-1 mt-0.5">
                  <span class="text-[11px] text-terminal-muted">${tInstant}</span>
                  <span class="text-[11px] font-mono text-cyan-300 flex items-center gap-1"><img src="/img/Gem.png" class="w-3 h-3" onerror="this.onerror=null; this.outerHTML='💎';" /> ${item.instant}</span>
                </div>
              `
                  : ""
              }
            </div>
          </div>
        </div>
        
        <!-- XP Column -->
        <div class="mt-2 lg:mt-0 lg:px-4 flex items-center gap-1">
          <span class="text-white text-sm font-bold ${finalXp > item.xp ? 'text-emerald-400' : ''}">${formatNumber(finalXp, 0)}</span>
          ${finalXp > item.xp ? `<span class="text-[10px] text-emerald-400 opacity-80" title="Base: ${formatNumber(item.xp, 0)}">✨</span>` : ""}
        </div>

        <!-- SFL Cost Column -->
        <div class="mt-2 lg:mt-0 lg:px-4 flex flex-col">
          <span class="text-white text-sm ${costObj.total > costObj.baseTotal ? 'text-red-400' : ''}">${costObj.total > 0 ? formatNumber(costObj.total, 2) : "0"}</span>
          ${costObj.missing && costObj.total > 0 ? `<span class="text-[9px] text-yellow-500/70" title="Missing some P2P prices">*Incomplete</span>` : ""}
          ${costObj.total > costObj.baseTotal ? `<span class="text-[9px] text-red-500/70" title="Base: ${formatNumber(costObj.baseTotal, 2)}">Debuff x${costObj.total/costObj.baseTotal}</span>` : ""}
        </div>
        
        <!-- XP / SFL Column -->
        <div class="mt-2 lg:mt-0 lg:px-4 flex items-center">
          <span class="text-white text-sm">${xpPerSfl > 0 ? formatNumber(xpPerSfl, 2) : "0.00"}</span>
        </div>

        <!-- XP / Day Column -->
        <div class="mt-2 lg:mt-0 lg:px-4 flex items-center">
          <span class="text-white text-sm font-bold">${formatNumber(xpPerDay, 0)}</span>
        </div>

        <!-- Ingredients Column -->
        <div class="mt-3 lg:mt-0 lg:px-4 flex flex-col gap-1.5 justify-center">
          ${ingredientsHtml}
        </div>
      `
      tableBody.appendChild(row)
    })
  }

  const fetchPrices = async () => {
    try {
      loadingState.classList.remove("hidden")
      dataContainer.classList.add("hidden")

      const response = await fetch("/api/sfl_data.json")
      if (!response.ok) throw new Error("Error loading data")

      const json = await response.json()

      Object.values(json.items).forEach((data) => {
        const idMatch = data.key.match(/collectibles-(\d+)$/)
        if (idMatch) {
          const id = idMatch[1]
          if (sflIds[id]) {
            priceDict[sflIds[id]] = data.currentPrice
          }
        }
      })

      Object.values(json.items).forEach((data) => {
        if (!data.key.startsWith("collectibles-")) {
          const resMatch = data.key.match(/resources-(\d+)$/)
          if (resMatch && sflIds[resMatch[1]]) {
            priceDict[sflIds[resMatch[1]]] = data.currentPrice
          }
        }
      })

      loadingState.classList.add("hidden")
      dataContainer.classList.remove("hidden")

      renderTable()
    } catch (err) {
      console.error(err)
      loadingState.innerHTML = `<p class="text-red-500 text-sm">${tError}</p>`
    }
  }

  // Listeners
  document.querySelectorAll(".buff-checkbox").forEach((cb) => {
    cb.addEventListener("change", (e) => {
      const buffId = e.target.dataset.buffId;
      const card = e.target.closest('label');
      if (e.target.checked) {
        activeBuffs.add(buffId);
        if (card) {
          card.classList.add("border-emerald-500/50", "bg-emerald-500/10", "active");
          card.classList.remove("border-white/5", "bg-white/5");
        }
      } else {
        activeBuffs.delete(buffId);
        if (card) {
          card.classList.remove("border-emerald-500/50", "bg-emerald-500/10", "active");
          card.classList.add("border-white/5", "bg-white/5");
        }
      }
      renderTable(searchInput ? searchInput.value : "");
    });
  });

  const formatSkillDescription = (skillName, rank, originalDesc) => {
    const skill = sflSkills[skillName] || sflOthers[skillName] || sflConsumables[skillName];
    if (!skill) return originalDesc;
    
    // When rank is 0, we still want to show the rank_1 values instead of {math} templates
    const effectiveRank = rank === 0 ? 1 : rank;
    let updatedDesc = originalDesc;
    
    if (skill.mathematics_1 && skill.mathematics_1.calc_by_rank) {
      const m1 = skill.mathematics_1.calc_by_rank[`rank_${effectiveRank}`];
      if (m1 !== undefined) {
         updatedDesc = updatedDesc.replace('{math1}', m1);
         updatedDesc = updatedDesc.replace('{math1_pct}', parseFloat((m1 * 100).toFixed(2)));
         updatedDesc = updatedDesc.replace('{math1_days}', parseFloat((m1 / 86400000).toFixed(2)));
      }
    }
    
    if (skill.mathematics_2 && skill.mathematics_2.calc_by_rank) {
      const m2 = skill.mathematics_2.calc_by_rank[`rank_${effectiveRank}`];
      if (m2 !== undefined) {
         updatedDesc = updatedDesc.replace('{math2}', m2);
         updatedDesc = updatedDesc.replace('{math2_pct}', parseFloat((m2 * 100).toFixed(2)));
         updatedDesc = updatedDesc.replace('{math2_days}', parseFloat((m2 / 86400000).toFixed(2)));
      }
    }
    
    return updatedDesc;
  };

  const updateSkillUI = (skillId) => {
    const rank = activeSkills[skillId] || 0;
    const safeId = skillId.replace(/\s+/g, '_');
    
    // Update card styling
    const card = document.querySelector(`.skill-card[data-skill-id="${skillId}"]`);
    if (card) {
      if (rank > 0) {
        card.classList.add("border-blue-500/50", "bg-blue-500/10", "active");
        card.classList.remove("border-white/5", "bg-white/5");
      } else {
        card.classList.remove("border-blue-500/50", "bg-blue-500/10", "active");
        card.classList.add("border-white/5", "bg-white/5");
      }
      
      const descSpan = card.querySelector('.skill-description-text');
      if (descSpan) {
        descSpan.textContent = formatSkillDescription(skillId, rank, descSpan.dataset.original);
      }
    }
    
    // Update checkboxes progressively
    document.querySelectorAll(`.rank-input-${safeId}`).forEach((cb) => {
      const cbRank = parseInt(cb.dataset.rank);
      cb.checked = skillId === "Faction Pet" ? cbRank === rank : cbRank <= rank;
    });
  };

  document.querySelectorAll(".skill-card").forEach((card) => {
    card.addEventListener("click", (e) => {
      const skillId = card.dataset.skillId;
      if (activeSkills[skillId]) {
        delete activeSkills[skillId]; // Turn off
      } else {
        activeSkills[skillId] = 1; // Turn on to rank 1
      }
      updateSkillUI(skillId);
      renderTable(searchInput ? searchInput.value : "");
    });
  });

  document.querySelectorAll(".skill-rank-checkbox").forEach((cb) => {
    cb.addEventListener("change", (e) => {
      const skillId = e.target.dataset.skillId;
      const rank = parseInt(e.target.value);
      
      if (e.target.checked) {
        // Turning ON a rank => set skill to that rank
        activeSkills[skillId] = rank;
      } else {
        // Turning OFF a rank => set skill to rank-1 (or delete if 0)
        if (skillId === "Faction Pet") {
          delete activeSkills[skillId];
        } else if (rank - 1 > 0) {
          activeSkills[skillId] = rank - 1;
        } else {
          delete activeSkills[skillId];
        }
      }
      updateSkillUI(skillId);
      renderTable(searchInput ? searchInput.value : "");
    });
  });

  document.querySelectorAll(".category-btn").forEach((btn) => {
    btn.addEventListener("click", (e) => {
      window.handleCategory(e.target.dataset.category)
    })
  })

  if (searchInput) {
    searchInput.addEventListener("input", (e) => {
      renderTable(e.target.value)
    })
  }

  // Init
  fetchPrices()
</script>
