              <img src="/img/sunflowerland/fish/a/fish_oil.webp" class="w-full h-full object-contain" alt="Fish Oil" />
            </div>
            <div class="flex flex-col">
              <span class="text-[11px] font-mono text-white/60 leading-none mb-1">{t("sfl.cooking.dash.fishOilName")}</span>
