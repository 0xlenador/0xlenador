          {t("sfl.cooking.table.colXp")} <span
            class="sort-icon opacity-0 group-hover:opacity-50 transition-opacity"
            data-col="xp">↕</span
          >
        </div>
        <div
          class="lg:px-4 text-xs font-mono text-terminal-muted uppercase tracking-wider font-semibold cursor-pointer group flex items-center gap-2"
          onclick="window.handleSort('cost')"
        >
          {t("sfl.cooking.table.colCost")} <span
            class="sort-icon opacity-0 group-hover:opacity-50 transition-opacity"
            data-col="cost">↕</span
          >
        </div>
        <div
