---
// ============================================================
// src/components/views/SflCookingView.astro
// View puro para la herramienta de cocina SFL.
// Fuente única de verdad: consumido por sfl-cocinando.astro y en/sfl-cooking.astro.
// El idioma se detecta desde la URL vía getLangFromUrl.
// ============================================================
import { getEntry } from "astro:content"
import { getLangFromUrl, useTranslations } from "../../i18n/utils"
import SflToolLayout from "../SflToolLayout.astro"
import FaqAccordion from "../FaqAccordion.astro"

const sflRecipesEntry = await getEntry("sfl", "recipes")
const sflIdsEntry = await getEntry("sfl", "resources")
const sflBuffsEntry = await getEntry("sfl", "calculo_buffs")
const sflPowerUpsDataEntry = await getEntry("sfl", "powerups")
const sflSkillsEntry = await getEntry("sfl", "skills")
const sflRecipes = sflRecipesEntry.data
const sflIds = sflIdsEntry.data
const sflBuffsRaw = sflBuffsEntry.data
const sflPowerUpsData = sflPowerUpsDataEntry.data.power_ups

import { getAllCookingRecipes } from "../../lib/sfl/cooking"
import { getCookingBuffs } from "../../lib/sfl/buffs"
import rawFishList from "../../content/data/sfl/fishing/fish.json"
import SflBoostsConfig from "../sfl/common/SflBoostsConfig.astro"

const cookingBuffs = getCookingBuffs()
const cookingBuffsCatalog = cookingBuffs.map((b) => {
  let imgSrc = b.image || ""
  if (imgSrc && !imgSrc.startsWith("/")) {
    if (b.type === "wearable") imgSrc = `/img/sunflowerland/powerups/wearables/${imgSrc}`
    else if (b.type === "collectible") imgSrc = `/img/sunflowerland/powerups/${imgSrc}`
    else if (b.type === "shrine") imgSrc = `/img/sunflowerland/shrines/${imgSrc}`
  }
  if (!imgSrc) imgSrc = "/img/cripto/sunflowerland.webp"

  return {
    id: b.id !== undefined ? String(b.id) : undefined,
    name: b.name,
    type: b.type,
    category: b.category,
    image: imgSrc,
    effects: b.effects || [],
  }
})
const sflBuffs = Object.fromEntries(
  cookingBuffs
    .filter((b) => b.type === "collectible" || b.type === "wearable")
    .map((b) => [String(b.id), b.raw])
)
const sflShrines = Object.fromEntries(
  cookingBuffs.filter((b) => b.type === "shrine").map((b) => [b.name, b.raw])
)
const sflConsumables = Object.fromEntries(
  cookingBuffs.filter((b) => b.type === "consumable").map((b) => [b.name, b.raw])
)
const sflSkills = { ...(sflSkillsEntry.data.Cooking || {}) }
if (sflSkillsEntry.data.Fishing && sflSkillsEntry.data.Fishing["Fishy Feast"]) {
  sflSkills["Fishy Feast"] = sflSkillsEntry.data.Fishing["Fishy Feast"]
}
if (sflSkillsEntry.data.Aging && sflSkillsEntry.data.Aging["Speedy Aging"]) {
  sflSkills["Speedy Aging"] = sflSkillsEntry.data.Aging["Speedy Aging"]
}
const sflOthers = sflBuffsRaw.others || {}

import levelExperience from "../../content/data/sfl/level_experience.json"
import bettyPrices from "../../content/data/sfl/betty_prices.json"

const allSflRecipes = {
  ...sflRecipes,
  recipes: getAllCookingRecipes(),
}

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)

const faqItems = [
  { pregunta: t("sfl.cooking.faq.q1"), respuesta: t("sfl.cooking.faq.a1") },
  { pregunta: t("sfl.cooking.faq.q2"), respuesta: t("sfl.cooking.faq.a2") },
  { pregunta: t("sfl.cooking.faq.q3"), respuesta: t("sfl.cooking.faq.a3") },
  { pregunta: t("sfl.cooking.faq.q4"), respuesta: t("sfl.cooking.faq.a4") },
  { pregunta: t("sfl.cooking.faq.q5"), respuesta: t("sfl.cooking.faq.a5") },
  { pregunta: t("sfl.cooking.faq.q6"), respuesta: t("sfl.cooking.faq.a6") },
  { pregunta: t("sfl.cooking.faq.q7"), respuesta: t("sfl.cooking.faq.a7") },
]


const getCompactText = (data, formattedDesc, typeName) => {
  let value = "?";
  if (!formattedDesc || typeof formattedDesc !== "string") {
    return value;
  }
  const match = formattedDesc.match(/(?:^|\b|\s)([x+-]?\d+(?:\.\d+)?(?:%|x)?)/i);
  if (match) {
    value = match[1].trim();
    if (value.toLowerCase().endsWith('x')) {
      value = 'x' + value.slice(0, -1);
    }
  }

  let effectType = "";
  const descLower = formattedDesc.toLowerCase();
  if (descLower.includes("prime")) {
    effectType = " Prime";
  } else if (descLower.includes("xp")) {
    effectType = " XP";
  } else if (descLower.includes("time") || descLower.includes("faster") || descLower.includes("speed")) {
    effectType = " Time";
  } else if (descLower.includes("food") || descLower.includes("yield")) {
    effectType = " Food";
  }

  let target = "All";
  if (data.mathematics_1) {
    if (data.mathematics_1.target_food && data.mathematics_1.target_food !== "all") {
       target = data.mathematics_1.target_food;
    } else if (data.mathematics_1.target && data.mathematics_1.target !== "all") {
       target = data.mathematics_1.target;
    }
  }
  if (data.building) {
    target = data.building;
  }
  
  target = target.charAt(0).toUpperCase() + target.slice(1);
  return `${value}${effectType} [${target}] ${data.name}`;
}

const getEffectType = (desc) => {
  if (!desc) return "other";
  const descLower = desc.toLowerCase();
  const effects = [];
  if (descLower.includes("xp") || descLower.includes("prime") || descLower.includes("yield") || (descLower.includes("food") && !descLower.includes("revenue"))) effects.push("xp");
  if (descLower.includes("time") || descLower.includes("faster") || descLower.includes("speed")) effects.push("time");
  return effects.length > 0 ? effects.join(" ") : "other";
};

const formatAstroDescription = (skill) => {
  let desc = skill.description || "";
  if (skill.mathematics_1?.calc_by_rank?.rank_1 !== undefined) {
    const m1 = skill.mathematics_1.calc_by_rank.rank_1;
    desc = desc.replace("{math1}", m1).replace("{math1_pct}", parseFloat((m1 * 100).toFixed(2))).replace("{math1_days}", parseFloat((m1 / 86400000).toFixed(2)));
  }
  if (skill.mathematics_2?.calc_by_rank?.rank_1 !== undefined) {
    const m2 = skill.mathematics_2.calc_by_rank.rank_1;
    desc = desc.replace("{math2}", m2).replace("{math2_pct}", parseFloat((m2 * 100).toFixed(2))).replace("{math2_days}", parseFloat((m2 / 86400000).toFixed(2)));
  }
  return desc;
};
---

