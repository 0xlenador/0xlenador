<script
  define:vars={{
    sflRecipes,
    sflIds,
      sflBuffs: { ...sflBuffs, ...sflShrines },
    sflSkills,
      sflOthers,
      sflConsumables,
    levelExperience,
    bettyPrices,
    tEmpty: t("sfl.cooking.empty"),
    tError: t("sfl.cooking.error"),
    tTime: t("sfl.cooking.col.time"),
    tInstant: t("sfl.cooking.col.instant"),
  }}
>
  window.handleImgError = function(img) {
    img.onerror = null;
    img.src = "/img/cripto/sunflowerland.webp";
  };

  const fishList = [
    'Anchovy', 'Angelfish', 'Blowfish', 'Butterflyfish', 'Halibut', 
    'Horse Mackerel', 'Napoleanfish', 'Olive Flounder', 'Red Snapper', 
    'Squid', 'Sunfish', 'Surgeonfish', 'Tuna'
  ];
  const fishSpecialsWebp = ['Fish Flake', 'Fish Stick', 'Crab Stick'];

  function getIngredientImg(name) {
    if (recipesData.some(r => r.name === name)) {
      return `/img/sunflowerland/food/${name}.png`;
    }
    if (name === 'Magic Mushroom') return '/img/sunflowerland/123/magic_mushroom.webp';
    if (name === 'Wild Mushroom') return '/img/sunflowerland/123/wild_mushroom.webp';
    if (name === 'Seaweed') return '/img/sunflowerland/123/seaweed.webp';
    if (fishList.includes(name)) return `/img/sunflowerland/fish/${name}.png`;
    if (fishSpecialsWebp.includes(name)) return `/img/sunflowerland/fish/specials/${name.toLowerCase().replace(/\s+/g, '_')}.webp`;
    if (name === 'Fish Oil') return '/img/sunflowerland/fish/specials/Fish Oil.png';
    return `/img/sunflowerland/${name}.png`;
  }

  const searchInput = document.getElementById("searchInput")
  const loadingState = document.getElementById("loadingState")
  const dataContainer = document.getElementById("dataContainer")
  const tableBody = document.getElementById("tableBody")

  let recipesData = sflRecipes.recipes
  let priceDict = {}

  window.currentSort = { column: "xpsfl", direction: "desc" }
  let currentCategory = "all"
  
  window.currentHideXpLimit = 0;
  window.setHideXpLimit = (limit) => {
    window.currentHideXpLimit = limit;
    
    document.querySelectorAll('.dash-hide-xp-btn, .hide-xp-btn').forEach(btn => {
      const minXp = parseInt(btn.dataset.minXp !== undefined ? btn.dataset.minXp : btn.dataset.xp);
      if (minXp === limit) {
        btn.classList.add('active', 'bg-emerald-500/20', 'text-emerald-400', 'border-emerald-500/40');
        btn.classList.remove('bg-[#141414]', 'text-white/60', 'border-white/10', 'bg-white/5', 'text-white/50');
      } else {
        btn.classList.remove('active', 'bg-emerald-500/20', 'text-emerald-400', 'border-emerald-500/40');
        btn.classList.add('bg-[#141414]', 'text-white/60', 'border-white/10');
      }
    });
    
    const customInputs = [document.getElementById('dashCustomHideXp'), document.getElementById('custom-hide-xp')].filter(Boolean);
    customInputs.forEach(input => {
      if (limit === 0 || [500, 1000, 2500, 5000].includes(limit)) {
        input.value = "";
      } else if (parseInt(input.value) !== limit) {
        input.value = limit;
      }
    });

    if (typeof updateSkillCalculator === "function") {
      updateSkillCalculator();
    }
    
    const searchInput = document.getElementById("searchInput");
    renderTable(searchInput ? searchInput.value : "");
    if (typeof saveState === "function") saveState();
  };
  
  let activeBuffs = new Set()
  let activeSkills = {} // Format: { "Skill Name": rank (1, 2 or 3) }
  window.manualSelectedDish = null;
  window.sflCustomCoinsPerFlower = null;
  window.sflCustomRodCost = null;
  window.sflCustomFishFlakeCost = null;
  window.sflCustomFishStickCost = null;
  window.sflCustomCrabStickCost = null;
  window.sflCustomFishOilCost = null;

  const CACHE_KEY = "sfl_cooking_state";
  const saveState = () => {
    const state = {
      activeBuffs: Array.from(activeBuffs),
      activeSkills: activeSkills,
      currentHideXpLimit: window.currentHideXpLimit,
      currentCategory: currentCategory,
      manualSelectedDish: window.manualSelectedDish || null,
      customCoins: window.sflCustomCoinsPerFlower !== null && window.sflCustomCoinsPerFlower !== undefined ? window.sflCustomCoinsPerFlower : null,
      customRod: window.sflCustomRodCost !== null && window.sflCustomRodCost !== undefined ? window.sflCustomRodCost : null,
      customFishFlake: window.sflCustomFishFlakeCost !== null && window.sflCustomFishFlakeCost !== undefined ? window.sflCustomFishFlakeCost : null,
      customFishStick: window.sflCustomFishStickCost !== null && window.sflCustomFishStickCost !== undefined ? window.sflCustomFishStickCost : null,
      customCrabStick: window.sflCustomCrabStickCost !== null && window.sflCustomCrabStickCost !== undefined ? window.sflCustomCrabStickCost : null,
      customFishOil: window.sflCustomFishOilCost !== null && window.sflCustomFishOilCost !== undefined ? window.sflCustomFishOilCost : null,
      boostFilter: document.querySelector('.filter-boost-btn.active')?.dataset?.filter || 'all',
      viewStyle: document.querySelector('.view-switch-btn.active')?.dataset?.action || 'detailed',
      skillLevel: document.getElementById('skillLevelRange')?.value || '100'
    };
    localStorage.setItem(CACHE_KEY, JSON.stringify(state));
  };


  const isTargetMatch = (item, target) => {
    if (target === "all") return true;
    if (target === "Cakes") return item.building === "Bakery" || item.name.includes("Cake");
    if (target === "Fermented Carrots") return item.name === "Fermented Carrots";
    if (target === "Cheese Recipes") return item.name.includes("Cheese") || item.ingredients.some(ing => ing.name.includes("Cheese"));
    if (target === "Fish") {
      const fishIngs = ['Anchovy', 'Butterflyfish', 'Blowfish', 'Clownfish', 'Seaweed', 'Squid', 'Red Snapper', 'Sunfish', 'Horse Mackerel', 'Tuna', 'Olive Flounder', 'Angelfish', 'Halibut', 'Surgeonfish', 'Napoleanfish', 'Zebra Turkeyfish', 'Ray', 'Hammerhead Shark', 'Great White Shark', 'Octopus', 'Mahi Mahi', 'Blue Marlin', 'Moray Eel', 'Crab', 'Starfish', 'Seahorse', 'Crab Stick', 'Fish Stick'];
      return item.name.includes("Fish") || item.ingredients.some(ing => fishIngs.includes(ing.name)) || ["Gumbo", "Chowder", "Steamed Red Snapper", "Surimi Rice Bowl"].includes(item.name);
    }
    if (target === "Honey Foods") {
      return item.ingredients.some(ing => ing.name === "Honey");
    }
    return false;
  };

  const getCalculatedXp = (item) => {
    let boostedExp = item.xp;
    let additions = 0;
    
    activeBuffs.forEach(id => {
      const buff = sflBuffs[id];
      if (buff && buff.mathematics_1) {
         const math = buff.mathematics_1;
         if (math.category === "bumpkin_xp" && isTargetMatch(item, math.target_food)) {
           if (math.mathematics_operation === "multiply") {
             boostedExp *= math.calc;
           } else if (math.mathematics_operation === "add") {
             additions += math.calc;
           }
         }
      }
    });
    
    // Skills Logic for XP (Multiplicative compounding according to SFL engine)
    if (activeSkills) {
      Object.entries(activeSkills).forEach(([skillName, rank]) => {
        const skill = sflSkills[skillName] || sflOthers[skillName] || sflConsumables[skillName];
        if (!skill) return;
        const math1 = skill.mathematics_1?.calc_by_rank[`rank_${rank}`];
        if (math1 === undefined || math1 === null) return;
        
        // Others XP Buffs
        if (skillName === "VIP Pass") { boostedExp *= (1 + math1); }
        if (skillName === "Blossom Beard") { boostedExp *= (1 + math1); }
        if (skillName === "Luminous Anglerfish" && isTargetMatch(item, "Fish")) { boostedExp *= (1 + math1); }
        if (skillName === "Faction Pet") { boostedExp *= (1 + math1); }
        
        // Munching Mastery (+5% XP)
        if (skillName === "Munching Mastery") {
          boostedExp *= (1 + math1);
        }
        // Juicy Boost (+10% XP for Smoothie Shack)
        if (skillName === "Juicy Boost" && item.building === "Smoothie Shack") {
          boostedExp *= (1 + math1);
        }
        // Double Nom (+1 food = 2x XP essentially)
        if (skillName === "Double Nom") {
          boostedExp *= (1 + math1);
        }
        // Fiery Jackpot (+20% chance of +1 food in Fire Pit)
        if (skillName === "Fiery Jackpot" && item.building === "Fire Pit") {
          boostedExp *= (1 + (math1 / 100));
        }
        // Fishy Feast (+20% XP for Fish)
        if (skillName === "Fishy Feast" && isTargetMatch(item, "Fish")) {
          boostedExp *= (1 + math1);
        }
        // Buzzworthy Treats (+10% XP for Honey Foods)
        if (skillName === "Buzzworthy Treats" && isTargetMatch(item, "Honey Foods")) {
          boostedExp *= (1 + math1);
        }
      });
    }
    
    return boostedExp + additions;
  };

  const getCalculatedTime = (item) => {
    let timeSeconds = parseTime(item.time);
    if (timeSeconds === 0) return 0;
    
    let timeMultiplier = 1;
    
    activeSkills && Object.entries(activeSkills).forEach(([skillName, rank]) => {
      const skill = sflSkills[skillName] || sflOthers[skillName] || sflConsumables[skillName];
      if (!skill) return;
      const math1 = skill.mathematics_1?.calc_by_rank[`rank_${rank}`];
      
      // Others Time Buffs
      if (skillName === "Desert Gnome") { timeMultiplier *= math1; }
      if (skillName === "Time Warp Totem") { timeMultiplier *= math1; }
      if (skillName === "Gourmet Hourglass") { timeMultiplier *= math1; }
      if (skillName === "Faction Medallion") { timeMultiplier *= math1; }
      
      // Fast Feasts (Fire Pit and Kitchen)
      if (skillName === "Fast Feasts" && (item.building === "Fire Pit" || item.building === "Kitchen")) {
        timeMultiplier *= math1;
      }
      // Frosted Cakes (Bakery / Cakes)
      if (skillName === "Frosted Cakes" && (item.building === "Bakery" || item.name.includes("Cake"))) {
        timeMultiplier *= math1;
      }
      // Swift Sizzle (Fire Pit con oil)
      if (skillName === "Swift Sizzle" && item.building === "Fire Pit") {
        timeMultiplier *= math1;
      }
      // Turbo Fry (Kitchen con oil)
      if (skillName === "Turbo Fry" && item.building === "Kitchen") {
        timeMultiplier *= math1;
      }
      // Fry Frenzy (Deli con oil)
      if (skillName === "Fry Frenzy" && item.building === "Deli") {
        timeMultiplier *= math1;
      }
    });

    // Boost Base de Oil en edificios (cuando Oil está activo y no se sobreescribe por una skill superior)
    const hasOil = Boolean(activeSkills && activeSkills["Oil"]);
    if (hasOil) {
      if (item.building === "Fire Pit" && !(activeSkills && activeSkills["Swift Sizzle"])) {
        timeMultiplier *= 0.8; // -20% tiempo base Fire Pit con Oil
      } else if (item.building === "Kitchen" && !(activeSkills && activeSkills["Turbo Fry"])) {
        timeMultiplier *= 0.75; // -25% tiempo base Kitchen con Oil
      } else if (item.building === "Bakery") {
        timeMultiplier *= 0.65; // -35% tiempo base Bakery con Oil
      } else if (item.building === "Deli" && !(activeSkills && activeSkills["Fry Frenzy"])) {
        timeMultiplier *= 0.6; // -40% tiempo base Deli con Oil
      }
    }
      activeBuffs.forEach(id => {
        const buff = sflBuffs[id];
        if (buff && buff.mathematics_1) {
           const math = buff.mathematics_1;
           if (math.category === "cooking_time" && isTargetMatch(item, math.target_food)) {
             if (math.mathematics_operation === "multiply") {
               timeMultiplier *= math.calc;
             }
           }
        }
      });
    
    return timeSeconds * timeMultiplier;
  };

  const parseTime = (timeStr) => {
    if (!timeStr) return 0
    let days = 0
    let tStr = timeStr
    if (timeStr.includes("d ")) {
      const parts = timeStr.split("d ")
      days = parseInt(parts[0])
      tStr = parts[1]
    }
    const [h, m, s] = tStr.split(":").map(Number)
    return days * 86400 + h * 3600 + m * 60 + (s || 0)
  }

  const formatSeconds = (totalSeconds) => {
    if (!totalSeconds) return "00:00:00";
    let days = Math.floor(totalSeconds / 86400);
    let remaining = totalSeconds % 86400;
    let h = Math.floor(remaining / 3600);
    remaining %= 3600;
    let m = Math.floor(remaining / 60);
    let s = Math.floor(remaining % 60);
    
    let timeStr = `${h.toString().padStart(2, '0')}:${m.toString().padStart(2, '0')}:${s.toString().padStart(2, '0')}`;
    return days > 0 ? `${days}d ${timeStr}` : timeStr;
  }

  window.handleCategory = (category) => {
    currentCategory = category

    document.querySelectorAll(".category-btn").forEach((btn) => {
      if (btn.dataset.category === category) {
        btn.className =
          "category-btn active px-4 py-2 bg-emerald-500/20 text-emerald-400 border border-emerald-500/30 rounded-xl text-xs font-bold uppercase tracking-wider hover:bg-emerald-500/30 transition-colors whitespace-nowrap shrink-0"
      } else {
        btn.className =
          "category-btn px-4 py-2 bg-white/5 text-white/40 border border-white/10 rounded-xl text-xs font-bold uppercase tracking-wider hover:bg-white/10 hover:text-white transition-colors whitespace-nowrap shrink-0"
      }
    })

    renderTable(searchInput ? searchInput.value : "")
    if (typeof saveState === "function") saveState();
  }

  window.handleSort = (column) => {
    if (window.currentSort.column === column) {
      if (window.currentSort.direction === "none") window.currentSort.direction = "desc"
      else if (window.currentSort.direction === "desc") window.currentSort.direction = "asc"
      else window.currentSort.direction = "none"
    } else {
      window.currentSort.column = column
      window.currentSort.direction = "desc"
    }

    document.querySelectorAll(".sort-icon").forEach((icon) => {
      icon.innerHTML = "↕"
      icon.classList.remove("opacity-100", "text-emerald-500")
      icon.classList.add("opacity-0", "group-hover:opacity-50")
    })
    
    document.querySelectorAll(".mobile-sort-btn").forEach((btn) => {
      btn.className = "mobile-sort-btn px-3 py-1.5 bg-black/40 border border-white/10 rounded-lg text-[10px] font-semibold text-white/60 hover:text-white hover:bg-white/10 transition-all whitespace-nowrap flex items-center gap-1.5";
    })

    if (window.currentSort.direction !== "none") {
      document.querySelectorAll(`.sort-icon[data-col="${column}"]`).forEach((activeIcon) => {
        activeIcon.innerHTML = window.currentSort.direction === "desc" ? "↓" : "↑"
        activeIcon.classList.remove("opacity-0", "group-hover:opacity-50")
        activeIcon.classList.add("opacity-100", "text-emerald-500")
      })
      
      const activeMobileBtn = document.querySelector(`.mobile-sort-btn[data-col="${column}"]`);
      if (activeMobileBtn) {
        activeMobileBtn.className = "mobile-sort-btn px-3 py-1.5 bg-emerald-500/10 border border-emerald-500/30 rounded-lg text-[10px] font-semibold text-emerald-400 hover:bg-emerald-500/20 transition-all whitespace-nowrap flex items-center gap-1.5";
      }
    }

    renderTable(searchInput ? searchInput.value : "")
  }

  const formatNumber = (num, decimals = 2) => {
    if (num === undefined || num === null || isNaN(num)) return "0"
    if (num > 0 && num < 0.0001) return num.toExponential(2)
    return new Intl.NumberFormat("en-US", {
      minimumFractionDigits: 0,
      maximumFractionDigits: decimals,
    }).format(num)
  }

  const calculateRecipeCost = (ingredients, visited = new Set(), isTopLevel = true) => {
    let total = 0
    let missing = false
    
    const fishNames = [
      "Anchovy", "Angelfish", "Barred Knifejaw", "Blowfish", "Blue Marlin", "Butterflyfish", 
      "Clownfish", "Cobia", "Coelacanth", "Football fish", "Halibut", "Hammerhead shark", 
      "Horse Mackerel", "Mahi Mahi", "Napoleanfish", "Oarfish", "Olive Flounder", "Parrotfish", 
      "Phantom Barracuda", "Porgy", "Ray", "Red Snapper", "Rock Blackfish", "Saw Shark", 
      "Sea Bass", "Sea Horse", "Squid", "Sunfish", "Surgeonfish", "Tilapia", "Trout", 
      "Tuna", "Walleye", "Weakfish", "Whale Shark", "White Shark", "Zebra Turkeyfish",
      "Crystal Shrimp", "Deep Sea Pig", "Deep Sea Slug", "Dollocaris", "Garden Eel", 
      "Giant Isopod", "Gilded Swordfish", "Longhorn Cowfish", "Nautilus", "Twilight Anglerfish",
      "Octopus", "Moray Eel"
    ];

    for (const ing of ingredients) {
      if (priceDict[ing.name]) {
        total += priceDict[ing.name] * ing.amount
      } else if (fishNames.includes(ing.name) && window.sflRodCost) {
        total += window.sflRodCost * ing.amount;
      } else if (ing.name === "Fish Flake") {
        const flakeCost = (window.sflCustomFishFlakeCost !== null && window.sflCustomFishFlakeCost !== undefined)
          ? window.sflCustomFishFlakeCost
          : (window.sflRodCost ? 8 * window.sflRodCost : 0);
        total += flakeCost * ing.amount;
      } else if (ing.name === "Fish Stick") {
        const stickCost = (window.sflCustomFishStickCost !== null && window.sflCustomFishStickCost !== undefined)
          ? window.sflCustomFishStickCost
          : (window.sflRodCost ? 10 * window.sflRodCost : 0);
        total += stickCost * ing.amount;
      } else if (ing.name === "Fish Oil") {
        const oilCost = (window.sflCustomFishOilCost !== null && window.sflCustomFishOilCost !== undefined)
          ? window.sflCustomFishOilCost
          : (window.sflRodCost ? 14 * window.sflRodCost : 0);
        total += oilCost * ing.amount;
      } else if (ing.name === "Crab Stick") {
        const crabCost = (window.sflCustomCrabStickCost !== null && window.sflCustomCrabStickCost !== undefined)
          ? window.sflCustomCrabStickCost
          : 5.9;
        total += crabCost * ing.amount;
      } else if (ing.name === "Magic Mushroom" || ing.name === "Wild Mushroom") {
        total += 0;
      } else {
        // Buscar si el ingrediente es en realidad otra receta
        const subRecipe = recipesData.find((r) => r.name === ing.name)
        if (subRecipe && !visited.has(ing.name)) {
          visited.add(ing.name)
          const subCost = calculateRecipeCost(subRecipe.ingredients, visited, false)
          if (subCost.missing) missing = true
          total += subCost.total * ing.amount
        } else {
          missing = true
        }
      }
    }
    
    // Skills Logic for Cost (Debuffs)
    let costMultiplier = 1;
    if (isTopLevel) {
      activeSkills && Object.entries(activeSkills).forEach(([skillName, rank]) => {
        const skill = sflSkills[skillName] || sflOthers[skillName] || sflConsumables[skillName];
        if (!skill) return;
        
        // Double Nom Debuff (2x ingredients)
        if (skillName === "Double Nom" && skill.mathematics_2) {
          costMultiplier *= skill.mathematics_2.calc_by_rank[`rank_${rank}`];
        }
        // Instant Gratification Debuff (2x ingredients)
        if (skillName === "Instant Gratification") {
          // Assume default x2 since rank logic is complex for this one
          costMultiplier *= 2; 
        }
      });
    }
    
    return { total: total * costMultiplier, missing, baseTotal: total }
  }

  window.renderTable = (searchTerm = "") => {
    let filtered = recipesData.filter((item) => {
      const nameMatch = item.name.toLowerCase().includes(searchTerm.toLowerCase())
      const ingMatch = item.ingredients.some((ing) =>
        ing.name.toLowerCase().includes(searchTerm.toLowerCase()),
      )
      const matchesSearch = nameMatch || ingMatch

      const matchesCategory = currentCategory === "all" || item.building === currentCategory
      
      const xp = getCalculatedXp(item);
      const matchesXpLimit = window.currentHideXpLimit > 0 ? xp >= window.currentHideXpLimit : true;

      return matchesSearch && matchesCategory && matchesXpLimit;
    })

    if (
      window.currentSort &&
      window.currentSort.column &&
      window.currentSort.direction !== "none"
    ) {
      const { column, direction } = window.currentSort
      filtered.sort((a, b) => {
        let valA, valB
        if (column === "name") {
          valA = a.name.toLowerCase()
          valB = b.name.toLowerCase()
        } else if (column === "xp") {
          valA = getCalculatedXp(a)
          valB = getCalculatedXp(b)
        } else if (column === "cost") {
          const costA = calculateRecipeCost(a.ingredients)
          const costB = calculateRecipeCost(b.ingredients)
          valA = costA.total
          valB = costB.total
        } else if (column === "xpsfl") {
          const costA = calculateRecipeCost(a.ingredients)
          const costB = calculateRecipeCost(b.ingredients)
          valA = costA.total > 0 ? getCalculatedXp(a) / costA.total : 0
          valB = costB.total > 0 ? getCalculatedXp(b) / costB.total : 0
        } else if (column === "xpday") {
          const timeA = parseTime(a.time)
          const timeB = parseTime(b.time)
          valA = timeA > 0 ? (86400 / timeA) * getCalculatedXp(a) : 0
          valB = timeB > 0 ? (86400 / timeB) * getCalculatedXp(b) : 0
        }

        if (valA < valB) return direction === "asc" ? -1 : 1
        if (valA > valB) return direction === "asc" ? 1 : -1
        return 0
      })
    }

    tableBody.innerHTML = ""

    if (filtered.length === 0) {
      tableBody.innerHTML = `<div class="py-8 text-center text-terminal-muted text-sm">${tEmpty}</div>`
      return
    }

    filtered.forEach((item) => {
      let doubleNomMultiplier = 1;
      if (activeSkills && activeSkills["Double Nom"]) {
        const rank = activeSkills["Double Nom"];
        const math1 = sflSkills["Double Nom"]?.mathematics_1?.calc_by_rank[`rank_${rank}`] || 0;
        doubleNomMultiplier = 1 + math1;
      }
      
      const costObj = calculateRecipeCost(item.ingredients)
      const timeSeconds = getCalculatedTime(item)
      const finalXp = getCalculatedXp(item);
      const xpPerSfl = costObj.total > 0 ? finalXp / costObj.total : 0
      const xpPerDay = timeSeconds > 0 ? (86400 / timeSeconds) * finalXp : 0

      // Format visual time
      const displayTime = formatSeconds(timeSeconds);
      const displayName = doubleNomMultiplier > 1 ? `${item.name} x${doubleNomMultiplier}` : item.name;

      const row = document.createElement("div")
      row.className =
        "hover:bg-white/[0.02] transition-colors group block border border-white/5 bg-white/[0.02] rounded-[20px] p-5 lg:p-0 lg:border-0 lg:border-b lg:border-white/5 last:lg:border-b-0 lg:bg-transparent lg:rounded-none lg:grid lg:grid-cols-[25%_10%_15%_15%_15%_20%] lg:items-center lg:py-3"

      const ingredientsHtml = item.ingredients
        .map((ing) => {
          const imgSrc = getIngredientImg(ing.name);
          const safeName = ing.name.replace(/'/g, "\\'");

          return `
          <div class="flex items-center gap-1.5 bg-white/5 lg:bg-transparent px-2 py-1 lg:p-0 rounded-md lg:rounded-none shrink-0 border border-white/5 lg:border-0">
            <img src="${imgSrc}" alt="${safeName}" class="w-4 h-4 object-contain drop-shadow-sm" onerror="window.handleImgError(this)" />
            <span class="text-[11px] lg:text-xs text-white/80">${ing.name} <span class="text-white/40 font-mono ml-0.5">x${ing.amount * doubleNomMultiplier}</span></span>
          </div>
        `
        })
        .join("")

      row.innerHTML = `
        <div class="lg:px-4 font-medium text-white flex items-center justify-between lg:justify-start h-full mb-3 lg:mb-0">
          <div class="flex items-center gap-3 lg:gap-3 w-full">
            <div class="w-12 h-12 lg:w-8 lg:h-8 flex items-center justify-center shrink-0 bg-white/5 rounded-xl lg:bg-transparent lg:rounded-none p-1 lg:p-0">
              <img src="/img/sunflowerland/food/${item.name}.png" alt="${item.name}" class="w-full h-full object-contain drop-shadow-sm" onerror="window.handleImgError(this)" />
            </div>
            <div class="flex flex-col flex-1">
              <span class="text-sm font-semibold text-white group-hover:text-emerald-400 transition-colors">${displayName}</span>
              <div class="flex items-center justify-between lg:justify-start w-full">
                <span class="text-[11px] text-terminal-muted mt-0.5 ${timeSeconds < parseTime(item.time) ? 'text-blue-400' : ''}">🕒 ${displayTime}</span>
                ${
                  item.instant
                    ? `<span class="text-[11px] font-mono text-cyan-300 flex items-center gap-1 ml-2"><img src="/img/Gem.png" class="w-3 h-3" onerror="this.onerror=null; this.outerHTML='💎';" /> ${item.instant}</span>`
                    : ""
                }
              </div>
            </div>
          </div>
        </div>
        
        <div class="grid grid-cols-2 gap-2 mb-3 lg:hidden">
          <div class="bg-white/5 border border-white/5 rounded-lg p-2.5 flex flex-col justify-center relative overflow-hidden">
            <div class="absolute -right-2 -bottom-2 text-white/5 text-4xl font-black pointer-events-none">XP</div>
            <span class="text-[9px] text-white/40 uppercase tracking-wider font-bold mb-0.5 relative z-10">Total XP</span>
            <div class="flex items-center gap-1 relative z-10">
              <span class="text-white text-[15px] font-bold ${finalXp > item.xp ? 'text-emerald-400' : ''}">${formatNumber(finalXp, 0)}</span>
              ${finalXp > item.xp ? `<span class="text-[10px] text-emerald-400 opacity-80" title="Base: ${formatNumber(item.xp, 0)}">✨</span>` : ""}
            </div>
          </div>
          <div class="bg-white/5 border border-white/5 rounded-lg p-2.5 flex flex-col justify-center relative overflow-hidden">
            <div class="absolute -right-2 -bottom-2 text-white/5 text-4xl font-black pointer-events-none">$</div>
            <span class="text-[9px] text-white/40 uppercase tracking-wider font-bold mb-0.5 relative z-10">FLOWER Cost</span>
            <div class="flex flex-col relative z-10">
              <div class="flex items-center gap-1">
                <img src="/img/sunflowerland/flower.jpg" class="w-3.5 h-3.5 rounded-full object-cover shrink-0" alt="FLOWER" />
                <span class="text-white text-[15px] font-mono ${costObj.total > costObj.baseTotal ? 'text-red-400' : ''}">${costObj.total > 0 ? formatNumber(costObj.total, costObj.total >= 100 ? 0 : 2) : "0"}</span>
                ${costObj.missing && costObj.total > 0 ? `<span class="text-[9px] text-yellow-500/70">*Inc</span>` : ""}
              </div>
              ${costObj.total > costObj.baseTotal ? `<span class="text-[8px] text-red-500/70 leading-none mt-0.5">Debuff x${(costObj.total/costObj.baseTotal).toFixed(2)}</span>` : ""}
            </div>
          </div>
          <div class="bg-white/5 border border-white/5 rounded-lg p-2.5 flex flex-col justify-center">
            <span class="text-[9px] text-white/40 uppercase tracking-wider font-bold mb-0.5">XP/FLOWER</span>
            <span class="text-emerald-300/90 text-sm font-mono">${xpPerSfl > 0 ? formatNumber(xpPerSfl, xpPerSfl >= 100 ? 0 : 2) : "0.00"}</span>
          </div>
          <div class="bg-white/5 border border-white/5 rounded-lg p-2.5 flex flex-col justify-center">
            <span class="text-[9px] text-white/40 uppercase tracking-wider font-bold mb-0.5">XP/Day</span>
            <span class="text-blue-300/90 text-sm font-bold font-mono">${formatNumber(xpPerDay, 0)}</span>
          </div>
        </div>

        <div class="hidden lg:flex mt-2 lg:mt-0 lg:px-4 items-center gap-1">
          <span class="text-white text-sm font-bold ${finalXp > item.xp ? 'text-emerald-400' : ''}">${formatNumber(finalXp, 0)}</span>
          ${finalXp > item.xp ? `<span class="text-[10px] text-emerald-400 opacity-80" title="Base: ${formatNumber(item.xp, 0)}">✨</span>` : ""}
        </div>
        
        <div class="hidden lg:flex mt-2 lg:mt-0 lg:px-4 flex-col justify-center">
          <div class="flex items-center gap-1.5">
            <img src="/img/sunflowerland/flower.jpg" class="w-3.5 h-3.5 rounded-full object-cover shrink-0" alt="FLOWER" />
            <span class="text-white text-sm ${costObj.total > costObj.baseTotal ? 'text-red-400' : ''}">${costObj.total > 0 ? formatNumber(costObj.total, costObj.total >= 100 ? 0 : 2) : "0"}</span>
            ${costObj.missing && costObj.total > 0 ? `<span class="text-[9px] text-yellow-500/70" title="Missing some P2P prices">*Incomplete</span>` : ""}
          </div>
          ${costObj.total > costObj.baseTotal ? `<span class="text-[9px] text-red-500/70" title="Base: ${formatNumber(costObj.baseTotal, 2)}">Debuff x${(costObj.total/costObj.baseTotal).toFixed(2)}</span>` : ""}
        </div>
        
        <div class="hidden lg:flex mt-2 lg:mt-0 lg:px-4 items-center">
          <span class="text-white text-sm font-mono">${xpPerSfl > 0 ? formatNumber(xpPerSfl, xpPerSfl >= 100 ? 0 : 2) : "0.00"}</span>
        </div>

        <div class="hidden lg:flex mt-2 lg:mt-0 lg:px-4 items-center">
          <span class="text-white text-sm font-bold font-mono">${formatNumber(xpPerDay, 0)}</span>
        </div>

        <div class="mt-2 lg:mt-0 lg:px-4 flex flex-wrap lg:flex-col gap-1.5 justify-start lg:justify-center pt-3 lg:pt-0 border-t border-white/5 lg:border-0">
          ${ingredientsHtml}
        </div>
      `
      tableBody.appendChild(row)
    })
  }

  const getBestRecipe = () => {
    if (window.manualSelectedDish) {
      const manualRecipe = recipesData.find((r) => r.name === window.manualSelectedDish);
      if (manualRecipe) {
        const calcXp = getCalculatedXp(manualRecipe);
        const costObj = calculateRecipeCost(manualRecipe.ingredients);
        const totalCost = costObj.total;
        const efficiency = totalCost > 0 ? calcXp / totalCost : 0;
        return {
          ...manualRecipe,
          xp: calcXp,
          rawBaseXp: manualRecipe.xp,
          baseCost: totalCost,
          efficiency,
          isManual: true,
        };
      }
    }

    let best = null;
    let maxEfficiency = 0;
    const minXp = window.currentHideXpLimit || 0;

    for (const recipe of recipesData) {
      const calcXp = getCalculatedXp(recipe);
      if (!calcXp || calcXp <= 0) continue;
      if (calcXp < minXp) continue;
      const costObj = calculateRecipeCost(recipe.ingredients);
      const totalCost = costObj.total;
      if (totalCost > 0 && !costObj.missing) {
        const efficiency = calcXp / totalCost;
        if (efficiency > maxEfficiency) {
          maxEfficiency = efficiency;
          best = { ...recipe, xp: calcXp, rawBaseXp: recipe.xp, baseCost: totalCost, efficiency };
        }
      }
    }

    if (!best) {
      for (const recipe of recipesData) {
        const calcXp = getCalculatedXp(recipe);
        if (!calcXp || calcXp <= 0) continue;
        if (calcXp < minXp) continue;
        const costObj = calculateRecipeCost(recipe.ingredients);
        const totalCost = costObj.total;
        if (totalCost > 0) {
          const efficiency = calcXp / totalCost;
          if (efficiency > maxEfficiency) {
            maxEfficiency = efficiency;
            best = { ...recipe, xp: calcXp, rawBaseXp: recipe.xp, baseCost: totalCost, efficiency };
          }
        }
      }
    }

    return best;
  };

  const formatCompactXp = (xp, isDelta = true) => {
    if (xp === 0) return "0 XP";
    const prefix = isDelta ? "+" : "";
    if (xp >= 1000000) return `${prefix}${(xp / 1000000).toFixed(2)}M XP`;
    if (xp >= 10000) return `${prefix}${(xp / 1000).toFixed(1)}k XP`;
    return `${prefix}${formatNumber(xp, 0)} XP`;
  };

  const updateSkillCalculator = () => {
    const levelRange = document.getElementById("skillLevelRange");
    const levelInput = document.getElementById("skillLevelInput");
    if (!levelRange) return;

    let level = parseInt(levelRange.value);
    if (isNaN(level) || level < 1) level = 1;
    if (level > 200) level = 200;

    if (levelInput && parseInt(levelInput.value) !== level) {
      levelInput.value = level;
    }

    const best = getBestRecipe();

    const costDisplay = document.getElementById("skillCostDisplay");
    const deltaXpDisplay = document.getElementById("skillDeltaXpDisplay");
    const skillNextCostDisplay = document.getElementById("skillNextCostDisplay");
    const skillNextDeltaXpDisplay = document.getElementById("skillNextDeltaXpDisplay");
    const totalCostDisplay = document.getElementById("skillTotalCostDisplay");
    const totalXpDisplay = document.getElementById("skillTotalXpDisplay");
    const skillAvgCostDisplay = document.getElementById("skillAvgCostDisplay");
    const skillAvgXpDisplay = document.getElementById("skillAvgXpDisplay");
    const skillReachLabel = document.getElementById("skillReachLabel");
    const skillNextLabel = document.getElementById("skillNextLabel");

    const skillReachDishImg = document.getElementById("skillReachDishImg");
    const skillReachDishCount = document.getElementById("skillReachDishCount");
    const skillNextDishImg = document.getElementById("skillNextDishImg");
    const skillNextDishCount = document.getElementById("skillNextDishCount");
    const skillTotalDishImg = document.getElementById("skillTotalDishImg");
    const skillTotalDishCount = document.getElementById("skillTotalDishCount");

    const bestFoodImg = document.getElementById("bestFoodImg");
    const bestFoodNameDisplay = document.getElementById("bestFoodNameDisplay");
    const bestFoodEfficiencyDisplay = document.getElementById("bestFoodEfficiencyDisplay");
    const bestFoodCostDisplay = document.getElementById("bestFoodCostDisplay");
    const bestFoodXpDisplay = document.getElementById("bestFoodXpDisplay");

    if (!best || !best.efficiency || best.efficiency <= 0) {
      if (skillAvgCostDisplay) skillAvgCostDisplay.innerText = "...";
      if (skillAvgXpDisplay) skillAvgXpDisplay.innerText = "...";
      if (costDisplay) costDisplay.innerText = "...";
      if (deltaXpDisplay) deltaXpDisplay.innerText = "...";
      if (skillNextCostDisplay) skillNextCostDisplay.innerText = "...";
      if (skillNextDeltaXpDisplay) skillNextDeltaXpDisplay.innerText = "...";
      if (totalCostDisplay) totalCostDisplay.innerText = "...";
      if (totalXpDisplay) totalXpDisplay.innerText = "...";
      if (skillReachDishCount) skillReachDishCount.innerText = "...";
      if (skillNextDishCount) skillNextDishCount.innerText = "...";
      if (skillTotalDishCount) skillTotalDishCount.innerText = "...";
      if (bestFoodNameDisplay) bestFoodNameDisplay.innerText = "...";
      if (bestFoodEfficiencyDisplay) bestFoodEfficiencyDisplay.innerText = "...";
      if (bestFoodCostDisplay) bestFoodCostDisplay.innerText = "...";
      if (bestFoodXpDisplay) bestFoodXpDisplay.innerText = "...";
      return;
    }

    const currentLevelXp = levelExperience[level] || 0;
    const prevLevelXp = level > 1 ? (levelExperience[level - 1] || 0) : 0;
    const nextLevelXp = level < 200 ? (levelExperience[level + 1] || currentLevelXp) : currentLevelXp;

    const deltaXp = level > 1 ? (currentLevelXp - prevLevelXp) : 0;
    const nextDeltaXp = level < 200 ? (nextLevelXp - currentLevelXp) : 0;

    const dishesThisLevel = (best.xp > 0 && deltaXp > 0) ? Math.ceil(deltaXp / best.xp) : 0;
    const dishesNextLevel = (best.xp > 0 && nextDeltaXp > 0) ? Math.ceil(nextDeltaXp / best.xp) : 0;
    const dishesTotal = (best.xp > 0 && currentLevelXp > 0) ? Math.ceil(currentLevelXp / best.xp) : 0;

    const costThisLevel = deltaXp / best.efficiency;
    const costNextLevel = nextDeltaXp / best.efficiency;
    const totalCost = currentLevelXp / best.efficiency;

    // Skills obtenidos hasta este nivel (1 por cada nivel superado a partir de lvl 2)
    const skillsEarned = Math.max(1, level - 1);
    const avgCostPerSkill = totalCost / skillsEarned;
    const avgXpPerSkill = currentLevelXp / skillsEarned;

    const safeDishName = best.name.replace(/'/g, "\\'");
    const dishImgSrc = `/img/sunflowerland/food/${best.name}.png`;

    // Tarjeta 1: Skill Calculator
    // Métrica Hero: Promedio por Skill (La que prima)
    if (skillAvgCostDisplay) {
      const avgDecimals = avgCostPerSkill >= 100 ? 0 : 2;
      skillAvgCostDisplay.innerText = `${formatNumber(avgCostPerSkill, avgDecimals)} FLOWER`;
    }
    if (skillAvgXpDisplay) {
      skillAvgXpDisplay.innerText = `~${formatCompactXp(avgXpPerSkill, false)}`;
      skillAvgXpDisplay.title = `Promedio: ${formatNumber(avgXpPerSkill, 0)} XP`;
    }

    // Col 1: Llegar a este nivel
    if (skillReachLabel) {
      const prefix = skillReachLabel.dataset.prefix || "Lvl";
      skillReachLabel.innerText = `${prefix} ${level}`;
    }
    if (skillReachDishCount) {
      skillReachDishCount.innerText = formatNumber(dishesThisLevel, 0);
      skillReachDishCount.title = `${formatNumber(dishesThisLevel, 0)}x ${best.name}`;
    }
    if (skillReachDishImg) {
      skillReachDishImg.src = dishImgSrc;
      skillReachDishImg.alt = best.name;
      skillReachDishImg.title = best.name;
      skillReachDishImg.onerror = function() { window.handleImgError(this); };
    }
    if (costDisplay) {
      const costThisLevelDecimals = costThisLevel >= 100 ? 0 : 2;
      costDisplay.innerText = `${formatNumber(costThisLevel, costThisLevelDecimals)} FLOWER`;
    }
    if (deltaXpDisplay) {
      deltaXpDisplay.innerText = `(${formatCompactXp(deltaXp, true)})`;
      deltaXpDisplay.title = `${formatNumber(deltaXp, 0)} XP`;
    }

    // Col 2: Próximo nivel
    if (skillNextLabel) {
      const prefix = skillNextLabel.dataset.prefix || "Próx. Lvl";
      skillNextLabel.innerText = level < 200 ? `${prefix} ${level + 1}` : "Max Lvl";
    }
    if (skillNextDishCount) {
      if (level >= 200) {
        skillNextDishCount.innerText = "-";
        skillNextDishCount.title = "Max Lvl";
      } else {
        skillNextDishCount.innerText = formatNumber(dishesNextLevel, 0);
        skillNextDishCount.title = `${formatNumber(dishesNextLevel, 0)}x ${best.name}`;
      }
    }
    if (skillNextDishImg) {
      skillNextDishImg.src = dishImgSrc;
      skillNextDishImg.alt = best.name;
      skillNextDishImg.title = best.name;
      skillNextDishImg.onerror = function() { window.handleImgError(this); };
    }
    if (skillNextCostDisplay) {
      if (level >= 200) {
        skillNextCostDisplay.innerText = "-";
      } else {
        const costNextLevelDecimals = costNextLevel >= 100 ? 0 : 2;
        skillNextCostDisplay.innerText = `${formatNumber(costNextLevel, costNextLevelDecimals)} FLOWER`;
      }
    }
    if (skillNextDeltaXpDisplay) {
      if (level >= 200) {
        skillNextDeltaXpDisplay.innerText = "(Max)";
      } else {
        skillNextDeltaXpDisplay.innerText = `(${formatCompactXp(nextDeltaXp, true)})`;
        skillNextDeltaXpDisplay.title = `${formatNumber(nextDeltaXp, 0)} XP`;
      }
    }

    // Col 3: Histórico total acumulado
    if (skillTotalDishCount) {
      skillTotalDishCount.innerText = formatNumber(dishesTotal, 0);
      skillTotalDishCount.title = `${formatNumber(dishesTotal, 0)}x ${best.name}`;
    }
    if (skillTotalDishImg) {
      skillTotalDishImg.src = dishImgSrc;
      skillTotalDishImg.alt = best.name;
      skillTotalDishImg.title = best.name;
      skillTotalDishImg.onerror = function() { window.handleImgError(this); };
    }
    if (totalCostDisplay) {
      const totalCostDecimals = totalCost >= 100 ? 0 : 2;
      totalCostDisplay.innerText = `${formatNumber(totalCost, totalCostDecimals)} FLOWER`;
    }
    if (totalXpDisplay) {
      totalXpDisplay.innerText = `(${formatCompactXp(currentLevelXp, false)})`;
      totalXpDisplay.title = `Total: ${formatNumber(currentLevelXp, 0)} XP`;
    }

    // Tarjeta 2: Alimento Más Rentable & XP por FLOWER
    if (bestFoodNameDisplay) bestFoodNameDisplay.innerText = best.name;
    if (bestFoodEfficiencyDisplay) {
      const effDecimals = best.efficiency >= 100 ? 0 : 1;
      bestFoodEfficiencyDisplay.innerText = `${formatNumber(best.efficiency, effDecimals)} XP/FLOWER`;
    }
    const baseCostDecimals = best.baseCost >= 100 ? 0 : 3;
    if (bestFoodCostDisplay) bestFoodCostDisplay.innerText = `${formatNumber(best.baseCost, baseCostDecimals)} FLOWER`;
    if (bestFoodXpDisplay) {
      const isBoosted = best.rawBaseXp && best.xp > best.rawBaseXp;
      const isLowXp = best.xp < 1000;
      const labelLowXp = bestFoodXpDisplay.dataset.labelLowXp || "Baja XP (< 1,000 XP)";
      bestFoodXpDisplay.innerHTML = `${formatNumber(best.xp, 0)}${isBoosted ? ` <span class="text-[10px] text-emerald-400 opacity-80" title="Base: ${formatNumber(best.rawBaseXp, 0)}">✨</span>` : ""}${isLowXp ? ` <span class="inline-block text-xs select-none ml-1 cursor-help" title="${labelLowXp}">😐</span>` : ""}`;
    }

    if (bestFoodImg) {
      bestFoodImg.src = `/img/sunflowerland/food/${best.name}.png`;
      bestFoodImg.alt = best.name;
      bestFoodImg.onerror = function() { window.handleImgError(this); };
    }

    const dishManualBadge = document.getElementById("dishManualBadge");
    if (dishManualBadge) {
      if (window.manualSelectedDish) {
        dishManualBadge.classList.remove("hidden");
        dishManualBadge.classList.add("inline-flex");
      } else {
        dishManualBadge.classList.add("hidden");
        dishManualBadge.classList.remove("inline-flex");
      }
    }

    const menu = document.getElementById("dishSelectDropdownMenu");
    if (menu && !menu.classList.contains("hidden")) {
      const searchInput = document.getElementById("dishDropdownSearch");
      renderDishDropdownList(searchInput ? searchInput.value : "");
    }
  };

  const fetchPrices = async () => {
    try {
      loadingState.classList.remove("hidden")
      dataContainer.classList.add("hidden")

      const response = await fetch("/api/sfl_data.json")
      if (!response.ok) throw new Error("Error loading data")

      const json = await response.json()

      Object.values(json.items).forEach((data) => {
        const idMatch = data.key.match(/collectibles-(\d+)$/)
        if (idMatch) {
          const id = idMatch[1]
          if (sflIds[id]) {
            priceDict[sflIds[id]] = data.currentPrice
          }
        }
      })

      Object.values(json.items).forEach((data) => {
        if (!data.key.startsWith("collectibles-")) {
          const resMatch = data.key.match(/resources-(\d+)$/)
          if (resMatch && sflIds[resMatch[1]]) {
            priceDict[sflIds[resMatch[1]]] = data.currentPrice
          }
        }
      })

      // 1. Precio de FLOWER (USD)
      const flowerPrice = json.flowerPrice ? parseFloat(json.flowerPrice) : 0.0854;
      window.sflFlowerPrice = flowerPrice;
      const flowerDisplay = document.getElementById("quickFlowerPriceDisplay");
      if (flowerDisplay) {
        flowerDisplay.innerText = "$" + flowerPrice.toFixed(4);
      }

      // 2. Precio de Coins (Ratio P2P)
      let bestCoinsPerFlower = 0;
      if (json.items && bettyPrices) {
        Object.keys(bettyPrices).forEach((name) => {
          const itemConfig = bettyPrices[name];
          const itemId = Object.keys(sflIds).find((key) => sflIds[key] === name);
          if (!itemId) return;
          const internalKey = `collectibles-${itemId}`;
          const marketItem = json.items[internalKey];
          const bettyPriceCoins = itemConfig.sellPrice;
          const p2pPriceFlower = marketItem ? marketItem.currentPrice : 0;
          if (p2pPriceFlower > 0) {
            const coinsPerFlower = bettyPriceCoins / p2pPriceFlower;
            if (coinsPerFlower > bestCoinsPerFlower) {
              bestCoinsPerFlower = coinsPerFlower;
            }
          }
        });
      }
      if (bestCoinsPerFlower <= 0) bestCoinsPerFlower = 1330;
      window.sflAutoCoinsPerFlower = bestCoinsPerFlower;

      // 3. Caña de Pescar (1 Stone + 3 Wood + 20 Coins)
      const stonePrice = priceDict["Stone"] || (json.items['collectibles-602']?.currentPrice) || 0;
      const woodPrice = priceDict["Wood"] || (json.items['collectibles-601']?.currentPrice) || 0;
      window.sflStonePrice = stonePrice;
      window.sflWoodPrice = woodPrice;

      // 4. Petróleo / Oil (Oil Drill: 20 Wood + 9 Iron + 10 Leather + 100 Coins -> rinde 16.67 Oil)
      const ironPrice = priceDict["Iron"] || (json.items['collectibles-603']?.currentPrice) || 0;
      const leatherPrice = priceDict["Leather"] || (json.items['collectibles-641']?.currentPrice) || 0;
      window.sflIronPrice = ironPrice;
      window.sflLeatherPrice = leatherPrice;

      // Actualizar precios clave dinámicos (soporta edición personalizada de Coins y Rod)
      window.updateKeyPrices();

      // 5. Gemas / Gems (Gema P2P: 0.0103 USD con 29% bonus -> convertido a FLOWER)
      const gemBaseUsd = 0.0103;
      const gemBonus = 0.29;
      const gemCostUsd = gemBaseUsd / (1 + gemBonus);
      const gemCostFlower = gemCostUsd / (flowerPrice || 0.0854);
      window.sflGemPrice = gemCostFlower;
      const gemsDisplay = document.getElementById("quickGemsPriceDisplay");
      if (gemsDisplay) {
        gemsDisplay.innerText = formatNumber(gemCostFlower, 4);
      }

      loadingState.classList.add("hidden")
      dataContainer.classList.remove("hidden")

      renderTable()
      updateSkillCalculator()
    } catch (err) {
      console.error(err)
      loadingState.innerHTML = `<p class="text-red-500 text-sm">${tError}</p>`
    }
  }

  // Listeners
  const levelRange = document.getElementById("skillLevelRange");
  const levelInput = document.getElementById("skillLevelInput");

  if (levelRange && levelInput) {
    levelRange.addEventListener("input", (e) => {
      levelInput.value = e.target.value;
      updateSkillCalculator();
      if (typeof saveState === "function") saveState();
    });

    levelInput.addEventListener("input", (e) => {
      let val = parseInt(e.target.value);
      if (isNaN(val)) return;
      if (val < 1) val = 1;
      if (val > 200) val = 200;
      levelRange.value = val;
      updateSkillCalculator();
      if (typeof saveState === "function") saveState();
    });

    levelInput.addEventListener("blur", (e) => {
      let val = parseInt(e.target.value);
      if (isNaN(val) || val < 1) val = 1;
      if (val > 200) val = 200;
      e.target.value = val;
      levelRange.value = val;
      updateSkillCalculator();
      if (typeof saveState === "function") saveState();
    });
  }

  document.querySelectorAll('.dash-hide-xp-btn, .hide-xp-btn').forEach(btn => {
    btn.addEventListener('click', (e) => {
      window.manualSelectedDish = null;
      const target = e.currentTarget;
      const minXpAttr = target.dataset.minXp !== undefined ? target.dataset.minXp : target.dataset.xp;
      const limit = parseInt(minXpAttr);
      if (window.currentHideXpLimit === limit) {
        window.setHideXpLimit(0);
      } else {
        window.setHideXpLimit(limit);
      }
    });
  });

  ['dashCustomHideXp', 'custom-hide-xp'].forEach(id => {
    const customInput = document.getElementById(id);
    if (customInput) {
      customInput.addEventListener('input', (e) => {
        window.manualSelectedDish = null;
        const val = e.target.value;
        const limit = val ? parseInt(val) : 0;
        window.setHideXpLimit(isNaN(limit) ? 0 : limit);
      });
    }
  });

  // Funciones y Listeners del Menú Desplegable de Platos
  const toggleDishDropdown = () => {
    const menu = document.getElementById("dishSelectDropdownMenu");
    const chevron = document.getElementById("dishDropdownChevron");
    const btn = document.getElementById("dishSelectDropdownBtn");
    if (!menu) return;

    const isHidden = menu.classList.contains("hidden");
    if (isHidden) {
      menu.classList.remove("hidden");
      if (chevron) chevron.classList.add("rotate-180");
      if (btn) btn.setAttribute("aria-expanded", "true");
      renderDishDropdownList();
      const searchInput = document.getElementById("dishDropdownSearch");
      if (searchInput) {
        searchInput.value = "";
        setTimeout(() => searchInput.focus(), 50);
      }
    } else {
      closeDishDropdown();
    }
  };

  const closeDishDropdown = () => {
    const menu = document.getElementById("dishSelectDropdownMenu");
    const chevron = document.getElementById("dishDropdownChevron");
    const btn = document.getElementById("dishSelectDropdownBtn");
    if (menu) menu.classList.add("hidden");
    if (chevron) chevron.classList.remove("rotate-180");
    if (btn) btn.setAttribute("aria-expanded", "false");
  };

  window.selectManualDish = (dishName) => {
    window.manualSelectedDish = dishName;
    closeDishDropdown();
    updateSkillCalculator();
    if (typeof saveState === "function") saveState();
  };

  const renderDishDropdownList = (search = "") => {
    const listContainer = document.getElementById("dishDropdownList");
    if (!listContainer) return;

    const query = search.trim().toLowerCase();
    
    // Calcular eficiencia de todos los platos con boosts actuales
    const sortedDishes = recipesData
      .map((recipe) => {
        const calcXp = getCalculatedXp(recipe);
        const costObj = calculateRecipeCost(recipe.ingredients);
        const totalCost = costObj.total;
        const efficiency = totalCost > 0 ? calcXp / totalCost : 0;
        return {
          ...recipe,
          calcXp,
          totalCost,
          efficiency,
          missing: costObj.missing
        };
      })
      .filter((r) => r.totalCost > 0)
      .sort((a, b) => b.efficiency - a.efficiency);

    const isAutoActive = !window.manualSelectedDish;
    const labelAutoOptimal = listContainer.dataset.labelAutoOptimal || "Automático (Más Óptimo)";
    const labelAutoDesc = listContainer.dataset.labelAutoDesc || "Selecciona siempre el de mayor rendimiento según boosts";
    const labelNoDishes = listContainer.dataset.labelNoDishes || "No se encontraron platos";
    const labelCost = listContainer.dataset.labelCost || "Costo:";
    const labelLowXp = listContainer.dataset.labelLowXp || "Baja XP (< 1,000 XP)";

    let html = `
      <button
        type="button"
        class="w-full px-3 py-2 text-left flex items-center justify-between gap-2 hover:bg-white/10 transition-colors cursor-pointer ${isAutoActive ? 'bg-emerald-500/15 text-emerald-400 font-bold' : 'text-white/80'}"
        onclick="window.selectManualDish(null)"
      >
        <div class="flex items-center gap-2.5">
          <span class="text-sm">⚡</span>
          <div class="flex flex-col">
            <span class="text-xs ${isAutoActive ? 'text-emerald-400 font-bold' : 'text-white'}">${labelAutoOptimal}</span>
            <span class="text-[9px] text-white/40">${labelAutoDesc}</span>
          </div>
        </div>
        ${isAutoActive ? '<span class="text-xs text-emerald-400">✓</span>' : ''}
      </button>
      <div class="border-t border-white/10 my-1"></div>
    `;

    const filtered = query
      ? sortedDishes.filter((d) => d.name.toLowerCase().includes(query))
      : sortedDishes;

    if (filtered.length === 0) {
      html += `<div class="p-3 text-center text-white/40 text-xs font-mono">${labelNoDishes}</div>`;
    } else {
      filtered.forEach((dish) => {
        const isSelected = window.manualSelectedDish === dish.name;
        const safeName = dish.name.replace(/'/g, "\\'");
        const effDecimals = dish.efficiency >= 100 ? 0 : 1;
        const costDecimals = dish.totalCost >= 100 ? 0 : 2;
        const isLowXp = dish.calcXp < 1000;

        html += `
          <button
            type="button"
            class="w-full px-3 py-2 text-left flex items-center gap-2.5 hover:bg-white/10 transition-colors cursor-pointer ${isSelected ? 'bg-emerald-500/20 text-emerald-400' : 'text-white/90'}"
            onclick="window.selectManualDish('${safeName}')"
          >
            <img src="/img/sunflowerland/food/${dish.name}.png" class="w-6 h-6 object-contain shrink-0 drop-shadow" onerror="window.handleImgError(this)" />
            <div class="flex flex-col min-w-0 flex-1">
              <div class="flex items-center justify-between gap-1">
                <span class="text-xs truncate font-medium ${isSelected ? 'text-emerald-400 font-bold' : 'text-white'}">${dish.name}</span>
                <span class="text-xs font-mono font-bold ${isSelected ? 'text-emerald-300' : 'text-emerald-400'} shrink-0">${formatNumber(dish.efficiency, effDecimals)} <span class="text-[9px] text-white/50 font-normal">XP/FLOWER</span></span>
              </div>
              <div class="flex items-center gap-2 text-[10px] text-white/40 font-mono mt-0.5">
                <span>${labelCost} ${formatNumber(dish.totalCost, costDecimals)} FLOWER</span>
                <span>•</span>
                <span>${formatNumber(dish.calcXp, 0)} XP${isLowXp ? ` <span class="inline-block text-[11px] leading-none select-none cursor-help" title="${labelLowXp}">😐</span>` : ''}</span>
              </div>
            </div>
            ${isSelected ? '<span class="text-xs text-emerald-400 ml-1">✓</span>' : ''}
          </button>
        `;
      });
    }

    listContainer.innerHTML = html;
  };

  const dishDropdownBtn = document.getElementById("dishSelectDropdownBtn");
  if (dishDropdownBtn) {
    dishDropdownBtn.addEventListener("click", (e) => {
      e.stopPropagation();
      toggleDishDropdown();
    });
  }

  const manualBadge = document.getElementById("dishManualBadge");
  if (manualBadge) {
    manualBadge.addEventListener("click", (e) => {
      e.stopPropagation();
      window.selectManualDish(null);
    });
  }

  const dishDropdownSearch = document.getElementById("dishDropdownSearch");
  if (dishDropdownSearch) {
    dishDropdownSearch.addEventListener("input", (e) => {
      renderDishDropdownList(e.target.value);
    });
    dishDropdownSearch.addEventListener("click", (e) => {
      e.stopPropagation();
    });
  }

  document.addEventListener("click", (e) => {
    const container = document.getElementById("dishSelectContainer");
    if (container && !container.contains(e.target)) {
      closeDishDropdown();
    }
  });

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") closeDishDropdown();
  });

  document.querySelectorAll(".buff-checkbox").forEach((cb) => {
    cb.addEventListener("change", (e) => {
      const buffId = e.target.dataset.buffId;
      const card = e.target.closest('label');
      if (e.target.checked) {
        activeBuffs.add(buffId);
        if (card) {
          card.classList.add("border-emerald-500/50", "bg-emerald-500/10", "active");
          card.classList.remove("border-white/5", "bg-white/5");
        }
      } else {
        activeBuffs.delete(buffId);
        if (card) {
          card.classList.remove("border-emerald-500/50", "bg-emerald-500/10", "active");
          card.classList.add("border-white/5", "bg-white/5");
        }
      }
      renderTable(searchInput ? searchInput.value : "");
      updateSkillCalculator();
      if (typeof saveState === "function") saveState();
    });
  });

  const formatSkillDescription = (skillName, rank, originalDesc) => {
    const skill = sflSkills[skillName] || sflOthers[skillName] || sflConsumables[skillName];
    if (!skill) return originalDesc;
    
    // When rank is 0, we still want to show the rank_1 values instead of {math} templates
    const effectiveRank = rank === 0 ? 1 : rank;
    let updatedDesc = originalDesc;
    
    if (skill.mathematics_1 && skill.mathematics_1.calc_by_rank) {
      const m1 = skill.mathematics_1.calc_by_rank[`rank_${effectiveRank}`];
      if (m1 !== undefined) {
         updatedDesc = updatedDesc.replace('{math1}', m1);
         updatedDesc = updatedDesc.replace('{math1_pct}', parseFloat((m1 * 100).toFixed(2)));
         updatedDesc = updatedDesc.replace('{math1_days}', parseFloat((m1 / 86400000).toFixed(2)));
      }
    }
    
    if (skill.mathematics_2 && skill.mathematics_2.calc_by_rank) {
      const m2 = skill.mathematics_2.calc_by_rank[`rank_${effectiveRank}`];
      if (m2 !== undefined) {
         updatedDesc = updatedDesc.replace('{math2}', m2);
         updatedDesc = updatedDesc.replace('{math2_pct}', parseFloat((m2 * 100).toFixed(2)));
         updatedDesc = updatedDesc.replace('{math2_days}', parseFloat((m2 / 86400000).toFixed(2)));
      }
    }
    
    return updatedDesc;
  };

  const updateSkillUI = (skillId) => {
    const rank = activeSkills[skillId] || 0;
    const safeId = skillId.replace(/\s+/g, '_');
    
    // Update card styling
    const card = document.querySelector(`.skill-card[data-skill-id="${skillId}"]`);
    if (card) {
      if (rank > 0) {
        card.classList.add("border-blue-500/50", "bg-blue-500/10", "active");
        card.classList.remove("border-white/5", "bg-white/5");
      } else {
        card.classList.remove("border-blue-500/50", "bg-blue-500/10", "active");
        card.classList.add("border-white/5", "bg-white/5");
      }
      
      const descSpan = card.querySelector('.skill-description-text');
      let updatedDesc = "";
      if (descSpan) {
        updatedDesc = formatSkillDescription(skillId, rank, descSpan.dataset.original);
        descSpan.textContent = updatedDesc;
      }
      
      const compactSpan = card.querySelector('.compact-view span');
      if (compactSpan) {
        if (skillId === "Faction Pet") {
          const labels = ["10%", "20%", "30%", "50%"];
          const displayVal = rank > 0 ? "+" + labels[rank - 1] : "?";
          compactSpan.textContent = compactSpan.textContent.replace(/^[^\s]+/, displayVal);
        } else if (descSpan) {
          const descToParse = rank === 0 ? formatSkillDescription(skillId, 1, descSpan.dataset.original) : updatedDesc;
          const match = descToParse.match(/(?:^|\b|\s)([x+-]?\d+(?:\.\d+)?(?:%|x)?)/i);
          if (match) {
            let newVal = match[1].trim();
            if (newVal.toLowerCase().endsWith('x')) newVal = 'x' + newVal.slice(0, -1);
            compactSpan.textContent = compactSpan.textContent.replace(/^[^\s]+/, newVal);
          }
        }
      }
    }
    
    // Update checkboxes progressively
    document.querySelectorAll(`.rank-input-${safeId}`).forEach((cb) => {
      const cbRank = parseInt(cb.dataset.rank);
      cb.checked = skillId === "Faction Pet" ? cbRank === rank : cbRank <= rank;
    });
  };

  document.querySelectorAll(".skill-card").forEach((card) => {
    card.addEventListener("click", (e) => {
      const skillId = card.dataset.skillId;
      if (activeSkills[skillId]) {
        delete activeSkills[skillId]; // Turn off
      } else {
        activeSkills[skillId] = 1; // Turn on to rank 1
      }
      updateSkillUI(skillId);
      renderTable(searchInput ? searchInput.value : "");
      updateSkillCalculator();
      if (typeof saveState === "function") saveState();
    });
  });

  document.querySelectorAll(".skill-rank-checkbox").forEach((cb) => {
    cb.addEventListener("change", (e) => {
      const skillId = e.target.dataset.skillId;
      const rank = parseInt(e.target.value);
      
      if (e.target.checked) {
        // Turning ON a rank => set skill to that rank
        activeSkills[skillId] = rank;
      } else {
        // Turning OFF a rank => set skill to rank-1 (or delete if 0)
        if (skillId === "Faction Pet") {
          delete activeSkills[skillId];
        } else if (rank - 1 > 0) {
          activeSkills[skillId] = rank - 1;
        } else {
          delete activeSkills[skillId];
        }
      }
      updateSkillUI(skillId);
      renderTable(searchInput ? searchInput.value : "");
      updateSkillCalculator();
      if (typeof saveState === "function") saveState();
    });
  });

  document.querySelectorAll(".category-btn").forEach((btn) => {
    btn.addEventListener("click", (e) => {
      window.handleCategory(e.target.dataset.category)
    })
  })

  if (searchInput) {
    searchInput.addEventListener("input", (e) => {
      renderTable(e.target.value)
    })
  }


  window.setViewStyle = function(style) {
    const container = document.getElementById('boosts-container');
    if (style === 'compact') container.classList.add('is-compact');
    else container.classList.remove('is-compact');
    
    document.querySelectorAll('.view-switch-btn').forEach(b => b.classList.remove('active'));
    document.querySelectorAll('.view-switch-btn[data-action="' + style + '"]').forEach(btn => btn.classList.add('active'));
    
    if (typeof saveState === "function") saveState();
  };

  window.toggleBoostFilter = function(filter) {
    const container = document.getElementById("boosts-container");
    document.querySelectorAll(".filter-boost-btn").forEach(btn => btn.classList.remove("active"));
    
    if (filter === 'all') {
      container.removeAttribute("data-filter");
    } else {
      container.setAttribute("data-filter", filter);
    }
    document.querySelectorAll('.filter-boost-btn[data-filter="' + filter + '"]').forEach(btn => btn.classList.add('active'));
    
    if (typeof saveState === "function") saveState();
  };

  const loadState = () => {
    const cached = localStorage.getItem(CACHE_KEY);
    if (cached) {
      try {
        const state = JSON.parse(cached);
        if (state.activeBuffs) {
          state.activeBuffs.forEach(buffId => {
            activeBuffs.add(buffId);
            const cb = document.querySelector(`.buff-checkbox[data-buff-id="${buffId}"]`);
            if (cb) {
              cb.checked = true;
              const card = cb.closest('label');
              if (card) {
                card.classList.add("border-emerald-500/50", "bg-emerald-500/10", "active");
                card.classList.remove("border-white/5", "bg-white/5");
              }
            }
          });
        }
        if (state.activeSkills) {
          activeSkills = state.activeSkills;
          Object.keys(activeSkills).forEach(skillId => updateSkillUI(skillId));
        }
        if (state.currentCategory) {
          window.handleCategory(state.currentCategory);
        }
        if (state.currentHideXpLimit) {
          window.setHideXpLimit(state.currentHideXpLimit);
        } else {
          window.setHideXpLimit(0);
        }
        if (state.manualSelectedDish) {
          window.manualSelectedDish = state.manualSelectedDish;
        }
        
        if (state.customCoins) {
          window.sflCustomCoinsPerFlower = parseFloat(state.customCoins);
        }
        if (state.customRod !== null && state.customRod !== undefined) {
          window.sflCustomRodCost = parseFloat(state.customRod);
        }
        if (state.customFishFlake !== null && state.customFishFlake !== undefined) {
          window.sflCustomFishFlakeCost = parseFloat(state.customFishFlake);
        }
        if (state.customFishStick !== null && state.customFishStick !== undefined) {
          window.sflCustomFishStickCost = parseFloat(state.customFishStick);
        }
        if (state.customCrabStick !== null && state.customCrabStick !== undefined) {
          window.sflCustomCrabStickCost = parseFloat(state.customCrabStick);
        }
        if (state.customFishOil !== null && state.customFishOil !== undefined) {
          window.sflCustomFishOilCost = parseFloat(state.customFishOil);
        }
        const isFirstTimeBoosts = localStorage.getItem("sfl_boosts_expanded") !== "true";
        if (state.boostFilter && !isFirstTimeBoosts) {
          window.toggleBoostFilter(state.boostFilter);
        } else {
          window.toggleBoostFilter('all');
        }
        if (state.viewStyle && !isFirstTimeBoosts) {
          window.setViewStyle(state.viewStyle);
        } else {
          window.setViewStyle('detailed');
        }
        const targetLevel = (state.skillLevel && state.skillLevel !== "10") ? state.skillLevel : "100";
        const range = document.getElementById("skillLevelRange");
        const input = document.getElementById("skillLevelInput");
        const badge = document.getElementById("skillSliderBadge");
        if (range) range.value = targetLevel;
        if (input) input.value = targetLevel;
        if (badge) badge.innerText = `Lvl ${targetLevel}`;
      } catch (e) {
        console.error("Failed to parse cached state", e);
      }
    } else {
      window.setHideXpLimit(0);
      window.toggleBoostFilter('all');
      window.setViewStyle('detailed');
    }
  };

  window.updateKeyPrices = function() {
    // 1. Coins
    const autoCoins = window.sflAutoCoinsPerFlower || 1330;
    const isCustomCoins = window.sflCustomCoinsPerFlower !== null && window.sflCustomCoinsPerFlower !== undefined && window.sflCustomCoinsPerFlower > 0;
    const effectiveCoins = isCustomCoins ? window.sflCustomCoinsPerFlower : autoCoins;
    window.sflBestCoinsPerFlower = effectiveCoins;

    const coinsInput = document.getElementById("quickCoinsInput");
    const resetCoinsBtn = document.getElementById("resetCoinsBtn");
    if (coinsInput) {
      coinsInput.value = Math.round(effectiveCoins);
      if (isCustomCoins) {
        coinsInput.classList.add("text-amber-400", "border-amber-400/50");
        coinsInput.classList.remove("text-emerald-400");
      } else {
        coinsInput.classList.remove("text-amber-400", "border-amber-400/50");
        coinsInput.classList.add("text-emerald-400");
      }
    }
    if (resetCoinsBtn) {
      if (isCustomCoins) resetCoinsBtn.classList.remove("hidden");
      else resetCoinsBtn.classList.add("hidden");
    }

    // 2. Rod
    const stoneP = window.sflStonePrice || 0;
    const woodP = window.sflWoodPrice || 0;
    const rodCoinsInFlower = 20 / effectiveCoins;
    const autoRodCost = (1 * stoneP) + (3 * woodP) + rodCoinsInFlower;
    window.sflAutoRodCost = autoRodCost;

    const isCustomRod = window.sflCustomRodCost !== null && window.sflCustomRodCost !== undefined && window.sflCustomRodCost >= 0;
    const effectiveRod = isCustomRod ? window.sflCustomRodCost : autoRodCost;
    window.sflRodCost = effectiveRod;

    const rodInput = document.getElementById("fishingRodInput");
    const resetRodBtn = document.getElementById("resetRodBtn");
    if (rodInput) {
      rodInput.value = isCustomRod ? effectiveRod.toString() : formatNumber(effectiveRod, 4);
      if (isCustomRod) {
        rodInput.classList.add("text-amber-400", "border-amber-400/50");
        rodInput.classList.remove("text-emerald-400");
      } else {
        rodInput.classList.remove("text-amber-400", "border-amber-400/50");
        rodInput.classList.add("text-emerald-400");
      }
    }
    if (resetRodBtn) {
      if (isCustomRod) resetRodBtn.classList.remove("hidden");
      else resetRodBtn.classList.add("hidden");
    }

    // Helper para actualizar inputs de derivados
    const updateDerivedPriceInput = (inputId, resetBtnId, customCost, autoCost) => {
      const isCustom = customCost !== null && customCost !== undefined && customCost >= 0;
      const effectiveVal = isCustom ? customCost : autoCost;
      const inputEl = document.getElementById(inputId);
      const resetEl = document.getElementById(resetBtnId);
      if (inputEl) {
        inputEl.value = isCustom ? effectiveVal.toString() : formatNumber(effectiveVal, 4);
        if (isCustom) {
          inputEl.classList.add("text-amber-400", "border-amber-400/50");
          inputEl.classList.remove("text-emerald-400");
        } else {
          inputEl.classList.remove("text-amber-400", "border-amber-400/50");
          inputEl.classList.add("text-emerald-400");
        }
      }
      if (resetEl) {
        if (isCustom) resetEl.classList.remove("hidden");
        else resetEl.classList.add("hidden");
      }
    };

    // 3. Fish Flake (8 rods por defecto)
    updateDerivedPriceInput(
      "quickFishFlakeInput",
      "resetFishFlakeBtn",
      window.sflCustomFishFlakeCost,
      8 * effectiveRod
    );

    // 4. Fish Stick (10 rods por defecto)
    updateDerivedPriceInput(
      "quickFishStickInput",
      "resetFishStickBtn",
      window.sflCustomFishStickCost,
      10 * effectiveRod
    );

    // 5. Crab Stick (5.9 FLOWER promedio por defecto)
    updateDerivedPriceInput(
      "quickCrabStickInput",
      "resetCrabStickBtn",
      window.sflCustomCrabStickCost,
      5.9
    );

    // 6. Fish Oil (14 rods por defecto)
    updateDerivedPriceInput(
      "quickFishOilInput",
      "resetFishOilBtn",
      window.sflCustomFishOilCost,
      14 * effectiveRod
    );
  };

  const setupEditablePrice = (inputId, resetBtnId, customKey) => {
    const inputEl = document.getElementById(inputId);
    const resetBtnEl = document.getElementById(resetBtnId);
    if (inputEl) {
      const handleChange = (e) => {
        const rawStr = (e.target.value || "").trim().replace(',', '.');
        const val = parseFloat(rawStr);
        if (!isNaN(val) && val >= 0) {
          window[customKey] = val;
        } else {
          window[customKey] = null;
        }
        window.updateKeyPrices();
        renderTable(searchInput ? searchInput.value : "");
        updateSkillCalculator();
        if (typeof saveState === "function") saveState();
      };
      inputEl.addEventListener("change", handleChange);
      inputEl.addEventListener("keydown", (e) => {
        if (e.key === "Enter") inputEl.blur();
      });
    }
    if (resetBtnEl) {
      resetBtnEl.addEventListener("click", (e) => {
        e.stopPropagation();
        window[customKey] = null;
        window.updateKeyPrices();
        renderTable(searchInput ? searchInput.value : "");
        updateSkillCalculator();
        if (typeof saveState === "function") saveState();
      });
    }
  };

  setupEditablePrice("quickCoinsInput", "resetCoinsBtn", "sflCustomCoinsPerFlower");
  setupEditablePrice("fishingRodInput", "resetRodBtn", "sflCustomRodCost");
  setupEditablePrice("quickFishFlakeInput", "resetFishFlakeBtn", "sflCustomFishFlakeCost");
  setupEditablePrice("quickFishStickInput", "resetFishStickBtn", "sflCustomFishStickCost");
  setupEditablePrice("quickCrabStickInput", "resetCrabStickBtn", "sflCustomCrabStickCost");
  setupEditablePrice("quickFishOilInput", "resetFishOilBtn", "sflCustomFishOilCost");

  const boostsExpandBtn = document.getElementById("boosts-expand-btn");
  if (boostsExpandBtn && window.expandBoosts) {
    boostsExpandBtn.addEventListener("click", window.expandBoosts);
  }
  
  // Init
  loadState();
  fetchPrices()
</script>





