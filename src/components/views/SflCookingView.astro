  const startRange = document.getElementById("skillStartLevelRange");
  const startInput = document.getElementById("skillStartLevelInput");
  const levelRange = document.getElementById("skillLevelRange");
  const levelInput = document.getElementById("skillLevelInput");

  if (startRange && levelRange) {
    startRange.addEventListener("mousedown", () => {
      startRange.style.zIndex = "25";
      levelRange.style.zIndex = "20";
    });
    startRange.addEventListener("touchstart", () => {
      startRange.style.zIndex = "25";
      levelRange.style.zIndex = "20";
    });
    levelRange.addEventListener("mousedown", () => {
      levelRange.style.zIndex = "25";
      startRange.style.zIndex = "20";
    });
    levelRange.addEventListener("touchstart", () => {
      levelRange.style.zIndex = "25";
      startRange.style.zIndex = "20";
    });

    startRange.addEventListener("input", (e) => {
      let sVal = parseInt(e.target.value) || 1;
      let tVal = parseInt(levelRange.value) || 100;
      if (sVal > tVal) {
        tVal = sVal;
        levelRange.value = tVal;
        if (levelInput) levelInput.value = tVal;
      }
      if (startInput) startInput.value = sVal;
      updateRangeHighlight(sVal, tVal);
      updateSkillCalculator();
      if (typeof saveState === "function") saveState();
    });

    levelRange.addEventListener("input", (e) => {
      let tVal = parseInt(e.target.value) || 100;
      let sVal = parseInt(startRange.value) || 1;
      if (tVal < sVal) {
        sVal = tVal;
        startRange.value = sVal;
        if (startInput) startInput.value = sVal;
      }
      if (levelInput) levelInput.value = tVal;
      updateRangeHighlight(sVal, tVal);
      updateSkillCalculator();
      if (typeof saveState === "function") saveState();
    });
  }

  if (startInput) {
    startInput.addEventListener("input", (e) => {
      let val = parseInt(e.target.value);
      if (isNaN(val)) return;
      if (val >= 1 && val <= 200 && startRange) {
        startRange.value = val;
      }
      updateSkillCalculator();
      if (typeof saveState === "function") saveState();
    });

    startInput.addEventListener("blur", (e) => {
      let val = parseInt(e.target.value);
      if (isNaN(val) || val < 1) val = 1;
      if (val > 200) val = 200;
      let tVal = parseInt(levelInput ? levelInput.value : 100);
      if (isNaN(tVal) || tVal < 1) tVal = 1;
      if (tVal > 200) tVal = 200;

      if (val > tVal) {
        tVal = val;
        if (levelInput) levelInput.value = tVal;
        if (levelRange) levelRange.value = tVal;
      }
      e.target.value = val;
      if (startRange) startRange.value = val;
      updateRangeHighlight(val, tVal);
      updateSkillCalculator();
      if (typeof saveState === "function") saveState();
    });
  }

  if (levelInput) {
    levelInput.addEventListener("input", (e) => {
      let val = parseInt(e.target.value);
      if (isNaN(val)) return;
      if (val >= 1 && val <= 200 && levelRange) {
        levelRange.value = val;
      }
      updateSkillCalculator();
      if (typeof saveState === "function") saveState();
    });

    levelInput.addEventListener("blur", (e) => {
      let val = parseInt(e.target.value);
      if (isNaN(val) || val < 1) val = 1;
      if (val > 200) val = 200;
      let sVal = parseInt(startInput ? startInput.value : 1);
      if (isNaN(sVal) || sVal < 1) sVal = 1;
      if (sVal > 200) sVal = 200;

      if (val < sVal) {
        sVal = val;
        if (startInput) startInput.value = sVal;
        if (startRange) startRange.value = sVal;
      }
      e.target.value = val;
      if (levelRange) levelRange.value = val;
      updateRangeHighlight(sVal, val);
      updateSkillCalculator();
      if (typeof saveState === "function") saveState();
    });
  }

  document.querySelectorAll('.dash-hide-xp-btn, .hide-xp-btn').forEach(btn => {
    btn.addEventListener('click', (e) => {
      window.manualSelectedDish = null;
      const target = e.currentTarget;
      const minXpAttr = target.dataset.minXp !== undefined ? target.dataset.minXp : target.dataset.xp;
      const limit = parseInt(minXpAttr);
      if (window.currentHideXpLimit === limit) {
        window.setHideXpLimit(0, 'preset');
      } else {
        window.setHideXpLimit(limit, 'preset');
      }
    });
  });

  ['dashCustomHideXp', 'custom-hide-xp'].forEach(id => {
    const customInput = document.getElementById(id);
    if (customInput) {
      customInput.addEventListener('input', (e) => {
        window.manualSelectedDish = null;
        const val = e.target.value.trim();
        const limit = val ? parseInt(val, 10) : 0;
        window.setHideXpLimit(isNaN(limit) ? 0 : limit, 'custom', e.target);
      });
    }
  });

  // Funciones y Listeners del Menú Desplegable de Platos
  const toggleDishDropdown = () => {
    const menu = document.getElementById("dishSelectDropdownMenu");
    const chevron = document.getElementById("dishDropdownChevron");
    const btn = document.getElementById("dishSelectDropdownBtn");
    if (!menu) return;

    const isHidden = menu.classList.contains("hidden");
    if (isHidden) {
      menu.classList.remove("hidden");
      if (chevron) chevron.classList.add("rotate-180");
      if (btn) btn.setAttribute("aria-expanded", "true");
      renderDishDropdownList();
      const searchInput = document.getElementById("dishDropdownSearch");
      if (searchInput) {
        searchInput.value = "";
        setTimeout(() => searchInput.focus(), 50);
      }
    } else {
      closeDishDropdown();
    }
  };

  const closeDishDropdown = () => {
    const menu = document.getElementById("dishSelectDropdownMenu");
    const chevron = document.getElementById("dishDropdownChevron");
    const btn = document.getElementById("dishSelectDropdownBtn");
    if (menu) menu.classList.add("hidden");
    if (chevron) chevron.classList.remove("rotate-180");
    if (btn) btn.setAttribute("aria-expanded", "false");
  };

  window.selectManualDish = (dishName) => {
    window.manualSelectedDish = dishName;
    closeDishDropdown();
    updateSkillCalculator();
    if (typeof saveState === "function") saveState();
  };

  const renderDishDropdownList = (search = "") => {
    const listContainer = document.getElementById("dishDropdownList");
    if (!listContainer) return;

    const query = search.trim().toLowerCase();
    
    // Calcular eficiencia de todos los platos con boosts actuales
    const sortedDishes = recipesData
      .map((recipe) => {
        const calcXp = getCalculatedXp(recipe);
        const costObj = calculateRecipeCost(recipe.ingredients, new Set(), true, recipe.building === "Aging Shed", recipe.building === "Fish");
        const totalCost = costObj.total;
        const efficiency = totalCost > 0 ? calcXp / totalCost : 0;
        return {
          ...recipe,
          calcXp,
          totalCost,
          efficiency,
          missing: costObj.missing
        };
      })
      .filter((r) => r.totalCost > 0)
      .sort((a, b) => b.efficiency - a.efficiency);

    const isAutoActive = !window.manualSelectedDish;
    const labelAutoOptimal = listContainer.dataset.labelAutoOptimal || "Automático (Más Óptimo)";
    const labelAutoDesc = listContainer.dataset.labelAutoDesc || "Selecciona siempre el de mayor rendimiento según boosts";
    const labelNoDishes = listContainer.dataset.labelNoDishes || "No se encontraron platos";
    const labelCost = listContainer.dataset.labelCost || "Costo:";
    const labelLowXp = listContainer.dataset.labelLowXp || "Baja XP (< 1,000 XP)";

    let html = `
      <button
        type="button"
        class="w-full px-3 py-2 text-left flex items-center justify-between gap-2 hover:bg-white/10 transition-colors cursor-pointer ${isAutoActive ? 'bg-emerald-500/15 text-emerald-400 font-bold' : 'text-white/80'}"
        onclick="window.selectManualDish(null)"
      >
        <div class="flex items-center gap-2.5">
          <span class="text-sm">⚡</span>
          <div class="flex flex-col">
            <span class="text-xs ${isAutoActive ? 'text-emerald-400 font-bold' : 'text-white'}">${labelAutoOptimal}</span>
            <span class="text-[9px] text-white/40">${labelAutoDesc}</span>
          </div>
        </div>
        ${isAutoActive ? '<span class="text-xs text-emerald-400">✓</span>' : ''}
      </button>
      <div class="border-t border-white/10 my-1"></div>
    `;

    const filtered = query
      ? sortedDishes.filter((d) => d.name.toLowerCase().includes(query))
      : sortedDishes;

    if (filtered.length === 0) {
      html += `<div class="p-3 text-center text-white/40 text-xs font-mono">${labelNoDishes}</div>`;
    } else {
      filtered.forEach((dish) => {
        const isSelected = window.manualSelectedDish === dish.name;
        const safeName = dish.name.replace(/'/g, "\\'");
        const effDecimals = dish.efficiency >= 100 ? 0 : 1;
        const costDecimals = dish.totalCost >= 100 ? 0 : 2;
        const isLowXp = dish.calcXp < 1000;
        const isAgingDish = dish.building === "Aging Shed" || dish.name.startsWith("Aged ");
        const rawFishName = isAgingDish ? dish.name.replace(/^Aged\s+/i, "") : null;
        const rawFishImg = isAgingDish ? (dish.image || `/img/sunflowerland/fish/${rawFishName}.png`) : null;

        html += `
          <button
            type="button"
            class="w-full px-3 py-2 text-left flex items-center gap-2.5 hover:bg-white/10 transition-colors cursor-pointer ${isSelected ? 'bg-emerald-500/20 text-emerald-400' : 'text-white/90'}"
            onclick="window.selectManualDish('${safeName}')"
          >
            <div class="relative w-6 h-6 shrink-0 flex items-center justify-center">
              ${
                isAgingDish && rawFishImg
                  ? `
                <div class="absolute -top-1 -left-1 w-3 h-3 rounded-full bg-black/90 border border-white/25 p-0.5 flex items-center justify-center pointer-events-none z-10 shadow-sm" title="${rawFishName}">
                  <img src="${rawFishImg}" alt="${rawFishName}" width="12" height="12" class="w-full h-full object-contain [image-rendering:pixelated]" loading="lazy" decoding="async" />
                </div>
              `
                  : ""
              }
              <img src="${dish.image || `/img/sunflowerland/food/${dish.name}.png`}" class="w-full h-full object-contain drop-shadow ${isAgingDish ? 'aged-fish-filter [image-rendering:pixelated]' : ''}" alt="${safeName}" width="24" height="24" onerror="window.handleImgError(this)" />
            </div>
            <div class="flex flex-col min-w-0 flex-1">
              <div class="flex items-center justify-between gap-1">
                <span class="text-xs truncate font-medium ${isSelected ? 'text-emerald-400 font-bold' : 'text-white'} flex items-center gap-1.5">
                  ${dish.name}
                  ${dish.event ? `<span class="px-1 py-0.5 rounded text-[9px] font-mono ${isEventEnded(dish) ? 'bg-amber-500/20 text-amber-300 border border-amber-500/30' : 'bg-purple-500/20 text-purple-300 border border-purple-500/40'} shrink-0">✨ ${dish.event}</span>` : ''}
                </span>
                <span class="text-xs font-mono font-bold ${isSelected ? 'text-emerald-300' : 'text-emerald-400'} shrink-0">${formatNumber(dish.efficiency, effDecimals)} <span class="text-[9px] text-white/50 font-normal">XP/FLOWER</span></span>
              </div>
              <div class="flex items-center gap-2 text-[10px] text-white/40 font-mono mt-0.5">
                <span>${labelCost} ${formatNumber(dish.totalCost, costDecimals)} FLOWER</span>
                <span>•</span>
                <span>${formatNumber(dish.calcXp, 0)} XP${isLowXp ? ` <span class="inline-block text-[11px] leading-none select-none cursor-help" title="${labelLowXp}">😐</span>` : ''}</span>
              </div>
            </div>
            ${isSelected ? '<span class="text-xs text-emerald-400 ml-1">✓</span>' : ''}
          </button>
        `;
      });
    }

    listContainer.innerHTML = html;
