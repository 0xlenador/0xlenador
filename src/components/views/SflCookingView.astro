  <script is:inline>
    // Función global inmediata para expandir al 100% sin importar qué script se cargue después:
    window.expandBoosts = function() {
      var wrap = document.getElementById("boosts-peek-wrapper");
      var ov = document.getElementById("boosts-fade-overlay");
      if (wrap) {
        wrap.classList.remove("is-peek");
        wrap.style.maxHeight = "none";
        wrap.style.overflow = "visible";
      }
      if (ov) {
        ov.style.display = "none";
        ov.remove();
      }
      try {
        localStorage.setItem("sfl_boosts_expanded", "true");
      } catch (e) {}
    };

    // Inicialización inmediata para evitar parpadeos:
    (function() {
      var isExpanded = typeof localStorage !== "undefined" && localStorage.getItem("sfl_boosts_expanded") === "true";
      var wrap = document.getElementById("boosts-peek-wrapper");
      var ov = document.getElementById("boosts-fade-overlay");
      if (isExpanded) {
        if (wrap) {
          wrap.classList.remove("is-peek");
          wrap.style.maxHeight = "none";
          wrap.style.overflow = "visible";
        }
        if (ov) {
          ov.style.display = "none";
          ov.remove();
        }
      } else {
        if (wrap) wrap.classList.add("is-peek");
      }
    })();
  </script>

