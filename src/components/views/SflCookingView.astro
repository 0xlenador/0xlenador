    </div>

    <!-- Configuración Centralizada de Boosts y Buffs -->
    <SflBoostsConfig domain="cooking" idPrefix="cooking-boosts" />

    <!-- Controles y Filtros (Sticky Header) -->
    <div class="sticky top-0 z-40 bg-[#06080A]/95 backdrop-blur-md py-4 border-b border-white/5 mb-8 -mx-4 px-4 sm:mx-0 sm:px-0 sm:bg-transparent sm:border-0 sm:static sm:py-0">
      <div class="flex flex-col gap-3 relative z-10">
        <div class="p-2 sm:p-2.5 bg-[#101010]/90 border border-white/10 rounded-2xl shadow-xl shadow-black/50 backdrop-blur-xl flex flex-col xl:flex-row justify-between items-start xl:items-center gap-3">
          <!-- Pestañas de categorías -->
          <div class="flex gap-1.5 overflow-x-auto w-full xl:w-auto pb-1 xl:pb-0 no-scrollbar snap-x items-center">
            <button class="category-btn active snap-start px-3.5 py-1.5 bg-emerald-500/20 text-emerald-400 border border-emerald-500/30 rounded-xl text-xs font-mono font-bold uppercase tracking-wider hover:bg-emerald-500/30 transition-colors whitespace-nowrap shrink-0 shadow-sm shadow-emerald-950/40" data-category="all">{t("sfl.cooking.filter.all")}</button>
            <button class="category-btn snap-start px-3.5 py-1.5 bg-white/5 text-white/50 border border-white/10 rounded-xl text-xs font-mono font-medium uppercase tracking-wider hover:bg-white/10 hover:text-white transition-colors whitespace-nowrap shrink-0" data-category="Fire Pit">Fire Pit</button>
            <button class="category-btn snap-start px-3.5 py-1.5 bg-white/5 text-white/50 border border-white/10 rounded-xl text-xs font-mono font-medium uppercase tracking-wider hover:bg-white/10 hover:text-white transition-colors whitespace-nowrap shrink-0" data-category="Kitchen">Kitchen</button>
            <button class="category-btn snap-start px-3.5 py-1.5 bg-white/5 text-white/50 border border-white/10 rounded-xl text-xs font-mono font-medium uppercase tracking-wider hover:bg-white/10 hover:text-white transition-colors whitespace-nowrap shrink-0" data-category="Deli">Deli</button>
            <button class="category-btn snap-start px-3.5 py-1.5 bg-white/5 text-white/50 border border-white/10 rounded-xl text-xs font-mono font-medium uppercase tracking-wider hover:bg-white/10 hover:text-white transition-colors whitespace-nowrap shrink-0" data-category="Smoothie Shack">Smoothie Shack</button>
            <button class="category-btn snap-start px-3.5 py-1.5 bg-white/5 text-white/50 border border-white/10 rounded-xl text-xs font-mono font-medium uppercase tracking-wider hover:bg-white/10 hover:text-white transition-colors whitespace-nowrap shrink-0" data-category="Bakery">Bakery</button>
            <button class="category-btn snap-start px-3.5 py-1.5 bg-white/5 text-white/50 border border-white/10 rounded-xl text-xs font-mono font-medium uppercase tracking-wider hover:bg-white/10 hover:text-white transition-colors whitespace-nowrap shrink-0" data-category="Aging Shed">Aging Shed</button>
            <button class="category-btn snap-start px-3.5 py-1.5 bg-white/5 text-white/50 border border-white/10 rounded-xl text-xs font-mono font-medium uppercase tracking-wider hover:bg-white/10 hover:text-white transition-colors whitespace-nowrap shrink-0" data-category="Fish">Fish</button>
          </div>

          <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-2.5 w-full xl:w-auto">
            <!-- Hidden XP Filter -->
            <div class="flex items-center gap-1.5 bg-black/40 border border-white/5 p-1 rounded-xl overflow-x-auto w-full sm:w-auto pb-1 sm:pb-1 no-scrollbar shrink-0">
              <span class="text-[10px] font-mono font-bold text-white/40 uppercase tracking-wider whitespace-nowrap px-1.5 select-none">{t("sfl.cooking.table.hideXp")}</span>
              <button class="hide-xp-btn active px-2.5 py-1 bg-emerald-500/20 text-emerald-400 border border-emerald-500/40 rounded-lg text-xs font-mono font-bold whitespace-nowrap shrink-0 shadow-sm shadow-emerald-950/40" data-xp="1000">&lt;1k</button>
              <button class="hide-xp-btn px-2.5 py-1 bg-white/5 text-white/50 border border-white/10 rounded-lg text-xs font-mono font-bold hover:bg-white/10 hover:text-white transition-all whitespace-nowrap shrink-0" data-xp="5000">&lt;5k</button>
              <button class="hide-xp-btn px-2.5 py-1 bg-white/5 text-white/50 border border-white/10 rounded-lg text-xs font-mono font-bold hover:bg-white/10 hover:text-white transition-all whitespace-nowrap shrink-0" data-xp="10000">&lt;10k</button>
              <div class="relative flex items-center shrink-0">
                <input type="number" id="custom-hide-xp" min="0" step="500" placeholder="Custom" class="w-18 px-2 py-1 bg-white/5 text-white/80 border border-white/10 rounded-lg text-xs font-mono text-center focus:outline-none focus:border-emerald-500/50 focus:bg-emerald-500/5 placeholder-white/30 transition-all" />
              </div>
            </div>

            <!-- Search Input -->
            <div class="relative w-full sm:w-56 lg:w-60 shrink-0">
              <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-3.5 h-3.5 text-white/30 pointer-events-none" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
              </svg>
              <input
                type="text"
                id="searchInput"
                placeholder={t("sfl.cooking.search.placeholder")}
                class="w-full bg-black/40 border border-white/10 rounded-xl pl-8 pr-3 py-1.5 text-xs text-white placeholder-white/30 focus:outline-none focus:border-emerald-500/50 focus:ring-1 focus:ring-emerald-500/30 transition-all font-mono"
              />
            </div>
          </div>
        </div>

        <!-- Ordenamiento Móvil Estilo App -->
        <div class="relative w-[calc(100%)] lg:hidden scroll-hint-wrapper overflow-hidden pt-1">
          <div class="w-full overflow-x-auto no-scrollbar scroll-area flex items-center justify-start">
            <div class="flex items-center gap-1.5 w-max pr-6">
              <span class="text-[10px] font-mono text-white/30 uppercase tracking-widest mr-1 shrink-0">{t("sfl.cooking.table.sortBy")}</span>
              <button class="mobile-sort-btn px-3 py-1.5 bg-black/40 border border-white/10 rounded-lg text-[10px] font-semibold text-white/60 hover:text-white hover:bg-white/10 transition-all whitespace-nowrap flex items-center gap-1.5" data-col="name" onclick="window.handleSort('name')">{t("sfl.cooking.table.colName")}<span class="sort-icon opacity-0" data-col="name">↕</span></button>
              <button class="mobile-sort-btn px-3 py-1.5 bg-black/40 border border-white/10 rounded-lg text-[10px] font-semibold text-white/60 hover:text-white hover:bg-white/10 transition-all whitespace-nowrap flex items-center gap-1.5" data-col="xp" onclick="window.handleSort('xp')">{t("sfl.cooking.table.colXp")}<span class="sort-icon opacity-0" data-col="xp">↕</span></button>
              <button class="mobile-sort-btn px-3 py-1.5 bg-black/40 border border-white/10 rounded-lg text-[10px] font-semibold text-white/60 hover:text-white hover:bg-white/10 transition-all whitespace-nowrap flex items-center gap-1.5" data-col="cost" onclick="window.handleSort('cost')">{t("sfl.cooking.table.colCost")}<span class="sort-icon opacity-0" data-col="cost">↕</span></button>
              <button class="mobile-sort-btn px-3 py-1.5 bg-emerald-500/10 border border-emerald-500/30 rounded-lg text-[10px] font-semibold text-emerald-400 hover:bg-emerald-500/20 transition-all whitespace-nowrap flex items-center gap-1.5" data-col="xpsfl" onclick="window.handleSort('xpsfl')">{t("sfl.cooking.table.colXpFlower")}<span class="sort-icon opacity-100 text-emerald-500" data-col="xpsfl">↓</span></button>
              <button class="mobile-sort-btn px-3 py-1.5 bg-black/40 border border-white/10 rounded-lg text-[10px] font-semibold text-white/60 hover:text-white hover:bg-white/10 transition-all whitespace-nowrap flex items-center gap-1.5" data-col="xpday" onclick="window.handleSort('xpday')">{t("sfl.cooking.table.colXpDay")}<span class="sort-icon opacity-0" data-col="xpday">↕</span></button>
            </div>
          </div>
          <div class="scroll-hint absolute right-0 top-1 bottom-0 w-12 bg-gradient-to-l from-[#06080A]/95 to-transparent pointer-events-none flex justify-end items-center transition-opacity duration-300 pr-1 opacity-0">
            <svg class="w-4 h-4 text-emerald-500/70 animate-pulse" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
          </div>
        </div>
      </div>
    </div>

    <!-- Estado de Carga -->
    <div
      id="loadingState"
      class="py-12 flex flex-col items-center justify-center gap-4 relative z-10"
