                  title={t("sfl.cooking.dash.clickToEditRod")}
                  placeholder="..."
                />
                <button
                  type="button"
                  id="resetRodBtn"
                  class="hidden text-[10px] font-mono text-white/40 hover:text-white px-1 py-0.5 rounded bg-white/5 hover:bg-white/10 transition-colors cursor-pointer"
                  title={t("sfl.cooking.dash.resetAuto")}
                >↺</button>
              </div>
            </div>
          </div>

          <!-- 3. Fish Flake (Clic para editar costo) -->
          <div class="flex items-center gap-3 sm:justify-center pt-2 sm:pt-0 sm:pl-3" title="8 Rods">
            <div class="w-8 h-8 rounded-full bg-black/80 border border-white/10 flex items-center justify-center p-1.5 shrink-0">
              <img src="/img/sunflowerland/fish/specials/fish_flake.webp" class="w-full h-full object-contain" alt="Fish Flake" />
            </div>
            <div class="flex flex-col">
              <span class="text-[11px] font-mono text-white/60 leading-none mb-1">{t("sfl.cooking.dash.fishFlakeName")}</span>
              <div class="flex items-center gap-1">
                <img src="/img/sunflowerland/flower.jpg" class="w-3.5 h-3.5 rounded-full object-cover shrink-0" alt="FLOWER" />
                <input
                  type="text"
                  inputmode="decimal"
                  id="quickFishFlakeInput"
                  class="w-16 sm:w-20 bg-transparent text-xs sm:text-sm font-mono font-bold text-emerald-400 leading-none outline-none border-b border-dashed border-white/20 hover:border-emerald-400/60 focus:border-emerald-400 transition-colors p-0 cursor-text select-all"
                  title={t("sfl.cooking.dash.clickToEditFlake")}
