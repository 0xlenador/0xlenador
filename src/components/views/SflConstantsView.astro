                    data-multiplier="1"
                  >
                    x1
                  </button>
                  <button
                    type="button"
                    id="jafarCraftMidBtn"
                    class="jafar-craft-multiplier-btn py-1 px-2 rounded-lg text-[11px] font-mono font-bold bg-black/40 text-white/50 border border-white/5 transition-all cursor-pointer hover:bg-white/10 hover:text-white"
                    data-multiplier="10"
