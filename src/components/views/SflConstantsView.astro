        >
          <svg
            class="w-5 h-5 text-emerald-400/80"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="1.5"
              d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"
            ></path>
          </svg>
        </div>
        <p class="text-terminal-muted text-xs font-mono max-w-lg">
          {t("sfl.constants.dashboard.placeholder")}
        </p>
      </div>
    </div>
  </div>

  <!-- 2. Segundo Dashboard (5 Columnas de 20% cada una en Desktop) -->
  <div class="w-full mb-6 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-3 items-stretch">
    <!-- COLUMNA 1 (20%): Divisas Base (Coin, Gemas, FLOWER) -->
