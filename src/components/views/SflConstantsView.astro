    >
      <!-- Cabecera -->
      <div class="flex items-center justify-between">
        <span class="text-[10px] font-bold text-white tracking-wider flex items-center gap-1.5 shrink-0">
          <Icon name="lucide:coins" class="w-3.5 h-3.5 text-amber-400 shrink-0" />
