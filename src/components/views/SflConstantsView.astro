<!-- 1. Motor Centralizado de Mercado y Constantes (compilado por Vite con ES Modules) -->
<script>
  import * as SflMarket from "../../lib/sfl/market"
  import * as SflConstants from "../../lib/sfl/constants"
  import * as SflPrices from "../../lib/sfl/prices"
  ;(window as any).SflMarket = SflMarket
  ;(window as any).SflConstants = SflConstants
  ;(window as any).SflPrices = SflPrices
  // Iniciar la descarga del mercado P2P
  SflMarket.fetchMarketData()
</script>

<!-- Script interactivo de cliente -->
<script is:inline define:vars={{ bettyPrices, sflIds, oilDrillItem, jafarSellItems, mudMixOptions, fishMarketData, tPermanent: t("sfl.constants.detail.permanent"), tUnlimited: t("sfl.constants.detail.unlimited"), tFree: t("sfl.constants.detail.free"), tLevelPrefix: t("sfl.constants.bounties.levelPrefix") }}>
  ;(function () {
    let liveFlowerPrice = 0.144
    let effectiveFlowerPrice = 0.144
    let effectiveGemUsd = 0.0103
    let activeCoinsPerFlower = 320 // Paridad inicial fallback
    let marketDataCache = null
    let calculatedOilPriceFlower = 0
    let calculatedMudPriceFlower = 0
    let calculatedMushroomPriceFlower = 0
    let calculatedMagicMushroomPriceFlower = 0

    // Elementos compartidos del Dashboard superior
    const liveFlowerDisplay = document.getElementById("liveFlowerPriceDisplay")
    const liveBettyRatioDisplay = document.getElementById("liveBettyRatioDisplay")
    const liveOilPriceDisplay = document.getElementById("liveOilPriceDisplay")

    // Elementos de Recursos de Cueva (Dashboard Columna 2)
    const caveMudPriceDisplay = document.getElementById("caveMudPriceDisplay")
    const caveMudUsdDisplay = document.getElementById("caveMudUsdDisplay")
    const caveMushroomPriceDisplay = document.getElementById("caveMushroomPriceDisplay")
    const caveMushroomUsdDisplay = document.getElementById("caveMushroomUsdDisplay")
    const caveMagicMushroomPriceDisplay = document.getElementById("caveMagicMushroomPriceDisplay")
    const caveMagicMushroomUsdDisplay = document.getElementById("caveMagicMushroomUsdDisplay")

    // Helper para obtener el precio en FLOWER de un material base (usa el motor SflMarket)
    function getBaseMaterialUnitPrice(materialName) {
      if (window.SflMarket && typeof window.SflMarket.getItemPrice === "function") {
        const p = window.SflMarket.getItemPrice(materialName)
        if (p > 0) return p
      }
      const rawState = window.__sflMarketState || (window.SflMarket ? window.SflMarket.getState() : null)
      if (rawState && rawState.raw && rawState.raw.items && sflIds) {
        const itemId = Object.keys(sflIds).find((k) => sflIds[k] === materialName)
        if (itemId) {
          const item = rawState.raw.items[`collectibles-${itemId}`]
          if (item && item.currentPrice) return parseFloat(item.currentPrice)
        }
      }
      return 0
    }

    // Calcula el costo de 1 unidad de Oil dividiendo el costo total de 1 Oil Drill entre 16.67
    function calculateOilUnitPrice() {
      if (window.SflConstants && typeof window.SflConstants.calculateOilUnitPrice === "function") {
        return window.SflConstants.calculateOilUnitPrice(activeCoinsPerFlower, 16.67, getBaseMaterialUnitPrice)
      }
      if (!oilDrillItem) return 0
      const coins = oilDrillItem.coins || 0
      const coinsFlower = activeCoinsPerFlower > 0 ? coins / activeCoinsPerFlower : 0

      let ingredientsFlower = 0
      if (oilDrillItem.ingredients && oilDrillItem.ingredients.length > 0) {
        oilDrillItem.ingredients.forEach((ing) => {
          const unitPrice = getBaseMaterialUnitPrice(ing.name)
          ingredientsFlower += unitPrice * ing.amount
        })
      }

      const totalDrillCost = coinsFlower + ingredientsFlower
      return totalDrillCost > 0 ? totalDrillCost / 16.67 : 0
    }

    // Helper para obtener el precio en FLOWER de un tesoro según su valor en Coins y la tasa Betty
    function getTreasureUnitPrice(materialName) {
      // 1. Intentar obtener el valor dinámico desde los slots activos en el DOM
      const sellSlots = document.querySelectorAll(".jafar-sell-slot")
      for (const slot of sellSlots) {
        try {
          const item = JSON.parse(slot.dataset.toolData)
          if (item && item.name && item.name.toLowerCase() === materialName.toLowerCase()) {
            const coins = parseFloat(item.coins) || 0
            if (coins > 0 && activeCoinsPerFlower > 0) {
              return coins / activeCoinsPerFlower
            }
          }
        } catch (e) {}
      }

      // 2. Fallback al listado importado jafarSellItems
      if (jafarSellItems && Array.isArray(jafarSellItems)) {
        const treasure = jafarSellItems.find(
          (t) => t.name.toLowerCase() === materialName.toLowerCase()
        )
        if (treasure && treasure.coins > 0 && activeCoinsPerFlower > 0) {
          return treasure.coins / activeCoinsPerFlower
        }
      }

      return 0
    }

    // Helper general para resolver cualquier material (Oil calculado, Mud, Hongos de cueva, Gemas, Tesoros de Jafar, o recursos base P2P)
    function getMaterialUnitPrice(materialName) {
      if (materialName === "Oil") {
        return calculatedOilPriceFlower
      }
      if (materialName === "Mud") {
        return calculatedMudPriceFlower
      }
      if (materialName === "Wild Mushroom" || materialName === "Mushroom") {
        return calculatedMushroomPriceFlower
      }
      if (materialName === "Magic Mushroom") {
        return calculatedMagicMushroomPriceFlower
      }
      if (materialName === "Refined Salt") {
        const saltPrice = getBaseMaterialUnitPrice("Salt")
        return saltPrice > 0 ? saltPrice * 10 : 0
      }
      if (materialName === "Honey Treat") {
        const refined = getMaterialUnitPrice("Refined Salt")
        return ((5 * refined) + (5 * getBaseMaterialUnitPrice("Honey"))) / 6
      }
      if (materialName === "Truffle Seasoning") {
        const refined = getMaterialUnitPrice("Refined Salt")
        return ((5 * refined) + (10 * getBaseMaterialUnitPrice("Truffle"))) / 6
      }
      if (materialName === "Salt Lick") {
        const refined = getMaterialUnitPrice("Refined Salt")
        return (5 * refined) / 6
      }
      if (materialName === "Gem" || materialName === "Gems") {
        return effectiveFlowerPrice > 0 ? effectiveGemUsd / effectiveFlowerPrice : 0
      }
      const treasurePrice = getTreasureUnitPrice(materialName)
      if (treasurePrice > 0) {
        return treasurePrice
      }
      if (window.SflPrices && typeof window.SflPrices.getUnitCost === "function") {
        const resolved = window.SflPrices.getUnitCost(materialName)
        if (resolved && resolved.flower > 0) {
          return resolved.flower
        }
      }
      return getBaseMaterialUnitPrice(materialName)
    }

    // Calcula el costo unitario óptimo de Mud, Wild Mushroom y Magic Mushroom desde la economía de Cueva
    function calculateCaveOptimalPrices() {
      let optimalGlobalResidualCost = 0.005

      if (window.SflConstants && typeof window.SflConstants.calculateCaveBatchCost === "function") {
        const batch = window.SflConstants.calculateCaveBatchCost({
          coinsPerFlower: activeCoinsPerFlower,
          flowerPriceUsd: effectiveFlowerPrice,
          resolveBasePrice: (name) => getBaseMaterialUnitPrice(name),
        })
        optimalGlobalResidualCost = batch.unitCostFlower
      } else {
        // Fallback local preventivo
        const coinsShovel = activeCoinsPerFlower > 0 ? 20 / activeCoinsPerFlower : 0
        const woodP = getBaseMaterialUnitPrice("Wood")
        const stoneP = getBaseMaterialUnitPrice("Stone")
        const shovelUnitCost = coinsShovel + (2 * woodP) + (1 * stoneP)
        const shovels25Cost = 25 * shovelUnitCost

        const greenP = getBaseMaterialUnitPrice("Green Beetle") || 0.05
        const blueP = getBaseMaterialUnitPrice("Blue Beetle") || 0.1
        const pinkP = getBaseMaterialUnitPrice("Pink Beetle") || 0.25
        const amberP = getBaseMaterialUnitPrice("Amber Beetle") || 0.5
        const expectedBeetleUnitVal = (0.4 * greenP) + (0.3 * blueP) + (0.2 * pinkP) + (0.1 * amberP)
        const expectedBeetlesRev = 2 * expectedBeetleUnitVal

        let lowestCropReqCost = Infinity
        if (mudMixOptions && Array.isArray(mudMixOptions)) {
          mudMixOptions.forEach((opt) => {
            let unitP = getBaseMaterialUnitPrice(opt.name)
            if (!unitP || unitP <= 0) {
              const betty = (typeof bettyPrices !== "undefined" && bettyPrices) ? bettyPrices[opt.name] : null
              const sellPrice = betty ? betty.sellPrice : 0.02
              unitP = activeCoinsPerFlower > 0 ? (sellPrice / activeCoinsPerFlower) : 0.005
            }
            const totalCost = unitP * opt.amount
            if (totalCost < lowestCropReqCost) {
              lowestCropReqCost = totalCost
            }
          })
        }
        if (lowestCropReqCost === Infinity || lowestCropReqCost <= 0) {
          lowestCropReqCost = 0.005
        }

        const mudBatchTotalCost = shovels25Cost + lowestCropReqCost
        const mudNetDeficit = Math.max(0, mudBatchTotalCost - expectedBeetlesRev)
        optimalGlobalResidualCost = mudNetDeficit > 0 ? (mudNetDeficit / 43) : 0.005
      }

      calculatedMudPriceFlower = optimalGlobalResidualCost
      calculatedMushroomPriceFlower = optimalGlobalResidualCost
      calculatedMagicMushroomPriceFlower = optimalGlobalResidualCost

      // Actualizar visual del segundo bloque del dashboard
      if (caveMudPriceDisplay) {
        caveMudPriceDisplay.innerText = calculatedMudPriceFlower > 0 ? calculatedMudPriceFlower.toFixed(4) : "--"
      }
      if (caveMudUsdDisplay) {
        const usd = calculatedMudPriceFlower * effectiveFlowerPrice
        caveMudUsdDisplay.innerText = `($${usd < 0.01 ? usd.toFixed(4) : usd.toFixed(2)})`
      }

      if (caveMushroomPriceDisplay) {
        caveMushroomPriceDisplay.innerText = calculatedMushroomPriceFlower > 0 ? calculatedMushroomPriceFlower.toFixed(4) : "--"
      }
      if (caveMushroomUsdDisplay) {
        const usd = calculatedMushroomPriceFlower * effectiveFlowerPrice
        caveMushroomUsdDisplay.innerText = `($${usd < 0.01 ? usd.toFixed(4) : usd.toFixed(2)})`
      }

      if (caveMagicMushroomPriceDisplay) {
        caveMagicMushroomPriceDisplay.innerText = calculatedMagicMushroomPriceFlower > 0 ? calculatedMagicMushroomPriceFlower.toFixed(4) : "--"
      }
      if (caveMagicMushroomUsdDisplay) {
        const usd = calculatedMagicMushroomPriceFlower * effectiveFlowerPrice
        caveMagicMushroomUsdDisplay.innerText = `($${usd < 0.01 ? usd.toFixed(4) : usd.toFixed(2)})`
      }
    }

    // Actualiza el indicador visual de 1 Oil en el Dashboard superior
    function updateOilPriceDisplay() {
      calculatedOilPriceFlower = calculateOilUnitPrice()
      if (liveOilPriceDisplay) {
        if (calculatedOilPriceFlower > 0) {
          liveOilPriceDisplay.innerText = `${calculatedOilPriceFlower.toFixed(4)} FLOWER`
