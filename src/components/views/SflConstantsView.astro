---
import SflToolLayout from "../SflToolLayout.astro"
import blacksmithData from "../../content/data/sfl/blacksmith_tools.json"
import bettyPrices from "../../content/data/sfl/betty_prices.json"
import sflIds from "../../content/data/sfl/resources.json"
import { getLangFromUrl, useTranslations, getLocalizedPath } from "../../i18n/utils"

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)
const loc = (path: string) => getLocalizedPath(path, lang)
const bettyUrl = loc("/sfl-betty")

const blacksmith = blacksmithData.buildings.blacksmith
const toolsTab = blacksmith.tabs.find((tab) => tab.id === "tools")
const categories = toolsTab ? toolsTab.categories : []
const firstTool = categories[0]?.items[0]
---

<SflToolLayout activeTab="constantes">
  <!-- Encabezado Principal -->
  <div class="mb-5 relative z-10 text-center sm:text-left">
    <h1 class="text-3xl md:text-4xl font-black text-white tracking-tighter mb-2">
      {t("sfl.constants.heading")}
      <span class="text-emerald-500"> {t("sfl.constants.heading.accent")}</span>
    </h1>
    <p class="text-terminal-secondary text-sm leading-relaxed max-w-3xl">
      {t("sfl.constants.intro")}
    </p>
  </div>

  <!-- 1. Bloque Superior: Dashboard Placeholder (Ancho Completo) -->
  <div
    class="w-full mb-6 bg-[#18181b]/90 border border-white/10 rounded-2xl p-4 sm:p-5 shadow-lg backdrop-blur-md relative overflow-hidden"
  >
    <!-- Fondo decorativo sutil -->
    <div
      class="absolute -right-20 -top-20 w-72 h-72 bg-emerald-500/10 rounded-full blur-3xl pointer-events-none"
    >
    </div>
    <div
      class="absolute -left-20 -bottom-20 w-72 h-72 bg-amber-500/10 rounded-full blur-3xl pointer-events-none"
    >
    </div>

    <div class="relative z-10 flex flex-col gap-2.5">
      <div class="flex flex-wrap items-center justify-between gap-2.5">
        <div class="flex items-center gap-2">
          <span class="relative flex h-2 w-2">
            <span
              class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"
            ></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
          </span>
          <h2 class="text-sm sm:text-base font-mono font-bold tracking-tight text-white">
            {t("sfl.constants.dashboard.title")}
          </h2>
        </div>

        <!-- Indicador de precio de FLOWER & Tasa Betty en vivo -->
        <div class="flex items-center gap-2 flex-wrap">
          <div
            class="flex items-center gap-2 px-2.5 py-1 rounded-full bg-black/50 border border-white/10 text-xs font-mono shadow-sm"
          >
            <!-- Token oficial de FLOWER -->
            <img
              src="/img/sunflowerland/flower.jpg"
              class="w-3.5 h-3.5 rounded-full object-cover"
              alt="FLOWER"
            />
            <span class="text-terminal-muted">FLOWER:</span>
            <span id="liveFlowerPriceDisplay" class="text-emerald-400 font-bold">$0.14 USD</span>
            <span class="text-white/20">•</span>
            <span class="text-terminal-muted">Paridad:</span>
            <span id="liveBettyRatioDisplay" class="text-amber-400 font-bold">1:320 Coins</span>

            <!-- Tooltip Popup idéntico al estándar de 0xLeñador -->
            <div class="relative inline-flex items-center group/tooltip ml-0.5">
              <button
                type="button"
                class="text-terminal-muted hover:text-white transition-colors focus:outline-none cursor-pointer p-0.5 flex items-center justify-center"
                aria-label={t("sfl.constants.tooltip.title")}
              >
                <svg
                  class="w-[11px] h-[11px]"
                  xmlns="http://www.w3.org/2000/svg"
                  width="24"
                  height="24"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <circle cx="12" cy="12" r="10"></circle>
                  <path d="M12 16v-4"></path>
                  <path d="M12 8h.01"></path>
                </svg>
              </button>
              <div
                class="absolute right-0 sm:left-1/2 sm:-translate-x-1/2 top-full mt-2 w-64 p-3 bg-[#0c1015] border border-white/10 rounded-lg shadow-2xl text-[9.5px] text-white/70 font-sans text-left leading-relaxed opacity-0 invisible group-hover/tooltip:opacity-100 group-hover/tooltip:visible group-focus-within/tooltip:opacity-100 group-focus-within/tooltip:visible transition-all z-[80] pointer-events-auto"
              >
                <span class="block text-white font-bold mb-1 text-[11px]">
                  {t("sfl.constants.tooltip.title")}
                </span>
                <div set:html={t("sfl.constants.tooltip.desc")} />
                <a
                  href={bettyUrl}
                  class="text-emerald-400 hover:text-emerald-300 font-bold text-[10px] inline-flex items-center gap-1 transition-colors mt-2 pt-1.5 border-t border-white/5 w-full"
                >
                  {t("sfl.constants.tooltip.link")}
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Área de contenido placeholder para futuro dashboard -->
      <div
        class="border border-dashed border-white/10 rounded-xl p-4 sm:p-5 flex flex-col items-center justify-center text-center bg-black/20 my-1"
      >
        <div
          class="w-10 h-10 rounded-xl bg-white/[0.03] border border-white/10 flex items-center justify-center mb-2"
        >
          <svg
            class="w-5 h-5 text-emerald-400/80"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="1.5"
              d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"
            ></path>
          </svg>
        </div>
        <p class="text-terminal-muted text-xs font-mono max-w-lg">
          {t("sfl.constants.dashboard.placeholder")}
        </p>
      </div>
    </div>
  </div>

  <!-- 2. Bloques por Categorías: Grid 50% en PC -->
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-5 items-start">
    <!-- BLOQUE 1: BLACKSMITH (Ocupa 50% en escritorio) -->
    <div
      class="bg-[#18181b]/95 border border-white/10 rounded-2xl shadow-xl backdrop-blur-md overflow-hidden flex flex-col"
    >
      <!-- Cabecera del Edificio con Icono y Tabs -->
      <div class="p-3.5 sm:p-4 border-b border-white/10 bg-black/20">
        <div class="flex items-center justify-between mb-3">
          <div class="flex items-center gap-2.5">
            <div
              class="w-10 h-10 sm:w-11 sm:h-11 rounded-xl bg-amber-500/10 border border-amber-500/30 flex items-center justify-center shrink-0 relative"
            >
              <img
                src={blacksmith.icon}
                alt={blacksmith.name}
                class="w-full h-full object-contain pointer-events-none [image-rendering:pixelated]"
                style="transform: scale(1.75) translateY(10%); clip-path: inset(0 0 40% 0);"
              />
            </div>
            <div>
              <h3 class="text-base sm:text-lg font-bold text-white tracking-tight flex items-center gap-2">
                {t("sfl.constants.building.blacksmith")}
                <span
                  class="text-[10px] font-mono px-2 py-0.5 rounded-full bg-emerald-500/10 text-emerald-400 border border-emerald-500/30 font-normal"
                >
                  13 items
                </span>
              </h3>
              <p class="text-xs text-terminal-muted">
                {t("sfl.constants.building.blacksmith.desc")}
              </p>
            </div>
          </div>
        </div>

        <!-- 3 Pestañas del Edificio (Tools, Boosts, Build) -->
        <div class="flex items-center gap-1.5 bg-black/40 p-1 rounded-xl border border-white/5">
          <button
            type="button"
            class="blacksmith-tab-btn flex-1 py-1 px-2.5 rounded-lg text-xs font-mono font-bold transition-all cursor-pointer flex items-center justify-center gap-1.5 bg-white/10 text-amber-400 border border-amber-500/30 shadow-sm"
            data-target="tab-tools"
          >
            <span>⛏️</span>
            <span>{t("sfl.constants.tab.tools")}</span>
          </button>
          <button
            type="button"
            class="blacksmith-tab-btn flex-1 py-1 px-2.5 rounded-lg text-xs font-mono font-bold transition-all cursor-pointer flex items-center justify-center gap-1.5 text-white/50 hover:text-white/80 hover:bg-white/[0.04] border border-transparent"
            data-target="tab-boosts"
          >
            <span>⚡</span>
            <span>{t("sfl.constants.tab.boosts")}</span>
          </button>
          <button
            type="button"
            class="blacksmith-tab-btn flex-1 py-1 px-2.5 rounded-lg text-xs font-mono font-bold transition-all cursor-pointer flex items-center justify-center gap-1.5 text-white/50 hover:text-white/80 hover:bg-white/[0.04] border border-transparent"
            data-target="tab-build"
          >
            <span>🔨</span>
            <span>{t("sfl.constants.tab.build")}</span>
          </button>
        </div>
      </div>

      <!-- PESTAÑA: TOOLS (Activa) -->
      <div id="tab-tools" class="blacksmith-tab-panel p-3.5 sm:p-4">
        <div class="grid grid-cols-1 md:grid-cols-12 gap-4 items-stretch">
          <!-- Columna Izquierda: Grid de Herramientas por Subcategorías (md:col-span-8 para ranuras más anchas) -->
          <div class="md:col-span-8 flex flex-col gap-3">
            {
              categories.map((cat) => (
                <div class="flex flex-col gap-1.5">
                  <div class="flex items-center gap-1.5">
                    <span class="text-[10px] font-mono font-bold tracking-wider uppercase text-terminal-muted px-1.5 py-0.5 rounded bg-white/[0.03] border border-white/5">
                      {cat.name}
                    </span>
                  </div>

                  <!-- Grid de Slots idéntica a la UI del juego, más compacta y con ranuras más anchas -->
                  <div class="grid grid-cols-6 sm:grid-cols-6 gap-1.5">
                    {cat.items.map((tool) => (
                      <button
                        type="button"
                        class="tool-slot relative w-full rounded-xl bg-black/60 border-2 border-white/10 hover:border-white/30 hover:bg-white/[0.04] transition-all cursor-pointer flex flex-col items-center justify-between p-1 pt-0.5 pb-1 group select-none min-h-[62px] sm:min-h-[66px]"
                        data-tool-id={tool.id}
                        data-tool-data={JSON.stringify(tool)}
                        title={tool.name}
                      >
                        <!-- Esquinas de selección estilo juego (ocultas por defecto) -->
                        <div class="slot-corner-bracket absolute inset-0 rounded-xl pointer-events-none hidden">
                          <span class="absolute -top-0.5 -left-0.5 w-1.5 h-1.5 border-t-2 border-l-2 border-amber-400" />
                          <span class="absolute -top-0.5 -right-0.5 w-1.5 h-1.5 border-t-2 border-r-2 border-amber-400" />
                          <span class="absolute -bottom-0.5 -left-0.5 w-1.5 h-1.5 border-b-2 border-l-2 border-amber-400" />
                          <span class="absolute -bottom-0.5 -right-0.5 w-1.5 h-1.5 border-b-2 border-r-2 border-amber-400" />
                        </div>

                        <!-- Sprite del ítem -->
                        <img
                          src={tool.image}
                          alt={tool.name}
                          class="w-6 h-6 object-contain drop-shadow-[0_2px_4px_rgba(0,0,0,0.8)] [image-rendering:pixelated] group-hover:scale-105 transition-transform my-1"
                          loading="lazy"
                        />

                        <!-- Costo en FLOWER por 1 unidad abajo (con icono de FLOWER a la izquierda) -->
                        <div class="w-full flex items-center justify-center gap-0.5 leading-none px-0.5 overflow-hidden">
                          <img
                            src="/img/sunflowerland/flower.jpg"
                            class="w-2.5 h-2.5 rounded-full object-cover shrink-0"
                            alt="FLOWER"
                          />
                          <span
                            class="tool-unit-flower text-[8px] sm:text-[8.5px] font-mono font-bold text-emerald-400/90 leading-none tracking-tighter"
                            data-coins={tool.coins}
                          >
                            {tool.coins === 0 ? "0" : `${(tool.coins / 320).toFixed(4)}`}
                          </span>
                        </div>
                      </button>
                    ))}
                  </div>
                </div>
              ))
            }
          </div>

          <!-- Columna Derecha: Panel de Detalle & Conversión (md:col-span-4 más compacto) -->
          <div
            class="md:col-span-4 bg-black/40 border border-white/10 rounded-xl p-3 flex flex-col justify-between min-h-[380px]"
          >
            <!-- Estado inicial vacío: cuando no hay herramienta seleccionada -->
            <div
              id="detailPlaceholder"
              class="flex flex-col items-center justify-center text-center p-6 my-auto"
            >
              <div
                class="w-12 h-12 rounded-xl bg-white/[0.03] border border-white/10 flex items-center justify-center mb-3 text-2xl"
              >
                ⛏️
              </div>
              <h4 class="text-sm font-bold text-white mb-1">
                {t("sfl.constants.selectTool.title")}
              </h4>
              <p class="text-xs text-terminal-muted max-w-[220px]">
                {t("sfl.constants.selectTool.desc")}
              </p>
            </div>

            <!-- Contenido de Detalle (visible al seleccionar una herramienta) -->
            <div id="detailContent" class="hidden flex flex-col justify-between h-full">
              <div>
                <!-- Nombre del Ítem -->
                <div class="mb-2">
                  <h4 id="detailTitle" class="text-base sm:text-lg font-bold text-white tracking-tight truncate">
                    --
                  </h4>
                </div>

                <!-- Sprite grande centrado -->
                <div class="my-2.5 flex items-center justify-center p-2.5 rounded-xl bg-white/[0.02]">
                  <img
                    id="detailImg"
                    src=""
                    alt=""
                    class="w-12 h-12 object-contain drop-shadow-[0_6px_12px_rgba(0,0,0,0.6)] [image-rendering:pixelated]"
                  />
                </div>

                <!-- Descripción -->
                <p id="detailDesc" class="text-xs text-terminal-secondary leading-relaxed mb-2.5">
                  --
                </p>

                <!-- Separador -->
                <div class="border-t border-white/10 my-2.5"></div>

                <!-- Sección: Materiales Requeridos (Directo en el lienzo, uno debajo del otro) -->
                <div class="mb-3">
                  <span
                    class="text-[10px] font-mono uppercase tracking-wider text-terminal-muted block mb-1"
                  >
                    {t("sfl.constants.detail.ingredients")}
                  </span>
                  <div id="detailIngredients" class="flex flex-col gap-0.5">
                    <!-- Inyectado dinámicamente: Monedas + Cada Material en plano -->
                  </div>
                </div>

                <!-- Costo Total Fusionado -->
                <div
                  class="flex items-center justify-between py-2 px-3 rounded-xl bg-emerald-500/[0.06] border border-emerald-500/20 mt-2"
                >
                  <span class="text-xs font-mono text-terminal-secondary font-medium">
                    {t("sfl.constants.detail.totalCost")}:
                  </span>
                  <div class="flex flex-col items-end leading-tight">
                    <div class="flex items-center gap-1.5">
                      <img
                        src="/img/sunflowerland/flower.jpg"
                        class="w-3.5 h-3.5 rounded-full object-cover shrink-0"
                        alt="FLOWER"
                      />
                      <span id="detailFlower" class="text-sm font-mono font-bold text-emerald-400">
                        0.0000
                      </span>
                    </div>
                    <span id="detailUsd" class="text-[10.5px] font-mono text-white/50 pt-0.5">
                      ~$0.0000
                    </span>
                  </div>
                </div>
              </div>

              <!-- Simulador de Crafteo -->
              <div id="craftSimulatorSection" class="mt-3 pt-2.5 border-t border-white/10 flex flex-col gap-1.5">
                <div class="flex items-center justify-between">
                  <span class="text-[10px] font-mono text-terminal-muted">Simulador de Fabricación</span>

                  <!-- Popup de Límite de Stock (Click/Tap nativo para móvil y desktop) -->
                  <div class="relative">
                    <button
                      id="stockPopupTrigger"
                      type="button"
                      class="text-terminal-muted hover:text-white transition-colors focus:outline-none cursor-pointer p-0.5 rounded-md flex items-center justify-center"
                      aria-label={t("sfl.constants.stockTooltip.title")}
                    >
                      <!-- Icono estándar 0xLeñador de información/alerta ⓘ -->
                      <svg
                        class="w-3.5 h-3.5"
                        xmlns="http://www.w3.org/2000/svg"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2.5"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      >
                        <circle cx="12" cy="12" r="10"></circle>
                        <path d="M12 16v-4"></path>
                        <path d="M12 8h.01"></path>
                      </svg>
                    </button>

                    <!-- Popup Flotante (se despliega hacia arriba sobre el simulador) -->
                    <div
                      id="stockPopupModal"
                      class="hidden absolute right-0 bottom-full mb-2 w-64 p-3 bg-[#0c1015] border border-white/10 rounded-xl shadow-2xl z-[90] text-left"
                    >
                      <div class="flex items-center justify-between pb-1.5 mb-2 border-b border-white/10">
                        <span class="text-white font-bold text-xs flex items-center gap-1.5">
                          <svg
                            class="w-3.5 h-3.5 text-cyan-400"
                            xmlns="http://www.w3.org/2000/svg"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2.5"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                          >
                            <circle cx="12" cy="12" r="10"></circle>
                            <path d="M12 16v-4"></path>
                            <path d="M12 8h.01"></path>
                          </svg>
                          <span>{t("sfl.constants.stockTooltip.title")}</span>
                        </span>
                        <button
                          id="stockPopupCloseBtn"
                          type="button"
                          class="text-white/40 hover:text-white text-xs cursor-pointer p-0.5 leading-none transition-colors"
                          aria-label="Cerrar"
                        >
                          ✕
                        </button>
                      </div>

                      <div class="flex items-center justify-between text-[11px] font-mono mb-2 px-2 py-1 rounded bg-white/[0.03] border border-white/5">
                        <span class="text-terminal-muted">{t("sfl.constants.stockTooltip.available")}:</span>
                        <span id="stockPopupQty" class="text-cyan-400 font-bold">--</span>
                      </div>

                      <p class="text-[10px] text-white/70 font-sans leading-relaxed">
                        {t("sfl.constants.stockTooltip.desc")}
                      </p>
                    </div>
                  </div>
                </div>

                <!-- Botones del Simulador (actualizados dinámicamente según el stock máximo) -->
                <div class="grid grid-cols-3 gap-1.5" id="craftMultiplierGrid">
                  <button
                    type="button"
                    id="craftBtn1"
                    class="craft-multiplier-btn active py-1 px-2 rounded-lg text-[11px] font-mono font-bold bg-white/10 text-white border border-white/20 transition-all cursor-pointer hover:bg-white/20"
                    data-multiplier="1"
                  >
                    x1
                  </button>
                  <button
                    type="button"
                    id="craftMidBtn"
                    class="craft-multiplier-btn py-1 px-2 rounded-lg text-[11px] font-mono font-bold bg-black/40 text-white/50 border border-white/5 transition-all cursor-pointer hover:bg-white/10 hover:text-white"
                    data-multiplier="10"
                  >
                    x10
                  </button>
                  <button
                    type="button"
                    id="craftMaxBtn"
                    class="craft-multiplier-btn py-1 px-2 rounded-lg text-[11px] font-mono font-bold bg-black/40 text-white/50 border border-white/5 transition-all cursor-pointer hover:bg-white/10 hover:text-white"
                    data-multiplier="max"
                  >
                    Max
                  </button>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- PESTAÑA: BOOSTS (Vacía por ahora) -->
      <div id="tab-boosts" class="blacksmith-tab-panel p-8 hidden text-center">
        <div class="flex flex-col items-center justify-center py-6">
          <div
            class="w-12 h-12 rounded-xl bg-amber-500/10 border border-amber-500/30 flex items-center justify-center mb-3 text-2xl"
          >
            ⚡
          </div>
          <h4 class="text-base font-bold text-white mb-1">
            {t("sfl.constants.comingSoon.title")}
          </h4>
          <p class="text-xs text-terminal-muted max-w-sm">
            {t("sfl.constants.comingSoon.desc").replace("{tab}", "Boosts")}
          </p>
        </div>
      </div>

      <!-- PESTAÑA: BUILD (Vacía por ahora) -->
      <div id="tab-build" class="blacksmith-tab-panel p-8 hidden text-center">
        <div class="flex flex-col items-center justify-center py-6">
          <div
            class="w-12 h-12 rounded-xl bg-blue-500/10 border border-blue-500/30 flex items-center justify-center mb-3 text-2xl"
          >
            🔨
          </div>
          <h4 class="text-base font-bold text-white mb-1">
            {t("sfl.constants.comingSoon.title")}
          </h4>
          <p class="text-xs text-terminal-muted max-w-sm">
            {t("sfl.constants.comingSoon.desc").replace("{tab}", "Build")}
          </p>
        </div>
      </div>
    </div>

    <!-- BLOQUE 2 (Columna Derecha Libre para el siguiente edificio) -->
    <div
      class="border border-dashed border-white/10 rounded-2xl p-8 flex flex-col items-center justify-center text-center bg-black/10 min-h-[400px]"
    >
      <div
        class="w-12 h-12 rounded-xl bg-white/[0.02] border border-white/5 flex items-center justify-center mb-3 text-xl text-white/30"
      >
        +
      </div>
      <h4 class="text-sm font-mono font-bold text-white/60 mb-1">Próximo Bloque de Constantes</h4>
      <p class="text-xs text-terminal-muted max-w-xs font-mono">
        Espacio reservado para las siguientes categorías del juego (Barn, Kitchen, Hen House, etc.).
      </p>
    </div>
  </div>
</SflToolLayout>

<!-- Script interactivo de cliente -->
<script is:inline define:vars={{ bettyPrices, sflIds, tPermanent: t("sfl.constants.detail.permanent"), tFree: t("sfl.constants.detail.free") }}>
  ;(function () {
    let currentMultiplier = 1
    let selectedTool = null
    let liveFlowerPrice = 0.144
    let activeCoinsPerFlower = 320 // Paridad inicial fallback
    let marketDataCache = null

    // Elementos del DOM
    const liveFlowerDisplay = document.getElementById("liveFlowerPriceDisplay")
    const liveBettyRatioDisplay = document.getElementById("liveBettyRatioDisplay")
    const detailPlaceholder = document.getElementById("detailPlaceholder")
    const detailContent = document.getElementById("detailContent")
    const detailTitle = document.getElementById("detailTitle")
    const detailDesc = document.getElementById("detailDesc")
    const detailImg = document.getElementById("detailImg")
    const stockPopupTrigger = document.getElementById("stockPopupTrigger")
    const stockPopupModal = document.getElementById("stockPopupModal")
    const stockPopupCloseBtn = document.getElementById("stockPopupCloseBtn")
    const stockPopupQty = document.getElementById("stockPopupQty")
    const detailFlower = document.getElementById("detailFlower")
    const detailUsd = document.getElementById("detailUsd")
    const detailIngredients = document.getElementById("detailIngredients")
    const craftSimulatorSection = document.getElementById("craftSimulatorSection")
    const craftBtn1 = document.getElementById("craftBtn1")
    const craftMidBtn = document.getElementById("craftMidBtn")
    const craftMaxBtn = document.getElementById("craftMaxBtn")
    const slots = document.querySelectorAll(".tool-slot")

    // Manejo del Popup de Stock (click/tap para móvil y PC)
    if (stockPopupTrigger && stockPopupModal) {
      stockPopupTrigger.addEventListener("click", (e) => {
        e.stopPropagation()
        stockPopupModal.classList.toggle("hidden")
      })

      if (stockPopupCloseBtn) {
        stockPopupCloseBtn.addEventListener("click", (e) => {
          e.stopPropagation()
          stockPopupModal.classList.add("hidden")
        })
      }

      stockPopupModal.addEventListener("click", (e) => {
        e.stopPropagation()
      })

      document.addEventListener("click", () => {
        stockPopupModal.classList.add("hidden")
      })
    }

    // Actualiza los badges de FLOWER de 1 unidad en cada slot de la cuadrícula calculando el TOTAL (Coins + Materiales)
    function updateGridUnitFlowerCosts() {
      slots.forEach((slot) => {
        const badge = slot.querySelector(".tool-unit-flower")
        if (!badge) return
        try {
          const tool = JSON.parse(slot.dataset.toolData)
          const coins = tool.coins || 0
          const coinsFlower = activeCoinsPerFlower > 0 ? coins / activeCoinsPerFlower : 0

          let materialsFlower = 0
          if (tool.ingredients && tool.ingredients.length > 0) {
            tool.ingredients.forEach((ing) => {
              const unitPrice = getMaterialUnitPrice(ing.name)
              materialsFlower += unitPrice * ing.amount
            })
          }

          const grandTotalFlower = coinsFlower + materialsFlower

          if (coins === 0 && materialsFlower === 0) {
            badge.innerText = "0"
          } else {
            if (grandTotalFlower < 0.1) {
              badge.innerText = `${grandTotalFlower.toFixed(4)}`
            } else if (grandTotalFlower < 10) {
              badge.innerText = `${grandTotalFlower.toFixed(3)}`
            } else {
              badge.innerText = `${grandTotalFlower.toFixed(2)}`
            }
          }
        } catch (e) {}
      })
    }

    // Helper para obtener el precio en FLOWER de un material desde sfl_data.json
    function getMaterialUnitPrice(materialName) {
      if (!marketDataCache || !marketDataCache.items || !sflIds) return 0
      const itemId = Object.keys(sflIds).find((k) => sflIds[k] === materialName)
      if (!itemId) return 0
      const item = marketDataCache.items[`collectibles-${itemId}`]
      return item && item.currentPrice ? parseFloat(item.currentPrice) : 0
    }

    // Función para actualizar vista de detalle
    function updateDetailView() {
      if (!selectedTool) return

      const stock = selectedTool.stock || 1

      // Si la herramienta es permanente, se oculta el simulador (solo se puede craftear 1 unidad)
      if (craftSimulatorSection) {
        if (selectedTool.isPermanent) {
          craftSimulatorSection.classList.add("hidden")
          currentMultiplier = 1
        } else {
          craftSimulatorSection.classList.remove("hidden")

          // Lógica dinámica de multiplicadores según el stock disponible de cada herramienta
          let step2 = 10
          if (stock <= 5) {
            step2 = Math.ceil(stock / 2) // ej: 5 -> 3
          } else if (stock <= 10) {
            step2 = Math.floor(stock / 2) // ej: 10 -> 5
          } else {
            step2 = 10
          }

          if (craftBtn1) {
            craftBtn1.innerText = "x1"
            craftBtn1.dataset.multiplier = "1"
          }
          if (craftMidBtn) {
            craftMidBtn.innerText = `x${step2}`
            craftMidBtn.dataset.multiplier = step2.toString()
          }
          if (craftMaxBtn) {
            craftMaxBtn.innerText = `x${stock}`
            craftMaxBtn.dataset.multiplier = "max"
          }

          // Ajustar currentMultiplier si supera el stock de la herramienta seleccionada
          if (currentMultiplier !== "max" && currentMultiplier > stock) {
            currentMultiplier = "max"
          }

          // Actualizar clases activas visuales de los botones
          const multiplierBtns = document.querySelectorAll(".craft-multiplier-btn")
          multiplierBtns.forEach((b) => {
            const m = b.dataset.multiplier
            const isActive = (m === "max" && currentMultiplier === "max") ||
                             (m !== "max" && parseInt(m, 10) === currentMultiplier)
            if (isActive) {
              b.classList.add("bg-white/10", "border-white/20", "text-white")
              b.classList.remove("bg-black/40", "border-white/5", "text-white/50")
            } else {
              b.classList.remove("bg-white/10", "border-white/20", "text-white")
              b.classList.add("bg-black/40", "border-white/5", "text-white/50")
            }
          })
        }
      }

      const qty = selectedTool.isPermanent
        ? 1
        : (currentMultiplier === "max" ? stock : Math.min(currentMultiplier, stock))
      const totalCoins = selectedTool.coins * qty

      // Conversión de monedas usando la paridad de arbitraje de Betty
      const coinsFlower = activeCoinsPerFlower > 0 ? totalCoins / activeCoinsPerFlower : 0

      if (detailTitle) detailTitle.innerText = selectedTool.name
      if (detailDesc) detailDesc.innerText = selectedTool.description
      if (detailImg) {
        detailImg.src = selectedTool.image
        detailImg.alt = selectedTool.name
      }

      // Actualizar dato dentro del popup de stock
      if (stockPopupQty) {
        if (selectedTool.isPermanent) {
          stockPopupQty.innerText = `${tPermanent} (1x)`
          stockPopupQty.className = "text-amber-400 font-bold"
        } else {
          stockPopupQty.innerText = `${selectedTool.stock} uds`
          stockPopupQty.className = "text-cyan-400 font-bold"
        }
      }

      // Renderizar MATERIALES REQUERIDOS:
      // Monedas (como primer ingrediente) + Materiales adicionales con icono FLOWER a la izquierda
      let materialsTotalFlower = 0
      let ingredientsHtml = ""

      // 1. Monedas (directo en el lienzo)
      const coinsFormatted = selectedTool.coins === 0
        ? `0 Coins (${tFree})`
        : `${totalCoins.toLocaleString()} Coins ${qty > 1 ? `(${qty}x)` : ""}`
      const coinsFlwFormatted = selectedTool.coins === 0
        ? "0"
        : `${coinsFlower.toFixed(4)}`

      ingredientsHtml += `
        <div class="flex items-center justify-between py-1 px-1 text-xs font-mono">
          <div class="flex items-center gap-2">
            <img src="/img/sunflowerland/123/coins.png" class="w-4 h-4 object-contain" alt="Coins" />
            <span class="${selectedTool.coins === 0 ? 'text-terminal-muted' : 'text-amber-400'} font-bold">${coinsFormatted}</span>
          </div>
          <div class="flex items-center gap-1.5 text-emerald-400 font-bold text-[11px]">
            <img src="/img/sunflowerland/flower.jpg" class="w-3 h-3 rounded-full object-cover shrink-0" alt="FLOWER" />
            <span>${coinsFlwFormatted}</span>
          </div>
        </div>
      `

      // 2. Materiales adicionales (directo en el lienzo)
      if (selectedTool.ingredients && selectedTool.ingredients.length > 0) {
        selectedTool.ingredients.forEach((ing) => {
          const reqQty = ing.amount * qty
          const unitPrice = getMaterialUnitPrice(ing.name)
          const ingTotalFlower = unitPrice * reqQty
          materialsTotalFlower += ingTotalFlower

          const ingFlwFormatted = unitPrice > 0
            ? `${ingTotalFlower.toFixed(4)}`
            : `<span class="text-white/40">...</span>`

          ingredientsHtml += `
            <div class="flex items-center justify-between py-1 px-1 text-xs font-mono">
              <div class="flex items-center gap-2">
                <img src="${ing.image}" class="w-4 h-4 object-contain" alt="${ing.name}" />
                <span class="text-white font-bold">${reqQty.toLocaleString()}</span>
                <span class="text-terminal-secondary">${ing.name}</span>
              </div>
              <div class="flex items-center gap-1.5 text-emerald-400 font-bold text-[11px]">
                <img src="/img/sunflowerland/flower.jpg" class="w-3 h-3 rounded-full object-cover shrink-0" alt="FLOWER" />
                <span>${ingFlwFormatted}</span>
              </div>
            </div>
          `
        })
      }

      if (detailIngredients) {
        detailIngredients.innerHTML = ingredientsHtml
      }

      // Costo Total = Monedas en FLOWER + Materiales en FLOWER
      const grandTotalFlower = coinsFlower + materialsTotalFlower
      const grandTotalUsd = grandTotalFlower * liveFlowerPrice

      if (detailFlower) {
        if (selectedTool.coins === 0 && materialsTotalFlower === 0) {
          detailFlower.innerText = "0"
        } else {
          detailFlower.innerText = grandTotalFlower.toFixed(4)
        }
      }
      if (detailUsd) {
        if (selectedTool.coins === 0 && materialsTotalFlower === 0) {
          detailUsd.innerText = "~$0.00"
        } else {
          detailUsd.innerText = `~$${grandTotalUsd.toFixed(4)}`
        }
      }
    }

    // Actualiza la tasa y los textos
    function applyBettyRatio(ratio) {
      if (!ratio || ratio <= 0) return
      activeCoinsPerFlower = ratio
      const rounded = Math.round(ratio)
      if (liveBettyRatioDisplay) {
        liveBettyRatioDisplay.innerText = `1:${rounded} Coins (Betty)`
      }
      updateGridUnitFlowerCosts()
      updateDetailView()
    }

    // Escuchar el evento que emite SflTabs cuando calcula la mejor tasa de Betty
    window.addEventListener("sfl:bettyBestUpdated", (e) => {
      if (e.detail) {
        applyBettyRatio(e.detail)
      }
    })

    // Si SflTabs ya lo calculó previamente en window.__bestCoinsPerFlower
    if (window.__bestCoinsPerFlower) {
      applyBettyRatio(window.__bestCoinsPerFlower)
    }

    // Manejar selección de slots de herramientas
    slots.forEach((slot) => {
      slot.addEventListener("click", () => {
        // Deseleccionar todas las ranuras (remover borde amarillo y ocultar esquinas)
        slots.forEach((s) => {
          s.classList.remove(
            "border-amber-400",
            "bg-amber-400/10",
            "shadow-[0_0_15px_rgba(251,191,36,0.2)]",
          )
          s.classList.add("border-white/10")
          const bracket = s.querySelector(".slot-corner-bracket")
          if (bracket) bracket.classList.add("hidden")
        })

        // Activar la ranura clickeada
        slot.classList.add(
          "border-amber-400",
          "bg-amber-400/10",
          "shadow-[0_0_15px_rgba(251,191,36,0.2)]",
        )
        slot.classList.remove("border-white/10")
        const activeBracket = slot.querySelector(".slot-corner-bracket")
        if (activeBracket) activeBracket.classList.remove("hidden")

        try {
          selectedTool = JSON.parse(slot.dataset.toolData)
          currentMultiplier = 1
          if (detailPlaceholder) detailPlaceholder.classList.add("hidden")
          if (detailContent) detailContent.classList.remove("hidden")
          if (stockPopupModal) stockPopupModal.classList.add("hidden")
          updateDetailView()
        } catch (e) {}
      })
    })

    // Manejar botones de multiplicador de crafteo
    const multiplierBtns = document.querySelectorAll(".craft-multiplier-btn")
    multiplierBtns.forEach((btn) => {
      btn.addEventListener("click", () => {
        multiplierBtns.forEach((b) => {
          b.classList.remove("bg-white/10", "border-white/20", "text-white")
          b.classList.add("bg-black/40", "border-white/5", "text-white/50")
        })
        btn.classList.add("bg-white/10", "border-white/20", "text-white")
        btn.classList.remove("bg-black/40", "border-white/5", "text-white/50")

        const multVal = btn.dataset.multiplier
        currentMultiplier = multVal === "max" ? "max" : parseInt(multVal, 10) || 1
        updateDetailView()
      })
    })

    // Manejar pestañas del Blacksmith (Tools, Boosts, Build)
    const tabBtns = document.querySelectorAll(".blacksmith-tab-btn")
    const tabPanels = document.querySelectorAll(".blacksmith-tab-panel")

    tabBtns.forEach((btn) => {
      btn.addEventListener("click", () => {
        const targetId = btn.dataset.target

        tabBtns.forEach((b) => {
          b.classList.remove("bg-white/10", "text-amber-400", "border-amber-500/30", "shadow-sm")
          b.classList.add("text-white/50", "border-transparent")
        })
        btn.classList.add("bg-white/10", "text-amber-400", "border-amber-500/30", "shadow-sm")
        btn.classList.remove("text-white/50", "border-transparent")

        tabPanels.forEach((p) => {
          if (p.id === targetId) {
            p.classList.remove("hidden")
          } else {
            p.classList.add("hidden")
          }
        })
      })
    })

    // Consultar datos de API para obtener flowerPrice, precios de materiales y calcular tasa Betty
    async function fetchLiveMarketData() {
      try {
        const res = await fetch("/api/sfl_data.json?t=" + Date.now())
        if (res.ok) {
          const data = await res.json()
          marketDataCache = data

          if (data && data.flowerPrice) {
            liveFlowerPrice = parseFloat(data.flowerPrice)
            if (liveFlowerDisplay) {
              liveFlowerDisplay.innerText = `$${liveFlowerPrice.toFixed(4)} USD`
            }
          }

          // Si window.__bestCoinsPerFlower aún no se cargó desde SflTabs, calcularlo aquí
          if (!window.__bestCoinsPerFlower && data && data.items && bettyPrices && sflIds) {
            let bestRatio = 0
            Object.keys(bettyPrices).forEach((name) => {
              const itemConfig = bettyPrices[name]
              const itemId = Object.keys(sflIds).find((key) => sflIds[key] === name)
              const internalKey = `collectibles-${itemId}`
              const marketItem = data.items[internalKey]

              const bettyPriceCoins = itemConfig.sellPrice
              const p2pPriceFlower = marketItem ? marketItem.currentPrice : 0
              if (p2pPriceFlower > 0) {
                const ratio = bettyPriceCoins / p2pPriceFlower
                if (ratio > bestRatio) {
                  bestRatio = ratio
                }
              }
            })

            if (bestRatio > 0) {
              applyBettyRatio(bestRatio)
            }
          }
        }
      } catch (err) {
        console.error("Error al obtener datos de mercado SFL:", err)
      }
      updateDetailView()
      updateGridUnitFlowerCosts()
    }

    updateGridUnitFlowerCosts()
    fetchLiveMarketData()
  })()
</script>
