              src="/img/sunflowerland/123/Oil.png"
              class="w-3.5 h-3.5 object-contain"
              alt="Oil"
              width="14"
              height="14"
            />
            <span class="text-terminal-muted">1 Oil:</span>
            <span id="liveOilPriceDisplay" class="text-amber-400 font-bold">~0.1257 FLOWER</span>

            <!-- Tooltip Popup para Oil -->
