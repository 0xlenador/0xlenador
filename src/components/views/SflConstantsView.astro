<!-- 1. Motor Centralizado de Mercado (compilado por Vite con ES Modules) -->
<script>
  import * as SflMarket from "../../lib/sfl/market"
  ;(window as any).SflMarket = SflMarket
  // Iniciar la descarga del mercado P2P
  SflMarket.fetchMarketData()
</script>

<!-- Script interactivo de cliente -->
<script is:inline define:vars={{ bettyPrices, sflIds, oilDrillItem, jafarSellItems, tPermanent: t("sfl.constants.detail.permanent"), tUnlimited: t("sfl.constants.detail.unlimited"), tFree: t("sfl.constants.detail.free") }}>
  ;(function () {
    let liveFlowerPrice = 0.144
    let effectiveFlowerPrice = 0.144
    let effectiveGemUsd = 0.0103
    let activeCoinsPerFlower = 320 // Paridad inicial fallback
    let marketDataCache = null
    let calculatedOilPriceFlower = 0

    // Elementos compartidos del Dashboard superior
    const liveFlowerDisplay = document.getElementById("liveFlowerPriceDisplay")
    const liveBettyRatioDisplay = document.getElementById("liveBettyRatioDisplay")
    const liveOilPriceDisplay = document.getElementById("liveOilPriceDisplay")

    // Helper para obtener el precio en FLOWER de un material base (usa el motor SflMarket)
    function getBaseMaterialUnitPrice(materialName) {
      if (window.SflMarket && typeof window.SflMarket.getItemPrice === "function") {
        const p = window.SflMarket.getItemPrice(materialName)
        if (p > 0) return p
      }
      const rawState = window.__sflMarketState || (window.SflMarket ? window.SflMarket.getState() : null)
      if (rawState && rawState.raw && rawState.raw.items && sflIds) {
        const itemId = Object.keys(sflIds).find((k) => sflIds[k] === materialName)
        if (itemId) {
          const item = rawState.raw.items[`collectibles-${itemId}`]
          if (item && item.currentPrice) return parseFloat(item.currentPrice)
        }
      }
      return 0
    }

    // Calcula el costo de 1 unidad de Oil dividiendo el costo total de 1 Oil Drill entre 16.67
    function calculateOilUnitPrice() {
      if (!oilDrillItem) return 0
      const coins = oilDrillItem.coins || 0
      const coinsFlower = activeCoinsPerFlower > 0 ? coins / activeCoinsPerFlower : 0

      let ingredientsFlower = 0
      if (oilDrillItem.ingredients && oilDrillItem.ingredients.length > 0) {
        oilDrillItem.ingredients.forEach((ing) => {
          const unitPrice = getBaseMaterialUnitPrice(ing.name)
          ingredientsFlower += unitPrice * ing.amount
        })
      }

      const totalDrillCost = coinsFlower + ingredientsFlower
      return totalDrillCost > 0 ? totalDrillCost / 16.67 : 0
    }

    // Helper para obtener el precio en FLOWER de un tesoro según su valor en Coins y la tasa Betty
    function getTreasureUnitPrice(materialName) {
      // 1. Intentar obtener el valor dinámico desde los slots activos en el DOM
      const sellSlots = document.querySelectorAll(".jafar-sell-slot")
      for (const slot of sellSlots) {
        try {
          const item = JSON.parse(slot.dataset.toolData)
          if (item && item.name && item.name.toLowerCase() === materialName.toLowerCase()) {
            const coins = parseFloat(item.coins) || 0
            if (coins > 0 && activeCoinsPerFlower > 0) {
              return coins / activeCoinsPerFlower
            }
          }
        } catch (e) {}
      }

      // 2. Fallback al listado importado jafarSellItems
      if (jafarSellItems && Array.isArray(jafarSellItems)) {
        const treasure = jafarSellItems.find(
          (t) => t.name.toLowerCase() === materialName.toLowerCase()
        )
        if (treasure && treasure.coins > 0 && activeCoinsPerFlower > 0) {
          return treasure.coins / activeCoinsPerFlower
        }
      }

      return 0
    }

    // Helper general para resolver cualquier material (Oil calculado, Gemas, Tesoros de Jafar, o recursos base P2P)
    function getMaterialUnitPrice(materialName) {
      if (materialName === "Oil") {
        return calculatedOilPriceFlower
      }
      if (materialName === "Gem" || materialName === "Gems") {
        return effectiveFlowerPrice > 0 ? effectiveGemUsd / effectiveFlowerPrice : 0
      }
      const treasurePrice = getTreasureUnitPrice(materialName)
      if (treasurePrice > 0) {
        return treasurePrice
      }
      return getBaseMaterialUnitPrice(materialName)
    }

    // Actualiza el indicador visual de 1 Oil en el Dashboard superior
    function updateOilPriceDisplay() {
      calculatedOilPriceFlower = calculateOilUnitPrice()
      if (liveOilPriceDisplay) {
        if (calculatedOilPriceFlower > 0) {
          liveOilPriceDisplay.innerText = `${calculatedOilPriceFlower.toFixed(4)} FLOWER`
        } else {
          liveOilPriceDisplay.innerText = `-- FLOWER`
        }
      }
    }

    // Actualiza los badges de FLOWER de 1 unidad en cada slot (Coins + Materiales)
    function updateSlotsUnitFlower(slots) {
      slots.forEach((slot) => {
        const badge = slot.querySelector(".tool-unit-flower")
        if (!badge) return
        try {
          const tool = JSON.parse(slot.dataset.toolData)
          const coins = tool.coins || 0
          const coinsFlower = activeCoinsPerFlower > 0 ? coins / activeCoinsPerFlower : 0

          let materialsFlower = 0
          if (tool.ingredients && tool.ingredients.length > 0) {
            tool.ingredients.forEach((ing) => {
              const unitPrice = getMaterialUnitPrice(ing.name)
              materialsFlower += unitPrice * ing.amount
            })
          }

          const grandTotalFlower = coinsFlower + materialsFlower

          if (coins === 0 && materialsFlower === 0) {
            badge.innerText = "0"
          } else {
            if (grandTotalFlower < 100) {
              badge.innerText = `${grandTotalFlower.toFixed(4)}`
            } else {
              badge.innerText = `${grandTotalFlower.toFixed(2)}`
            }
          }
        } catch (e) {}
      })
    }

    // Fábrica reutilizable para controlar cada sección de tienda (Blacksmith, Jafar, etc.)
    function createShopController(config) {
      let selectedTool = null
      let currentMultiplier = 1

      const placeholder = document.getElementById(config.placeholderId)
      const content = document.getElementById(config.contentId)
      const title = document.getElementById(config.titleId)
      const desc = document.getElementById(config.descId)
      const img = document.getElementById(config.imgId)
      const ingredientsContainer = document.getElementById(config.ingredientsId)
      const flowerTotal = document.getElementById(config.flowerId)
      const usdTotal = document.getElementById(config.usdId)
      const simulatorSection = document.getElementById(config.simulatorSectionId)
      const craftBtn1 = document.getElementById(config.craftBtn1Id)
      const craftMidBtn = document.getElementById(config.craftMidBtnId)
      const craftMaxBtn = document.getElementById(config.craftMaxBtnId)
      const popupTrigger = document.getElementById(config.stockPopupTriggerId)
      const popupModal = document.getElementById(config.stockPopupModalId)
      const popupCloseBtn = document.getElementById(config.stockPopupCloseBtnId)
      const popupQty = document.getElementById(config.stockPopupQtyId)
      const customQtyInput = config.customQtyInputId ? document.getElementById(config.customQtyInputId) : null
      const slots = document.querySelectorAll(config.slotSelector)
      const multiplierBtns = document.querySelectorAll(config.multiplierBtnSelector)
      const tabBtns = document.querySelectorAll(config.tabBtnSelector)
      const tabPanels = document.querySelectorAll(config.tabPanelSelector)

      // Manejo del Popup de Stock (click/tap para móvil y desktop)
      if (popupTrigger && popupModal) {
        popupTrigger.addEventListener("click", (e) => {
          e.stopPropagation()
          popupModal.classList.toggle("hidden")
        })

        if (popupCloseBtn) {
          popupCloseBtn.addEventListener("click", (e) => {
            e.stopPropagation()
            popupModal.classList.add("hidden")
          })
        }

        popupModal.addEventListener("click", (e) => {
          e.stopPropagation()
        })

        document.addEventListener("click", () => {
          popupModal.classList.add("hidden")
        })
      }

      // Manejo de pestañas
      tabBtns.forEach((btn) => {
        btn.addEventListener("click", () => {
          const targetId = btn.dataset.target

          tabBtns.forEach((b) => {
            b.classList.remove("bg-white/10", "text-amber-400", "border-amber-500/30", "shadow-sm")
            b.classList.add("text-white/50", "border-transparent")
          })
          btn.classList.add("bg-white/10", "text-amber-400", "border-amber-500/30", "shadow-sm")
          btn.classList.remove("text-white/50", "border-transparent")

          tabPanels.forEach((p) => {
            if (p.id === targetId) {
              p.classList.remove("hidden")
            } else {
              p.classList.add("hidden")
            }
          })
        })
      })

      // Actualizar vista de detalle
      function updateDetail() {
        if (!selectedTool) return

        const isUnlimited = !selectedTool.isPermanent && (selectedTool.stock === undefined || selectedTool.stock === null || selectedTool.stock <= 0)
        const stock = isUnlimited ? null : (selectedTool.stock || 1)
        const isSingleOnly = selectedTool.isPermanent || (!isUnlimited && stock <= 1)

        if (simulatorSection) {
          if (isSingleOnly) {
            simulatorSection.classList.add("hidden")
            currentMultiplier = 1
          } else {
            simulatorSection.classList.remove("hidden")

            if (isUnlimited) {
              if (craftBtn1) {
                craftBtn1.innerText = "x1"
                craftBtn1.dataset.multiplier = "1"
              }
              if (craftMidBtn) {
                craftMidBtn.innerText = "x10"
                craftMidBtn.dataset.multiplier = "10"
              }
              if (craftMaxBtn) {
                craftMaxBtn.innerText = "x50"
                craftMaxBtn.dataset.multiplier = "50"
              }
            } else {
              let step2 = 10
              if (stock <= 5) {
                step2 = Math.ceil(stock / 2)
              } else if (stock <= 10) {
                step2 = Math.floor(stock / 2)
              } else {
                step2 = 10
              }

              if (craftBtn1) {
                craftBtn1.innerText = "x1"
                craftBtn1.dataset.multiplier = "1"
              }
              if (craftMidBtn) {
                craftMidBtn.innerText = `x${step2}`
                craftMidBtn.dataset.multiplier = step2.toString()
              }
              if (craftMaxBtn) {
                craftMaxBtn.innerText = `x${stock}`
                craftMaxBtn.dataset.multiplier = "max"
              }

              if (currentMultiplier !== "max" && currentMultiplier > stock) {
                currentMultiplier = "max"
              }
            }

            multiplierBtns.forEach((b) => {
              const m = b.dataset.multiplier
              const isActive = (!isUnlimited && m === "max" && currentMultiplier === "max") ||
                               (parseInt(m, 10) === currentMultiplier)
              if (isActive) {
                b.classList.add("bg-white/10", "border-white/20", "text-white")
                b.classList.remove("bg-black/40", "border-white/5", "text-white/50")
              } else {
                b.classList.remove("bg-white/10", "border-white/20", "text-white")
                b.classList.add("bg-black/40", "border-white/5", "text-white/50")
              }
            })

            if (customQtyInput) {
              if (!isUnlimited && currentMultiplier === "max") {
                customQtyInput.value = stock
              } else if (typeof currentMultiplier === "number" && currentMultiplier > 0) {
                customQtyInput.value = currentMultiplier
              }
            }
          }
        }

        let qty = 1
        if (isSingleOnly) {
          qty = 1
        } else if (isUnlimited) {
          qty = typeof currentMultiplier === "number" && currentMultiplier > 0
            ? currentMultiplier
            : (parseInt(currentMultiplier, 10) || 1)
        } else {
          qty = currentMultiplier === "max" ? stock : Math.min(parseInt(currentMultiplier, 10) || 1, stock)
        }
        const totalCoins = selectedTool.coins * qty
        const coinsFlower = activeCoinsPerFlower > 0 ? totalCoins / activeCoinsPerFlower : 0

        if (title) title.innerText = selectedTool.name
        if (desc) desc.innerText = selectedTool.description
        if (img) {
          img.src = selectedTool.image
          img.alt = selectedTool.name
        }

        if (popupQty) {
          if (selectedTool.isPermanent) {
            popupQty.innerText = `${tPermanent} (1x)`
            popupQty.className = "text-amber-400 font-bold"
          } else if (isUnlimited) {
            popupQty.innerText = tUnlimited
            popupQty.className = "text-emerald-400 font-bold"
          } else {
            popupQty.innerText = `${selectedTool.stock} uds`
            popupQty.className = "text-cyan-400 font-bold"
          }
        }

        // Renderizado de materiales requeridos directamente en el lienzo
        let materialsTotalFlower = 0
        let ingredientsHtml = ""

        // Monedas (si el ítem tiene monedas o no tiene ingredientes adicionales)
        if (selectedTool.coins > 0 || !selectedTool.ingredients || selectedTool.ingredients.length === 0) {
          const coinsFormatted = selectedTool.coins === 0
            ? `0 Coins (${tFree})`
            : `${totalCoins.toLocaleString()} Coins ${qty > 1 ? `(${qty}x)` : ""}`
          const coinsFlwFormatted = selectedTool.coins === 0
            ? "0"
            : `${coinsFlower.toFixed(4)}`

          ingredientsHtml += `
            <div class="flex items-center justify-between py-1 px-1 text-xs font-mono">
              <div class="flex items-center gap-2">
                <img src="/img/sunflowerland/123/coins.png" class="w-4 h-4 object-contain" alt="Coins" />
                <span class="${selectedTool.coins === 0 ? 'text-terminal-muted' : 'text-amber-400'} font-bold">${coinsFormatted}</span>
              </div>
              <div class="flex items-center gap-1.5 text-emerald-400 font-bold text-[11px]">
                <img src="/img/sunflowerland/flower.jpg" class="w-3 h-3 rounded-full object-cover shrink-0" alt="FLOWER" />
                <span>${coinsFlwFormatted}</span>
              </div>
            </div>
          `
        }

        // Materiales adicionales
        if (selectedTool.ingredients && selectedTool.ingredients.length > 0) {
          selectedTool.ingredients.forEach((ing) => {
            const reqQty = ing.amount * qty
            const unitPrice = getMaterialUnitPrice(ing.name)
            const ingTotalFlower = unitPrice * reqQty
            materialsTotalFlower += ingTotalFlower

            const ingFlwFormatted = unitPrice > 0
              ? `${ingTotalFlower.toFixed(4)}`
              : `<span class="text-white/40">--</span>`

            ingredientsHtml += `
              <div class="flex items-center justify-between py-1 px-1 text-xs font-mono">
                <div class="flex items-center gap-2">
                  <img src="${ing.image}" class="w-4 h-4 object-contain" alt="${ing.name}" />
                  <span class="text-white font-bold">${reqQty.toLocaleString()}</span>
                  <span class="text-terminal-secondary">${ing.name}</span>
                </div>
                <div class="flex items-center gap-1.5 text-emerald-400 font-bold text-[11px]">
                  <img src="/img/sunflowerland/flower.jpg" class="w-3 h-3 rounded-full object-cover shrink-0" alt="FLOWER" />
                  <span>${ingFlwFormatted}</span>
                </div>
              </div>
            `
          })
        }

        if (ingredientsContainer) {
          ingredientsContainer.innerHTML = ingredientsHtml
        }

        const grandTotalFlower = coinsFlower + materialsTotalFlower
        const grandTotalUsd = grandTotalFlower * effectiveFlowerPrice

        if (flowerTotal) {
          if (selectedTool.coins === 0 && materialsTotalFlower === 0) {
            flowerTotal.innerText = "0"
          } else {
            flowerTotal.innerText = grandTotalFlower.toFixed(4)
          }
        }
        if (usdTotal) {
          if (selectedTool.coins === 0 && materialsTotalFlower === 0) {
            usdTotal.innerText = "~$0.00"
          } else {
            usdTotal.innerText = `~$${grandTotalUsd.toFixed(4)}`
          }
        }
      }

      // Manejo de clic en slots
      slots.forEach((slot) => {
        slot.addEventListener("click", () => {
          slots.forEach((s) => {
            s.classList.remove(
              "border-amber-400",
              "bg-amber-400/10",
              "shadow-[0_0_15px_rgba(251,191,36,0.2)]",
            )
            s.classList.add("border-white/10")
            const bracket = s.querySelector(".slot-corner-bracket")
            if (bracket) bracket.classList.add("hidden")
          })

          slot.classList.add(
            "border-amber-400",
            "bg-amber-400/10",
            "shadow-[0_0_15px_rgba(251,191,36,0.2)]",
          )
          slot.classList.remove("border-white/10")
          const activeBracket = slot.querySelector(".slot-corner-bracket")
          if (activeBracket) activeBracket.classList.remove("hidden")

          try {
            selectedTool = JSON.parse(slot.dataset.toolData)
            currentMultiplier = 1
            if (customQtyInput) customQtyInput.value = 1
            if (placeholder) placeholder.classList.add("hidden")
            if (content) content.classList.remove("hidden")
            if (popupModal) popupModal.classList.add("hidden")
            updateDetail()
          } catch (e) {}
        })
      })

      // Manejo de botones de multiplicador
      multiplierBtns.forEach((btn) => {
        btn.addEventListener("click", () => {
          multiplierBtns.forEach((b) => {
            b.classList.remove("bg-white/10", "border-white/20", "text-white")
            b.classList.add("bg-black/40", "border-white/5", "text-white/50")
          })
          btn.classList.add("bg-white/10", "border-white/20", "text-white")
          btn.classList.remove("bg-black/40", "border-white/5", "text-white/50")

          const multVal = btn.dataset.multiplier
          currentMultiplier = multVal === "max" ? "max" : parseInt(multVal, 10) || 1
          if (customQtyInput) {
            if (multVal === "max" && selectedTool && selectedTool.stock) {
              customQtyInput.value = selectedTool.stock
            } else {
              customQtyInput.value = currentMultiplier
            }
          }
          updateDetail()
        })
      })

      // Manejo de entrada manual personalizada (Custom Quantity)
      if (customQtyInput) {
        customQtyInput.addEventListener("input", () => {
          let val = parseInt(customQtyInput.value, 10)
          if (isNaN(val) || val < 1) {
            val = 0
          }
          if (selectedTool && selectedTool.stock && !selectedTool.isPermanent && val > selectedTool.stock) {
            val = selectedTool.stock
            customQtyInput.value = val
          }
          currentMultiplier = val

          multiplierBtns.forEach((b) => {
            const m = b.dataset.multiplier
            const isMatch = (m === "max" && selectedTool && selectedTool.stock && val === selectedTool.stock) ||
                            (parseInt(m, 10) === val)
            if (isMatch) {
              b.classList.add("bg-white/10", "border-white/20", "text-white")
              b.classList.remove("bg-black/40", "border-white/5", "text-white/50")
            } else {
              b.classList.remove("bg-white/10", "border-white/20", "text-white")
              b.classList.add("bg-black/40", "border-white/5", "text-white/50")
            }
          })

          updateDetail()
        })

        customQtyInput.addEventListener("blur", () => {
          if (!customQtyInput.value || parseInt(customQtyInput.value, 10) < 1) {
            customQtyInput.value = 1
            currentMultiplier = 1
            multiplierBtns.forEach((b) => {
              if (b.dataset.multiplier === "1") {
                b.classList.add("bg-white/10", "border-white/20", "text-white")
                b.classList.remove("bg-black/40", "border-white/5", "text-white/50")
              } else {
                b.classList.remove("bg-white/10", "border-white/20", "text-white")
                b.classList.add("bg-black/40", "border-white/5", "text-white/50")
              }
            })
            updateDetail()
          }
        })
      }

      return {
        updateDetail,
        updateSlots: () => updateSlotsUnitFlower(slots)
      }
    }

    // Inicializar controladores para cada tienda
    const blacksmithManager = createShopController({
      placeholderId: "detailPlaceholder",
      contentId: "detailContent",
      titleId: "detailTitle",
      descId: "detailDesc",
      imgId: "detailImg",
      ingredientsId: "detailIngredients",
      flowerId: "detailFlower",
      usdId: "detailUsd",
      simulatorSectionId: "craftSimulatorSection",
      craftBtn1Id: "craftBtn1",
      craftMidBtnId: "craftMidBtn",
      craftMaxBtnId: "craftMaxBtn",
      stockPopupTriggerId: "stockPopupTrigger",
      stockPopupModalId: "stockPopupModal",
      stockPopupCloseBtnId: "stockPopupCloseBtn",
      stockPopupQtyId: "stockPopupQty",
      slotSelector: ".tool-slot",
      multiplierBtnSelector: ".craft-multiplier-btn",
      tabBtnSelector: ".blacksmith-tab-btn",
      tabPanelSelector: ".blacksmith-tab-panel"
    })

    const jafarManager = createShopController({
      placeholderId: "jafarDetailPlaceholder",
      contentId: "jafarDetailContent",
      titleId: "jafarDetailTitle",
      descId: "jafarDetailDesc",
      imgId: "jafarDetailImg",
      ingredientsId: "jafarDetailIngredients",
      flowerId: "jafarDetailFlower",
      usdId: "jafarDetailUsd",
      simulatorSectionId: "jafarCraftSimulatorSection",
      craftBtn1Id: "jafarCraftBtn1",
      craftMidBtnId: "jafarCraftMidBtn",
      craftMaxBtnId: "jafarCraftMaxBtn",
      stockPopupTriggerId: "jafarStockPopupTrigger",
      stockPopupModalId: "jafarStockPopupModal",
      stockPopupCloseBtnId: "jafarStockPopupCloseBtn",
      stockPopupQtyId: "jafarStockPopupQty",
      customQtyInputId: "jafarCraftCustomQty",
      slotSelector: ".jafar-tool-slot",
      multiplierBtnSelector: ".jafar-craft-multiplier-btn",
      tabBtnSelector: ".jafar-tab-btn",
      tabPanelSelector: ".jafar-tab-panel"
    })

    // Controlador para la Pestaña de Sell de Jafar (Tesoros acumulables sin límite de stock)
    function createSellController() {
      const placeholder = document.getElementById("jafarSellDetailPlaceholder")
      const content = document.getElementById("jafarSellDetailContent")
      const title = document.getElementById("jafarSellDetailTitle")
      const desc = document.getElementById("jafarSellDetailDescription")
      const img = document.getElementById("jafarSellDetailImage")
      const coinsDisplay = document.getElementById("jafarSellDetailCoins")
      const coinsFlowerDisplay = document.getElementById("jafarSellDetailCoinsFlower")
      const coinsUsdDisplay = document.getElementById("jafarSellDetailCoinsUsd")
      const customQtyInput = document.getElementById("jafarSellCustomQty")
      const multiplierBtns = document.querySelectorAll(".jafar-sell-multiplier-btn")
      const slots = document.querySelectorAll(".jafar-sell-slot")
      const flowerCosts = document.querySelectorAll(".jafar-sell-flower-cost")

      let selectedTreasure = null
      let currentMultiplier = 1

      // Auto-seleccionar el primer tesoro por defecto
      if (slots.length > 0) {
        const firstSlot = slots[0]
        try {
          selectedTreasure = JSON.parse(firstSlot.dataset.toolData)
          firstSlot.classList.add(
            "border-amber-400",
            "bg-amber-400/10",
            "shadow-[0_0_15px_rgba(251,191,36,0.2)]"
          )
          firstSlot.classList.remove("border-white/10")
          const bracket = firstSlot.querySelector(".slot-corner-bracket")
          if (bracket) bracket.classList.remove("hidden")
          if (placeholder) placeholder.classList.add("hidden")
          if (content) content.classList.remove("hidden")
        } catch (e) {}
      }

      function updateSlots() {
        flowerCosts.forEach((span) => {
          const coins = parseFloat(span.dataset.coins) || 0
          if (activeCoinsPerFlower > 0) {
            const flowerValue = coins / activeCoinsPerFlower
            span.innerText = flowerValue.toFixed(4)
          } else {
            span.innerText = "--"
          }
        })
      }

      function updateDetail() {
        if (!selectedTreasure) return

        if (title) title.innerText = selectedTreasure.name || ""
        if (desc) desc.innerText = selectedTreasure.description || ""
        if (img) {
          img.src = selectedTreasure.image || ""
          img.alt = selectedTreasure.name || ""
        }

        const unitCoins = selectedTreasure.coins || 0
        const totalCoins = unitCoins * currentMultiplier
        const totalFlower = activeCoinsPerFlower > 0 ? totalCoins / activeCoinsPerFlower : 0
        const totalUsd = totalFlower * effectiveFlowerPrice

        if (coinsDisplay) {
          coinsDisplay.innerText = `${totalCoins.toLocaleString()} Coins`
        }
        if (coinsFlowerDisplay) {
          coinsFlowerDisplay.innerText = totalFlower.toFixed(4)
        }
        if (coinsUsdDisplay) {
          coinsUsdDisplay.innerText = `~$${totalUsd.toFixed(4)}`
        }
      }

      // Manejo de clic en slots de tesoros
      slots.forEach((slot) => {
        slot.addEventListener("click", () => {
          slots.forEach((s) => {
            s.classList.remove(
              "border-amber-400",
              "bg-amber-400/10",
              "shadow-[0_0_15px_rgba(251,191,36,0.2)]"
            )
            s.classList.add("border-white/10")
            const b = s.querySelector(".slot-corner-bracket")
            if (b) b.classList.add("hidden")
          })

          slot.classList.add(
            "border-amber-400",
            "bg-amber-400/10",
            "shadow-[0_0_15px_rgba(251,191,36,0.2)]"
          )
          slot.classList.remove("border-white/10")
          const activeBracket = slot.querySelector(".slot-corner-bracket")
          if (activeBracket) activeBracket.classList.remove("hidden")

          try {
            selectedTreasure = JSON.parse(slot.dataset.toolData)
            if (placeholder) placeholder.classList.add("hidden")
            if (content) content.classList.remove("hidden")
            updateDetail()
          } catch (e) {}
        })
      })

      // Multiplicadores de venta predefinidos (x1, x10, x100)
      multiplierBtns.forEach((btn) => {
        btn.addEventListener("click", () => {
          multiplierBtns.forEach((b) => {
            b.classList.remove("active", "bg-white/10", "text-white", "border-white/20")
            b.classList.add("bg-black/40", "text-white/50", "border-white/5")
          })
          btn.classList.add("active", "bg-white/10", "text-white", "border-white/20")
          btn.classList.remove("bg-black/40", "text-white/50", "border-white/5")

          const mult = parseInt(btn.dataset.multiplier, 10) || 1
          currentMultiplier = mult
          if (customQtyInput) {
            customQtyInput.value = mult
          }
          updateDetail()
        })
      })

      // Manejo del input de cantidad personalizada
      if (customQtyInput) {
        customQtyInput.addEventListener("input", () => {
          let val = parseInt(customQtyInput.value, 10)
          if (isNaN(val) || val < 1) {
            val = 0
          }
          currentMultiplier = val

          // Sincronizar estado visual de los botones predefinidos
          multiplierBtns.forEach((b) => {
            const m = parseInt(b.dataset.multiplier, 10)
            if (m === val) {
              b.classList.add("active", "bg-white/10", "text-white", "border-white/20")
              b.classList.remove("bg-black/40", "text-white/50", "border-white/5")
            } else {
              b.classList.remove("active", "bg-white/10", "text-white", "border-white/20")
              b.classList.add("bg-black/40", "text-white/50", "border-white/5")
            }
          })

          updateDetail()
        })

        customQtyInput.addEventListener("blur", () => {
          if (!customQtyInput.value || parseInt(customQtyInput.value, 10) < 1) {
            customQtyInput.value = 1
            currentMultiplier = 1
            multiplierBtns.forEach((b) => {
              if (b.dataset.multiplier === "1") {
                b.classList.add("active", "bg-white/10", "text-white", "border-white/20")
                b.classList.remove("bg-black/40", "text-white/50", "border-white/5")
              } else {
                b.classList.remove("active", "bg-white/10", "text-white", "border-white/20")
                b.classList.add("bg-black/40", "text-white/50", "border-white/5")
              }
            })
            updateDetail()
          }
        })
      }

      updateSlots()
      updateDetail()

      return {
        updateSlots,
        updateDetail
      }
    }

    const jafarSellManager = createSellController()

    function updateAll() {
      updateOilPriceDisplay()
      blacksmithManager.updateSlots()
      blacksmithManager.updateDetail()
      if (jafarSellManager) {
        jafarSellManager.updateSlots()
        jafarSellManager.updateDetail()
      }
      jafarManager.updateSlots()
      jafarManager.updateDetail()
    }

    // --- GESTIÓN DE DIVISAS BASE (Coin, Gemas, FLOWER) ---
    // 1. Coins
    let coinsParityMode = "arbitrage" // "arbitrage" | "official"
    let isBettyCustom = false
    let customBettyRatio = null
    let arbitrageCoinsPerFlower = 320
    const officialCoinsPerFlower = 320

    const containerBetty = document.getElementById("coinsBettyContainer")
    const inputBetty = document.getElementById("coinsBettyInput")
    const btnOfficial = document.getElementById("coinsOptionOfficial")
    const arbitrageRatioText = document.getElementById("arbitrageRatioText")

    // 2. Gemas (Fórmula algorítmica de SFL Mercado: tiers fiat con 20% descuento cripto)
    const getGemFiatPrice = (gems) => {
      if (gems < 650) return 1.29 / 100
      if (gems < 1350) return 6.49 / 650
      if (gems < 2800) return 12.99 / 1350
      if (gems < 8000) return 25.99 / 2800
      if (gems < 15500) return 0.0087825 // Hidden tier
      if (gems < 200000) return 129.99 / 15500
      return 1299.99 / 200000
    }

    let gemAmount = 1
    let isGemBonusCustom = false
    let customGemBonus = null
    const gemAmountInput = document.getElementById("gemAmountInput")
    const gemBonusInput = document.getElementById("gemBonusInput")
    const gemBonusContainer = document.getElementById("gemBonusContainer")
    const gemPriceDisplayText = document.getElementById("gemPriceDisplayText")

    // 3. FLOWER
    let flowerAmount = 1
    let isFlowerCustom = false
    let customFlowerPrice = null
    const flowerAmountInput = document.getElementById("flowerAmountInput")
    const flowerPriceDisplayText = document.getElementById("flowerPriceDisplayText")

    function updateCurrencyUI() {
      // 1. Determinar activeCoinsPerFlower
      if (coinsParityMode === "arbitrage") {
        activeCoinsPerFlower = (isBettyCustom && customBettyRatio && customBettyRatio > 0)
          ? customBettyRatio
          : arbitrageCoinsPerFlower
      } else if (coinsParityMode === "official") {
        activeCoinsPerFlower = officialCoinsPerFlower
      }

      // Estilos de botones de Coin
      const activeBtnClass = ["bg-amber-500/15", "text-amber-400", "border-amber-500/30"]
      const inactiveBtnClass = ["text-white/50", "border-white/5", "bg-black/40"]

      if (containerBetty) {
        if (coinsParityMode === "arbitrage") {
          containerBetty.classList.add(...activeBtnClass)
          containerBetty.classList.remove(...inactiveBtnClass)
        } else {
          containerBetty.classList.remove(...activeBtnClass)
          containerBetty.classList.add(...inactiveBtnClass)
        }
      }

      if (inputBetty) {
        if (coinsParityMode === "arbitrage") {
          inputBetty.classList.add("text-amber-400")
          inputBetty.classList.remove("text-white/50")
        } else {
          inputBetty.classList.remove("text-amber-400")
          inputBetty.classList.add("text-white/50")
        }
        inputBetty.placeholder = Math.round(arbitrageCoinsPerFlower).toString()
        if (!isBettyCustom) {
          inputBetty.value = Math.round(arbitrageCoinsPerFlower).toString()
        }
      }

      if (btnOfficial) {
        if (coinsParityMode === "official") {
          btnOfficial.classList.add(...activeBtnClass)
          btnOfficial.classList.remove(...inactiveBtnClass)
        } else {
          btnOfficial.classList.remove(...activeBtnClass)
          btnOfficial.classList.add(...inactiveBtnClass)
        }
      }

      // 2. Determinar precio activo de FLOWER
      const effectiveFlowerPrice = (isFlowerCustom && customFlowerPrice && customFlowerPrice > 0)
        ? customFlowerPrice
        : liveFlowerPrice

      const totalFlowerUsd = flowerAmount * effectiveFlowerPrice

      if (flowerPriceDisplayText) {
        if (flowerAmount === 1) {
          flowerPriceDisplayText.innerText = `$${effectiveFlowerPrice.toFixed(4)}`
          flowerPriceDisplayText.title = isFlowerCustom
            ? `$${effectiveFlowerPrice.toFixed(4)} USD / FL (Personalizado. Clic para cambiar)`
            : `$${effectiveFlowerPrice.toFixed(4)} USD / FL (En vivo. Clic para personalizar)`
        } else {
          flowerPriceDisplayText.innerText = `$${totalFlowerUsd >= 10 ? totalFlowerUsd.toFixed(2) : totalFlowerUsd.toFixed(4)}`
          flowerPriceDisplayText.title = `$${effectiveFlowerPrice.toFixed(4)} USD/FL (Total: $${totalFlowerUsd.toFixed(2)}. Clic para personalizar)`
        }
      }
      if (liveFlowerDisplay) {
        liveFlowerDisplay.innerText = `$${effectiveFlowerPrice.toFixed(4)} USD`
      }

      // 3. Determinar precio activo de Gemas y bono por volumen
      let fiatPerGem = 0.0129
      let gemBonus = 0

      if (isGemBonusCustom && customGemBonus !== null && customGemBonus >= 0) {
        gemBonus = customGemBonus
        fiatPerGem = 0.0129 / (1 + customGemBonus)
      } else {
        fiatPerGem = getGemFiatPrice(gemAmount)
        gemBonus = (0.0129 / fiatPerGem) - 1
      }

      const unitGemUsd = fiatPerGem * 0.8
      const totalGemUsd = gemAmount * unitGemUsd
      effectiveGemUsd = unitGemUsd

      const bonusPercent = Math.round(gemBonus * 100)

      if (gemBonusInput && document.activeElement !== gemBonusInput) {
        gemBonusInput.value = bonusPercent.toString()
      }

      if (gemBonusContainer) {
        if (bonusPercent > 0) {
          gemBonusContainer.classList.add("bg-emerald-500/15", "text-emerald-400", "border-emerald-500/30")
          gemBonusContainer.classList.remove("bg-white/5", "text-white/50", "border-white/10")
        } else {
          gemBonusContainer.classList.add("bg-white/5", "text-white/50", "border-white/10")
          gemBonusContainer.classList.remove("bg-emerald-500/15", "text-emerald-400", "border-emerald-500/30")
        }
      }

      if (gemPriceDisplayText) {
        if (gemAmount === 1) {
          gemPriceDisplayText.innerText = `$${unitGemUsd.toFixed(4)}`
          gemPriceDisplayText.title = `$${unitGemUsd.toFixed(4)} USD/gema ($${fiatPerGem.toFixed(4)} fiat -20% cripto. Bono: +${bonusPercent}%)`
        } else {
          gemPriceDisplayText.innerText = `$${totalGemUsd >= 10 ? totalGemUsd.toFixed(2) : totalGemUsd.toFixed(4)}`
          gemPriceDisplayText.title = `$${unitGemUsd.toFixed(4)} USD/u (Total: $${totalGemUsd.toFixed(2)}. Bono: +${bonusPercent}%)`
        }
      }

      // 4. Textos de ratio
      const rounded = Math.round(activeCoinsPerFlower)
      if (liveBettyRatioDisplay) {
        const modeLabel = coinsParityMode === "arbitrage" ? "(Betty)" : coinsParityMode === "official" ? "(Oficial)" : "(Custom)"
        liveBettyRatioDisplay.innerText = `1:${rounded} Coins ${modeLabel}`
      }

      // 5. Recalcular todo
      updateAll()
    }

    // Eventos de Coin
    if (containerBetty) {
      containerBetty.addEventListener("click", (e) => {
        coinsParityMode = "arbitrage"
        if (e.target !== inputBetty && inputBetty) {
          inputBetty.focus()
        }
        updateCurrencyUI()
      })
    }

    if (inputBetty) {
      inputBetty.addEventListener("focus", () => {
        coinsParityMode = "arbitrage"
        updateCurrencyUI()
      })
      inputBetty.addEventListener("input", () => {
        coinsParityMode = "arbitrage"
        const val = parseFloat(inputBetty.value)
        if (!isNaN(val) && val > 0) {
          isBettyCustom = true
          customBettyRatio = val
        } else {
          isBettyCustom = false
          customBettyRatio = null
        }
        updateCurrencyUI()
      })
    }

    if (btnOfficial) {
      btnOfficial.addEventListener("click", () => {
        coinsParityMode = "official"
        updateCurrencyUI()
      })
    }

    // Eventos de Gemas
    if (gemAmountInput) {
      gemAmountInput.addEventListener("input", () => {
        const val = parseFloat(gemAmountInput.value)
        gemAmount = (!isNaN(val) && val > 0) ? val : 1
        isGemBonusCustom = false
        customGemBonus = null
        updateCurrencyUI()
      })
    }

    if (gemBonusContainer) {
      gemBonusContainer.addEventListener("click", (e) => {
        if (e.target !== gemBonusInput && gemBonusInput) {
          gemBonusInput.focus()
          gemBonusInput.select()
        }
      })
    }

    if (gemBonusInput) {
      gemBonusInput.addEventListener("focus", () => {
        gemBonusInput.select()
      })
      gemBonusInput.addEventListener("input", () => {
        const val = parseFloat(gemBonusInput.value)
        if (!isNaN(val) && val >= 0) {
          isGemBonusCustom = true
          customGemBonus = val / 100
        } else {
          isGemBonusCustom = false
          customGemBonus = null
        }
        updateCurrencyUI()
      })
      gemBonusInput.addEventListener("blur", () => {
        if (!gemBonusInput.value || isNaN(parseFloat(gemBonusInput.value))) {
          isGemBonusCustom = false
          customGemBonus = null
          updateCurrencyUI()
        }
      })
    }

    // Eventos de FLOWER
    if (flowerAmountInput) {
      flowerAmountInput.addEventListener("input", () => {
        const val = parseFloat(flowerAmountInput.value)
        flowerAmount = (!isNaN(val) && val > 0) ? val : 1
        updateCurrencyUI()
      })
    }

    if (flowerPriceDisplayText) {
      flowerPriceDisplayText.addEventListener("click", () => {
        const current = (isFlowerCustom && customFlowerPrice) ? customFlowerPrice : liveFlowerPrice
        const input = prompt("Precio personalizado de 1 FLOWER en USD (deja vacío para volver al precio en vivo):", current.toFixed(4))
        if (input !== null) {
          const val = parseFloat(input.trim())
          if (!isNaN(val) && val > 0) {
            isFlowerCustom = true
            customFlowerPrice = val
          } else {
            isFlowerCustom = false
            customFlowerPrice = null
          }
          updateCurrencyUI()
        }
      })
    }

    // Sincronizar datos con el motor centralizado SflMarket
    function syncWithMarket(marketState) {
      if (!marketState) return
      if (marketState.flowerPrice) {
        liveFlowerPrice = marketState.flowerPrice
      }
      if (marketState.bettyRatio && marketState.bettyRatio > 0) {
        arbitrageCoinsPerFlower = marketState.bettyRatio
        if (arbitrageRatioText) {
          arbitrageRatioText.innerText = `1:${Math.round(marketState.bettyRatio).toLocaleString()}`
        }
      }
      updateCurrencyUI()
    }

    // 1. Escuchar el evento nativo del navegador
    window.addEventListener("sfl:marketUpdated", (e) => {
      if (e.detail) {
        syncWithMarket(e.detail)
      }
    })

    // 2. Si ya estaba en window o en SflMarket al cargar
    if (window.__sflMarketState) {
      syncWithMarket(window.__sflMarketState)
    } else if (window.SflMarket) {
      window.SflMarket.onUpdate((s) => syncWithMarket(s))
      const current = window.SflMarket.getState()
      if (current && current.raw) {
        syncWithMarket(current)
      }
    }

    // Escuchar el evento legacy de SflTabs por retrocompatibilidad
    window.addEventListener("sfl:bettyBestUpdated", (e) => {
      if (e.detail && e.detail > 0) {
        arbitrageCoinsPerFlower = e.detail
        if (arbitrageRatioText) {
          arbitrageRatioText.innerText = `1:${Math.round(e.detail).toLocaleString()}`
        }
        updateCurrencyUI()
      }
    })

    // Si SflTabs ya lo calculó previamente en window.__bestCoinsPerFlower
    if (window.__bestCoinsPerFlower && window.__bestCoinsPerFlower > 0) {
      arbitrageCoinsPerFlower = window.__bestCoinsPerFlower
      if (arbitrageRatioText) {
        arbitrageRatioText.innerText = `1:${Math.round(window.__bestCoinsPerFlower).toLocaleString()}`
      }
    }

    updateCurrencyUI()
  })()
</script>
