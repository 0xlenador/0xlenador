                  >
                    {t("sfl.constants.detail.ingredients")}
                  </span>
                  <div id="jafarDetailIngredients" class="flex flex-col gap-0.5">
                    <!-- Inyectado dinámicamente -->
                  </div>
                </div>

                <!-- Costo Total Fusionado -->
                <div
                  class="flex items-center justify-between py-2 px-3 rounded-xl bg-emerald-500/[0.06] border border-emerald-500/20 mt-2"
                >
                  <span class="text-xs font-mono text-terminal-secondary font-medium">
                    {t("sfl.constants.detail.totalCost")}:
                  </span>
                  <div class="flex flex-col items-end leading-tight">
                    <div class="flex items-center gap-1.5">
                      <img
                        src="/img/sunflowerland/flower.jpg"
                        class="w-3.5 h-3.5 rounded-full object-cover shrink-0"
                        alt="FLOWER"
                      />
                      <span id="jafarDetailFlower" class="text-sm font-mono font-bold text-emerald-400">
                        0.0000
                      </span>
                    </div>
                    <span id="jafarDetailUsd" class="text-[10.5px] font-mono text-white/50 pt-0.5">
                      ~$0.0000
                    </span>
                  </div>
                </div>
              </div>

              <!-- Simulador de Crafteo -->
              <div id="jafarCraftSimulatorSection" class="mt-3 pt-2.5 border-t border-white/10 flex flex-col gap-1.5">
                <div class="flex items-center justify-between">
                  <span class="text-[10px] font-mono text-terminal-muted">{t("sfl.constants.craftSimulation")}</span>

                  <!-- Popup de Límite de Stock -->
                  <div class="relative">
                    <button
                      id="jafarStockPopupTrigger"
                      type="button"
