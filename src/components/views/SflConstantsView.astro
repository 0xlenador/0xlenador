            title="Cantidad de gemas a cotizar"
          />

          <!-- Pill de Bono % recibido por volumen -->
          <div
            id="gemBonusContainer"
            class="flex items-center px-1 py-0.5 rounded text-[9px] font-mono font-bold bg-white/5 text-white/50 border border-white/10 whitespace-nowrap leading-none transition-all cursor-pointer"
            title={t("sfl.constants.gems.bonusTooltip")}
          >
            <span>+</span>
            <input
              type="number"
