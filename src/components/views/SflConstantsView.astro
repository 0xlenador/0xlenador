---
import { Icon } from "astro-icon/components"
import SflToolLayout from "../SflToolLayout.astro"
import CatalogCard, { type CatalogTab } from "../ui/CatalogCard.astro"
import blacksmithData from "../../content/data/sfl/blacksmith_tools.json"
import jafarData from "../../content/data/sfl/jafar_shop"
import agingShedData from "../../content/data/sfl/aging_shed.json"
import fishMarketData from "../../content/data/sfl/fishing/fish_market.json"
import fishData from "../../content/data/sfl/fishing/fish.json"
import crustaceansData from "../../content/data/sfl/fishing/crustaceans.json"
import bettyPrices from "../../content/data/sfl/betty_prices.json"
import sflIds from "../../content/data/sfl/resources.json"
import { getLangFromUrl, useTranslations, getLocalizedPath } from "../../i18n/utils"

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)
const loc = (path: string) => getLocalizedPath(path, lang)
const bettyUrl = loc("/sfl-betty")

const blacksmith = blacksmithData.buildings.blacksmith
const toolsTab = blacksmith.tabs.find((tab) => tab.id === "tools")
const categories = toolsTab ? toolsTab.categories : []
const landCat = categories.find((cat) => cat.id === "land")
const oilDrillItem = landCat?.items.find((item) => item.id === "oil_drill")

const jafar = jafarData.npc
const jafarBuyTab = jafar.tabs.find((tab) => tab.id === "buy")
const jafarCategories = jafarBuyTab ? jafarBuyTab.categories : []
const totalJafarItems = jafarCategories.reduce((acc, cat) => acc + (cat.items?.length || 0), 0)

const jafarSellTab = jafar.tabs.find((tab) => tab.id === "sell")
const jafarSellCategories = jafarSellTab ? jafarSellTab.categories : []
const totalJafarSellItems = jafarSellCategories.reduce((acc, cat) => acc + (cat.items?.length || 0), 0)
const jafarSellItems = jafarSellCategories[0]?.items || []

const catalogLabels = {
  selectTitle: t("sfl.constants.selectTool.title"),
  selectDesc: t("sfl.constants.selectTool.desc"),
  ingredients: t("sfl.constants.detail.ingredients"),
  reward: t("sfl.constants.sell.reward"),
  totalCost: t("sfl.constants.detail.totalCost"),
  totalReward: t("sfl.constants.sell.reward"),
  craftSimulation: t("sfl.constants.craftSimulation"),
  sellSimulation: t("sfl.constants.sell.simulation"),
  stockTitle: t("sfl.constants.stockTooltip.title"),
  stockDesc: t("sfl.constants.stockTooltip.desc"),
  stockAvailable: t("sfl.constants.stockTooltip.available"),
  permanent: t("sfl.constants.detail.permanent"),
  unlimited: t("sfl.constants.detail.unlimited"),
  free: t("sfl.constants.detail.free"),
  comingSoonTitle: t("sfl.constants.comingSoon.title"),
  comingSoonDesc: t("sfl.constants.comingSoon.desc"),
  customUnits: t("sfl.constants.sell.customUnits"),
  customPlaceholder: t("sfl.constants.sell.customPlaceholder"),
  agedXpLabel: t("sfl.constants.agedXp"),
  primeAgedXpLabel: t("sfl.constants.primeAgedXp"),
  agingTimeLabel: t("sfl.constants.agingTime"),
  catchesTitle: t("sfl.constants.catchesTitle"),
}

const blacksmithTabs: CatalogTab[] = [
  {
    id: "tools",
    name: t("sfl.constants.tab.tools"),
    icon: "⛏️",
    type: "craft",
    placeholderIcon: "⛏️",
    sections: categories.map((cat) => ({
      id: cat.id,
      name: cat.name,
      items: cat.items,
    })),
  },
  {
    id: "boosts",
    name: t("sfl.constants.tab.boosts"),
    icon: "⚡",
    isComingSoon: true,
  },
  {
    id: "build",
    name: t("sfl.constants.tab.build"),
    icon: "🔨",
    isComingSoon: true,
  },
]

const jafarTabs: CatalogTab[] = [
  {
    id: "buy",
    name: t("sfl.constants.tab.buy"),
    icon: "⛏️",
    type: "craft",
    placeholderIcon: "🏜️",
    sections: jafarCategories.map((cat) => ({
      id: cat.id,
      name: t(`sfl.constants.cat.${cat.id}`) || cat.name,
      items: cat.items,
    })),
  },
  {
    id: "sell",
    name: t("sfl.constants.tab.sell"),
    icon: "💰",
    type: "sell",
    placeholderIcon: "💎",
    multipliers: [1, 10, 100],
    sections: jafarSellCategories.map((cat) => ({
      id: cat.id,
      name: t(`sfl.constants.cat.${cat.id}`) || cat.name,
      showCount: true,
      items: cat.items,
    })),
  },
]

const agingShed = agingShedData.building
const agingShedTabs: CatalogTab[] = agingShed.tabs.map((tab) => {
  const tabDefaultChances = (tab as any).defaultChances
  return {
    id: tab.id,
    name: t(`sfl.constants.tab.${tab.id}`) || tab.name,
    icon: tab.icon,
    type: (tab.type as any) || "craft",
    isComingSoon: (tab as any).isComingSoon || false,
    placeholderIcon: tab.placeholderIcon,
    sections: tab.categories.map((cat) => ({
      id: cat.id,
      name: t(`sfl.constants.cat.${cat.id}`) || cat.name,
      items: cat.items.map((item: any) => {
        if (item.salt !== undefined) {
          const baseFishName = item.name.replace(/^Aged\s+/i, "")
          const baseFish = {
            name: baseFishName,
            amount: 1,
            image: item.image,
          }
          const saltIngredient = {
            name: "Salt",
            amount: item.salt,
            image: "/img/sunflowerland/Salt.png",
          }
          const customIngredients = Array.isArray(item.ingredients)
            ? item.ingredients.filter((ing: any) => ing.name !== "Salt")
            : [baseFish]

          return {
            ...item,
            chances: item.chances || tabDefaultChances,
            ingredients: [...customIngredients, saltIngredient],
          }
        }
        return item
      }),
    })),
  }
})

// --- 4. FISH MARKET: Mapeo de cebos especializados por estación ---
const itemImageMap: Record<string, string> = {
  Crab: "/img/sunflowerland/fish/a/Crab.png",
  "Crab Pot": "/img/sunflowerland/fish/a/Crab Pot.png",
  "Mariner Pot": "/img/sunflowerland/fish/a/Mariner Pot.png",
  Earthworm: "/img/sunflowerland/fish/a/Earthworm.png",
  Grub: "/img/sunflowerland/fish/a/Grub.png",
  "Red Wiggler": "/img/sunflowerland/fish/a/Red Wiggler.png",
  "Fishing Lure": "/img/sunflowerland/fish/a/Fishing Lure.png",
  Salt: "/img/sunflowerland/Salt.png",
}
fishData.forEach((f) => {
  if (f.name && f.image) itemImageMap[f.name] = f.image
})
crustaceansData.forEach((c) => {
  if (c.name && c.image) itemImageMap[c.name] = c.image
})

const seasonIcons: Record<string, string> = {
  spring: "🌸",
  summer: "☀️",
  autumn: "🍂",
  winter: "❄️",
}

const fishMarketSeasons = ["spring", "summer", "autumn", "winter"] as const

// Determinación dinámica de la estación actual en el ciclo de 4 semanas de Sunflower Land
// Rota cada lunes a las 00:00 UTC: spring -> summer -> autumn -> winter
const SFL_SEASONS_ORDER: Array<"spring" | "summer" | "autumn" | "winter"> = [
  "spring",
  "summer",
  "autumn",
  "winter",
]
const referenceMondayUtc = new Date("2024-01-01T00:00:00Z").getTime()
const oneWeekMs = 7 * 24 * 60 * 60 * 1000
const currentWeeksDiff = Math.floor((Date.now() - referenceMondayUtc) / oneWeekMs)
const currentSeasonIndex = ((currentWeeksDiff % 4) + 4) % 4
const currentSeason = SFL_SEASONS_ORDER[currentSeasonIndex]

// Estaciones ordenadas: primero la actual, luego las siguientes en rotación
const orderedSeasons: Array<"spring" | "summer" | "autumn" | "winter"> = [
  currentSeason,
  SFL_SEASONS_ORDER[(currentSeasonIndex + 1) % 4],
  SFL_SEASONS_ORDER[(currentSeasonIndex + 2) % 4],
  SFL_SEASONS_ORDER[(currentSeasonIndex + 3) % 4],
]

const getFishMarketItemDescription = (item: any) => {
  const timeHours = item.craftTimeHours || 1
  return lang === "en" ? `⏱️ Craft Time: ${timeHours}h.` : `⏱️ Tiempo: ${timeHours}h.`
}

const fishMarketTabs: CatalogTab[] = [
  {
    id: "specialty_baits",
    name: t("sfl.constants.cat.specialty_baits"),
    icon: "🎣",
    type: "craft",
    placeholderIcon: "🎣",
    multipliers: [1, 5, 10],
    sections: orderedSeasons.map((season, idx) => {
      const isCurrent = idx === 0
      const seasonName = t(`sfl.constants.tab.${season}`)
      const currentLabel = isCurrent ? ` (${t("sfl.constants.fish_market.currentSeason")})` : ""

      return {
        id: `season_${season}`,
        name: `${seasonIcons[season]} ${seasonName}${currentLabel}`,
        showCount: true,
        items: fishMarketData.map((item) => {
          const seasonal =
            (item.seasonalIngredients as Record<string, Record<string, number>>)[season] || {}
          const ingredients = [
            ...Object.entries(item.baseIngredients).map(([name, amount]) => ({
              name,
              amount: Number(amount),
              image: itemImageMap[name] || `/img/sunflowerland/fish/${name}.png`,
            })),
            ...Object.entries(seasonal).map(([name, amount]) => ({
              name,
              amount: Number(amount),
              image: itemImageMap[name] || `/img/sunflowerland/fish/${name}.png`,
            })),
          ]

          const timeHours = item.craftTimeHours || 1
          const catchPool = (item.guaranteedCatchPool || []).map((fishName: string) => ({
            name: fishName,
            image: `/img/sunflowerland/fish/${fishName}.png`,
          }))

          return {
            id: `${item.id}_${season}`,
            name: `${item.name} (${seasonName})`,
            baseName: item.name,
            season,
            image: item.image,
            coins: 0,
            stock: 0,
            timeSeconds: timeHours * 3600,
            description: getFishMarketItemDescription(item),
            ingredients,
            catchPool,
          }
        }),
      }
    }),
  },
]

import { getAnimalBuildings } from "../../lib/sfl/animals"
import { caveData } from "../../content/data/sfl/cave_mining"
const mudMixData = caveData.mixes.find((m) => m.id === "mud_mix")
const mudMixOptions = mudMixData?.requirement.options || []

const animalBuildings = getAnimalBuildings()
const henHouse = animalBuildings.find((b) => b.id === "hen_house")
const barn = animalBuildings.find((b) => b.id === "barn")
const pigpen = animalBuildings.find((b) => b.id === "pigpen")

const animalBuildingsList = [
  { building: henHouse, prefix: "henhouse", icon: "/img/sunflowerland/123/Chicken.png" },
  { building: barn, prefix: "barn", icon: "/img/sunflowerland/powerups/baby_cow.webp" },
  { building: pigpen, prefix: "pigpen", icon: "/img/sunflowerland/123/Pig.png" },
]
---

<SflToolLayout activeTab="constantes">
  <!-- Encabezado Principal -->
  <div class="mb-5 relative z-10 text-center sm:text-left">
    <h1 class="text-3xl md:text-4xl font-black text-white tracking-tighter mb-2">
      {t("sfl.constants.heading")}
      <span class="text-emerald-500"> {t("sfl.constants.heading.accent")}</span>
    </h1>
    <p class="text-terminal-secondary text-sm leading-relaxed max-w-3xl">
      {t("sfl.constants.intro")}
