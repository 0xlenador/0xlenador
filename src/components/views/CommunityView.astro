<!-- SCRIPT INTERACTIVO: SLIDER AUDIOVISUAL + FILTROS + COPIAR ENLACE -->
<script>
  let activeCommunitySliderTimer: ReturnType<typeof setInterval> | null = null

  function setupCommunityView() {
    if (activeCommunitySliderTimer !== null) {
      clearInterval(activeCommunitySliderTimer)
      activeCommunitySliderTimer = null
    }

    // ----------------------------------------------------
    // 1. Slider Audiovisual (YouTube / TikTok / Instagram)
    // ----------------------------------------------------
    const slides = document.querySelectorAll<HTMLElement>("#slider-viewport .slide-content")
    const tabs = document.querySelectorAll<HTMLButtonElement>("#slider-tabs .slide-tab")
    const dots = document.querySelectorAll<HTMLButtonElement>("#slider-dots button")
    const prevBtn = document.getElementById("slider-prev")
    const nextBtn = document.getElementById("slider-next")
    const counter = document.getElementById("slider-counter")

    let currentSlide = 0
    const totalSlides = slides.length

    function startAutoSlide() {
      stopAutoSlide()
      activeCommunitySliderTimer = setInterval(() => {
        showSlide(currentSlide + 1)
      }, 5000)
    }

    function stopAutoSlide() {
      if (activeCommunitySliderTimer !== null) {
        clearInterval(activeCommunitySliderTimer)
        activeCommunitySliderTimer = null
      }
    }

    function resetAutoSlide() {
      stopAutoSlide()
      startAutoSlide()
    }

    const tabActiveClasses = [
      ["text-white", "bg-red-500/20", "border-red-500/40"],
      ["text-white", "bg-teal-500/20", "border-teal-500/40"],
      ["text-white", "bg-pink-500/20", "border-pink-500/40"]
    ]

    const dotActiveClasses = ["bg-red-400", "bg-teal-400", "bg-pink-400"]

    function showSlide(index: number) {
      if (index < 0) index = totalSlides - 1
      if (index >= totalSlides) index = 0
      currentSlide = index

      // Actualizar slides
      slides.forEach((s, idx) => {
        if (idx === currentSlide) {
          s.classList.remove("hidden", "opacity-0")
          s.classList.add("block", "opacity-100")
        } else {
          s.classList.add("hidden", "opacity-0")
          s.classList.remove("block", "opacity-100")
        }
      })

      // Actualizar tabs
      tabs.forEach((tab, idx) => {
        tab.className = "slide-tab flex-1 py-1.5 px-2 rounded-lg text-xs font-mono font-medium transition-all border "
        if (idx === currentSlide) {
          tab.classList.add(...tabActiveClasses[idx])
        } else {
          tab.classList.add("text-terminal-muted", "hover:text-white", "border-transparent")
        }
      })

      // Actualizar dots
      dots.forEach((dot, idx) => {
        dot.className = "w-2 h-2 rounded-full transition-all "
        if (idx === currentSlide) {
          dot.classList.add(dotActiveClasses[idx], "w-4")
        } else {
          dot.classList.add("bg-white/20", "hover:bg-white/40")
        }
      })

      if (counter) {
        counter.textContent = `${currentSlide + 1} / ${totalSlides}`
      }
    }

    if (tabs.length > 0) {
      tabs.forEach((tab) => {
        tab.addEventListener("click", () => {
          const idx = parseInt(tab.getAttribute("data-slide-index") || "0", 10)
          showSlide(idx)
          resetAutoSlide()
        })
      })

      dots.forEach((dot) => {
        dot.addEventListener("click", () => {
          const idx = parseInt(dot.getAttribute("data-dot-index") || "0", 10)
          showSlide(idx)
          resetAutoSlide()
        })
      })

      if (prevBtn) {
        prevBtn.addEventListener("click", () => {
          showSlide(currentSlide - 1)
          resetAutoSlide()
        })
      }
      if (nextBtn) {
        nextBtn.addEventListener("click", () => {
          showSlide(currentSlide + 1)
          resetAutoSlide()
        })
      }

      // Pausar rotación automática si el cursor está sobre la tarjeta del slider
      const sliderContainer = document.getElementById("visual-slider-card")
      if (sliderContainer) {
        sliderContainer.addEventListener("mouseenter", stopAutoSlide)
        sliderContainer.addEventListener("mouseleave", startAutoSlide)
      }

      // Iniciar rotación automática cada 5 segundos
      startAutoSlide()
    }

    // ----------------------------------------------------
    // 2. Filtros de Canales (Todos / Activos / Próximamente)
    // ----------------------------------------------------
    const filterTabs = document.querySelectorAll<HTMLButtonElement>("#community-filters .filter-tab")
    const channelItems = document.querySelectorAll<HTMLElement>("#bottom-cards-container .channel-item")

    filterTabs.forEach((tab) => {
      tab.addEventListener("click", () => {
        const filter = tab.getAttribute("data-filter")

        // Activar tab
        filterTabs.forEach((t) => {
          t.classList.remove("bg-emerald-500/20", "text-emerald-300", "border-emerald-500/30")
          t.classList.add("text-terminal-muted", "border-transparent")
        })
        tab.classList.remove("text-terminal-muted", "border-transparent")
        tab.classList.add("bg-emerald-500/20", "text-emerald-300", "border-emerald-500/30")

        // Filtrar elementos
        channelItems.forEach((item) => {
          const status = item.getAttribute("data-status")
          if (filter === "all") {
            item.style.display = ""
          } else if (filter === "active") {
            item.style.display = status === "active" ? "" : "none"
          } else if (filter === "soon") {
            item.style.display = status === "soon" ? "" : "none"
          }
        })
      })
    })

    // ----------------------------------------------------
    // 3. Botón de Copiar Enlace
    // ----------------------------------------------------
    const copyBtn = document.getElementById("copy-link-btn")
    const copyBtnText = document.getElementById("copy-btn-text")
    if (copyBtn && copyBtnText) {
      const originalText = copyBtnText.textContent || "Copiar Enlace"
      copyBtn.addEventListener("click", async () => {
        try {
          await navigator.clipboard.writeText(window.location.href)
          copyBtnText.textContent = "¡Copiado!"
          copyBtn.classList.add("border-emerald-400", "text-emerald-300")
          setTimeout(() => {
            copyBtnText.textContent = originalText
            copyBtn.classList.remove("border-emerald-400", "text-emerald-300")
          }, 2000)
        } catch {
          const input = document.createElement("input")
          input.value = window.location.href
          document.body.appendChild(input)
          input.select()
          document.execCommand("copy")
          document.body.removeChild(input)
          copyBtnText.textContent = "¡Copiado!"
          setTimeout(() => {
            copyBtnText.textContent = originalText
          }, 2000)
        }
      })
    }
  }

  // Ejecución inicial y soporte View Transitions de Astro
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", setupCommunityView)
  } else {
    setupCommunityView()
  }
  document.addEventListener("astro:page-load", setupCommunityView)
  document.addEventListener("astro:before-swap", () => {
    if (activeCommunitySliderTimer !== null) {
      clearInterval(activeCommunitySliderTimer)
      activeCommunitySliderTimer = null
    }
  })
</script>
