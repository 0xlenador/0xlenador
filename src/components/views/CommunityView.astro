<main class="max-w-6xl mx-auto px-4 sm:px-6 pt-4 pb-14">
  <!-- HEADER COMPACTO SUPERIOR -->
  <header class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-4 pb-3 border-b border-terminal-border/60">
    <div>
      <div class="flex items-center gap-2 flex-wrap">
        <h1 class="text-xl md:text-2xl font-bold text-white tracking-tight">
          Canales Oficiales y Comunitarios de 0x Lenador
        </h1>
      </div>
      <p class="text-xs text-terminal-secondary mt-1 max-w-xl">
        {t("community.header.bio")}
      </p>
    </div>

    <!-- Acciones Rápidas -->
    <div class="flex items-center gap-2 flex-shrink-0">
      <button
        id="copy-link-btn"
        type="button"
        class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-terminal-surface hover:bg-terminal-elevated border border-terminal-border text-xs font-mono text-terminal-text hover:text-white transition-all cursor-pointer shadow-sm active:scale-95"
      >
        <svg class="w-3.5 h-3.5 text-terminal-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3" />
        </svg>
        <span id="copy-btn-text">Copiar Enlace</span>
      </button>

      <span class="px-2.5 py-1.5 rounded-lg bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 font-mono text-xs flex items-center gap-1">
        <svg class="w-3.5 h-3.5" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
        </svg>
        <span>Verificado</span>
      </span>
    </div>
