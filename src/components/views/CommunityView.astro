    background: linear-gradient(
      180deg,
      rgba(255, 255, 255, 0.045) 0%,
      rgba(255, 255, 255, 0.02) 50%,
      rgba(255, 255, 255, 0.008) 100%
    );
    border: 1px solid rgba(255, 255, 255, 0.1);
    box-shadow:
      inset 0 1px 0 0 rgba(255, 255, 255, 0.12),
      0 12px 32px -8px rgba(0, 0, 0, 0.5);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    transition:
      transform 0.3s cubic-bezier(0.16, 1, 0.3, 1),
      border-color 0.3s ease,
      box-shadow 0.3s ease;
  }
  .apple-hero-card:hover {
    transform: translateY(-3px);
    border-color: rgba(255, 255, 255, 0.22);
    box-shadow:
      inset 0 1px 0 0 rgba(255, 255, 255, 0.2),
      0 20px 48px -12px rgba(0, 0, 0, 0.7);
  }

  /* Apple Directory Card — Sleek, subtle, uniform */
  .apple-card {
    background: rgba(255, 255, 255, 0.022);
    border: 1px solid rgba(255, 255, 255, 0.065);
    border-radius: 1rem;
    position: relative;
    overflow: hidden;
    transition:
      background 0.25s ease,
      border-color 0.25s ease,
      transform 0.25s ease;
  }
  .apple-card:hover {
    background: rgba(255, 255, 255, 0.04);
    border-color: rgba(255, 255, 255, 0.15);
    transform: translateY(-2px);
  }

  /* Segmented control tab button */
  .segmented-tab {
    color: rgba(255, 255, 255, 0.45);
    border: 1px solid transparent;
    cursor: pointer;
    user-select: none;
  }
  .segmented-tab.active {
    background: rgba(255, 255, 255, 0.09);
    border-color: rgba(255, 255, 255, 0.14);
    color: #ffffff;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.5);
  }
</style>

<script>
  function setupCommunityView() {
    // 1. Filtros segmentados para el Directorio Completo
    const filterTabs = document.querySelectorAll<HTMLButtonElement>("#community-filters .segmented-tab")
    const directoryCards = document.querySelectorAll<HTMLElement>("#directory-grid-container .directory-card")

    filterTabs.forEach((tab) => {
      tab.addEventListener("click", () => {
        const filter = tab.getAttribute("data-filter")

        // Activar tab
        filterTabs.forEach((t) => {
          t.classList.remove("active")
          t.classList.add("text-white/40")
        })
        tab.classList.add("active")
        tab.classList.remove("text-white/40")

        // Filtrar tarjetas del directorio
        directoryCards.forEach((card) => {
          const status = card.getAttribute("data-status")
          if (filter === "all") {
            card.style.display = ""
          } else if (filter === "active") {
            card.style.display = status === "active" ? "" : "none"
          } else if (filter === "soon") {
            card.style.display = status === "soon" ? "" : "none"
          }
        })
      })
    })

    // 2. Botón Copiar Enlace
    const copyBtn = document.getElementById("copy-link-btn")
    const copyBtnText = document.getElementById("copy-btn-text")
    if (copyBtn && copyBtnText) {
      const originalText = copyBtn.getAttribute("data-copy-text") || copyBtnText.textContent || "Compartir Enlace"
      const copiedText = copyBtn.getAttribute("data-copied-text") || "¡Enlace copiado!"

      copyBtn.addEventListener("click", async () => {
        try {
          await navigator.clipboard.writeText(window.location.href)
          copyBtnText.textContent = copiedText
          copyBtn.classList.add("border-emerald-400", "text-emerald-300")
          setTimeout(() => {
            copyBtnText.textContent = originalText
            copyBtn.classList.remove("border-emerald-400", "text-emerald-300")
          }, 2000)
        } catch {
          const input = document.createElement("input")
          input.value = window.location.href
          document.body.appendChild(input)
          input.select()
          document.execCommand("copy")
          document.body.removeChild(input)
          copyBtnText.textContent = copiedText
          setTimeout(() => {
            copyBtnText.textContent = originalText
          }, 2000)
        }
      })
    }
  }

  // Ejecución inicial y soporte View Transitions de Astro
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", setupCommunityView)
  } else {
    setupCommunityView()
  }
  document.addEventListener("astro:page-load", setupCommunityView)
</script>
