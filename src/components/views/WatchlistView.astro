---
// ==========================================
// src/components/views/WatchlistView.astro
// View puro para la página de activos/watchlist
// ==========================================

import FaqAccordion from "../FaqAccordion.astro"
import { getLangFromUrl, useTranslations, getLocalizedPath } from "../../i18n/utils"

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)

// Activos en seguimiento activo — datos estáticos que reflejan la tesis
const watchlist = [
  {
    ticker: "BTC",
    nombre: "Bitcoin",
    categoria: t("assets.cat.cryptoL1"),
    href: getLocalizedPath("/activos/bitcoin", lang),
    imagen: "/img/cripto/bitcoin.webp",
    descripcion: t("assets.btc.desc"),
    accentColor: "orange",
  },
  {
    ticker: "ETH",
    nombre: "Ethereum",
    categoria: t("assets.cat.cryptoL1"),
    href: getLocalizedPath("/activos/ethereum", lang),
    imagen: "/img/cripto/ethereum.webp",
    descripcion: t("assets.eth.desc"),
    accentColor: "blue",
  },
  {
    ticker: "HYPE",
    nombre: "Hyperliquid",
    categoria: t("assets.cat.dex"),
    href: getLocalizedPath("/activos/hyperliquid", lang),
    imagen: "/img/cripto/hyperliquid.webp",
    descripcion: t("assets.hype.desc"),
    accentColor: "fuchsia",
  },
  {
    ticker: "SPY",
    nombre: "S&P 500 ETF",
    categoria: t("assets.cat.renta"),
    href: null,
    imagen: "/img/cripto/syp500.webp",
    descripcion: t("assets.spy.desc"),
    accentColor: "emerald",
  },
  {
    ticker: "BRK.B",
    nombre: "Berkshire Hathaway",
    categoria: t("assets.cat.renta"),
    href: null,
    imagen: "/img/cripto/brk.webp",
    descripcion: t("assets.brk.desc"),
    accentColor: "emerald",
  },
  {
    ticker: "RUNE",
    nombre: "Runestone",
    categoria: t("assets.cat.ordinals"),
    href: getLocalizedPath("/activos/runestone", lang),
    imagen: "/img/cripto/runestone.webp",
    descripcion: t("assets.rune.desc"),
    accentColor: "orange",
  },
  {
    ticker: "SFL",
    nombre: "Sunflower Land",
    categoria: t("assets.cat.game"),
    href: getLocalizedPath("/activos/sunflowerland", lang),
    imagen: "/img/cripto/sunflowerland.webp",
    descripcion: t("assets.sfl.desc"),
    accentColor: "yellow",
  },
]

// Mapa de colores para el acento de categoría
const accentMap: Record<string, string> = {
  orange: "text-orange-400  border-orange-400/20  bg-orange-400/5",
  blue: "text-blue-400    border-blue-400/20    bg-blue-400/5",
  fuchsia: "text-fuchsia-400 border-fuchsia-400/20 bg-fuchsia-400/5",
  emerald: "text-emerald-400 border-emerald-400/20 bg-emerald-400/5",
  yellow: "text-yellow-400  border-yellow-400/20  bg-yellow-400/5",
}

const faqItems = [
  { pregunta: t("assets.faq.q1"), respuesta: t("assets.faq.a1") },
  { pregunta: t("assets.faq.q2"), respuesta: t("assets.faq.a2") },
  { pregunta: t("assets.faq.q3"), respuesta: t("assets.faq.a3") },
  { pregunta: t("assets.faq.q4"), respuesta: t("assets.faq.a4") },
]
---

<main class="max-w-6xl mx-auto px-6 pt-10 pb-20">
  <!-- Header -->
  <header class="mb-16">
    <p class="text-[10px] font-mono text-emerald-500/70 uppercase tracking-[0.4em] mb-3">
      {t("assets.breadcrumb")}
    </p>
    <h1 class="text-4xl md:text-5xl font-black text-white tracking-tighter mb-4">
      {t("assets.heading")}{" "}
      <span class="text-emerald-500">{t("assets.heading.accent")}</span>
    </h1>
    <p class="text-terminal-secondary text-sm leading-relaxed max-w-2xl">
      {t("assets.intro")}
    </p>
  </header>

  <!-- Watchlist header de tabla -->
  <div class="flex items-center gap-4 mb-8">
    <h2 class="section-prompt text-xs font-mono text-terminal-subtle uppercase tracking-[0.5em]">
      {t("assets.section.title")}
    </h2>
    <div class="h-px flex-grow bg-terminal-border/50"></div>
    <span class="text-[10px] font-mono text-terminal-subtle"
      >{watchlist.length} {t("assets.count")}</span
    >
  </div>

  <!-- Tabla de activos (desktop) / Cards (móvil) -->
  <div class="hub-card overflow-hidden mb-20">
    <!-- Desktop: tabla -->
    <div class="hidden md:block overflow-x-auto">
      <table class="ops-table">
        <thead>
          <tr>
            <th>{t("assets.table.asset")}</th>
            <th>{t("assets.table.ticker")}</th>
            <th>{t("assets.table.category")}</th>
            <th>{t("assets.table.thesis")}</th>
            <th class="text-right">{t("assets.table.detail")}</th>
          </tr>
        </thead>
        <tbody>
          {
            watchlist.map((activo) => (
              <tr>
                <td>
                  {activo.href ? (
                    <a href={activo.href} class="flex items-center gap-3 group no-underline">
                      <img
                        src={activo.imagen}
                        alt={activo.nombre}
                        width={32}
                        height={32}
                        loading="lazy"
                        class="w-7 h-7 rounded-full object-contain flex-shrink-0"
                      />
                      <span class="text-white font-bold text-xs group-hover:text-emerald-400 transition-colors">
                        {activo.nombre}
                      </span>
                    </a>
                  ) : (
                    <div class="flex items-center gap-3">
                      <img
                        src={activo.imagen}
                        alt={activo.nombre}
                        width={32}
                        height={32}
                        loading="lazy"
                        class="w-7 h-7 rounded-full object-contain flex-shrink-0"
                      />
                      <span class="text-white font-bold text-xs">{activo.nombre}</span>
                    </div>
                  )}
                </td>
                <td>
                  <span
                    class:list={[
                      "font-mono text-xs px-2 py-0.5 rounded border",
                      accentMap[activo.accentColor],
                    ]}
                  >
                    {activo.ticker}
                  </span>
                </td>
                <td class="text-terminal-subtle text-xs">{activo.categoria}</td>
                <td class="text-terminal-muted text-xs max-w-xs">{activo.descripcion}</td>
                <td class="text-right">
                  {activo.href ? (
                    <a
                      href={activo.href}
                      class="text-emerald-500/70 hover:text-emerald-400 font-mono text-xs uppercase tracking-widest transition-colors"
                    >
                      {t("assets.link.view")}
                    </a>
                  ) : (
                    <span class="text-terminal-subtle/40 font-mono text-[10px] uppercase">
                      {t("assets.link.soon")}
                    </span>
                  )}
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>

    <!-- Móvil: cards -->
    <div class="grid grid-cols-1 gap-0 divide-y divide-terminal-border md:hidden">
      {
        watchlist.map((activo) => (
          <div class="p-4 flex items-start gap-3">
            {activo.href ? (
              <a href={activo.href} class="block group flex-shrink-0 mt-0.5">
                <img
                  src={activo.imagen}
                  alt={activo.nombre}
                  width={32}
                  height={32}
                  loading="lazy"
                  class="w-8 h-8 rounded-full object-contain"
                />
              </a>
            ) : (
              <img
                src={activo.imagen}
                alt={activo.nombre}
                width={32}
                height={32}
                loading="lazy"
                class="w-8 h-8 rounded-full object-contain flex-shrink-0 mt-0.5"
              />
            )}
            <div class="flex-1 min-w-0">
              <div class="flex items-center justify-between gap-2 mb-1">
                {activo.href ? (
                  <a
                    href={activo.href}
                    class="text-white font-bold text-sm hover:text-emerald-400 transition-colors no-underline"
                  >
                    {activo.nombre}
                  </a>
                ) : (
                  <span class="text-white font-bold text-sm">{activo.nombre}</span>
                )}
                <span
                  class:list={[
                    "font-mono text-[10px] px-1.5 py-0.5 rounded border flex-shrink-0",
                    accentMap[activo.accentColor],
                  ]}
                >
                  {activo.ticker}
                </span>
              </div>
              <p class="text-terminal-muted text-xs leading-relaxed">{activo.descripcion}</p>
              {activo.href && (
                <a
                  href={activo.href}
                  class="text-emerald-500/70 text-xs font-mono mt-2 inline-block hover:text-emerald-400 transition-colors"
                >
                  {t("assets.link.analysis")}
                </a>
              )}
            </div>
          </div>
        ))
      }
    </div>
  </div>

  <!-- Avisos de activos individuales -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-20">
    {
      watchlist
        .filter((a) => a.href)
        .map((activo) => (
          <a href={activo.href!} class="hub-card p-5 flex items-center gap-4 group no-underline">
            <img
              src={activo.imagen}
              alt={activo.nombre}
              width={48}
              height={48}
              loading="lazy"
              class="w-10 h-10 rounded-full object-contain flex-shrink-0"
            />
            <div class="flex-1 min-w-0">
              <p class="text-white font-bold text-sm group-hover:text-emerald-400 transition-colors">
                {activo.nombre}
              </p>
              <p class="text-terminal-subtle text-[10px] font-mono uppercase tracking-widest">
                {t("assets.link.full")}
              </p>
            </div>
          </a>
        ))
    }
  </div>

  <FaqAccordion
    titulo={t("assets.faq.title")}
    subtitulo={t("assets.faq.subtitle")}
    startId={500}
    items={faqItems}
  />
</main>
