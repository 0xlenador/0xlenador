---
import SflToolLayout from "../SflToolLayout.astro"
import bettyPrices from "../../content/data/sfl/betty_prices.json"
import sflIds from "../../content/data/sfl/resources.json"
import { getLangFromUrl, useTranslations } from "../../i18n/utils"

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)
---

<SflToolLayout activeTab="betty">
  <div class="flex flex-col lg:flex-row items-start justify-between gap-6 mb-6 lg:mb-8">
    <div class="max-w-2xl text-center lg:text-left px-4 lg:px-0">
      <h1 class="text-3xl md:text-4xl font-black text-white tracking-tighter mb-3">
        {t("sfl.betty.heading")}
        <span class="text-emerald-500"> {t("sfl.betty.heading.accent")}</span>
      </h1>
      <p class="text-terminal-secondary text-sm leading-relaxed max-w-2xl">
        {t("sfl.betty.intro")}
      </p>
    </div>
    
    <!-- Calculator Card -->
    <div class="w-full lg:w-[420px] bg-white/[0.02] border border-white/5 rounded-xl p-3 flex flex-col gap-3 shrink-0 mt-2 lg:mt-0">
      <div class="flex items-center justify-between">
        <span class="text-[10px] font-bold text-terminal-muted uppercase tracking-wider">{t("sfl.betty.calculator.title")}</span>
        <button id="resetBestBtn" class="text-[9px] font-mono text-emerald-400 hover:text-emerald-300 transition-colors cursor-pointer" title={t("sfl.betty.calculator.resetTitle")}>{t("sfl.betty.calculator.reset")}</button>
      </div>
      <div class="relative">
        <button id="itemSelectorBtn" class="w-full flex items-center justify-between bg-black/20 hover:bg-white/[0.04] transition-colors rounded-lg p-2 border border-white/5 cursor-pointer text-left">
          <div id="selectedItemContent" class="flex items-center gap-2 w-full">
            <div class="animate-pulse bg-white/5 h-7 w-7 rounded"></div>
            <div class="animate-pulse bg-white/5 h-3 w-16 rounded"></div>
          </div>
          <svg class="w-4 h-4 text-white/30 shrink-0 ml-2" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
        </button>
        
        <!-- Dropdown Menu -->
        <div id="itemDropdown" class="hidden absolute top-full left-0 right-0 mt-1 max-h-48 overflow-y-auto bg-[#1a1a1a] border border-white/10 rounded-lg shadow-xl z-50 flex flex-col gap-1 p-1 no-scrollbar">
          <!-- Items injected via JS -->
        </div>
      </div>
      
      <div class="flex items-center gap-1.5 mt-1">
        <div class="relative flex-1" title="Inversión en $FLOWER">
          <input type="number" id="flowerInput" value="10" min="0" step="0.1" class="w-full bg-black/40 border border-white/10 rounded-lg py-1.5 pl-2 pr-6 text-xs text-white font-mono focus:!outline-none focus-visible:!outline-none focus:!ring-1 focus:!ring-emerald-500/30 focus:!border-emerald-500/30 transition-all" />
          <img src="/img/sunflowerland/flower.jpg" class="w-3 h-3 rounded-full absolute right-2 top-1/2 -translate-y-1/2 opacity-70" />
        </div>
        <svg class="w-3 h-3 text-white/30 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
        <div class="relative flex-1 bg-white/5 border border-white/10 rounded-lg" title="Cantidad de items a comprar">
          <input type="number" id="itemsInput" value="0" min="0" step="1" class="w-full bg-transparent py-1.5 pl-2 pr-7 text-xs text-white/90 font-bold font-mono text-right focus:!outline-none focus-visible:!outline-none focus:!ring-0 focus:bg-white/10 rounded-lg transition-colors" />
          <img id="itemsOutputImg" src="/img/sunflowerland/123/empty.png" class="w-4 h-4 absolute right-1.5 top-1/2 -translate-y-1/2 object-contain" />
        </div>
        <svg class="w-3 h-3 text-white/30 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
        <div class="relative flex-1 bg-emerald-500/10 border border-emerald-500/20 rounded-lg" title="Coins recibidas de Betty">
          <input type="number" id="coinsInput" value="0" min="0" step="10" class="w-full bg-transparent py-1.5 pl-2 pr-6 text-xs text-emerald-400 font-bold font-mono text-right focus:!outline-none focus-visible:!outline-none focus:!ring-0 focus:bg-emerald-500/20 rounded-lg transition-colors" />
          <img src="/img/sunflowerland/123/coins.png" class="w-3 h-3 absolute right-2 top-1/2 -translate-y-1/2" />
        </div>
      </div>
    </div>
  </div>

  <div class="w-full">
    <!-- Controles -->
    <div class="flex flex-col sm:flex-row gap-3 sm:gap-4 mb-4 sm:mb-6">
      <div class="relative flex-1">
        <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
          <svg class="w-4 h-4 text-terminal-muted" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </div>
        <input
          type="text"
          id="searchInput"
          class="w-full bg-white/[0.02] border border-white/10 rounded-xl py-3 pl-10 pr-4 text-sm text-white placeholder-white/30 focus:!outline-none focus-visible:!outline-none focus:!ring-1 focus:!ring-emerald-500/30 focus:!border-emerald-500/30 focus:bg-white/[0.04] transition-all"
          placeholder={t("sfl.betty.search.placeholder")}
          autocomplete="off"
        />
      </div>
      
      <!-- Filtros por Categoría -->
      <div class="flex items-center w-full sm:w-auto gap-2 overflow-x-auto no-scrollbar pb-2 sm:pb-0">
        <button
          class="category-btn active flex-1 flex justify-center px-2 sm:px-4 py-2 bg-emerald-500/20 text-emerald-400 border border-emerald-500/30 rounded-xl text-[10px] sm:text-xs font-bold uppercase tracking-wider hover:bg-emerald-500/30 transition-colors whitespace-nowrap shrink-0"
          data-category="all"
          onclick="window.handleCategory('all')"
        >
          {t("sfl.cooking.filter.all")}
        </button>
        <button
          class="category-btn flex-1 flex justify-center px-2 sm:px-4 py-2 bg-white/5 text-white/40 border border-white/10 rounded-xl text-[10px] sm:text-xs font-bold uppercase tracking-wider hover:bg-white/10 hover:text-white transition-colors whitespace-nowrap shrink-0"
          data-category="Crops"
          onclick="window.handleCategory('Crops')"
        >
          Crops
        </button>
        <button
          class="category-btn flex-1 flex justify-center px-2 sm:px-4 py-2 bg-white/5 text-white/40 border border-white/10 rounded-xl text-[10px] sm:text-xs font-bold uppercase tracking-wider hover:bg-white/10 hover:text-white transition-colors whitespace-nowrap shrink-0"
          data-category="Fruits"
          onclick="window.handleCategory('Fruits')"
        >
          Fruits
        </button>
        <button
          class="category-btn flex-1 flex justify-center px-2 sm:px-4 py-2 bg-white/5 text-white/40 border border-white/10 rounded-xl text-[10px] sm:text-xs font-bold uppercase tracking-wider hover:bg-white/10 hover:text-white transition-colors whitespace-nowrap shrink-0"
          data-category="Greenhouse"
          onclick="window.handleCategory('Greenhouse')"
        >
          Greenhouse
        </button>
        
        <!-- Botón Refresh -->
        <button
          id="fetchBtn"
          class="px-3 py-1.5 bg-emerald-500/10 hover:bg-emerald-500/20 border border-emerald-500/30 text-emerald-400 font-bold text-xs rounded-xl transition-colors whitespace-nowrap flex items-center gap-2 group shrink-0 ml-auto"
        >
          <svg
            id="fetchBtnRefreshIcon"
            class="w-3.5 h-3.5 group-hover:rotate-180 transition-transform duration-500 shrink-0"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            ><path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"
            ></path></svg
          >
          <svg 
            id="fetchBtnCheckIcon"
            class="w-3.5 h-3.5 shrink-0 hidden" 
            fill="none" 
            viewBox="0 0 24 24" 
            stroke="currentColor"
            ><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
          <span id="fetchBtnText" data-original-text={t("sfl.refresh")} data-updated-text={t("sfl.updated")}>{t("sfl.refresh")}</span>
        </button>
      </div>
    </div>

    <!-- Loading State -->
    <div id="loadingState" class="py-12 flex flex-col items-center justify-center gap-4 border border-white/5 bg-white/[0.02] rounded-3xl">
      <div class="w-8 h-8 border-2 border-emerald-500/20 border-t-emerald-500 rounded-full animate-spin"></div>
      <p class="text-sm font-mono text-terminal-muted">{t("sfl.betty.loading")}</p>
    </div>

    <!-- Data Container -->
    <div id="dataContainer" class="hidden">
      <!-- Header Tabla Desktop -->
      <div class="hidden lg:grid grid-cols-[22%_15%_15%_15%_15%_18%] border-b border-white/10 pb-3 mb-2 px-6 mt-4">
        <div class="text-xs font-mono text-terminal-muted uppercase tracking-wider font-semibold cursor-pointer group flex items-center gap-2" onclick="window.handleSort('name')">
          {t("sfl.betty.col.name")} <span class="sort-icon opacity-0 group-hover:opacity-50 transition-opacity" data-col="name">↕</span>
        </div>
        <div class="text-xs font-mono text-terminal-muted uppercase tracking-wider font-semibold cursor-pointer group flex items-center gap-2" onclick="window.handleSort('category')">
          {t("sfl.betty.col.category")} <span class="sort-icon opacity-0 group-hover:opacity-50 transition-opacity" data-col="category">↕</span>
        </div>
        <div class="text-xs font-mono text-terminal-muted uppercase tracking-wider font-semibold cursor-pointer group flex items-center gap-2 justify-end" onclick="window.handleSort('bettyCoins')">
          {t("sfl.betty.col.bettyCoins")} <span class="sort-icon opacity-0 group-hover:opacity-50 transition-opacity" data-col="bettyCoins">↕</span>
        </div>
        <div class="text-xs font-mono text-terminal-muted uppercase tracking-wider font-semibold cursor-pointer group flex items-center gap-2 justify-end" onclick="window.handleSort('p2pPrice')">
          {t("sfl.betty.col.p2pPrice")} <span class="sort-icon opacity-0 group-hover:opacity-50 transition-opacity" data-col="p2pPrice">↕</span>
        </div>
        <div class="text-xs font-mono text-terminal-muted uppercase tracking-wider font-semibold cursor-pointer group flex items-center gap-2 justify-end" onclick="window.handleSort('coinsPerFlower')">
          {t("sfl.betty.col.coinsPerFlower")} <span class="sort-icon opacity-100 text-emerald-500 transition-opacity" data-col="coinsPerFlower">↓</span>
        </div>
        <div class="text-xs font-mono text-terminal-muted uppercase tracking-wider font-semibold cursor-pointer group flex items-center gap-2 justify-end" onclick="window.handleSort('profit')">
          {t("sfl.betty.col.best")} <span class="sort-icon opacity-0 group-hover:opacity-50 transition-opacity" data-col="profit">↕</span>
        </div>
      </div>

      <!-- Body Tabla -->
      <div id="tableBody" class="flex flex-col gap-4 lg:gap-0 relative z-10">
        <!-- JS inyectará filas aquí -->
      </div>
    </div>
  </div>
</SflToolLayout>

<style is:global>
  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .no-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>

<script define:vars={{ bettyPrices, sflIds, tEmpty: t("sfl.betty.empty"), tBestBetty: t("sfl.betty.best.betty"), tBestP2p: t("sfl.betty.best.p2p"), tBettyCoins: t("sfl.betty.col.bettyCoins"), tP2pPrice: t("sfl.betty.col.p2pPrice"), tCoinsPerFlower: t("sfl.betty.col.coinsPerFlower"), tCalcNoData: t("sfl.betty.calculator.noData") }}>


  let marketData = {}
  window.currentSort = { column: "coinsPerFlower", direction: "desc" }
  let currentCategory = "all"
  
  let manualSelectedItem = null;
  let isDropdownOpen = false;
  let allItemsData = [];
  let isDropdownInitialized = false;

  const getSearchVal = () => {
    const el = document.getElementById("searchInput");
    return el ? el.value : "";
  }

  window.handleCategory = (category) => {
    currentCategory = category

    document.querySelectorAll(".category-btn").forEach((btn) => {
      if (btn.dataset.category === category) {
        btn.className = "category-btn active flex-1 flex justify-center px-2 sm:px-4 py-2 bg-emerald-500/20 text-emerald-400 border border-emerald-500/30 rounded-xl text-[10px] sm:text-xs font-bold uppercase tracking-wider hover:bg-emerald-500/30 transition-colors whitespace-nowrap shrink-0"
      } else {
        btn.className = "category-btn flex-1 flex justify-center px-2 sm:px-4 py-2 bg-white/5 text-white/40 border border-white/10 rounded-xl text-[10px] sm:text-xs font-bold uppercase tracking-wider hover:bg-white/10 hover:text-white transition-colors whitespace-nowrap shrink-0"
      }
    })

    renderTable(getSearchVal())
  }

  window.handleSort = (column) => {
    if (window.currentSort.column === column) {
      if (window.currentSort.direction === "none") window.currentSort.direction = "desc"
      else if (window.currentSort.direction === "desc") window.currentSort.direction = "asc"
      else window.currentSort.direction = "none"
    } else {
      window.currentSort.column = column
      window.currentSort.direction = "desc"
    }

    document.querySelectorAll(".sort-icon").forEach((icon) => {
      icon.innerHTML = "↕"
      icon.classList.remove("opacity-100", "text-emerald-500")
      icon.classList.add("opacity-0", "group-hover:opacity-50")
    })

    if (window.currentSort.direction !== "none") {
      const activeIcon = document.querySelector(`.sort-icon[data-col="${column}"]`)
      if (activeIcon) {
        activeIcon.innerHTML = window.currentSort.direction === "desc" ? "↓" : "↑"
        activeIcon.classList.remove("opacity-0", "group-hover:opacity-50")
        activeIcon.classList.add("opacity-100", "text-emerald-500")
      }
    }

    renderTable(getSearchVal())
  }

  const formatNumber = (num, decimals = 2) => {
    if (num === undefined || num === null || isNaN(num)) return "0"
    if (num > 0 && num < 0.0001) return num.toExponential(2)
    return new Intl.NumberFormat("en-US", {
      minimumFractionDigits: 0,
      maximumFractionDigits: decimals,
    }).format(num)
  }

  const updateCalculatorUI = (item) => {
    const selectedContent = document.getElementById("selectedItemContent")
    const flowerInput = document.getElementById("flowerInput")
    const itemsInput = document.getElementById("itemsInput")
    const itemsOutputImg = document.getElementById("itemsOutputImg")
    const coinsInput = document.getElementById("coinsInput")
    
    if (item && selectedContent) {
      const coinsForOneFlower = formatNumber(item.coinsPerFlower, 0)
      
      selectedContent.innerHTML = `
        <div class="flex flex-1 items-center gap-2">
          <img src="/img/sunflowerland/${item.name}.png" class="w-7 h-7 object-contain" onerror="this.src='/img/sunflowerland/123/empty.png'" />
          <div class="flex flex-col">
            <span class="text-xs font-bold text-white leading-tight">${item.name}</span>
            ${item.profit > 0 ? `<span class="text-[9px] text-emerald-400 font-mono">+${formatNumber(item.profit, 0)}%</span>` : `<span class="text-[9px] text-red-400 font-mono">${formatNumber(item.profit, 0)}%</span>`}
          </div>
        </div>
        <div class="flex flex-col items-end text-[9px] font-mono text-white/40 shrink-0">
          <span>1 <img src="/img/sunflowerland/flower.jpg" class="w-2.5 h-2.5 inline rounded-full grayscale opacity-70" /> = ${coinsForOneFlower} Coins</span>
        </div>
      `
      
      if (itemsOutputImg) {
        itemsOutputImg.src = `/img/sunflowerland/${item.name}.png`
        itemsOutputImg.onerror = () => { itemsOutputImg.src = '/img/sunflowerland/123/empty.png' }
      }

      if (flowerInput && itemsInput && coinsInput) {
        const updateFromFlower = () => {
          if (flowerInput.value === "") {
            itemsInput.value = ""
            coinsInput.value = ""
            return
          }
          const flowerVal = parseFloat(flowerInput.value) || 0
          const itemsVal = item.p2pPrice > 0 ? Math.floor(flowerVal / item.p2pPrice) : 0
          itemsInput.value = itemsVal.toString()
          coinsInput.value = (itemsVal * item.bettyCoins).toFixed(0)
        }
        
        const updateFromItems = () => {
          if (itemsInput.value === "") {
            flowerInput.value = ""
            coinsInput.value = ""
            return
          }
          const itemsVal = Math.round(parseFloat(itemsInput.value) || 0)
          const fv = itemsVal * item.p2pPrice
          flowerInput.value = fv === 0 ? "0" : parseFloat(fv.toFixed(3)).toString()
          coinsInput.value = (itemsVal * item.bettyCoins).toFixed(0)
        }
        
        const updateFromCoins = () => {
          if (coinsInput.value === "") {
            itemsInput.value = ""
            flowerInput.value = ""
            return
          }
          const coinsVal = parseFloat(coinsInput.value) || 0
          const itemsVal = Math.round(coinsVal / item.bettyCoins)
          itemsInput.value = itemsVal.toString()
          const fv = itemsVal * item.p2pPrice
          flowerInput.value = fv === 0 ? "0" : parseFloat(fv.toFixed(3)).toString()
        }
        
        flowerInput.oninput = updateFromFlower
        itemsInput.oninput = updateFromItems
        coinsInput.oninput = updateFromCoins
        
        updateFromFlower()
      }
    } else if (selectedContent) {
      selectedContent.innerHTML = `<span class="text-xs text-terminal-muted">${tCalcNoData}</span>`
      if (coinsInput) coinsInput.value = "0"
      if (itemsInput) itemsInput.value = "0"
    }
  }

  const toggleDropdown = (show) => {
     const dropdown = document.getElementById("itemDropdown")
     if (!dropdown) return
     if (show === undefined) {
         isDropdownOpen = !isDropdownOpen
     } else {
         isDropdownOpen = show
     }
     
     if (isDropdownOpen) {
         dropdown.classList.remove("hidden")
     } else {
         dropdown.classList.add("hidden")
     }
  }

  const renderDropdownItems = () => {
     const dropdown = document.getElementById("itemDropdown")
     if (!dropdown) return
     
     const sortedItems = [...allItemsData].sort((a,b) => a.name.localeCompare(b.name))
     
     dropdown.innerHTML = sortedItems.map(item => `
        <button class="dropdown-item w-full flex items-center justify-between p-2 hover:bg-white/5 rounded-md transition-colors text-left" data-name="${item.name}">
           <div class="flex items-center gap-2">
             <img src="/img/sunflowerland/${item.name}.png" class="w-5 h-5 object-contain" onerror="this.src='/img/sunflowerland/123/empty.png'" loading="lazy" />
             <span class="text-xs font-medium text-white">${item.name}</span>
           </div>
           ${item.profit > 0 ? `<span class="text-[10px] text-emerald-400 font-mono">+${formatNumber(item.profit, 0)}%</span>` : `<span class="text-[10px] text-red-400/50 font-mono">${formatNumber(item.profit, 0)}%</span>`}
        </button>
     `).join('')
     
     dropdown.querySelectorAll('.dropdown-item').forEach(btn => {
        btn.addEventListener('click', (e) => {
           const itemName = e.currentTarget.dataset.name
           manualSelectedItem = allItemsData.find(i => i.name === itemName)
           updateCalculatorUI(manualSelectedItem)
           toggleDropdown(false)
        })
     })
  }

  const initDropdown = () => {
    if (isDropdownInitialized) return;
    isDropdownInitialized = true;

    const btn = document.getElementById("itemSelectorBtn")
    const resetBtn = document.getElementById("resetBestBtn")
    
    if (btn) {
      btn.addEventListener("click", () => toggleDropdown())
    }
    
    if (resetBtn) {
      resetBtn.addEventListener("click", () => {
         manualSelectedItem = null
         const bestItem = [...allItemsData].sort((a, b) => b.profit - a.profit)[0]
         updateCalculatorUI(bestItem)
      })
    }
    
    document.addEventListener("click", (e) => {
       const dropdown = document.getElementById("itemDropdown")
       if (isDropdownOpen && btn && dropdown && !btn.contains(e.target) && !dropdown.contains(e.target)) {
          toggleDropdown(false)
       }
    })
  }

  window.renderTable = (searchTerm = "") => {
    let items = []
    
    // Preparar lista de items con cálculos
    Object.keys(bettyPrices).forEach(name => {
      const itemConfig = bettyPrices[name]
      const itemId = Object.keys(sflIds).find(key => sflIds[key] === name)
      const internalKey = `collectibles-${itemId}`
      const marketItem = marketData[internalKey]
      
      const bettyPriceCoins = itemConfig.sellPrice
      const p2pPriceFlower = marketItem ? marketItem.currentPrice : 0
      
      let coinsPerFlower = 0
      let profitVsDirect = 0
      
      if (p2pPriceFlower > 0) {
        coinsPerFlower = bettyPriceCoins / p2pPriceFlower
        profitVsDirect = ((coinsPerFlower / 320) - 1) * 100
      }
      
      items.push({
        name,
        category: itemConfig.category,
        bettyCoins: bettyPriceCoins,
        p2pPrice: p2pPriceFlower,
        coinsPerFlower,
        profit: profitVsDirect
      })
    })

    allItemsData = items

    const bestItem = [...items].sort((a, b) => b.profit - a.profit)[0]
    const displayItem = manualSelectedItem || bestItem
    
    updateCalculatorUI(displayItem)
    renderDropdownItems()
    
    // Filtrar
    let filtered = items.filter((item) => {
      const matchesSearch = item.name.toLowerCase().includes(searchTerm.toLowerCase())
      const matchesCategory = currentCategory === "all" || item.category === currentCategory
      return matchesSearch && matchesCategory
    })

    // Ordenar
    if (window.currentSort && window.currentSort.column && window.currentSort.direction !== "none") {
      const { column, direction } = window.currentSort
      filtered.sort((a, b) => {
        let valA = a[column]
        let valB = b[column]
        
        if (column === "name" || column === "category") {
          valA = valA.toLowerCase()
          valB = valB.toLowerCase()
        }

        if (valA < valB) return direction === "asc" ? -1 : 1
        if (valA > valB) return direction === "asc" ? 1 : -1
        return 0
      })
    }

    const tableBody = document.getElementById("tableBody")
    if (!tableBody) return;
    
    tableBody.innerHTML = ""

    if (filtered.length === 0) {
      tableBody.innerHTML = `<div class="py-8 text-center text-terminal-muted text-sm">${tEmpty}</div>`
      return
    }

    filtered.forEach((item) => {
      const imgPath = `/img/sunflowerland/${item.name}.png`
      
      // Colores de profit
      let profitColorClass = "text-terminal-muted"
      let profitBgClass = "bg-white/5 border-white/10"
      let isBettyBetter = item.coinsPerFlower > 320
      
      if (item.p2pPrice > 0) {
        if (isBettyBetter) {
          profitColorClass = "text-emerald-400"
          profitBgClass = "bg-emerald-500/10 border-emerald-500/20"
        } else {
          profitColorClass = "text-red-400"
          profitBgClass = "bg-red-500/10 border-red-500/20"
        }
      }

      const row = document.createElement("div")
      row.className = "hover:bg-white/[0.02] transition-colors group block border border-white/5 bg-white/[0.02] rounded-[20px] p-5 lg:p-0 lg:border-0 lg:border-b lg:border-white/5 last:lg:border-b-0 lg:bg-transparent lg:rounded-none lg:grid lg:grid-cols-[22%_15%_15%_15%_15%_18%] lg:items-center lg:py-3 lg:px-6"

      row.innerHTML = `
        <!-- Name -->
        <div class="flex items-center gap-3 mb-4 lg:mb-0">
          <div class="w-10 h-10 lg:w-8 lg:h-8 rounded-lg bg-black/40 border border-white/5 flex items-center justify-center p-1.5 shrink-0">
            <img src="${imgPath}" alt="${item.name}" class="w-full h-full object-contain drop-shadow-sm" onerror="this.src='/img/sunflowerland/123/empty.png'" loading="lazy" />
          </div>
          <div>
            <p class="text-sm font-semibold text-white group-hover:text-emerald-300 transition-colors">${item.name}</p>
          </div>
        </div>

        <!-- Category -->
        <div class="hidden lg:block">
          <span class="px-2 py-0.5 rounded text-[10px] uppercase tracking-wider font-semibold bg-white/5 text-white/60 border border-white/10">${item.category}</span>
        </div>

        <!-- Betty Coins -->
        <div class="flex justify-between lg:justify-end items-center mb-2 lg:mb-0">
          <span class="text-xs text-terminal-muted lg:hidden">${tBettyCoins}</span>
          <div class="flex items-center gap-1.5">
            <span class="text-sm font-bold text-yellow-400">${formatNumber(item.bettyCoins)}</span>
            <img src="/img/sunflowerland/123/coins.png" class="w-3.5 h-3.5" alt="Coins" />
          </div>
        </div>

        <!-- P2P Price -->
        <div class="flex justify-between lg:justify-end items-center mb-2 lg:mb-0">
          <span class="text-xs text-terminal-muted lg:hidden">${tP2pPrice}</span>
          <div class="flex items-center gap-1.5">
            <span class="text-sm font-sans font-medium ${item.p2pPrice > 0 ? 'text-white/90' : 'text-white/30'}">${item.p2pPrice > 0 ? formatNumber(item.p2pPrice, 4) : 'N/A'}</span>
            <img src="/img/sunflowerland/flower.jpg" class="w-3.5 h-3.5 rounded-full ${item.p2pPrice > 0 ? '' : 'opacity-30'}" alt="FLOWER" />
          </div>
        </div>

        <!-- Coins / FLOWER -->
        <div class="flex justify-between lg:justify-end items-center mb-4 lg:mb-0">
          <span class="text-xs text-terminal-muted lg:hidden">${tCoinsPerFlower}</span>
          <div class="flex items-center gap-1.5">
            <span class="text-sm font-bold ${profitColorClass}">${item.p2pPrice > 0 ? formatNumber(item.coinsPerFlower, 0) : 'N/A'}</span>
            <span class="text-[10px] text-white/30">/</span>
            <img src="/img/sunflowerland/flower.jpg" class="w-3.5 h-3.5 rounded-full ${item.p2pPrice > 0 ? '' : 'opacity-30'}" alt="FLOWER" />
          </div>
        </div>

        <!-- Best Option & Profit -->
        <div class="flex justify-between lg:justify-end items-center pt-4 lg:pt-0 border-t border-white/5 lg:border-none">
          <div class="flex items-center gap-2">
            ${item.p2pPrice > 0 ? `
              <div class="px-2 py-1 rounded-lg border ${profitBgClass} flex items-center gap-1">
                <span class="text-xs font-bold ${profitColorClass}">${isBettyBetter ? tBestBetty : tBestP2p}</span>
              </div>
              <span class="text-xs font-mono ${item.profit > 0 ? 'text-emerald-400' : 'text-red-400'}">${item.profit > 0 ? '+' : ''}${formatNumber(item.profit, 0)}%</span>
            ` : `<span class="text-xs text-terminal-muted">No P2P data</span>`}
          </div>
        </div>
      `
      tableBody.appendChild(row)
    })
  }

  const setupSearchListener = () => {
    const searchInputEl = document.getElementById("searchInput")
    if (searchInputEl && !searchInputEl.dataset.listenerAttached) {
      searchInputEl.addEventListener("input", (e) => {
        renderTable(e.target.value)
      })
      searchInputEl.dataset.listenerAttached = "true"
    }
  }

  const fetchMarketData = async (isManual = false) => {
    const fetchBtn = document.getElementById("fetchBtn")
    const refreshIcon = document.getElementById("fetchBtnRefreshIcon")
    const checkIcon = document.getElementById("fetchBtnCheckIcon")
    const fetchBtnText = document.getElementById("fetchBtnText")

    if (isManual && fetchBtn && refreshIcon && fetchBtnText) {
      refreshIcon.classList.add("animate-spin")
      fetchBtnText.innerText = "Cargando..."
      fetchBtn.disabled = true
      fetchBtn.classList.remove("hover:bg-emerald-500/20")
      fetchBtn.classList.add("opacity-50", "cursor-not-allowed", "bg-emerald-500/20")
    }

    try {
      const res = await fetch("/api/sfl_data.json?t=" + new Date().getTime())
      if (!res.ok) throw new Error("API error")
      const json = await res.json()
      marketData = json.items || {}
      
      const loadingState = document.getElementById("loadingState")
      const dataContainer = document.getElementById("dataContainer")
      if (loadingState) loadingState.classList.add("hidden")
      if (dataContainer) dataContainer.classList.remove("hidden")
      
      initDropdown()
      renderTable(getSearchVal())

      if (isManual && fetchBtn && refreshIcon && checkIcon && fetchBtnText) {
        refreshIcon.classList.remove("animate-spin")
        refreshIcon.classList.add("hidden")
        checkIcon.classList.remove("hidden")
        fetchBtnText.innerText = fetchBtnText.dataset.updatedText || "Actualizado"
        
        setTimeout(() => {
          checkIcon.classList.add("hidden")
          refreshIcon.classList.remove("hidden")
          fetchBtnText.innerText = fetchBtnText.dataset.originalText || "Refrescar"
          fetchBtn.disabled = false
          fetchBtn.classList.add("hover:bg-emerald-500/20")
          fetchBtn.classList.remove("opacity-50", "cursor-not-allowed", "bg-emerald-500/20")
        }, 60000)
      }
    } catch (e) {
      console.error(e)
      if(loadingState) loadingState.innerHTML = '<div class="text-red-400 text-sm">Error cargando datos del mercado.</div>'
      
      if (isManual && fetchBtn && refreshIcon && fetchBtnText) {
        refreshIcon.classList.remove("animate-spin")
        fetchBtnText.innerText = "Error"
        setTimeout(() => {
          fetchBtnText.innerText = fetchBtnText.dataset.originalText || "Refrescar"
          fetchBtn.disabled = false
          fetchBtn.classList.add("hover:bg-emerald-500/20")
          fetchBtn.classList.remove("opacity-50", "cursor-not-allowed", "bg-emerald-500/20")
        }, 60000)
      }
    }
  }

  const initApp = () => {
    setupSearchListener()
    fetchMarketData()
    const fetchBtn = document.getElementById("fetchBtn")
    if (fetchBtn && !fetchBtn.dataset.listenerAttached) {
      fetchBtn.addEventListener("click", () => fetchMarketData(true))
      fetchBtn.dataset.listenerAttached = "true"
    }
  }

  document.addEventListener("astro:page-load", initApp)
  if (document.readyState === "complete" || document.readyState === "interactive") {
    setTimeout(initApp, 1)
  } else {
    document.addEventListener("DOMContentLoaded", initApp)
  }
</script>
