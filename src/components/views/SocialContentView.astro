---
// ==========================================
// src/components/views/SocialContentView.astro
// View unificada para Contenido Social (X, YouTube, etc.)
// ==========================================

import { getLangFromUrl, useTranslations } from "../../i18n/utils"
import xFeed from "../../content/data/x_feed.json"
import youtubeFeed from "../../content/data/youtube_feed.json"
import FaqAccordion from "../FaqAccordion.astro"

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)

// Procesar y fusionar feeds
const xFeedWithPlatform = xFeed.map(item => ({ ...item, platform: "x" }))
const youtubeFeedWithPlatform = youtubeFeed.map(item => ({ ...item, platform: "youtube" }))

const socialFeed = [...xFeedWithPlatform, ...youtubeFeedWithPlatform]
  .filter(post => !post.draft)
  .filter(post => {
    if (lang === 'en') {
      // Solo mostrar si tiene título o descripción en inglés
      return (post.title_en && post.title_en.trim() !== "") || (post.description_en && post.description_en.trim() !== "")
    }
    return true
  })
  .sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime())

const X_ICON = `<path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 22.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>`
const YT_ICON = `<path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>`

const getIcon = (platform) => platform === 'youtube' ? YT_ICON : X_ICON

---

<main class="max-w-6xl mx-auto px-6 pt-12 pb-24 relative z-10">
  <!-- Gradiente decorativo superior sutil -->
  <div
    class="absolute top-0 left-1/2 -translate-x-1/2 w-[600px] h-[300px] bg-emerald-500/[0.03] blur-[130px] rounded-full pointer-events-none -z-10"
  >
  </div>

  <!-- Cabecera de la sección -->
  <header class="mb-16 md:mb-24">
    <span class="text-xs font-mono uppercase tracking-[0.4em] text-emerald-500 mb-3 block"
      >{t("social.badge.research")}</span
    >
    <h1 class="text-2xl md:text-4xl font-extrabold text-white tracking-tight leading-none mb-4">
      {t("social.title")}
    </h1>
    
    <p class="text-terminal-secondary max-w-2xl text-sm md:text-base mb-8 leading-relaxed font-light">
      {t("social.description")}
    </p>

    <div class="mb-10 flex flex-col md:flex-row gap-4 items-center w-full">
      <div class="relative flex-grow w-full">
        <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
          <svg class="w-5 h-5 text-terminal-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
        </div>
        <input 
          type="text" 
          id="social-search" 
          placeholder={t("social.search.placeholder")} 
          class="w-full bg-terminal-surface/30 border border-terminal-border/60 text-white text-sm rounded-xl focus:ring-emerald-500/50 focus:border-emerald-500 block pl-11 p-3.5 transition-all duration-300 placeholder-terminal-muted"
        />
      </div>
      <div class="flex items-center gap-2 self-start md:self-auto">
        <button type="button" class="platform-btn flex items-center justify-center w-12 h-12 rounded-xl bg-terminal-surface/30 border border-terminal-border/60 text-terminal-muted hover:text-white hover:border-emerald-500/50 transition-all duration-300" data-platform-filter="x" aria-label="Filter X">
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" set:html={X_ICON}></svg>
        </button>
        <button type="button" class="platform-btn flex items-center justify-center w-12 h-12 rounded-xl bg-terminal-surface/30 border border-terminal-border/60 text-terminal-muted hover:text-white hover:border-emerald-500/50 transition-all duration-300" data-platform-filter="youtube" aria-label="Filter YouTube">
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" set:html={YT_ICON}></svg>
        </button>
        <button type="button" id="clear-filters" class="flex items-center justify-center w-12 h-12 rounded-xl bg-terminal-surface/30 border border-terminal-border/60 text-terminal-muted hover:text-red-400 hover:border-red-400/50 transition-all duration-300 ml-2" aria-label="Clear filters">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
        </button>
      </div>
    </div>
  </header>

  <section class="mb-24">
    <div id="social-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
      {socialFeed.map((post) => (
        <a
          href={post.platform === 'youtube' ? `https://youtube.com/watch?v=${post.videoId}` : `https://x.com/i/status/${post.tweetId}`}
          target="_blank"
          rel="noopener noreferrer nofollow"
          data-title={(lang === 'en' && post.title_en ? post.title_en : post.title).toLowerCase()}
          data-desc={(lang === 'en' && post.description_en ? post.description_en : post.description).toLowerCase()}
          data-hidden={(lang === 'en' && post.hidden_text_en ? post.hidden_text_en : (post.hidden_text || "")).toLowerCase()}
          data-platform={post.platform}
          class="social-card bg-terminal-surface/20 border border-terminal-border p-6 rounded-2xl flex flex-col gap-4 group no-underline relative overflow-hidden hover:border-emerald-500/30 hover:bg-terminal-surface/30 transition-all duration-500 shadow-lg hover:shadow-emerald-500/5"
        >
          {/* Resplandor superior sutil */}
          <div class="absolute top-0 left-0 w-full h-1 bg-gradient-to-r from-transparent via-emerald-500/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>

          {/* Efecto de luz y Logo decorativo */}
          <div class="absolute -bottom-6 -right-6 w-32 h-32 bg-emerald-500/[0.015] rounded-full blur-2xl group-hover:bg-emerald-500/[0.04] transition-all duration-700"></div>
          <svg class="absolute -bottom-2 -right-2 w-24 h-24 text-white/[0.02] group-hover:text-emerald-500/[0.05] group-hover:scale-110 group-hover:-rotate-3 transition-all duration-700" viewBox="0 0 24 24" fill="currentColor" set:html={getIcon(post.platform)} />

          <div class="relative z-10 flex flex-col flex-grow">
            {((post.platform === 'youtube' && post.videoId) || (post.platform === 'x' && (post.imageUrl || post.media))) && (
              <div class="mb-4 rounded-xl overflow-hidden aspect-video border border-terminal-border/50 bg-terminal-surface/50 relative">
                <img 
                  src={post.platform === 'youtube' 
                    ? `https://img.youtube.com/vi/${post.videoId}/hqdefault.jpg` 
                    : (post.imageUrl || post.media)} 
                  alt={lang === 'en' && post.title_en ? post.title_en : post.title} 
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" 
                  loading="lazy" 
                />
                {post.format === 'video' && (
                  <div class="absolute inset-0 flex items-center justify-center">
                    <div class="w-14 h-14 rounded-full bg-black/60 backdrop-blur-sm flex items-center justify-center border border-white/20 group-hover:bg-emerald-500/80 group-hover:scale-110 transition-all duration-300">
                      <svg class="w-6 h-6 text-white ml-1" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
                    </div>
                  </div>
                )}
                <div class="absolute inset-0 bg-black/10 group-hover:bg-transparent transition-colors duration-500"></div>
              </div>
            )}
            
            <div class="flex items-start justify-between mb-4">
              <h3 class="text-white text-lg font-bold leading-snug group-hover:text-emerald-400 transition-colors line-clamp-2 pr-4">
                {lang === 'en' && post.title_en ? post.title_en : post.title}
              </h3>
              {/* Pequeño icono indicador */}
              <div class="flex-shrink-0 mt-1 text-terminal-border-subtle group-hover:text-emerald-400/40 transition-colors">
                <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24" set:html={getIcon(post.platform)} />
              </div>
            </div>
            
            <p class="text-terminal-secondary text-sm leading-relaxed flex-grow line-clamp-3 font-light mb-4">
              {lang === 'en' && post.description_en ? post.description_en : post.description}
            </p>

          </div>

          <div class="pt-4 mt-auto border-t border-terminal-border/40 relative z-10 flex items-center justify-between">
            <div class="flex items-center gap-2">
              {post.format && (
                <span class="px-2 py-0.5 rounded-md bg-terminal-surface/60 border border-terminal-border text-[9px] font-mono uppercase tracking-wider text-terminal-muted">
                  {lang === 'en' ? t(`social.format.${post.format}` as any) || post.format : post.format}
                </span>
              )}
              {post.length && (
                <span class="px-2 py-0.5 rounded-md bg-terminal-surface/60 border border-terminal-border text-[9px] font-mono uppercase tracking-wider text-emerald-500/80">
                  {lang === 'en' ? t(`social.length.${post.length}` as any) || post.length : post.length}
                </span>
              )}
            </div>
            <span class="text-emerald-500 text-[10px] font-mono font-bold uppercase tracking-widest group-hover:text-emerald-400 flex items-center gap-2 transition-all">
              {t("social.card.view")} 
              <span class="w-5 h-5 rounded-full bg-emerald-500/10 flex items-center justify-center group-hover:bg-emerald-500/20 group-hover:translate-x-1 transition-all">
                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
              </span>
            </span>
          </div>
        </a>
      ))}
      <div id="no-results" class="hidden col-span-full text-center py-24 text-terminal-muted">
        <svg class="w-12 h-12 mx-auto mb-4 opacity-20" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
        <p>{t("social.no_results")}</p>
      </div>
    </div>
    {/* Sentinel para Infinite Scroll */}
    <div id="scroll-sentinel" class="h-10 w-full mt-4"></div>
  </section>

  <section class="mt-24 border-t border-terminal-border/30 pt-16">
    <FaqAccordion 
      titulo={t("social.faq.heading")}
      subtitulo={t("social.faq.subheading")}
      items={[
        {
          pregunta: t("social.faq.q1"),
          respuesta: t("social.faq.a1")
        },
        {
          pregunta: t("social.faq.q2"),
          respuesta: t("social.faq.a2")
        },
        {
          pregunta: t("social.faq.q3"),
          respuesta: t("social.faq.a3")
        },
        {
          pregunta: t("social.faq.q4"),
          respuesta: t("social.faq.a4")
        },
        {
          pregunta: t("social.faq.q5"),
          respuesta: t("social.faq.a5")
        }
      ]}
    />
  </section>
</main>

<script>
  const setupSocialSearch = () => {
    const searchInput = document.getElementById('social-search') as HTMLInputElement;
    const grid = document.getElementById('social-grid');
    const noResults = document.getElementById('no-results');
    const platformBtns = document.querySelectorAll('.platform-btn') as NodeListOf<HTMLButtonElement>;
    const clearBtn = document.getElementById('clear-filters');
    const sentinel = document.getElementById('scroll-sentinel');
    
    if (!searchInput || !grid || !noResults || !sentinel) return;

    const cards = Array.from(grid.querySelectorAll('.social-card')) as HTMLAnchorElement[];
    const originalOrder = [...cards];

    let debounceTimer: ReturnType<typeof setTimeout>;
    let currentPlatform: string | null = null;
    let currentLimit = 9;
    let activeMatches: HTMLAnchorElement[] = [...originalOrder];

    const stopWords = ['el', 'la', 'los', 'las', 'un', 'una', 'unos', 'unas', 'y', 'o', 'de', 'del', 'a', 'en', 'con', 'por', 'para', 'es', 'the', 'a', 'an', 'and', 'or', 'of', 'in', 'with', 'for', 'is'];

    const normalizeText = (text: string) => {
      return text.normalize("NFD").replace(/[\u0300-\u036f]/g, "").toLowerCase();
    };

    const renderCards = () => {
      // Ocultar todas primero
      originalOrder.forEach(c => c.style.display = 'none');
      
      if (activeMatches.length === 0) {
        noResults.classList.remove('hidden');
      } else {
        noResults.classList.add('hidden');
        
        // Mostrar hasta el límite actual
        const toShow = activeMatches.slice(0, currentLimit);
        toShow.forEach(card => {
          card.style.display = 'flex';
          grid.appendChild(card); // Re-adjuntar mantiene el orden de la lista 'toShow'
        });
      }
    };

    const applyFilters = () => {
      const rawTerm = normalizeText(searchInput.value).trim();
      const tokens = rawTerm.split(/\s+/).filter(word => word.length > 0 && !stopWords.includes(word));

      // Actualizar estado visual de los botones
      platformBtns.forEach(btn => {
        if (btn.dataset.platformFilter === currentPlatform) {
          btn.classList.add('bg-emerald-500/20', 'border-emerald-500', 'text-emerald-400');
          btn.classList.remove('bg-terminal-surface/30', 'border-terminal-border/60', 'text-terminal-muted');
        } else {
          btn.classList.remove('bg-emerald-500/20', 'border-emerald-500', 'text-emerald-400');
          btn.classList.add('bg-terminal-surface/30', 'border-terminal-border/60', 'text-terminal-muted');
        }
      });

      if (tokens.length === 0 && !currentPlatform) {
        // Sin filtros, restauramos la lista original
        activeMatches = [...originalOrder];
      } else {
        const scoredCards = cards.map(card => {
          const title = normalizeText(card.dataset.title || "");
          const desc = normalizeText(card.dataset.desc || "");
          const hidden = normalizeText(card.dataset.hidden || "");
          const platform = card.dataset.platform || "";
          
          let totalScore = 0;
          let matchedAllTokens = true;

          if (currentPlatform && platform !== currentPlatform) {
            matchedAllTokens = false;
          }

          if (matchedAllTokens && tokens.length > 0) {
            for (const token of tokens) {
              let tokenScore = 0;
              if (title.includes(token)) tokenScore = 3;
              else if (desc.includes(token)) tokenScore = 2;
              else if (hidden.includes(token)) tokenScore = 1;

              if (tokenScore === 0) {
                matchedAllTokens = false;
                break;
              }
              totalScore += tokenScore;
            }
          } else if (matchedAllTokens && tokens.length === 0) {
            totalScore = 1;
          }
          
          return { card, score: matchedAllTokens ? totalScore : 0 };
        });

        // Filtrar solo los que hicieron match
        const matches = scoredCards.filter(sc => sc.score > 0);
        
        // Ordenar
        if (tokens.length > 0) {
          matches.sort((a, b) => b.score - a.score);
        } else {
          matches.sort((a, b) => originalOrder.indexOf(a.card) - originalOrder.indexOf(b.card));
        }

        activeMatches = matches.map(m => m.card);
      }

      // Al buscar/filtrar siempre volvemos a la primera página de resultados
      currentLimit = 9;
      renderCards();
    };

    // Infinite Scroll con Intersection Observer
    const observer = new IntersectionObserver((entries) => {
      if (entries[0].isIntersecting && currentLimit < activeMatches.length) {
        currentLimit += 9;
        renderCards();
      }
    }, { rootMargin: '100px' });
    
    observer.observe(sentinel);

    // Inicializar render
    renderCards();

    searchInput.addEventListener('input', () => {
      clearTimeout(debounceTimer);
      debounceTimer = setTimeout(applyFilters, 250);
    });

    platformBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const platform = btn.dataset.platformFilter;
        currentPlatform = currentPlatform === platform ? null : (platform || null);
        applyFilters();
      });
    });

    if (clearBtn) {
      clearBtn.addEventListener('click', () => {
        searchInput.value = '';
        currentPlatform = null;
        applyFilters();
      });
    }
  };

  const setupVideoAutoplay = () => {
    const videos = document.querySelectorAll('.social-video') as NodeListOf<HTMLVideoElement>;
    
    if (!videos.length) return;

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        const video = entry.target as HTMLVideoElement;
        if (entry.isIntersecting) {
          video.play().catch(() => {});
        } else {
          video.pause();
        }
      });
    }, { threshold: 0.5 });

    videos.forEach(video => observer.observe(video));
  };

  setupSocialSearch();
  setupVideoAutoplay();
  document.addEventListener('astro:page-load', () => {
    setupSocialSearch();
    setupVideoAutoplay();
  });
</script>
