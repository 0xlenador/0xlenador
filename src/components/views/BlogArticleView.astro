---
// ==========================================
// src/components/views/BlogArticleView.astro
// View puro para la página de detalle de artículo
// ==========================================

import { render } from "astro:content"
import ArticleHeader from "../blog/ArticleHeader.astro"
import ShareButtons from "../blog/ShareButtons.astro"
import TableOfContents from "../blog/TableOfContents.astro"
import RelatedArticles from "../blog/RelatedArticles.astro"
import { Icon } from "astro-icon/components"
import { getLangFromUrl, useTranslations, formatDate } from "../../i18n/utils"

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)

const { post, prevPost, nextPost } = Astro.props
const { title, description, keywords, date, category, coverImage, coverAlt } = post.data
const { Content, headings } = await render(post)
const readTime = post.data.readTime || "5 min"

// 3. Agrupar headings: cada H2 contiene sus H3 hijos
type Heading = (typeof headings)[0]
type TocGroup = { heading: Heading; children: Heading[] }

const tocHeadings = headings.filter((h) => h.depth === 2 || h.depth === 3)
const groupedToc: TocGroup[] = []
for (const h of tocHeadings) {
  if (h.depth === 2) {
    groupedToc.push({ heading: h, children: [] })
  } else if (h.depth === 3 && groupedToc.length > 0) {
    groupedToc[groupedToc.length - 1].children.push(h)
  }
}

// 4. Formatear fecha al estilo: Apr 22, 2026 (EN) o 22 abr. 2026 (ES)
const formattedDate = formatDate(date, lang)
// coverImage es ImageMetadata cuando viene de image() — extraemos .src para la OG tag
const ogImage = coverImage?.src
---

<!-- Barra de progreso de lectura (estilos en main.css → #reading-progress) -->
<div
  id="reading-progress"
  role="progressbar"
  aria-label="Progreso de lectura"
  aria-valuenow={0}
  aria-valuemin={0}
  aria-valuemax={100}
>
</div>

<main class="max-w-7xl mx-auto px-6 relative z-10 flex flex-col lg:flex-row gap-16">
  <!-- ─── COLUMNA PRINCIPAL: ARTÍCULO ─── -->
  <article class="w-full lg:w-[68%]">
    <!-- Breadcrumb + título + meta + imagen de portada -->
    <ArticleHeader
      title={title}
      category={category}
      formattedDate={formattedDate}
      readTime={readTime}
      coverImage={coverImage}
      coverAlt={coverAlt}
    />

    <!-- Cuerpo del artículo renderizado desde Markdown -->
    <div class="content relative text-left md:text-justify" id="article-content">
      <Content />
    </div>

    <!-- Pie del artículo: autor -->
    <footer
      class="mt-20 pt-8 border-t border-terminal-border/60 flex flex-col sm:flex-row items-center justify-between gap-6"
    >
      <div class="flex items-center gap-4">
        <div
          class="w-12 h-12 rounded-full bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-center"
        >
          <span class="font-bold text-emerald-400 font-mono">0x</span>
        </div>
        <div>
          <p class="text-white font-bold text-sm">
            {t("blog.article.writtenBy")}{" "}
            <a href={lang === "en" ? "/en/author/" : "/autor/"} class="hover:text-emerald-400 hover:underline transition-colors decoration-emerald-400/30 underline-offset-4">
              0x Leñador
            </a>
          </p>
          <p class="text-terminal-muted text-xs">{t("blog.article.role")}</p>
        </div>
      </div>
    </footer>

    <!-- Navegación Post a Post -->
    {(prevPost || nextPost) && (
      <div class="mt-12 flex flex-col sm:flex-row items-stretch justify-between gap-4">
        {prevPost ? (
          <a href={lang === "en" ? `/en/blog/${prevPost.slug}/` : `/blog/${prevPost.slug}/`} class="flex-1 group">
            <div class="h-full px-6 py-4 rounded-xl border border-terminal-border/50 bg-terminal-surface/10 hover:bg-terminal-surface/30 hover:border-emerald-500/30 transition-all flex flex-col">
              <span class="text-xs font-mono uppercase tracking-wider text-terminal-muted group-hover:text-emerald-400 mb-1 transition-colors">← {lang === "en" ? "Previous" : "Anterior"}</span>
              <span class="text-sm font-bold text-white group-hover:text-emerald-300 transition-colors line-clamp-1">{prevPost.data.title}</span>
            </div>
          </a>
        ) : <div class="flex-1"></div>}
        
        {nextPost ? (
          <a href={lang === "en" ? `/en/blog/${nextPost.slug}/` : `/blog/${nextPost.slug}/`} class="flex-1 group text-right">
            <div class="h-full px-6 py-4 rounded-xl border border-terminal-border/50 bg-terminal-surface/10 hover:bg-terminal-surface/30 hover:border-emerald-500/30 transition-all flex flex-col">
              <span class="text-xs font-mono uppercase tracking-wider text-terminal-muted group-hover:text-emerald-400 mb-1 transition-colors">{lang === "en" ? "Next" : "Siguiente"} →</span>
              <span class="text-sm font-bold text-white group-hover:text-emerald-300 transition-colors line-clamp-1">{nextPost.data.title}</span>
            </div>
          </a>
        ) : <div class="flex-1"></div>}
      </div>
    )}

    <!-- Artículos Relacionados -->
    <RelatedArticles post={post} lang={lang} t={t} />
  </article>

  <!-- ─── COLUMNA LATERAL: SIDEBAR ─── -->
  <aside class="w-full lg:w-[32%] mt-12 lg:mt-0">
    <div
      id="sidebar-scroll-container"
      class="sticky top-32 space-y-10 max-h-[calc(100vh-8rem)] overflow-y-auto pb-8 pr-2 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
    >
      <!-- Botones de compartir -->
      <ShareButtons title={title} />

      <!-- Tabla de contenidos (incluye drawer móvil y botón flotante) -->
      <TableOfContents groupedToc={groupedToc} />
    </div>
  </aside>

  <!-- Gradiente decorativo de fondo -->
  <div
    class="fixed top-0 left-1/2 -translate-x-1/2 w-[800px] h-[400px] bg-emerald-500/5 blur-[120px] rounded-full pointer-events-none z-0"
  >
  </div>
</main>
