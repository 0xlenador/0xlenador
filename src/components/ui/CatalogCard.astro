---
export interface CatalogIngredient {
  name: string
  amount: number
  image?: string
}

export interface CatalogItem {
  id: string
  name: string
  description?: string
  image: string
  coins?: number
  stock?: number
  isPermanent?: boolean
  ingredients?: CatalogIngredient[]
  [key: string]: any
}

export interface CatalogSection {
  id: string
  name?: string
  showCount?: boolean
  items: CatalogItem[]
}

export interface CatalogTab {
  id: string
  name: string
  icon?: string
  type?: "craft" | "sell"
  isComingSoon?: boolean
  placeholderIcon?: string
  multipliers?: Array<number | "max">
  sections?: CatalogSection[]
}

export interface CatalogLabels {
  selectTitle?: string
  selectDesc?: string
  ingredients?: string
  reward?: string
  totalCost?: string
  totalReward?: string
  craftSimulation?: string
  sellSimulation?: string
  stockTitle?: string
  stockDesc?: string
  stockAvailable?: string
  permanent?: string
  unlimited?: string
  free?: string
  comingSoonTitle?: string
  comingSoonDesc?: string
  customUnits?: string
  customPlaceholder?: string
  agedXpLabel?: string
  primeAgedXpLabel?: string
  agingTimeLabel?: string
  catchesTitle?: string
}

interface Props {
  id: string
  title: string
  icon?: string
  iconStyle?: string
  badgeText?: string
  description?: string
  tabs?: CatalogTab[]
  currencyIcon?: string
  currencySymbol?: string
  secondaryCurrencyIcon?: string
  secondaryCurrencySymbol?: string
  hasSimulator?: boolean
  emptyMessage?: string
  labels?: CatalogLabels
  class?: string
}

const {
  id,
  title,
  icon,
  iconStyle = "",
  badgeText,
  description,
  tabs = [],
  currencyIcon = "/img/sunflowerland/flower.jpg",
  currencySymbol = "FLOWER",
  secondaryCurrencyIcon = "/img/sunflowerland/123/coins.png",
  secondaryCurrencySymbol = "Coins",
  hasSimulator = true,
  emptyMessage = "No hay ítems disponibles",
  labels = {},
  class: className = "",
} = Astro.props

const showTabBar = tabs.length > 1
const defaultLabels: CatalogLabels = {
  selectTitle: "Selecciona un ítem",
  selectDesc: "Haz clic en una ranura para ver sus materiales y costo.",
  ingredients: "MATERIALES REQUERIDOS",
  reward: "RECOMPENSA",
  totalCost: "Costo Total:",
  totalReward: "Recompensa Total:",
  craftSimulation: "Simulador de crafteo",
  sellSimulation: "Simulador de venta",
  stockTitle: "Límite de stock",
  stockDesc: "Límite máximo por jugador en el juego.",
  stockAvailable: "Disponible",
  permanent: "Permanente",
  unlimited: "Ilimitado",
  free: "Gratis",
  comingSoonTitle: "Próximamente",
  comingSoonDesc: "La sección de {tab} estará disponible próximamente.",
  customUnits: "uds",
  customPlaceholder: "Cantidad...",
  agedXpLabel: "XP Pez Envejecido:",
  primeAgedXpLabel: "XP Pez Prime Aged:",
  agingTimeLabel: "Tiempo de curado:",
  catchesTitle: "Peces que se pueden capturar:",
  ...labels,
}
---

<div
  class={`catalog-card bg-[#18181b]/95 border border-white/10 rounded-2xl shadow-xl backdrop-blur-md overflow-hidden flex flex-col ${className}`}
  data-catalog-id={id}
  data-labels={JSON.stringify(defaultLabels)}
  data-currency-icon={currencyIcon}
  data-currency-symbol={currencySymbol}
  data-secondary-icon={secondaryCurrencyIcon}
  data-secondary-symbol={secondaryCurrencySymbol}
>
  <!-- CABECERA -->
  <div class="p-3.5 sm:p-4 border-b border-white/10 bg-black/20">
    <div class="flex items-center justify-between mb-3">
      <div class="flex items-center gap-2.5">
        {
          icon && (
            <div class="w-10 h-10 sm:w-11 sm:h-11 rounded-xl bg-amber-500/10 border border-amber-500/30 flex items-center justify-center shrink-0 relative overflow-hidden">
              <img
                src={icon}
                alt={title}
                width="44"
                height="44"
                class="w-full h-full object-contain pointer-events-none [image-rendering:pixelated]"
                style={iconStyle}
                loading="lazy"
              />
            </div>
          )
        }
        <div>
          <h2 class="text-base sm:text-lg font-bold text-white tracking-tight flex items-center gap-2">
            <span>{title}</span>
            {
              badgeText && (
                <span class="text-[10px] font-mono px-2 py-0.5 rounded-full bg-emerald-500/10 text-emerald-400 border border-emerald-500/30 font-normal">
                  {badgeText}
                </span>
              )
            }
          </h2>
          {description && <p class="text-xs text-terminal-muted leading-tight">{description}</p>}
        </div>
      </div>
      <slot name="header-extra" />
    </div>

    <!-- PESTAÑAS (Si hay más de 1) -->
    {
      showTabBar && (
        <div class="flex items-center gap-1.5 bg-black/40 p-1 rounded-xl border border-white/5">
          {tabs.map((tab, idx) => (
            <button
              type="button"
              class={`catalog-tab-btn flex-1 py-1 px-2.5 rounded-lg text-xs font-mono font-bold transition-all cursor-pointer flex items-center justify-center gap-1.5 ${
                idx === 0
                  ? "bg-white/10 text-amber-400 border border-amber-500/30 shadow-sm"
                  : "text-white/50 hover:text-white/80 hover:bg-white/[0.04] border border-transparent"
              }`}
              data-target={`${id}-tab-${tab.id}`}
            >
              {tab.icon && <span>{tab.icon}</span>}
              <span>{tab.name}</span>
            </button>
          ))}
        </div>
      )
    }
  </div>

  <!-- SLOTS PARA CONTENIDO PERSONALIZADO (ej. Hen House, Barn, Pigpen) -->
  {
    Astro.slots.has("left") ? (
      <div class="p-3.5 sm:p-4 flex-1 flex flex-col justify-between">
        <div class="grid grid-cols-1 md:grid-cols-12 gap-3.5 items-stretch h-full">
          <div class="md:col-span-7 flex flex-col gap-2">
            <slot name="left" />
          </div>
          <div class="md:col-span-5 bg-black/40 border border-white/10 rounded-xl p-3 flex flex-col justify-between min-h-[320px]">
            <slot name="right" />
          </div>
        </div>
      </div>
    ) : (
      /* PANELES DE PESTAÑAS AUTÓNOMOS PARA TIENDAS / CATÁLOGOS */
      tabs.map((tab, idx) => (
        <div
          id={`${id}-tab-${tab.id}`}
          class={`catalog-tab-panel p-3.5 sm:p-4 ${idx !== 0 && showTabBar ? "hidden" : ""}`}
          data-tab-type={tab.type || "craft"}
        >
          {tab.isComingSoon ? (
            <div class="flex flex-col items-center justify-center py-8 text-center">
              <div class="w-12 h-12 rounded-xl bg-amber-500/10 border border-amber-500/30 flex items-center justify-center mb-3 text-2xl">
                {tab.icon || "⚡"}
              </div>
              <h3 class="text-base font-bold text-white mb-1">{defaultLabels.comingSoonTitle}</h3>
              <p class="text-xs text-terminal-muted max-w-sm">
                {defaultLabels.comingSoonDesc?.replace("{tab}", tab.name)}
              </p>
            </div>
          ) : (
            <div class="grid grid-cols-1 md:grid-cols-12 gap-3.5 sm:gap-4 items-stretch">
              <!-- COLUMNA IZQUIERDA: Grid de Slots -->
              <div class="md:col-span-8 flex flex-col gap-3">
                <slot name="before-sections" />
                {tab.sections && tab.sections.length > 0 ? (
                  tab.sections.map((sec) => (
                    <div class="flex flex-col gap-1.5">
                      <div class="flex items-center justify-between gap-1.5">
                        <span class="text-[10px] font-mono font-bold tracking-wider uppercase text-terminal-muted px-1.5 py-0.5 rounded bg-white/[0.03] border border-white/5">
                          {sec.name}
                        </span>
                        {sec.showCount && (
                          <span class="text-[10px] font-mono text-terminal-muted">
                            {sec.items?.length || 0} items
                          </span>
                        )}
                      </div>

                      <div class="grid grid-cols-6 sm:grid-cols-6 gap-1.5">
                        {sec.items && sec.items.length > 0 ? (
                          sec.items.map((item) => (
                            <button
                              type="button"
                              class="catalog-item-slot relative w-full rounded-xl bg-black/60 border-2 border-white/10 hover:border-white/30 hover:bg-white/[0.04] transition-all cursor-pointer flex flex-col items-center justify-between p-1 pt-0.5 pb-1 group select-none min-h-[62px] sm:min-h-[66px]"
                              data-item-data={JSON.stringify(item)}
                              title={item.name}
                              aria-label={item.name}
                            >
                              <div class="slot-corner-bracket absolute inset-0 rounded-xl pointer-events-none hidden">
                                <span class="absolute -top-0.5 -left-0.5 w-1.5 h-1.5 border-t-2 border-l-2 border-amber-400" />
                                <span class="absolute -top-0.5 -right-0.5 w-1.5 h-1.5 border-t-2 border-r-2 border-amber-400" />
                                <span class="absolute -bottom-0.5 -left-0.5 w-1.5 h-1.5 border-b-2 border-l-2 border-amber-400" />
                                <span class="absolute -bottom-0.5 -right-0.5 w-1.5 h-1.5 border-b-2 border-r-2 border-amber-400" />
                              </div>

                              {
                                item.yield && item.yield > 1 && (
                                  <span class="absolute top-1 right-1 text-[7.5px] font-mono font-bold px-1 py-0.5 rounded bg-amber-500/20 text-amber-300 border border-amber-500/30 leading-none pointer-events-none z-10">
                                    x{item.yield}
                                  </span>
                                )
                              }

                              <img
                                src={item.image}
                                alt={item.name}
                                width="24"
                                height="24"
                                class="w-6 h-6 object-contain drop-shadow-[0_2px_4px_rgba(0,0,0,0.8)] [image-rendering:pixelated] group-hover:scale-105 transition-transform my-1"
                                loading="lazy"
                              />

                              <div class="w-full flex items-center justify-center gap-0.5 leading-none px-0.5 overflow-hidden">
                                <img
                                  src={currencyIcon}
                                  class="w-2.5 h-2.5 rounded-full object-cover shrink-0"
                                  width="10"
                                  height="10"
                                  alt={currencySymbol}
                                />
                                <span
                                  class="catalog-unit-flower text-[8px] sm:text-[8.5px] font-mono font-bold text-emerald-400/90 leading-none tracking-tighter"
                                  data-coins={item.coins}
                                >
                                  {item.coins && item.coins > 0
                                    ? (item.coins / 320).toFixed(4)
                                    : (item.ingredients && item.ingredients.length > 0 ? "--" : "0")}
                                </span>
                              </div>
                            </button>
                          ))
                        ) : (
                          <div class="col-span-6 py-2 px-3 rounded-lg bg-white/[0.02] border border-dashed border-white/5 text-[10px] text-terminal-muted font-mono text-center">
                            {emptyMessage}
                          </div>
                        )}
                      </div>
                    </div>
                  ))
                ) : (
                  <div class="py-8 text-center text-xs text-terminal-muted border border-dashed border-white/10 rounded-xl">
                    {emptyMessage}
                  </div>
                )}
              </div>

              <!-- COLUMNA DERECHA: Detalle -->
              <div class="catalog-detail-panel md:col-span-4 bg-black/40 border border-white/10 rounded-xl p-3 flex flex-col justify-between min-h-[380px]">
                <div class="catalog-detail-placeholder flex flex-col items-center justify-center text-center p-6 my-auto">
                  <div class="w-12 h-12 rounded-xl bg-white/[0.03] border border-white/10 flex items-center justify-center mb-3 text-2xl">
                    {tab.placeholderIcon || (tab.type === "sell" ? "💎" : "⛏️")}
                  </div>
                  <h3 class="text-sm font-bold text-white mb-1">{defaultLabels.selectTitle}</h3>
                  <p class="text-xs text-terminal-muted max-w-[220px]">
                    {defaultLabels.selectDesc}
                  </p>
                </div>

                <div class="catalog-detail-content hidden flex flex-col justify-between h-full">
                  <div>
                    <div class="flex items-center justify-between gap-2 mb-2">
                      <h3 class="catalog-detail-title text-base sm:text-lg font-bold text-white tracking-tight truncate">
                        --
                      </h3>
                      <span class="catalog-detail-yield-badge hidden text-[10px] font-mono font-bold px-1.5 py-0.5 rounded-md bg-amber-500/20 text-amber-300 border border-amber-500/30 shrink-0">
                        x6
                      </span>
                    </div>
                    <div class="my-2.5 flex items-center justify-center p-2.5 rounded-xl bg-white/[0.02]">
                      <img
                        src=""
                        alt=""
                        width="48"
                        height="48"
                        class="catalog-detail-img w-12 h-12 object-contain drop-shadow-[0_6px_12px_rgba(0,0,0,0.6)] [image-rendering:pixelated]"
                      />
                    </div>
                    <p class="catalog-detail-desc text-xs text-terminal-secondary leading-relaxed mb-2.5">
                      --
                    </p>
                    <div class="border-t border-white/10 my-2.5" />

                    <div class="mb-3">
                      <span class="text-[10px] font-mono uppercase tracking-wider text-terminal-muted block mb-1">
                        {tab.type === "sell" ? defaultLabels.reward : defaultLabels.ingredients}
                      </span>
                      <div class="catalog-detail-ingredients flex flex-col gap-0.5" />
                    </div>

                    <div class="flex items-center justify-between py-2 px-3 rounded-xl bg-emerald-500/[0.06] border border-emerald-500/20 mt-2">
                      <span class="text-xs font-mono text-terminal-secondary font-medium">
                        {tab.type === "sell"
                          ? defaultLabels.totalReward
                          : defaultLabels.totalCost}
                      </span>
                      <div class="flex flex-col items-end leading-tight">
                        <div class="flex items-center gap-1.5">
                          <img
                            src={currencyIcon}
                            width="14"
                            height="14"
                            class="w-3.5 h-3.5 rounded-full object-cover shrink-0"
                            alt={currencySymbol}
                          />
                          <span class="catalog-detail-flower-total text-sm font-mono font-bold text-emerald-400">
                            0.0000
                          </span>
                        </div>
                        <span class="catalog-detail-usd-total text-[10.5px] font-mono text-white/50 pt-0.5">
                          ~$0.0000
                        </span>
                        <span class="catalog-detail-unit-cost text-[9.5px] font-mono text-amber-300/80 hidden pt-0.5">
                          --
                        </span>
                      </div>
                    </div>

                    <!-- STATS DE AGING & XP (Aged Fish & Prime Aged Fish) -->
                    <div class="catalog-detail-xp-section hidden flex-col gap-1.5 mt-2">
                      <!-- Fila Tiempo de Curado -->
                      <div class="catalog-detail-time-row hidden items-center justify-between py-1.5 px-3 rounded-xl bg-cyan-500/[0.05] border border-cyan-500/20 text-xs font-mono">
                        <div class="flex items-center gap-1.5 text-cyan-300/90 font-medium">
                          <span class="text-xs">⏱️</span>
                          <span>{defaultLabels.agingTimeLabel}</span>
                        </div>
                        <span class="catalog-detail-aging-time font-bold text-cyan-300">
                          --
                        </span>
                      </div>

                      <!-- Fila Aged Fish con Badge de Probabilidad -->
                      <div class="flex items-center justify-between py-1.5 px-3 rounded-xl bg-amber-500/[0.05] border border-amber-500/20 text-xs font-mono">
                        <div class="flex items-center gap-1.5 text-terminal-secondary">
                          <span class="text-xs">🐟</span>
                          <span>{defaultLabels.agedXpLabel}</span>
                          <span class="catalog-detail-aged-chance text-[9.5px] px-1 py-0.2 rounded bg-amber-400/10 text-amber-300 font-bold border border-amber-400/20">
                            90%
                          </span>
                        </div>
                        <span class="catalog-detail-aged-xp font-bold text-amber-300">
                          +0 XP
                        </span>
                      </div>

                      <!-- Fila Prime Aged Fish con Badge de Probabilidad -->
                      <div class="flex items-center justify-between py-1.5 px-3 rounded-xl bg-yellow-500/[0.08] border border-yellow-500/30 text-xs font-mono shadow-[0_0_12px_rgba(234,179,8,0.06)]">
                        <div class="flex items-center gap-1.5 text-yellow-300/90 font-medium">
                          <span class="text-xs">✨</span>
                          <span>{defaultLabels.primeAgedXpLabel}</span>
                          <span class="catalog-detail-prime-chance text-[9.5px] px-1 py-0.2 rounded bg-yellow-400/15 text-yellow-300 font-bold border border-yellow-400/30">
                            10%
                          </span>
                        </div>
                        <span class="catalog-detail-prime-xp font-bold text-yellow-300">
                          +0 XP
                        </span>
                      </div>
                    </div>
                  </div>

                  <!-- Simulador -->
                  {hasSimulator && (
                    <div class="catalog-simulator-section mt-3 pt-2.5 border-t border-white/10 flex flex-col gap-1.5">
                      <div class="flex items-center justify-between">
                        <span class="text-[10px] font-mono text-terminal-muted">
                          {tab.type === "sell"
                            ? defaultLabels.sellSimulation
                            : defaultLabels.craftSimulation}
                        </span>

                        <div class="relative">
                          <button
                            type="button"
                            class="stock-popup-trigger text-terminal-muted hover:text-white transition-colors focus:outline-none cursor-pointer p-0.5 rounded-md flex items-center justify-center"
                            aria-label={defaultLabels.stockTitle}
                          >
                            <svg
                              class="w-3.5 h-3.5"
                              viewBox="0 0 24 24"
                              fill="none"
                              stroke="currentColor"
                              stroke-width="2.5"
                              stroke-linecap="round"
                              stroke-linejoin="round"
                            >
                              <circle cx="12" cy="12" r="10" />
                              <path d="M12 16v-4" />
                              <path d="M12 8h.01" />
                            </svg>
                          </button>

                          <div class="stock-popup-modal hidden absolute right-0 bottom-full mb-2 w-64 p-3 bg-[#0c1015] border border-white/10 rounded-xl shadow-2xl z-[90] text-left">
                            <div class="flex items-center justify-between pb-1.5 mb-2 border-b border-white/10">
                              <span class="text-white font-bold text-xs flex items-center gap-1.5">
                                <svg
                                  class="w-3.5 h-3.5 text-cyan-400"
                                  viewBox="0 0 24 24"
                                  fill="none"
                                  stroke="currentColor"
                                  stroke-width="2.5"
                                  stroke-linecap="round"
                                  stroke-linejoin="round"
                                >
                                  <circle cx="12" cy="12" r="10" />
                                  <path d="M12 16v-4" />
                                  <path d="M12 8h.01" />
                                </svg>
                                <span>{defaultLabels.stockTitle}</span>
                              </span>
                              <button
                                type="button"
                                class="stock-popup-close text-white/40 hover:text-white text-xs cursor-pointer p-0.5 leading-none transition-colors"
                              >
                                ✕
                              </button>
                            </div>
                            <div class="flex items-center justify-between text-[11px] font-mono mb-2 px-2 py-1 rounded bg-white/[0.03] border border-white/5">
                              <span class="text-terminal-muted">{defaultLabels.stockAvailable}:</span>
                              <span class="stock-popup-qty text-cyan-400 font-bold">--</span>
                            </div>
                            <p class="text-[10px] text-white/70 font-sans leading-relaxed">
                              {defaultLabels.stockDesc}
                            </p>
                          </div>
                        </div>
                      </div>

                      <div class="grid grid-cols-3 gap-1.5 multiplier-grid">
                        {(
                          tab.multipliers ||
                          (tab.type === "sell" ? [1, 10, 100] : [1, 10, "max"])
                        ).map((m, mIdx) => (
                          <button
                            type="button"
                            class={`catalog-multiplier-btn py-1 px-2 rounded-lg text-[11px] font-mono font-bold transition-all cursor-pointer ${
                              mIdx === 0
                                ? "active bg-white/10 text-white border border-white/20 hover:bg-white/20"
                                : "bg-black/40 text-white/50 border border-white/5 hover:bg-white/10 hover:text-white"
                            }`}
                            data-multiplier={m.toString()}
                          >
                            {m === "max" ? "Max" : `x${m}`}
                          </button>
                        ))}
                      </div>

                      <div class="relative flex items-center mt-1.5">
                        <input
                          type="number"
                          min="1"
                          step="1"
                          value="1"
                          placeholder={defaultLabels.customPlaceholder}
                          class="catalog-custom-qty w-full bg-black/50 border border-white/10 focus:border-amber-400/60 focus:bg-white/[0.03] text-white font-mono text-xs rounded-lg pl-3 pr-10 py-1.5 outline-none transition-all placeholder:text-white/30 text-center [appearance:textfield] [&::-webkit-outer-spin-button]:appearance-none [&::-webkit-inner-spin-button]:appearance-none"
                        />
                        <span class="absolute right-2.5 text-[10px] font-mono text-terminal-muted pointer-events-none select-none">
                          {defaultLabels.customUnits}
                        </span>
                      </div>
                    </div>
                  )}

                  <!-- Peces que se pueden capturar (Catch Pool) -->
                  <div class="catalog-detail-catches-section hidden mt-3 pt-2.5 border-t border-white/10 flex-col gap-1.5">
                    <span class="text-[10px] font-mono uppercase tracking-wider text-terminal-muted block">
                      {defaultLabels.catchesTitle || "Peces que se pueden capturar:"}
                    </span>
                    <div class="catalog-detail-catches-grid flex flex-wrap gap-1.5 items-center">
                    </div>
                  </div>
                </div>
              </div>
            </div>
          )}
        </div>
      ))
    )
  }
</div>

<script>
  function setupCatalogCards() {
    document.querySelectorAll<HTMLElement>(".catalog-card").forEach((card) => {
      if (card.dataset.initialized === "true") return
      card.dataset.initialized = "true"

      const labels = JSON.parse(card.dataset.labels || "{}")
      const currIcon = card.dataset.currencyIcon || "/img/sunflowerland/flower.jpg"
      const secIcon = card.dataset.secondaryIcon || "/img/sunflowerland/123/coins.png"
      const secSymbol = card.dataset.secondarySymbol || "Coins"

      // Pestañas
      const tabBtns = card.querySelectorAll<HTMLButtonElement>(".catalog-tab-btn")
      const tabPanels = card.querySelectorAll<HTMLElement>(".catalog-tab-panel")
      tabBtns.forEach((btn) => {
        btn.addEventListener("click", () => {
          const targetId = btn.dataset.target
          tabBtns.forEach((b) => {
            b.classList.remove("bg-white/10", "text-amber-400", "border-amber-500/30", "shadow-sm")
            b.classList.add("text-white/50", "border-transparent")
          })
          btn.classList.add("bg-white/10", "text-amber-400", "border-amber-500/30", "shadow-sm")
          btn.classList.remove("text-white/50", "border-transparent")
          tabPanels.forEach((p) => p.classList.toggle("hidden", p.id !== targetId))
        })
      })

      // Control de paneles autónomos
      tabPanels.forEach((panel) => {
        const placeholder = panel.querySelector<HTMLElement>(".catalog-detail-placeholder")
        const content = panel.querySelector<HTMLElement>(".catalog-detail-content")
        const titleEl = panel.querySelector<HTMLElement>(".catalog-detail-title")
        const yieldBadgeEl = panel.querySelector<HTMLElement>(".catalog-detail-yield-badge")
        const imgEl = panel.querySelector<HTMLImageElement>(".catalog-detail-img")
        const descEl = panel.querySelector<HTMLElement>(".catalog-detail-desc")
        const ingredientsEl = panel.querySelector<HTMLElement>(".catalog-detail-ingredients")
        const flowerTotalEl = panel.querySelector<HTMLElement>(".catalog-detail-flower-total")
        const usdTotalEl = panel.querySelector<HTMLElement>(".catalog-detail-usd-total")
        const unitCostEl = panel.querySelector<HTMLElement>(".catalog-detail-unit-cost")
        const xpSection = panel.querySelector<HTMLElement>(".catalog-detail-xp-section")
        const agedXpEl = panel.querySelector<HTMLElement>(".catalog-detail-aged-xp")
        const primeAgedXpEl = panel.querySelector<HTMLElement>(".catalog-detail-prime-xp")
        const agingTimeRow = panel.querySelector<HTMLElement>(".catalog-detail-time-row")
        const agingTimeEl = panel.querySelector<HTMLElement>(".catalog-detail-aging-time")
        const agedChanceEl = panel.querySelector<HTMLElement>(".catalog-detail-aged-chance")
        const primeChanceEl = panel.querySelector<HTMLElement>(".catalog-detail-prime-chance")
        const simulatorSection = panel.querySelector<HTMLElement>(".catalog-simulator-section")
        const catchesSection = panel.querySelector<HTMLElement>(".catalog-detail-catches-section")
        const catchesGrid = panel.querySelector<HTMLElement>(".catalog-detail-catches-grid")
        const multiplierBtns = panel.querySelectorAll<HTMLButtonElement>(".catalog-multiplier-btn")
        const customQtyInput = panel.querySelector<HTMLInputElement>(".catalog-custom-qty")
        const popupTrigger = panel.querySelector<HTMLButtonElement>(".stock-popup-trigger")
        const popupModal = panel.querySelector<HTMLElement>(".stock-popup-modal")
        const popupClose = panel.querySelector<HTMLButtonElement>(".stock-popup-close")
        const popupQty = panel.querySelector<HTMLElement>(".stock-popup-qty")
        const slots = panel.querySelectorAll<HTMLButtonElement>(".catalog-item-slot")

        let selectedItem: any = null
        let currentMultiplier: any = 1

        if (popupTrigger && popupModal) {
          popupTrigger.addEventListener("click", (e) => {
            e.stopPropagation()
            popupModal.classList.toggle("hidden")
          })
          if (popupClose) popupClose.addEventListener("click", () => popupModal.classList.add("hidden"))
          popupModal.addEventListener("click", (e) => e.stopPropagation())
          document.addEventListener("click", () => popupModal.classList.add("hidden"))
        }

        function getRates() {
          const w = window as any
          return {
            coinsPerFlower: w.__bestCoinsPerFlower || 320,
            flowerUsd: w.__flowerPrice || 0.144,
          }
        }

        function resolveMaterial(matName: string): number {
          const w = window as any
          if (typeof w.getMaterialUnitPrice === "function") return w.getMaterialUnitPrice(matName)
          const sflConst = w.SflConstants
          const { coinsPerFlower, flowerUsd } = getRates()
          if (sflConst?.resolveMaterialFlowerCost) {
            return sflConst.resolveMaterialFlowerCost(matName, { coinsPerFlower, flowerPriceUsd: flowerUsd })
          }
          return 0
        }

        function updateSlots() {
          const { coinsPerFlower } = getRates()
          slots.forEach((slot) => {
            const badge = slot.querySelector<HTMLElement>(".catalog-unit-flower")
            if (!badge) return
            try {
              const item = JSON.parse(slot.dataset.itemData || "{}")
              const coinsFlower = coinsPerFlower > 0 ? (item.coins || 0) / coinsPerFlower : 0
              let mats = 0
              if (Array.isArray(item.ingredients)) {
                item.ingredients.forEach((ing: any) => (mats += resolveMaterial(ing.name) * ing.amount))
              }
              const total = coinsFlower + mats
              const hasIngredients = Array.isArray(item.ingredients) && item.ingredients.length > 0
              if (total > 0) {
                badge.innerText = total < 100 ? total.toFixed(4) : total.toFixed(2)
              } else if (hasIngredients) {
                badge.innerText = "--"
              } else {
                badge.innerText = "0"
              }
            } catch (_) {}
          })
        }

        function updateDetail() {
          if (!selectedItem) return
          const { coinsPerFlower, flowerUsd } = getRates()
          const isUnlimited = !selectedItem.isPermanent && (!selectedItem.stock || selectedItem.stock <= 0)
          const stock = isUnlimited ? null : selectedItem.stock || 1
          const isSingle = selectedItem.isPermanent || (!isUnlimited && stock <= 1)

          if (simulatorSection) {
            simulatorSection.classList.toggle("hidden", isSingle)
            if (!isSingle && !isUnlimited) {
              const step2 = stock <= 5 ? Math.ceil(stock / 2) : stock <= 10 ? Math.floor(stock / 2) : 10
              multiplierBtns.forEach((b) => {
                if (b.dataset.multiplier === "10") {
                  b.innerText = `x${step2}`
                  b.dataset.multiplier = step2.toString()
                } else if (b.dataset.multiplier === "max") {
                  b.innerText = `x${stock}`
                }
              })
            }
          }

          let qty = isSingle ? 1 : isUnlimited ? (typeof currentMultiplier === "number" ? currentMultiplier : 1) : currentMultiplier === "max" ? stock : Math.min(parseInt(currentMultiplier, 10) || 1, stock)
          if (titleEl) titleEl.innerText = selectedItem.name
          if (descEl) {
            if (selectedItem.description) {
              descEl.innerText = selectedItem.description
              descEl.classList.remove("hidden")
            } else {
              descEl.innerText = ""
              descEl.classList.add("hidden")
            }
          }
          if (imgEl) {
            imgEl.src = selectedItem.image
            imgEl.alt = selectedItem.name
          }

          if (popupQty) {
            popupQty.innerText = selectedItem.isPermanent ? `${labels.permanent} (1x)` : isUnlimited ? labels.unlimited : `${selectedItem.stock} ${labels.customUnits}`
            popupQty.className = `stock-popup-qty font-bold ${selectedItem.isPermanent ? "text-amber-400" : isUnlimited ? "text-emerald-400" : "text-cyan-400"}`
          }

          const totalCoins = (selectedItem.coins || 0) * qty
          const coinsFlower = coinsPerFlower > 0 ? totalCoins / coinsPerFlower : 0
          let matsFlower = 0
          let html = ""

          if (selectedItem.coins > 0 || !selectedItem.ingredients?.length) {
            html += `<div class="flex items-center justify-between py-1 px-1 text-xs font-mono"><div class="flex items-center gap-2"><img src="${secIcon}" width="16" height="16" class="w-4 h-4 object-contain" alt="${secSymbol}" /><span class="${selectedItem.coins === 0 ? "text-terminal-muted" : "text-amber-400"} font-bold">${selectedItem.coins === 0 ? `0 ${secSymbol} (${labels.free})` : `${totalCoins.toLocaleString()} ${secSymbol} ${qty > 1 ? `(${qty}x)` : ""}`}</span></div><div class="flex items-center gap-1.5 text-emerald-400 font-bold text-[11px]"><img src="${currIcon}" width="12" height="12" class="w-3 h-3 rounded-full object-cover shrink-0" alt="token" /><span>${coinsFlower.toFixed(4)}</span></div></div>`
          }

          if (Array.isArray(selectedItem.ingredients)) {
            selectedItem.ingredients.forEach((ing: any) => {
              const reqQty = ing.amount * qty
              const unitP = resolveMaterial(ing.name)
              const cost = unitP * reqQty
              matsFlower += cost
              html += `<div class="flex items-center justify-between py-1 px-1 text-xs font-mono"><div class="flex items-center gap-2">${ing.image ? `<img src="${ing.image}" width="16" height="16" class="w-4 h-4 object-contain" alt="${ing.name}" />` : ""}<span class="text-white font-bold">${reqQty.toLocaleString()}</span><span class="text-terminal-secondary">${ing.name}</span></div><div class="flex items-center gap-1.5 text-emerald-400 font-bold text-[11px]"><img src="${currIcon}" width="12" height="12" class="w-3 h-3 rounded-full object-cover shrink-0" alt="token" /><span>${unitP > 0 ? cost.toFixed(4) : "--"}</span></div></div>`
            })
          }

          if (ingredientsEl) ingredientsEl.innerHTML = html
          const grandFlower = coinsFlower + matsFlower
          if (flowerTotalEl) {
            const hasIngredients =
              Array.isArray(selectedItem.ingredients) && selectedItem.ingredients.length > 0
            if (grandFlower > 0) {
              flowerTotalEl.innerText =
                grandFlower < 100 ? grandFlower.toFixed(4) : grandFlower.toFixed(2)
            } else if (hasIngredients) {
              flowerTotalEl.innerText = "--"
            } else {
              flowerTotalEl.innerText = "0"
            }
          }
          if (usdTotalEl) usdTotalEl.innerText = `~$${(grandFlower * flowerUsd).toFixed(4)}`

          if (yieldBadgeEl) {
            if (selectedItem.yield && selectedItem.yield > 1) {
              yieldBadgeEl.classList.remove("hidden")
              yieldBadgeEl.innerText = `x${selectedItem.yield * qty}`
            } else {
              yieldBadgeEl.classList.add("hidden")
            }
          }

          if (unitCostEl) {
            if (selectedItem.yield && selectedItem.yield > 1 && grandFlower > 0) {
              unitCostEl.classList.remove("hidden")
              const totalUnits = selectedItem.yield * qty
              const unitFlower = grandFlower / totalUnits
              const unitUsd = (grandFlower * flowerUsd) / totalUnits
              unitCostEl.innerText = `(${unitFlower.toFixed(4)} FLOWER · ~$${unitUsd.toFixed(4)} / ud)`
            } else {
              unitCostEl.classList.add("hidden")
            }
          }

          function formatDuration(seconds: number): string {
            if (!seconds || seconds <= 0) return "--"
            const hours = Math.floor(seconds / 3600)
            const mins = Math.floor((seconds % 3600) / 60)
            if (hours > 0) {
              return mins > 0 ? `${hours}h ${mins}m` : `${hours}h`
            }
            return `${mins}m`
          }

          if (xpSection && agedXpEl && primeAgedXpEl) {
            if (selectedItem.agedXp || selectedItem.primeAgedXp) {
              xpSection.classList.remove("hidden")
              xpSection.classList.add("flex")
              const totalAgedXp = (selectedItem.agedXp || 0) * qty
              const totalPrimeXp = (selectedItem.primeAgedXp || 0) * qty
              agedXpEl.innerText = `+${totalAgedXp.toLocaleString()} XP`
              primeAgedXpEl.innerText = `+${totalPrimeXp.toLocaleString()} XP`

              if (agingTimeRow && agingTimeEl) {
                if (selectedItem.timeSeconds) {
                  agingTimeRow.classList.remove("hidden")
                  agingTimeRow.classList.add("flex")
                  agingTimeEl.innerText = formatDuration(selectedItem.timeSeconds)
                } else {
                  agingTimeRow.classList.add("hidden")
                  agingTimeRow.classList.remove("flex")
                }
              }

              const chances = selectedItem.chances || { aged: 90, primeAged: 10 }
              if (agedChanceEl && chances.aged !== undefined) {
                agedChanceEl.innerText = `${chances.aged}%`
              }
              if (primeChanceEl && chances.primeAged !== undefined) {
                primeChanceEl.innerText = `${chances.primeAged}%`
              }
            } else {
              xpSection.classList.add("hidden")
              xpSection.classList.remove("flex")
            }
          }

          if (catchesSection && catchesGrid) {
            if (Array.isArray(selectedItem.catchPool) && selectedItem.catchPool.length > 0) {
              catchesSection.classList.remove("hidden")
              catchesSection.classList.add("flex")
              catchesGrid.innerHTML = selectedItem.catchPool
                .map((fish: any) => {
                  const name = typeof fish === "string" ? fish : fish.name
                  const img = typeof fish === "string" ? `/img/sunflowerland/fish/${name}.png` : fish.image
                  return `<div class="relative group/fish" title="${name}"><div class="w-6 h-6 sm:w-7 sm:h-7 rounded-lg bg-black/50 border border-white/10 hover:border-cyan-400/60 hover:bg-white/[0.08] p-0.5 flex items-center justify-center transition-all cursor-pointer"><img src="${img}" alt="${name}" class="w-full h-full object-contain [image-rendering:pixelated]" loading="lazy" /></div><div class="absolute bottom-full left-1/2 -translate-x-1/2 mb-1.5 px-2 py-0.5 rounded-md bg-[#0c1015] border border-white/10 text-[10.5px] font-mono text-cyan-300 font-bold whitespace-nowrap shadow-2xl opacity-0 invisible group-hover/fish:opacity-100 group-hover/fish:visible transition-all pointer-events-none z-30">${name}</div></div>`
                })
                .join("")
            } else {
              catchesSection.classList.add("hidden")
              catchesSection.classList.remove("flex")
              catchesGrid.innerHTML = ""
            }
          }
        }

        slots.forEach((slot) => {
          slot.addEventListener("click", () => {
            slots.forEach((s) => {
              s.classList.remove("border-amber-400", "bg-amber-400/10", "shadow-[0_0_15px_rgba(251,191,36,0.2)]")
              s.classList.add("border-white/10")
              s.querySelector(".slot-corner-bracket")?.classList.add("hidden")
            })
            slot.classList.add("border-amber-400", "bg-amber-400/10", "shadow-[0_0_15px_rgba(251,191,36,0.2)]")
            slot.classList.remove("border-white/10")
            slot.querySelector(".slot-corner-bracket")?.classList.remove("hidden")

            try {
              selectedItem = JSON.parse(slot.dataset.itemData || "{}")
              currentMultiplier = 1
              if (customQtyInput) customQtyInput.value = "1"
              if (placeholder) placeholder.classList.add("hidden")
              if (content) content.classList.remove("hidden")
              updateDetail()
            } catch (_) {}
          })
        })

        multiplierBtns.forEach((btn) => {
          btn.addEventListener("click", () => {
            multiplierBtns.forEach((b) => {
              b.classList.remove("bg-white/10", "border-white/20", "text-white")
              b.classList.add("bg-black/40", "border-white/5", "text-white/50")
            })
            btn.classList.add("bg-white/10", "border-white/20", "text-white")
            btn.classList.remove("bg-black/40", "border-white/5", "text-white/50")
            const m = btn.dataset.multiplier
            currentMultiplier = m === "max" ? "max" : parseInt(m || "1", 10) || 1
            if (customQtyInput) customQtyInput.value = (m === "max" && selectedItem?.stock ? selectedItem.stock : currentMultiplier).toString()
            updateDetail()
          })
        })

        if (customQtyInput) {
          customQtyInput.addEventListener("input", () => {
            let val = parseInt(customQtyInput.value, 10)
            currentMultiplier = isNaN(val) || val < 1 ? 1 : val
            updateDetail()
          })
        }

        ;(panel as any).__updateCatalog = () => {
          updateSlots()
          updateDetail()
        }

        updateSlots()
      })
    })
  }

  window.addEventListener("sfl:currency-change", () => {
    document.querySelectorAll<HTMLElement>(".catalog-tab-panel").forEach((p) => {
      ;(p as any).__updateCatalog?.()
    })
  })

  setupCatalogCards()
  document.addEventListener("astro:page-load", setupCatalogCards)
</script>
