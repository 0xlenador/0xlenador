{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "0xlenador",
  "main": "src/worker/index.js",
  "compatibility_date": "2024-09-23",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "kv_namespaces": [
    {
      "binding": "SFL_KV",
      "id": "24b64a276ee8423fb532b561305fede7"
    }
  ],
  "triggers": {
    "crons": ["*/15 * * * *"]
  }
}
