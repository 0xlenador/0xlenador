{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "0xlenador",
  "main": "src/worker/index.js",
  "compatibility_date": "2024-09-23",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "kv_namespaces": [
    {
      "binding": "SFL_KV",
      "id": "f013f0117bbf4b9d9c16c77031f181db"
    }
  ],
  "triggers": {
    "crons": [
      "*/15 * * * *"
    ]
  }
}