# ==============================
# .gitattributes — 0xLeñador
# Normalización de fin de línea
# ==============================

# Texto: Git decide el EOL según el OS del colaborador
* text=auto

# JS/TS/Astro/CSS/JSON/MD — forzar LF en el repositorio
*.js      text eol=lf
*.ts      text eol=lf
*.mjs     text eol=lf
*.cjs     text eol=lf
*.astro   text eol=lf
*.css     text eol=lf
*.json    text eol=lf
*.md      text eol=lf
*.mdx     text eol=lf
*.html    text eol=lf
*.svg     text eol=lf
*.xml     text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.toml    text eol=lf
*.txt     text eol=lf
*.env     text eol=lf

# Binarios — nunca tocar EOL
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.webp    binary
*.ico     binary
*.pdf     binary
*.woff    binary
*.woff2   binary
*.ttf     binary
*.eot     binary
